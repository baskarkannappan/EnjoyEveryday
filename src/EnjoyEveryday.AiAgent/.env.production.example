# ==============================================================================
# EnjoyEveryday AI Agent - Production Environment Configuration
# ==============================================================================

# Application Environment
DEBUG=false
AI_PROVIDER=GoogleGemini
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# Security & Server-to-Server Authentication
REQUIRE_SERVICE_AUTH=true
AI_SERVICE_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY

# Google Gemini API Credentials (if default fallback is used)
GEMINI_API_KEY=YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY

# Rate Limiting & Concurrency Guardrails
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_GENERATIONS=20
