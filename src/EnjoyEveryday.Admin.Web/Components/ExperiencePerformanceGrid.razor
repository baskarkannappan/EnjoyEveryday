@namespace EnjoyEveryday.Admin.Web.Components
@using Microsoft.FluentUI.AspNetCore.Components

<div class="panel experience-performance-panel">

    <h3>Experience performance</h3>

    <div class="panel-description performance-description">
        Program signals &mdash; not child scores.
    </div>

    <FluentDataGrid Items="@Items"
                    TGridItem="ExperiencePerformanceItem"
                    Class="performance-grid"
                    GridTemplateColumns="2.8fr 0.7fr 1.1fr 0.8fr"
                    RowSize="DataGridRowSize.Large">

        <TemplateColumn Title="EXPERIENCE">

            <div class="experience-cell">
                <strong>@context.Title</strong>
                <small>@context.Subtitle</small>
            </div>

        </TemplateColumn>

        <PropertyColumn Property="@(p => p.Uses)"
                        Title="USES"
                        Align="DataGridCellAlignment.Start" />

        <TemplateColumn Title="RESPONSE">

            <div class="response-cell">
                @context.Response
            </div>

        </TemplateColumn>

        <TemplateColumn Title="INSIGHT" Align="DataGridCellAlignment.End">

            <button class="insight-button"
                    @onclick="() => OnViewClick.InvokeAsync(context)">
                View
            </button>

        </TemplateColumn>

    </FluentDataGrid>
</div>


<style>

    .performance-grid {
        width: 100%;
        border: none;
        background: transparent;
    }

        .performance-grid .fluent-data-grid-cell {
            white-space: normal !important;
            padding: 12px 0 !important;
            background: transparent !important;
            border-bottom: 1px solid #e1e5e2;
        }

    .experience-cell {
        display: flex;
        flex-direction: column;
        justify-content: center;
        line-height: 1.3;
    }

        .experience-cell strong {
            color: #101820;
            font-size: 0.88rem;
            font-weight: 700;
        }

        .experience-cell small {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: 0.68rem;
        }

    .response-cell {
        display: flex;
        align-items: center;
    }

    .insight-button {
        border: none;
        background: transparent;
        padding: 0;
        color: #0b3d36;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
    }

</style>


@code {

    [Parameter]
    public IQueryable<ExperiencePerformanceItem>? Items { get; set; }

    [Parameter]
    public EventCallback<ExperiencePerformanceItem> OnViewClick { get; set; }


    public class ExperiencePerformanceItem
    {
        public string Title { get; set; } = string.Empty;

        public string Subtitle { get; set; } = string.Empty;

        public int Uses { get; set; }

        public string Response { get; set; } = string.Empty;
    }

}