@page "/audit-logs"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@inject IPlatformAdminService PlatformService
@rendermode InteractiveServer

<PageTitle>Platform Admin — Audit Logs</PageTitle>

<div class="content">
    <PageHero Eyebrow="PLATFORM OPERATIONS"
              Title="Security &amp; Administrative Audit Logs"
              Subtitle="Immutable audit trail of organization status changes, financial reconciliations, and transactional email dispatches.">
        <RightContent>
            <button class="btn secondary" @onclick="RefreshLogsAsync">🔄 Refresh</button>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <!-- TAB NAVIGATION -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px;">
        <button class="tab @(_activeTab == "Audit" ? "active" : "")" 
                style="padding: 10px 20px; border-radius: 9px; font-size: 13.5px; font-weight: 750; cursor: pointer; border: 1px solid var(--border); @(_activeTab == "Audit" ? "background: var(--accent-dark); color: #ffffff;" : "background: var(--surface); color: var(--text);")" 
                @onclick='() => SetTab("Audit")'>
            🛡️ Administrative Audit Trail (@(_logs?.Count ?? 0))
        </button>
        <button class="tab @(_activeTab == "Emails" ? "active" : "")" 
                style="padding: 10px 20px; border-radius: 9px; font-size: 13.5px; font-weight: 750; cursor: pointer; border: 1px solid var(--border); @(_activeTab == "Emails" ? "background: var(--accent-dark); color: #ffffff;" : "background: var(--surface); color: var(--text);")" 
                @onclick='() => SetTab("Emails")'>
            ✉️ Transactional Email Delivery Logs (@(_emailLogs?.Count ?? 0))
        </button>
    </div>

    @if (_activeTab == "Audit")
    {
        @if (_logs == null)
        {
            <LoadingState Text="Loading audit trail..." />
        }
        else
        {
            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr style="background: var(--surface-soft); font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800; letter-spacing: 0.8px;">
                            <th style="padding: 12px 14px; text-align: left;">Timestamp</th>
                            <th style="padding: 12px 14px; text-align: left;">Actor</th>
                            <th style="padding: 12px 14px; text-align: left;">Action</th>
                            <th style="padding: 12px 14px; text-align: left;">Details</th>
                            <th style="padding: 12px 14px; text-align: left;">Severity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _logs)
                        {
                            <tr style="border-bottom: 1px solid #edf1ec; font-size: 13px;">
                                <td style="padding: 14px; color: var(--muted); white-space: nowrap;">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td style="padding: 14px; font-weight: 700; color: var(--text);">@log.Actor</td>
                                <td style="padding: 14px; font-weight: 650; color: var(--accent);">@log.Action</td>
                                <td style="padding: 14px; color: var(--text);">@log.Details</td>
                                <td style="padding: 14px;">
                                    <span style="background: @(log.Severity == "Warning" ? "#fdf6ec" : "var(--accent-light)"); color: @(log.Severity == "Warning" ? "#8c631b" : "var(--accent-dark)"); padding: 2px 7px; border-radius: 999px; font-size: 11px; font-weight: 750;">
                                        @log.Severity
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        @if (_emailLogs == null)
        {
            <LoadingState Text="Loading email delivery logs..." />
        }
        else if (_emailLogs.Count == 0)
        {
            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 36px; text-align: center; box-shadow: var(--shadow);">
                <div style="font-size: 32px; margin-bottom: 12px;">✉️</div>
                <div style="font-size: 16px; font-weight: 700; color: var(--text);">No Transactional Emails Logged</div>
                <p style="font-size: 13px; color: var(--muted); margin: 6px 0 0;">Platform invitation, tariff updates, and invoice notification dispatches will appear here.</p>
            </div>
        }
        else
        {
            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr style="background: var(--surface-soft); font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800; letter-spacing: 0.8px;">
                            <th style="padding: 12px 14px; text-align: left;">Sent At (UTC)</th>
                            <th style="padding: 12px 14px; text-align: left;">Notification Type</th>
                            <th style="padding: 12px 14px; text-align: left;">Recipient Email</th>
                            <th style="padding: 12px 14px; text-align: left;">Delivery Status</th>
                            <th style="padding: 12px 14px; text-align: left;">Notes / Metadata</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var em in _emailLogs)
                        {
                            <tr style="border-bottom: 1px solid #edf1ec; font-size: 13px;">
                                <td style="padding: 14px; color: var(--muted); white-space: nowrap;">@em.SentAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td style="padding: 14px; font-weight: 700; color: var(--text);">
                                    <span style="background: var(--accent-light); color: var(--accent-dark); padding: 2px 8px; border-radius: 6px; font-size: 11.5px;">
                                        @em.NotificationType
                                    </span>
                                </td>
                                <td style="padding: 14px; font-weight: 650; color: var(--text);">@em.RecipientEmail</td>
                                <td style="padding: 14px;">
                                    <span style="background: @(em.Status == "Sent" || em.Status == "Delivered" ? "#e6eee9" : (em.Status == "Skipped" ? "#fdf6ec" : "#fee2e2")); color: @(em.Status == "Sent" || em.Status == "Delivered" ? "#2e5a45" : (em.Status == "Skipped" ? "#8c631b" : "#b91c1c")); padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 750;">
                                        @(em.Status == "Sent" || em.Status == "Delivered" ? "✓ " : "")@em.Status
                                    </span>
                                </td>
                                <td style="padding: 14px; font-size: 12px; color: var(--muted); max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(em.ErrorMessage ?? em.Metadata ?? "Dispatched successfully")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private List<PlatformAuditLog>? _logs;
    private List<EmailNotificationLogDto>? _emailLogs;
    private string _activeTab = "Audit";

    protected override async Task OnInitializedAsync()
    {
        await RefreshLogsAsync();
    }

    private async Task RefreshLogsAsync()
    {
        _logs = await PlatformService.GetAuditLogsAsync(100);
        _emailLogs = await PlatformService.GetEmailAuditLogsAsync(100);
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }
}
