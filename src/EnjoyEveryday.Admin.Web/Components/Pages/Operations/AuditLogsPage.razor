@page "/audit-logs"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@inject IPlatformAdminService PlatformService
@rendermode InteractiveServer

<PageTitle>Audit Logs — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="PLATFORM OPERATIONS"
              Title="Security &amp; Administrative Audit Logs"
              Subtitle="Immutable audit trail of organization status changes, financial reconciliations, and platform actions.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    @if (_logs == null)
    {
        <LoadingState Text="Loading audit trail..." />
    }
    else
    {
        <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
            <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: var(--surface-soft); font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800; letter-spacing: 0.8px;">
                        <th style="padding: 12px 14px; text-align: left;">Timestamp</th>
                        <th style="padding: 12px 14px; text-align: left;">Actor</th>
                        <th style="padding: 12px 14px; text-align: left;">Action</th>
                        <th style="padding: 12px 14px; text-align: left;">Details</th>
                        <th style="padding: 12px 14px; text-align: left;">Severity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr style="border-bottom: 1px solid #edf1ec; font-size: 13px;">
                            <td style="padding: 14px; color: var(--muted); white-space: nowrap;">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td style="padding: 14px; font-weight: 700; color: var(--text);">@log.Actor</td>
                            <td style="padding: 14px; font-weight: 650; color: var(--accent);">@log.Action</td>
                            <td style="padding: 14px; color: var(--text);">@log.Details</td>
                            <td style="padding: 14px;">
                                <span style="background: @(log.Severity == "Warning" ? "#fdf6ec" : "var(--accent-light)"); color: @(log.Severity == "Warning" ? "#8c631b" : "var(--accent-dark)"); padding: 2px 7px; border-radius: 999px; font-size: 11px; font-weight: 750;">
                                    @log.Severity
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PlatformAuditLog>? _logs;

    protected override async Task OnInitializedAsync()
    {
        _logs = await PlatformService.GetAuditLogsAsync(50);
    }
}
