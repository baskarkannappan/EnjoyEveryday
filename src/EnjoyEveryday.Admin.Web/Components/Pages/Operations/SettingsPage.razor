@page "/settings"
@using EnjoyEveryday.UI.Shared.Components
@rendermode InteractiveServer

<PageTitle>System Settings — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="PLATFORM OPERATIONS"
              Title="System &amp; Governance Settings"
              Subtitle="Multi-tenant authentication parameters, AI provider keys, and backup policies.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div style="max-width: 720px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 20px;">
        <div>
            <h4 style="font-size: 16px; font-weight: 750; color: var(--text); margin: 0 0 4px 0;">Google OpenID &amp; OAuth Authentication</h4>
            <p style="font-size: 13px; color: var(--muted); margin: 0;">Multi-tenant SSO authentication for daycare directors and platform administrators.</p>
            <div style="margin-top: 10px; display: flex; align-items: center; gap: 8px;">
                <span style="background: var(--accent-light); color: var(--accent-dark); padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700;">OAuth 2.0 Active</span>
            </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border); margin: 4px 0;" />

        <div>
            <h4 style="font-size: 16px; font-weight: 750; color: var(--text); margin: 0 0 4px 0;">AI Gateway &amp; Google ADK Configuration</h4>
            <p style="font-size: 13px; color: var(--muted); margin: 0;">Model provider: Gemini 2.5 Flash with deterministic fallback.</p>
            <div style="margin-top: 10px; display: flex; align-items: center; gap: 8px;">
                <span style="background: var(--accent-light); color: var(--accent-dark); padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700;">Human-in-the-Loop Enforced</span>
            </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border); margin: 4px 0;" />

        <div>
            <h4 style="font-size: 16px; font-weight: 750; color: var(--text); margin: 0 0 4px 0;">Tenant Isolation &amp; Encryption</h4>
            <p style="font-size: 13px; color: var(--muted); margin: 0;">PostgreSQL Row-Level Security (RLS) and AES-256 child data field-level encryption.</p>
            <div style="margin-top: 10px; display: flex; align-items: center; gap: 8px;">
                <span style="background: var(--accent-light); color: var(--accent-dark); padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700;">AES-256 Active</span>
            </div>
        </div>
    </div>
</div>
