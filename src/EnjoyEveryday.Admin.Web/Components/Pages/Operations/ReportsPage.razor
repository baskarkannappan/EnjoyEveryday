@page "/reports"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.UI.Shared.Components
@inject IPlatformAdminService PlatformService
@rendermode InteractiveServer

<PageTitle>Reports &amp; Intelligence — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="PLATFORM OPERATIONS"
              Title="Reports &amp; Organization Intelligence"
              Subtitle="SaaS-wide platform telemetry, cohort retention, and aggregate operational insights.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
            <div style="font-size: 11px; font-weight: 800; color: var(--accent); text-transform: uppercase;">FINANCIAL REPORTING</div>
            <h3 style="font-size: 18px; font-weight: 750; color: var(--text); margin: 6px 0 12px 0;">Revenue &amp; Collections</h3>
            <p style="font-size: 13px; color: var(--muted); line-height: 1.4;">Automated reconciliation of invoices, ACH/card payments, and outstanding balances.</p>
            <div style="margin-top: 16px; font-size: 24px; font-weight: 800; color: var(--text);">$48,250 <span style="font-size: 12px; font-weight: 600; color: var(--accent);">MTD</span></div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
            <div style="font-size: 11px; font-weight: 800; color: var(--accent); text-transform: uppercase;">ORGANIZATION TELEMETRY</div>
            <h3 style="font-size: 18px; font-weight: 750; color: var(--text); margin: 6px 0 12px 0;">Platform Retention</h3>
            <p style="font-size: 13px; color: var(--muted); line-height: 1.4;">Active classroom experience execution and teacher daily engagement.</p>
            <div style="margin-top: 16px; font-size: 24px; font-weight: 800; color: var(--text);">98.4% <span style="font-size: 12px; font-weight: 600; color: var(--accent);">30-day</span></div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
            <div style="font-size: 11px; font-weight: 800; color: var(--accent); text-transform: uppercase;">AI GATEWAY</div>
            <h3 style="font-size: 18px; font-weight: 750; color: var(--text); margin: 6px 0 12px 0;">Parent Communication AI</h3>
            <p style="font-size: 13px; color: var(--muted); line-height: 1.4;">Human-in-the-loop draft generation and teacher approval telemetry.</p>
            <div style="margin-top: 16px; font-size: 24px; font-weight: 800; color: var(--text);">100% <span style="font-size: 12px; font-weight: 600; color: var(--accent);">Human Approved</span></div>
        </div>
    </div>
</div>
