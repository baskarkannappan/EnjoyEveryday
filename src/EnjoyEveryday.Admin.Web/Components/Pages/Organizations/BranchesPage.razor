@page "/branches"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.UI.Shared.Components
@inject IPlatformAdminService PlatformService
@rendermode InteractiveServer

<PageTitle>Branches — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="ORGANIZATION MANAGEMENT"
              Title="Branch Network"
              Subtitle="Multi-branch configuration and physical campus directory across all daycare organizations.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
        <p style="color: var(--muted); font-size: 14px;">Select an organization to manage classrooms, physical capacity, and localized staff assignments.</p>
        <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
            <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 14px; padding: 18px;">
                <div style="font-weight: 750; font-size: 15px; color: var(--text);">Downtown Campus</div>
                <div style="font-size: 12.5px; color: var(--muted); margin-top: 2px;">Little Stars Early Learning Center · Seattle, WA</div>
                <div style="margin-top: 12px; font-size: 12px; font-weight: 650; color: var(--accent);">5 Classrooms · 64 Children</div>
            </div>
            <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 14px; padding: 18px;">
                <div style="font-weight: 750; font-size: 15px; color: var(--text);">Westside Annex</div>
                <div style="font-size: 12.5px; color: var(--muted); margin-top: 2px;">Little Stars Early Learning Center · Seattle, WA</div>
                <div style="margin-top: 12px; font-size: 12px; font-weight: 650; color: var(--accent);">3 Classrooms · 38 Children</div>
            </div>
            <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 14px; padding: 18px;">
                <div style="font-weight: 750; font-size: 15px; color: var(--text);">Forest Hill Main</div>
                <div style="font-size: 12.5px; color: var(--muted); margin-top: 2px;">Nordic Pine Forest Preschool · Portland, OR</div>
                <div style="margin-top: 12px; font-size: 12px; font-weight: 650; color: var(--accent);">4 Classrooms · 48 Children</div>
            </div>
        </div>
    </div>
</div>
