@page "/admins"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.UI.Shared.Components
@inject IPlatformAdminService PlatformService
@rendermode InteractiveServer

<PageTitle>Organization Admins — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="ORGANIZATION MANAGEMENT"
              Title="Organization Administrators"
              Subtitle="Assigned daycare directors, owners, and primary billing administrators.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
            <thead>
                <tr style="background: var(--surface-soft); font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800; letter-spacing: 0.8px;">
                    <th style="padding: 12px 14px; text-align: left;">Administrator</th>
                    <th style="padding: 12px 14px; text-align: left;">Daycare Organization</th>
                    <th style="padding: 12px 14px; text-align: left;">Role</th>
                    <th style="padding: 12px 14px; text-align: left;">Account Status</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #edf1ec; font-size: 13.5px;">
                    <td style="padding: 14px;"><strong>Priya Sharma</strong><div style="font-size: 12px; color: var(--muted);">director@littlestars.org</div></td>
                    <td style="padding: 14px;">Little Stars Early Learning Center</td>
                    <td style="padding: 14px;"><span style="background: #edf1ec; padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 650;">Tenant Admin</span></td>
                    <td style="padding: 14px;"><StatusBadge Status="Active" /></td>
                </tr>
                <tr style="border-bottom: 1px solid #edf1ec; font-size: 13.5px;">
                    <td style="padding: 14px;"><strong>Karin Lindqvist</strong><div style="font-size: 12px; color: var(--muted);">karin@nordicpine.edu</div></td>
                    <td style="padding: 14px;">Nordic Pine Forest Preschool</td>
                    <td style="padding: 14px;"><span style="background: #edf1ec; padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 650;">Tenant Admin</span></td>
                    <td style="padding: 14px;"><StatusBadge Status="Active" /></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
