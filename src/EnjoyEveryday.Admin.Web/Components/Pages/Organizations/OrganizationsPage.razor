@page "/organizations"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@inject IPlatformAdminService PlatformService
@rendermode InteractiveServer

<PageTitle>Organizations — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="ORGANIZATION MANAGEMENT"
              Title="Daycare Organizations"
              Subtitle="Create, configure, and monitor multi-tenant daycare organizations and branches.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
        <SearchFilterRow SearchPlaceholder="Search organizations..." SearchQuery="@_search" SearchQueryChanged="OnSearch">
            <Filters>
                <select class="filter" @bind="_statusFilter">
                    <option value="All">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Onboarding">Onboarding</option>
                    <option value="Trial">Trial</option>
                    <option value="Suspended">Suspended</option>
                </select>
            </Filters>
        </SearchFilterRow>

        @if (_orgs == null)
        {
            <LoadingState Text="Loading organizations..." />
        }
        else if (_orgs.Count == 0)
        {
            <EmptyState Title="No organizations found" Message="Try adjusting your search criteria." />
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr style="background: var(--surface-soft); font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800; letter-spacing: 0.8px;">
                            <th style="padding: 12px 14px; text-align: left;">Name</th>
                            <th style="padding: 12px 14px; text-align: left;">Location</th>
                            <th style="padding: 12px 14px; text-align: left;">Branches</th>
                            <th style="padding: 12px 14px; text-align: left;">Account Status</th>
                            <th style="padding: 12px 14px; text-align: left;">Financial Status</th>
                            <th style="padding: 12px 14px; text-align: left;">Plan</th>
                            <th style="padding: 12px 14px; text-align: left;">Admin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var org in FilteredOrgs)
                        {
                            <tr style="border-bottom: 1px solid #edf1ec; font-size: 13.5px;">
                                <td style="padding: 14px; font-weight: 700; color: var(--text);">@org.Name</td>
                                <td style="padding: 14px; color: var(--muted);">@(org.Location ?? "—")</td>
                                <td style="padding: 14px;"><span style="background: #f0f4ed; padding: 2px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 650;">@org.BranchCount branches</span></td>
                                <td style="padding: 14px;"><StatusBadge Status="@org.AccountStatus.ToString()" /></td>
                                <td style="padding: 14px;"><StatusBadge Status="@org.FinancialStatus.ToString()" /></td>
                                <td style="padding: 14px; font-weight: 650;">@org.PlanName</td>
                                <td style="padding: 14px; font-size: 12px; color: var(--muted);">@org.AdminEmail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<PlatformOrganizationDto>? _orgs;
    private string _search = "";
    private string _statusFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        _orgs = await PlatformService.GetOrganizationsOverviewAsync();
    }

    private IEnumerable<PlatformOrganizationDto> FilteredOrgs =>
        (_orgs ?? new List<PlatformOrganizationDto>())
        .Where(o => (string.IsNullOrWhiteSpace(_search) || o.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
                 && (_statusFilter == "All" || o.AccountStatus.ToString() == _statusFilter));

    private void OnSearch(string val) => _search = val;
}
