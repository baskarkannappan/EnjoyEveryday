@page "/teachers"

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject UserService UserService

<PageHero 
    Eyebrow="PEOPLE" 
    Title="Teachers" 
    Subtitle="Less typing. More teaching.">
    <RightContent>
        <button id="addTeacherButton" class="primary" @onclick="OpenAddTeacherModal">
            + Add teacher
        </button>
    </RightContent>
</PageHero>

<div id="teacherGrid" class="people-grid">
    @if (_teachers != null && _teachers.Any())
    {
        @foreach (var teacher in _teachers)
        {
            <div @onclick="() => OpenEditTeacherModal(teacher)" style="cursor: pointer;">
                <PersonCard AvatarInitials="@(teacher.FirstName?.FirstOrDefault().ToString() ?? "?")" 
                            Name="@teacher.DisplayName" 
                            Subtitle="Experience Facilitator" 
                            HighlightTitle="Today's support" 
                            HighlightText="4 experiences planned. Keep room for child-led exploration." />
            </div>
        }
    }
    else if (_teachers != null && !_teachers.Any())
    {
        <p>No teachers found. Generating sample data...</p>
    }
</div>

<TeacherFormModal IsOpen="_isModalOpen"
                  IsEditing="_isEditing"
                  @bind-FirstName="_currentTeacher.FirstName"
                  @bind-LastName="_currentTeacher.LastName"
                  @bind-Email="_currentTeacher.Email"
                  OnClose="CloseDialog"
                  OnSave="SaveTeacherAsync"
                  OnDelete="DeleteTeacherAsync" />

@code {
    private IEnumerable<User>? _teachers;
    private User _currentTeacher = new();
    private bool _isModalOpen = false;
    private bool _isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachersAsync();

        if (_teachers != null && !_teachers.Any())
        {
            await InsertSampleDataAsync();
        }
    }

    private async Task LoadTeachersAsync()
    {
        _teachers = await UserService.GetTeachersAsync();
    }

    private async Task InsertSampleDataAsync()
    {
        await UserService.CreateUserAsync("jane.doe@example.com", "Jane", "Doe", "TEMP_HASH", "Teacher");
        await UserService.CreateUserAsync("john.smith@example.com", "John", "Smith", "TEMP_HASH", "Teacher");
        await LoadTeachersAsync();
    }

    private void OpenAddTeacherModal()
    {
        _currentTeacher = new User();
        _isEditing = false;
        _isModalOpen = true;
    }

    private void OpenEditTeacherModal(User teacher)
    {
        _currentTeacher = new User
        {
            Id = teacher.Id,
            TenantId = teacher.TenantId,
            FirstName = teacher.FirstName,
            LastName = teacher.LastName,
            Email = teacher.Email,
            DisplayName = teacher.DisplayName,
            IsActive = teacher.IsActive
        };
        _isEditing = true;
        _isModalOpen = true;
    }

    private void CloseDialog()
    {
        _isModalOpen = false;
    }

    private async Task SaveTeacherAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentTeacher.FirstName) || string.IsNullOrWhiteSpace(_currentTeacher.LastName) || string.IsNullOrWhiteSpace(_currentTeacher.Email))
        {
            return;
        }

        if (_isEditing)
        {
            await UserService.UpdateUserAsync(_currentTeacher);
        }
        else
        {
            await UserService.CreateUserAsync(
                _currentTeacher.Email,
                _currentTeacher.FirstName,
                _currentTeacher.LastName,
                "TEMP_HASH", "Teacher");
        }

        await LoadTeachersAsync();
        CloseDialog();
    }

    private async Task DeleteTeacherAsync()
    {
        if (_currentTeacher.Id != Guid.Empty)
        {
            await UserService.DeleteUserAsync(_currentTeacher.Id);
            await LoadTeachersAsync();
            CloseDialog();
        }
    }
}



