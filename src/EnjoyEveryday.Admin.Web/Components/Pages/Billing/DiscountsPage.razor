@page "/discounts"
@using EnjoyEveryday.UI.Shared.Components
@rendermode InteractiveServer

<PageTitle>Discounts &amp; Offers — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="COMMERCIAL MANAGEMENT"
              Title="Discounts, Exemptions &amp; Offers"
              Subtitle="Approved discount programs, promotional periods, and financial fee exemptions.">
        <RightContent>
            <a href="/" class="btn secondary">← Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);">
        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
            <thead>
                <tr style="background: var(--surface-soft); font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800; letter-spacing: 0.8px;">
                    <th style="padding: 12px 14px; text-align: left;">Code</th>
                    <th style="padding: 12px 14px; text-align: left;">Program Name</th>
                    <th style="padding: 12px 14px; text-align: left;">Benefit</th>
                    <th style="padding: 12px 14px; text-align: left;">Validity</th>
                    <th style="padding: 12px 14px; text-align: left;">Status</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #edf1ec; font-size: 13.5px;">
                    <td style="padding: 14px; font-weight: 750; color: var(--accent);">PILOT-30</td>
                    <td style="padding: 14px;">Early Adopter Pilot Program</td>
                    <td style="padding: 14px;"><strong>30% Off for 6 months</strong></td>
                    <td style="padding: 14px; color: var(--muted);">Valid through Dec 2026</td>
                    <td style="padding: 14px;"><StatusBadge Status="Active" /></td>
                </tr>
                <tr style="border-bottom: 1px solid #edf1ec; font-size: 13.5px;">
                    <td style="padding: 14px; font-weight: 750; color: var(--accent);">NONPROFIT-EXEMPT</td>
                    <td style="padding: 14px;">Community Cooperative Grant</td>
                    <td style="padding: 14px;"><strong>Annual Fee Exemption</strong></td>
                    <td style="padding: 14px; color: var(--muted);">Approved by Board</td>
                    <td style="padding: 14px;"><StatusBadge Status="Active" /></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
