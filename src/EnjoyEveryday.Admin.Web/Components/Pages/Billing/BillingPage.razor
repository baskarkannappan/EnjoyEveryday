@page "/billing"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@rendermode InteractiveServer

<PageTitle>Commercial Billing &amp; Invoices — Platform Admin</PageTitle>

<div class="content billing-container">
    <PageHero Eyebrow="COMMERCIAL MANAGEMENT"
              Title="Billing &amp; Invoices"
              Subtitle="Administer daycare organization invoices, configure manual vs. automatic billing modes, record payments, and manage ledgers.">
        <RightContent>
            <button class="btn secondary" @onclick="RunScheduledBillingAsync" title="Run scheduled automatic billing for eligible organizations">
                ⚡ Run Scheduled Billing
            </button>
            <button class="btn primary" @onclick="OpenCreateInvoiceModal">
                + Create Draft Invoice
            </button>
        </RightContent>
    </PageHero>

    @if (!string.IsNullOrWhiteSpace(_statusNotification))
    {
        <div style="background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; border-radius: 12px; padding: 12px 18px; font-size: 13.5px; color: var(--accent-dark, #3e6253); display: flex; align-items: center; justify-content: space-between;">
            <span>@_statusNotification</span>
            <button style="background: none; border: none; cursor: pointer; color: var(--accent-dark); font-weight: 700;" @onclick="() => _statusNotification = null">✕</button>
        </div>
    }

    <!-- METRICS GRID -->
    <div class="metrics-grid">
        <div class="metric-card">
            <span class="metric-label">Total Invoiced</span>
            <span class="metric-value">@TotalInvoicedAmount.ToString("C0")</span>
            <span class="metric-sub">Across @_allInvoices.Count invoices</span>
        </div>
        <div class="metric-card">
            <span class="metric-label">Outstanding Balance</span>
            <span class="metric-value" style="color: #b55a5a;">@TotalOutstandingBalance.ToString("C0")</span>
            <span class="metric-sub">@OverdueCount overdue</span>
        </div>
        <div class="metric-card">
            <span class="metric-label">Payments Collected</span>
            <span class="metric-value" style="color: var(--accent-dark, #3e6253);">@TotalAmountPaid.ToString("C0")</span>
            <span class="metric-sub">Reconciled to ledger</span>
        </div>
        <div class="metric-card">
            <span class="metric-label">Active Mode</span>
            <span class="metric-value" style="font-size: 20px; text-transform: uppercase;">@(_currentBillingSettings?.Mode.ToString() ?? "Manual")</span>
            <span class="metric-sub">@(_selectedOrgId.HasValue ? GetOrgName(_selectedOrgId.Value) : "Select an organization")</span>
        </div>
    </div>

    <!-- CONTROLS & ORGANIZATION SELECTOR -->
    <div class="controls-row">
        <div class="filters-left">
            <select class="select-filter" value="@(_selectedOrgId?.ToString() ?? "")" @onchange="OnOrganizationChanged">
                <option value="">All Daycare Organizations</option>
                @foreach (var org in _organizations)
                {
                    <option value="@org.Id">@org.Name</option>
                }
            </select>

            <input class="search-input" placeholder="Filter by invoice # or description..." @bind="_searchQuery" @bind:event="oninput" />
        </div>

        <div class="actions-right">
            @if (_selectedOrgId.HasValue)
            {
                <button class="action-btn" @onclick="OpenBillingSettingsModal">
                    ⚙️ Billing Settings (@(_currentBillingSettings?.Mode.ToString() ?? "Manual"))
                </button>
            }
        </div>
    </div>

    <!-- TABS -->
    <div class="tabs-row">
        <button class="tab-btn @(_activeTab == "All" ? "active" : "")" @onclick='() => _activeTab = "All"'>
            All Invoices (@FilteredInvoices.Count)
        </button>
        <button class="tab-btn @(_activeTab == "Draft" ? "active" : "")" @onclick='() => _activeTab = "Draft"'>
            Drafts (@_allInvoices.Count(i => i.Status == InvoiceStatus.Draft))
        </button>
        <button class="tab-btn @(_activeTab == "Unpaid" ? "active" : "")" @onclick='() => _activeTab = "Unpaid"'>
            Unpaid &amp; Overdue (@_allInvoices.Count(i => i.Status == InvoiceStatus.Unpaid || i.Status == InvoiceStatus.PartiallyPaid || i.Status == InvoiceStatus.Overdue))
        </button>
        <button class="tab-btn @(_activeTab == "Paid" ? "active" : "")" @onclick='() => _activeTab = "Paid"'>
            Paid (@_allInvoices.Count(i => i.Status == InvoiceStatus.Paid))
        </button>
        <button class="tab-btn @(_activeTab == "Void" ? "active" : "")" @onclick='() => _activeTab = "Void"'>
            Void (@_allInvoices.Count(i => i.Status == InvoiceStatus.Void))
        </button>
    </div>

    <!-- INVOICES TABLE -->
    @if (_isLoading)
    {
        <LoadingState Message="Loading invoices and organization ledgers..." />
    }
    else if (!FilteredInvoices.Any())
    {
        <EmptyState Title="No Invoices Found"
                    Description="There are no invoices matching the selected organization and status filters. Click 'Create Draft Invoice' to issue a new invoice." />
    }
    else
    {
        <div class="invoices-card">
            <table class="invoices-table">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Organization</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Balance Due</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in FilteredInvoices)
                    {
                        <tr>
                            <td style="font-weight: 800; color: var(--text);">
                                <span style="font-family: monospace; font-size: 13px;">@inv.InvoiceNumber</span>
                                @if (!string.IsNullOrWhiteSpace(inv.BillingPeriod))
                                {
                                    <span style="font-size: 10px; background: #eaf0eb; padding: 2px 6px; border-radius: 4px; margin-left: 4px;">@inv.BillingPeriod</span>
                                }
                            </td>
                            <td>
                                <div style="font-weight: 700;">@GetOrgName(inv.OrganizationId)</div>
                                <div style="font-size: 11.5px; color: var(--muted);">@inv.Description</div>
                            </td>
                            <td style="color: var(--muted);">@inv.IssueDate.ToString("MMM dd, yyyy")</td>
                            <td style="color: var(--muted);">@inv.DueDate.ToString("MMM dd, yyyy")</td>
                            <td style="font-weight: 800;">@inv.TotalAmount.ToString("C2")</td>
                            <td style="color: var(--accent-dark); font-weight: 700;">@inv.AmountPaid.ToString("C2")</td>
                            <td style="font-weight: 800; color: @(inv.BalanceDue > 0 ? "#b55a5a" : "var(--text)");">
                                @inv.BalanceDue.ToString("C2")
                            </td>
                            <td>
                                <StatusBadge Status="@inv.Status.ToString()" />
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end;">
                                    <button class="action-btn" title="View &amp; Print Document" @onclick="() => OpenPreviewModal(inv)">
                                        📄 View
                                    </button>

                                    @if (inv.Status == InvoiceStatus.Draft)
                                    {
                                        <button class="action-btn" title="Edit Line Items" @onclick="() => OpenEditDraftModal(inv)">
                                            ✏️ Edit
                                        </button>
                                        <button class="action-btn primary-action" title="Publish to Daycare" @onclick="() => PublishInvoice(inv.Id)">
                                            🚀 Publish
                                        </button>
                                    }
                                    else if (inv.Status != InvoiceStatus.Void && inv.BalanceDue > 0)
                                    {
                                        <button class="action-btn primary-action" title="Record In-Person Cash Payment &amp; Issue Receipt" @onclick="() => OpenRecordCashModal(inv)">
                                            💵 Cash
                                        </button>
                                        <button class="action-btn" title="Record Bank Wire / Check Payment" @onclick="() => OpenRecordPaymentModal(inv)">
                                            🏦 Wire/Other
                                        </button>
                                    }

                                    @if (inv.Status != InvoiceStatus.Void && inv.AmountPaid == 0)
                                    {
                                        <button class="action-btn danger-action" title="Void Invoice" @onclick="() => OpenVoidModal(inv)">
                                            Void
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- CREATE / EDIT DRAFT INVOICE MODAL -->
<!-- ========================================== -->
@if (_showInvoiceModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">@(_editingInvoiceId.HasValue ? "UPDATE DRAFT INVOICE" : "NEW INVOICE GENERATOR")</div>
                    <h3 class="modal-title">@(_editingInvoiceId.HasValue ? "Edit Draft Line Items & Dates" : "Create Manual Organization Invoice")</h3>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                @if (!_editingInvoiceId.HasValue)
                {
                    <div class="form-group">
                        <label>Target Daycare Organization *</label>
                        <select class="form-input" @bind="_invoiceOrgId">
                            <option value="">-- Select Daycare Organization --</option>
                            @foreach (var org in _organizations)
                            {
                                <option value="@org.Id">@org.Name</option>
                            }
                        </select>
                    </div>
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>Issue Date *</label>
                        <input type="date" class="form-input" value="@_invoiceIssueDate.ToString("yyyy-MM-dd")" @onchange="e => _invoiceIssueDate = DateTime.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="form-group">
                        <label>Payment Due Date *</label>
                        <input type="date" class="form-input" value="@_invoiceDueDate.ToString("yyyy-MM-dd")" @onchange="e => _invoiceDueDate = DateTime.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="form-group">
                        <label>Currency</label>
                        <select class="form-input" @bind="_invoiceCurrency" disabled title="The entire application currency is INR only.">
                            <option value="INR">INR (₹)</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Invoice Memo / Description</label>
                    <input class="form-input" placeholder="e.g. October 2026 Platform Subscription and Branch Fee" @bind="_invoiceDescription" />
                </div>

                <!-- LINE ITEMS TABLE -->
                <div style="border: 1px solid var(--border); border-radius: 12px; padding: 14px; background: var(--surface-soft);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-weight: 800; font-size: 13px; text-transform: uppercase; color: var(--muted);">Line Items</span>
                        <button type="button" class="action-btn" @onclick="AddLineItem">
                            + Add Line Item
                        </button>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <thead>
                            <tr style="text-align: left; color: var(--muted); font-size: 11px; text-transform: uppercase;">
                                <th style="padding: 6px;">Description</th>
                                <th style="padding: 6px; width: 80px;">Qty</th>
                                <th style="padding: 6px; width: 120px;">Unit Price</th>
                                <th style="padding: 6px; width: 100px;">Total</th>
                                <th style="padding: 6px; width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _lineItems)
                            {
                                <tr>
                                    <td style="padding: 6px;">
                                        <input class="form-input" placeholder="Item description..." @bind="item.Description" />
                                    </td>
                                    <td style="padding: 6px;">
                                        <input type="number" min="1" class="form-input" @bind="item.Quantity" />
                                    </td>
                                    <td style="padding: 6px;">
                                        <input type="number" step="0.01" min="0" class="form-input" @bind="item.UnitPrice" />
                                    </td>
                                    <td style="padding: 6px; font-weight: 750;">
                                        @((item.Quantity * item.UnitPrice).ToString("C2"))
                                    </td>
                                    <td style="padding: 6px; text-align: center;">
                                        <button type="button" style="background: none; border: none; color: #b55a5a; cursor: pointer; font-weight: bold;" @onclick="() => RemoveLineItem(item)">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- TOTALS SUMMARY -->
                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 4px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border);">
                        <div style="font-size: 13px; color: var(--muted);">Subtotal: <strong>@ComputedSubtotal.ToString("C2")</strong></div>
                        <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted);">
                            <span>Tax (%):</span>
                            <input type="number" step="0.1" min="0" max="100" style="width: 70px; padding: 4px 8px;" class="form-input" @bind="_invoiceTaxRate" />
                            <span>= @ComputedTaxAmount.ToString("C2")</span>
                        </div>
                        <div style="font-size: 16px; font-weight: 800; color: var(--text); margin-top: 4px;">
                            Final Total: @ComputedTotalAmount.ToString("C2")
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Remittance Notes &amp; Payment Instructions</label>
                    <textarea class="form-input" rows="2" placeholder="e.g. Please wire transfer to Account #123456789 or send check to..." @bind="_invoicePaymentInstructions"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn secondary" @onclick="SaveAsDraft" disabled="@(!CanSaveDraft)">
                    💾 Save as Draft
                </button>
                <button class="btn primary" @onclick="SaveAndPublish" disabled="@(!CanSaveDraft)">
                    🚀 Publish Immediately
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- RECORD PAYMENT MODAL -->
<!-- ========================================== -->
@if (_showPaymentModal && _selectedInvoiceForAction != null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">RECONCILE LEDGER</div>
                    <h3 class="modal-title">Record Manual Payment</h3>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 12px; padding: 14px; font-size: 13px;">
                    <div>Invoice: <strong>@_selectedInvoiceForAction.InvoiceNumber</strong></div>
                    <div>Organization: <strong>@GetOrgName(_selectedInvoiceForAction.OrganizationId)</strong></div>
                    <div style="margin-top: 6px; font-size: 14px;">Total Amount: <strong>@_selectedInvoiceForAction.TotalAmount.ToString("C2")</strong></div>
                    <div style="color: var(--accent-dark);">Amount Paid: <strong>@_selectedInvoiceForAction.AmountPaid.ToString("C2")</strong></div>
                    <div style="color: #b55a5a; font-weight: 750;">Balance Due: <strong>@_selectedInvoiceForAction.BalanceDue.ToString("C2")</strong></div>
                </div>

                <div class="form-group">
                    <label>Payment Amount * (Max: @_selectedInvoiceForAction.BalanceDue.ToString("C2"))</label>
                    <input type="number" step="0.01" min="0.01" max="@_selectedInvoiceForAction.BalanceDue" class="form-input" @bind="_paymentAmount" />
                </div>

                <div class="form-group">
                    <label>Payment Method *</label>
                    <select class="form-input" @bind="_paymentMethod">
                        <option value="BankTransfer">Bank Wire / Electronic Transfer</option>
                        <option value="ACH">ACH Direct Debit</option>
                        <option value="Check">Business Check</option>
                        <option value="CreditCard">Credit / Debit Card (Manual)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Payment Reference / Transaction # *</label>
                    <input class="form-input" placeholder="e.g. WIRE-8849102 or CHK-4401" @bind="_paymentReference" />
                </div>

                <div class="form-group">
                    <label>Payment Date</label>
                    <input type="date" class="form-input" value="@_paymentDate.ToString("yyyy-MM-dd")" @onchange="e => _paymentDate = DateTime.Parse(e.Value!.ToString()!)" />
                </div>

                <div class="form-group">
                    <label>Internal Audit Notes</label>
                    <input class="form-input" placeholder="Any remarks regarding this payment..." @bind="_paymentNotes" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn primary" @onclick="SubmitPayment" disabled="@(_paymentAmount <= 0 || string.IsNullOrWhiteSpace(_paymentReference))">
                    Confirm &amp; Record Payment
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- RECORD CASH PAYMENT MODAL -->
<!-- ========================================== -->
@if (_showCashPaymentModal && _selectedInvoiceForAction != null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">IN-PERSON CASH COLLECTION</div>
                    <h3 class="modal-title">Record Cash Received</h3>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 12px; padding: 14px; font-size: 13px; margin-bottom: 16px;">
                    <div>Invoice: <strong>@_selectedInvoiceForAction.InvoiceNumber</strong></div>
                    <div>Organization: <strong>@GetOrgName(_selectedInvoiceForAction.OrganizationId)</strong></div>
                    <div style="margin-top: 6px; font-size: 14px;">Total Invoice: <strong>@_selectedInvoiceForAction.TotalAmount.ToString("C2")</strong></div>
                    <div style="color: var(--accent-dark);">Amount Already Paid: <strong>@_selectedInvoiceForAction.AmountPaid.ToString("C2")</strong></div>
                    <div style="color: #b55a5a; font-weight: 750;">Current Outstanding Balance: <strong>@_selectedInvoiceForAction.BalanceDue.ToString("C2")</strong></div>
                </div>

                <div class="form-group">
                    <label>Cash Amount Received * (Max: @_selectedInvoiceForAction.BalanceDue.ToString("C2"))</label>
                    <input type="number" step="0.01" min="0.01" max="@_selectedInvoiceForAction.BalanceDue" class="form-input" @bind="_cashAmount" />
                </div>

                <div class="form-group">
                    <label>Actual Receipt Date *</label>
                    <input type="date" class="form-input" value="@_cashReceiptDate.ToString("yyyy-MM-dd")" @onchange="e => _cashReceiptDate = DateTime.Parse(e.Value!.ToString()!)" />
                </div>

                <div class="form-group">
                    <label>Official Cash Receipt # *</label>
                    <input class="form-input" placeholder="e.g. RCPT-CASH-20261016-1042" @bind="_cashReceiptNumber" />
                    <small style="font-size: 11px; color: var(--muted); display: block; margin-top: 4px;">Auto-generated unique receipt identifier for this daycare organization.</small>
                </div>

                <div class="form-group">
                    <label>Internal Audit Notes / Memo</label>
                    <input class="form-input" placeholder="e.g. Received in person from Director at main daycare office..." @bind="_cashNotes" />
                </div>

                <div style="margin-top: 16px; padding: 12px; background: #eaf1ec; border: 1px solid #c8dacd; border-radius: 10px;">
                    <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 12.5px; font-weight: 650; color: #26332d;">
                        <input type="checkbox" style="margin-top: 3px;" @bind="_cashConfirmed" />
                        <span>I confirm that physical cash has been verified and received in person from the authorized organization representative.</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn primary" @onclick="SubmitCashPayment" disabled="@(_cashAmount <= 0 || _cashAmount > _selectedInvoiceForAction.BalanceDue || string.IsNullOrWhiteSpace(_cashReceiptNumber) || !_cashConfirmed)">
                    Confirm &amp; Record Cash Payment
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- REVERSE PAYMENT MODAL -->
<!-- ========================================== -->
@if (_showReverseModal && _selectedPaymentForReversal != null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">AUDIT &amp; GOVERNANCE</div>
                    <h3 class="modal-title">Reverse Recorded Payment</h3>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <p style="font-size: 13.5px; color: #9b2c2c; margin: 0; background: #fff5f5; border: 1px solid #fed7d7; padding: 12px; border-radius: 10px;">
                    ⚠️ Reversing this payment of <strong>@_selectedPaymentForReversal.Amount.ToString("C2")</strong> (@_selectedPaymentForReversal.PaymentReference) will restore the outstanding balance on the invoice. This action is permanently audited.
                </p>

                <div class="form-group" style="margin-top: 14px;">
                    <label>Reason for Reversal / Correction *</label>
                    <textarea class="form-input" rows="3" placeholder="Provide an explanation for reversing this payment..." @bind="_reversalReason"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn danger-action" @onclick="SubmitReversal" disabled="@(string.IsNullOrWhiteSpace(_reversalReason))">
                    Confirm Audited Reversal
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- VOID INVOICE MODAL -->
<!-- ========================================== -->
@if (_showVoidModal && _selectedInvoiceForAction != null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">AUDIT &amp; GOVERNANCE</div>
                    <h3 class="modal-title">Void Invoice @_selectedInvoiceForAction.InvoiceNumber</h3>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <p style="font-size: 13.5px; color: #9b2c2c; margin: 0; background: #fff5f5; border: 1px solid #fed7d7; padding: 12px; border-radius: 10px;">
                    ⚠️ Voiding an invoice cancels its balance due and removes it from active billing. This action is permanently recorded in the audit log.
                </p>

                <div class="form-group">
                    <label>Reason for Voiding *</label>
                    <textarea class="form-input" rows="3" placeholder="Provide a detailed explanation for this cancellation..." @bind="_voidReason"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn danger-action" @onclick="SubmitVoid" disabled="@(string.IsNullOrWhiteSpace(_voidReason))">
                    Confirm Void
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- BILLING SETTINGS MODAL (MANUAL VS AUTOMATIC) -->
<!-- ========================================== -->
@if (_showSettingsModal && _selectedOrgId.HasValue)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">ORGANIZATION BILLING CONFIGURATION</div>
                    <h3 class="modal-title">@GetOrgName(_selectedOrgId.Value)</h3>
                </div>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Billing Mode</label>
                    <div style="display: flex; gap: 16px; margin-top: 4px;">
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: 500; cursor: pointer;">
                            <input type="radio" name="billingMode" checked="@(_targetBillingMode == BillingMode.Manual)" @onchange="() => _targetBillingMode = BillingMode.Manual" />
                            <span><strong>Manual</strong> — Admin creates &amp; publishes invoices</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: 500; cursor: pointer;">
                            <input type="radio" name="billingMode" checked="@(_targetBillingMode == BillingMode.Automatic)" @onchange="() => _targetBillingMode = BillingMode.Automatic" />
                            <span><strong>Automatic</strong> — System generates on schedule</span>
                        </label>
                    </div>
                </div>

                @if (_targetBillingMode == BillingMode.Automatic)
                {
                    <div class="form-group">
                        <label>Billing Frequency</label>
                        <select class="form-input" @bind="_targetFrequency">
                            <option value="@BillingFrequency.Monthly">Monthly</option>
                            <option value="@BillingFrequency.Quarterly">Quarterly</option>
                            <option value="@BillingFrequency.Annual">Annual</option>
                        </select>
                    </div>
                }

                <div class="form-group">
                    <label>Effective Date</label>
                    <input type="date" class="form-input" value="@_targetEffectiveDate.ToString("yyyy-MM-dd")" @onchange="e => _targetEffectiveDate = DateTime.Parse(e.Value!.ToString()!)" />
                </div>

                <!-- CONSEQUENCE SUMMARY -->
                <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 12px; padding: 14px; font-size: 13px;">
                    <div style="font-weight: 750; margin-bottom: 6px; color: var(--text);">Policy Summary:</div>
                    @if (_targetBillingMode == BillingMode.Automatic)
                    {
                        <div style="color: var(--muted); line-height: 1.4;">
                            ✓ All existing invoices and payments are strictly preserved.<br />
                            ✓ First scheduled invoice will generate on the effective date.<br />
                            ✓ Periods that already have an invoice will never be duplicated.
                        </div>
                    }
                    else
                    {
                        <div style="color: var(--muted); line-height: 1.4;">
                            ✓ Stops future automatic scheduled invoice generation.<br />
                            ✓ All outstanding balances and published invoices remain visible.<br />
                            ✓ Authorized admins can create, publish, and manage manual invoices anytime.
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label>Reason / Audit Remark</label>
                    <input class="form-input" placeholder="e.g. Switched to automatic recurring billing upon contract renewal" @bind="_billingSettingsReason" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn primary" @onclick="SubmitBillingSettings">
                    Save Configuration
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- PRINTABLE INVOICE PREVIEW MODAL -->
<!-- ========================================== -->
<InvoiceDetailsModal 
    IsOpen="@(_showPreviewModal && _selectedInvoiceForAction != null)"
    Invoice="@_selectedInvoiceForAction"
    OrganizationName="@(_selectedInvoiceForAction != null ? GetOrgName(_selectedInvoiceForAction.OrganizationId) : "")"
    Payments="@_invoicePayments"
    OnClose="CloseModals"
    OnPrint="PrintInvoice">
    <PaymentActions Context="p">
        <div style="display: flex; gap: 6px; justify-content: flex-end;">
            <a href="/api/billing/payments/@p.Id/receipt" target="_blank" class="invoice-receipt-link">📄 Receipt</a>
            @if (!p.IsReversed && p.Status == PaymentStatus.Completed)
            {
                <button class="btn secondary" style="color: #9b2c2c; padding: 2px 7px; font-size: 11px;" @onclick="() => OpenReverseModal(p)">⚠️ Reverse</button>
            }
        </div>
    </PaymentActions>
</InvoiceDetailsModal>



