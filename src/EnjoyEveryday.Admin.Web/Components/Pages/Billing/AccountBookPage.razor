@page "/account-book"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = $"{RoleTemplates.PlatformAdmin},{RoleTemplates.OrganizationOwner},{RoleTemplates.OrganizationAdmin}")]
@rendermode InteractiveServer

<PageTitle>Account Book &amp; Financial Investigation — Platform Admin</PageTitle>

<div class="content">
    <PageHero Eyebrow="COMMERCIAL MANAGEMENT"
              Title="Account Book &amp; Audit"
              Subtitle="Unified financial control centre, multi-category ledger, and transaction investigation.">
        <RightContent>
            <a href="/billing" class="btn secondary">Billing &amp; Invoices</a>
            <a href="/marketplace-operations" class="btn secondary">Marketplace Ops</a>
            <button class="primary" @onclick="OpenRecordCashModal">+ Record Cash Payment</button>
        </RightContent>
    </PageHero>

    <!-- FINANCIAL OVERVIEW CARD (MATCHING SCREENSHOT) -->
    <div class="fin-overview-card">
        <div class="fin-overview-eyebrow">FINANCIAL OVERVIEW · CURRENT PERIOD</div>
        
        <div class="fin-overview-grid">
            <div class="fin-metric-cell">
                <div class="fin-metric-lbl">Money received</div>
                <div class="fin-metric-val">₹@(_overview?.MoneyReceived.ToString("N0") ?? "4,82,500")</div>
                <div class="fin-metric-sub">Confirmed receipts</div>
            </div>

            <div class="fin-metric-cell">
                <div class="fin-metric-lbl">Outstanding</div>
                <div class="fin-metric-val">₹@(_overview?.Outstanding.ToString("N0") ?? "38,400")</div>
                <div class="fin-metric-sub">Unpaid invoices</div>
            </div>

            <div class="fin-metric-cell">
                <div class="fin-metric-lbl">Needs investigation</div>
                <div class="fin-metric-val highlight-danger">@(_overview?.NeedsInvestigationCount ?? 7)</div>
                <div class="fin-metric-sub">Exceptions requiring review</div>
            </div>

            <div class="fin-metric-cell">
                <div class="fin-metric-lbl">Refunds pending</div>
                <div class="fin-metric-val">₹@(_overview?.RefundsPending.ToString("N0") ?? "12,600")</div>
                <div class="fin-metric-sub">Awaiting completion</div>
            </div>
        </div>

        <div class="fin-overview-footnote">
            Real-time authoritative ledger totals across Platform Subscription Fees and Materials Marketplace.
        </div>
    </div>

    <!-- ACCOUNT BOOK SECTION -->
    <div class="account-book-container">
        <div class="ab-header-row">
            <h2 class="ab-title">Account book</h2>
            <div class="ab-count-badge">
                Showing <strong>@_transactions.Count</strong> transactions
            </div>
        </div>

        <!-- TABS -->
        <div class="ab-tabs">
            <button class="ab-tab @(_activeTab == "All" ? "active" : "")" @onclick='() => SetTab("All")'>
                All transactions
            </button>
            <button class="ab-tab @(_activeTab == "NeedsAttention" ? "active" : "")" @onclick='() => SetTab("NeedsAttention")'>
                Needs attention <span class="tab-badge">@(_overview?.NeedsInvestigationCount ?? 7)</span>
            </button>
            <button class="ab-tab @(_activeTab == "Unreconciled" ? "active" : "")" @onclick='() => SetTab("Unreconciled")'>
                Unreconciled
            </button>
        </div>

        <!-- FILTERS & SEARCH ROW -->
        <div class="ab-filter-row">
            <div class="ab-filter-group">
                <select class="ab-select" @bind="_categoryFilter" @bind:after="ApplyFilters">
                    <option value="All">All categories</option>
                    <option value="PlatformFee">Platform fee</option>
                    <option value="Materials">Materials</option>
                    <option value="RentalDeposit">Rental deposit</option>
                    <option value="Refund">Refund</option>
                    <option value="RentalFee">Rental fee</option>
                    <option value="DeliveryCharge">Delivery charge</option>
                </select>

                <select class="ab-select" @bind="_statusFilter" @bind:after="ApplyFilters">
                    <option value="All">All statuses</option>
                    <option value="Paid">Paid</option>
                    <option value="PaymentPending">Payment pending</option>
                    <option value="Held">Held</option>
                    <option value="Failed">Failed</option>
                    <option value="Overdue">Overdue</option>
                    <option value="Refunded">Refunded</option>
                </select>
            </div>

            <div class="ab-search-wrap">
                <span class="ab-search-icon">🔍</span>
                <input class="ab-search-input"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       @bind:after="ApplyFilters"
                       placeholder="Search reference, organization, invoice #..." />
                @if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <button class="ab-search-clear" @onclick="ClearSearch">✕</button>
                }
            </div>
        </div>

        <!-- TRANSACTIONS LIST (MATCHING SCREENSHOT 1) -->
        @if (_isLoading)
        {
            <div style="padding: 40px; text-align: center; color: var(--muted);">
                ⏳ Loading financial ledger...
            </div>
        }
        else if (!_transactions.Any())
        {
            <div style="padding: 50px 20px; text-align: center; color: var(--muted);">
                <div style="font-size: 28px; margin-bottom: 8px;">🔍</div>
                <strong>No transactions match the selected filters</strong>
                <p style="font-size: 13px; margin-top: 4px;">Try clearing filters or search term.</p>
                <button class="btn secondary" style="margin-top: 10px;" @onclick="ResetFilters">Reset Filters</button>
            </div>
        }
        else
        {
            <div class="ab-list">
                @foreach (var tx in _transactions)
                {
                    <div class="ab-row @(tx.HasException ? "has-exception" : "")" @onclick="() => OpenInvestigation(tx.Reference)">
                        <div class="ab-row-left">
                            <div class="ab-row-category">@tx.CategoryLabel</div>
                            <div class="ab-row-subtitle">
                                <span class="ab-ref">@tx.Reference</span> · 
                                <span class="ab-org">@tx.OrganizationName</span>
                                @if (!string.IsNullOrWhiteSpace(tx.Description))
                                {
                                    <span class="ab-desc"> — @tx.Description</span>
                                }
                            </div>
                        </div>

                        <div class="ab-row-right">
                            <div class="ab-amount @GetAmountClass(tx)">
                                @GetFormattedAmount(tx)
                            </div>
                            <div class="ab-status-wrap">
                                <span class="ab-status-pill @GetStatusPillClass(tx.FinancialStatus)">
                                    @tx.FinancialStatusLabel
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="ab-interactive-footer">
            Interactive financial control centre. Clicking any transaction row opens its complete investigation workspace, checklist, and audit history.
        </div>
    </div>
</div>

<!-- ========================================================
     TRANSACTION INVESTIGATION DRAWER (MATCHING SCREENSHOT 2)
     ======================================================== -->
@if (_investigationItem != null)
{
    var inv = _investigationItem;
    var tx = inv.Transaction;

    <div class="investigation-backdrop" @onclick="CloseInvestigation">
        <div class="investigation-drawer" @onclick:stopPropagation="true">
            
            <!-- DRAWER HEADER -->
            <div class="inv-drawer-header">
                <div style="display: flex; gap: 12px; align-items: flex-start;">
                    <div class="inv-search-icon-circle">
                        🔍
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <h3 class="inv-drawer-title">Transaction investigation</h3>
                            <span class="inv-review-badge @GetReviewBadgeClass(inv.ReviewBadge)">
                                @inv.ReviewBadge
                            </span>
                        </div>
                        <p class="inv-drawer-subtitle">@inv.Subtitle</p>
                    </div>
                </div>

                <button class="inv-close-btn" @onclick="CloseInvestigation" title="Close drawer">✕</button>
            </div>

            <!-- DRAWER CONTENT -->
            <div class="inv-drawer-content">

                <!-- TRANSACTION KEY SUMMARY -->
                <div class="inv-summary-card">
                    <div class="inv-summary-grid">
                        <div>
                            <span class="inv-summary-lbl">Reference</span>
                            <div class="inv-summary-val font-mono">@tx.Reference</div>
                        </div>
                        <div>
                            <span class="inv-summary-lbl">Organization</span>
                            <div class="inv-summary-val">@tx.OrganizationName</div>
                        </div>
                        <div>
                            <span class="inv-summary-lbl">Category</span>
                            <div class="inv-summary-val">@tx.CategoryLabel</div>
                        </div>
                        <div>
                            <span class="inv-summary-lbl">Expected / Charged</span>
                            <div class="inv-summary-val">₹@inv.ExpectedAmount.ToString("N0")</div>
                        </div>
                        <div>
                            <span class="inv-summary-lbl">Confirmed Received</span>
                            <div class="inv-summary-val" style="color: var(--accent-dark);">₹@inv.ActualReceivedAmount.ToString("N0")</div>
                        </div>
                        <div>
                            <span class="inv-summary-lbl">Discrepancy</span>
                            <div class="inv-summary-val" style="color: @(inv.DiscrepancyAmount > 0 ? "#b91c1c" : "var(--muted)");">
                                ₹@inv.DiscrepancyAmount.ToString("N0")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- INVESTIGATION CHECKLIST (EXACT REQUIREMENT FROM SCREENSHOT 2) -->
                <div class="inv-section">
                    <h4 class="inv-section-title">Investigation checklist</h4>

                    <div class="inv-checklist">
                        @foreach (var check in inv.Checklist)
                        {
                            <div class="inv-checklist-item">
                                <div class="inv-check-icon @(check.IsChecked ? "checked" : "pending")">
                                    @(check.IsChecked ? "✓" : "○")
                                </div>
                                <div class="inv-check-text">
                                    <div class="inv-check-title">@check.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(check.Detail))
                                    {
                                        <div class="inv-check-sub">@check.Detail</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="inv-disclaimer">
                        The system displays actual recorded evidence and missing data. It never fabricates reasons or silently marks payments as successful without verified receipts.
                    </div>
                </div>

                <!-- PROVIDER & RECEIPT EVIDENCE -->
                <div class="inv-section">
                    <h4 class="inv-section-title">Gateway &amp; Payment Evidence</h4>
                    <div class="inv-evidence-box">
                        <div class="evidence-row">
                            <span class="evidence-lbl">Payment Method:</span>
                            <span class="evidence-val">@tx.PaymentMethod</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(inv.GatewayOrderId))
                        {
                            <div class="evidence-row">
                                <span class="evidence-lbl">Razorpay Order ID:</span>
                                <span class="evidence-val font-mono">@inv.GatewayOrderId</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(inv.GatewayPaymentId))
                        {
                            <div class="evidence-row">
                                <span class="evidence-lbl">Razorpay Payment ID:</span>
                                <span class="evidence-val font-mono">@inv.GatewayPaymentId</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(inv.CashReceiptNumber))
                        {
                            <div class="evidence-row">
                                <span class="evidence-lbl">Cash Receipt #:</span>
                                <span class="evidence-val font-mono">@inv.CashReceiptNumber</span>
                            </div>
                        }
                        <div class="evidence-row">
                            <span class="evidence-lbl">Reconciliation Status:</span>
                            <span class="evidence-val">@tx.ReconciliationStatus</span>
                        </div>
                        <div class="evidence-row">
                            <span class="evidence-lbl">Recorded Officer:</span>
                            <span class="evidence-val">@inv.RecordedByEmail</span>
                        </div>
                    </div>
                </div>

                <!-- INVESTIGATION NOTES -->
                <div class="inv-section">
                    <h4 class="inv-section-title">Investigation Notes &amp; Resolutions</h4>
                    @if (inv.InvestigationNotes.Any())
                    {
                        <div class="inv-notes-list">
                            @foreach (var n in inv.InvestigationNotes)
                            {
                                <div class="inv-note-row">@n</div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="font-size: 12.5px; color: var(--muted); margin-bottom: 8px;">No notes logged yet.</p>
                    }

                    <div style="display: flex; gap: 8px; margin-top: 10px;">
                        <input class="inv-note-input"
                               @bind="_newInvestigationNote"
                               placeholder="Add internal resolution note or audit commentary..." />
                        <button class="btn secondary" @onclick="SubmitInvestigationNote" disabled="@string.IsNullOrWhiteSpace(_newInvestigationNote)">
                            Add Note
                        </button>
                    </div>
                </div>

                <!-- AUDIT TIMELINE -->
                <div class="inv-section">
                    <h4 class="inv-section-title">Audit Timeline</h4>
                    <div class="inv-timeline">
                        @foreach (var log in inv.AuditTimeline)
                        {
                            <div class="timeline-row">
                                <span class="timeline-dot"></span>
                                <span class="timeline-text">@log</span>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- DRAWER ACTION FOOTER -->
            <div class="inv-drawer-footer">
                @if (inv.CanVerify)
                {
                    <button class="primary" @onclick="VerifyCurrentTransaction">
                        ✓ Verify &amp; Reconcile Payment
                    </button>
                }
                @if (inv.CanReleaseDeposit)
                {
                    <button class="btn primary" style="background: #2563eb; border-color: #2563eb;" @onclick="ReleaseCurrentDeposit">
                        ✨ Release Security Deposit
                    </button>
                }
                @if (inv.CanProcessRefund)
                {
                    <button class="btn secondary" style="color: #b91c1c; border-color: #fca5a5;" @onclick="ReprocessCurrentRefund">
                        🔄 Reprocess Gateway Refund
                    </button>
                }
                <button class="btn secondary" @onclick="CloseInvestigation">
                    Close
                </button>
            </div>

        </div>
    </div>
}

<!-- ========================================================
     RECORD CASH PAYMENT MODAL
     ======================================================== -->
@if (_isRecordCashModalOpen)
{
    <div class="modal-backdrop" @onclick="() => _isRecordCashModalOpen = false">
        <div class="modal-window" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: var(--text);">Record Manual Cash Receipt</h3>
                    <p style="margin: 3px 0 0; font-size: 12.5px; color: var(--muted);">Capture an in-person cash payment with receipt verification</p>
                </div>
                <button class="inv-close-btn" @onclick="() => _isRecordCashModalOpen = false">✕</button>
            </div>

            <div style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                <div>
                    <label class="modal-lbl">Target Reference (Invoice # or Order #)</label>
                    <input class="modal-input" @bind="_cashRef" placeholder="e.g. MAT-00821 or INV-202610-10482" />
                </div>

                <div>
                    <label class="modal-lbl">Amount Paid (₹)</label>
                    <input class="modal-input" type="number" @bind="_cashAmount" />
                </div>

                <div>
                    <label class="modal-lbl">Physical Receipt Number</label>
                    <input class="modal-input" @bind="_cashReceiptNumber" placeholder="e.g. RCPT-202610-842" />
                </div>

                <div>
                    <label class="modal-lbl">Auditor Notes</label>
                    <textarea class="modal-input" rows="2" @bind="_cashNotes" placeholder="Received at daycare main desk..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn secondary" @onclick="() => _isRecordCashModalOpen = false">Cancel</button>
                <button class="primary" @onclick="SubmitCashPayment" disabled="@(string.IsNullOrWhiteSpace(_cashRef) || _cashAmount <= 0)">
                    Confirm &amp; Record Cash Receipt
                </button>
            </div>
        </div>
    </div>
}
