@page "/harvest"
<PageHero 
    Eyebrow="EXPERIENCE MEMORY" 
    Title="Harvest & Insights" 
    Subtitle="What happened matters more than simply completing the activity.">
</PageHero>
<div class="insight">
    <div class="insight-icon">💡</div>
    <div>
        <strong>Your daycare is learning.</strong>
        <p>
            42 experiences happened this month.
            31 received teacher feedback.
            8 patterns were discovered.
        </p>
    </div>
</div>
<div class="harvest-layout">
    <div class="panel">
        <h3>Experience performance</h3>
        <div class="panel-description">
            Program signals — not child scores.
        </div>
        <div class="harvest-row harvest-heading">
            <span>EXPERIENCE</span>
            <span>USES</span>
            <span>RESPONSE</span>
            <span>INSIGHT</span>
        </div>
        <HarvestRow Title="Our Little City" Subtitle="Created by Priya" Uses="12" Response="💬 10" />
        <HarvestRow Title="Frog Rescue" Subtitle="AI + Teacher" Uses="8" Response="💬 6" />
        <HarvestRow Title="Giant Painting" Subtitle="Created by Daniel" Uses="6" Response="💬 5" />
    </div>
    <div class="panel">
        <h3>What teachers are saying</h3>
        <div class="panel-description">
            Recent feedback
        </div>
        <TeacherQuote QuoteText="The children loved jumping but lost interest after five minutes." AuthorInfo="Priya &middot; Bluebirds" />
        <TeacherQuote QuoteText="Adding animals completely changed the experience." AuthorInfo="Sarah &middot; Butterflies" />
    </div>
</div>
<div class="flywheel">
    <div class="flywheel-step active">
        <span>1</span>
        <strong>Create</strong>
    </div>
    <span>↻</span>
    <div class="flywheel-step active">
        <span>2</span>
        <strong>Experience</strong>
    </div>
    <span>↻</span>
    <div class="flywheel-step">
        <span>3</span>
        <strong>Harvest</strong>
    </div>
    <span>↻</span>
    <div class="flywheel-step">
        <span>4</span>
        <strong>Adapt</strong>
    </div>
</div>
@code {
}
