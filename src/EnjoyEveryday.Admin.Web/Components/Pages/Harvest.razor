@page "/harvest"
 
    <div class="page-header">

        <div>

            <div class="eyebrow">
                EXPERIENCE MEMORY
            </div>

            <h2>
                Harvest &amp; Insights
            </h2>

            <p>
                What happened matters more than simply
                completing the activity.
            </p>

        </div>

    </div>


    <div class="insight">

        <div class="insight-icon">
            ✦
        </div>

        <div>

            <strong>
                Your daycare is learning.
            </strong>

            <p>
                42 experiences happened this month.
                31 received teacher feedback.
                8 patterns were discovered.
            </p>

        </div>

    </div>


    <div class="harvest-layout">


        <div class="panel">

            <h3>
                Experience performance
            </h3>

            <div class="panel-description">
                Program signals — not child scores.
            </div>


            <div class="harvest-row harvest-heading">

                <span>
                    EXPERIENCE
                </span>

                <span>
                    USES
                </span>

                <span>
                    RESPONSE
                </span>

                <span>
                    INSIGHT
                </span>

            </div>


            <div class="harvest-row">

                <span>

                    <strong>
                        Our Little City
                    </strong>

                    <small>
                        Created by Priya
                    </small>

                </span>

                <span>
                    12
                </span>

                <span>
                    ♥ 10
                </span>

                <button class="text-button insight-button" data-insight="city">

                    View

                </button>

            </div>


            <div class="harvest-row">

                <span>

                    <strong>
                        Frog Rescue
                    </strong>

                    <small>
                        AI + Teacher
                    </small>

                </span>

                <span>
                    8
                </span>

                <span>
                    ● 6
                </span>

                <button class="text-button insight-button" data-insight="frog">

                    View

                </button>

            </div>


            <div class="harvest-row">

                <span>

                    <strong>
                        Giant Painting
                    </strong>

                    <small>
                        Created by Daniel
                    </small>

                </span>

                <span>
                    6
                </span>

                <span>
                    ♥ 5
                </span>

                <button class="text-button insight-button" data-insight="painting">

                    View

                </button>

            </div>


        </div>


        <div class="panel">

            <h3>
                What teachers are saying
            </h3>

            <div class="panel-description">
                Recent feedback
            </div>


            <div class="quote">

                <div class="quote-mark">
                    “
                </div>

                <p>
                    The children loved jumping but lost
                    interest after five minutes.
                </p>

                <small>
                    — Priya · Bluebirds
                </small>

            </div>


            <div class="quote">

                <div class="quote-mark">
                    “
                </div>

                <p>
                    Adding animals completely changed
                    the experience.
                </p>

                <small>
                    — Sarah · Butterflies
                </small>

            </div>

        </div>


    </div>


    <div class="flywheel">


        <div class="flywheel-step active">
            <span>1</span>
            <strong>Create</strong>
        </div>

        <span>→</span>

        <div class="flywheel-step active">
            <span>2</span>
            <strong>Schedule</strong>
        </div>

        <span>→</span>

        <div class="flywheel-step active">
            <span>3</span>
            <strong>Experience</strong>
        </div>

        <span>→</span>

        <div class="flywheel-step active">
            <span>4</span>
            <strong>Harvest</strong>
        </div>

        <span>→</span>

        <div class="flywheel-step">
            <span>5</span>
            <strong>Improve</strong>
        </div>

        <span>→</span>

        <div class="flywheel-step">
            <span>6</span>
            <strong>Reuse</strong>
        </div>


    </div>
 