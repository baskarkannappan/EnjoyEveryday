@page "/planner"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject PlannerService PlannerService
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject ExperienceService ExperienceService
@inject EnjoyEveryday.Shared.Data.IDbConnectionFactory DbConnectionFactory
@using Dapper
@rendermode InteractiveServer
 <section id="page-planner" class="page active">
    <PageHero 
        Eyebrow="PLAN THE MONTH" 
        Title="@_currentDate.ToString("MMMM yyyy")" 
        Subtitle="Give the month a rhythm. Leave room for children to lead.">
        <RightContent>
            <div class="planner-controls">
                <button id="generateMonthButton" class="secondary">? Generate with AI</button>
                <button id="publishMonthButton" class="primary">Publish month</button>
            </div>
        </RightContent>
    </PageHero>
    <div class="month-settings">
        <div class="field">
            <label>
                MONTH THEME
            </label>
            <input id="monthTheme" value="Our World">
        </div>
        <div class="field">
            <label>
                EXPERIENCES / WEEK
            </label>
            <select>
                <option>
                    3
                </option>
                <option>
                    4
                </option>
                <option>
                    5
                </option>
            </select>
        </div>
        <div class="field">
            <label>
                OUTDOOR
            </label>
            <select>
                <option>
                    At least 1 / week
                </option>
                <option>
                    At least 2 / week
                </option>
            </select>
        </div>
        <div class="field">
            <label>
                CREATIVE
            </label>
            <select>
                <option>
                    At least 1 / week
                </option>
                <option>
                    At least 2 / week
                </option>
            </select>
        </div>
    </div>
    <div class="planner-layout">
        <div class="calendar">
            <div class="calendar-header">
                <button id="previousMonth" class="calendar-arrow" @onclick="PreviousMonth">
                    &lt;
                </button>
                <strong>
                    @_currentDate.ToString("MMMM yyyy")
                </strong>
                <button id="nextMonth" class="calendar-arrow" @onclick="NextMonth">
                    &gt;
                </button>
            </div>
            <div class="week">
                <div>MON</div>
                <div>TUE</div>
                <div>WED</div>
                <div>THU</div>
                <div>FRI</div>
            </div>
            <div id="calendarGrid" class="calendar-grid">
                @for (int day = 1; day <= DateTime.DaysInMonth(_currentDate.Year, _currentDate.Month); day++)
                {
                    var iterDay = day;
                    var currentDate = new DateOnly(_currentDate.Year, _currentDate.Month, iterDay);
                    var dailySchedules = _schedules.Where(s => s.ScheduledDate == currentDate).OrderBy(s => s.TimeOfDay).ToList();
                    <div class="day">
                        <div class="day-number @(currentDate == DateOnly.FromDateTime(DateTime.Today) ? "today" : "")">
                            @iterDay
                            <button class="text-button" style="float: right; padding: 0; min-width: auto; font-size: 14px;" @onclick='() => OpenScheduleDialog(currentDate, "Morning")'>+</button>
                        </div>
                        @foreach (var schedule in dailySchedules)
                        {
                            var experience = _experiences.FirstOrDefault(e => e.Id == schedule.ExperienceId);
                            if (experience != null)
                            {
                                <div class="scheduled @(schedule.Status == "Suggested" ? "suggested" : "")" style="cursor: pointer;" @onclick="() => EditSchedule(schedule)">
                                    <strong>@experience.Title</strong>
                                    <span>
                                        @GetExperienceType(experience) &middot; @schedule.TimeOfDay
                                    </span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
        <div class="planner-side">
            <div class="panel">
                <h3>
                    Month balance
                </h3>
                <div class="panel-description">
                    Program rhythm
                </div>
                <BalanceRow Label="Explore" Percentage="72" Value="4" />
                <BalanceRow Label="Create" Percentage="55" Value="3" />
                <BalanceRow Label="Together" Percentage="55" Value="3" />
                <BalanceRow Label="Move" Percentage="38" Value="2" />
            </div>
            <div class="panel ai-planner">
                <div class="ai-symbol">
                    ?
                </div>
                <h3 style="margin-top:12px">
                    AI noticed something
                </h3>
                <p class="panel-description">
                    Children recently enjoyed building,
                    movement and animal experiences.
                </p>
                <button id="addAISuggestion" class="text-button">
                    Add suggestion â†’
                </button>
            </div>
        </div>
    </div>
</section>

@if (_isModalOpen)
{
    <ExperienceScheduleFormModal IsOpen="_isModalOpen"
                                 IsEditing="_currentScheduleId.HasValue"
                                 DialogDate="_dialogDate"
                                 @bind-SelectedExperienceId="_dialogSelectedExperienceId"
                                 @bind-TimeOfDay="_dialogTimeOfDay"
                                 ExperienceOptions="@(_experiences.Select(e => new KeyValuePair<string, string>(e.Id.ToString(), e.Title)))"
                                 OnClose="CloseDialog"
                                 OnSave="ConfirmSchedule"
                                 OnDelete="DeleteSchedule" />
}
@code {
    private DateOnly _currentDate;
    private DateTime? _currentDateTime;
    private List<Classroom> _classrooms = new();
    private string? _selectedClassroomId;
    private List<Experience> _experiences = new();
    private List<ExperienceSchedule> _schedules = new();
    // Dialog state
    private DateOnly _dialogDate;
    private bool _isModalOpen = false;
    private string _dialogTimeOfDay = string.Empty;
    private string? _dialogSelectedExperienceId;
    private Guid? _currentScheduleId;
    protected override async Task OnInitializedAsync()
    {
        // Set to current week's Monday
        var today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        _currentDate = DateOnly.FromDateTime(today.AddDays(-1 * diff));
        _currentDateTime = _currentDate.ToDateTime(TimeOnly.MinValue);
        
        using var connection = await DbConnectionFactory.CreateConnectionAsync();
        var fallbackId = await connection.QueryFirstOrDefaultAsync<Guid?>("SELECT id FROM classrooms LIMIT 1");
        if (fallbackId.HasValue && fallbackId.Value != Guid.Empty)
        {
            _selectedClassroomId = fallbackId.Value.ToString();
        }

        _experiences = (await ExperienceService.GetExperiencesAsync()).ToList();
        
        await LoadSchedules();
        CloseDialog();
    }
    private async Task LoadSchedules()
    {
        if (string.IsNullOrEmpty(_selectedClassroomId)) return;
        StateHasChanged();
        var cid = Guid.Parse(_selectedClassroomId);
        // Load for current month
        _schedules = (await PlannerService.GetMonthlyScheduleAsync(cid, _currentDate.Year, _currentDate.Month)).ToList();
        StateHasChanged();
    }
        private async Task OnCalendarValueChanged()
    {
        if (_currentDateTime.HasValue)
        {
            _currentDate = DateOnly.FromDateTime(_currentDateTime.Value);
                    if (string.IsNullOrEmpty(_selectedClassroomId))
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            var fallbackId = await connection.QueryFirstOrDefaultAsync<Guid?>("SELECT id FROM classrooms LIMIT 1");
            if (fallbackId.HasValue && fallbackId.Value != Guid.Empty)
            {
                _selectedClassroomId = fallbackId.Value.ToString();
            }
        }

        await LoadSchedules();
        CloseDialog();
        }
    }

    private void PreviousMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        _ = LoadSchedules();
    }
    private void NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        _ = LoadSchedules();
    }
    private void NextWeek()
    {
        _currentDate = _currentDate.AddDays(7);
        _ = LoadSchedules();
    }
    private IEnumerable<ExperienceSchedule> GetSchedulesForDay(DateOnly date, string timeOfDay)
    {
        return _schedules.Where(s => s.ScheduledDate == date && s.TimeOfDay == timeOfDay);
    }
    private string GetExperienceTitle(Guid experienceId)
    {
        return _experiences.FirstOrDefault(e => e.Id == experienceId)?.Title ?? "Unknown";
    }
    private void OpenExperience(Guid experienceId)
    {
        // Typically navigates to a viewer
    }
    private void OpenScheduleDialog(DateOnly date, string timeOfDay)
    {
        _currentScheduleId = null;
        _dialogDate = date;
        _dialogTimeOfDay = timeOfDay;
        if (_experiences.Any())
        {
            _dialogSelectedExperienceId = _experiences.First().Id.ToString();
        }
        _isModalOpen = true;
    }

    private void EditSchedule(ExperienceSchedule schedule)
    {
        _currentScheduleId = schedule.Id;
        _dialogDate = schedule.ScheduledDate;
        _dialogTimeOfDay = schedule.TimeOfDay;
        _dialogSelectedExperienceId = schedule.ExperienceId.ToString();
        _isModalOpen = true;
    }

    private async Task DeleteSchedule()
    {
        if (_currentScheduleId.HasValue)
        {
            await PlannerService.DeleteScheduleAsync(_currentScheduleId.Value);
                    if (string.IsNullOrEmpty(_selectedClassroomId))
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            var fallbackId = await connection.QueryFirstOrDefaultAsync<Guid?>("SELECT id FROM classrooms LIMIT 1");
            if (fallbackId.HasValue && fallbackId.Value != Guid.Empty)
            {
                _selectedClassroomId = fallbackId.Value.ToString();
            }
        }

        await LoadSchedules();
            CloseDialog();
        }
    }

    private void CloseDialog()
    {
        _isModalOpen = false;
    }

    private async Task ConfirmSchedule()
    {
        if (string.IsNullOrEmpty(_dialogSelectedExperienceId) || string.IsNullOrEmpty(_selectedClassroomId)) return;
        var expId = Guid.Parse(_dialogSelectedExperienceId);
        var clsId = Guid.Parse(_selectedClassroomId);
        
        if (_currentScheduleId.HasValue)
        {
            var scheduleToUpdate = _schedules.FirstOrDefault(s => s.Id == _currentScheduleId.Value);
            if (scheduleToUpdate != null)
            {
                scheduleToUpdate.ExperienceId = expId;
                scheduleToUpdate.TimeOfDay = _dialogTimeOfDay;
                scheduleToUpdate.ScheduledDate = _dialogDate;
                await PlannerService.UpdateScheduleAsync(scheduleToUpdate);
            }
        }
        else
        {
            await PlannerService.ScheduleExperienceAsync(expId, clsId, _dialogDate, _dialogTimeOfDay);
        }
        
                if (string.IsNullOrEmpty(_selectedClassroomId))
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            var fallbackId = await connection.QueryFirstOrDefaultAsync<Guid?>("SELECT id FROM classrooms LIMIT 1");
            if (fallbackId.HasValue && fallbackId.Value != Guid.Empty)
            {
                _selectedClassroomId = fallbackId.Value.ToString();
            }
        }

        await LoadSchedules();
        CloseDialog();
    }
    private string GetExperienceType(Experience experience)
    {
        if (string.IsNullOrEmpty(experience.DnaPayload)) return "Experience";
        try 
        {
            var json = System.Text.Json.JsonDocument.Parse(experience.DnaPayload);
            if (json.RootElement.TryGetProperty("type", out var typeElement))
            {
                return typeElement.GetString() ?? "Experience";
            }
        }
        catch { }
        return "Experience";
    }
}

