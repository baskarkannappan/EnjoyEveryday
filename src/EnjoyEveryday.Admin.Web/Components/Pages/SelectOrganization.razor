@page "/select-organization"
@using Dapper
@using EnjoyEveryday.Shared.Data
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IDbConnectionFactory DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Select Organization — EnjoyEveryday Platform</PageTitle>

<div style="min-height: calc(100vh - 100px); display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); padding: 36px 32px; width: 100%; max-width: 440px;">
        <div style="margin-bottom: 24px;">
            <div style="font-size: 11px; font-weight: 800; letter-spacing: 0.8px; color: var(--accent, #557c6c); text-transform: uppercase; margin-bottom: 6px;">
                ORGANIZATION CONTEXT
            </div>
            <h2 style="font-size: 24px; font-weight: 800; color: var(--text, #26332d); margin: 0 0 8px 0; letter-spacing: -0.4px;">
                Select Organization
            </h2>
            <p style="font-size: 14px; color: var(--muted, #6c7870); margin: 0; line-height: 1.5;">
                Please select the organization workspace you wish to administer.
            </p>
        </div>

        @if (options == null)
        {
            <div style="padding: 24px 0; text-align: center; color: var(--muted, #6c7870); font-weight: 600;">
                Loading available organizations...
            </div>
        }
        else if (options.Count == 0)
        {
            <div style="padding: 16px; border-radius: 12px; background: #fff5f5; border: 1px solid #fed7d7; color: #9b2c2c; font-size: 14px;">
                You are not currently assigned to any active organizations.
            </div>
        }
        else
        {
            <form method="post" action="/auth/set-organization" data-enhance="false">
                <AntiforgeryToken />
                <div style="margin-bottom: 24px;">
                    <label for="organizationId" style="display: block; font-size: 12px; font-weight: 700; color: var(--muted, #6c7870); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                        Active Workspace
                    </label>
                    <select id="organizationId" name="organizationId" required
                            style="width: 100%; height: 46px; padding: 0 14px; border-radius: 11px; border: 1.5px solid var(--border, #e4e7df); background: var(--surface-soft, #f8f9f5); color: var(--text, #26332d); font-size: 15px; font-family: inherit; font-weight: 600; outline: none; cursor: pointer;">
                        @foreach (var org in options)
                        {
                            <option value="@org.Id" selected="@(org.Id == currentOrgId)">@org.Name</option>
                        }
                    </select>
                </div>

                <button type="submit" class="primary" style="width: 100%; height: 46px; border-radius: 11px; background: var(--accent, #557c6c); color: #fff; font-weight: 700; font-size: 15px; border: none; cursor: pointer; transition: background 0.2s ease;">
                    Continue to Platform
                </button>
            </form>
        }
    </div>
</div>

@code {
    private List<OrganizationOption>? options;
    private Guid? currentOrgId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/auth/login", forceLoad: true);
            return;
        }

        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdStr, out var userId)) return;

        var activeOrgClaim = user.FindFirst("ActiveOrganizationId")?.Value;
        if (Guid.TryParse(activeOrgClaim, out var activeOrg))
        {
            currentOrgId = activeOrg;
        }

        using var conn = await DbFactory.CreateConnectionAsync();
        var orgs = (await conn.QueryAsync<OrganizationOption>(
            @"SELECT o.id as Id, o.name as Name 
              FROM organization_memberships om 
              JOIN organizations o ON om.organization_id = o.id 
              WHERE om.user_id = @UserId AND om.status = 'Active'
              ORDER BY o.name",
            new { UserId = userId })).ToList();

        options = orgs;
    }

    private class OrganizationOption
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = "";
    }
}
