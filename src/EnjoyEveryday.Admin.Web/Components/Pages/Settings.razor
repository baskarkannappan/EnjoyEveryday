@page "/settings"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject OrganizationService OrgService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext


    <div class="page-header">

        <div>

            <div class="eyebrow">
                CONFIGURATION
            </div>

            <h2>
                Settings
            </h2>

            <p>
                Configure your daycare experience environment.
            </p>

        </div>

    </div>


    <div class="settings">


        <div class="setting">

            <div>

                <strong>
                    Daycare profile
                </strong>

                <span>
                    Name, logo, location and languages
                </span>

            </div>

            <button class="secondary">
                Configure
            </button>

        </div>


        <div class="setting">

            <div>

                <strong>
                    Experience policies
                </strong>

                <span>
                    Age, materials and safety rules
                </span>

            </div>

            <button class="secondary">
                Configure
            </button>

        </div>


        <div class="setting">

            <div>

                <strong>
                    AI governance
                </strong>

                <span>
                    Review and approval settings
                </span>

            </div>

            <button class="secondary">
                Configure
            </button>

        </div>


    </div>
 
@code {
    private Organization? _org;

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrgService.GetOrganizationsAsync();
        _org = orgs.FirstOrDefault();
    }

    private async Task SaveSettingsAsync()
    {
        if (_org != null)
        {
            await OrgService.UpdateOrganizationAsync(_org);
            // Ideally, show a toast notification here
        }
    }
}
