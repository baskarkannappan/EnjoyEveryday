@page "/management"
@using EnjoyEveryday.Application.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.Domain.Entities
@inject OrganizationService OrganizationService
@inject DashboardService DashboardService
@rendermode InteractiveServer
<PageHero 
    Eyebrow="DAYCARE MANAGEMENT" 
    Title="Management" 
    Subtitle="A calm view of what is happening.">
</PageHero>
<div class="metrics">
    @if (_orgMetrics != null) {
        <MetricCard Label="BRANCHES" Value="@_orgMetrics.TotalBranches.ToString()" Subtext="Active branches" />
        <MetricCard Label="CLASSROOMS" Value="@_orgMetrics.TotalClassrooms.ToString()" Subtext="Total classrooms" />
        <MetricCard Label="CHILDREN" Value="@_orgMetrics.TotalChildren.ToString()" Subtext="Across branches" />
        <MetricCard Label="TEACHERS" Value="@_orgMetrics.TotalTeachers.ToString()" Subtext="Active educators" />
    } else {
        <MetricCard Label="BRANCHES" Value="0" Subtext="Active branches" />
        <MetricCard Label="CLASSROOMS" Value="0" Subtext="Total classrooms" />
        <MetricCard Label="CHILDREN" Value="0" Subtext="Across branches" />
        <MetricCard Label="TEACHERS" Value="0" Subtext="Active educators" />
    }
</div> 
@code {
    private Organization? _org;
    private OrganizationMetrics? _orgMetrics;
    private List<BranchMetrics> _branchMetrics = new();
    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrganizationService.GetOrganizationsAsync();
        _org = orgs.FirstOrDefault();
        if (_org != null)
        {
            _orgMetrics = await DashboardService.GetOrganizationMetricsAsync(_org.Id);
            _branchMetrics = (await DashboardService.GetBranchMetricsAsync(_org.Id)).ToList();
        }
    }
}
