@page "/access-denied"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@inject NavigationManager Navigation

<PageTitle>Access Denied — EnjoyEveryday Admin</PageTitle>

<div style="padding: 44px 36px; border-radius: var(--radius, 18px); background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); text-align: center; max-width: 440px; width: 100%; margin: 20px;">
    <div style="margin-bottom: 20px;">
        <div style="width: 56px; height: 56px; margin: 0 auto; border-radius: 14px; background: #fff5f5; display: flex; align-items: center; justify-content: center; color: #c53030; border: 1px solid #fed7d7;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
        </div>
    </div>
    
    <h2 style="margin-top: 0; margin-bottom: 8px; font-family: 'Figtree', Inter, sans-serif; font-weight: 750; font-size: 22px; color: var(--text, #26332d); letter-spacing: -0.3px;">Access Restricted</h2>
    <p style="color: var(--muted, #6c7870); margin-bottom: 24px; font-size: 14px; line-height: 1.5;">
        @GetErrorMessage()
    </p>

    <div style="display: flex; flex-direction: column; gap: 10px;">
        <a href="/login" class="btn primary" style="display: inline-block; padding: 12px 24px; border-radius: 11px; background: var(--accent, #557c6c); color: #ffffff; font-weight: 700; text-decoration: none; font-size: 14px;">
            Sign In with Different Account
        </a>
        <a href="/auth/logout" style="display: inline-block; padding: 10px 20px; border-radius: 11px; background: transparent; color: var(--muted, #6c7870); font-weight: 600; text-decoration: none; font-size: 13px;">
            Sign Out
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Reason { get; set; }

    private string GetErrorMessage() => Reason switch
    {
        "not_registered" => "No administrator account was found matching this Google email address. Platform Operations is strictly restricted to pre-registered platform administrators and organization owners.",
        "insufficient_permissions" => "Your account is not assigned to an administrative role (PlatformAdmin or OrganizationAdmin).",
        "account_disabled" => "Your administrator account has been disabled. Please contact system support.",
        "no_organizations" => "You are not assigned to any active organizations in the platform.",
        _ => "EnjoyEveryday Platform Operations is restricted to authorized platform administrators and organization owners only. Your Google account does not currently have administrative privileges."
    };
}
