@page "/platform-admin/storage-explorer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Storage

<PageTitle>Storage &amp; Media Explorer — Platform Admin</PageTitle>

<div class="content" style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <PageHero Eyebrow="SYSTEM INFRASTRUCTURE"
              Title="Platform Storage &amp; Media Explorer"
              Subtitle="Real-time telemetry of physical and cloud object storage distribution across organizations, branches, and classrooms.">
        <RightContent>
            <a href="/" class="btn secondary">Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <div style="margin-top: 20px;">
        <StorageExplorerView IsPlatformAdminView="true" />
    </div>
</div>

