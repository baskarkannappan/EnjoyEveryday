@page "/monetization"
@rendermode InteractiveServer
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@inject ExperienceMarketplaceService MarketplaceService

<PageTitle>Monetization &amp; Revenue — EnjoyEveryday</PageTitle>

<div class="content">
    <PageHero Eyebrow="COMMERCIAL METRICS"
              Title="Platform Monetization &amp; Revenue"
              Subtitle="Comprehensive financial reporting for marketplace experiences, entitlement tracking, gross sales, and net revenue.">
        <RightContent>
            <button class="secondary" @onclick="LoadReportAsync">Refresh Financials</button>
        </RightContent>
    </PageHero>

    @if (isLoading)
    {
        <div style="padding: 40px; text-align: center; color: var(--muted);">Loading financial reports...</div>
    }
    else if (summary != null)
    {
        <!-- KPI Metrics Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 24px 0;">
            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow);">
                <div style="font-size: 12px; font-weight: 750; color: var(--muted); text-transform: uppercase;">Gross Sales</div>
                <div style="font-size: 28px; font-weight: 800; color: var(--text); margin-top: 6px;">$@summary.GrossSales.ToString("N2")</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">Total charged volume</div>
            </div>

            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow);">
                <div style="font-size: 12px; font-weight: 750; color: #9b2c2c; text-transform: uppercase;">Refunds</div>
                <div style="font-size: 28px; font-weight: 800; color: #9b2c2c; margin-top: 6px;">$@summary.Refunds.ToString("N2")</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">Returned to organizations</div>
            </div>

            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow);">
                <div style="font-size: 12px; font-weight: 750; color: var(--accent-dark); text-transform: uppercase;">Net Revenue</div>
                <div style="font-size: 28px; font-weight: 800; color: var(--accent-dark); margin-top: 6px;">$@summary.NetRevenue.ToString("N2")</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">Gross Sales minus Refunds</div>
            </div>

            <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow);">
                <div style="font-size: 12px; font-weight: 750; color: var(--muted); text-transform: uppercase;">Active Entitlements</div>
                <div style="font-size: 28px; font-weight: 800; color: var(--text); margin-top: 6px;">@summary.ActiveEntitlements</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">Daycare licensed access</div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px;">
            <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 750; color: var(--text);">Marketplace Transaction Ledger</h3>

            @if (!summary.RecentOrders.Any())
            {
                <div style="padding: 20px; text-align: center; color: var(--muted);">No transactions recorded yet.</div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13.5px;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border); text-align: left; color: var(--muted); font-size: 12px;">
                                <th style="padding: 10px;">Date</th>
                                <th style="padding: 10px;">Txn Reference</th>
                                <th style="padding: 10px;">Organization</th>
                                <th style="padding: 10px;">Pricing Model</th>
                                <th style="padding: 10px;">Amount</th>
                                <th style="padding: 10px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in summary.RecentOrders)
                            {
                                <tr style="border-bottom: 1px solid var(--border);">
                                    <td style="padding: 12px 10px; color: var(--text);">@order.PurchasedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td style="padding: 12px 10px; font-family: monospace; color: var(--muted);">@order.TransactionReference</td>
                                    <td style="padding: 12px 10px; color: var(--text);">@order.OrganizationId.ToString()[..8]...</td>
                                    <td style="padding: 12px 10px; color: var(--text);">@order.PricingModel</td>
                                    <td style="padding: 12px 10px; font-weight: 750; color: var(--text);">$@order.AmountPaid.ToString("N2")</td>
                                    <td style="padding: 12px 10px;">
                                        <span style="@(order.PaymentStatus == "Completed" ? "color: var(--accent-dark); font-weight: 700;" : "color: #9b2c2c; font-weight: 700;")">
                                            @order.PaymentStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private MonetizationSummary? summary;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        isLoading = true;
        try
        {
            summary = await MarketplaceService.GetMonetizationSummaryAsync();
        }
        finally
        {
            isLoading = false;
        }
    }
}
