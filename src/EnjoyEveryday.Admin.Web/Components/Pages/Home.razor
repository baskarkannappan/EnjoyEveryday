@page "/home-old"

<PageTitle>Today — EnjoyEveryday</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">

    @* Welcome Card (matches wireframe hero section) *@
    <FluentCard Style="padding: 28px;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                     VerticalAlignment="VerticalAlignment.Center" Wrap="true">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                <FluentText Size="TextSize.Size100" Weight="TextWeight.Bold" Color="Color.Primary">
                    TODAY
                </FluentText>
                <FluentText Size="TextSize.Size600" Weight="TextWeight.Bold">
                    Good Morning, Priya
                </FluentText>
                <FluentText Size="TextSize.Size200" Color="Color.Default">
                    Bluebirds · 18 children · Indoor · September 20
                </FluentText>
            </FluentStack>

            <FluentCard Style="padding: 14px; background: var(--neutral-fill-secondary-rest);">
                <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                    <FluentText Size="TextSize.Size500">🌧️</FluentText>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                        <FluentText Size="TextSize.Size200" Weight="TextWeight.Bold">Rainy · 14°C</FluentText>
                        <FluentText Size="TextSize.Size100" Color="Color.Default">Indoor day recommended</FluentText>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentStack>
    </FluentCard>

    @* Today's Rhythm Section *@
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentText Size="TextSize.Size400" Weight="TextWeight.Bold">Today's Rhythm</FluentText>
            <FluentText Size="TextSize.Size100" Color="Color.Default">4 experiences planned</FluentText>
        </FluentStack>

        <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart">
            <FluentGridItem xs="12" sm="6" md="3">
                <FluentCard Style="padding: 20px; min-height: 160px;">
                    <FluentText Size="TextSize.Size100" Color="Color.Default" Weight="TextWeight.Bold">01</FluentText>
                    <FluentText Size="TextSize.Size100" Weight="TextWeight.Bold" Color="Color.Primary"
                                Style="margin-top: 14px; letter-spacing: 1px;">EXPLORE</FluentText>
                    <FluentText Size="TextSize.Size300" Weight="TextWeight.Bold" Style="margin-top: 6px;">
                        Tiny Discoveries
                    </FluentText>
                    <FluentText Size="TextSize.Size100" Color="Color.Default">
                        Look closely at tiny things hiding in the classroom.
                    </FluentText>
                    <FluentButton Style="margin-top: 10px;" Appearance="ButtonAppearance.Transparent">
                        Start →
                    </FluentButton>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="6" md="3">
                <FluentCard Style="padding: 20px; min-height: 160px;">
                    <FluentText Size="TextSize.Size100" Color="Color.Default" Weight="TextWeight.Bold">02</FluentText>
                    <FluentText Size="TextSize.Size100" Weight="TextWeight.Bold" Color="Color.Primary"
                                Style="margin-top: 14px; letter-spacing: 1px;">CREATE</FluentText>
                    <FluentText Size="TextSize.Size300" Weight="TextWeight.Bold" Style="margin-top: 6px;">
                        Our Little City
                    </FluentText>
                    <FluentText Size="TextSize.Size100" Color="Color.Default">
                        Children build a city together.
                    </FluentText>
                    <FluentButton Style="margin-top: 10px;" Appearance="ButtonAppearance.Transparent">
                        Start →
                    </FluentButton>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="6" md="3">
                <FluentCard Style="padding: 20px; min-height: 160px;">
                    <FluentText Size="TextSize.Size100" Color="Color.Default" Weight="TextWeight.Bold">03</FluentText>
                    <FluentText Size="TextSize.Size100" Weight="TextWeight.Bold" Color="Color.Primary"
                                Style="margin-top: 14px; letter-spacing: 1px;">TOGETHER</FluentText>
                    <FluentText Size="TextSize.Size300" Weight="TextWeight.Bold" Style="margin-top: 6px;">
                        Frog Rescue
                    </FluentText>
                    <FluentText Size="TextSize.Size100" Color="Color.Default">
                        A cooperative rescue mission.
                    </FluentText>
                    <FluentButton Style="margin-top: 10px;" Appearance="ButtonAppearance.Transparent">
                        Start →
                    </FluentButton>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="6" md="3">
                <FluentCard Style="padding: 20px; min-height: 160px;">
                    <FluentText Size="TextSize.Size100" Color="Color.Default" Weight="TextWeight.Bold">04</FluentText>
                    <FluentText Size="TextSize.Size100" Weight="TextWeight.Bold" Color="Color.Primary"
                                Style="margin-top: 14px; letter-spacing: 1px;">MOVE</FluentText>
                    <FluentText Size="TextSize.Size300" Weight="TextWeight.Bold" Style="margin-top: 6px;">
                        Animal Adventure
                    </FluentText>
                    <FluentText Size="TextSize.Size100" Color="Color.Default">
                        Move, sound and imagine like animals.
                    </FluentText>
                    <FluentButton Style="margin-top: 10px;" Appearance="ButtonAppearance.Transparent">
                        Start →
                    </FluentButton>
                </FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </FluentStack>

    @* Bottom Panels *@
    <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart">
        @* Classroom Feeling *@
        <FluentGridItem xs="12" md="6">
            <FluentCard Style="padding: 22px;">
                <FluentText Size="TextSize.Size300" Weight="TextWeight.Bold">How's the classroom?</FluentText>
                <FluentText Size="TextSize.Size100" Color="Color.Default" Style="margin-top: 4px;">
                    How does the room feel right now?
                </FluentText>
                <FluentStack Style="margin-top: 16px;" HorizontalGap="8">
                    <FluentButton Style="font-size: 20px; padding: 12px 16px;" Appearance="ButtonAppearance.Outline">
                        ☀️ Bright
                    </FluentButton>
                    <FluentButton Style="font-size: 20px; padding: 12px 16px;" Appearance="ButtonAppearance.Outline">
                        🌊 Calm
                    </FluentButton>
                    <FluentButton Style="font-size: 20px; padding: 12px 16px;" Appearance="ButtonAppearance.Outline">
                        ⚡ Restless
                    </FluentButton>
                    <FluentButton Style="font-size: 20px; padding: 12px 16px;" Appearance="ButtonAppearance.Outline">
                        🌙 Quiet
                    </FluentButton>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>

        @* AI Surprise *@
        <FluentGridItem xs="12" md="6">
            <FluentCard Style="padding: 22px; background: var(--neutral-fill-secondary-rest);">
                <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Primary" />
                    <FluentText Size="TextSize.Size300" Weight="TextWeight.Bold">Little Surprise</FluentText>
                </FluentStack>
                <FluentText Size="TextSize.Size200" Color="Color.Default" Style="margin-top: 8px; line-height: 1.6;">
                    The children have been interested in animals all week. Try a 5-minute animal sound guessing game
                    before the next experience — no preparation needed.
                </FluentText>
                <FluentButton Style="margin-top: 12px;" Appearance="ButtonAppearance.Transparent">
                    Try this →
                </FluentButton>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

</FluentStack>
