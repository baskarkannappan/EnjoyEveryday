@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Tenancy
@inject NavigationManager NavigationManager
@inject IPlatformBusinessEventService EventService
@inject IUserContext UserContext
@implements IDisposable

<FluentLayout>
    <!-- MOBILE ONLY HEADER -->
    <FluentLayoutItem Area="LayoutArea.Header" class="mobile-header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="15">
            <FluentLayoutHamburger @ref="_hamburger" />
            <div style="display: flex; gap: 8px; align-items: center;">
                <div style="width: 24px; height: 24px; border-radius: 6px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); display: grid; place-items: center; font-size: 14px;">
                    ✨
                </div>
                <div style="font-weight: 750; font-size: 14px; letter-spacing: -0.5px; color: var(--text, #26332d);">EnjoyEveryday</div>
            </div>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Width="228px">
        <CascadingValue Value="CloseMobileMenuAsync" Name="CloseMobileMenu">
            <NavMenu />
        </CascadingValue>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        <!-- TOP CONTROL BAR WITH LIVE NOTIFICATIONS -->
        <div class="platform-header-bar">
            <div class="platform-header-left">
                <span class="platform-superadmin-tag">🛡️ Platform Admin Control Plane</span>
            </div>
            <div class="platform-header-right">
                <!-- NOTIFICATION BELL & POPUP -->
                <div class="notification-wrapper">
                    <button class="notification-bell-btn @(_unreadCount > 0 ? "has-unread" : "")" 
                            @onclick="ToggleNotificationsAsync" 
                            title="Platform Notifications">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        @if (_unreadCount > 0)
                        {
                            <span class="notification-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                        }
                    </button>

                    @if (_isNotificationsOpen)
                    {
                        <div class="notification-popover" @onclick:stopPropagation="true">
                            <div class="popover-header">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <strong>Business Notifications</strong>
                                    @if (_unreadCount > 0)
                                    {
                                        <span class="unread-count-pill">@_unreadCount new</span>
                                    }
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    @if (_unreadCount > 0)
                                    {
                                        <button class="mark-all-read-btn" @onclick="MarkAllReadAsync">Mark all read</button>
                                    }
                                    <button class="close-popover-btn" @onclick="() => _isNotificationsOpen = false">✕</button>
                                </div>
                            </div>

                            <div class="popover-body">
                                @if (_isLoadingNotifications)
                                {
                                    <div style="padding: 24px; text-align: center; color: var(--muted, #6c7870); font-size: 13px;">
                                        Loading notifications...
                                    </div>
                                }
                                else if (_notifications.Count == 0)
                                {
                                    <div style="padding: 30px 20px; text-align: center; color: var(--muted, #6c7870);">
                                        <div style="font-size: 24px; margin-bottom: 6px;">✨</div>
                                        <div style="font-weight: 600; font-size: 13px; color: var(--text, #26332d);">All caught up!</div>
                                        <div style="font-size: 11.5px; margin-top: 2px;">No new commercial activity notifications.</div>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var n in _notifications)
                                    {
                                        <div class="notification-item @(n.IsRead ? "read" : "unread")">
                                            <div class="notif-dot @(n.IsRead ? "read" : "unread")"></div>
                                            <div class="notif-details">
                                                <div class="notif-title-row">
                                                    <span class="notif-title">@n.Title</span>
                                                    <span class="notif-time">@GetTimeAgo(n.CreatedAt)</span>
                                                </div>
                                                <div class="notif-msg">@n.Message</div>
                                                <div class="notif-actions">
                                                    @if (!string.IsNullOrWhiteSpace(n.ActionUrl))
                                                    {
                                                        <a href="@n.ActionUrl" class="notif-action-link" @onclick="() => NavigateToAction(n)">
                                                            View Details →
                                                        </a>
                                                    }
                                                    @if (!n.IsRead)
                                                    {
                                                        <button class="notif-single-read-btn" @onclick="() => MarkSingleReadAsync(n.Id)">
                                                            Mark read
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <GlobalErrorBoundary>
            @Body
        </GlobalErrorBoundary>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

<style>
    .platform-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 36px;
        background: var(--surface, #ffffff);
        border-bottom: 1px solid var(--border, #e4e7df);
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .platform-superadmin-tag {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.3px;
        color: var(--accent-dark, #31523c);
        background: var(--accent-light, #e6eee9);
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .platform-header-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .notification-wrapper {
        position: relative;
    }
    .notification-bell-btn {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        border: 1px solid var(--border, #e4e7df);
        background: var(--surface, #ffffff);
        color: var(--text, #26332d);
        display: grid;
        place-items: center;
        cursor: pointer;
        position: relative;
        transition: all 0.15s ease;
    }
    .notification-bell-btn:hover {
        background: var(--surface-soft, #f8f9f5);
        border-color: #c8dacd;
    }
    .notification-bell-btn.has-unread {
        color: var(--accent-dark, #31523c);
    }
    .notification-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #dc2626;
        color: #ffffff;
        font-size: 10px;
        font-weight: 800;
        min-width: 17px;
        height: 17px;
        line-height: 17px;
        padding: 0 4px;
        border-radius: 9px;
        text-align: center;
        box-shadow: 0 2px 5px rgba(220, 38, 38, 0.4);
    }
    .notification-popover {
        position: absolute;
        top: 44px;
        right: 0;
        width: 380px;
        max-width: 90vw;
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        z-index: 1000;
        overflow: hidden;
        animation: fadeIn 0.15s ease;
    }
    .popover-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 16px;
        background: var(--surface-soft, #f8f9f5);
        border-bottom: 1px solid var(--border, #e4e7df);
        font-size: 13.5px;
        color: var(--text, #26332d);
    }
    .unread-count-pill {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        font-size: 10px;
        font-weight: 750;
        padding: 2px 7px;
        border-radius: 5px;
    }
    .mark-all-read-btn {
        background: transparent;
        border: none;
        color: var(--accent, #557c6c);
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        padding: 0;
    }
    .mark-all-read-btn:hover {
        text-decoration: underline;
    }
    .close-popover-btn {
        background: transparent;
        border: none;
        color: var(--muted, #6c7870);
        font-size: 13px;
        cursor: pointer;
        padding: 0;
    }
    .popover-body {
        max-height: 420px;
        overflow-y: auto;
    }
    .notification-item {
        display: flex;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border, #e4e7df);
        transition: background 0.15s ease;
    }
    .notification-item.unread {
        background: #fbfcf9;
    }
    .notification-item:last-child {
        border-bottom: none;
    }
    .notif-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-top: 5px;
        flex-shrink: 0;
    }
    .notif-dot.unread {
        background: #dc2626;
    }
    .notif-dot.read {
        background: #d1d5db;
    }
    .notif-details {
        flex: 1;
        min-width: 0;
    }
    .notif-title-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        align-items: baseline;
    }
    .notif-title {
        font-size: 13px;
        font-weight: 750;
        color: var(--text, #26332d);
    }
    .notif-time {
        font-size: 10.5px;
        color: var(--muted, #6c7870);
        white-space: nowrap;
    }
    .notif-msg {
        font-size: 12px;
        color: var(--muted, #6c7870);
        margin: 3px 0 6px;
        line-height: 1.4;
    }
    .notif-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .notif-action-link {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--accent-dark, #31523c);
        text-decoration: none;
    }
    .notif-action-link:hover {
        text-decoration: underline;
    }
    .notif-single-read-btn {
        background: transparent;
        border: none;
        color: var(--muted, #6c7870);
        font-size: 11px;
        cursor: pointer;
        padding: 0;
    }
    .notif-single-read-btn:hover {
        color: var(--text, #26332d);
    }
</style>

@code {
    private FluentLayoutHamburger? _hamburger;
    private int _unreadCount = 0;
    private bool _isNotificationsOpen = false;
    private bool _isLoadingNotifications = false;
    private List<PlatformAdminNotification> _notifications = new();
    private Guid _currentUserId = Guid.Parse("50000000-0000-0000-0000-000000000002");

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;

        if (UserContext.UserId != Guid.Empty)
        {
            _currentUserId = UserContext.UserId;
        }

        await RefreshUnreadCountAsync();
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            _unreadCount = await EventService.GetUnreadNotificationCountAsync(_currentUserId);
        }
        catch { /* fail-safe */ }
    }

    private async Task ToggleNotificationsAsync()
    {
        _isNotificationsOpen = !_isNotificationsOpen;
        if (_isNotificationsOpen)
        {
            await LoadNotificationsAsync();
        }
    }

    private async Task LoadNotificationsAsync()
    {
        _isLoadingNotifications = true;
        try
        {
            _notifications = await EventService.GetAdminNotificationsAsync(_currentUserId, unreadOnly: false, limit: 25);
            _unreadCount = _notifications.Count(n => !n.IsRead);
        }
        catch { /* fail-safe */ }
        finally
        {
            _isLoadingNotifications = false;
        }
    }

    private async Task MarkAllReadAsync()
    {
        try
        {
            await EventService.MarkAllNotificationsReadAsync(_currentUserId);
            _unreadCount = 0;
            foreach (var n in _notifications)
            {
                n.IsRead = true;
            }
        }
        catch { /* fail-safe */ }
    }

    private async Task MarkSingleReadAsync(Guid notificationId)
    {
        try
        {
            await EventService.MarkNotificationReadAsync(notificationId, _currentUserId);
            var item = _notifications.FirstOrDefault(n => n.Id == notificationId);
            if (item != null)
            {
                item.IsRead = true;
            }
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }
        catch { /* fail-safe */ }
    }

    private async Task NavigateToAction(PlatformAdminNotification notification)
    {
        if (!notification.IsRead)
        {
            await MarkSingleReadAsync(notification.Id);
        }
        _isNotificationsOpen = false;
    }

    private string GetTimeAgo(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return dt.ToString("MMM dd");
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _isNotificationsOpen = false;
        await RefreshUnreadCountAsync();
        await CloseMobileMenuAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseMobileMenuAsync()
    {
        if (_hamburger is not null)
        {
            try
            {
                await _hamburger.HideAsync();
            }
            catch
            {
                // Ignore if hamburger dialog is not currently open
            }
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
