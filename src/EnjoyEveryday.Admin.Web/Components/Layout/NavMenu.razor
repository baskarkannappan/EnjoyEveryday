@* Platform Admin Navigation Menu *@

<nav class="custom-nav" style="padding: 15px; height: 100%;">
    
    <!-- BRANDING HEADER -->
    <div style="display: flex; gap: 12px; align-items: center; padding: 12px 10px 20px;">
        <div style="width: 40px; height: 40px; border-radius: 13px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 20px;">
            🌿
        </div>
        <div>
            <div style="font-weight: 750; font-size: 16px; letter-spacing: -0.5px; color: var(--text, #26332d);">EnjoyEveryday</div>
            <div style="font-size: 11px; color: var(--muted, #6c7870); margin-top: 2px;">Platform Operations</div>
        </div>
    </div>

    <!-- PLATFORM BADGE -->
    <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 12px; padding: 10px 12px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="color: var(--muted, #6c7870); font-size: 9.5px; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase;">Portal</div>
            <div style="font-weight: 750; color: var(--text, #26332d); font-size: 13px;">Platform Admin</div>
        </div>
        <span style="background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); font-size: 10px; font-weight: 750; padding: 2px 7px; border-radius: 6px;">Superadmin</span>
    </div>

    @* OVERVIEW *@
    <div class="nav-section">OVERVIEW</div>
    <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
        <FluentIcon Value="@(new Icons.Regular.Size20.Apps())" Color="Color.Custom" CustomColor="#0d9488" />
        <span>Dashboard</span>
    </NavLink>

    @* ORGANIZATION MANAGEMENT *@
    <div class="nav-section">ORGANIZATIONS</div>
    <NavLink class="nav-item" href="/organizations">
        <FluentIcon Value="@(new Icons.Regular.Size20.Building())" Color="Color.Custom" CustomColor="#2563eb" />
        <span>Organizations</span>
    </NavLink>
    <NavLink class="nav-item" href="/branches">
        <FluentIcon Value="@(new Icons.Regular.Size20.Location())" Color="Color.Custom" CustomColor="#ea580c" />
        <span>Branches</span>
    </NavLink>
    <NavLink class="nav-item" href="/admins">
        <FluentIcon Value="@(new Icons.Regular.Size20.PersonBoard())" Color="Color.Custom" CustomColor="#d97706" />
        <span>Org Administrators</span>
    </NavLink>

    @* COMMERCIAL MANAGEMENT *@
    <div class="nav-section">COMMERCIAL</div>
    <NavLink class="nav-item" href="/plans">
        <FluentIcon Value="@(new Icons.Regular.Size20.Tag())" Color="Color.Custom" CustomColor="#7c3aed" />
        <span>Plans &amp; Tariffs</span>
    </NavLink>
    <NavLink class="nav-item" href="/billing">
        <FluentIcon Value="@(new Icons.Regular.Size20.Receipt())" Color="Color.Custom" CustomColor="#059669" />
        <span>Billing &amp; Invoices</span>
    </NavLink>
    <NavLink class="nav-item" href="/payments">
        <FluentIcon Value="@(new Icons.Regular.Size20.Payment())" Color="Color.Custom" CustomColor="#10b981" />
        <span>Payments &amp; Reconcile</span>
    </NavLink>
    <NavLink class="nav-item" href="/discounts">
        <FluentIcon Value="@(new Icons.Regular.Size20.Gift())" Color="Color.Custom" CustomColor="#e11d48" />
        <span>Discounts &amp; Offers</span>
    </NavLink>

    @* EXPERIENCE MARKETPLACE & CURATION *@
    <div class="nav-section">EXPERIENCE MARKETPLACE</div>
    <NavLink class="nav-item" href="/platform-curation">
        <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Custom" CustomColor="#eab308" />
        <span>Experience Curation</span>
    </NavLink>
    <NavLink class="nav-item" href="/platform-marketplace">
        <FluentIcon Value="@(new Icons.Regular.Size20.BuildingShop())" Color="Color.Custom" CustomColor="#4f46e5" />
        <span>Platform Marketplace</span>
    </NavLink>
    <NavLink class="nav-item" href="/monetization">
        <FluentIcon Value="@(new Icons.Regular.Size20.Money())" Color="Color.Custom" CustomColor="#0284c7" />
        <span>Monetization &amp; Revenue</span>
    </NavLink>

    @* PLATFORM OPERATIONS *@
    <div class="nav-section">PLATFORM OPERATIONS</div>
    <NavLink class="nav-item" href="/reports">
        <FluentIcon Value="@(new Icons.Regular.Size20.DataBarVertical())" Color="Color.Custom" CustomColor="#9333ea" />
        <span>Reports &amp; Intelligence</span>
    </NavLink>
    <NavLink class="nav-item" href="/ai-communication">
        <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Custom" CustomColor="#06b6d4" />
        <span>AI Communication Gateway</span>
    </NavLink>
    <NavLink class="nav-item" href="/audit-logs">
        <FluentIcon Value="@(new Icons.Regular.Size20.History())" Color="Color.Custom" CustomColor="#b45309" />
        <span>Audit Logs</span>
    </NavLink>
    <NavLink class="nav-item" href="/settings">
        <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.Custom" CustomColor="#64748b" />
        <span>System Settings</span>
    </NavLink>

    @* LOGGED IN ADMIN FOOTER *@
    <AuthorizeView>
        <Authorized>
            @{
                var userName = context.User.Identity?.Name;
                if (string.IsNullOrWhiteSpace(userName))
                {
                    userName = context.User.FindFirst("DisplayName")?.Value;
                }
                if (string.IsNullOrWhiteSpace(userName))
                {
                    userName = context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                }
                if (string.IsNullOrWhiteSpace(userName))
                {
                    userName = "Admin";
                }
                var initialChar = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpper() : "A";
            }
            <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid var(--border, #e4e7df); display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; min-width: 0; flex: 1;">
                    <div style="width: 34px; height: 34px; border-radius: 50%; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 14px; font-weight: 750; flex-shrink: 0;">
                        @initialChar
                    </div>
                    <div style="overflow: hidden; min-width: 0; flex: 1;">
                        <div style="font-weight: 750; font-size: 13px; color: var(--text, #26332d); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;" title="@userName">
                            @userName
                        </div>
                        <div style="font-size: 11px; color: var(--muted, #6c7870); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">Platform Admin</div>
                    </div>
                </div>
                <a href="/auth/logout" data-enhance-nav="false" style="font-size: 11.5px; font-weight: 600; color: #b55a5a; text-decoration: none; padding: 5px 9px; border-radius: 7px; background: #fff5f5; border: 1px solid #fed7d7; flex-shrink: 0; display: inline-flex; align-items: center;">
                    Sign Out
                </a>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>
