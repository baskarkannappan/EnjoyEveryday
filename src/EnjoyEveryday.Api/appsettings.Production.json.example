{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-azure-pg.postgres.database.azure.com;Port=5432;Database=enjoyeveryday;Username=your_admin_user;Password=your_secure_password;Ssl Mode=Require;"
  },
  "Services": {
    "ApiUrl": "https://api.enjoyeveryday.com",
    "DaycareUrl": "https://daycare.enjoyeveryday.com",
    "ParentUrl": "https://parent.enjoyeveryday.com"
  },
  "AiAgent": {
    "BaseUrl": "http://enjoyeveryday-ai-agent:8000",
    "TimeoutSeconds": 30,
    "ServiceSecret": "MATCH_THE_AI_SERVICE_SECRET_IN_AI_AGENT"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://daycare.enjoyeveryday.com",
      "https://admin.enjoyeveryday.com",
      "https://parent.enjoyeveryday.com"
    ]
  },
  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_storage_key;EndpointSuffix=core.windows.net",
    "ContainerName": "enjoyeveryday-media"
  },
  "Razorpay": {
    "KeyId": "rzp_live_your_key_id",
    "KeySecret": "your_razorpay_live_secret",
    "WebhookSecret": "your_razorpay_live_webhook_secret",
    "DefaultCurrency": "INR",
    "MockMode": false
  }
}
