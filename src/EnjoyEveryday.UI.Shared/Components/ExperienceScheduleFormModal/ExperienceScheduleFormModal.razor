@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-overlay show" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="OnClose">✕</button>
            <h2>@(IsEditing ? "Edit Experience" : "Schedule Experience")</h2>
            <p>@DialogDate.ToString("MMMM d, yyyy")</p>
            
            <div style="margin-top: 20px; display: grid; gap: 15px;">
                <div>
                    <label style="display: block; font-size: 11px; color: #8a958e; margin-bottom: 5px; font-weight: 700;">EXPERIENCE</label>
                    <select value="@SelectedExperienceId" @onchange="@(e => SelectedExperienceIdChanged.InvokeAsync(e.Value?.ToString()))" style="width: 100%; padding: 12px; border: 1px solid #e7ebe7; border-radius: 10px; outline: none;">
                        @if (ExperienceOptions != null)
                        {
                            @foreach (var exp in ExperienceOptions)
                            {
                                <option value="@exp.Key">@exp.Value</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 11px; color: #8a958e; margin-bottom: 5px; font-weight: 700;">TIME OF DAY</label>
                    <select value="@TimeOfDay" @onchange="@(e => TimeOfDayChanged.InvokeAsync(e.Value?.ToString()))" style="width: 100%; padding: 12px; border: 1px solid #e7ebe7; border-radius: 10px; outline: none;">
                        <option value="Morning">Morning</option>
                        <option value="Afternoon">Afternoon</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 25px; align-items: center; border-top: 1px solid #edf0ed; padding-top: 20px;">
                <div>
                    @if (IsEditing)
                    {
                        <button type="button" style="border: 1px solid #ffccd5; background: #fff0f2; color: #d92d4b; padding: 10px 15px; border-radius: 10px; font-size: 12px; font-weight: 700;" @onclick="OnDelete">Delete</button>
                    }
                </div>
                <div style="display: flex; gap: 10px;">
                    <button type="button" style="border: 1px solid #e7ebe7; background: white; padding: 10px 15px; border-radius: 10px; font-size: 12px; font-weight: 700;" @onclick="OnClose">Cancel</button>
                    <button type="button" class="ai-action" style="background: #26332d; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;" @onclick="OnSave">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public DateOnly DialogDate { get; set; }
    
    [Parameter] public string? SelectedExperienceId { get; set; }
    [Parameter] public EventCallback<string?> SelectedExperienceIdChanged { get; set; }
    
    [Parameter] public string TimeOfDay { get; set; } = "Morning";
    [Parameter] public EventCallback<string> TimeOfDayChanged { get; set; }
    
    [Parameter] public IEnumerable<KeyValuePair<string, string>>? ExperienceOptions { get; set; }
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
