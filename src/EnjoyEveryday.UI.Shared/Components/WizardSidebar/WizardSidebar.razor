@namespace EnjoyEveryday.UI.Shared.Components

<div class="wizard-sidebar">
    <!-- Mobile Stepper & Progress Tracker (Shown on mobile screens <= 768px) -->
    <div class="wizard-mobile-stepper">
        <div class="mobile-step-header">
            <div class="mobile-step-title-wrap">
                <span class="mobile-step-badge">Step @CurrentStep of @Steps.Count</span>
                <span class="mobile-step-name">@(CurrentStep > 0 && CurrentStep <= Steps.Count ? Steps[CurrentStep - 1] : "")</span>
            </div>
            <div class="mobile-step-pct">
                @((int)Math.Round((double)CurrentStep / Math.Max(Steps.Count, 1) * 100))%
            </div>
        </div>

        <div class="mobile-progress-track">
            <div class="mobile-progress-fill" style="width: @((int)Math.Round((double)CurrentStep / Math.Max(Steps.Count, 1) * 100))%;"></div>
        </div>

        <div class="mobile-chips-scroll">
            @for (int i = 0; i < Steps.Count; i++)
            {
                var stepNumber = i + 1;
                var isCompleted = CurrentStep > stepNumber;
                var isActive = CurrentStep == stepNumber;
                var isClickable = MaxAllowedStep >= stepNumber;

                <button type="button"
                        class="mobile-step-chip @(isActive ? "active" : isCompleted ? "completed" : "")"
                        disabled="@(!isClickable)"
                        @onclick="() => { if (isClickable) OnStepClicked.InvokeAsync(stepNumber); }">
                    <span class="chip-number">@(isCompleted ? "✓" : stepNumber.ToString())</span>
                    <span class="chip-label">@Steps[i]</span>
                </button>
            }
        </div>
    </div>

    <!-- Desktop Sidebar List (Shown on screens > 768px) -->
    <ul class="wizard-desktop-list">
        @for (int i = 0; i < Steps.Count; i++)
        {
            var stepNumber = i + 1;
            var isCompleted = CurrentStep > stepNumber;
            var isActive = CurrentStep == stepNumber;
            var isClickable = MaxAllowedStep >= stepNumber;

            <li class="@(isActive ? "active" : isCompleted ? "completed" : "")"
                style="@(isClickable ? "cursor: pointer;" : "cursor: not-allowed; opacity: 0.55;")"
                @onclick="() => { if (isClickable) OnStepClicked.InvokeAsync(stepNumber); }">
                <span class="step-icon">
                    @(isCompleted ? "✓" : stepNumber.ToString())
                </span>
                <span class="step-label">@Steps[i]</span>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public List<string> Steps { get; set; } = new();
    [Parameter] public int CurrentStep { get; set; } = 1;
    [Parameter] public int MaxAllowedStep { get; set; } = 1;
    [Parameter] public EventCallback<int> OnStepClicked { get; set; }
}
