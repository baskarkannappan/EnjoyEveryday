@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="avif-image-uploader" style="@Style">
    @if (string.IsNullOrEmpty(Value))
    {
        <div class="uploader-actions-row">
            <!-- 1. Mobile Camera Capture (triggers camera directly on mobile) -->
            <label class="camera-btn" title="Take a photo with camera">
                <span class="btn-content">
                    <span class="btn-icon">📷</span>
                    <span>Take Photo</span>
                </span>
                <input type="file"
                       accept="image/*"
                       capture="environment"
                       @ref="_cameraInput"
                       @onchange="HandleCameraCapture"
                       style="display: none;" />
            </label>

            <!-- 2. Photo Library / File Picker -->
            <label class="library-btn" title="Choose photo from library or files">
                <span class="btn-content">
                    <span class="btn-icon">🖼️</span>
                    <span>@ButtonText</span>
                </span>
                <input type="file"
                       accept="image/*"
                       @ref="_fileInput"
                       @onchange="HandleFileSelected"
                       style="display: none;" />
            </label>
        </div>

        @if (_isProcessing)
        {
            <div class="processing-bar">
                <span class="spin-icon">⏳</span>
                <span>Optimizing &amp; converting photo...</span>
            </div>
        }
    }
    else
    {
        <!-- Photo Preview Card -->
        <div class="photo-preview-card">
            <div class="preview-thumb-wrap">
                <img src="@Value" alt="Attached moment photo" class="preview-thumb-img" />
            </div>
            <div class="preview-meta">
                <div class="photo-status-badge">
                    <span>✓</span>
                    <span>Photo Attached</span>
                </div>
                <div class="preview-actions">
                    <!-- Retake button with camera capture -->
                    <label class="retake-label" title="Retake photo with camera">
                        <span>📷 Retake</span>
                        <input type="file"
                               accept="image/*"
                               capture="environment"
                               @onchange="HandleCameraCapture"
                               style="display: none;" />
                    </label>
                    <span class="meta-divider">•</span>
                    <!-- Remove button -->
                    <button type="button" class="btn-remove-photo" @onclick="RemovePhoto">
                        ✕ Remove
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
    
    [Parameter]
    public string ButtonText { get; set; } = "Choose Photo";

    [Parameter]
    public string Style { get; set; } = "";

    private ElementReference _fileInput;
    private ElementReference _cameraInput;
    private bool _isProcessing = false;

    private async Task HandleCameraCapture(ChangeEventArgs e)
    {
        await ProcessInputFile(_cameraInput);
    }

    private async Task HandleFileSelected(ChangeEventArgs e)
    {
        await ProcessInputFile(_fileInput);
    }

    private async Task ProcessInputFile(ElementReference inputRef)
    {
        _isProcessing = true;
        StateHasChanged();
        
        try
        {
            // Call the JS interop to convert to AVIF base64 data url
            var result = await JSRuntime.InvokeAsync<string>("window.imageConverter.convertToAvif", inputRef);
            
            if (!string.IsNullOrEmpty(result))
            {
                Value = result;
                await ValueChanged.InvokeAsync(result);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error converting image: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RemovePhoto()
    {
        Value = null;
        await ValueChanged.InvokeAsync(string.Empty);
    }
}
