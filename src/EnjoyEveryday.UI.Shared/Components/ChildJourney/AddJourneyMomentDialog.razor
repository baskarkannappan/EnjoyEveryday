@namespace EnjoyEveryday.UI.Shared.Components.ChildJourney
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Entities.Learning
@using EnjoyEveryday.Application.Services

@inject IChildJourneyService JourneyService
@inject ChildService ChildService
@inject ExperienceService ExperienceService
@inject PlannerService PlannerService
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService

    @if (!_hideDialog)
    {
        <div class="modal-backdrop show" @onclick="CloseDialog">
            <div class="modal" @onclick:stopPropagation="true">
                <button class="modal-close" @onclick="CloseDialog" aria-label="Close dialog">✕</button>
        @if (_step == 1)
        {
            <h3 class="dialog-title">What did you notice?@(!string.IsNullOrEmpty(ChildName) ? $" — {ChildName}" : "")</h3>
            
            @* DISPLAY CURRENTLY PLANNED EXPERIENCE FOR THE TEACHER / CLASSROOM *@
            <div class="form-group planned-exp-section">
                <div class="planned-exp-header">
                    <label class="form-label">Planned Experience</label>
                    @if (_selectedPlannedExperience != null && _selectedPlannedExperience.IsRunning)
                    {
                        <span class="exp-status-pill running">⚡ In Progress Now</span>
                    }
                    else if (_selectedPlannedExperience != null)
                    {
                        <span class="exp-status-pill planned">📅 Planned Today</span>
                    }
                </div>

                @if (_plannedExperiences != null && _plannedExperiences.Any())
                {
                    <div class="planned-exp-selector-wrap">
                        <select class="form-select planned-exp-select" @bind="_selectedPlannedScheduleId">
                            @foreach (var exp in _plannedExperiences)
                            {
                                <option value="@exp.ScheduleId">
                                    @exp.Title @(!string.IsNullOrWhiteSpace(exp.TimeRangeDisplay) ? $"({exp.TimeRangeDisplay})" : (!string.IsNullOrWhiteSpace(exp.TimeOfDay) ? $"({exp.TimeOfDay})" : ""))
                                </option>
                            }
                            <option value="">-- No specific experience (Spontaneous Moment) --</option>
                        </select>
                        @if (_selectedPlannedExperience != null && !string.IsNullOrWhiteSpace(_selectedPlannedExperience.Description))
                        {
                            <div class="planned-exp-description">
                                <span class="exp-desc-icon">🌿</span>
                                <span class="exp-desc-text">@_selectedPlannedExperience.Description</span>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(ExperienceTitle))
                {
                    <div class="fixed-exp-badge">
                        <span class="exp-badge-icon">🎨</span>
                        <div class="exp-badge-info">
                            <strong>@ExperienceTitle</strong>
                            <small class="exp-badge-sub">Session in progress</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-planned-exp-banner">
                        <span class="no-exp-icon">✨</span>
                        <div class="no-exp-text">
                            <strong>Spontaneous Learning Observation</strong>
                            <small class="no-exp-sub">No experience currently planned for this classroom today.</small>
                        </div>
                    </div>
                }
            </div>

            @if (ClassroomId == null)
            {
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Branch</label>
                        <select class="form-select" value="@_selectedBranchId" @onchange="OnBranchChanged">
                            <option value="">-- Select Branch --</option>
                            @if (_allBranches != null) {
                                foreach(var b in _allBranches) {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group flex-1">
                        <label class="form-label">Classroom</label>
                        <select class="form-select" value="@_selectedDropdownClassroomId" @onchange="OnClassroomChanged" disabled="@(_selectedBranchId == null)">
                            <option value="">-- Select Classroom --</option>
                            @if (_allClassrooms != null) {
                                foreach(var c in _allClassrooms) {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            }

            @if (ChildId == null)
            {
                <div class="form-group">
                    <label class="form-label">Which children?</label>
                    <div class="children-selector-box @(_selectedDropdownClassroomId == null && ClassroomId == null ? "disabled-state" : "")">
                        @if (_selectedDropdownClassroomId == null && ClassroomId == null)
                        {
                            <div class="helper-text italic">Please select a classroom first.</div>
                        }
                        else if (_allChildren != null && _allChildren.Any())
                        {
                            @foreach (var child in _allChildren)
                            {
                                <label class="child-chip @(_selectedChildIds.Contains(child.Id) ? "active" : "")">
                                    <input type="checkbox" checked="@_selectedChildIds.Contains(child.Id)" @onchange="@(e => ToggleChild(child.Id, (bool)(e.Value ?? false)))" style="display:none;" />
                                    <span>@child.FirstName @child.LastName</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            }

            <div class="form-group">
                <textarea class="form-textarea" @bind="_observation" rows="3" placeholder="e.g., Maya built a tall tower by herself."></textarea>
            </div>

            <p class="quick-obs-header">Quick observations:</p>
            <div class="quick-obs-wrap">
                @foreach (var quickObs in _quickObservations)
                {
                    <span class="quick-obs-chip" @onclick="() => AppendObservation(quickObs)">
                        @quickObs
                    </span>
                }
            </div>
        }
        else if (_step == 2)
        {
            <h3 class="dialog-title">What did this show?</h3>
            
            <div class="areas-list">
                @if (_allAreas != null)
                {
                    @foreach (var area in _allAreas)
                    {
                        <label class="area-item-card @(_selectedAreas.Contains(area.Id) ? "active" : "")">
                            <input type="checkbox" class="area-checkbox" checked="@_selectedAreas.Contains(area.Id)" @onchange="@(e => ToggleArea(area.Id, (bool)(e.Value ?? false)))" />
                            <span class="area-name">@area.Name</span>
                        </label>
                    }
                }
                else
                {
                    <p class="helper-text">Loading areas...</p>
                }
            </div>
            
            <div class="form-group photo-section">
                <label class="form-label">Attach Photo (Optional)</label>
                <AvifImageUploader @bind-Value="_photoUrl" ButtonText="Capture or Select Photo" />
                <small class="consent-notice">
                    <i class="bi bi-shield-check"></i> Photos are verified against signed parental consent before appearing in parent portal.
                </small>
            </div>
            
            <div class="visibility-card">
                <label class="visibility-label">
                    <input type="checkbox" class="visibility-checkbox" @bind="_isParentVisible" />
                    <div>
                        <span class="visibility-title">Visible in Parent Timeline</span>
                        <span class="visibility-desc">When unchecked, this observation is kept strictly internal for educators and conference preparation.</span>
                    </div>
                </label>
            </div>
        }

        <div class="dialog-footer">
            <button class="secondary" @onclick="CloseDialog">Cancel</button>
            
            @if (_step == 1)
            {
                <button class="primary" @onclick="GoToNextStep" disabled="@(string.IsNullOrWhiteSpace(_observation) || (ChildId == null && !_selectedChildIds.Any()))">Next</button>
            }
            else
            {
                <button class="secondary" @onclick="() => _step = 1">Back</button>
                <button class="primary" @onclick="SaveJourneyMoment" disabled="@_isSaving">@(_isSaving ? "Saving..." : "Save Moment")</button>
            }
        </div>
            </div>
        </div>
    }

@code {
    [Parameter]
    public Guid? ChildId { get; set; }

    [Parameter]
    public string? ChildName { get; set; }

    [Parameter]
    public Guid TeacherId { get; set; }

    [Parameter]
    public Guid? ClassroomId { get; set; }

    [Parameter]
    public Guid? ExperienceId { get; set; }

    [Parameter]
    public string? ExperienceTitle { get; set; }

    [Parameter]
    public Guid? ExperienceScheduleId { get; set; }

    [Parameter]
    public List<TodayActivityItemDto>? PlannedExperiences { get; set; }

    [Parameter]
    public Guid? ExperienceSessionId { get; set; }

    [Parameter]
    public Guid? ExperienceParticipationId { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private bool _hideDialog = true;
    private int _step = 1;
    
    private string _observation = "";
    private string _photoUrl = "";
    private bool _isSaving = false;
    private bool _isParentVisible = false;
    
    private List<DevelopmentArea>? _allAreas;
    private HashSet<Guid> _selectedAreas = new();

    private List<Child>? _allChildren;
    private HashSet<Guid> _selectedChildIds = new();

    private List<TodayActivityItemDto>? _plannedExperiences;
    private Guid? _selectedPlannedScheduleId;
    private TodayActivityItemDto? _selectedPlannedExperience => _plannedExperiences?.FirstOrDefault(p => p.ScheduleId == _selectedPlannedScheduleId);

    private List<Branch>? _allBranches;
    private List<Classroom>? _allClassrooms;
    private Guid? _selectedBranchId;
    private Guid? _selectedDropdownClassroomId;

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var branchId))
        {
            _selectedBranchId = branchId;
            _allClassrooms = (await ClassroomService.GetClassroomsAsync(branchId)).ToList();
            _selectedDropdownClassroomId = null;
            _allChildren = new List<Child>();
        }
        else
        {
            _selectedBranchId = null;
            _allClassrooms = null;
            _selectedDropdownClassroomId = null;
            _allChildren = new List<Child>();
        }
    }

    private async Task OnClassroomChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var classId))
        {
            _selectedDropdownClassroomId = classId;
            _allChildren = (await ChildService.GetChildrenByClassroomAsync(classId)).ToList();
            await LoadPlannedExperiencesForClassroomAsync(classId);
        }
        else
        {
            _selectedDropdownClassroomId = null;
            _allChildren = new List<Child>();
            _plannedExperiences = new();
            _selectedPlannedScheduleId = null;
        }
    }

    private readonly string[] _quickObservations = new[]
    {
        "🌱 Tried something new",
        "💬 Communicated an idea",
        "🤝 Helped a friend",
        "🧩 Solved a problem",
        "❤️ Expressed an emotion",
        "🎨 Showed creativity",
        "⭐ Did something independently",
        "👂 Listened and followed",
        "🏃 Moved confidently"
    };

    public async Task OpenAsync()
    {
        _step = 1;
        _observation = "";
        _photoUrl = "";
        _isParentVisible = true;
        _selectedAreas.Clear();
        _selectedChildIds.Clear();
        _selectedBranchId = null;
        _selectedDropdownClassroomId = null;
        _selectedPlannedScheduleId = null;
        
        _allAreas ??= (await JourneyService.GetDevelopmentAreasAsync()).ToList();
        
        var effectiveClassroomId = ClassroomId ?? _selectedDropdownClassroomId;

        // 1. Resolve planned experiences for the classroom (not all experiences from catalog!)
        if (PlannedExperiences != null && PlannedExperiences.Any())
        {
            _plannedExperiences = PlannedExperiences;
        }
        else if (effectiveClassroomId.HasValue)
        {
            await LoadPlannedExperiencesForClassroomAsync(effectiveClassroomId.Value);
        }
        else
        {
            _plannedExperiences = new();
        }

        // 2. Pre-select currently planned or active experience
        ResolveDefaultPlannedSelection();

        // 3. Resolve children if classroom is known
        if (ClassroomId == null)
        {
            var orgs = await OrganizationService.GetOrganizationsAsync();
            var org = orgs.FirstOrDefault();
            if (org != null)
            {
                _allBranches = (await BranchService.GetBranchesAsync(org.Id)).ToList();
            }
            _allChildren = new List<Child>();
        }
        else if (ChildId == null)
        {
            if (_allChildren == null)
            {
                try
                {
                    _allChildren = (await ChildService.GetChildrenByClassroomAsync(ClassroomId.Value)).ToList();
                }
                catch (UnauthorizedAccessException)
                {
                    var all = await ChildService.GetChildrenAsync();
                    _allChildren = all.Where(c => c.ClassroomId == ClassroomId.Value).ToList();
                }
                catch (Exception)
                {
                    _allChildren = new List<Child>();
                }
            }
        }
        
        _hideDialog = false;
        StateHasChanged();
    }

    private async Task LoadPlannedExperiencesForClassroomAsync(Guid classroomId)
    {
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var feed = await PlannerService.GetTodayActivitiesFeedAsync(today, classroomId: classroomId);
            _plannedExperiences = feed.Activities?.ToList() ?? new();
        }
        catch
        {
            _plannedExperiences = new();
        }
        ResolveDefaultPlannedSelection();
    }

    private void ResolveDefaultPlannedSelection()
    {
        if (_plannedExperiences == null || !_plannedExperiences.Any())
        {
            _selectedPlannedScheduleId = null;
            return;
        }

        if (ExperienceScheduleId.HasValue && _plannedExperiences.Any(p => p.ScheduleId == ExperienceScheduleId.Value))
        {
            _selectedPlannedScheduleId = ExperienceScheduleId.Value;
        }
        else if (ExperienceId.HasValue && _plannedExperiences.Any(p => p.ExperienceId == ExperienceId.Value))
        {
            _selectedPlannedScheduleId = _plannedExperiences.First(p => p.ExperienceId == ExperienceId.Value).ScheduleId;
        }
        else
        {
            var activeRunning = _plannedExperiences.FirstOrDefault(p => p.IsRunning);
            var nextPlanned = _plannedExperiences.FirstOrDefault(p => p.IsPending);
            var defaultExp = activeRunning ?? nextPlanned ?? _plannedExperiences.FirstOrDefault();
            if (defaultExp != null)
            {
                _selectedPlannedScheduleId = defaultExp.ScheduleId;
            }
        }
    }

    public async Task OpenForExperienceAsync(Guid experienceId, string title)
    {
        ExperienceId = experienceId;
        ExperienceTitle = title;
        await OpenAsync();
    }

    public async Task OpenForChildAsync(
        Guid childId, 
        string? childName = null, 
        Guid? classroomId = null, 
        Guid? experienceId = null, 
        string? experienceTitle = null,
        Guid? experienceScheduleId = null,
        List<TodayActivityItemDto>? plannedExperiences = null)
    {
        ChildId = childId;
        ChildName = childName;
        if (classroomId.HasValue) ClassroomId = classroomId;
        if (experienceId.HasValue) ExperienceId = experienceId;
        if (!string.IsNullOrEmpty(experienceTitle)) ExperienceTitle = experienceTitle;
        if (experienceScheduleId.HasValue) ExperienceScheduleId = experienceScheduleId;
        if (plannedExperiences != null) PlannedExperiences = plannedExperiences;
        await OpenAsync();
    }

    public async Task OpenGeneralAsync(
        Guid? classroomId = null, 
        Guid? experienceId = null, 
        string? experienceTitle = null,
        Guid? experienceScheduleId = null,
        List<TodayActivityItemDto>? plannedExperiences = null)
    {
        ChildId = null;
        ChildName = null;
        ClassroomId = classroomId;
        ExperienceId = experienceId;
        ExperienceTitle = experienceTitle;
        ExperienceScheduleId = experienceScheduleId;
        if (plannedExperiences != null) PlannedExperiences = plannedExperiences;
        await OpenAsync();
    }

    private void CloseDialog()
    {
        _hideDialog = true;
        _photoUrl = "";
    }

    private void AppendObservation(string obs)
    {
        if (!string.IsNullOrWhiteSpace(_observation))
        {
            _observation += " ";
        }
        _observation += obs;
    }

    private void GoToNextStep()
    {
        // Don't proceed if child is missing in activity integration mode
        if (ChildId == null && !_selectedChildIds.Any()) return;
        _step = 2;
    }

    private void ToggleArea(Guid areaId, bool isSelected)
    {
        if (isSelected) _selectedAreas.Add(areaId);
        else _selectedAreas.Remove(areaId);
    }

    private void ToggleChild(Guid childId, bool isSelected)
    {
        if (isSelected) _selectedChildIds.Add(childId);
        else _selectedChildIds.Remove(childId);
    }

    private async Task SaveJourneyMoment()
    {
        _isSaving = true;
        try
        {
            var targetChildIds = ChildId.HasValue ? new[] { ChildId.Value } : _selectedChildIds.ToArray();
            var targetClassroomId = ClassroomId ?? _selectedDropdownClassroomId;

            var targetScheduleId = _selectedPlannedScheduleId ?? ExperienceScheduleId;
            Guid? targetExperienceId = ExperienceId;
            string? targetExperienceTitle = ExperienceTitle;

            if (_selectedPlannedExperience != null)
            {
                targetExperienceId = _selectedPlannedExperience.ExperienceId;
                targetExperienceTitle = _selectedPlannedExperience.Title;
                targetScheduleId = _selectedPlannedExperience.ScheduleId;
            }
            else if (targetScheduleId.HasValue && !targetExperienceId.HasValue)
            {
                var sch = await PlannerService.GetScheduleAsync(targetScheduleId.Value);
                if (sch != null)
                {
                    targetExperienceId = sch.ExperienceId;
                }
            }
            
            foreach (var targetChildId in targetChildIds)
            {
                var entry = new ChildJourneyEntry
                {
                    ChildId = targetChildId,
                    TeacherId = TeacherId,
                    ClassroomId = targetClassroomId,
                    ExperienceId = targetExperienceId,
                    ExperienceScheduleId = targetScheduleId,
                    Title = targetExperienceTitle,
                    ExperienceSessionId = ExperienceSessionId,
                    ExperienceParticipationId = ExperienceParticipationId,
                    JourneyType = "Observation",
                    Observation = _observation,
                    ObservationDate = DateTimeOffset.UtcNow,
                    IsParentVisible = _isParentVisible,
                    ParentVisibilityStatus = _isParentVisible ? "Approved" : "Draft"
                };

                await JourneyService.CreateJourneyEntryAsync(entry, _selectedAreas);
                
                if (!string.IsNullOrEmpty(_photoUrl))
                {
                    var evidence = new ChildJourneyEvidence
                    {
                        JourneyEntryId = entry.Id,
                        EvidenceType = "Photo",
                        TextContent = _photoUrl,
                        Visibility = _isParentVisible ? "Parent" : "InternalOnly"
                    };
                    await JourneyService.CreateJourneyEvidenceAsync(evidence);
                }
            }

            _hideDialog = true;
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}

