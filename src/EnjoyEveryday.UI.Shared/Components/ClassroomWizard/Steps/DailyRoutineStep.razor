@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Arrival Time</label>
    <input @bind="Model.ArrivalTime" type="time" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Meal Time</label>
    <input @bind="Model.MealTime" type="time" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Nap Time</label>
    <input @bind="Model.NapTime" type="time" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Departure Time</label>
    <input @bind="Model.DepartureTime" type="time" />
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
