@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div style="background: #fcfdfc; padding: 1.5rem; border: 1px solid #e4e7df; border-radius: 8px;">
    <h3 style="margin-top: 0; color: #26332d; font-size: 1.25rem; margin-bottom: 1rem; border-bottom: 1px solid #e4e7df; padding-bottom: 0.5rem;">Review Classroom Configuration</h3>
    
    <dl style="margin: 0;">
        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Classroom Name</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@Model.Name</dd>
        
        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Code</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@(string.IsNullOrEmpty(Model.Code) ? "-" : Model.Code)</dd>
        
        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Classroom Type</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@Model.ClassroomType</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Age Group</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@Model.AgeGroup</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Capacity</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@(Model.Capacity.HasValue ? Model.Capacity.Value.ToString() : "-")</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Environment</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@Model.Environment</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Lead Teacher</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@(string.IsNullOrEmpty(Model.LeadTeacher) ? "-" : Model.LeadTeacher)</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Assistant Teachers</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@(string.IsNullOrEmpty(Model.AssistantTeachers) ? "-" : Model.AssistantTeachers)</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Schedule</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">@(Model.OpeningTime?.ToString("t")) - @(Model.ClosingTime?.ToString("t"))</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Daily Routine</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">Arrival: @(Model.ArrivalTime?.ToString("t")), Meals: @(Model.MealTime?.ToString("t")), Nap: @(Model.NapTime?.ToString("t")), Departure: @(Model.DepartureTime?.ToString("t"))</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Safety</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">Exit: @(Model.EmergencyExit ?? "-") | Assembly: @(Model.AssemblyPoint ?? "-") | First Aid: @(Model.FirstAidLocation ?? "-")</dd>

        <dt style="font-weight: 600; color: #666; font-size: 0.85rem; text-transform: uppercase;">Resources</dt>
        <dd style="margin: 0 0 1rem 0; color: #26332d;">Equipment: @(Model.Equipment ?? "-") | Learning: @(Model.LearningResources ?? "-")</dd>
    </dl>
</div>

<p style="margin-top: 1rem; color: #666;">If everything looks good, you can either save this as a draft or create the classroom.</p>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
