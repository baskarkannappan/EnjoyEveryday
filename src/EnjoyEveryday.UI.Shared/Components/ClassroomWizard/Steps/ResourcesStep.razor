@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Equipment</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">List any major physical equipment (e.g. Activity tables, reading rugs).</p>
    <textarea @bind="Model.Equipment" placeholder="Enter equipment details..." style="width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid #ccc; min-height: 80px;"></textarea>
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Learning Resources</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">Specify specific learning materials needed.</p>
    <textarea @bind="Model.LearningResources" placeholder="Enter learning materials..." style="width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid #ccc; min-height: 80px;"></textarea>
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
