@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Learning Environment</label>
    <select @bind="Model.Environment">
        <option value="Indoor">Indoor</option>
        <option value="Outdoor">Outdoor</option>
        <option value="Mixed">Mixed</option>
    </select>
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
