@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Emergency Exit Route</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">Specify the designated emergency exit for this classroom.</p>
    <input @bind="Model.EmergencyExit" placeholder="e.g. North corridor, Door A" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>First Aid Kit Location</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">Where is the first aid kit stored?</p>
    <input @bind="Model.FirstAidLocation" placeholder="e.g. Wall cabinet near sink" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Emergency Assembly Point</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">Where should children gather outside?</p>
    <input @bind="Model.AssemblyPoint" placeholder="e.g. Playground zone 2" />
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
