@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div class="field" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem;">
    <div style="width: 80px; height: 80px; border-radius: 50%; background: #e4e7df; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" style="width: 100%; height: 100%; object-fit: cover;" />
        }
        else
        {
            <span style="color: #666; font-size: 2rem;">🏫</span>
        }
    </div>
    <div style="flex-grow: 1;">
        <label>Classroom Profile Photo</label>
        <div style="display: flex; gap: 10px; flex-direction: column;">
            <AvifImageUploader @bind-Value="Model.PhotoUrl" ButtonText="Upload Image (Auto-Converts to AVIF)" />
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 12px; color: #666;">OR</span>
                <input @bind="Model.PhotoUrl" type="text" placeholder="https://example.com/photo.jpg" style="flex-grow: 1;" />
            </div>
        </div>
    </div>
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Classroom Name *</label>
    <input @bind="Model.Name" placeholder="e.g. Sunflowers" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Classroom Code</label>
    <input @bind="Model.Code" placeholder="e.g. SUN-01" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Classroom Type</label>
    <select @bind="Model.ClassroomType">
        <option value="Infant">Infant</option>
        <option value="Toddler">Toddler</option>
        <option value="Preschool">Preschool</option>
        <option value="Pre-K">Pre-K</option>
        <option value="Kindergarten">Kindergarten</option>
        <option value="Mixed Age">Mixed Age</option>
        <option value="Special Program">Special Program</option>
    </select>
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Age Group</label>
    <input @bind="Model.AgeGroup" placeholder="e.g. 3-4 years" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Description</label>
    <textarea @bind="Model.Description" rows="3" placeholder="A warm, creative classroom focused on exploration and social learning."></textarea>
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
