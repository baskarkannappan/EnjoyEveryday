@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Lead Teacher</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">Select the primary educator responsible for this classroom.</p>
    <input @bind="Model.LeadTeacher" placeholder="e.g. Jane Doe" />
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Assistant Teachers</label>
    <p style="color: #666; font-size: 0.9rem; margin-top: 0;">Comma-separated list of supporting educators.</p>
    <input @bind="Model.AssistantTeachers" placeholder="e.g. John Smith, Mary Johnson" />
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = default!;
}
