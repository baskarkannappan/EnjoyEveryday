@namespace EnjoyEveryday.UI.Shared.Components.ClassroomWizard
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard.Steps
@using Microsoft.AspNetCore.Components

<style>
::deep .field label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    color: #7c877f;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
    text-transform: uppercase;
}
::deep .field input, ::deep .field select, ::deep .field textarea {
    width: 100%;
    border: 1px solid #e4e7df;
    border-radius: 10px;
    padding: 12px 14px;
    background: #fcfdfc;
    outline: none;
    font-size: 14px;
    color: #26332d;
}
::deep .field input:focus, ::deep .field select:focus, ::deep .field textarea:focus {
    border-color: #557660;
    background: white;
}

.wizard-container {
    display: flex;
    gap: 40px;
    background: white;
    border: 1px solid #e3e7e1;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
}

.wizard-sidebar-container {
    width: 220px;
    flex-shrink: 0;
    border-right: 1px solid #e3e7e1;
    padding-right: 20px;
}

.wizard-content-container {
    flex-grow: 1;
}
</style>

<div class="wizard-container">
    <!-- Sidebar -->
    <div class="wizard-sidebar-container">
        <WizardSidebar 
            Steps="@_steps" 
            CurrentStep="@_currentStep" 
            MaxAllowedStep="@_maxAllowedStep" 
            OnStepClicked="NavigateToStep" />
    </div>

    <!-- Content -->
    <div class="wizard-content">
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <div class="eyebrow">STEP @_currentStep</div>
            <div style="font-size: 0.85rem; font-weight: 600; color: #52745e;">
                Completion: @GetCompletionPercentage()%
                <div style="width: 100px; height: 6px; background: #e4e7df; border-radius: 3px; display: inline-block; margin-left: 10px; vertical-align: middle;">
                    <div style="width: @GetCompletionPercentage()%; height: 100%; background: #52745e; border-radius: 3px;"></div>
                </div>
            </div>
        </div>
        <h3 style="margin: 0 0 24px 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">@_steps[_currentStep - 1]</h3>

        @if (_currentStep == 1)
        {
            <BasicInfoStep Model="Model" />
        }
        else if (_currentStep == 2)
        {
            <CapacityStep Model="Model" />
        }
        else if (_currentStep == 3)
        {
            <EnvironmentStep Model="Model" />
        }
        else if (_currentStep == 4)
        {
            <TeachersStep Model="Model" />
        }
        else if (_currentStep == 5)
        {
            <ScheduleStep Model="Model" />
        }
        else if (_currentStep == 6)
        {
            <DailyRoutineStep Model="Model" />
        }
        else if (_currentStep == 7)
        {
            <SafetyStep Model="Model" />
        }
        else if (_currentStep == 8)
        {
            <ResourcesStep Model="Model" />
        }
        else if (_currentStep == 9)
        {
            <ReviewStep Model="Model" />
        }

        <div style="margin-top: 40px; display: flex; justify-content: space-between; padding-top: 24px; border-top: 1px solid #e4e7df;">
            <div>
                @if (_currentStep > 1)
                {
                    <button class="secondary" @onclick="PreviousStep">Back</button>
                }
            </div>
            
            <div style="display: flex; gap: 10px;">
                <button class="secondary" @onclick="SaveDraft">Save Draft</button>
                
                @if (_currentStep < _steps.Count)
                {
                    <button class="primary" @onclick="NextStep">Continue</button>
                }
                else
                {
                    <button class="primary" @onclick="Submit">Create Classroom</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ClassroomWizardModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<ClassroomWizardModel> OnSaveDraft { get; set; }

    [Parameter]
    public EventCallback<ClassroomWizardModel> OnSubmit { get; set; }

    private int _currentStep = 1;
    private int _maxAllowedStep = 1;

    protected override void OnParametersSet()
    {
        // If we are editing an existing classroom (it has a name), unlock all steps so the user can navigate freely.
        if (_maxAllowedStep == 1 && !string.IsNullOrWhiteSpace(Model.Name))
        {
            _maxAllowedStep = 9; 
        }
    }

    private readonly List<string> _steps = new()
    {
        "Basic Information",
        "Capacity",
        "Environment",
        "Teachers",
        "Schedule",
        "Daily Routine",
        "Safety",
        "Resources",
        "Review"
    };

    private void NavigateToStep(int step)
    {
        if (step <= _maxAllowedStep)
        {
            _currentStep = step;
        }
    }

    private void PreviousStep()
    {
        if (_currentStep > 1)
        {
            _currentStep--;
        }
    }

    private void NextStep()
    {
        if (_currentStep < _steps.Count)
        {
            _currentStep++;
            if (_currentStep > _maxAllowedStep)
            {
                _maxAllowedStep = _currentStep;
            }
        }
    }

    private async Task SaveDraft()
    {
        await OnSaveDraft.InvokeAsync(Model);
    }

    private async Task Submit()
    {
        await OnSubmit.InvokeAsync(Model);
    }

    private int GetCompletionPercentage()
    {
        int totalFields = 12; 
        int filledFields = 0;

        if (!string.IsNullOrWhiteSpace(Model.Name)) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.ClassroomType)) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.AgeGroup)) filledFields++;
        if (Model.Capacity.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.Environment)) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.LeadTeacher)) filledFields++;
        if (Model.OpeningTime.HasValue) filledFields++;
        if (Model.ArrivalTime.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.EmergencyExit)) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.AssemblyPoint)) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.Equipment)) filledFields++;
        if (!string.IsNullOrWhiteSpace(Model.LearningResources)) filledFields++;

        return (int)Math.Round((double)filledFields / totalFields * 100);
    }
}
