@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">@(IsEditing ? "EDIT" : "ADD")</div>
                    <h3 class="modal-title">@(IsEditing ? "Edit Child" : "Add Child")</h3>
                </div>
                <button class="modal-close" @onclick="OnClose" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(PhotoUrl))
                {
                    <div style="text-align: center; margin-bottom: 16px;">
                        <img src="@PhotoUrl" style="width: 110px; height: 110px; border-radius: 0px; object-fit: cover; border: 1px solid var(--border, #e4e7df);" />
                    </div>
                }

                <div class="field" style="margin-bottom: 12px;">
                    <label>First Name</label>
                    <input value="@FirstName" @onchange="@(e => FirstNameChanged.InvokeAsync(e.Value?.ToString()))" type="text" placeholder="e.g. Aarav" />
                </div>

                <div class="field" style="margin-bottom: 12px;">
                    <label>Last Name</label>
                    <input value="@LastName" @onchange="@(e => LastNameChanged.InvokeAsync(e.Value?.ToString()))" type="text" placeholder="e.g. Patel" />
                </div>

                <div class="field" style="margin-bottom: 14px;">
                    <label>Date of Birth</label>
                    <input type="date" value="@(DateOfBirth?.ToString("yyyy-MM-dd"))" @onchange="@(e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) DateOfBirthChanged.InvokeAsync(d); else DateOfBirthChanged.InvokeAsync(null); })" />
                </div>
            </div>

            <div class="modal-footer">
                @if (IsEditing)
                {
                    <button type="button" class="secondary" style="border-color: #fca5a5; color: #9b2c2c; margin-right: auto;" @onclick="OnDelete">Delete</button>
                }
                <button type="button" class="secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="primary" @onclick="OnSave">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public string? PhotoUrl { get; set; }

    [Parameter] public string? FirstName { get; set; }
    [Parameter] public EventCallback<string?> FirstNameChanged { get; set; }

    [Parameter] public string? LastName { get; set; }
    [Parameter] public EventCallback<string?> LastNameChanged { get; set; }

    [Parameter] public DateTime? DateOfBirth { get; set; }
    [Parameter] public EventCallback<DateTime?> DateOfBirthChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
