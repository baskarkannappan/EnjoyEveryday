@namespace EnjoyEveryday.UI.Shared.Components

<div class="branch-closed-lock-card" role="alert" aria-live="polite">
    <div class="branch-closed-icon-wrap" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#9b2c2c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>

    <div class="branch-closed-badge">@BadgeText</div>
    <h2 class="branch-closed-title">@Title</h2>
    <p class="branch-closed-message">@Message</p>

    @if (!string.IsNullOrWhiteSpace(BranchName) || !string.IsNullOrWhiteSpace(OrganizationName) || !string.IsNullOrWhiteSpace(Status) || !string.IsNullOrWhiteSpace(ClosureReason) || ReopeningDate.HasValue)
    {
        <div class="branch-closed-meta-grid">
            @if (!string.IsNullOrWhiteSpace(BranchName))
            {
                <div class="meta-row"><span>Branch</span><strong>@BranchName</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(OrganizationName))
            {
                <div class="meta-row"><span>Organization</span><strong>@OrganizationName</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Status))
            {
                <div class="meta-row"><span>Status</span><strong class="status-closed-text">@Status</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(ClosureReason))
            {
                <div class="meta-row"><span>Closure reason</span><strong>@ClosureReason</strong></div>
            }
            @if (ReopeningDate.HasValue)
            {
                <div class="meta-row"><span>Reopening date</span><strong>@ReopeningDate.Value.LocalDateTime.ToString("MMM dd, yyyy h:mm tt")</strong></div>
            }
        </div>
    }

    @if (ShowBlockedActivitiesList)
    {
        <div class="branch-closed-blocked-list">
            <div class="blocked-list-heading">Unavailable until the branch reopens:</div>
            <ul>
                <li>Child attendance</li>
                <li>Teacher classroom attendance</li>
                <li>Experience planning and execution</li>
                <li>Classroom activity logging</li>
                <li>Child daily care tracking</li>
                <li>Child movement tracking</li>
                <li>Other classroom operational activities</li>
            </ul>
        </div>
    }

    <div class="branch-closed-notice">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#31523c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>@AdminInstruction</span>
    </div>

    <div class="branch-closed-actions">
        @if (OnActionClick.HasDelegate)
        {
            <button type="button" class="btn primary" @onclick="OnActionClick">@ActionLabel</button>
        }
        else if (!string.IsNullOrWhiteSpace(ActionUrl))
        {
            <a href="@ActionUrl" class="btn primary">@ActionLabel</a>
        }

        @if (!string.IsNullOrWhiteSpace(SecondaryUrl) && !string.IsNullOrWhiteSpace(SecondaryLabel))
        {
            <a href="@SecondaryUrl" class="btn secondary">@SecondaryLabel</a>
        }
    </div>
</div>

<style>
    .branch-closed-lock-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-top: 4px solid #c53030;
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        padding: 32px 28px;
        max-width: 640px;
        margin: 24px auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .branch-closed-icon-wrap {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #fff5f5;
        border: 1px solid #fed7d7;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2px;
    }

    .branch-closed-badge {
        display: inline-block;
        background: #fff5f5;
        color: #9b2c2c;
        border: 1px solid #fed7d7;
        border-radius: 6px;
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .branch-closed-title {
        margin: 2px 0 0;
        font-size: 22px;
        font-weight: 800;
        color: var(--text, #26332d);
        letter-spacing: -0.3px;
    }

    .branch-closed-message {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: var(--muted, #6c7870);
        max-width: 520px;
    }

    .branch-closed-meta-grid {
        width: 100%;
        max-width: 520px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        text-align: left;
        font-size: 13px;
    }

    .branch-closed-meta-grid .meta-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: var(--muted, #6c7870);
    }

    .branch-closed-meta-grid .meta-row strong {
        color: var(--text, #26332d);
        text-align: right;
    }

    .branch-closed-meta-grid .status-closed-text {
        color: #9b2c2c;
    }

    .branch-closed-blocked-list {
        width: 100%;
        max-width: 520px;
        background: #fff8f6;
        border: 1px solid #fed7d7;
        border-radius: 12px;
        padding: 12px 18px;
        text-align: left;
    }

    .blocked-list-heading {
        font-size: 12.5px;
        font-weight: 750;
        color: #9b2c2c;
        margin-bottom: 6px;
    }

    .branch-closed-blocked-list ul {
        margin: 0;
        padding-left: 18px;
        font-size: 12.5px;
        color: #742a2a;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 4px 12px;
    }

    .branch-closed-notice {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 600;
        color: var(--text, #26332d);
        max-width: 520px;
        width: 100%;
        margin-top: 2px;
    }

    .branch-closed-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 6px;
    }

    @@media (max-width: 640px) {
        .branch-closed-lock-card {
            padding: 24px 16px;
            margin: 12px auto;
        }

        .branch-closed-title {
            font-size: 19px;
        }

        .branch-closed-meta-grid .meta-row {
            flex-direction: column;
            gap: 2px;
        }

        .branch-closed-meta-grid .meta-row strong {
            text-align: left;
        }

        .branch-closed-actions {
            width: 100%;
            flex-direction: column;
        }

        .branch-closed-actions .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Branch Closed";
    [Parameter] public string BadgeText { get; set; } = "BRANCH CLOSED";
    [Parameter] public string? BranchName { get; set; }
    [Parameter] public string? OrganizationName { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public string Message { get; set; } = "Your assigned branch is currently closed. You cannot access or perform classroom activities until the branch is reopened.";
    [Parameter] public string? ClosureReason { get; set; }
    [Parameter] public DateTimeOffset? ReopeningDate { get; set; }
    [Parameter] public bool ShowBlockedActivitiesList { get; set; } = true;
    [Parameter] public string AdminInstruction { get; set; } = "Please contact your Branch Admin or Organization Admin if you need more information.";
    [Parameter] public string ActionLabel { get; set; } = "Go to Branch Management";
    [Parameter] public string? ActionUrl { get; set; }
    [Parameter] public EventCallback OnActionClick { get; set; }
    [Parameter] public string? SecondaryLabel { get; set; }
    [Parameter] public string? SecondaryUrl { get; set; }
}
