@namespace EnjoyEveryday.UI.Shared.Components

<div class="perf-panel">
    <div class="perf-header-row">
        <div>
            <div class="perf-eyebrow">PEDAGOGICAL SIGNALS</div>
            <h3 class="perf-title">Experience Performance</h3>
            <p class="perf-description">Program signals &mdash; not child scores.</p>
        </div>
        @if (TotalFilteredCount > 0)
        {
            <span class="perf-count-badge">@TotalFilteredCount @(TotalFilteredCount == 1 ? "experience" : "experiences")</span>
        }
    </div>

    <!-- Search & Sort Controls -->
    <div class="perf-toolbar">
        <div class="perf-search-wrap">
            <svg class="perf-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text"
                   value="@SearchTerm"
                   @oninput="OnSearchInput"
                   placeholder="Filter experiences by name or creator..."
                   class="perf-search-input" />
            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <button type="button" class="btn-clear-search" @onclick="ClearSearch" title="Clear filter">✕</button>
            }
        </div>
    </div>

    <!-- Table Header -->
    <div class="perf-grid-header">
        <button type="button" class="sortable-col-btn @(_sortColumn == "title" ? "active" : "")" @onclick='() => SortByColumn("title")'>
            <span>EXPERIENCE</span>
            @if (_sortColumn == "title")
            {
                <span class="sort-indicator">@(_sortAscending ? "▲" : "▼")</span>
            }
        </button>
        <button type="button" class="sortable-col-btn center @(_sortColumn == "uses" ? "active" : "")" @onclick='() => SortByColumn("uses")'>
            <span>USES</span>
            @if (_sortColumn == "uses")
            {
                <span class="sort-indicator">@(_sortAscending ? "▲" : "▼")</span>
            }
        </button>
        <button type="button" class="sortable-col-btn center @(_sortColumn == "response" ? "active" : "")" @onclick='() => SortByColumn("response")'>
            <span>RESPONSE</span>
            @if (_sortColumn == "response")
            {
                <span class="sort-indicator">@(_sortAscending ? "▲" : "▼")</span>
            }
        </button>
        <div class="col-label right">INSIGHT</div>
    </div>

    <!-- Rows -->
    <div class="perf-rows-list">
        @if (PagedItems != null && PagedItems.Any())
        {
            @foreach (var item in PagedItems)
            {
                <div class="perf-item-card">
                    <div class="perf-exp-col">
                        <div class="perf-exp-icon">🌱</div>
                        <div class="perf-exp-text">
                            <strong class="perf-exp-title" title="@item.Title">@item.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                            {
                                <small class="perf-exp-sub">@item.Subtitle</small>
                            }
                        </div>
                    </div>

                    <div class="perf-metric-col">
                        <span class="uses-pill @(item.Uses > 0 ? "has-uses" : "")">
                            @item.Uses @(item.Uses == 1 ? "run" : "runs")
                        </span>
                    </div>

                    <div class="perf-metric-col">
                        <span class="response-pill">@item.Response</span>
                    </div>

                    <div class="perf-action-col">
                        <button type="button"
                                class="btn-view-insight"
                                disabled="@IsActionDisabled"
                                title="@(IsActionDisabled && !string.IsNullOrWhiteSpace(DisabledReason) ? DisabledReason : $"Log or view moments for {item.Title}")"
                                @onclick="() => OnViewClick.InvokeAsync(item)">
                            <span>View</span>
                            <span class="arrow">&rarr;</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="perf-empty-state">
                <span class="empty-icon">🌿</span>
                <strong>No experiences found</strong>
                <p>No experiences match your current search criteria.</p>
                @if (!string.IsNullOrWhiteSpace(SearchTerm))
                {
                    <button type="button" class="btn-reset-filter" @onclick="ClearSearch">Clear search</button>
                }
            </div>
        }
    </div>

    <!-- Pagination Footer -->
    @if (TotalFilteredCount > 0)
    {
        <div class="perf-pagination-bar">
            <div class="perf-page-summary">
                Showing <strong>@PageStartItem&ndash;@PageEndItem</strong> of <strong>@TotalFilteredCount</strong>
                <span class="perf-page-pill">Page @SafeCurrentPage of @TotalPages</span>
            </div>
            <div class="perf-page-actions">
                <button type="button"
                        class="btn-perf-page secondary"
                        disabled="@(SafeCurrentPage <= 1)"
                        @onclick="PrevPage">
                    &larr; Previous
                </button>
                <button type="button"
                        class="btn-perf-page primary"
                        disabled="@(SafeCurrentPage >= TotalPages)"
                        @onclick="NextPage">
                    Next &rarr;
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public IQueryable<ExperiencePerformanceItem>? Items { get; set; }

    [Parameter]
    public EventCallback<ExperiencePerformanceItem> OnViewClick { get; set; }

    [Parameter]
    public bool IsActionDisabled { get; set; }

    [Parameter]
    public string? DisabledReason { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 5;

    private string _sortColumn = "title";
    private bool _sortAscending = true;

    private IEnumerable<ExperiencePerformanceItem> FilteredAndSortedItems
    {
        get
        {
            var list = Items?.Where(i =>
                string.IsNullOrEmpty(SearchTerm) ||
                (i.Title != null && i.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (i.Subtitle != null && i.Subtitle.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))).ToList()
                ?? new List<ExperiencePerformanceItem>();

            list = _sortColumn switch
            {
                "title" => _sortAscending ? list.OrderBy(i => i.Title).ToList() : list.OrderByDescending(i => i.Title).ToList(),
                "uses" => _sortAscending ? list.OrderBy(i => i.Uses).ToList() : list.OrderByDescending(i => i.Uses).ToList(),
                "response" => _sortAscending ? list.OrderBy(i => i.Response).ToList() : list.OrderByDescending(i => i.Response).ToList(),
                _ => list
            };

            return list;
        }
    }

    private int TotalFilteredCount => FilteredAndSortedItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)PageSize));
    private int SafeCurrentPage => Math.Clamp(CurrentPage, 1, TotalPages);
    private int PageStartItem => TotalFilteredCount == 0 ? 0 : ((SafeCurrentPage - 1) * PageSize) + 1;
    private int PageEndItem => Math.Min(SafeCurrentPage * PageSize, TotalFilteredCount);

    private IEnumerable<ExperiencePerformanceItem> PagedItems =>
        FilteredAndSortedItems.Skip((SafeCurrentPage - 1) * PageSize).Take(PageSize);

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
        CurrentPage = 1;
    }

    private void SortByColumn(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = column == "title";
        }
        CurrentPage = 1;
    }

    private void PrevPage()
    {
        if (SafeCurrentPage > 1)
        {
            CurrentPage = SafeCurrentPage - 1;
        }
    }

    private void NextPage()
    {
        if (SafeCurrentPage < TotalPages)
        {
            CurrentPage = SafeCurrentPage + 1;
        }
    }
}
