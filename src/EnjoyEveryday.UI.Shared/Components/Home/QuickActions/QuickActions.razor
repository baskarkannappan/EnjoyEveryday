@namespace EnjoyEveryday.UI.Shared.Components.Home
<div class="section-card">

    <div class="section-header">
        <h2>Quick actions</h2>
    </div>

    <div class="quick-actions">
        <QuickActionItem Icon="✦" Title="Create experience" Description="Make something new" OnClick="openPage('experiences', null)" />
