        <QuickActionItem Icon="◫" Title="View classrooms" Description="See today's rhythm" OnClick="openPage('classrooms', null)" />
        <QuickActionItem Icon="♡" Title="Ask AI" Description="Help me think" OnClick="showModal('AI Help')" />
    </div>

</div>

