@namespace EnjoyEveryday.UI.Shared.Components.Home
<div class="moment">
    <div class="moment-name">
        @Name
    </div>
    <div class="moment-text">
        @Text
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
}

