@namespace EnjoyEveryday.UI.Shared.Components.Home
<div class="classroom">
    <div class="classroom-top">
        <div class="classroom-name">
            <div class="classroom-dot"></div>
            <div>
                <strong>@Name</strong>
                <small>Age @AgeRange • @Teacher</small>
            </div>
        </div>
        <span class="status @StatusClass">
            @Status
        </span>
    </div>
    @if (ShowBottom)
    {
        <div class="classroom-bottom">
            <div class="mini-info">
                Children
                <strong>@ChildrenPresent / @ChildrenTotal</strong>
            </div>
            <div class="mini-info">
                Experience
                <strong>@Experience</strong>
            </div>
            <button class="view-btn" onclick="showModal('@Name')">
                Open →
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string AgeRange { get; set; } = "";
    [Parameter] public string Teacher { get; set; } = "";
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string StatusClass { get; set; } = "";
    [Parameter] public int ChildrenPresent { get; set; }
    [Parameter] public int ChildrenTotal { get; set; }
    [Parameter] public string Experience { get; set; } = "";
    [Parameter] public bool ShowBottom { get; set; } = true;
}

