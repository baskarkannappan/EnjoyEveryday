@namespace EnjoyEveryday.UI.Shared.Components.Home

<div class="classroom-card-delight">
    <!-- Top 3D Glossy Initial Sphere with Whimsical Stars -->
    <div class="classroom-sphere-wrap">
        <!-- Floating Yellow Stars -->
        <span class="star-deco star-1">★</span>
        <span class="star-deco star-2">★</span>
        <span class="star-deco star-3">★</span>
        <span class="star-deco star-4">★</span>

        <div class="classroom-glossy-orb">
            <span class="orb-initial">@(string.IsNullOrWhiteSpace(Name) ? "A" : Name[0].ToString().ToUpper())</span>
        </div>
    </div>

    <!-- Title & Details -->
    <div class="classroom-header-info">
        <h3 class="classroom-title">@Name</h3>
        <p class="classroom-meta">
            Age: @AgeRange &nbsp;|&nbsp; @(ChildrenTotal > 0 ? $"{ChildrenTotal} children" : Teacher)
            @if (!string.IsNullOrWhiteSpace(Experience))
            {
                <span>&nbsp;|&nbsp; @Experience</span>
            }
        </p>
    </div>

    <!-- Progress / Occupancy Bar -->
    <div class="classroom-progress-wrap">
        @{
            var pct = ChildrenTotal > 0 ? Math.Min(100, (int)Math.Round((double)ChildrenPresent / ChildrenTotal * 100)) : 100;
        }
        <div class="progress-track">
            <div class="progress-fill" style="width: @(pct)%"></div>
        </div>
        <span class="progress-label">@(pct)% Complete</span>
    </div>

    <!-- Status Badge -->
    <div class="classroom-status-row">
        <span class="status-pill-badge @StatusClass">
            <span class="status-check">✓</span>
            <span>@(string.IsNullOrWhiteSpace(Status) ? "Active" : Status)</span>
        </span>
    </div>

    <!-- Action Button -->
    <div class="classroom-action-row">
        <button type="button" class="btn-classroom-view" onclick="showModal('@Name')">
            <span>View Details</span>
            <span class="arrow">&rarr;</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string AgeRange { get; set; } = "";
    [Parameter] public string Teacher { get; set; } = "";
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string StatusClass { get; set; } = "";
    [Parameter] public int ChildrenPresent { get; set; }
    [Parameter] public int ChildrenTotal { get; set; }
    [Parameter] public string Experience { get; set; } = "";
    [Parameter] public bool ShowBottom { get; set; } = true;
}

