@namespace EnjoyEveryday.UI.Shared.Components.Home
<div class="attention">
    <div class="attention-icon">@Icon</div>
    <div>
        <strong>@Title</strong>
        <p>@Description</p>
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
}

