@namespace EnjoyEveryday.UI.Shared.Components.Home
<div class="pulse">

    <div class="pulse-card pulse-main">
        <div class="pulse-header-row">
            <span class="pulse-badge">✦ DAYCARE TODAY</span>
            <div class="pulse-star-deco">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
                </svg>
            </div>
        </div>
        <div class="pulse-headline">A day full of possibility.</div>
        <div class="pulse-metrics-strip">
            <span class="pulse-metric-pill">
                <strong>42</strong> children
            </span>
            <span class="pulse-metric-dot">•</span>
            <span class="pulse-metric-pill">
                <strong>3</strong> classrooms
            </span>
            <span class="pulse-metric-dot">•</span>
            <span class="pulse-metric-pill">
                <strong>8</strong> experiences
            </span>
        </div>
    </div>

    <div class="pulse-card">
        <div class="stat-label">Children here</div>
        <div class="stat-number">42</div>
        <div class="stat-note">of 47 expected today</div>
    </div>

    <div class="pulse-card">
        <div class="stat-label">Experiences</div>
        <div class="stat-number">8</div>
        <div class="stat-note">3 happening now</div>
    </div>

    <div class="pulse-card">
        <div class="stat-label">Teachers</div>
        <div class="stat-number">7</div>
        <div class="stat-note">All classrooms covered</div>
    </div>

</div>

