@namespace EnjoyEveryday.UI.Shared.Components.Users
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.UI.Shared.Components

@inject IUserRepository UserRepository
@inject BranchService BranchService
@inject ITenantContext TenantContext
@inject IUserContext UserContext
@inject IAccessScopeRepository AccessScopeRepo

<div class="users-by-role-view">
    <!-- SUCCESS NOTIFICATION -->
    @if (!string.IsNullOrEmpty(_successBanner))
    {
        <div class="success-banner-box">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span>✨</span>
                <span>@_successBanner</span>
            </div>
            <button type="button" @onclick="() => _successBanner = null" class="close-banner-btn">✕</button>
        </div>
    }

    <!-- SEARCH & FILTER ROW -->
    <div class="search-row" style="margin-bottom: 14px;">
        <input class="search" 
               @bind="_searchTerm" 
               @bind:event="oninput" 
               placeholder="Search team members by name, email, or role..." />
               
        <select class="filter" @bind="_selectedFilter" @bind:after="RecomputeGroups" style="padding: 10px 14px; border-radius: 0px; border: 1px solid var(--border, #e4e7df); font-weight: 650; color: var(--text, #26332d); background: white; font-size: 13px; cursor: pointer;">
            <option value="All">All Roles (@_allUsers.Count)</option>
            <option value="Admin">Leadership &amp; Admins</option>
            <option value="Teacher">Educators &amp; Teachers</option>
            <option value="Parent">Families &amp; Parents</option>
        </select>
    </div>

    <!-- FILTER TABS -->
    <FilterTabs Tabs="UserRoleTabs" ActiveTab="@_selectedFilter" OnTabSelected="SetRoleFilter" />

    <!-- HIERARCHY GROUPS -->
    @if (_isLoading)
    {
        <LoadingState Message="Loading team members and resolving role hierarchy..." />
    }
    else if (!_groupedRoles.Any())
    {
        <EmptyState Icon="👥"
                    Title="No team members found"
                    Description="No users matched your search criteria." />
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 36px;">
            @foreach (var group in _groupedRoles)
            {
                <div>
                    <!-- GROUP HEADER -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border, #e1e6df); flex-wrap: wrap; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 36px; height: 36px; border-radius: 0px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 18px;">
                                @group.HierarchyIcon
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <h2 style="font-size: 18px; font-weight: 750; color: var(--text, #26332d); margin: 0; letter-spacing: -0.3px;">
                                        @group.RoleDisplayName
                                    </h2>
                                    <span style="background: #eef2ed; color: var(--accent-dark, #3e6253); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 0px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        Rank @group.HierarchyRank
                                    </span>
                                    <span style="background: white; border: 1px solid var(--border, #e4e7df); color: var(--muted, #6c7870); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 0px;">
                                        @group.Scope Scope
                                    </span>
                                </div>
                                <p style="margin: 3px 0 0 0; font-size: 13px; color: var(--muted, #6c7870);">@group.Description</p>
                            </div>
                        </div>

                        <span style="font-size: 12px; font-weight: 700; color: var(--muted, #6c7870); background: white; border: 1px solid var(--border, #e4e7df); padding: 4px 12px; border-radius: 0px;">
                            @group.Users.Count member@(group.Users.Count == 1 ? "" : "s")
                        </span>
                    </div>

                    <!-- PEOPLE GRID -->
                    <div class="people-grid">
                        @foreach (var user in group.Users)
                        {
                            <PersonCard AvatarInitials="@(user.DisplayName.Length > 0 ? user.DisplayName.Substring(0, 1).ToUpper() : (user.Email.Length > 0 ? user.Email.Substring(0, 1).ToUpper() : "?"))"
                                        Name="@user.DisplayName"
                                        Subtitle="@user.Email"
                                        Status="@(user.IsActive ? "Active" : "Inactive")"
                                        HighlightTitle="@(user.ClassroomName != null ? "Classroom Assignment" : (user.AssociatedChildrenCount > 0 ? "Enrolled Children" : (!string.IsNullOrEmpty(user.OrganizationName) ? "Organization" : "Authority Scope")))"
                                        HighlightText="@(user.ClassroomName ?? (user.AssociatedChildrenCount > 0 ? $"{user.AssociatedChildrenCount} child(ren) enrolled" : (!string.IsNullOrEmpty(user.OrganizationName) ? user.OrganizationName : $"{group.Scope} Level Permissions")))" />
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- ADD TEAM MEMBER MODAL -->
    @if (_showAddUserModal)
    {
        <div class="modal-backdrop" @onclick="CloseAddUserModal">
            <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 520px; width: 100%;">
                <div class="modal-header">
                    <div>
                        <div class="modal-eyebrow">ORGANIZATION STAFF</div>
                        <h3 class="modal-title">Add Team Member</h3>
                    </div>
                    <button type="button" class="modal-close" @onclick="CloseAddUserModal">✕</button>
                </div>
                <div class="modal-body">
                    <p style="margin: 0 0 12px 0; font-size: 13px; color: var(--muted, #6c7870);">Create a user account and assign organization or branch authority.</p>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="modal-error-box">
                            @_errorMessage
                        </div>
                    }

                    <div style="display: flex; flex-direction: column; gap: 14px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <label class="field-label">First Name</label>
                                <input type="text" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="e.g. Maria" @bind="_newUserFirstName" />
                            </div>
                            <div>
                                <label class="field-label">Last Name</label>
                                <input type="text" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="e.g. Montessori" @bind="_newUserLastName" />
                            </div>
                        </div>

                        <div>
                            <label class="field-label">Email Address <span style="color: #c53030;">*</span></label>
                            <input type="email" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="educator@daycare.org" @bind="_newUserEmail" />
                        </div>

                        <div>
                            <label class="field-label">Assigned Role <span style="color: #c53030;">*</span></label>
                            <select class="filter" style="width: 100%; box-sizing: border-box; padding: 10px 12px; font-size: 13px; font-weight: 600; border-radius: 0px; background: white;" @bind="_newUserRole">
                                @if (_isOrgAdmin)
                                {
                                    <option value="OrganizationAdmin">🏢 Organization Admin (Org Level)</option>
                                    <option value="BranchAdmin">🏛️ Branch Admin</option>
                                }
                                <option value="LeadTeacher">🎓 Lead Teacher</option>
                                <option value="ClassroomTeacher">✏️ Teacher / Educator</option>
                                <option value="DaycareTeacher">🧸 Assistant Teacher</option>
                            </select>
                        </div>

                        @if (_newUserRole == "BranchAdmin" || _newUserRole == "LeadTeacher" || _newUserRole == "ClassroomTeacher" || _newUserRole == "DaycareTeacher")
                        {
                            <div>
                                <label class="field-label">Assigned Branch Location</label>
                                <select class="filter" style="width: 100%; box-sizing: border-box; padding: 10px 12px; font-size: 13px; font-weight: 600; border-radius: 0px; background: white;" @bind="_selectedBranchId">
                                    <option value="">-- All Authorized Branches / None --</option>
                                    @foreach (var branch in _branches)
                                    {
                                        <option value="@branch.Id">@branch.Name @(!string.IsNullOrEmpty(branch.Location) ? $"({branch.Location})" : "")</option>
                                    }
                                </select>
                            </div>
                        }

                        <div>
                            <label class="field-label">Temporary Initial Password</label>
                            <input type="text" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="Welcome@123" @bind="_newUserPassword" />
                            <span class="field-hint">User can sign in with this temporary password or directly via Google SSO.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn secondary" @onclick="CloseAddUserModal" disabled="@_isSaving">Cancel</button>
                    <button type="button" class="btn primary" @onclick="HandleCreateUserAsync" disabled="@_isSaving" style="min-width: 130px;">
                        @(_isSaving ? "Creating..." : "Create Member")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string _searchTerm = "";
    private string _selectedFilter = "All";
    private List<UserRecordItem> _allUsers = new();
    private List<RoleGroup> _groupedRoles = new();

    private bool _showAddUserModal = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successBanner;

    private string _newUserFirstName = "";
    private string _newUserLastName = "";
    private string _newUserEmail = "";
    private string _newUserRole = "ClassroomTeacher";
    private string _newUserPassword = "Welcome@123";
    private string _selectedBranchId = "";
    private List<Branch> _branches = new();

    private bool _isOrgAdmin = true;
    private bool _isBranchAdmin = false;

    private List<FilterTabs.TabItem> UserRoleTabs = new()
    {
        new FilterTabs.TabItem { Text = "All Roles", Value = "All" },
        new FilterTabs.TabItem { Text = "Leadership & Admins", Value = "Admin" },
        new FilterTabs.TabItem { Text = "Educators & Teachers", Value = "Teacher" },
        new FilterTabs.TabItem { Text = "Families & Parents", Value = "Parent" }
    };

    protected override async Task OnInitializedAsync()
    {
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();
        _isOrgAdmin = userRoles.Any(r =>
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase));
        _isBranchAdmin = userRoles.Any(r => r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        await LoadUsersAsync();
    }

    public void OpenAddUserModal()
    {
        _showAddUserModal = true;
    }

    private void CloseAddUserModal()
    {
        _showAddUserModal = false;
        _errorMessage = null;
    }

    public async Task LoadUsersAsync()
    {
        try
        {
            _isLoading = true;
            var tenantId = TenantContext.TenantId;
            var users = (await UserRepository.GetUsersHierarchyAsync(tenantId)).ToList();

            if (UserContext.OrganizationId.HasValue)
            {
                _branches = (await BranchService.GetBranchesAsync(UserContext.OrganizationId.Value)).ToList();
            }

            _allUsers = users.Select(u => new UserRecordItem
            {
                Id = u.UserId,
                Email = u.Email,
                DisplayName = string.IsNullOrWhiteSpace(u.DisplayName) ? u.Email.Split('@')[0] : u.DisplayName,
                IsActive = u.IsActive,
                Role = u.CanonicalRoles.FirstOrDefault() ?? u.AssignedRoles.FirstOrDefault() ?? "Member",
                TenantId = tenantId,
                ClassroomName = u.ClassroomName,
                AssociatedChildrenCount = u.AssociatedChildrenCount,
                OrganizationName = u.OrganizationName
            }).ToList();

            RecomputeGroups();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SetRoleFilter(string filter)
    {
        _selectedFilter = filter;
        RecomputeGroups();
    }

    private void RecomputeGroups()
    {
        var q = _searchTerm?.Trim().ToLowerInvariant() ?? "";
        var filtered = _allUsers.Where(u =>
        {
            if (!string.IsNullOrWhiteSpace(q))
            {
                var matchName = u.DisplayName.ToLowerInvariant().Contains(q);
                var matchEmail = u.Email.ToLowerInvariant().Contains(q);
                var matchRole = u.Role.ToLowerInvariant().Contains(q);
                if (!matchName && !matchEmail && !matchRole) return false;
            }

            if (_selectedFilter == "Admin")
                return u.Role.Contains("Admin", StringComparison.OrdinalIgnoreCase) || u.Role.Contains("Owner", StringComparison.OrdinalIgnoreCase);
            if (_selectedFilter == "Teacher")
                return u.Role.Contains("Teacher", StringComparison.OrdinalIgnoreCase) || u.Role.Contains("Educator", StringComparison.OrdinalIgnoreCase);
            if (_selectedFilter == "Parent")
                return u.Role.Contains("Parent", StringComparison.OrdinalIgnoreCase) || u.Role.Contains("Family", StringComparison.OrdinalIgnoreCase);

            return true;
        }).ToList();

        var groups = filtered
            .GroupBy(u => u.Role)
            .Select(g => new RoleGroup
            {
                RoleName = g.Key,
                RoleDisplayName = FormatRoleName(g.Key),
                HierarchyRank = GetRoleRank(g.Key),
                HierarchyIcon = GetRoleIcon(g.Key),
                Scope = GetRoleScope(g.Key),
                Description = GetRoleDescription(g.Key),
                Users = g.ToList()
            })
            .OrderBy(g => g.HierarchyRank)
            .ToList();

        _groupedRoles = groups;
    }

    private async Task HandleCreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_newUserEmail))
        {
            _errorMessage = "Email address is required.";
            return;
        }

        try
        {
            _isSaving = true;
            _errorMessage = null;

            var tenantId = TenantContext.TenantId;
            var displayName = $"{_newUserFirstName} {_newUserLastName}".Trim();
            if (string.IsNullOrWhiteSpace(displayName)) displayName = _newUserEmail.Split('@')[0];

            var newUser = new User
            {
                Id = Guid.NewGuid(),
                TenantId = tenantId,
                Email = _newUserEmail.Trim(),
                FirstName = _newUserFirstName.Trim(),
                LastName = _newUserLastName.Trim(),
                DisplayName = displayName,
                IsActive = true,
                CreatedAt = DateTimeOffset.UtcNow,
                UpdatedAt = DateTimeOffset.UtcNow
            };

            await UserRepository.AddAsync(newUser, _newUserPassword);
            if (UserContext.OrganizationId.HasValue)
            {
                await UserRepository.AssignOrganizationRoleAsync(tenantId, UserContext.OrganizationId.Value, newUser.Id, _newUserRole);
                if (Guid.TryParse(_selectedBranchId, out var branchGuid))
                {
                    await UserRepository.AssignBranchToUserAsync(tenantId, UserContext.OrganizationId.Value, branchGuid, newUser.Id, UserContext.UserId);
                }
            }

            _successBanner = $"Team member '{displayName}' created successfully with role '{FormatRoleName(_newUserRole)}'.";
            CloseAddUserModal();
            _newUserFirstName = "";
            _newUserLastName = "";
            _newUserEmail = "";
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create team member: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string FormatRoleName(string role)
    {
        return role switch
        {
            "PlatformAdmin" => "Platform Administrator",
            "OrganizationOwner" => "Daycare Owner",
            "OrganizationAdmin" => "Organization Administrator",
            "BranchAdmin" => "Campus Branch Director",
            "LeadTeacher" => "Lead Educator",
            "ClassroomTeacher" => "Classroom Teacher",
            "DaycareTeacher" => "Assistant Teacher",
            "Parent" => "Family & Parent",
            _ => role
        };
    }

    private int GetRoleRank(string role)
    {
        return role switch
        {
            "PlatformAdmin" => 1,
            "OrganizationOwner" => 2,
            "OrganizationAdmin" => 2,
            "BranchAdmin" => 3,
            "LeadTeacher" => 4,
            "ClassroomTeacher" => 4,
            "DaycareTeacher" => 4,
            "Parent" => 5,
            _ => 6
        };
    }

    private string GetRoleIcon(string role)
    {
        return role switch
        {
            "PlatformAdmin" => "🛡️",
            "OrganizationOwner" => "🏢",
            "OrganizationAdmin" => "🏛️",
            "BranchAdmin" => "📍",
            "LeadTeacher" => "🎓",
            "ClassroomTeacher" => "✏️",
            "DaycareTeacher" => "🧸",
            "Parent" => "👨‍👩‍👧",
            _ => "👤"
        };
    }

    private string GetRoleScope(string role)
    {
        return role switch
        {
            "PlatformAdmin" => "Platform",
            "OrganizationOwner" or "OrganizationAdmin" => "Organization",
            "BranchAdmin" => "Branch",
            "LeadTeacher" or "ClassroomTeacher" or "DaycareTeacher" => "Classroom",
            "Parent" => "Family",
            _ => "Limited"
        };
    }

    private string GetRoleDescription(string role)
    {
        return role switch
        {
            "PlatformAdmin" => "Super administrator with cross-tenant management access.",
            "OrganizationOwner" or "OrganizationAdmin" => "Executive authority over all branches, billing, curriculum, and staffing.",
            "BranchAdmin" => "Location director responsible for daily campus attendance, rosters, and safety.",
            "LeadTeacher" or "ClassroomTeacher" => "Primary educators managing daily routines, learning moments, and parent messages.",
            "DaycareTeacher" => "Support educators assisting with classroom care and activity guidance.",
            "Parent" => "Families with view and direct messaging access for their enrolled children.",
            _ => "Authorized user role."
        };
    }

    private class UserRecordItem
    {
        public Guid Id { get; set; }
        public string Email { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public string Role { get; set; } = string.Empty;
        public Guid TenantId { get; set; }
        public string? ClassroomName { get; set; }
        public int AssociatedChildrenCount { get; set; }
        public string? OrganizationName { get; set; }
    }

    private class RoleGroup
    {
        public string RoleName { get; set; } = string.Empty;
        public string RoleDisplayName { get; set; } = string.Empty;
        public int HierarchyRank { get; set; }
        public string HierarchyIcon { get; set; } = "👤";
        public string Scope { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public List<UserRecordItem> Users { get; set; } = new();
    }
}
