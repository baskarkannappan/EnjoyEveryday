@namespace EnjoyEveryday.UI.Shared.Components.Users
@using System
@using System.Linq
@using System.Threading.Tasks
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.UI.Shared.Components

@inject IUserContext UserContext
@inject ITenantContext TenantContext
@inject IUserRepository UserRepository

<div class="user-profile-view">
    @if (_isLoading)
    {
        <LoadingState Message="Loading profile and security credentials..." />
    }
    else
    {
        <!-- Identity Summary Card -->
        <div style="background: var(--surface, #ffffff); border-radius: var(--radius, 18px); padding: 28px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); margin-bottom: 24px; border: 1px solid var(--border, #e4e7df);">
            <div style="display: flex; gap: 22px; align-items: center; margin-bottom: 24px;">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--accent, #557c6c), var(--accent-dark, #3e6253)); color: white; display: grid; place-items: center; font-size: 28px; font-weight: 750; box-shadow: 0 4px 14px rgba(85, 124, 108, 0.35); flex-shrink: 0;">
                    @(UserEmail?.FirstOrDefault().ToString().ToUpper() ?? "?")
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 22px; font-weight: 750; color: var(--text, #26332d); letter-spacing: -0.3px;">
                        @(UserDisplayName.Length > 0 ? UserDisplayName : UserEmail)
                    </h2>
                    <p style="margin: 4px 0 0 0; color: var(--muted, #6c7870); font-size: 14px; font-weight: 500;">@UserEmail</p>
                    <div style="margin-top: 6px; display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; border-radius: 6px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); font-family: monospace; font-size: 11px; color: var(--muted, #6c7870);">
                        <span>User ID:</span>
                        <span style="color: var(--text, #26332d); font-weight: 600;">@UserId</span>
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
                <div style="padding: 16px; background: var(--surface-soft, #f8f9f5); border-radius: 12px; border: 1px solid var(--border, #e4e7df);">
                    <div style="font-size: 11px; font-weight: 700; color: var(--muted, #6c7870); text-transform: uppercase; letter-spacing: 0.6px;">Tenant ID</div>
                    <div style="font-family: monospace; font-size: 13px; font-weight: 600; color: var(--text, #26332d); margin-top: 4px; word-break: break-all;">@TenantId</div>
                </div>
                <div style="padding: 16px; background: var(--surface-soft, #f8f9f5); border-radius: 12px; border: 1px solid var(--border, #e4e7df);">
                    <div style="font-size: 11px; font-weight: 700; color: var(--muted, #6c7870); text-transform: uppercase; letter-spacing: 0.6px;">Active Organization</div>
                    <div style="font-family: monospace; font-size: 13px; font-weight: 600; color: var(--text, #26332d); margin-top: 4px; word-break: break-all;">@(ActiveOrgId ?? "None / Platform Default")</div>
                </div>
            </div>
        </div>

        <!-- Assigned Roles Section -->
        <div style="background: var(--surface, #ffffff); border-radius: var(--radius, 18px); padding: 24px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); border: 1px solid var(--border, #e4e7df); margin-bottom: 24px;">
            <h3 style="font-size: 17px; font-weight: 750; color: var(--text, #26332d); margin: 0 0 16px 0;">Assigned Operational Roles</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                @foreach (var role in AssignedRoles)
                {
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; color: var(--accent-dark, #3e6253); font-size: 13px; font-weight: 750;">
                        🛡️ @role
                    </span>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string UserDisplayName = "";
    private string UserEmail = "";
    private string UserId = "";
    private string TenantId = "";
    private string? ActiveOrgId;
    private List<string> AssignedRoles = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            UserId = UserContext.UserId.ToString();
            TenantId = TenantContext.TenantId.ToString();
            ActiveOrgId = UserContext.OrganizationId?.ToString();
            UserEmail = UserContext.Email ?? "";
            UserDisplayName = UserEmail.Contains('@') ? UserEmail.Split('@')[0] : "User";
            AssignedRoles = UserContext.Roles?.ToList() ?? new List<string>();

            if (UserContext.UserId != Guid.Empty)
            {
                var record = await UserRepository.GetByIdAsync(TenantContext.TenantId, UserContext.UserId);
                if (record != null)
                {
                    if (!string.IsNullOrWhiteSpace(record.DisplayName)) UserDisplayName = record.DisplayName;
                    if (!string.IsNullOrWhiteSpace(record.Email)) UserEmail = record.Email;
                }
            }

            if (!AssignedRoles.Any()) AssignedRoles.Add("Member");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
