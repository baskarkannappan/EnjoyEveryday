@namespace EnjoyEveryday.UI.Shared.Components

<div class="search-row">
    <input class="search" placeholder="@SearchPlaceholder" @bind="SearchQuery" @bind:event="oninput" />
    @if (Filters != null)
    {
        @Filters
    }
</div>

@code {
    [Parameter] public string SearchPlaceholder { get; set; } = "Search...";
    
    private string _searchQuery = "";
    [Parameter] public string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                SearchQueryChanged.InvokeAsync(value);
            }
        }
    }
    
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }
    
    [Parameter] public RenderFragment? Filters { get; set; }
}
