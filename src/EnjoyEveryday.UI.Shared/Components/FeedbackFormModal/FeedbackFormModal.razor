@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop show" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="OnClose">✕</button>
            <h2>@(IsEditing ? "Edit Feedback" : "Log Feedback")</h2>
            
            <div class="field" style="margin-bottom: 1rem; margin-top: 1rem;">
                <label>Experience</label>
                <select value="@SelectedExperienceId" @onchange="@(e => SelectedExperienceIdChanged.InvokeAsync(e.Value?.ToString()))" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
                    @if (ExperienceOptions != null)
                    {
                        @foreach (var exp in ExperienceOptions)
                        {
                            <option value="@exp.Key">@exp.Value</option>
                        }
                    }
                </select>
            </div>

            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Rating</label>
                <select value="@Rating" @onchange="@(e => RatingChanged.InvokeAsync(e.Value?.ToString()))" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
                    <option value="Loved it">Loved it</option>
                    <option value="Good">Good</option>
                    <option value="Difficult">Difficult</option>
                    <option value="Didn't work">Didn't work</option>
                </select>
            </div>

            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Teacher Quote / Insight</label>
                <textarea value="@FeedbackText" @oninput="@(e => FeedbackTextChanged.InvokeAsync(e.Value?.ToString()))" rows="4" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; align-items: center; border-top: 1px solid #edf0ed; padding-top: 20px;">
                @if (IsEditing)
                {
                    <button class="secondary" style="color: red; border-color: red; margin-right: auto;" @onclick="OnDelete">Delete</button>
                }
                <button class="secondary" @onclick="OnClose">Cancel</button>
                <button class="primary" @onclick="OnSave">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    
    [Parameter] public string? SelectedExperienceId { get; set; }
    [Parameter] public EventCallback<string?> SelectedExperienceIdChanged { get; set; }
    
    [Parameter] public string Rating { get; set; } = "Good";
    [Parameter] public EventCallback<string> RatingChanged { get; set; }

    [Parameter] public string FeedbackText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> FeedbackTextChanged { get; set; }
    
    [Parameter] public IEnumerable<KeyValuePair<string, string>>? ExperienceOptions { get; set; }
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
