@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop show" @onclick="OnClose">
        <div class="modal modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">OBSERVATIONS &amp; FEEDBACK</div>
                    <h3 class="modal-title">@(IsEditing ? "Edit Feedback" : "Log Feedback")</h3>
                </div>
                <button class="modal-close" @onclick="OnClose" aria-label="Close">✕</button>
            </div>
            
            <div class="modal-body">
                <div class="field" style="margin-bottom: 12px;">
                    <label>Experience</label>
                    <select value="@SelectedExperienceId" @onchange="@(e => SelectedExperienceIdChanged.InvokeAsync(e.Value?.ToString()))">
                        @if (ExperienceOptions != null)
                        {
                            @foreach (var exp in ExperienceOptions)
                            {
                                <option value="@exp.Key">@exp.Value</option>
                            }
                        }
                    </select>
                </div>

                <div class="field" style="margin-bottom: 12px;">
                    <label>Rating</label>
                    <select value="@Rating" @onchange="@(e => RatingChanged.InvokeAsync(e.Value?.ToString()))">
                        <option value="Loved it">Loved it</option>
                        <option value="Good">Good</option>
                        <option value="Difficult">Difficult</option>
                        <option value="Didn't work">Didn't work</option>
                    </select>
                </div>

                <div class="field" style="margin-bottom: 14px;">
                    <label>Teacher Quote / Insight</label>
                    <textarea value="@FeedbackText" @oninput="@(e => FeedbackTextChanged.InvokeAsync(e.Value?.ToString()))" rows="4"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                @if (IsEditing)
                {
                    <button class="secondary" style="border-color: #fca5a5; color: #9b2c2c; margin-right: auto;" @onclick="OnDelete">Delete</button>
                }
                <button class="secondary" @onclick="OnClose">Cancel</button>
                <button class="primary" @onclick="OnSave">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    
    [Parameter] public string? SelectedExperienceId { get; set; }
    [Parameter] public EventCallback<string?> SelectedExperienceIdChanged { get; set; }
    
    [Parameter] public string Rating { get; set; } = "Good";
    [Parameter] public EventCallback<string> RatingChanged { get; set; }

    [Parameter] public string FeedbackText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> FeedbackTextChanged { get; set; }
    
    [Parameter] public IEnumerable<KeyValuePair<string, string>>? ExperienceOptions { get; set; }
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
