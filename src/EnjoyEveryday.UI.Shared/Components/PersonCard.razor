@namespace EnjoyEveryday.UI.Shared.Components

<div class="person" style="@(Status?.Equals("Inactive", StringComparison.OrdinalIgnoreCase) == true ? "background-color: #f5f5f5; border-color: #e0e0e0; opacity: 0.75;" : "")">
    <div class="person-header">
        <div class="person-avatar">
            @if (!string.IsNullOrEmpty(PhotoUrl))
            {
                <img src="@PhotoUrl" class="person-photo" alt="@Name" />
            }
            else
            {
                @AvatarInitials
            }
        </div>
        <div>
            <h3>@Name</h3>
            @if (SubtitleTemplate != null)
            {
                <div class="person-subtitle">@SubtitleTemplate</div>
            }
            else
            {
                <p>@Subtitle</p>
            }
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(HighlightTitle) || !string.IsNullOrEmpty(HighlightText))
    {
        <div class="person-interest">
            @if (!string.IsNullOrEmpty(HighlightTitle))
            {
                <strong>@HighlightTitle</strong>
            }
            @if (!string.IsNullOrEmpty(HighlightText))
            {
                <p>@HighlightText</p>
            }
        </div>
    }
    @if (Progress >= 0)
    {
        <div style="margin-top: 8px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 4px; font-weight: 600; color: #7c877f;">
                <span>@(string.IsNullOrEmpty(Status) ? "Draft" : Status)</span>
                <span>@Progress% Complete</span>
            </div>
            <div style="width: 100%; background: #eaf2ec; height: 6px; border-radius: 4px; overflow: hidden;">
                <div style="width: @Progress%; background: @(Status?.Equals("Inactive", StringComparison.OrdinalIgnoreCase) == true ? "#a0a0a0" : "#52745e"); height: 100%; border-radius: 4px;"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string AvatarInitials { get; set; } = "";
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public RenderFragment? SubtitleTemplate { get; set; }
    [Parameter] public string HighlightTitle { get; set; } = "";
    [Parameter] public string HighlightText { get; set; } = "";
    [Parameter] public int Progress { get; set; } = -1;
    [Parameter] public string Status { get; set; } = "";
}
