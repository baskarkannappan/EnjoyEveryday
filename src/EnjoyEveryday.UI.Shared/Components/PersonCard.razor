@namespace EnjoyEveryday.UI.Shared.Components

<div class="person @(Status?.Equals("Inactive", StringComparison.OrdinalIgnoreCase) == true ? "person-inactive" : "") @(Progress >= 0 || LargeAvatar ? "person-horizontal" : "")"
     style="@(Status?.Equals("Inactive", StringComparison.OrdinalIgnoreCase) == true ? "background-color: #f5f5f5; border-color: #e0e0e0; opacity: 0.75;" : "")">

    @if (Progress >= 0 || LargeAvatar)
    {
        <div class="person-horizontal-content">
            <div class="person-avatar-large">
                @if (!string.IsNullOrEmpty(PhotoUrl))
                {
                    <img src="@PhotoUrl" class="person-photo" alt="@Name" />
                }
                else
                {
                    <span class="person-initials-large">@AvatarInitials</span>
                }
            </div>
            <div class="person-body">
                <div class="person-info">
                    <h3 title="@Name">@Name</h3>
                    @if (SubtitleTemplate != null)
                    {
                        <div class="person-subtitle">@SubtitleTemplate</div>
                    }
                    else
                    {
                        <p title="@Subtitle">@Subtitle</p>
                    }
                </div>

                @if (Progress >= 0)
                {
                    <div class="person-progress-wrap">
                        <div class="person-meta-row">
                            <span class="person-status-text">@(string.IsNullOrEmpty(Status) ? "Draft" : Status)</span>
                            <span class="person-progress-text">@Progress% Complete</span>
                        </div>
                        <div class="person-track">
                            <div class="person-bar" style="width: @Progress%; background: @(Status?.Equals("Inactive", StringComparison.OrdinalIgnoreCase) == true ? "#a0a0a0" : "#52745e");"></div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(HighlightTitle) || !string.IsNullOrEmpty(HighlightText))
                {
                    <div class="person-interest-inline">
                        @if (!string.IsNullOrEmpty(HighlightTitle))
                        {
                            <strong>@HighlightTitle</strong>
                        }
                        @if (!string.IsNullOrEmpty(HighlightText))
                        {
                            <p>@HighlightText</p>
                        }
                    </div>
                }
            </div>
        </div>

        @if (ActionTemplate != null)
        {
            <div class="person-card-actions">
                @ActionTemplate
            </div>
        }
    }
    else
    {
        <div class="person-header">
            <div class="person-avatar">
                @if (!string.IsNullOrEmpty(PhotoUrl))
                {
                    <img src="@PhotoUrl" class="person-photo" alt="@Name" />
                }
                else
                {
                    @AvatarInitials
                }
            </div>
            <div>
                <h3>@Name</h3>
                @if (SubtitleTemplate != null)
                {
                    <div class="person-subtitle">@SubtitleTemplate</div>
                }
                else
                {
                    <p>@Subtitle</p>
                }
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(HighlightTitle) || !string.IsNullOrEmpty(HighlightText))
        {
            <div class="person-interest">
                @if (!string.IsNullOrEmpty(HighlightTitle))
                {
                    <strong>@HighlightTitle</strong>
                }
                @if (!string.IsNullOrEmpty(HighlightText))
                {
                    <p>@HighlightText</p>
                }
            </div>
        }

        @if (ActionTemplate != null)
        {
            <div class="person-card-actions">
                @ActionTemplate
            </div>
        }
    }
</div>

@code {
    [Parameter] public string AvatarInitials { get; set; } = "";
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public RenderFragment? SubtitleTemplate { get; set; }
    [Parameter] public string HighlightTitle { get; set; } = "";
    [Parameter] public string HighlightText { get; set; } = "";
    [Parameter] public int Progress { get; set; } = -1;
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public bool LargeAvatar { get; set; } = false;
    [Parameter] public RenderFragment? ActionTemplate { get; set; }
}
