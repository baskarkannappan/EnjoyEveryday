@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

<article class="marketplace-item-card cat-@CategoryKey" data-status="@(Item.IsPurchasedOrEntitled ? "entitled" : "available")">
    <!-- Top Row: Category Chip & Pricing/Entitlement Badge -->
    <div class="card-top-row">
        <span class="category-chip @CategoryKey">
            <span class="category-icon">@GetCategoryIcon(Item.Category)</span>
            <span>@Item.Category</span>
        </span>
        <div class="status-wrapper">
            @if (Item.IsPurchasedOrEntitled)
            {
                <span class="status-badge entitled" title="Added to Organization Library">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Entitled</span>
                </span>
            }
            else if (Item.PricingModel == ExperiencePricingModel.IncludedInSubscription)
            {
                <span class="status-badge plan-included">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>Plan Included</span>
                </span>
            }
            else
            {
                <span class="status-badge price">
                    ₹@Item.PriceAmount.ToString("N2")
                </span>
            }
        </div>
    </div>

    <!-- Title & Description Section -->
    <div class="card-main-content">
        <h3 class="item-title" title="@Item.Title">@Item.Title</h3>
        <p class="item-desc" title="@Item.Description">
            @Item.Description
        </p>
    </div>

    <!-- Metadata Ribbon: Age Group, Duration, Version -->
    <div class="attributes-ribbon">
        <div class="attr-pill" title="Target Age Range">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            </svg>
            <span class="attr-val">@FormatAgeRange()</span>
        </div>
        <div class="attr-pill" title="Activity Duration">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="attr-val">@(Item.DurationMinutes.HasValue ? $"{Item.DurationMinutes}m" : "20–30m")</span>
        </div>
        <div class="attr-pill" title="Curated Canonical Version">
            <span class="version-label">v@(Item.CurrentVersion)</span>
        </div>
    </div>

    <!-- Footer Row: Attribution & Actions -->
    <div class="card-footer">
        <div class="attribution-info">
            @if (!string.IsNullOrWhiteSpace(Item.CreatorAttribution))
            {
                <span class="curator-text" title="Created by @Item.CreatorAttribution">
                    <span class="curator-dot">🌿</span> @Item.CreatorAttribution
                </span>
            }
            else
            {
                <span class="curator-text">
                    <span class="curator-dot">🌿</span> Platform Curriculum
                </span>
            }
        </div>

        <div class="action-buttons-group">
            <button class="btn-action secondary" @onclick="() => OnViewDetails.InvokeAsync(Item)">
                Details
            </button>
            @if (Item.IsPurchasedOrEntitled)
            {
                <button class="btn-action primary" @onclick="() => OnAddToLibrary.InvokeAsync(Item)">
                    + Add to Library
                </button>
            }
            else
            {
                <button class="btn-action primary" @onclick="() => OnAcquire.InvokeAsync(Item)">
                    @(Item.PricingModel == ExperiencePricingModel.IncludedInSubscription ? "Redeem Access" : $"Acquire (₹{Item.PriceAmount:0.00})")
                </button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public PlatformExperience Item { get; set; } = null!;
    [Parameter] public EventCallback<PlatformExperience> OnAddToLibrary { get; set; }
    [Parameter] public EventCallback<PlatformExperience> OnAcquire { get; set; }
    [Parameter] public EventCallback<PlatformExperience> OnViewDetails { get; set; }

    private string CategoryKey => Item.Category?.ToLowerInvariant() switch
    {
        "art" or "creative arts" => "art",
        "nature" or "nature & outdoors" => "nature",
        "sensory" or "sensory & tactile" => "sensory",
        "stem" or "science" => "stem",
        "social" or "social-emotional" => "social",
        "early childhood" or "early" => "early",
        _ => "general"
    };

    private string GetCategoryIcon(string? category) => category?.ToLowerInvariant() switch
    {
        "stem" or "science" => "🔬",
        "sensory" or "sensory & tactile" => "🎨",
        "nature" or "nature & outdoors" => "🌿",
        "art" or "creative arts" => "🎭",
        "social" or "social-emotional" => "🤝",
        "early childhood" or "early" => "🧸",
        _ => "✨"
    };

    private string FormatAgeRange()
    {
        if (!Item.AgeRangeMinMonths.HasValue && !Item.AgeRangeMaxMonths.HasValue)
            return "All Ages";

        var min = Item.AgeRangeMinMonths ?? 0;
        var max = Item.AgeRangeMaxMonths ?? 72;

        if (min >= 12 && max >= 12)
        {
            var minYears = min / 12;
            var maxYears = max / 12;
            return minYears == maxYears ? $"{minYears} yrs" : $"{minYears}–{maxYears} yrs";
        }
        return $"{min}–{max} mo";
    }
}
