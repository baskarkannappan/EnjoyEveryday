@using EnjoyEveryday.Domain.Entities

<div class="material-timeline">
    @if (Events == null || !Events.Any())
    {
        <div style="padding: 24px; text-align: center; color: var(--muted, #6c7870); font-size: 13px;">
            No event history recorded yet.
        </div>
    }
    else
    {
        <div class="timeline-container">
            @for (int i = 0; i < Events.Count; i++)
            {
                var evt = Events[i];
                var isLatest = i == Events.Count - 1;
                var dotClass = GetDotClass(evt.EventType, isLatest);
                var icon = GetEventIcon(evt.EventType);

                <div class="timeline-item @(isLatest ? "latest" : "")">
                    <div class="timeline-marker">
                        <div class="timeline-dot @dotClass">
                            @icon
                        </div>
                        @if (i < Events.Count - 1)
                        {
                            <div class="timeline-line"></div>
                        }
                    </div>

                    <div class="timeline-body">
                        <div class="timeline-header">
                            <span class="timeline-title">@FormatEventTitle(evt.EventType)</span>
                            <span class="timeline-time">@evt.CreatedAt.ToLocalTime().ToString("d MMM, h:mm tt")</span>
                        </div>

                        <div class="timeline-desc">
                            @evt.Description
                        </div>

                        @if (!string.IsNullOrWhiteSpace(evt.Notes))
                        {
                            <div class="timeline-notes">
                                <span class="notes-label">Note:</span> @evt.Notes
                            </div>
                        }

                        <div class="timeline-actor">
                            <span class="actor-badge @evt.ActorRole.ToLowerInvariant()">
                                @FormatActorRole(evt.ActorRole)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(evt.ActorEmail))
                            {
                                <span class="actor-email">(@evt.ActorEmail)</span>
                            }
                            @if (evt.IsInternalNote)
                            {
                                <span class="internal-badge">🔒 Internal Staff Note</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .material-timeline {
        padding: 8px 0;
    }

    .timeline-container {
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .timeline-item {
        display: flex;
        gap: 16px;
        position: relative;
        padding-bottom: 24px;
    }

    .timeline-item:last-child {
        padding-bottom: 4px;
    }

    .timeline-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 32px;
        flex-shrink: 0;
    }

    .timeline-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 13px;
        background: #f0f4f1;
        border: 2px solid var(--border, #e4e7df);
        color: var(--accent-dark, #3e6253);
        z-index: 2;
    }

    .timeline-dot.active {
        background: var(--accent, #557c6c);
        border-color: var(--accent-dark, #3e6253);
        color: white;
        box-shadow: 0 0 0 4px rgba(85, 124, 108, 0.15);
    }

    .timeline-dot.completed {
        background: #e6eee9;
        border-color: #557c6c;
        color: #3e6253;
    }

    .timeline-dot.rejected {
        background: #fee2e2;
        border-color: #ef4444;
        color: #b91c1c;
    }

    .timeline-dot.shipped {
        background: #e0f2fe;
        border-color: #0284c7;
        color: #0369a1;
    }

    .timeline-line {
        width: 2px;
        flex-grow: 1;
        background: var(--border, #e4e7df);
        margin: 4px 0;
    }

    .timeline-body {
        flex-grow: 1;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 12px 16px;
    }

    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .timeline-title {
        font-size: 13.5px;
        font-weight: 750;
        color: var(--text, #26332d);
    }

    .timeline-time {
        font-size: 11.5px;
        color: var(--muted, #6c7870);
    }

    .timeline-desc {
        font-size: 13px;
        color: #4a5750;
        line-height: 1.45;
        margin-bottom: 8px;
    }

    .timeline-notes {
        background: white;
        border-left: 3px solid var(--accent, #557c6c);
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 12px;
        color: #405248;
        margin-bottom: 8px;
    }

    .notes-label {
        font-weight: 700;
        color: var(--accent-dark, #3e6253);
    }

    .timeline-actor {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
    }

    .actor-badge {
        padding: 2px 7px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .actor-badge.platformadmin {
        background: #e6eee9;
        color: #3e6253;
        border: 1px solid #c0d8cb;
    }

    .actor-badge.daycareorganization {
        background: #fbf7ee;
        color: #8a6e32;
        border: 1px solid #eedec3;
    }

    .actor-badge.system {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

    .actor-email {
        color: var(--muted, #6c7870);
    }

    .internal-badge {
        font-size: 10px;
        font-weight: 700;
        color: #92400e;
        background: #fef3c7;
        padding: 1px 6px;
        border-radius: 4px;
    }
</style>

@code {
    [Parameter] public List<MaterialOrderHistory> Events { get; set; } = new();

    private string FormatEventTitle(string eventType) => eventType switch
    {
        "OrderSubmitted" => "Order Request Submitted",
        "OrderApprovedForQuotation" => "Review Approved for Quotation",
        "QuotationIssued" => "Quotation & Loan Terms Issued",
        "QuotationAccepted" => "Quotation Accepted by Daycare",
        "PaymentRecorded" => "Payment Completed",
        "ManualPaymentRecorded" => "Official Cash Receipt Issued",
        "StockAllocatedAndPacking" => "Warehouse Picking & Packing",
        "OrderDispatched" => "Shipment Dispatched",
        "DeliveryConfirmed" => "Delivery Receipt Confirmed",
        "DeliveryExceptionReported" => "Delivery Issue Reported",
        "LoanReturnInitiated" => "Return In Transit to Warehouse",
        "LoanReturnReceivedAtWarehouse" => "Return Received at Warehouse",
        "ReturnInspectionCompleted" => "Return Quality Inspection Completed",
        "OrderCancelled" => "Order Cancelled",
        "OrderRejected" => "Order Request Rejected",
        _ => eventType
    };

    private string FormatActorRole(string role) => role switch
    {
        "PlatformAdmin" => "Platform Admin",
        "DaycareOrganization" => "Daycare Admin",
        "System" => "System",
        _ => role
    };

    private string GetDotClass(string eventType, bool isLatest)
    {
        if (eventType.Contains("Rejected") || eventType.Contains("Cancelled") || eventType.Contains("Exception"))
            return "rejected";
        if (eventType.Contains("Dispatched"))
            return "shipped";
        if (isLatest)
            return "active";
        return "completed";
    }

    private string GetEventIcon(string eventType) => eventType switch
    {
        "OrderSubmitted" => "🛒",
        "OrderApprovedForQuotation" => "📋",
        "QuotationIssued" => "🏷️",
        "QuotationAccepted" => "🤝",
        "PaymentRecorded" or "ManualPaymentRecorded" => "💳",
        "StockAllocatedAndPacking" => "📦",
        "OrderDispatched" => "🚚",
        "DeliveryConfirmed" => "✅",
        "DeliveryExceptionReported" => "⚠️",
        "LoanReturnInitiated" => "🔄",
        "LoanReturnReceivedAtWarehouse" => "📥",
        "ReturnInspectionCompleted" => "🔍",
        "OrderCancelled" or "OrderRejected" => "❌",
        _ => "•"
    };
}
