@using EnjoyEveryday.Domain.Entities

<div class="material-timeline">
    @if (Events == null || !Events.Any())
    {
        <div style="padding: 24px; text-align: center; color: var(--muted, #6c7870); font-size: 13px;">
            No event history recorded yet.
        </div>
    }
    else
    {
        <div class="timeline-container">
            @for (int i = 0; i < Events.Count; i++)
            {
                var evt = Events[i];
                var isLatest = i == Events.Count - 1;
                var dotClass = GetDotClass(evt.EventType, isLatest);
                var icon = GetEventIcon(evt.EventType);

                <div class="timeline-item @(isLatest ? "latest" : "")">
                    <div class="timeline-marker">
                        <div class="timeline-dot @dotClass">
                            @icon
                        </div>
                        @if (i < Events.Count - 1)
                        {
                            <div class="timeline-line"></div>
                        }
                    </div>

                    <div class="timeline-body">
                        <div class="timeline-header">
                            <span class="timeline-title">@FormatEventTitle(evt.EventType)</span>
                            <span class="timeline-time">@evt.CreatedAt.ToLocalTime().ToString("d MMM, h:mm tt")</span>
                        </div>

                        <div class="timeline-desc">
                            @evt.Description
                        </div>

                        @if (!string.IsNullOrWhiteSpace(evt.Notes))
                        {
                            <div class="timeline-notes">
                                <span class="notes-label">Note:</span> @evt.Notes
                            </div>
                        }

                        <div class="timeline-actor">
                            <span class="actor-badge @evt.ActorRole.ToLowerInvariant()">
                                @FormatActorRole(evt.ActorRole)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(evt.ActorEmail))
                            {
                                <span class="actor-email">(@evt.ActorEmail)</span>
                            }
                            @if (evt.IsInternalNote)
                            {
                                <span class="internal-badge">🔒 Internal Staff Note</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<MaterialOrderHistory> Events { get; set; } = new();

    private string FormatEventTitle(string eventType) => eventType switch
    {
        "OrderSubmitted" => "Order Request Submitted",
        "OrderApprovedForQuotation" => "Review Approved for Quotation",
        "QuotationIssued" => "Quotation & Loan Terms Issued",
        "QuotationAccepted" => "Quotation Accepted by Daycare",
        "PaymentRecorded" => "Payment Completed",
        "ManualPaymentRecorded" => "Official Cash Receipt Issued",
        "StockAllocatedAndPacking" => "Warehouse Picking & Packing",
        "OrderDispatched" => "Shipment Dispatched",
        "DeliveryConfirmed" => "Delivery Receipt Confirmed",
        "DeliveryExceptionReported" => "Delivery Issue Reported",
        "LoanReturnInitiated" => "Return In Transit to Warehouse",
        "LoanReturnReceivedAtWarehouse" => "Return Received at Warehouse",
        "ReturnInspectionCompleted" => "Return Quality Inspection Completed",
        "OrderCancelled" => "Order Cancelled",
        "OrderRejected" => "Order Request Rejected",
        _ => eventType
    };

    private string FormatActorRole(string role) => role switch
    {
        "PlatformAdmin" => "Platform Admin",
        "DaycareOrganization" => "Daycare Admin",
        "System" => "System",
        _ => role
    };

    private string GetDotClass(string eventType, bool isLatest)
    {
        if (eventType.Contains("Rejected") || eventType.Contains("Cancelled") || eventType.Contains("Exception"))
            return "rejected";
        if (eventType.Contains("Dispatched"))
            return "shipped";
        if (isLatest)
            return "active";
        return "completed";
    }

    private string GetEventIcon(string eventType) => eventType switch
    {
        "OrderSubmitted" => "🛒",
        "OrderApprovedForQuotation" => "📋",
        "QuotationIssued" => "🏷️",
        "QuotationAccepted" => "🤝",
        "PaymentRecorded" or "ManualPaymentRecorded" => "💳",
        "StockAllocatedAndPacking" => "📦",
        "OrderDispatched" => "🚚",
        "DeliveryConfirmed" => "✅",
        "DeliveryExceptionReported" => "⚠️",
        "LoanReturnInitiated" => "🔄",
        "LoanReturnReceivedAtWarehouse" => "📥",
        "ReturnInspectionCompleted" => "🔍",
        "OrderCancelled" or "OrderRejected" => "❌",
        _ => "•"
    };
}
