@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

@{
    var off = Product.Offering;
    var bal = Product.StockBalance;
    var isKit = Product.MaterialType == "ActivityKit" || Product.MaterialType == "Reusable";
}

<div class="material-product-card">
    <div class="card-media">
        @{
            var images = DisplayImages;
            var hasImages = images.Count > 0;
            var activeIdx = Math.Clamp(_currentImageIndex, 0, Math.Max(0, images.Count - 1));
            var currentImg = hasImages ? images[activeIdx] : null;
        }
        @if (hasImages && !string.IsNullOrWhiteSpace(currentImg))
        {
            <div class="carousel-container">
                <img src="@currentImg" alt="@Product.Name" class="carousel-img" />
                @if (images.Count > 1)
                {
                    <button type="button" class="carousel-btn prev-btn" @onclick="PrevImage" @onclick:stopPropagation="true" title="Previous image">‹</button>
                    <button type="button" class="carousel-btn next-btn" @onclick="NextImage" @onclick:stopPropagation="true" title="Next image">›</button>
                    <div class="carousel-dots" @onclick:stopPropagation="true">
                        @for (int i = 0; i < images.Count; i++)
                        {
                            var dotIdx = i;
                            <span class="carousel-dot @(dotIdx == activeIdx ? "active" : "")"
                                  @onclick="() => SelectImage(dotIdx)"></span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="media-placeholder">
                <span>@(isKit ? "🧩" : "🎨")</span>
            </div>
        }
        <span class="type-badge @Product.MaterialType.ToLowerInvariant()">
            @(isKit ? "Reusable Kit" : "Consumable")
        </span>
        @if (bal == null || bal.AvailableStock <= 0)
        {
            <span class="stock-badge out-of-stock" style="background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; font-weight: 700;">● Out of stock (0 in stock)</span>
        }
        else if (bal.AvailableStock <= 5)
        {
            <span class="stock-badge low-stock" style="background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; font-weight: 700;">⚠️ Low stock: Only @bal.AvailableStock left!</span>
        }
        else
        {
            <span class="stock-badge available">● @bal.AvailableStock in stock</span>
        }
    </div>

    <div class="card-body">
        <div class="category-tag">@Product.Category</div>
        <h3 class="product-name">@Product.Name</h3>
        <p class="product-desc">@Product.Description</p>

        @if (!string.IsNullOrWhiteSpace(Product.SafetyInstructions))
        {
            <div class="safety-tip">
                <span>🛡️</span>
                <span>@Product.SafetyInstructions</span>
            </div>
        }

        <div class="pricing-container">
            @if (off?.AllowPurchase == true)
            {
                <div class="price-box">
                    <div class="price-lbl">BUY TO KEEP</div>
                    <div class="price-val">₹@off.PurchasePrice.ToString("N0")</div>
                </div>
            }

            @if (off?.AllowBorrow == true)
            {
                <div class="price-box borrow">
                    <div class="price-lbl">BORROW KIT</div>
                    <div class="price-val">
                        ₹@off.RentalFee.ToString("N0")
                        <span class="loan-period">/@(off.DefaultLoanDurationDays)d</span>
                    </div>
                    @if (off.RefundableDeposit > 0)
                    {
                        <div class="deposit-note">+ ₹@off.RefundableDeposit.ToString("N0") deposit</div>
                    }
                </div>
            }
        </div>

        <div class="card-actions">
            <button class="btn secondary" @onclick="() => OnViewDetails.InvokeAsync(Product)">
                Details &amp; Safety
            </button>
            @if ((bal == null || bal.AvailableStock <= 0) && off?.AllowPurchase == true && off?.AllowBorrow != true)
            {
                <button class="btn secondary" disabled style="opacity: 0.55; cursor: not-allowed; font-weight: 700;">
                    Out of Stock
                </button>
            }
            else
            {
                <button class="primary" @onclick="() => OnAddToOrder.InvokeAsync(Product)">
                    + Add to Order
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MaterialProduct Product { get; set; } = null!;
    [Parameter] public EventCallback<MaterialProduct> OnViewDetails { get; set; }
    [Parameter] public EventCallback<MaterialProduct> OnAddToOrder { get; set; }

    private int _currentImageIndex = 0;

    private List<string> DisplayImages
    {
        get
        {
            if (Product == null) return new List<string>();
            if (Product.ImageUrls != null && Product.ImageUrls.Count > 0)
            {
                return Product.ImageUrls.Where(u => !string.IsNullOrWhiteSpace(u)).ToList();
            }
            if (!string.IsNullOrWhiteSpace(Product.ImageUrl))
            {
                var trimmed = Product.ImageUrl.Trim();
                if (trimmed.StartsWith("[") && trimmed.EndsWith("]"))
                {
                    try
                    {
                        var parsed = System.Text.Json.JsonSerializer.Deserialize<List<string>>(trimmed);
                        if (parsed != null && parsed.Count > 0)
                        {
                            return parsed.Where(u => !string.IsNullOrWhiteSpace(u)).ToList();
                        }
                    }
                    catch { }
                }
                return new List<string> { trimmed };
            }
            return new List<string>();
        }
    }

    private void PrevImage()
    {
        var imgs = DisplayImages;
        if (imgs.Count > 1)
        {
            _currentImageIndex = (_currentImageIndex - 1 + imgs.Count) % imgs.Count;
        }
    }

    private void NextImage()
    {
        var imgs = DisplayImages;
        if (imgs.Count > 1)
        {
            _currentImageIndex = (_currentImageIndex + 1) % imgs.Count;
        }
    }

    private void SelectImage(int index)
    {
        var imgs = DisplayImages;
        if (index >= 0 && index < imgs.Count)
        {
            _currentImageIndex = index;
        }
    }
}
