@namespace EnjoyEveryday.UI.Shared.Components

<div class="media-thumb-container @CustomClass" 
     style="@ContainerStyle"
     @onclick="HandleClick"
     @onkeydown="HandleKeyDown"
     tabindex="@(Clickable ? "0" : "-1")"
     role="@(Clickable ? "button" : null)"
     aria-label="@(AltText ?? Title ?? "View photo")">
    
    <div class="media-thumb-wrapper" style="@AspectStyle">
        <img src="@EffectiveUrl"
             alt="@(AltText ?? Title ?? "Photo")"
             class="media-thumb-image"
             loading="lazy"
             decoding="async"
             @onload="OnImageLoaded"
             @onerror="OnImageError" />

        @if (_isLoading)
        {
            <div class="media-thumb-shimmer"></div>
        }

        @if (_hasError)
        {
            <div class="media-thumb-fallback">
                <i class="bi bi-image"></i>
            </div>
        }

        @if (ShowEnlargeIcon && Clickable)
        {
            <div class="media-enlarge-badge" title="Click to view full photo">
                <i class="bi bi-arrows-fullscreen"></i>
            </div>
        }

        @if (IsVideo)
        {
            <div class="media-video-badge" aria-label="Video">▶</div>
        }

        @if (!string.IsNullOrEmpty(EffectiveBadgeText))
        {
            <div class="media-thumb-badge">@EffectiveBadgeText</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(EffectiveSubtitle))
    {
        <div class="media-thumb-meta">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="media-thumb-title">@Title</div>
            }
            @if (!string.IsNullOrEmpty(EffectiveSubtitle))
            {
                <div class="media-thumb-sub">@EffectiveSubtitle</div>
            }
        </div>
    }
</div>

<style>
    .media-thumb-container {
        position: relative;
        border-radius: var(--media-thumb-radius, 10px);
        overflow: hidden;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        display: inline-block;
        vertical-align: top;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .media-thumb-container[role="button"] {
        cursor: pointer;
    }

    .media-thumb-container[role="button"]:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(40, 55, 47, 0.12);
        border-color: var(--accent, #557c6c);
    }

    .media-thumb-container[role="button"]:focus-visible {
        outline: 2px solid var(--accent, #557c6c);
        outline-offset: 2px;
    }

    .media-thumb-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: var(--surface-soft, #f8f9f5);
    }

    .media-thumb-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.25s ease;
    }

    .media-thumb-container[role="button"]:hover .media-thumb-image {
        transform: scale(1.03);
    }

    .media-thumb-shimmer {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #f0f3ee 0%, #e8eee6 50%, #f0f3ee 100%);
        background-size: 200% 100%;
        animation: media-shimmer 1.5s infinite;
    }

    @@keyframes media-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    .media-thumb-fallback {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--surface-soft, #f8f9f5);
        color: var(--muted, #6c7870);
        font-size: 24px;
    }

    .media-enlarge-badge {
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: rgba(38, 51, 45, 0.75);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        backdrop-filter: blur(4px);
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.15s ease;
    }

    .media-thumb-container:hover .media-enlarge-badge,
    .media-thumb-container:focus-visible .media-enlarge-badge {
        opacity: 1;
        transform: scale(1.05);
    }

    .media-thumb-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(255, 255, 255, 0.92);
        color: var(--text, #26332d);
        font-size: 10px;
        font-weight: 750;
        padding: 2px 7px;
        border-radius: 6px;
        backdrop-filter: blur(4px);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .media-thumb-meta {
        padding: 8px 12px;
        background: var(--surface, #ffffff);
        border-top: 1px solid var(--border, #e4e7df);
    }

    .media-thumb-title {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text, #26332d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .media-thumb-sub {
        font-size: 11px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }
</style>

@code {
    [Parameter, EditorRequired] public string ImageUrl { get; set; } = string.Empty;
    [Parameter] public string? ThumbnailUrl { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? DateLabel { get; set; }
    [Parameter] public string? Category { get; set; }
    [Parameter] public bool IsVideo { get; set; }
    [Parameter] public string? AltText { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string AspectRatio { get; set; } = "4 / 3";
    [Parameter] public string MaxWidth { get; set; } = "280px";
    [Parameter] public string? Width { get; set; }
    [Parameter] public bool Clickable { get; set; } = true;
    [Parameter] public bool ShowEnlargeIcon { get; set; } = true;
    [Parameter] public string CustomClass { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClick { get; set; }

    private string? EffectiveSubtitle => !string.IsNullOrEmpty(Subtitle) ? Subtitle : DateLabel;
    private string? EffectiveBadgeText => !string.IsNullOrEmpty(BadgeText) ? BadgeText : Category;

    private bool _isLoading = false;
    private bool _hasError = false;

    private string EffectiveUrl => !string.IsNullOrEmpty(ThumbnailUrl) ? ThumbnailUrl : ImageUrl;

    private string ContainerStyle => 
        $"max-width: {MaxWidth};" + 
        (!string.IsNullOrEmpty(Width) ? $" width: {Width};" : " width: 100%;");

    private string AspectStyle => $"aspect-ratio: {AspectRatio};";

    private async Task HandleClick()
    {
        if (Clickable)
        {
            await OnClick.InvokeAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Clickable && (e.Key == "Enter" || e.Key == " "))
        {
            await OnClick.InvokeAsync();
        }
    }

    private void OnImageLoaded()
    {
        _isLoading = false;
        _hasError = false;
    }

    private void OnImageError()
    {
        _isLoading = false;
        _hasError = true;
    }
}
