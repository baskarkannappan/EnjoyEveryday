@namespace EnjoyEveryday.UI.Shared.Components

<article class="experience-card" @onclick="OnClick">
    <!-- Top Row -->
    <div class="card-top-row">
        <span class="category-pill">
            @GetTypeIcon(Type)
            <span>@Type</span>
        </span>
        <div class="card-top-status-group">
            @if (Stars > 0)
            {
                <span class="rating-badge" title="@Stars.ToString("0.0") rating from @ReviewsCount reviews">
                    ★ @Stars.ToString("0.0") <span style="font-weight: normal; opacity: 0.8;">(@ReviewsCount)</span>
                </span>
            }
            <span class="status-badge @(IsPublished ? "published" : "")">
                <span class="status-dot"></span>
                <span>@Status</span>
            </span>
        </div>
    </div>

    <!-- Title & Description -->
    <h3>@Title</h3>
    <p class="card-desc">@Description</p>

    <!-- Attributes Ribbon -->
    <div class="attributes-ribbon">
        @if (!string.IsNullOrWhiteSpace(Ages))
        {
            <span class="attribute-item">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="7" r="4"></circle>
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                </svg>
                <span>@Ages yrs</span>
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(Duration))
        {
            <span class="attribute-item">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>@Duration</span>
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(Setting))
        {
            <span class="attribute-item">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                <span>@Setting</span>
            </span>
        }
    </div>

    <!-- Footer Row -->
    <div class="card-footer-row">
        <div class="author-info">
            <span class="author-avatar">@GetInitials(CreatedBy)</span>
            <span>@(CleanVersion(Version)) &middot; @CreatedDate</span>
        </div>

        <div class="card-actions-row">
            @if (IsPublished)
            {
                <a href="/api/experiences/@Id/storybook" target="_blank" class="btn-storybook" 
                   title="Read Published Storybook" 
                   @onclick:stopPropagation="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                    <span>Storybook</span>
                </a>
                @if (OnDownloadStorybook.HasDelegate)
                {
                    <button type="button" class="btn-download-icon" 
                            title="Download Storybook (.html)" 
                            @onclick="HandleDownloadStorybook" 
                            @onclick:stopPropagation="true">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </button>
                }
            }
            <button class="btn-view-card">
                <span>View</span>
                <svg class="arrow-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter] public string Type { get; set; } = "Experience";
    [Parameter] public string Status { get; set; } = "Idea";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Ages { get; set; } = "";
    [Parameter] public string Duration { get; set; } = "";
    [Parameter] public string Setting { get; set; } = "";
    [Parameter] public string Uses { get; set; } = "0";
    [Parameter] public double Stars { get; set; } = 0;
    [Parameter] public int ReviewsCount { get; set; } = 0;
    [Parameter] public string Version { get; set; } = "v1";
    [Parameter] public string CreatedBy { get; set; } = "Teacher";
    [Parameter] public string CreatedDate { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback<string> OnDownloadStorybook { get; set; }

    private bool IsPublished => string.Equals(Status, "Published", StringComparison.OrdinalIgnoreCase);

    private static string CleanVersion(string ver)
    {
        if (string.IsNullOrWhiteSpace(ver)) return "v1";
        ver = ver.Trim();
        if (ver.StartsWith("vv", StringComparison.OrdinalIgnoreCase)) ver = ver.Substring(1);
        if (!ver.StartsWith("v", StringComparison.OrdinalIgnoreCase)) ver = "v" + ver;
        return ver;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "T";
        return name.Trim().Substring(0, 1).ToUpperInvariant();
    }

    private async Task HandleDownloadStorybook()
    {
        if (OnDownloadStorybook.HasDelegate)
        {
            await OnDownloadStorybook.InvokeAsync(Id);
        }
    }

    private static RenderFragment GetTypeIcon(string type) => builder =>
    {
        var t = type?.ToLowerInvariant() ?? "";
        if (t.Contains("explore"))
        {
            builder.AddMarkupContent(0, @"<svg width=""12"" height=""12"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2""><circle cx=""12"" cy=""12"" r=""10""></circle><polygon points=""16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76""></polygon></svg>");
        }
        else if (t.Contains("create"))
        {
            builder.AddMarkupContent(0, @"<svg width=""12"" height=""12"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2""><circle cx=""13.5"" cy=""6.5"" r="".5""></circle><circle cx=""17.5"" cy=""10.5"" r="".5""></circle><circle cx=""8.5"" cy=""7.5"" r="".5""></circle><circle cx=""6.5"" cy=""12.5"" r="".5""></circle><path d=""M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z""></path></svg>");
        }
        else if (t.Contains("move"))
        {
            builder.AddMarkupContent(0, @"<svg width=""12"" height=""12"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2""><path d=""M13 2L3 14h9l-1 8 10-12h-9l1-8z""></path></svg>");
        }
        else
        {
            builder.AddMarkupContent(0, @"<svg width=""12"" height=""12"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.2""><path d=""M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z""></path></svg>");
        }
    };
}
