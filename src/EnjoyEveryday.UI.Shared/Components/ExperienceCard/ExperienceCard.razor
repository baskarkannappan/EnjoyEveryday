@namespace EnjoyEveryday.UI.Shared.Components

<article class="experience-card cat-@CategoryKey" @onclick="OnClick">
    <!-- Top Row: Category Chip & Rating / Status Badges -->
    <div class="card-top-row">
        <span class="category-chip @CategoryKey">
            <span class="category-icon">@CategoryIcon</span>
            <span>@CategoryDisplayName</span>
        </span>

        <div class="status-wrapper">
            @if (Stars > 0)
            {
                <span class="status-badge rating" title="@Stars.ToString("0.0") rating from @ReviewsCount reviews">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>@Stars.ToString("0.0")</span>
                    @if (ReviewsCount > 0)
                    {
                        <span class="reviews-count">(@ReviewsCount)</span>
                    }
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(StatusDisplay))
            {
                <span class="status-badge @StatusKey">
                    @if (StatusKey == "approved" || StatusKey == "published")
                    {
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    }
                    else
                    {
                        <span class="status-dot"></span>
                    }
                    <span>@StatusDisplay.ToUpperInvariant()</span>
                </span>
            }
        </div>
    </div>

    <!-- Title & Description Section -->
    <div class="card-main-content">
        <h3 class="item-title" title="@Title">@Title</h3>
        <p class="item-desc" title="@Description">
            @(string.IsNullOrWhiteSpace(Description) 
                ? "Engaging developmental learning experience crafted for early childhood curiosity." 
                : Description)
        </p>
    </div>

    <!-- Metadata Ribbon: Age Group, Duration, Version, Setting, Runs -->
    <div class="attributes-ribbon">
        <div class="attr-pill" title="Target Age Range">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            </svg>
            <span class="attr-val">@FormatAges(Ages)</span>
        </div>

        <div class="attr-pill" title="Activity Duration">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="attr-val">@FormatDuration(Duration)</span>
        </div>

        <div class="attr-pill" title="Curated Version">
            <span class="version-label">@(CleanVersion(Version))</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Setting))
        {
            <div class="attr-pill" title="Learning Environment">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                <span class="attr-val">@Setting</span>
            </div>
        }

        @if (UsesCount > 0)
        {
            <div class="attr-pill" title="Classroom Sessions Run">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                <span class="attr-val">@(UsesCount == 1 ? "1 run" : $"{UsesCount} runs")</span>
            </div>
        }
    </div>

    <!-- Footer Row: Attribution & Action Buttons -->
    <div class="card-footer">
        <div class="attribution-info">
            <span class="curator-text" title="Created by @CreatedBy">
                <span class="curator-dot">🌿</span> @(string.IsNullOrWhiteSpace(CreatedBy) ? "Platform Curriculum" : CreatedBy)
            </span>
        </div>

        <div class="action-buttons-group" @onclick:stopPropagation="true">
            <button type="button" class="btn-action secondary" @onclick="OnClick">
                Details
            </button>
            @if (IsPublished)
            {
                <a href="/api/experiences/@Id/storybook" target="_blank" class="btn-action primary" title="Read Published Storybook">
                    Storybook
                </a>
                @if (OnDownloadStorybook.HasDelegate)
                {
                    <button type="button" class="btn-action secondary btn-icon-only" title="Download Storybook (.html)" @onclick="HandleDownloadStorybook">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </button>
                }
            }
            else
            {
                <button type="button" class="btn-action primary" @onclick="OnClick">
                    <span>View &rarr;</span>
                </button>
            }
            @if (CanDelete && OnDelete.HasDelegate)
            {
                <button type="button"
                        class="btn-action secondary btn-icon-only"
                        style="color: #9b2c2c; border-color: #fed7d7;"
                        title="Discard / Delete Experience"
                        @onclick="HandleDelete">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                    </svg>
                </button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter] public string Type { get; set; } = "Experience";
    [Parameter] public string Status { get; set; } = "Idea";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Ages { get; set; } = "";
    [Parameter] public string Duration { get; set; } = "";
    [Parameter] public string Setting { get; set; } = "";
    [Parameter] public string Uses { get; set; } = "0";
    [Parameter] public double Stars { get; set; } = 0;
    [Parameter] public int ReviewsCount { get; set; } = 0;
    [Parameter] public string Version { get; set; } = "v1";
    [Parameter] public string CreatedBy { get; set; } = "Teacher";
    [Parameter] public string CreatedDate { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback<string> OnDownloadStorybook { get; set; }
    [Parameter] public bool CanDelete { get; set; } = false;
    [Parameter] public EventCallback<string> OnDelete { get; set; }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(Id);
    }

    private bool IsPublished => string.Equals(Status, "Published", StringComparison.OrdinalIgnoreCase);
    private int UsesCount => int.TryParse(Uses, out var u) ? u : 0;

    private string StatusKey => (Status ?? "idea").ToLowerInvariant() switch
    {
        "approved" => "approved",
        "published" => "published",
        "completed" => "completed",
        _ => "draft"
    };

    private string StatusDisplay => string.IsNullOrWhiteSpace(Status) ? "Idea" : Status;

    private string CategoryKey
    {
        get
        {
            var t = (Type ?? "").ToLowerInvariant();
            if (t.Contains("explore")) return "explore";
            if (t.Contains("art") || t.Contains("create")) return "art";
            if (t.Contains("move")) return "move";
            if (t.Contains("stem") || t.Contains("logic")) return "stem";
            if (t.Contains("early")) return "early";
            if (t.Contains("nature")) return "nature";
            if (t.Contains("play")) return "early";

            var combined = $"{Title} {Description}".ToLowerInvariant();
            if (combined.Contains("art") || combined.Contains("paint") || combined.Contains("texture") || 
                combined.Contains("salt") || combined.Contains("color") || combined.Contains("clay") || 
                combined.Contains("draw") || combined.Contains("craft"))
                return "art";

            if (combined.Contains("nature") || combined.Contains("plant") || combined.Contains("garden") || 
                combined.Contains("weather") || combined.Contains("water") || combined.Contains("science") || 
                combined.Contains("seed") || combined.Contains("outdoor") || combined.Contains("leaf") || 
                combined.Contains("leaves"))
                return "nature";

            if (combined.Contains("early") || combined.Contains("toddler") || combined.Contains("infant") ||
                combined.Contains("animal") || combined.Contains("toy") || combined.Contains("story") || 
                combined.Contains("puppet") || combined.Contains("pretend") || combined.Contains("roleplay") || 
                combined.Contains("adventure") || combined.Contains("sound"))
                return "early";

            if (combined.Contains("move") || combined.Contains("dance") || combined.Contains("jump") || 
                combined.Contains("run") || combined.Contains("active") || combined.Contains("yoga") || 
                combined.Contains("motor"))
                return "move";

            if (combined.Contains("explore") || combined.Contains("sensory") || combined.Contains("discover") || 
                combined.Contains("curiosity") || combined.Contains("magnify"))
                return "explore";

            if (combined.Contains("build") || combined.Contains("block") || combined.Contains("math") || 
                combined.Contains("puzzle") || combined.Contains("stem") || combined.Contains("count"))
                return "stem";

            return "general";
        }
    }

    private string CategoryDisplayName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Type) && !string.Equals(Type, "Experience", StringComparison.OrdinalIgnoreCase))
                return Type.ToUpperInvariant();

            return CategoryKey switch
            {
                "art" => "CREATIVE ART",
                "nature" => "NATURE & SCIENCE",
                "early" => "EARLY CHILDHOOD",
                "move" => "GROSS MOTOR",
                "explore" => "EXPLORATION",
                "stem" => "STEM & LOGIC",
                _ => "EARLY CHILDHOOD"
            };
        }
    }

    private string CategoryIcon => CategoryKey switch
    {
        "art" => "🎨",
        "nature" => "🌿",
        "early" => "🧸",
        "move" => "🏃",
        "explore" => "🔍",
        "stem" => "🔬",
        _ => "🧸"
    };

    private static string FormatAges(string? ages)
    {
        if (string.IsNullOrWhiteSpace(ages)) return "All Ages";
        ages = ages.Trim();
        if (ages.Equals("All Ages", StringComparison.OrdinalIgnoreCase)) return ages;
        if (ages.EndsWith("yrs", StringComparison.OrdinalIgnoreCase) || ages.EndsWith("years", StringComparison.OrdinalIgnoreCase))
            return ages;
        return $"{ages} yrs";
    }

    private static string FormatDuration(string? duration)
    {
        if (string.IsNullOrWhiteSpace(duration)) return "20–30m";
        duration = duration.Trim();
        if (duration.EndsWith("m", StringComparison.OrdinalIgnoreCase) || duration.EndsWith("min", StringComparison.OrdinalIgnoreCase))
            return duration;
        return $"{duration}m";
    }

    private static string CleanVersion(string ver)
    {
        if (string.IsNullOrWhiteSpace(ver)) return "v1";
        ver = ver.Trim();
        if (ver.StartsWith("vv", StringComparison.OrdinalIgnoreCase)) ver = ver.Substring(1);
        if (!ver.StartsWith("v", StringComparison.OrdinalIgnoreCase)) ver = "v" + ver;
        return ver;
    }

    private async Task HandleDownloadStorybook()
    {
        if (OnDownloadStorybook.HasDelegate)
        {
            await OnDownloadStorybook.InvokeAsync(Id);
        }
    }
}
