@namespace EnjoyEveryday.UI.Shared.Components

<style>
    .experience-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        position: relative;
        overflow: hidden;
    }
    .experience-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border-color: #cbd5e1;
    }
    .experience-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #10b981, #047857);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .experience-card:hover::before {
        opacity: 1;
    }
    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .type-chip, .status-chip {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .type-chip {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }
    .status-chip {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }
    .experience-card h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.4;
    }
    .description {
        color: #64748b;
        font-size: 0.95rem;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }
    .card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: auto;
    }
    .card-meta span {
        background: #f1f5f9;
        color: #475569;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .card-meta .stars {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }
    .card-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px solid #f1f5f9;
        margin-top: 8px;
    }
    .usage {
        font-size: 0.75rem;
        color: #94a3b8;
    }
    .view-experience {
        background: transparent;
        border: none;
        color: #0f172a;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        padding: 0;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .view-experience:hover {
        color: #10b981;
    }
    .card-top-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .status-chip.status-published {
        background: #e6eee9;
        color: #3e6253;
        border-color: #c8dacd;
    }
    .storybook-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #d9e2db;
        color: #3e6253;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        padding: 0;
        text-decoration: none;
    }
    .storybook-icon-btn:hover {
        background: #e6eee9;
        border-color: #557c6c;
        color: #26332d;
        transform: scale(1.12);
        box-shadow: 0 2px 8px rgba(62, 98, 83, 0.15);
    }
    .storybook-bottom-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 9px;
        border-radius: 7px;
        background: #f4f8f5;
        border: 1px solid #d4e2d8;
        color: #3e6253;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .storybook-bottom-btn:hover {
        background: #e6eee9;
        border-color: #557c6c;
        color: #26332d;
    }
</style>
<article class="experience-card" @onclick="OnClick">
    <div class="card-top">
        <span class="type-chip">@Type</span>
        <div class="card-top-right">
            @if (IsPublished)
            {
                <a href="/api/experiences/@Id/storybook" target="_blank" class="storybook-icon-btn" 
                   title="Open Storybook in separate tab" 
                   @onclick:stopPropagation="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                </a>
                @if (OnDownloadStorybook.HasDelegate)
                {
                    <button class="storybook-icon-btn" 
                            title="Download Storybook (.html)" 
                            @onclick="HandleDownloadStorybook" 
                            @onclick:stopPropagation="true">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </button>
                }
            }
            <span class="status-chip @(IsPublished ? "status-published" : "")">@Status</span>
        </div>
    </div>

    <h3>@Title</h3>

    <div class="description">
        @Description
    </div>

    <div class="card-meta">
        <span>@Ages</span>
        <span>@Duration</span>
        <span>@Setting</span>
        @if (Stars > 0) {
            <span class="stars">⭐ @Stars.ToString("0.0") (@ReviewsCount)</span>
        }
    </div>

    <div class="card-bottom">
        <span class="usage">
            @Uses uses &middot; v@(Version) &middot; @CreatedDate &middot; @CreatedBy
        </span>
        <div style="display: flex; align-items: center; gap: 8px;">
            @if (IsPublished)
            {
                <a href="/api/experiences/@Id/storybook" target="_blank" class="storybook-bottom-btn" 
                   title="Open Storybook in separate tab" 
                   @onclick:stopPropagation="true">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Read</span>
                </a>
                @if (OnDownloadStorybook.HasDelegate)
                {
                    <button class="storybook-bottom-btn" 
                            title="Download Storybook (.html)" 
                            @onclick="HandleDownloadStorybook" 
                            @onclick:stopPropagation="true">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Download</span>
                    </button>
                }
            }
            <button class="card-action view-experience">
                View &rarr;
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Ages { get; set; } = "";
    [Parameter] public string Duration { get; set; } = "";
    [Parameter] public string Setting { get; set; } = "";
    [Parameter] public string Uses { get; set; } = "";
    [Parameter] public double Stars { get; set; } = 0;
    [Parameter] public int ReviewsCount { get; set; } = 0;
    [Parameter] public string Version { get; set; } = "";
    [Parameter] public string CreatedBy { get; set; } = "System";
    [Parameter] public string CreatedDate { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback<string> OnDownloadStorybook { get; set; }

    private bool IsPublished => string.Equals(Status, "Published", StringComparison.OrdinalIgnoreCase);

    private async Task HandleDownloadStorybook()
    {
        if (OnDownloadStorybook.HasDelegate)
        {
            await OnDownloadStorybook.InvokeAsync(Id);
        }
    }
}
