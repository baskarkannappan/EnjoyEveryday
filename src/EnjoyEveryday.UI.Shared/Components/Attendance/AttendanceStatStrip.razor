@namespace EnjoyEveryday.UI.Shared.Components.Attendance

<div class="stats">
    <div class="stat">
        <div class="mlabel">Children present</div>
        <div class="statnum">@ChildrenPresentRatio</div>
        <span class="pill green">Attendance</span>
    </div>
    <div class="stat">
        <div class="mlabel">Teachers present</div>
        <div class="statnum">@TeachersPresentRatio</div>
        <span class="pill blue">Staff</span>
    </div>
    <div class="stat">
        <div class="mlabel">Not marked</div>
        <div class="statnum">@UnmarkedCount</div>
        <span class="pill amber">Action needed</span>
    </div>
    <div class="stat">
        <div class="mlabel">Missing check-out</div>
        <div class="statnum">@MissingCheckoutCount</div>
        <span class="pill red">Review</span>
    </div>
</div>

@code {
    [Parameter] public string ChildrenPresentRatio { get; set; } = "0 / 0";
    [Parameter] public string TeachersPresentRatio { get; set; } = "0 / 0";
    [Parameter] public int UnmarkedCount { get; set; }
    [Parameter] public int MissingCheckoutCount { get; set; }
}
