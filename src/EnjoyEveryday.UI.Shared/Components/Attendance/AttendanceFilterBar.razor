@using EnjoyEveryday.Domain.Entities

<div class="filters">
    <input class="control" type="date" value="@SelectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged">
    <select class="control" value="@BranchFilter" @onchange="OnBranchChanged">
        <option value="all">All branches</option>
        @foreach (var b in Branches)
        {
            <option value="@b.Name">@b.Name</option>
        }
    </select>
    <select class="control" value="@TypeFilter" @onchange="OnTypeChanged">
        <option value="both">Children &amp; teachers</option>
        <option value="children">Children only</option>
        <option value="teachers">Teachers only</option>
    </select>
    <input class="control search" placeholder="Search branches, classrooms or people..." value="@SearchQuery" @oninput="OnSearchInput">
</div>

@code {
    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public EventCallback<DateTime> SelectedDateChanged { get; set; }

    [Parameter] public string BranchFilter { get; set; } = "all";
    [Parameter] public EventCallback<string> BranchFilterChanged { get; set; }

    [Parameter] public string TypeFilter { get; set; } = "both";
    [Parameter] public EventCallback<string> TypeFilterChanged { get; set; }

    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }

    [Parameter] public IEnumerable<Branch> Branches { get; set; } = Array.Empty<Branch>();

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            SelectedDate = dt;
            await SelectedDateChanged.InvokeAsync(dt);
        }
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "all";
        BranchFilter = val;
        await BranchFilterChanged.InvokeAsync(val);
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "both";
        TypeFilter = val;
        await TypeFilterChanged.InvokeAsync(val);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        SearchQuery = val;
        await SearchQueryChanged.InvokeAsync(val);
    }
}
