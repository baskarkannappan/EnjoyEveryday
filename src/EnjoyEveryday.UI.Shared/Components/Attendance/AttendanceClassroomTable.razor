@namespace EnjoyEveryday.UI.Shared.Components.Attendance

<div id="classPanel">
    <div class="tablewrap">
        <table>
            <thead>
                <tr>
                    <th>Classroom</th>
                    <th>Children present</th>
                    <th>Teachers present</th>
                    <th>Pending</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach(var c in Classrooms)
                {
                    <tr>
                        <td><b>@c.Name</b></td>
                        <td>@c.Children</td>
                        <td>@c.Teachers</td>
                        <td>@c.Pending</td>
                        <td><span class="pill @(c.Status == "Marked" ? "green" : c.Status == "Staffing attention" ? "red" : "amber")">@c.Status</span></td>
                        <td><button class="link" @onclick="@(() => OnOpenClassroom.InvokeAsync(c.Name))">Open →</button></td>
                    </tr>
                }
                @if (!Classrooms.Any())
                {
                    <tr><td colspan="6" style="text-align: center; color: #6c7870; padding: 20px;">No classrooms available</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    public class ClassRowItem
    {
        public string Name { get; set; } = "";
        public string Children { get; set; } = "";
        public string Teachers { get; set; } = "";
        public string Pending { get; set; } = "";
        public string Status { get; set; } = "";
    }

    [Parameter]
    public IEnumerable<ClassRowItem> Classrooms { get; set; } = Enumerable.Empty<ClassRowItem>();

    [Parameter]
    public EventCallback<string> OnOpenClassroom { get; set; }
}
