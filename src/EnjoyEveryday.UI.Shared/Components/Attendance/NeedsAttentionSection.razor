@namespace EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities.Attendance
@inject AttendanceService AttendanceService

<div class="card">
    <div class="cardhead">
        <h2>Needs attention</h2>
        @if (_alertList.Any())
        {
            <span class="pill amber">@_alertList.Count @(_alertList.Count == 1 ? "item" : "items")</span>
        }
        else
        {
            <span class="pill green">All Clear</span>
        }
    </div>
    
    <div class="alerts">
        @if (_alertList.Any())
        {
            @foreach (var alert in _alertList)
            {
                <NeedsAttentionAlert 
                    Icon="@alert.Icon" 
                    Title="@alert.Title" 
                    Description="@alert.Description" 
                    Branch="@alert.BranchName" 
                    ActionText="@alert.ActionText" 
                    ActionUrl="@alert.ActionUrl" />
            }
        }
        else
        {
            <div style="padding: 16px; text-align: center; color: var(--accent-dark, #31523c); background: var(--accent-light, #e6eee9); border-radius: 0px; font-size: 13px; font-weight: 600; margin-top: 10px;">
                🌿 All attendances are marked and staffing coverage is on track.
            </div>
        }
    </div>
    
    <div style="margin-top:18px;padding:13px;border-radius: 0px;background:#f2f6f1">
        <b style="font-size:12px">A useful daily habit</b>
        <div class="note" style="margin-top:5px">Start with unmarked attendance, then review staffing and missing check-outs.</div>
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<AttendanceAttentionAlertDto>? Alerts { get; set; }

    [Parameter]
    public DateTime SelectedDate { get; set; } = DateTime.Today;

    [Parameter]
    public IEnumerable<EnjoyEveryday.Domain.Entities.Branch>? AllowedBranches { get; set; }

    [Parameter]
    public string BranchFilter { get; set; } = "all";

    private List<AttendanceAttentionAlertDto> _alertList = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Alerts != null)
        {
            _alertList = FilterAlerts(Alerts);
        }
        else
        {
            try
            {
                var result = await AttendanceService.GetAttendanceNeedsAttentionAsync(SelectedDate);
                _alertList = FilterAlerts(result);
            }
            catch
            {
                _alertList = new List<AttendanceAttentionAlertDto>();
            }
        }
    }

    private List<AttendanceAttentionAlertDto> FilterAlerts(IEnumerable<AttendanceAttentionAlertDto> alerts)
    {
        var list = alerts.ToList();

        if (AllowedBranches != null && AllowedBranches.Any())
        {
            var allowedNames = new HashSet<string>(AllowedBranches.Select(b => b.Name), StringComparer.OrdinalIgnoreCase);
            list = list.Where(a => string.IsNullOrWhiteSpace(a.BranchName) || allowedNames.Contains(a.BranchName)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(BranchFilter) && !BranchFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
        {
            list = list.Where(a => string.IsNullOrWhiteSpace(a.BranchName) || a.BranchName.Equals(BranchFilter, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        return list;
    }
}
