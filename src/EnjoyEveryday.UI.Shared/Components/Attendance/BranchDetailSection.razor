@namespace EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Entities.Attendance
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject AttendanceService AttendanceService
@inject ISystemLookupCatalog LookupCatalog
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Nav

<section id="detail">
    <div class="detailhead">
        <button class="back" @onclick="BackToOverview">←</button>
        <div>
            <div class="crumb">Attendance / @BranchName @(IsRoomView ? " / Classroom" : "")</div>
            <h1 style="font-size:27px;margin:3px 0">@(IsRoomView ? ClassroomName : BranchName + " Branch")</h1>
            <div class="sub">@(IsRoomView ? $"Classroom attendance · {ClassroomName} · {_filterDate:yyyy-MM-dd}" : $"Attendance across classrooms, children and teachers · {_filterDate:yyyy-MM-dd}")</div>
        </div>
    </div>
    <div class="filters">
        <input class="control" type="date" value="@_filterDate.ToString("yyyy-MM-dd")" @onchange="OnDateFilterChanged">
        <select class="control" @bind="typeFilter" @bind:event="oninput">
            <option value="both">Children &amp; teachers</option>
            <option value="children">Children only</option>
            <option value="teachers">Teachers only</option>
        </select>
        <input class="control search" @bind="personSearch" @bind:event="oninput" placeholder="Search people...">
    </div>

    <!-- Reusable Attendance Stat Strip -->
    <AttendanceStatStrip 
        ChildrenPresentRatio="@Totals[0]" 
        TeachersPresentRatio="@Totals[1]" 
        UnmarkedCount="UnmarkedCount" 
        MissingCheckoutCount="MissingCheckoutCount" />

    <div class="card">
        <div class="tabs">
            <button class="tab @(currentTab == "classrooms" ? "active" : "")" @onclick="@(() => currentTab = "classrooms")">Classrooms</button>
            <button class="tab @(currentTab == "children" ? "active" : "")" @onclick="@(() => currentTab = "children")">Children</button>
            <button class="tab @(currentTab == "teachers" ? "active" : "")" @onclick="@(() => currentTab = "teachers")">Teachers</button>
        </div>
        
        @if (currentTab == "classrooms")
        {
            <!-- Reusable Classroom Table -->
            <AttendanceClassroomTable Classrooms="GetClassroomItems()" OnOpenClassroom="OpenClass" />
        }
        else
        {
            <div id="peoplePanel">
                <div style="display:flex;gap:9px;flex-wrap:wrap;margin-bottom:13px;align-items:center;">
                    <select class="control" @bind="statusFilter" @bind:event="oninput">
                        <option value="all">All statuses</option>
                        @foreach (var st in _availableStatuses)
                        {
                            <option value="@st">@st</option>
                        }
                    </select>

                    @if (currentTab == "teachers" && !CanEditTeacherAttendance)
                    {
                        <span class="pill blue" style="padding: 6px 12px; font-weight: 700;">
                            👁 Read-Only Teacher Attendance (Branch: @BranchName)
                        </span>
                    }
                    else
                    {
                        <button class="btn primary" @onclick="MarkSelectedPresent">Mark selected present</button>
                        <button class="btn" @onclick="() => ShowToast()">Save changes</button>
                    }

                    <button class="btn secondary" style="margin-left:auto; display:inline-flex; align-items:center; gap:5px; font-weight:700;" @onclick="() => _isEndOfDayModalOpen = true">
                        <span>🌙</span>
                        <span>End of Day Process</span>
                    </button>
                </div>

                <!-- Reusable People Roster Table -->
                <AttendancePeopleTable 
                    People="GetPeopleItems()" 
                    CurrentTab="@currentTab" 
                    CanEditTeacherAttendance="CanEditTeacherAttendance" 
                    AvailableStatuses="_availableStatuses" 
                    OnToggleSelectAll="ToggleSelectAll" 
                    OnOpenPickupModal="OpenSecurePickupModal" 
                    OnCheckOutTeacher="CheckOutTeacher" />

                <div class="note" style="margin-top:12px;">Changes will now be saved securely to the database.</div>
            </div>
        }
    </div>
</section>

<SecurePickupModal 
    IsOpen="_isPickupModalOpen"
    ChildId="_activePickupChildId"
    BranchId="_branchId"
    ClassroomId="_activePickupClassroomId"
    ChildName="@_activePickupChildName"
    ClassroomName="@_activePickupClassroomName"
    ArrivalTime="@_activePickupArrivalTime"
    OnDepartureConfirmed="HandleDepartureConfirmed"
    OnClose="() => _isPickupModalOpen = false" />

<EndOfDayProcessModal 
    IsOpen="_isEndOfDayModalOpen"
    BranchId="_branchId"
    Date="_filterDate"
    OnClose="() => _isEndOfDayModalOpen = false"
    OnCompleted="HandleEndOfDayCompleted" />

@if (showToast)
{
    <div id="toast" style="display:block;">Saved attendance changes to database.</div>
}

@code {
    [Parameter] public string BranchName { get; set; } = "";
    [Parameter] public string ClassroomName { get; set; } = "";

    private bool IsRoomView => !string.IsNullOrEmpty(ClassroomName);
    private string currentTab = "classrooms";
    private string personSearch = "";
    private string statusFilter = "all";
    private string typeFilter = "both";
    private bool showToast = false;

    private Guid _branchId;
    private List<AttendanceClassroomTable.ClassRowItem> _classRows = new();
    private List<AttendancePeopleTable.PersonRowItem> _personRows = new();
    private DateTime _filterDate = DateTime.Today;
    private IReadOnlyList<string> _availableStatuses = new[] { "Present", "Late", "Absent", "Excused", "Not marked" };

    private int UnmarkedCount => _personRows.Count(p => p.Status == "Not marked");
    private int MissingCheckoutCount => _personRows.Count(p => p.Status == "Present" && (p.Out == "—" || string.IsNullOrEmpty(p.Out)));

    private bool _isPickupModalOpen = false;
    private Guid _activePickupChildId;
    private Guid _activePickupClassroomId;
    private string _activePickupChildName = "";
    private string _activePickupClassroomName = "";
    private string? _activePickupArrivalTime;
    private bool _isEndOfDayModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var lookups = await LookupCatalog.GetLookupsByCategoryAsync("AttendanceStatus");
            if (lookups != null && lookups.Any())
            {
                _availableStatuses = lookups.Select(l => l.DisplayName).ToList();
            }
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsRoomView && currentTab == "classrooms") currentTab = "children";
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org == null) return;
        
        var branches = (await BranchService.GetBranchesAsync(org.Id)).ToList();
        var branch = !string.IsNullOrEmpty(BranchName)
            ? branches.FirstOrDefault(b => b.Name.Contains(BranchName, StringComparison.OrdinalIgnoreCase))
            : branches.FirstOrDefault();

        if (branch == null) return;
        _branchId = branch.Id;
        if (string.IsNullOrEmpty(BranchName)) BranchName = branch.Name;

        var roster = await AttendanceService.GetBranchAttendanceRosterAsync(_branchId, _filterDate);
        _classRows = roster.Classrooms.Select(c => new AttendanceClassroomTable.ClassRowItem {
            Name = c.Name,
            Children = c.ChildrenRatio,
            Teachers = c.TeachersRatio,
            Pending = c.Pending,
            Status = c.Status
        }).ToList();

        _personRows = roster.People.Select(p => new AttendancePeopleTable.PersonRowItem {
            Id = p.Id,
            AttendanceId = p.AttendanceId,
            ClassroomId = p.ClassroomId,
            Name = p.Name,
            Initials = p.Initials,
            Room = p.Room,
            Status = p.Status,
            In = p.In,
            Out = p.Out,
            PickupPersonName = p.PickupPersonName,
            PickupPersonRelationship = p.PickupPersonRelationship,
            PickupVerificationMethod = p.PickupVerificationMethod,
            PickupNotes = p.PickupNotes,
            Notes = p.Notes,
            Type = p.Type
        }).ToList();
    }

    private IEnumerable<AttendanceClassroomTable.ClassRowItem> GetClassroomItems() => _classRows;

    private IEnumerable<AttendancePeopleTable.PersonRowItem> GetPeopleItems()
    {
        var result = _personRows.AsEnumerable();
        if (typeFilter == "children" && currentTab == "teachers") return Enumerable.Empty<AttendancePeopleTable.PersonRowItem>();
        if (typeFilter == "teachers" && currentTab == "children") return Enumerable.Empty<AttendancePeopleTable.PersonRowItem>();
        
        string targetType = currentTab == "teachers" ? "teachers" : "children";
        result = result.Where(p => p.Type == targetType);

        if (!string.IsNullOrEmpty(personSearch))
            result = result.Where(p => (p.Name + " " + p.Room).Contains(personSearch, StringComparison.OrdinalIgnoreCase));
        
        if (statusFilter != "all")
            result = result.Where(p => p.Status.Equals(statusFilter, StringComparison.OrdinalIgnoreCase));
            
        if (IsRoomView)
        {
            if (currentTab == "teachers")
            {
                result = result.Where(p => p.Room.Equals(ClassroomName, StringComparison.OrdinalIgnoreCase) || p.Room == "Teacher");
            }
            else
            {
                result = result.Where(p => p.Room.Contains(ClassroomName, StringComparison.OrdinalIgnoreCase));
            }
        }

        return result;
    }

    private void OpenSecurePickupModal(AttendancePeopleTable.PersonRowItem person)
    {
        _activePickupChildId = person.Id;
        _activePickupClassroomId = person.ClassroomId;
        _activePickupChildName = person.Name;
        _activePickupClassroomName = person.Room;
        _activePickupArrivalTime = person.In;
        _isPickupModalOpen = true;
    }

    private async Task HandleDepartureConfirmed(ChildAttendance att)
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task CheckOutTeacher(AttendancePeopleTable.PersonRowItem teacher)
    {
        var att = new TeacherAttendance {
            Id = teacher.AttendanceId ?? Guid.NewGuid(),
            BranchId = _branchId,
            TeacherId = teacher.Id,
            AttendanceDate = _filterDate,
            Status = "Present",
            ClockInTime = TimeSpan.TryParse(teacher.In, out var inTime) ? inTime : DateTime.Now.TimeOfDay,
            ClockOutTime = DateTime.Now.TimeOfDay,
            Notes = "Manual teacher checkout",
            RecordedByUserId = UserContext.UserId
        };
        await AttendanceService.MarkTeacherAttendanceAsync(att);
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task HandleEndOfDayCompleted(EndOfDayProcessReport report)
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private void BackToOverview()
    {
        if (IsRoomView)
            Nav.NavigateTo($"/management/attendance/branches/{Uri.EscapeDataString(BranchName)}");
        else
            Nav.NavigateTo("/management/attendance");
    }

    private void OpenClass(string room) => Nav.NavigateTo($"/management/attendance/classrooms/{Uri.EscapeDataString(room)}?branch={Uri.EscapeDataString(BranchName)}");

    private void ToggleSelectAll(bool isChecked)
    {
        foreach(var p in GetPeopleItems())
        {
            p.IsSelected = isChecked;
        }
    }

    private async Task MarkSelectedPresent()
    {
        foreach(var p in GetPeopleItems().Where(p => p.IsSelected))
        {
            if (p.Status != "Present")
            {
                p.Status = "Present";
                p.IsDirty = true;
            }
        }
        await ShowToast();
    }

    private bool CanEditTeacherAttendance
    {
        get
        {
            var roles = UserContext.Roles ?? Enumerable.Empty<string>();
            return roles.Any(r =>
                r.Equals("PlatformAdmin", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("OrganizationAdmin", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("OrgAdmin", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("BranchAdmin", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task OnDateFilterChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsedDate))
        {
            _filterDate = parsedDate;
            await LoadDataAsync();
        }
    }

    private async Task ShowToast()
    {
        var dirty = _personRows.Where(p => p.IsDirty).ToList();
        if (dirty.Any())
        {
            var req = new BulkMarkAttendanceRequest
            {
                BranchId = _branchId,
                Date = _filterDate,
                Items = dirty.Select(p => new BulkMarkAttendanceItem
                {
                    Id = p.Id,
                    AttendanceId = p.AttendanceId,
                    ClassroomId = p.ClassroomId,
                    Status = p.Status,
                    In = p.In,
                    Type = p.Type
                }).ToList()
            };
            await AttendanceService.BulkMarkAttendanceAsync(req, UserContext.UserId);
            foreach (var p in dirty) p.IsDirty = false;
        }

        showToast = true;
        await LoadDataAsync();
        StateHasChanged();
        await Task.Delay(2400);
        showToast = false;
        StateHasChanged();
    }

    private string[] Totals => new[] { 
        $"{_personRows.Count(p => p.Type == "children" && (p.Status == "Present" || p.Status == "Late"))} / {_personRows.Count(p => p.Type == "children")}",
        $"{_personRows.Count(p => p.Type == "teachers" && (p.Status == "Present" || p.Status == "Late"))} / {_personRows.Count(p => p.Type == "teachers")}"
    };
}
