@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject ChildService ChildService
@inject UserService UserService
@inject ITeacherService TeacherService
@inject AttendanceService AttendanceService
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Nav
<section id="detail">
    <div class="detailhead">
        <button class="back" @onclick="BackToOverview">←</button>
        <div>
            <div class="crumb">Attendance / @BranchName @(IsRoomView ? " / Classroom" : "")</div>
            <h1 style="font-size:27px;margin:3px 0">@(IsRoomView ? ClassroomName : BranchName + " Branch")</h1>
            <div class="sub">@(IsRoomView ? $"Classroom attendance · {ClassroomName}" : "Attendance across classrooms, children and teachers · 2026-10-09")</div>
        </div>
    </div>
    <div class="filters">
        <input class="control" type="date" value="2026-10-09">
        <select class="control" @bind="typeFilter" @bind:event="oninput">
            <option value="both">Children &amp; teachers</option>
            <option value="children">Children only</option>
            <option value="teachers">Teachers only</option>
        </select>
        <input class="control search" @bind="personSearch" @bind:event="oninput" placeholder="Search people...">
    </div>
    <div class="stats">
        <div class="stat"><div class="mlabel">Children present</div><div class="statnum">@Totals[0]</div><span class="pill green">Attendance</span></div>
        <div class="stat"><div class="mlabel">Teachers present</div><div class="statnum">@Totals[1]</div><span class="pill blue">Staff</span></div>
        <div class="stat"><div class="mlabel">Not marked</div><div class="statnum">@UnmarkedCount</div><span class="pill amber">Action needed</span></div>
        <div class="stat"><div class="mlabel">Missing check-out</div><div class="statnum">@MissingCheckoutCount</div><span class="pill red">Review</span></div>
    </div>
    <div class="card">
        <div class="tabs">
            <button class="tab @(currentTab == "classrooms" ? "active" : "")" @onclick="@(() => currentTab = "classrooms")">Classrooms</button>
            <button class="tab @(currentTab == "children" ? "active" : "")" @onclick="@(() => currentTab = "children")">Children</button>
            <button class="tab @(currentTab == "teachers" ? "active" : "")" @onclick="@(() => currentTab = "teachers")">Teachers</button>
        </div>
        
        @if (currentTab == "classrooms")
        {
            <div id="classPanel">
                <div class="tablewrap">
                    <table>
                        <thead><tr><th>Classroom</th><th>Children present</th><th>Teachers present</th><th>Pending</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach(var c in GetClassrooms())
                            {
                                <tr>
                                    <td><b>@c.Name</b></td>
                                    <td>@c.Children</td>
                                    <td>@c.Teachers</td>
                                    <td>@c.Pending</td>
                                    <td><span class="pill @(c.Status == "Marked" ? "green" : c.Status == "Staffing attention" ? "red" : "amber")">@c.Status</span></td>
                                    <td><button class="link" @onclick="@(() => OpenClass(c.Name))">Open →</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div id="peoplePanel">
                <div style="display:flex;gap:9px;flex-wrap:wrap;margin-bottom:13px">
                    <select class="control" @bind="statusFilter" @bind:event="oninput">
                        <option value="all">All statuses</option>
                        <option>Present</option>
                        <option>Late</option>
                        <option>Absent</option>
                        <option>Not marked</option>
                    </select>
                    <button class="btn primary" @onclick="MarkSelectedPresent">Mark selected present</button>
                    <button class="btn" @onclick="() => ShowToast()">Save changes</button>
                    <button class="btn secondary" style="margin-left:auto; display:inline-flex; align-items:center; gap:5px; font-weight:700;" @onclick="() => _isEndOfDayModalOpen = true">
                        <span>🌙</span>
                        <span>End of Day Process</span>
                    </button>
                </div>
                <div class="tablewrap">
                    <table>
                        <thead><tr><th><input type="checkbox" @onchange="ToggleSelectAll" aria-label="Select all"></th><th>Person</th><th>Classroom / Role</th><th>Status</th><th>Arrival / Clock-in</th><th>Departure / Clock-out</th></tr></thead>
                        <tbody>
                            @foreach(var p in GetPeople())
                            {
                                <tr>
                                    <td><input type="checkbox" @bind="p.IsSelected" aria-label="Select @p.Name"></td>
                                    <td><div class="person"><span class="personicon">@p.Initials</span>@p.Name</div></td>
                                    <td>@p.Room</td>
                                    <td>
                                        <select class="statusselect" @bind="p.Status" @bind:event="oninput">
                                            <option value="Present">Present</option>
                                            <option value="Late">Late</option>
                                            <option value="Absent">Absent</option>
                                            <option value="Excused">Excused</option>
                                            <option value="Not marked">Not marked</option>
                                        </select>
                                    </td>
                                    <td>@p.In</td>
                                    <td>
                                        @if (p.Type == "children" && (p.Status == "Present" || p.Status == "Late"))
                                        {
                                            @if (p.Out != "—")
                                            {
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    <span style="font-weight: 700; color: #26332d;">@p.Out</span>
                                                    @if (p.PickupVerificationMethod == "System Auto-Closed" || (p.PickupNotes?.Contains("System auto-checkout") == true))
                                                    {
                                                        <span class="pill amber" style="font-size: 10px; padding: 2px 6px;" title="Automatically checked out by system at End of Day">
                                                            ⚡ System Auto-Closed
                                                        </span>
                                                    }
                                                    else if (!string.IsNullOrEmpty(p.PickupPersonName))
                                                    {
                                                        <span class="pill green" style="font-size: 10px; padding: 2px 6px;" title="Collected by @p.PickupPersonName (@p.PickupPersonRelationship) · @p.PickupVerificationMethod">
                                                            <i class="bi bi-shield-check"></i> @p.PickupPersonName
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="btn secondary" style="padding: 3px 8px; font-size: 11px; font-weight: 700; border-color: #52745e; color: #365844; background: #eaf2ec; border-radius: 6px;" @onclick="() => OpenSecurePickupModal(p)">
                                                    <i class="bi bi-shield-check"></i> Check Out
                                                </button>
                                            }
                                        }
                                        else if (p.Type == "teachers" && (p.Status == "Present" || p.Status == "Late"))
                                        {
                                            @if (p.Out != "—")
                                            {
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    <span style="font-weight: 700; color: #26332d;">@p.Out</span>
                                                    @if (p.Notes?.Contains("System auto-checkout") == true)
                                                    {
                                                        <span class="pill amber" style="font-size: 10px; padding: 2px 6px;" title="Automatically checked out by system at End of Day">
                                                            ⚡ System Auto-Closed
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="btn secondary" style="padding: 3px 8px; font-size: 11px; font-weight: 700; border-color: #52745e; color: #365844; background: #eaf2ec; border-radius: 6px;" @onclick="() => CheckOutTeacher(p)">
                                                    Check Out
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            @p.Out
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!GetPeople().Any())
                            {
                                <tr><td colspan="6">No matching records</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="note" style="margin-top:12px;">Changes will now be saved securely to the database.</div>
            </div>
        }
    </div>
</section>

<SecurePickupModal 
    IsOpen="_isPickupModalOpen"
    ChildId="_activePickupChildId"
    BranchId="_branchId"
    ClassroomId="_activePickupClassroomId"
    ChildName="@_activePickupChildName"
    ClassroomName="@_activePickupClassroomName"
    ArrivalTime="@_activePickupArrivalTime"
    OnDepartureConfirmed="HandleDepartureConfirmed"
    OnClose="() => _isPickupModalOpen = false" />

<EndOfDayProcessModal 
    IsOpen="_isEndOfDayModalOpen"
    BranchId="_branchId"
    Date="_filterDate"
    OnClose="() => _isEndOfDayModalOpen = false"
    OnCompleted="HandleEndOfDayCompleted" />

@if (showToast)
{
    <div id="toast" style="display:block;">Saved attendance changes to database.</div>
}

@code {
    [Parameter] public string BranchName { get; set; } = "Downtown";
    [Parameter] public string ClassroomName { get; set; } = "";

    private bool IsRoomView => !string.IsNullOrEmpty(ClassroomName);
    private string currentTab = "classrooms";
    private string personSearch = "";
    private string statusFilter = "all";
    private string typeFilter = "both";
    private bool showToast = false;

    private Guid _branchId;
    private List<ClassRow> _classRows = new();
    private List<PersonRow> _personRows = new();
    private DateTime _filterDate = DateTime.Today;

    private int UnmarkedCount => _personRows.Count(p => p.Status == "Not marked");
    private int MissingCheckoutCount => _personRows.Count(p => p.Status == "Present" && (p.Out == "—" || string.IsNullOrEmpty(p.Out)));

    private bool _isPickupModalOpen = false;
    private Guid _activePickupChildId;
    private Guid _activePickupClassroomId;
    private string _activePickupChildName = "";
    private string _activePickupClassroomName = "";
    private string? _activePickupArrivalTime;

    private void OpenSecurePickupModal(PersonRow person)
    {
        _activePickupChildId = person.Id;
        _activePickupClassroomId = person.ClassroomId;
        _activePickupChildName = person.Name;
        _activePickupClassroomName = person.Room;
        _activePickupArrivalTime = person.In;
        _isPickupModalOpen = true;
    }

    private bool _isEndOfDayModalOpen = false;

    private async Task HandleDepartureConfirmed(ChildAttendance att)
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task CheckOutTeacher(PersonRow teacher)
    {
        var att = new TeacherAttendance {
            Id = teacher.AttendanceId ?? Guid.NewGuid(),
            BranchId = _branchId,
            TeacherId = teacher.Id,
            AttendanceDate = _filterDate,
            Status = "Present",
            ClockInTime = TimeSpan.TryParse(teacher.In, out var inTime) ? inTime : DateTime.Now.TimeOfDay,
            ClockOutTime = DateTime.Now.TimeOfDay,
            Notes = "Manual teacher checkout",
            RecordedByUserId = UserContext.UserId
        };
        await AttendanceService.MarkTeacherAttendanceAsync(att);
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task HandleEndOfDayCompleted(EndOfDayProcessReport report)
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private void BackToOverview()
    {
        if (IsRoomView)
            Nav.NavigateTo($"/management/attendance/branches/{Uri.EscapeDataString(BranchName)}");
        else
            Nav.NavigateTo("/management/attendance");
    }

    private void OpenClass(string room) => Nav.NavigateTo($"/management/attendance/classrooms/{Uri.EscapeDataString(room)}?branch={Uri.EscapeDataString(BranchName)}");

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        foreach(var p in GetPeople())
        {
            p.IsSelected = isChecked;
        }
    }

    private async Task MarkSelectedPresent()
    {
        foreach(var p in GetPeople().Where(p => p.IsSelected))
        {
            if (p.Status != "Present")
            {
                p.Status = "Present";
                p.IsDirty = true;
            }
        }
        await ShowToast();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsRoomView && currentTab == "classrooms") currentTab = "children";
        if (string.IsNullOrEmpty(BranchName)) BranchName = "Downtown";
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org == null) return;
        
        var branches = await BranchService.GetBranchesAsync(org.Id);
        var branch = branches.FirstOrDefault(b => b.Name.Contains(BranchName, StringComparison.OrdinalIgnoreCase));
        if (branch == null) return;
        _branchId = branch.Id;

        var classrooms = (await ClassroomService.GetClassroomsAsync(_branchId)).ToList();
        var allChildren = (await ChildService.GetChildrenAsync()).ToList(); 
        var allUsers = (await UserService.GetTeachersAsync()).ToList();
        var teacherProfiles = (await TeacherService.GetAllTeachersAsync(org.TenantId)).ToList();
        var teacherUserMap = teacherProfiles.Where(t => t.UserId.HasValue).ToDictionary(t => t.UserId!.Value, t => t.Id);

        var childAtt = (await AttendanceService.GetChildAttendanceAsync(_branchId, _filterDate)).ToList();
        var teacherAtt = (await AttendanceService.GetTeacherAttendanceAsync(_branchId, _filterDate)).ToList();

        _classRows = classrooms.Select(c => {
            var expectedC = allChildren.Count(ch => ch.ClassroomId == c.Id);
            var presentC = childAtt.Count(a => a.ClassroomId == c.Id && (a.Status == "Present" || a.Status == "Late"));
            var pendingC = childAtt.Count(a => a.ClassroomId == c.Id && a.Status == "Not marked");

            var expectedT = 2;
            var presentT = teacherAtt.Count(a => a.Status == "Present" || a.Status == "Late");
            if (presentT > expectedT) presentT = expectedT;

            string status;
            if (pendingC > 0)
            {
                status = "Needs marking";
            }
            else if (expectedT > 0 && presentT < expectedT)
            {
                status = "Staffing attention";
            }
            else
            {
                status = "Marked";
            }

            return new ClassRow {
                Name = c.Name,
                Children = $"{presentC} / {expectedC}",
                Teachers = $"{presentT} / {expectedT}",
                Pending = pendingC.ToString(),
                Status = status
            };
        }).ToList();

        _personRows.Clear();
        foreach(var child in allChildren)
        {
            var cr = classrooms.FirstOrDefault(c => c.Id == child.ClassroomId);
            var att = childAtt.FirstOrDefault(a => a.ChildId == child.Id);
            _personRows.Add(new PersonRow {
                Id = child.Id,
                Name = $"{child.FirstName} {child.LastName}",
                Initials = $"{child.FirstName.FirstOrDefault()}{child.LastName.FirstOrDefault()}",
                Room = cr?.Name ?? "Unknown",
                ClassroomId = cr?.Id ?? Guid.Empty,
                Status = att?.Status ?? "Not marked",
                In = att?.ArrivalTime?.ToString(@"hh\:mm") ?? "—",
                Out = att?.DepartureTime?.ToString(@"hh\:mm") ?? "—",
                PickupPersonName = att?.PickupPersonName,
                PickupPersonRelationship = att?.PickupPersonRelationship,
                PickupVerificationMethod = att?.PickupVerificationMethod,
                PickupNotes = att?.PickupNotes,
                Notes = att?.Notes,
                Type = "children",
                AttendanceId = att?.Id
            });
        }
        
        foreach(var teacher in allUsers)
        {
            var teacherId = teacherUserMap.TryGetValue(teacher.Id, out var tId) ? tId : teacher.Id;
            var att = teacherAtt.FirstOrDefault(a => a.TeacherId == teacherId || a.TeacherId == teacher.Id);
            _personRows.Add(new PersonRow {
                Id = teacherId,
                Name = $"{teacher.FirstName} {teacher.LastName}",
                Initials = $"{teacher.FirstName.FirstOrDefault()}{teacher.LastName.FirstOrDefault()}",
                Room = "Teacher",
                Status = att?.Status ?? "Not marked",
                In = att?.ClockInTime?.ToString(@"hh\:mm") ?? "—",
                Out = att?.ClockOutTime?.ToString(@"hh\:mm") ?? "—",
                Notes = att?.Notes,
                Type = "teachers",
                AttendanceId = att?.Id
            });
        }
    }

    private IEnumerable<ClassRow> GetClassrooms() => _classRows;

    private IEnumerable<PersonRow> GetPeople()
    {
        var result = _personRows.AsEnumerable();
        if (typeFilter == "children" && currentTab == "teachers") return Enumerable.Empty<PersonRow>();
        if (typeFilter == "teachers" && currentTab == "children") return Enumerable.Empty<PersonRow>();
        
        string targetType = currentTab == "teachers" ? "teachers" : "children";
        result = result.Where(p => p.Type == targetType);

        if (!string.IsNullOrEmpty(personSearch))
            result = result.Where(p => (p.Name + " " + p.Room).Contains(personSearch, StringComparison.OrdinalIgnoreCase));
        
        if (statusFilter != "all")
            result = result.Where(p => p.Status.Equals(statusFilter, StringComparison.OrdinalIgnoreCase));
            
        if (IsRoomView)
            result = result.Where(p => p.Room.Contains(ClassroomName, StringComparison.OrdinalIgnoreCase));

        return result;
    }

    private async Task ShowToast()
    {
        foreach(var p in _personRows.Where(p => p.IsDirty))
        {
            if (p.Type == "children")
            {
                var att = new ChildAttendance {
                    Id = p.AttendanceId ?? Guid.NewGuid(),
                    BranchId = _branchId,
                    ClassroomId = p.ClassroomId,
                    ChildId = p.Id,
                    AttendanceDate = _filterDate,
                    Status = p.Status,
                    RecordedByUserId = UserContext.UserId
                };
                if (p.Status == "Present" && p.In == "—") att.ArrivalTime = DateTime.Now.TimeOfDay;
                await AttendanceService.MarkChildAttendanceAsync(att);
            }
            else
            {
                var att = new TeacherAttendance {
                    Id = p.AttendanceId ?? Guid.NewGuid(),
                    BranchId = _branchId,
                    TeacherId = p.Id,
                    AttendanceDate = _filterDate,
                    Status = p.Status,
                    RecordedByUserId = UserContext.UserId
                };
                if (p.Status == "Present" && p.In == "—") att.ClockInTime = DateTime.Now.TimeOfDay;
                await AttendanceService.MarkTeacherAttendanceAsync(att);
            }
            p.IsDirty = false;
        }

        showToast = true;
        await LoadDataAsync();
        StateHasChanged();
        await Task.Delay(2400);
        showToast = false;
        StateHasChanged();
    }

    private string[] Totals => new[] { 
        $"{_personRows.Count(p => p.Type == "children" && (p.Status == "Present" || p.Status == "Late"))} / {_personRows.Count(p => p.Type == "children")}",
        $"{_personRows.Count(p => p.Type == "teachers" && (p.Status == "Present" || p.Status == "Late"))} / {_personRows.Count(p => p.Type == "teachers")}"
    };

    public class ClassRow { public string Name { get; set; } = ""; public string Children { get; set; } = ""; public string Teachers { get; set; } = ""; public string Pending { get; set; } = ""; public string Status { get; set; } = ""; }
    public class PersonRow { 
        public Guid Id { get; set; }
        public Guid? AttendanceId { get; set; }
        public Guid ClassroomId { get; set; }
        public string Name { get; set; } = ""; 
        public string Initials { get; set; } = ""; 
        public string Room { get; set; } = ""; 
        private string _status = "";
        public string Status { 
            get => _status; 
            set { if (_status != value && !string.IsNullOrEmpty(_status)) IsDirty = true; _status = value; } 
        } 
        public string In { get; set; } = ""; 
        public string Out { get; set; } = ""; 
        public string? PickupPersonName { get; set; }
        public string? PickupPersonRelationship { get; set; }
        public string? PickupVerificationMethod { get; set; }
        public string? PickupNotes { get; set; }
        public string? Notes { get; set; }
        public string Type { get; set; } = ""; 
        public bool IsDirty { get; set; }
        public bool IsSelected { get; set; }
    }
}
