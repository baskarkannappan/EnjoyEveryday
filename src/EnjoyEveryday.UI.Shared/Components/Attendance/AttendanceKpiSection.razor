@using EnjoyEveryday.Domain.Repositories

<div class="kpis">
    <KpiCard CssClass="kpi-sprout" Label="Children present" Icon="♧" Value="@(Summary?.PresentChildren.ToString() ?? "0")" ValueSuffix="@($"/ {Summary?.ExpectedChildren ?? 0}")" FooterText="@($"{(Summary?.ExpectedChildren > 0 ? (Summary.PresentChildren * 100.0 / Summary.ExpectedChildren).ToString("0.0") : "0")}% of children expected")" />
    <KpiCard CssClass="kpi-sage" Label="Teachers present" Icon="♙" Value="@(Summary?.PresentTeachers.ToString() ?? "0")" ValueSuffix="@($"/ {Summary?.ExpectedTeachers ?? 0}")" FooterText="@($"{(Summary?.ExpectedTeachers > 0 ? (Summary.PresentTeachers * 100.0 / Summary.ExpectedTeachers).ToString("0.0") : "0")}% of teachers expected")" />
    <KpiCard CssClass="kpi-amber" Label="Attendance to finish" Icon="◷" Value="@((Summary?.AttendanceToFinishClassrooms ?? 0).ToString())" ValueSuffix="@((Summary?.AttendanceToFinishClassrooms == 1) ? "classroom" : "classrooms")" FooterText="@((Summary?.AttendanceToFinishClassrooms > 0) ? "Some people are not marked yet" : "All classrooms marked")" />
    <KpiCard CssClass="kpi-coral" Label="Needs attention" Icon="!" Value="@((Summary?.NeedsAttentionClassrooms ?? 0).ToString())" ValueSuffix="@((Summary?.NeedsAttentionClassrooms == 1) ? "classroom" : "classrooms")" FooterText="@((Summary?.NeedsAttentionClassrooms > 0) ? "Review staffing coverage" : "All coverage on track")" />
</div>

@code {
    [Parameter]
    public AttendanceSummary? Summary { get; set; }
}
