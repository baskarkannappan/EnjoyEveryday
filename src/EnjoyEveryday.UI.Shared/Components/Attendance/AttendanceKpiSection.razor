@using EnjoyEveryday.Domain.Repositories

<div class="kpis">
    <KpiCard CssClass="childkpi" Label="Children present" Icon="♧" Value="@(Summary?.PresentChildren.ToString() ?? "0")" ValueSuffix="@($"/ {Summary?.ExpectedChildren ?? 0}")" FooterText="@($"{(Summary?.ExpectedChildren > 0 ? (Summary.PresentChildren * 100.0 / Summary.ExpectedChildren).ToString("0.0") : "0")}% of children expected")" />
    <KpiCard CssClass="teacherkpi" Label="Teachers present" Icon="♙" Value="@(Summary?.PresentTeachers.ToString() ?? "0")" ValueSuffix="@($"/ {Summary?.ExpectedTeachers ?? 0}")" FooterText="@($"{(Summary?.ExpectedTeachers > 0 ? (Summary.PresentTeachers * 100.0 / Summary.ExpectedTeachers).ToString("0.0") : "0")}% of teachers expected")" />
    <KpiCard Label="Attendance to finish" Icon="◷" Value="3" ValueSuffix="classrooms" FooterText="Some people are not marked yet" />
    <KpiCard Label="Needs attention" Icon="!" Value="2" ValueSuffix="classrooms" FooterText="Review staffing coverage" />
</div>

@code {
    [Parameter]
    public AttendanceSummary? Summary { get; set; }
}
