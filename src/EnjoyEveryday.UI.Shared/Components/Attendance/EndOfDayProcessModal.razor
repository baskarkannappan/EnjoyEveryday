    border-radius: 6px;
}

.eod-empty-notice {
    padding: 18px;
    text-align: center;
    color: #6c7870;
    font-size: 13px;
    background: #f8f9f5;
    border-radius: 12px;
}

.eod-error-banner {
    background: #fff5f5;
    border: 1px solid #fed7d7;
    border-radius: 10px;
    padding: 10px 14px;
    color: #9b2c2c;
    font-size: 13px;
    font-weight: 600;
}

.eod-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 28px 24px;
    border-top: 1px solid #edf0ec;
}

.btn.primary.eod-confirm-btn {
    background: var(--accent, #557c6c);
    color: #ffffff;
    font-weight: 750;
    border: none;
    border-radius: 11px;
    padding: 9px 18px;
    font-size: 13px;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(85, 124, 108, 0.25);
    transition: all 0.15s ease;
}

.btn.primary.eod-confirm-btn:hover {
    background: var(--accent-dark, #3e6253);
}

.btn.secondary {
    background: #ffffff;
    border: 1px solid #d0d7d2;
    color: #26332d;
    font-weight: 650;
    border-radius: 11px;
    padding: 9px 16px;
    font-size: 13px;
    cursor: pointer;
}
.btn.secondary:hover {
    background: #f8f9f5;
}
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid? BranchId { get; set; }
    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EndOfDayProcessReport> OnCompleted { get; set; }

    private bool _isLoadingSummary = false;
    private bool _isExecuting = false;
    private EndOfDayPendingSummary? _summary;
    private EndOfDayProcessReport? _report;
    private TimeSpan _checkoutTime = DateTime.Now.TimeOfDay;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _report == null && _summary == null && !_isLoadingSummary)
        {
            await LoadSummaryAsync();
        }
    }

    private async Task LoadSummaryAsync()
    {
        _isLoadingSummary = true;
        _errorMessage = null;
        try
        {
            _checkoutTime = DateTime.Now.TimeOfDay;
            _summary = await EndOfDayService.GetPendingSummaryAsync(BranchId, Date);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoadingSummary = false;
        }
    }

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var t))
        {
            _checkoutTime = t;
        }
    }

    private async Task ExecuteEndOfDay()
    {
        _isExecuting = true;
        _errorMessage = null;
        try
        {
            _report = await EndOfDayService.ExecuteEndOfDayProcessAsync(BranchId, Date, _checkoutTime);
            if (OnCompleted.HasDelegate)
            {
                await OnCompleted.InvokeAsync(_report);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private async Task CloseAndFinish()
    {
        _report = null;
        _summary = null;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        _report = null;
        _summary = null;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleBackdropClick()
    {
        if (_report != null)
        {
            await CloseAndFinish();
        }
        else if (!_isExecuting)
        {
            await Cancel();
        }
    }
}
