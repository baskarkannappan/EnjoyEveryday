    margin-top: 2px;
}

.eod-breakdown-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.eod-breakdown-card {
    background: #ffffff;
    border: 1px solid #e4e7df;
    border-radius: 12px;
    padding: 12px 16px;
}

.eod-card-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 750;
    color: #26332d;
    margin-bottom: 8px;
}

.pill-autoclosed {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 6px;
    letter-spacing: 0.2px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
}

.eod-pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.eod-item-pill {
    background: #f5f8f6;
    border: 1px solid #d4e2d8;
    color: #26332d;
