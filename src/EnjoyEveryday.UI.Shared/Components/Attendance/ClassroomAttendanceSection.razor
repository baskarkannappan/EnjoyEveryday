@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Application.Services
@inject AttendanceService AttendanceService
@inject ChildService ChildService

<div class="section">
    <div>
        <h2>Classroom attendance</h2>
        <div class="note">Quick view of attendance status across the organization</div>
    </div>
</div>
<div class="card attendance-grid-card">
    <div class="tabs">
        <button class="tab @(ClassroomTab == "all" ? "active" : "")" @onclick="@(() => ClassroomTab = "all")">All classrooms</button>
        <button class="tab @(ClassroomTab == "pending" ? "active" : "")" @onclick="@(() => ClassroomTab = "pending")">Needs marking</button>
        <button class="tab @(ClassroomTab == "attention" ? "active" : "")" @onclick="@(() => ClassroomTab = "attention")">Staffing attention</button>
    </div>
    <div class="tablewrap">
        <table class="ee-table">
            <thead>
                <tr>
                    <th>Classroom</th>
                    <th>Branch</th>
                    <th>Children Present</th>
                    <th>Teachers Present</th>
                    <th>Attendance Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in GetFilteredClassrooms())
                {
                    var branch = Branches.FirstOrDefault(b => b.Id == room.Classroom.BranchId);
                    var branchName = branch?.Name ?? "Unknown";

                    <tr>
                        <td>
                            <div class="room-cell">
                                <div class="room-avatar">
                                    @(string.IsNullOrWhiteSpace(room.Classroom.Name) ? "C" : room.Classroom.Name[0].ToString().ToUpper())
                                </div>
                                <div class="room-meta">
                                    <strong class="room-title">@room.Classroom.Name</strong>
                                    <span class="room-age">@room.Classroom.AgeGroup</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="branch-pill">@branchName</span>
                        </td>
                        <td>
                            <div class="stat-cell">
                                <strong class="stat-highlight">@room.PresentChildren</strong>
                                <span class="stat-total">/ @room.ExpectedChildren</span>
                            </div>
                        </td>
                        <td>
                            <div class="stat-cell">
                                <strong class="stat-highlight">@room.PresentTeachers</strong>
                                <span class="stat-total">/ @room.ExpectedTeachers</span>
                            </div>
                        </td>
                        <td>
                            <span class="status-pill status-pill-@(room.StatusCss)">
                                @room.StatusText
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <button class="btn-action" @onclick="@(() => GoToClassroom(branchName, room.Classroom.Name))">
                                Open &rarr;
                            </button>
                        </td>
                    </tr>
                }
                @if (!GetFilteredClassrooms().Any())
                {
                    <tr>
                        <td colspan="6" class="empty-cell">
                            No classrooms match the current filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@inject NavigationManager Nav
@code {
    [Parameter]
    public IEnumerable<Classroom> Classrooms { get; set; } = Array.Empty<Classroom>();

    [Parameter]
    public IEnumerable<Branch> Branches { get; set; } = Array.Empty<Branch>();

    [Parameter]
    public DateTime SelectedDate { get; set; } = DateTime.Today;

    [Parameter]
    public string SearchQuery { get; set; } = "";

    [Parameter]
    public string BranchFilter { get; set; } = "all";

    private string ClassroomTab { get; set; } = "all";
    private List<ClassroomSummaryData> Summaries = new();

    protected override async Task OnParametersSetAsync()
    {
        Summaries.Clear();
        var allChildren = (await ChildService.GetChildrenAsync()).ToList();

        // Ensure distinct branches to prevent duplicate rows
        var distinctBranches = (Branches ?? Enumerable.Empty<Branch>())
            .GroupBy(b => b.Id)
            .Select(g => g.First())
            .ToList();

        // Ensure distinct classrooms
        var distinctClassrooms = (Classrooms ?? Enumerable.Empty<Classroom>())
            .GroupBy(c => c.Id)
            .Select(g => g.First())
            .ToList();

        var processedClassroomIds = new HashSet<Guid>();

        foreach (var branch in distinctBranches)
        {
            var childAtt = (await AttendanceService.GetChildAttendanceAsync(branch.Id, SelectedDate)).ToList();
            var teacherAtt = (await AttendanceService.GetTeacherAttendanceAsync(branch.Id, SelectedDate)).ToList();

            var rooms = distinctClassrooms.Where(c => c.BranchId == branch.Id);
            foreach (var room in rooms)
            {
                if (!processedClassroomIds.Add(room.Id)) continue;

                var roomChildrenCount = allChildren.Count(c => c.ClassroomId == room.Id);
                var expectedC = Math.Max(roomChildrenCount, childAtt.Count(x => x.ClassroomId == room.Id));
                
                var presentC = childAtt.Count(x => x.ClassroomId == room.Id && (x.Status == "Present" || x.Status == "Late"));
                var markedC = childAtt.Count(x => x.ClassroomId == room.Id && x.Status != "Not marked");
                
                var unmarkedC = expectedC - markedC;
                if (unmarkedC < 0) unmarkedC = 0;

                var expectedT = 2; // Teacher assignments to classrooms not available on TeacherAttendance entity
                var presentT = 2;

                var summary = new ClassroomSummaryData
                {
                    Classroom = room,
                    ExpectedChildren = expectedC,
                    PresentChildren = presentC,
                    ExpectedTeachers = expectedT,
                    PresentTeachers = presentT,
                    UnmarkedChildren = unmarkedC
                };

                if (unmarkedC > 0)
                {
                    summary.StatusText = "Needs marking";
                    summary.StatusCss = "amber";
                    summary.StatusCategory = "pending";
                }
                else if (expectedT > 0 && presentT < expectedT)
                {
                    summary.StatusText = "Staffing attention";
                    summary.StatusCss = "red";
                    summary.StatusCategory = "attention";
                }
                else
                {
                    summary.StatusText = "Marked";
                    summary.StatusCss = "green";
                    summary.StatusCategory = "all";
                }

                Summaries.Add(summary);
            }
        }
    }

    private IEnumerable<ClassroomSummaryData> GetFilteredClassrooms()
    {
        var result = Summaries.AsEnumerable();

        if (BranchFilter != "all")
        {
            var b = Branches.FirstOrDefault(x => x.Name == BranchFilter);
            if (b != null) result = result.Where(x => x.Classroom.BranchId == b.Id);
        }

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            result = result.Where(x => x.Classroom.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));
        }

        if (ClassroomTab != "all")
        {
            result = result.Where(x => x.StatusCategory == ClassroomTab);
        }

        return result;
    }

    private void GoToClassroom(string branch, string room) => Nav.NavigateTo($"/management/attendance/classrooms/{Uri.EscapeDataString(room)}?branch={Uri.EscapeDataString(branch)}");

    private class ClassroomSummaryData
    {
        public Classroom Classroom { get; set; } = default!;
        public int ExpectedChildren { get; set; }
        public int PresentChildren { get; set; }
        public int ExpectedTeachers { get; set; }
        public int PresentTeachers { get; set; }
        public int UnmarkedChildren { get; set; }
        public string StatusText { get; set; } = "";
        public string StatusCss { get; set; } = "";
        public string StatusCategory { get; set; } = "all";
    }
}
