@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
                <div>
                    <div class="eyebrow">ADD</div>
                    <h3 style="margin: 0 0 8px 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">Add Parent Story</h3>
                </div>
                <button class="modal-close" @onclick="OnClose">✕</button>
            </div>

            <div class="field" style="margin-bottom: 1rem;">
                <label>Child</label>
                <select value="@SelectedChildId" @onchange="@(e => SelectedChildIdChanged.InvokeAsync(e.Value?.ToString()))">
                    @if (ChildOptions != null)
                    {
                        @foreach (var child in ChildOptions)
                        {
                            <option value="@child.Key">@child.Value</option>
                        }
                    }
                </select>
            </div>

            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Story Content</label>
                <textarea value="@StoryContent" @onchange="@(e => StoryContentChanged.InvokeAsync(e.Value?.ToString()))" rows="4" placeholder="Share a highlight from the day..."></textarea>
            </div>

            <div style="border-top: 1px solid var(--border, #e4e7df); padding-top: 1.5rem; display: flex; justify-content: flex-end; gap: 1rem;">
                <button type="button" class="secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="primary" @onclick="OnSave">Post Story</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    
    [Parameter] public string? SelectedChildId { get; set; }
    [Parameter] public EventCallback<string?> SelectedChildIdChanged { get; set; }
    
    [Parameter] public string? StoryContent { get; set; }
    [Parameter] public EventCallback<string?> StoryContentChanged { get; set; }
    
    [Parameter] public IEnumerable<KeyValuePair<string, string>>? ChildOptions { get; set; }
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
