@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
                <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px;">Schedule Experience</h3>
                <button class="modal-close" @onclick="OnClose">✕</button>
            </div>
            <div class="field" style="margin-bottom: 1rem;">
                <label>Date</label>
                <input type="date" value="@ScheduleDate.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) ScheduleDateChanged.InvokeAsync(d); })" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Time of Day</label>
                <select value="@ScheduleTimeOfDay" @onchange="@(e => ScheduleTimeOfDayChanged.InvokeAsync(e.Value?.ToString()))">
                    <option value="Morning">Morning</option>
                    <option value="Afternoon">Afternoon</option>
                    <option value="Late Afternoon">Late Afternoon</option>
                </select>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 1rem;">
                <button type="button" class="secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="primary" @onclick="OnSave">Schedule</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    
    [Parameter] public DateTime ScheduleDate { get; set; }
    [Parameter] public EventCallback<DateTime> ScheduleDateChanged { get; set; }
    
    [Parameter] public string? ScheduleTimeOfDay { get; set; }
    [Parameter] public EventCallback<string?> ScheduleTimeOfDayChanged { get; set; }
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
