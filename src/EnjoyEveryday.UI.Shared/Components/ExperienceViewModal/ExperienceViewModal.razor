@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal modal-card exp-view-modal" @onclick:stopPropagation="true">
            <!-- Standardized Header -->
            <div class="modal-header exp-modal-header">
                <div class="exp-header-left">
                    <div class="eyebrow exp-eyebrow-pill">
                        <span>🌱</span>
                        <span>EXPERIENCE BLUEPRINT</span>
                    </div>
                    <h2 class="modal-title exp-main-title">@Title</h2>
                    <div class="modal-meta">
                        <span class="meta-chip">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="7" r="4"></circle>
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            </svg>
                            <span>Age @Age</span>
                        </span>
                        <span class="meta-chip">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>@Duration</span>
                        </span>
                        <span class="meta-chip">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            </svg>
                            <span>@Environment</span>
                        </span>
                        <span class="meta-chip warm">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>@GroupSize</span>
                        </span>
                    </div>
                </div>
                <button type="button" class="modal-close" title="Close" @onclick="OnClose">✕</button>
            </div>

            <!-- Scrollable Body -->
            <div class="modal-body exp-modal-body">
                <!-- Mission Banner Card -->
                <div class="detail mission-card">
                    <label>
                        <span class="section-dot"></span>
                        TODAY'S MISSION
                    </label>
                    <p>@Mission</p>
                </div>

                <!-- DNA Highlights Grid -->
                @if (!string.IsNullOrEmpty(Discover) || !string.IsNullOrEmpty(Challenge) || !string.IsNullOrEmpty(JoyMoment))
                {
                    <div class="dna-highlights-grid">
                        @if (!string.IsNullOrEmpty(Discover))
                        {
                            <div class="detail dna-tile">
                                <label>✨ DISCOVER</label>
                                <p>@Discover</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Challenge))
                        {
                            <div class="detail dna-tile">
                                <label>🧩 CHALLENGE</label>
                                <p>@Challenge</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(JoyMoment))
                        {
                            <div class="detail dna-tile joy-tile">
                                <label>🌿 JOY MOMENT</label>
                                <p>@JoyMoment</p>
                            </div>
                        }
                    </div>
                }

                <!-- Execution Guide -->
                @if (ExecutionGuide != null)
                {
                    <div class="execution-guide-section">
                        <div class="execution-header-bar">
                            <div>
                                <div class="execution-eyebrow">CLASSROOM FACILITATION</div>
                                <h3>How to Run This Experience</h3>
                            </div>
                            <span class="duration-badge">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <span>@ExecutionGuide.SuggestedDurationMinutes minutes</span>
                            </span>
                        </div>

                        <div class="prep-setup-grid">
                            @if (ExecutionGuide.Preparation.Any())
                            {
                                <div class="detail guide-box">
                                    <label>BEFORE CHILDREN ARRIVE</label>
                                    <ul class="guide-list">
                                        @foreach (var item in ExecutionGuide.Preparation)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (ExecutionGuide.EnvironmentSetup.Any() || ExecutionGuide.MaterialSetup.Any())
                            {
                                <div class="detail guide-box">
                                    <label>SET UP</label>
                                    <ul class="guide-list">
                                        @foreach (var item in ExecutionGuide.EnvironmentSetup)
                                        {
                                            <li>@item</li>
                                        }
                                        @foreach (var item in ExecutionGuide.MaterialSetup)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>

                        @if (ExecutionGuide.Phases.Any())
                        {
                            <div class="detail guide-box">
                                <label>LET'S BEGIN — STEP-BY-STEP FLOW</label>
                                <div class="phases-list">
                                    @foreach (var phase in ExecutionGuide.Phases)
                                    {
                                        <div class="phase-item">
                                            <div class="phase-header">
                                                <strong>@phase.Name</strong>
                                                <span class="phase-time">@phase.DurationMinutes min</span>
                                            </div>
                                            <div class="phase-roles">
                                                <div class="role-row"><span class="role-tag children">Children</span> <span>@phase.ChildrenDo</span></div>
                                                <div class="role-row"><span class="role-tag teacher">Teacher</span> <span>@phase.TeacherDoes</span></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="detail guide-box teacher-eyes-box">
                            <label>TEACHER EYES &amp; PROMPTS</label>
                            <div class="teacher-eyes-grid">
                                <div class="eye-prompt">
                                    <span class="eye-tag">WATCH</span>
                                    <p>@ExecutionGuide.Watch</p>
                                </div>
                                <div class="eye-prompt">
                                    <span class="eye-tag">ASK</span>
                                    <p>@ExecutionGuide.Ask</p>
                                </div>
                                <div class="eye-prompt">
                                    <span class="eye-tag">TRY</span>
                                    <p>@ExecutionGuide.Try</p>
                                </div>
                            </div>
                        </div>

                        @if (ExecutionGuide.Adaptations.Any())
                        {
                            <div class="detail guide-box">
                                <label>IF THINGS CHANGE</label>
                                <ul class="guide-list">
                                    @foreach (var item in ExecutionGuide.Adaptations)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ExecutionGuide.LittleMomentOpportunity))
                        {
                            <div class="detail moment-callout">
                                <div class="moment-callout-text">
                                    <label>📸 CAPTURE A LITTLE MOMENT</label>
                                    <p>Look for: @ExecutionGuide.LittleMomentOpportunity</p>
                                </div>
                                <button type="button" class="secondary btn-compact">Capture Little Moment</button>
                            </div>
                        }
                    </div>
                }

                <!-- Teacher Reviews Section -->
                <div class="reviews-section">
                    <div class="reviews-header">
                        <label>TEACHER REVIEWS &amp; REFLECTIONS</label>
                        @if (Reviews != null && Reviews.Any())
                        {
                            <span class="reviews-count-pill">@Reviews.Count() @(Reviews.Count() == 1 ? "review" : "reviews")</span>
                        }
                    </div>

                    @if (Reviews != null && Reviews.Any())
                    {
                        <div class="reviews-list">
                            @foreach (var review in Reviews)
                            {
                                <div class="review-card">
                                    <div class="review-card-top">
                                        <div class="review-stars-wrap">
                                            <span class="stars-text">@string.Join("", Enumerable.Repeat("⭐", review.Stars))</span>
                                            @if (!string.IsNullOrEmpty(review.Rating))
                                            {
                                                <span class="review-summary-tag">@review.Rating</span>
                                            }
                                        </div>
                                        <span class="review-date">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(review.Notes))
                                    {
                                        <p class="review-notes">@review.Notes</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-reviews-box">
                            No classroom reviews yet. Be the first teacher to share how this experience went!
                        </div>
                    }

                    @if (OnSubmitReview.HasDelegate)
                    {
                        <div class="leave-review-card">
                            <div class="leave-review-title">Leave a Classroom Reflection</div>

                            <div class="review-form-row">
                                <div class="review-field">
                                    <label>Rating (Stars)</label>
                                    <select @bind="_newReviewStars">
                                        <option value="5">5 — Excellent</option>
                                        <option value="4">4 — Good</option>
                                        <option value="3">3 — Okay</option>
                                        <option value="2">2 — Needs Work</option>
                                        <option value="1">1 — Poor</option>
                                    </select>
                                </div>
                                <div class="review-field">
                                    <label>Quick Tag (Optional)</label>
                                    <input @bind="_newReviewRating" type="text" placeholder="e.g. Children loved it, High engagement" />
                                </div>
                            </div>

                            <div class="review-field" style="margin-bottom: 12px;">
                                <label>Comments / Classroom Adjustments</label>
                                <textarea @bind="_newReviewNotes" rows="2" placeholder="How did it go? Did you adapt any materials or steps?"></textarea>
                            </div>

                            <div class="review-submit-row">
                                <button type="button" class="primary" @onclick="SubmitReview">Submit Review</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Standardized Footer -->
            <div class="modal-footer exp-modal-footer">
                <button type="button" class="secondary" @onclick="OnClose" style="margin-right: auto;">Close</button>
                @if (CanManage && OnCompare.HasDelegate)
                {
                    <button type="button" class="secondary" @onclick="OnCompare">Compare</button>
                }
                @if (CanManage && OnDelete.HasDelegate)
                {
                    <button type="button" class="secondary btn-danger-outline" @onclick="OnDelete">Delete</button>
                }
                <button type="button" class="secondary" @onclick="OnPrint">Print</button>
                @if (CanManage)
                {
                    <button type="button" class="secondary" @onclick="OnDuplicate">Duplicate</button>
                }
                @if (CanManage && ExperienceId.HasValue && OnSubmitForCuration.HasDelegate)
                {
                    <button type="button" class="secondary btn-accent-outline" @onclick="() => OnSubmitForCuration.InvokeAsync(ExperienceId.Value)">
                        <span>🌿</span>
                        <span>Submit for Curation</span>
                    </button>
                }
                @if (ExperienceId.HasValue && OnOpenStorybook.HasDelegate)
                {
                    <button type="button" class="secondary btn-storybook-action" @onclick="() => OnOpenStorybook.InvokeAsync(ExperienceId.Value)">
                        <span>📖</span>
                        <span>Interactive Story</span>
                    </button>
                }
                @if (CanManage)
                {
                    <button type="button" class="primary btn-improve-ai" @onclick="OnImprove">
                        <span>✨</span>
                        <span>Improve with AI</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool CanManage { get; set; } = true;
    [Parameter] public Guid? ExperienceId { get; set; }
    [Parameter] public EventCallback<Guid> OnSubmitForCuration { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenStorybook { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Age { get; set; } = "3-4";
    [Parameter] public string Duration { get; set; } = "25 min";
    [Parameter] public string Environment { get; set; } = "Indoor";
    [Parameter] public string GroupSize { get; set; } = "6-18 children";
    
    [Parameter] public string Mission { get; set; } = "";
    [Parameter] public string Discover { get; set; } = "";
    [Parameter] public string Challenge { get; set; } = "";
    [Parameter] public string JoyMoment { get; set; } = "";
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrint { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }
    [Parameter] public EventCallback OnImprove { get; set; }
    [Parameter] public EventCallback OnCompare { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EnjoyEveryday.Domain.Entities.ExecutionGuide? ExecutionGuide { get; set; }
    
    [Parameter] public IEnumerable<EnjoyEveryday.Domain.Entities.ExperienceFeedback>? Reviews { get; set; }
    [Parameter] public EventCallback<(int Stars, string Rating, string Notes)> OnSubmitReview { get; set; }

    private int _newReviewStars = 5;
    private string _newReviewRating = "";
    private string _newReviewNotes = "";

    private async Task SubmitReview()
    {
        if (OnSubmitReview.HasDelegate)
        {
            await OnSubmitReview.InvokeAsync((_newReviewStars, _newReviewRating, _newReviewNotes));
            _newReviewStars = 5;
            _newReviewRating = "";
            _newReviewNotes = "";
        }
    }
}
