@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="OnClose">✕</button>
            
            <div class="eyebrow" style="margin-bottom: 8px;">EXPERIENCE</div>
            <h2 style="margin: 0 0 1.5rem 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">@Title</h2>
            
            <div class="modal-meta">
                <span>Age @Age</span>
                <span>@Duration</span>
                <span>@Environment</span>
                <span>@GroupSize</span>
            </div>

            <div class="detail">
                <label>TODAY'S MISSION</label>
                <p>@Mission</p>
            </div>

            @if (!string.IsNullOrEmpty(Discover))
            {
                <div class="detail">
                    <label>DISCOVER</label>
                    <p>@Discover</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Challenge))
            {
                <div class="detail">
                    <label>CHALLENGE</label>
                    <p>@Challenge</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(JoyMoment))
            {
                <div class="detail">
                    <label>JOY MOMENT</label>
                    <p>@JoyMoment</p>
                </div>
            }

            <div class="modal-footer">
                <button class="secondary" @onclick="OnSchedule">Schedule</button>
                <button class="secondary" @onclick="OnDuplicate">Duplicate</button>
                <button class="primary" @onclick="OnImprove" style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 14px;">✨</span> Improve with AI
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Age { get; set; } = "3-4";
    [Parameter] public string Duration { get; set; } = "25 min";
    [Parameter] public string Environment { get; set; } = "Indoor";
    [Parameter] public string GroupSize { get; set; } = "6-18 children";
    
    [Parameter] public string Mission { get; set; } = "";
    [Parameter] public string Discover { get; set; } = "";
    [Parameter] public string Challenge { get; set; } = "";
    [Parameter] public string JoyMoment { get; set; } = "";
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSchedule { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }
    [Parameter] public EventCallback OnImprove { get; set; }
}
