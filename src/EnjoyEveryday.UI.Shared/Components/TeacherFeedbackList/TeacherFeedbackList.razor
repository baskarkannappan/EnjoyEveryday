@namespace EnjoyEveryday.UI.Shared.Components

<div class="panel">
    <h3>@Title</h3>
    <div class="panel-description">
        @Subtitle
    </div>

    @foreach (var item in Items)
    {
        <div class="quote" style="cursor: pointer;" @onclick="() => OnItemClick.InvokeAsync(item)">
            <div class="quote-mark">"</div>
            <p>@item.Notes</p>
            <small>&mdash; @item.Author</small>
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "What teachers are saying";
    [Parameter] public string Subtitle { get; set; } = "Recent feedback";
    [Parameter] public IEnumerable<FeedbackItem> Items { get; set; } = Array.Empty<FeedbackItem>();
    [Parameter] public EventCallback<FeedbackItem> OnItemClick { get; set; }
}
