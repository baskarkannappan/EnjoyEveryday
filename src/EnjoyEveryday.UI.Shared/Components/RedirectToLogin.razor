@namespace EnjoyEveryday.UI.Shared.Components
@inject NavigationManager Navigation

@code {
    [Parameter]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!string.IsNullOrEmpty(relativeUri) && 
            !relativeUri.StartsWith("login", StringComparison.OrdinalIgnoreCase) &&
            !relativeUri.StartsWith("auth", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/" + relativeUri)}", forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
