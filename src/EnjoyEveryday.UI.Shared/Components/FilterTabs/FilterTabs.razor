@namespace EnjoyEveryday.UI.Shared.Components

<div class="tabs">
    @if (Tabs != null)
    {
        @foreach (var tab in Tabs)
        {
            <button class="tab @(tab.Value == ActiveTab ? "active" : "")" @onclick="() => OnTabSelected.InvokeAsync(tab.Value)">
                @tab.Text
            </button>
        }
    }
</div>

@code {
    public class TabItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    [Parameter] public IEnumerable<TabItem> Tabs { get; set; } = Array.Empty<TabItem>();
    [Parameter] public string ActiveTab { get; set; } = "";
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
}
