@namespace EnjoyEveryday.UI.Shared.Components

<div class="tabs-container">
    <div class="tabs" role="tablist">
        @if (Tabs != null)
        {
            @foreach (var tab in Tabs)
            {
                var isActive = string.Equals(tab.Value, ActiveTab, StringComparison.OrdinalIgnoreCase);
                <button type="button" 
                        role="tab" 
                        aria-selected="@(isActive ? "true" : "false")"
                        class="tab @(isActive ? "active" : "")" 
                        @onclick="() => OnTabSelected.InvokeAsync(tab.Value)">
                    <span class="tab-label">@tab.Text</span>
                    @if (tab.Count.HasValue)
                    {
                        <span class="tab-badge @(isActive ? "badge-active" : "")">@tab.Count.Value</span>
                    }
                </button>
            }
        }
    </div>
</div>

@code {
    public class TabItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
        public int? Count { get; set; }
    }

    [Parameter] public IEnumerable<TabItem> Tabs { get; set; } = Array.Empty<TabItem>();
    [Parameter] public string ActiveTab { get; set; } = "";
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
}
