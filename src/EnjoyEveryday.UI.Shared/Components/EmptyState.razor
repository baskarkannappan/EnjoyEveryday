@namespace EnjoyEveryday.UI.Shared.Components

<div class="empty-state-container" style="min-height: @(MinHeightPx)px;">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="empty-state-icon">@Icon</div>
    }
    <h3 class="empty-state-title">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="empty-state-description">@Description</p>
    }
    @if (!string.IsNullOrWhiteSpace(ActionText) && OnAction.HasDelegate)
    {
        <button class="primary empty-state-action-btn" @onclick="OnAction">
            @ActionText
        </button>
    }
    @if (ActionContent != null)
    {
        <div class="empty-state-custom-action">
            @ActionContent
        </div>
    }
</div>

<style>
    .empty-state-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 24px;
        background: var(--surface, #ffffff);
        border: 1px dashed var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .04));
        width: 100%;
        margin: 16px 0;
    }

    .empty-state-icon {
        font-size: 34px;
        line-height: 1;
        margin-bottom: 12px;
        background: var(--surface-soft, #f8f9f5);
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border, #e4e7df);
    }

    .empty-state-title {
        font-size: 16px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin: 0 0 6px 0;
        letter-spacing: -0.3px;
    }

    .empty-state-description {
        font-size: 13px;
        color: var(--muted, #6c7870);
        max-width: 440px;
        line-height: 1.5;
        margin: 0 0 16px 0;
    }

    .empty-state-action-btn {
        margin-top: 6px;
    }

    .empty-state-custom-action {
        margin-top: 10px;
    }
</style>

@code {
    [Parameter] public string Icon { get; set; } = "🌱";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Message { get => Description; set => Description = value; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public RenderFragment? ActionContent { get; set; }
    [Parameter] public int MinHeightPx { get; set; } = 220;
}
