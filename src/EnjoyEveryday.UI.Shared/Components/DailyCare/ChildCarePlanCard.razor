@namespace EnjoyEveryday.UI.Shared.Components.DailyCare
@using EnjoyEveryday.Domain.Entities

<div class="plan-sheet">
    <div class="plan-sheet-top">
        <div>
            <span class="badge-v">Version @Plan.Version</span>
            <h3>@Plan.ChildName</h3>
            <span class="effective-date">Effective: @Plan.EffectiveDate.ToString("MMM d, yyyy")</span>
        </div>
        <span class="status-pill active">@Plan.Status</span>
    </div>

    <div class="plan-body-sections">
        <div class="plan-field">
            <strong>⚠️ Allergies &amp; Dietary Guidance:</strong>
            <p>@(Plan.DietaryAllergiesSummary ?? "No documented food allergies.")</p>
        </div>
        <div class="plan-field">
            <strong>👶 Diaper &amp; Toileting Routine:</strong>
            <p>@(Plan.DiaperRoutineGuidance ?? "Routine 2-hour diaper checks.")</p>
            @if (!string.IsNullOrEmpty(Plan.ToiletingSupportPlan))
            {
                <small>Support: @Plan.ToiletingSupportPlan</small>
            }
        </div>
        <div class="plan-field">
            <strong>🥣 Feeding &amp; Bottle Instructions:</strong>
            <p>@(Plan.FeedingInstructions ?? "Self-feeds standard classroom meals.")</p>
        </div>
        <div class="plan-field">
            <strong>🌙 Sleep Routine:</strong>
            <p>@(Plan.SleepRoutineGuidance ?? "Quiet rest per classroom schedule.")</p>
        </div>
        <div class="plan-field">
            <strong>❤️ Comfort &amp; Calming:</strong>
            <p>@(Plan.ComfortCalmingPreferences ?? "Calm reassurance when tired.")</p>
        </div>
        <div class="plan-field">
            <strong>📦 Required Cubby Supplies:</strong>
            <p>@(Plan.RequiredSuppliesNote ?? "Standard diapers, wipes, and spare clothes.")</p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ChildCarePlan Plan { get; set; } = default!;
}
