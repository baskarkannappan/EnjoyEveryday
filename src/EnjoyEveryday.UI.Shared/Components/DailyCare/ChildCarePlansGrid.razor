@namespace EnjoyEveryday.UI.Shared.Components.DailyCare
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components

<div class="plans-container">
    @if (Plans == null || Plans.Count == 0)
    {
        <EmptyState Icon="📋"
                    Title="No specific care plans registered yet"
                    Description="Default age-appropriate classroom care standards currently apply across all active children." />
    }
    else
    {
        <div class="plans-grid">
            @foreach (var plan in Plans)
            {
                <ChildCarePlanCard Plan="@plan" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ChildCarePlan> Plans { get; set; } = Array.Empty<ChildCarePlan>();
}
