@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Tenancy
@inject IChildDailyCareService DailyCareService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject ITenantContext TenantContext
@inject IUserContext UserContext

<div class="daily-care-module">

    <!-- KPI PULSE SUMMARY -->
    <div class="kpi-grid">
        <div class="kpi-card good">
            <span class="kpi-label">Children Checked In</span>
            <span class="kpi-val">@_classroomOverview.Count(c => c.IsCheckedIn) / @_classroomOverview.Count</span>
            <span class="kpi-sub">Active in classroom today</span>
        </div>
        <div class="kpi-card info">
            <span class="kpi-label">Care Events Recorded</span>
            <span class="kpi-val">@_totalRecordedEventsToday</span>
            <span class="kpi-sub">Diapers, meals, and routines</span>
        </div>
        <div class="kpi-card attention">
            <span class="kpi-label">Active Rest Sessions</span>
            <span class="kpi-val">@_classroomOverview.Count(c => c.ActiveNapSession != null)</span>
            <span class="kpi-sub">Napping now</span>
        </div>
        <div class="kpi-card @(_lowSupplies.Count > 0 ? "warning" : "good")">
            <span class="kpi-label">Supply Warnings</span>
            <span class="kpi-val">@_lowSupplies.Count</span>
            <span class="kpi-sub">@(_lowSupplies.Count > 0 ? "Items low or depleted" : "All supplies stocked")</span>
        </div>
    </div>

    <!-- FILTER & CLASSROOM SELECTOR BAR -->
    <div class="action-bar">
        <div class="filter-controls">
            <div class="control-group">
                <label>Branch:</label>
                <select class="select-input" @onchange="OnBranchChanged">
                    @foreach (var b in _branches)
                    {
                        <option value="@b.Id" selected="@(b.Id == _selectedBranchId)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="control-group">
                <label>Classroom:</label>
                <select class="select-input" @onchange="OnClassroomChanged">
                    <option value="">All Classrooms</option>
                    @foreach (var c in _classrooms)
                    {
                        <option value="@c.Id" selected="@(c.Id == _selectedClassroomId)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="control-group">
                <label>Date:</label>
                <input type="date" class="text-input" value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
            </div>
        </div>

        <div class="header-actions">
            <button class="btn secondary" @onclick="() => _showCarePlanModal = true">
                📋 View Care Plans
            </button>
            <button class="btn secondary" @onclick="() => _showSupplyModal = true">
                📦 Check Supplies
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert-banner success">
            <span>✅ @_statusMessage</span>
            <button class="close-alert" @onclick="() => _statusMessage = null">✕</button>
        </div>
    }

    <!-- TWO-COLUMN WORKSPACE: QUICK CARE ENTRY (LEFT) & TIMELINE (RIGHT) -->
    <div class="main-workspace-grid">

        <!-- LEFT COLUMN: QUICK CARE ENTRY (Matching Screenshot 1) -->
        <div class="card-panel entry-panel">
            <div class="panel-header">
                <div class="header-with-toggle">
                    <div>
                        <div class="eyebrow">Interactive Care Logger</div>
                        <h2>Quick care entry</h2>
                    </div>
                    <div class="mode-toggle-group">
                        <button type="button" 
                                class="mode-tab @(!_isBulkMode ? "active" : "")" 
                                @onclick="() => SetEntryMode(false)">
                            👤 Single Child
                        </button>
                        <button type="button" 
                                class="mode-tab @(_isBulkMode ? "active" : "")" 
                                @onclick="() => SetEntryMode(true)">
                            👥 Group / Bulk (@_selectedChildIds.Count)
                        </button>
                    </div>
                </div>
                <p class="panel-desc">Fast, single-tap routine recording for teachers. Current timestamp recorded automatically.</p>
            </div>

            @if (!_isBulkMode)
            {
                <!-- Single Child Selector -->
                <div class="form-field">
                    <label>Child</label>
                    <select class="select-input child-select" @onchange="OnSelectedChildChanged">
                        @if (_classroomOverview.Count == 0)
                        {
                            <option value="">No children found in this classroom</option>
                        }
                        else
                        {
                            @foreach (var child in _classroomOverview)
                            {
                                <option value="@child.ChildId" selected="@(child.ChildId == _selectedChildId)">
                                    @child.ChildName @(child.IsCheckedIn ? "✓ (Checked In)" : "(Not Checked In)")
                                </option>
                            }
                        }
                    </select>
                </div>
            }
            else
            {
                <!-- Bulk Child Multi-Select Area -->
                <div class="form-field bulk-children-field">
                    <div class="bulk-toolbar">
                        <label>Select Children (@_selectedChildIds.Count of @_classroomOverview.Count selected)</label>
                        <div class="bulk-quick-actions">
                            <button type="button" class="btn sm outline" @onclick="SelectAllCheckedInChildren">
                                Select All Checked In (@_classroomOverview.Count(c => c.IsCheckedIn))
                            </button>
                            <button type="button" class="btn sm outline" @onclick="SelectAllChildren">
                                Select All
                            </button>
                            <button type="button" class="btn sm text-btn" @onclick="ClearSelectedChildren">
                                Clear
                            </button>
                        </div>
                    </div>

                    <div class="bulk-children-selector-grid">
                        @foreach (var child in _classroomOverview)
                        {
                            var isSelected = _selectedChildIds.Contains(child.ChildId);
                            <div class="bulk-child-chip @(isSelected ? "selected" : "")" 
                                 @onclick="() => ToggleChildSelection(child.ChildId)">
                                <span class="chip-checkbox">@(isSelected ? "☑" : "☐")</span>
                                <span class="chip-name">@child.ChildName</span>
                                @if (child.IsCheckedIn)
                                {
                                    <span class="chip-badge in">In</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Care Activity 2x3 Grid Tiles (Matching Screenshot 1) -->
            <div class="form-field">
                <label>Care activity</label>
                <div class="activity-tiles-grid">

                    <!-- Tile 1: Diaper change -->
                    <button type="button" 
                            class="activity-tile @(_selectedActivity == CareEventTypes.DiaperChange ? "selected" : "")"
                            @onclick="() => SelectActivity(CareEventTypes.DiaperChange)">
                        <div class="tile-top">
                            <span class="tile-icon">👶</span>
                            @if (_selectedActivity == CareEventTypes.DiaperChange)
                            {
                                <span class="tile-check">✓</span>
                            }
                        </div>
                        <div class="tile-name">Diaper change</div>
                    </button>

                    <!-- Tile 2: Meal -->
                    <button type="button" 
                            class="activity-tile @(_selectedActivity == CareEventTypes.Meal ? "selected" : "")"
                            @onclick="() => SelectActivity(CareEventTypes.Meal)">
                        <div class="tile-top">
                            <span class="tile-icon">🍴</span>
                            @if (_selectedActivity == CareEventTypes.Meal)
                            {
                                <span class="tile-check">✓</span>
                            }
                        </div>
                        <div class="tile-name">Meal</div>
                    </button>

                    <!-- Tile 3: Sleep / rest -->
                    <button type="button" 
                            class="activity-tile @(_selectedActivity == CareEventTypes.SleepRest ? "selected" : "")"
                            @onclick="() => SelectActivity(CareEventTypes.SleepRest)">
                        <div class="tile-top">
                            <span class="tile-icon">🌙</span>
                            @if (_selectedActivity == CareEventTypes.SleepRest)
                            {
                                <span class="tile-check">✓</span>
                            }
                        </div>
                        <div class="tile-name">Sleep / rest</div>
                    </button>

                    <!-- Tile 4: Toileting -->
                    <button type="button" 
                            class="activity-tile @(_selectedActivity == CareEventTypes.Toileting ? "selected" : "")"
                            @onclick="() => SelectActivity(CareEventTypes.Toileting)">
                        <div class="tile-top">
                            <span class="tile-icon">🚪</span>
                            @if (_selectedActivity == CareEventTypes.Toileting)
                            {
                                <span class="tile-check">✓</span>
                            }
                        </div>
                        <div class="tile-name">Toileting</div>
                    </button>

                    <!-- Tile 5: Hygiene -->
                    <button type="button" 
                            class="activity-tile @(_selectedActivity == CareEventTypes.Hygiene ? "selected" : "")"
                            @onclick="() => SelectActivity(CareEventTypes.Hygiene)">
                        <div class="tile-top">
                            <span class="tile-icon">💧</span>
                            @if (_selectedActivity == CareEventTypes.Hygiene)
                            {
                                <span class="tile-check">✓</span>
                            }
                        </div>
                        <div class="tile-name">Hygiene</div>
                    </button>

                    <!-- Tile 6: Comfort -->
                    <button type="button" 
                            class="activity-tile @(_selectedActivity == CareEventTypes.Comfort ? "selected" : "")"
                            @onclick="() => SelectActivity(CareEventTypes.Comfort)">
                        <div class="tile-top">
                            <span class="tile-icon">❤️</span>
                            @if (_selectedActivity == CareEventTypes.Comfort)
                            {
                                <span class="tile-check">✓</span>
                            }
                        </div>
                        <div class="tile-name">Comfort</div>
                    </button>

                </div>
            </div>

            <!-- Activity Details Selection -->
            <div class="form-field">
                <label>Activity details</label>
                <select class="select-input" @bind="_selectedDetail">
                    @foreach (var opt in GetDetailsOptionsForActivity(_selectedActivity))
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>

            <!-- Optional Note -->
            <div class="form-field">
                <label>Optional note</label>
                <input type="text" 
                       class="text-input" 
                       placeholder="Add a short factual observation..." 
                       @bind="_entryNote" />
            </div>

            <!-- Visibility checkbox -->
            <div class="form-field checkbox-field">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_parentVisible" />
                    <span>Share on parent daily summary</span>
                </label>
            </div>

            <!-- Submit Button (Matching Screenshot 1 & Bulk Mode) -->
            <div class="submit-action-box">
                @if (!_isBulkMode)
                {
                    <button class="btn primary btn-block" @onclick="SubmitQuickCareEntry" disabled="@(_isSubmitting || _selectedChildId == Guid.Empty)">
                        @(_isSubmitting ? "Saving Entry..." : "Record care entry")
                    </button>
                }
                else
                {
                    <button class="btn primary btn-block" @onclick="SubmitBulkCareEntry" disabled="@(_isSubmitting || _selectedChildIds.Count == 0)">
                        @(_isSubmitting ? "Recording for group..." : $"Record '{_selectedActivity}' for {_selectedChildIds.Count} children")
                    </button>
                }
            </div>

            <!-- Nap Controls (Single vs Bulk) -->
            @if (!_isBulkMode)
            {
                @if (_selectedChildStatus?.ActiveNapSession != null)
                {
                    <div class="active-nap-banner">
                        <div class="nap-info">
                            <strong>🌙 Active Rest in Progress</strong>
                            <span>Started at @_selectedChildStatus.ActiveNapSession.StartTime.ToLocalTime().ToString("h:mm tt")</span>
                        </div>
                        <button class="btn success sm" @onclick="WakeActiveChild">
                            ☀️ Wake Child &amp; Log Duration
                        </button>
                    </div>
                }
                else if (_selectedChildId != Guid.Empty)
                {
                    <div class="start-nap-box">
                        <button class="btn secondary sm" @onclick="StartNapForChild">
                            🌙 Start Rest Session for @(_selectedChildStatus?.ChildName ?? "Child")
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="bulk-nap-controls">
                    <button class="btn secondary sm" @onclick="StartBulkNap" disabled="@(_selectedChildIds.Count == 0)">
                        🌙 Start Rest for All Selected (@_selectedChildIds.Count)
                    </button>
                    <button class="btn success sm" @onclick="WakeBulkChildren" disabled="@(_selectedChildIds.Count == 0)">
                        ☀️ Wake All Selected &amp; Log Duration
                    </button>
                </div>
            }

        </div>

        <!-- RIGHT COLUMN: CHILD CARE TIMELINE (Matching Screenshot 2) -->
        <div class="card-panel timeline-panel">
            <div class="panel-header timeline-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="calendar-icon">📅</span>
                    <div>
                        <h2>@(_selectedChildStatus?.ChildName ?? "Child")'s day</h2>
                        <span class="sub-muted">Daily care timeline</span>
                    </div>
                </div>
                <div class="timeline-meta-badge">
                    @_childTimeline.Count recorded events
                </div>
            </div>

            @if (_childTimeline.Count == 0)
            {
                <div class="empty-timeline">
                    <span class="empty-icon">🌱</span>
                    <h3>No care records entered yet today</h3>
                    <p>Tap any activity on the left to record the first care event for @(_selectedChildStatus?.ChildName ?? "this child").</p>
                </div>
            }
            else
            {
                <div class="chronological-timeline">
                    @{
                        int step = 1;
                    }
                    @foreach (var item in _childTimeline)
                    {
                        <div class="timeline-step">
                            <div class="step-num">@step</div>
                            <div class="step-content">
                                <div class="step-header-line">
                                    <div class="step-time-title">
                                        <strong>@item.TimeLabel</strong>
                                        <span class="divider">—</span>
                                        <span class="step-title">@item.Title</span>
                                    </div>
                                    <span class="step-icon-badge">@item.Icon</span>
                                </div>
                                <p class="step-desc">@item.Description</p>
                                @if (!string.IsNullOrEmpty(item.StaffName))
                                {
                                    <div class="step-meta">Recorded by @item.StaffName</div>
                                }
                            </div>
                        </div>
                        step++;
                    }
                </div>
            }

            <div class="timeline-footer-note">
                Illustrative records only. The real timeline shows actual recorded events from daycare database.
            </div>
        </div>

    </div>

    <!-- CLASSROOM ROSTER QUICK-CARD OVERVIEW -->
    <div class="roster-section">
        <div class="roster-header">
            <h3>Classroom Children Roster</h3>
            <span class="roster-sub">Select any child to switch quick care entry and view their individual timeline</span>
        </div>

        <div class="roster-grid">
            @foreach (var child in _classroomOverview)
            {
                <div class="child-roster-card @(child.ChildId == _selectedChildId ? "active" : "")"
                     @onclick="() => SelectChild(child.ChildId)">
                    <div class="child-card-top">
                        <div class="child-avatar">
                            @if (!string.IsNullOrEmpty(child.PhotoUrl))
                            {
                                <img src="@child.PhotoUrl" alt="@child.ChildName" />
                            }
                            else
                            {
                                <span>@(child.ChildName.FirstOrDefault())</span>
                            }
                        </div>
                        <div class="child-info">
                            <h4>@child.ChildName</h4>
                            <span class="att-status @(child.IsCheckedIn ? "present" : "absent")">
                                @(child.IsCheckedIn ? "Checked In" : "Not Checked In")
                            </span>
                        </div>
                    </div>

                    <div class="child-care-summary-chips">
                        <div class="summary-chip">
                            <span class="chip-label">Diaper:</span>
                            <span class="chip-val">@(child.LastDiaperEvent?.DiaperCondition ?? "None")</span>
                        </div>
                        <div class="summary-chip">
                            <span class="chip-label">Meal:</span>
                            <span class="chip-val">@(child.LastMealEvent != null ? $"{child.LastMealEvent.MealType} ({child.LastMealEvent.AmountConsumed})" : "None")</span>
                        </div>
                        <div class="summary-chip">
                            <span class="chip-label">Rest:</span>
                            <span class="chip-val @(child.ActiveNapSession != null ? "active-rest" : "")">
                                @(child.ActiveNapSession != null ? "Napping" : "Awake")
                            </span>
                        </div>
                    </div>

                    @if (child.HasLowSupplies)
                    {
                        <div class="supply-alert-badge">
                            ⚠️ Supplies Low
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>

<!-- CARE PLANS MODAL -->
@if (_showCarePlanModal)
{
    <div class="modal-backdrop">
        <div class="modal-window">
            <div class="modal-header">
                <div>
                    <div class="eyebrow">Individual Child Care Routine</div>
                    <h2>Care Plan — @(_selectedChildStatus?.ChildName ?? "Child")</h2>
                </div>
                <button class="close-btn" @onclick="() => _showCarePlanModal = false">✕</button>
            </div>
            <div class="modal-body">
                @if (_currentPlan != null)
                {
                    <div class="care-plan-details">
                        <div class="plan-card">
                            <h4>Allergies &amp; Dietary Guidance</h4>
                            <p>@(_currentPlan.DietaryAllergiesSummary ?? "No allergies or specific food restrictions recorded.")</p>
                        </div>
                        <div class="plan-card">
                            <h4>Diaper &amp; Toileting Routine</h4>
                            <p>@(_currentPlan.DiaperRoutineGuidance ?? "Standard 2-hour diaper checks and routine assistance.")</p>
                            @if (!string.IsNullOrEmpty(_currentPlan.ToiletingSupportPlan))
                            {
                                <p><strong>Toileting Support:</strong> @_currentPlan.ToiletingSupportPlan</p>
                            }
                        </div>
                        <div class="plan-card">
                            <h4>Feeding &amp; Bottle Instructions</h4>
                            <p>@(_currentPlan.FeedingInstructions ?? "Self-feeds normal classroom meals. Offer water after outdoor play.")</p>
                            @if (!string.IsNullOrEmpty(_currentPlan.BottleScheduleGuidance))
                            {
                                <p><strong>Bottle Schedule:</strong> @_currentPlan.BottleScheduleGuidance</p>
                            }
                        </div>
                        <div class="plan-card">
                            <h4>Sleep &amp; Rest Routine</h4>
                            <p>@(_currentPlan.SleepRoutineGuidance ?? "Quiet rest from 12:30 PM to 2:00 PM.")</p>
                            @if (!string.IsNullOrEmpty(_currentPlan.ComfortCalmingPreferences))
                            {
                                <p><strong>Calming Strategies:</strong> @_currentPlan.ComfortCalmingPreferences</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p style="color: #6b7a70;">No customized care plan created yet. Default daycare room routine applies.</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="() => _showCarePlanModal = false">Close</button>
            </div>
        </div>
    </div>
}

<!-- CARE SUPPLIES MODAL -->
@if (_showSupplyModal)
{
    <div class="modal-backdrop">
        <div class="modal-window">
            <div class="modal-header">
                <div>
                    <div class="eyebrow">Personal Care Supplies</div>
                    <h2>Cubby Supplies — @(_selectedChildStatus?.ChildName ?? "Child")</h2>
                </div>
                <button class="close-btn" @onclick="() => _showSupplyModal = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="supplies-table-wrapper">
                    <table class="supplies-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Status</th>
                                <th>Cubby Note</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var supply in _childSupplies)
                            {
                                <tr>
                                    <td><strong>@supply.SupplyType</strong></td>
                                    <td>
                                        <span class="status-pill @supply.Status.ToLower()">@supply.Status</span>
                                    </td>
                                    <td>@(supply.ThresholdNote ?? "Standard stock in room")</td>
                                    <td>
                                        @if (supply.Status != "Low")
                                        {
                                            <button class="btn outline sm" @onclick="() => MarkSupplyLow(supply)">
                                                Mark Low
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn secondary sm" @onclick="() => MarkSupplyAdequate(supply)">
                                                Mark Restocked
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn secondary" @onclick="() => _showSupplyModal = false">Done</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Branch> _branches = new();
    private List<Classroom> _classrooms = new();
    private Guid _selectedBranchId = Guid.Empty;
    private Guid? _selectedClassroomId;
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);

    private List<ClassroomChildCareStatus> _classroomOverview = new();
    private Guid _selectedChildId = Guid.Empty;
    private ClassroomChildCareStatus? _selectedChildStatus;
    private List<ChildTimelineEntry> _childTimeline = new();

    private string _selectedActivity = CareEventTypes.DiaperChange;
    private string _selectedDetail = "Wet";
    private string _entryNote = string.Empty;
    private bool _parentVisible = true;
    private bool _isSubmitting = false;
    private string? _statusMessage;

    private int _totalRecordedEventsToday = 0;
    private List<ChildCareSupply> _lowSupplies = new();
    private List<ChildCareSupply> _childSupplies = new();
    private ChildCarePlan? _currentPlan;

    private bool _isBulkMode = false;
    private HashSet<Guid> _selectedChildIds = new();

    private bool _showCarePlanModal = false;
    private bool _showSupplyModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBranchesAndClassrooms();
        await RefreshClassroomData();
    }

    private async Task LoadBranchesAndClassrooms()
    {
        var orgs = (await OrganizationService.GetOrganizationsAsync()).ToList();
        var primaryOrg = (UserContext.OrganizationId.HasValue
            ? orgs.FirstOrDefault(o => o.Id == UserContext.OrganizationId.Value)
            : null) ?? orgs.FirstOrDefault();

        if (primaryOrg != null)
        {
            _branches = (await BranchService.GetBranchesAsync(primaryOrg.Id)).ToList();
        }
        else
        {
            _branches = new List<Branch>();
        }

        if (_branches.Count > 0 && _selectedBranchId == Guid.Empty)
        {
            _selectedBranchId = _branches[0].Id;
        }

        if (_selectedBranchId != Guid.Empty)
        {
            _classrooms = (await ClassroomService.GetClassroomsAsync(_selectedBranchId)).ToList();
            if (_classrooms.Count > 0 && !_selectedClassroomId.HasValue)
            {
                _selectedClassroomId = _classrooms[0].Id;
            }
        }
    }

    private async Task RefreshClassroomData()
    {
        if (_selectedBranchId == Guid.Empty) return;

        _classroomOverview = (await DailyCareService.GetClassroomOverviewAsync(
            _selectedBranchId,
            _selectedClassroomId,
            _selectedDate)).ToList();

        _lowSupplies = (await DailyCareService.GetLowSuppliesAsync(_selectedBranchId)).ToList();
        _totalRecordedEventsToday = _classroomOverview.Sum(c => c.TodayEventsCount);

        if (_selectedChildId == Guid.Empty && _classroomOverview.Count > 0)
        {
            _selectedChildId = _classroomOverview[0].ChildId;
        }

        await LoadSelectedChildDetails();
    }

    private async Task LoadSelectedChildDetails()
    {
        if (_selectedChildId == Guid.Empty)
        {
            _selectedChildStatus = null;
            _childTimeline = new();
            return;
        }

        _selectedChildStatus = _classroomOverview.FirstOrDefault(c => c.ChildId == _selectedChildId);
        _childTimeline = (await DailyCareService.GetChildCareTimelineAsync(_selectedChildId, _selectedDate)).ToList();
        _childSupplies = (await DailyCareService.GetChildSuppliesAsync(_selectedChildId)).ToList();
        _currentPlan = await DailyCareService.GetChildCarePlanAsync(_selectedChildId);
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var bId))
        {
            _selectedBranchId = bId;
            _classrooms = (await ClassroomService.GetClassroomsAsync(_selectedBranchId)).ToList();
            _selectedClassroomId = _classrooms.FirstOrDefault()?.Id;
            _selectedChildId = Guid.Empty;
            await RefreshClassroomData();
        }
    }

    private async Task OnClassroomChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedClassroomId = string.IsNullOrEmpty(val) ? null : Guid.Parse(val);
        _selectedChildId = Guid.Empty;
        await RefreshClassroomData();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _selectedDate = d;
            await RefreshClassroomData();
        }
    }

    private async Task OnSelectedChildChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var cId))
        {
            _selectedChildId = cId;
            await LoadSelectedChildDetails();
        }
    }

    private async Task SelectChild(Guid childId)
    {
        _selectedChildId = childId;
        await LoadSelectedChildDetails();
    }

    private void SelectActivity(string activity)
    {
        _selectedActivity = activity;
        var options = GetDetailsOptionsForActivity(activity);
        _selectedDetail = options.FirstOrDefault() ?? string.Empty;
    }

    private List<string> GetDetailsOptionsForActivity(string activity) => activity switch
    {
        CareEventTypes.DiaperChange => new() { "Wet", "Soiled", "Wet & Soiled", "Dry check" },
        CareEventTypes.Meal => new() { "Lunch (Ate most)", "Lunch (Ate all)", "Lunch (Ate some)", "Morning snack (All)", "Morning snack (Some)", "Afternoon snack", "Bottle (6 oz)", "Water intake" },
        CareEventTypes.SleepRest => new() { "Fell asleep", "Rested peacefully", "Had difficulty settling", "Woke naturally", "Awakened per routine" },
        CareEventTypes.Toileting => new() { "Successful toilet use", "Attempted toilet use", "Accident & change", "Assistance provided" },
        CareEventTypes.Hygiene => new() { "Handwashing routine", "Face & hand clean", "Clothing change", "Cleaned after accident" },
        CareEventTypes.Comfort => new() { "Happy & playful", "Calm and settled", "Needed comfort / hug", "Appeared tired", "Upset & comforted" },
        _ => new() { "Completed" }
    };

    private async Task SubmitQuickCareEntry()
    {
        if (_selectedChildId == Guid.Empty) return;

        _isSubmitting = true;
        try
        {
            var ev = new ChildCareEvent
            {
                ChildId = _selectedChildId,
                EventType = _selectedActivity,
                EventTime = DateTime.UtcNow,
                Notes = _entryNote,
                ParentVisible = _parentVisible
            };

            switch (_selectedActivity)
            {
                case CareEventTypes.DiaperChange:
                    ev.DiaperCondition = _selectedDetail.Replace(" & ", "And");
                    break;
                case CareEventTypes.Meal:
                    ev.MealType = _selectedDetail.Contains("Lunch") ? "Lunch" : (_selectedDetail.Contains("snack") ? "Snack" : "Feeding");
                    ev.AmountConsumed = _selectedDetail.Contains("all") ? "All" : (_selectedDetail.Contains("most") ? "Most" : "Some");
                    break;
                case CareEventTypes.SleepRest:
                    ev.RestStatus = _selectedDetail.Replace(" ", "");
                    break;
                case CareEventTypes.Toileting:
                    ev.ToiletingActivity = _selectedDetail.Contains("Successful") ? "Success" : (_selectedDetail.Contains("Attempted") ? "Attempt" : "Assistance");
                    break;
                case CareEventTypes.Hygiene:
                    ev.HygieneType = _selectedDetail.Replace(" ", "");
                    break;
                case CareEventTypes.Comfort:
                    ev.ComfortMood = _selectedDetail.Contains("Happy") ? "Happy" : (_selectedDetail.Contains("Calm") ? "Settled" : "NeededComfort");
                    break;
            }

            await DailyCareService.RecordCareEventAsync(ev);
            _statusMessage = $"Care event '{_selectedActivity}' recorded successfully for {_selectedChildStatus?.ChildName}!";
            _entryNote = string.Empty;

            await RefreshClassroomData();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task StartNapForChild()
    {
        if (_selectedChildId == Guid.Empty) return;
        await DailyCareService.StartNapAsync(_selectedChildId, _selectedClassroomId, "Rest session started by teacher.");
        _statusMessage = $"Nap session started for {_selectedChildStatus?.ChildName}.";
        await RefreshClassroomData();
    }

    private async Task WakeActiveChild()
    {
        if (_selectedChildId == Guid.Empty) return;
        var ended = await DailyCareService.WakeChildAsync(_selectedChildId, "WokeNaturally", "Woke naturally refreshed.");
        _statusMessage = $"Wake-up recorded. Duration: {ended?.DurationMinutes} minutes.";
        await RefreshClassroomData();
    }

    private async Task MarkSupplyLow(ChildCareSupply supply)
    {
        supply.Status = "Low";
        await DailyCareService.UpdateSupplyStatusAsync(supply);
        await RefreshClassroomData();
    }

    private async Task MarkSupplyAdequate(ChildCareSupply supply)
    {
        supply.Status = "Adequate";
        await DailyCareService.UpdateSupplyStatusAsync(supply);
        await RefreshClassroomData();
    }

    private void SetEntryMode(bool isBulk)
    {
        _isBulkMode = isBulk;
        if (_isBulkMode && _selectedChildIds.Count == 0)
        {
            // Default select all checked-in children
            SelectAllCheckedInChildren();
        }
    }

    private void ToggleChildSelection(Guid childId)
    {
        if (_selectedChildIds.Contains(childId))
            _selectedChildIds.Remove(childId);
        else
            _selectedChildIds.Add(childId);
    }

    private void SelectAllCheckedInChildren()
    {
        _selectedChildIds.Clear();
        foreach (var c in _classroomOverview.Where(c => c.IsCheckedIn))
        {
            _selectedChildIds.Add(c.ChildId);
        }
    }

    private void SelectAllChildren()
    {
        _selectedChildIds.Clear();
        foreach (var c in _classroomOverview)
        {
            _selectedChildIds.Add(c.ChildId);
        }
    }

    private void ClearSelectedChildren()
    {
        _selectedChildIds.Clear();
    }

    private async Task SubmitBulkCareEntry()
    {
        if (_selectedChildIds.Count == 0 || _isSubmitting) return;

        _isSubmitting = true;
        _statusMessage = null;

        try
        {
            var recorded = await DailyCareService.RecordBatchCareEventsAsync(
                _selectedChildIds,
                _selectedActivity,
                _selectedDetail,
                _entryNote,
                _parentVisible);

            _statusMessage = $"Bulk care event '{_selectedActivity}' ({_selectedDetail}) recorded successfully for {recorded} children!";
            _entryNote = string.Empty;

            await RefreshClassroomData();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error recording bulk care: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task StartBulkNap()
    {
        if (_selectedChildIds.Count == 0 || _isSubmitting) return;

        _isSubmitting = true;
        try
        {
            var count = await DailyCareService.StartBatchNapAsync(
                _selectedChildIds,
                _selectedClassroomId,
                "Classroom rest period started.");

            _statusMessage = $"Rest period started for {count} children.";
            await RefreshClassroomData();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error starting bulk rest: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task WakeBulkChildren()
    {
        if (_selectedChildIds.Count == 0 || _isSubmitting) return;

        _isSubmitting = true;
        try
        {
            var count = await DailyCareService.WakeBatchChildrenAsync(
                _selectedChildIds,
                "WokeNaturally",
                "Woke refreshed from group rest.");

            _statusMessage = $"Wake-up and duration recorded for {count} children.";
            await RefreshClassroomData();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error waking bulk children: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
