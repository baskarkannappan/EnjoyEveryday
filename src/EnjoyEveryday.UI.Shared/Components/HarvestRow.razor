@namespace EnjoyEveryday.UI.Shared.Components

<div class="harvest-row">
    <span>
        <strong>@Title</strong>
        <small>@Subtitle</small>
    </span>
    <span>@Uses</span>
    <span>@Response</span>
    <button class="text-button insight-button" @onclick="OnViewClick">View</button>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Uses { get; set; } = "";
    [Parameter] public string Response { get; set; } = "";
    [Parameter] public EventCallback OnViewClick { get; set; }
}
