@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="curation-modal-backdrop" @onclick="HandleClose">
        <div class="curation-modal" @onclick:stopPropagation="true">
            <div class="curation-modal-header">
                <div>
                    <div class="curation-modal-eyebrow">COMMUNITY &amp; CURATION</div>
                    <h3 class="curation-modal-title">Submit to Platform Library</h3>
                </div>
                <button class="curation-modal-close" @onclick="HandleClose" aria-label="Close dialog">&times;</button>
            </div>

            <div class="curation-modal-body">
                <div class="curation-preview-card">
                    <div class="curation-preview-title">@ExperienceTitle</div>
                    @if (!string.IsNullOrWhiteSpace(ExperienceDescription))
                    {
                        <div class="curation-preview-desc">@ExperienceDescription</div>
                    }
                </div>

                <div class="curation-notice">
                    <p class="curation-terms-text">
                        By submitting this activity for consideration, you grant EnjoyEveryday a commercial content license to review, sanitize, reproduce, and distribute this activity in the Platform Marketplace.
                    </p>
                    <div class="curation-privacy-pill">
                        🔒 <strong>Privacy Guarantee</strong>: Your organization's children, private observations, photos, and family records are never transferred. Only instructional and developmental content is curated.
                    </div>
                </div>

                <div class="curation-form-group">
                    <label class="curation-label">Content License Terms</label>
                    <select class="curation-select" @bind="SelectedLicenseType">
                        <option value="CommercialRoyalty">Standard Commercial Distribution &amp; Royalty</option>
                        <option value="PlatformExclusive">Platform Curated Exclusive</option>
                        <option value="OpenEducation">Open Early Childhood License</option>
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <div class="curation-status-badge">
                        @StatusMessage
                    </div>
                }
            </div>

            <div class="curation-modal-footer">
                <button class="btn secondary" @onclick="HandleClose">Cancel</button>
                <button class="btn primary" @onclick="HandleConfirm">Grant License &amp; Submit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? ExperienceTitle { get; set; }
    [Parameter] public string? ExperienceDescription { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnConfirm { get; set; }

    private string SelectedLicenseType { get; set; } = "CommercialRoyalty";

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync(SelectedLicenseType);
    }
}
