<div class="rhythm-row">
    <div class="rhythm-icon">@Icon</div>
    <div class="rhythm-info">
        <div class="rhythm-name">@Name</div>
        <div class="rhythm-count">@Count experiences</div>
    </div>
    <div class="rhythm-number" style="color: @NumberColor">@Percentage%</div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Count { get; set; }
    [Parameter] public int Percentage { get; set; }
    [Parameter] public string NumberColor { get; set; } = "#365844";
}
