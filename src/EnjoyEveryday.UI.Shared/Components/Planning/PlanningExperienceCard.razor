<div class="experience @Type.ToLower()" @onclick="OnClick">
    <div class="exp-top">
        <div class="exp-title">
            @Title
        </div>
        <div style="display: flex; gap: 4px; align-items: center;">
            <span class="source @Type.ToLower()">
                @Type
            </span>
            @if (OnCancel.HasDelegate)
            {
                <button @onclick="CancelClicked" @onclick:stopPropagation="true" style="background: none; border: none; cursor: pointer; color: #a0aab2; font-size: 16px; padding: 0 4px;" title="Cancel Plan">&times;</button>
            }
        </div>
    </div>
    
    @if (Tags != null && Tags.Any())
    {
        <div class="exp-meta">
            @foreach (var tag in Tags)
            {
                <span class="meta">@tag</span>
            }
        </div>
    }
    
    @if (!string.IsNullOrEmpty(Status))
    {
        <div class="exp-status">
            @Status
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Type { get; set; } = "Teacher"; // Management, Teacher, AI, Free
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task CancelClicked(MouseEventArgs e)
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
