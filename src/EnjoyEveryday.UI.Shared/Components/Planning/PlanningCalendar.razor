<section class="calendar-card">
    <div class="calendar-head">
        <div class="week-label">
            @WeekLabel
        </div>
        @foreach (var day in Days)
        {
            <div class="day-head">
                <div class="day-name">@day.Name.ToUpper()</div>
                <div class="day-date">@day.DateString</div>
            </div>
        }
    </div>

    <div class="calendar-body">
        <div class="time-cell">Morning</div>
        @foreach (var day in Days)
        {
            <div class="day-cell">
                @if (MorningTemplate != null)
                {
                    @MorningTemplate(day)
                }
            </div>
        }
        
        <div class="time-cell">Mid-Day</div>
        @foreach (var day in Days)
        {
            <div class="day-cell">
                @if (MidDayTemplate != null)
                {
                    @MidDayTemplate(day)
                }
            </div>
        }

        <div class="time-cell">Afternoon</div>
        @foreach (var day in Days)
        {
            <div class="day-cell">
                @if (AfternoonTemplate != null)
                {
                    @AfternoonTemplate(day)
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public string WeekLabel { get; set; } = "RHYTHM";
    [Parameter] public List<CalendarDay> Days { get; set; } = new();
    
    [Parameter] public RenderFragment<CalendarDay>? MorningTemplate { get; set; }
    [Parameter] public RenderFragment<CalendarDay>? MidDayTemplate { get; set; }
    [Parameter] public RenderFragment<CalendarDay>? AfternoonTemplate { get; set; }

    public class CalendarDay
    {
        public string Name { get; set; } = "";
        public string DateString { get; set; } = "";
        public DateTime Date { get; set; }
    }
}
