@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject ExperienceService ExperienceService
@inject ClassroomService ClassroomService
@inject ITeacherService TeacherService
@inject PlannerService PlannerService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject IEndOfDayService EndOfDayService

@if (IsOpen)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20, 30, 25, 0.45); backdrop-filter: blur(2px); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 12px; box-sizing: border-box;">
        <div style="background: white; border-radius: 0px; width: 480px; max-width: 95vw; max-height: 90vh; overflow-y: auto; padding: 12px 14px; box-shadow: 0 12px 35px rgba(25, 40, 32, 0.18); border: 1px solid #e1e6e0; box-sizing: border-box;">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; padding-bottom: 10px; border-bottom: 1px solid #edf0ec;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 1.15rem;">🌱</span>
                    <h2 style="margin: 0; font-size: 1.15rem; font-weight: 750; color: #26332d; letter-spacing: -0.2px;">Plan Experience</h2>
                </div>
                <button @onclick="Close" style="background: transparent; border: none; font-size: 1.4rem; cursor: pointer; color: #7c877f; line-height: 1; padding: 2px 6px; border-radius: 0px;" aria-label="Close dialog">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="background: #fff0f0; color: #d32f2f; padding: 8px 12px; border-radius: 0px; margin-bottom: 10px; border: 1px solid #ffcdd2; font-size: 12px; line-height: 1.4;">
                    @_errorMessage
                </div>
            }

            @if (!_isReadOnly && IsDateClosedForPlanning(_date, out var closedDateWarning))
            {
                <div style="background: #fff5f5; color: #9b2c2c; padding: 8px 12px; border-radius: 0px; margin-bottom: 10px; border: 1px solid #fed7d7; font-size: 12px; display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 14px;">🌙</span>
                    <span><strong>Daycare Closed:</strong> @closedDateWarning</span>
                </div>
            }

            @if (_isReadOnly)
            {
                <div style="background: #f4eee1; color: #5a4b2a; padding: 8px 12px; border-radius: 0px; margin-bottom: 10px; border: 1px solid #e5dac4; font-size: 12px; display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 14px;">🔒</span>
                    <span><strong>Read-Only Mode:</strong> Historical experiences cannot be modified.</span>
                </div>
            }

            <div style="display: flex; flex-direction: column; gap: 6px;">
                
                <div>
                    <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Experience</label>
                    <select @bind="_experienceId" disabled="@_isReadOnly" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;">
                        <option value="">Select an Experience...</option>
                        @foreach (var exp in _experiences)
                        {
                            <option value="@exp.Id">@exp.Title</option>
                        }
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                    <div>
                        <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Branch</label>
                        <select @bind="BranchId" disabled="@_isReadOnly" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;">
                            @if (!_branches.Any())
                            {
                                <option value="">Default Branch</option>
                            }
                            else
                            {
                                <option value="">Select Branch...</option>
                                @foreach (var b in _branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Classroom</label>
                        <select value="@(_classroomId?.ToString() ?? "")" @onchange="OnClassroomChangedAsync" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;" disabled="@(_isReadOnly || (_branchId == null && _branches.Any()))">
                            <option value="">Select Classroom...</option>
                            @foreach (var c in _classrooms.Where(c => _branchId == null || c.BranchId == _branchId))
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_conflictWarning))
                {
                    <div style="background: #fff5f5; color: #9b2c2c; padding: 8px 12px; border-radius: 0px; border: 1px solid #fed7d7; font-size: 12px; display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 14px;">⚠️</span>
                        <span><strong>Time Overlap Conflict:</strong> @_conflictWarning</span>
                    </div>
                }

                @if (_roomSchedules.Any())
                {
                    <div style="background: #f8f9f5; border: 1px solid #e1e6e0; border-radius: 0px; padding: 8px 12px; font-size: 11.5px; color: #47534c;">
                        <div style="font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; color: #26332d;">
                            <span>📅</span> <span>Planned today in @GetClassroomName():</span>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            @foreach (var s in _roomSchedules)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; background: white; padding: 4px 8px; border-radius: 0px; border: 1px solid #e8ede8;">
                                    <span><strong>@s.TimeOfDay</strong> &middot; @(GetExperienceTitle(s.ExperienceId))</span>
                                    <span style="color: #6c7870; font-size: 11px; font-weight: 600;">@(FormatTimeRange(s.PlannedStartTime, s.PlannedEndTime))</span>
                                </div>
                            }
                        </div>
                        <div style="margin-top: 6px; font-size: 10.5px; color: #31523c; font-weight: 600; display: flex; align-items: center; gap: 4px;">
                            <span>✓</span> <span>Additional non-overlapping slots (8:00 AM – 7:00 PM) are open.</span>
                        </div>
                    </div>
                }

                <div>
                    <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Primary Teacher</label>
                    <select @bind="_teacherId" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;" disabled="@(_isReadOnly || !_classroomId.HasValue)">
                        <option value="">Select a Teacher...</option>
                        @foreach (var t in GetFilteredTeachers())
                        {
                            <option value="@t.Id">@t.FullName</option>
                        }
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                    <div>
                        <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Date</label>
                        <input type="date" value="@_date.ToString("yyyy-MM-dd")" @onchange="OnDateChangedAsync" disabled="@_isReadOnly" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;" />
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Rhythm / Slot</label>
                        <select @bind="_timeOfDay" disabled="@_isReadOnly" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;">
                            <option value="Morning">Morning (8:00 AM - 11:30 AM)</option>
                            <option value="Mid-Day">Mid-Day (11:30 AM - 2:00 PM)</option>
                            <option value="Afternoon">Afternoon (2:00 PM - 5:00 PM)</option>
                            <option value="Evening">Evening (5:00 PM - 7:00 PM)</option>
                        </select>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                    <div>
                        <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Start Time (8am - 7pm)</label>
                        <input type="time" value="@(_startTime?.ToString("HH:mm"))" @onchange="OnStartTimeChanged" min="08:00" max="19:00" disabled="@_isReadOnly" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;" />
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">End Time (Closing 7pm)</label>
                        <input type="time" value="@(_endTime?.ToString("HH:mm"))" @onchange="OnEndTimeChanged" min="08:00" max="19:00" disabled="@_isReadOnly" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; box-sizing: border-box;" />
                    </div>
                </div>

                <div>
                    <label style="display: block; margin-bottom: 3px; font-weight: 700; color: #47534c; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.4px;">Preparation Notes</label>
                    <textarea @bind="_notes" disabled="@_isReadOnly" rows="2" style="width: 100%; padding: 7px 10px; border: 1px solid #d8dfd6; border-radius: 0px; font-size: 0.85rem; background: #fafbf9; color: #26332d; resize: vertical; box-sizing: border-box;"></textarea>
                </div>

            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #edf0ec; align-items: center; flex-wrap: wrap;">
                @if (ScheduleId.HasValue && !_isReadOnly)
                {
                    var isClosed = IsDateClosedForPlanning(_date, out _);
                    <div style="display: flex; gap: 6px; margin-right: auto; flex-wrap: wrap;">
                        <button type="button" class="secondary" @onclick="CompletePlan" disabled="@isClosed" style="padding: 7px 12px; border: 1px solid #c8dacd; background: #eaf2ec; color: #31523c; border-radius: 0px; cursor: @(isClosed ? "not-allowed" : "pointer"); opacity: @(isClosed ? "0.5" : "1"); font-weight: 700; font-size: 12px;">✓ Completed</button>
                        <button type="button" class="secondary" @onclick="CancelPlan" style="padding: 7px 10px; border: 1px solid #fed7d7; background: #fff5f5; color: #9b2c2c; border-radius: 0px; cursor: pointer; font-weight: 600; font-size: 12px;">Cancel</button>
                        <button type="button" class="secondary" @onclick="Delete" style="padding: 7px 10px; border: 1px solid #e1e6e0; background: white; color: #7c877f; border-radius: 0px; cursor: pointer; font-weight: 600; font-size: 12px;">Delete</button>
                    </div>
                }
                <button type="button" class="secondary" @onclick="Close" style="padding: 7px 14px; border: 1px solid #e1e6e0; background: white; border-radius: 0px; cursor: pointer; font-weight: 600; color: #47534c; font-size: 12.5px;">Close</button>
                @if (!_isReadOnly)
                {
                    var isClosedForSave = IsDateClosedForPlanning(_date, out _);
                    <button type="button" class="primary" @onclick="Save" disabled="@(_isSaving || isClosedForSave || !string.IsNullOrEmpty(_conflictWarning))" style="padding: 7px 16px; border: none; background: #456a55; color: white; border-radius: 0px; cursor: @(isClosedForSave ? "not-allowed" : "pointer"); opacity: @(isClosedForSave ? "0.5" : "1"); font-weight: 650; font-size: 12.5px;">
                        @(_isSaving ? "Saving..." : (ScheduleId.HasValue ? "Update Plan" : "Confirm Plan"))
                    </button>
                }
            </div>
            
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid? DefaultClassroomId { get; set; }
    [Parameter] public DateOnly? DefaultDate { get; set; }
    [Parameter] public Guid? ScheduleId { get; set; }
    [Parameter] public EventCallback<Guid> OnPlanCreated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<Experience> _experiences = new();
    private List<Classroom> _classrooms = new();
    private List<Teacher> _teachers = new();
    private List<Branch> _branches = new();

    private Guid? _experienceId;
    private Guid? _branchId;
    private Guid? _classroomId;
    private Guid? ClassroomId
    {
        get => _classroomId;
        set
        {
            if (_classroomId != value)
            {
                _classroomId = value;
                _teacherId = null; // Reset teacher when classroom changes
            }
        }
    }

    private Guid? _teacherId;
    private DateTime _date = DateTime.Today;
    private string _timeOfDay = "Morning";
    private DateTime? _startTime;
    private DateTime? _endTime;
    private string _notes = "";

    private string _errorMessage = "";
    private bool _isSaving = false;
    private bool _isReadOnly = false;

    private Guid? BranchId
    {
        get => _branchId;
        set
        {
            if (_branchId != value)
            {
                _branchId = value;
                ClassroomId = null; // Reset classroom when branch changes
            }
        }
    }

    private IEnumerable<Teacher> GetFilteredTeachers()
    {
        if (!_classroomId.HasValue) return Array.Empty<Teacher>();

        return _teachers.Where(t =>
        {
            if (string.IsNullOrWhiteSpace(t.DraftData)) return false;
            try
            {
                var doc = System.Text.Json.JsonDocument.Parse(t.DraftData);
                if (doc.RootElement.TryGetProperty("AssignedClassroom", out var ac) || 
                    doc.RootElement.TryGetProperty("assignedClassroom", out ac))
                {
                    var acStr = ac.GetString();
                    return acStr != null && acStr.Equals(_classroomId.Value.ToString(), StringComparison.OrdinalIgnoreCase);
                }
            }
            catch { }
            return false;
        });
    }

    protected override async Task OnInitializedAsync()
    {
        _experiences = (await ExperienceService.GetExperiencesAsync()).ToList();
        _classrooms = (await ClassroomService.GetAllClassroomsAsync()).ToList();
        _teachers = (await TeacherService.GetAllTeachersAsync(TenantContext.TenantId)).ToList();
        
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var orgId = orgs.FirstOrDefault()?.Id;
        if (orgId.HasValue) 
        {
            _branches = (await BranchService.GetBranchesAsync(orgId.Value)).ToList();
        }
    }

    private List<ExperienceSchedule> _roomSchedules = new();
    private string _conflictWarning = "";

    private string GetClassroomName()
    {
        if (!_classroomId.HasValue) return "Classroom";
        return _classrooms.FirstOrDefault(c => c.Id == _classroomId.Value)?.Name ?? "Classroom";
    }

    private string GetExperienceTitle(Guid experienceId)
    {
        return _experiences.FirstOrDefault(e => e.Id == experienceId)?.Title ?? "Experience";
    }

    private string FormatTimeRange(TimeSpan? start, TimeSpan? end)
    {
        if (start.HasValue && end.HasValue)
        {
            return $"{DateTime.Today.Add(start.Value):hh:mm tt} - {DateTime.Today.Add(end.Value):hh:mm tt}";
        }
        return "Time not set";
    }

    private bool IsDateClosedForPlanning(DateTime dt, out string reason)
    {
        return PlannerService.IsDaycareClosedForPlanning(DateOnly.FromDateTime(dt), out reason);
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (TimeSpan.TryParse(val, out var ts))
        {
            _startTime = DateTime.Today.Add(ts);
            if (!_endTime.HasValue || _endTime <= _startTime)
            {
                _endTime = _startTime.Value.AddMinutes(30);
            }

            var hour = ts.Hours;
            if (hour < 11 || (hour == 11 && ts.Minutes < 30))
            {
                _timeOfDay = "Morning";
            }
            else if (hour < 14)
            {
                _timeOfDay = "Mid-Day";
            }
            else if (hour < 17)
            {
                _timeOfDay = "Afternoon";
            }
            else
            {
                _timeOfDay = "Evening";
            }
        }
        else
        {
            _startTime = null;
        }
        ValidateTimeOverlap();
    }

    private void OnEndTimeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (TimeSpan.TryParse(val, out var ts))
        {
            _endTime = DateTime.Today.Add(ts);
        }
        else
        {
            _endTime = null;
        }
        ValidateTimeOverlap();
    }

    private void ValidateTimeOverlap()
    {
        _conflictWarning = "";
        if (!_startTime.HasValue || !_endTime.HasValue) return;

        var startTs = _startTime.Value.TimeOfDay;
        var endTs = _endTime.Value.TimeOfDay;

        if (startTs >= endTs)
        {
            _conflictWarning = "Start time must be before end time.";
            return;
        }

        foreach (var existing in _roomSchedules)
        {
            if (ScheduleId.HasValue && existing.Id == ScheduleId.Value) continue;
            if (!existing.PlannedStartTime.HasValue || !existing.PlannedEndTime.HasValue) continue;

            if (startTs < existing.PlannedEndTime.Value && endTs > existing.PlannedStartTime.Value)
            {
                var exp = _experiences.FirstOrDefault(e => e.Id == existing.ExperienceId);
                var expTitle = exp?.Title ?? "Existing session";
                var timeStr = $"{DateTime.Today.Add(existing.PlannedStartTime.Value):hh:mm tt} - {DateTime.Today.Add(existing.PlannedEndTime.Value):hh:mm tt}";
                _conflictWarning = $"Time overlaps with '{expTitle}' ({timeStr}). Please choose an open time slot.";
                return;
            }
        }
    }

    private async Task OnClassroomChangedAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var cId))
        {
            _classroomId = cId;
        }
        else
        {
            _classroomId = null;
        }
        _teacherId = null;
        await CheckClassroomSlotAvailabilityAsync();
    }

    private async Task OnDateChangedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _date = dt;
            await CheckClassroomSlotAvailabilityAsync();
        }
    }

    private async Task CheckClassroomSlotAvailabilityAsync()
    {
        _roomSchedules.Clear();
        _conflictWarning = "";

        if (!_classroomId.HasValue) return;

        try
        {
            var schedules = await PlannerService.GetSchedulesForDateAsync(DateOnly.FromDateTime(_date));
            _roomSchedules = schedules.Where(s =>
                s.ClassroomId == _classroomId.Value &&
                (!ScheduleId.HasValue || s.Id != ScheduleId.Value) &&
                !string.Equals(s.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();

            ValidateTimeOverlap();
        }
        catch
        {
        }
    }

    public async Task Open()
    {
        _errorMessage = "";
        
        if (ScheduleId.HasValue)
        {
            var s = await PlannerService.GetScheduleAsync(ScheduleId.Value);
            if (s != null)
            {
                _experienceId = s.ExperienceId;
                _classroomId = s.ClassroomId;
                var cls = _classrooms.FirstOrDefault(c => c.Id == _classroomId);
                _branchId = cls?.BranchId;
                _teacherId = s.PrimaryTeacherId;
                _date = s.ScheduledDate.ToDateTime(TimeOnly.MinValue);
                _timeOfDay = s.TimeOfDay;
                _startTime = s.PlannedStartTime.HasValue ? DateTime.Today.Add(s.PlannedStartTime.Value) : null;
                _endTime = s.PlannedEndTime.HasValue ? DateTime.Today.Add(s.PlannedEndTime.Value) : null;
                _notes = s.PreparationNotes ?? "";
                
                _isReadOnly = s.Status == "Completed" || s.ScheduledDate < DateOnly.FromDateTime(DateTime.Today);
            }
        }
        else
        {
            _experienceId = null;
            _classroomId = DefaultClassroomId;
            var cls = _classrooms.FirstOrDefault(c => c.Id == _classroomId);
            _branchId = cls?.BranchId ?? _branches.FirstOrDefault()?.Id;
            _teacherId = null;
            _date = DefaultDate.HasValue ? DefaultDate.Value.ToDateTime(TimeOnly.MinValue) : DateTime.Today;
            _timeOfDay = "Morning";
            _startTime = null;
            _endTime = null;
            _notes = "";
            _isReadOnly = false;
        }

        await CheckClassroomSlotAvailabilityAsync();
        
        IsOpen = true;
        StateHasChanged();
    }

    private bool _wasOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            await Open();
        }
        _wasOpen = IsOpen;
    }

    private async Task Close()
    {
        IsOpen = false;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task Save()
    {
        _errorMessage = "";

        if (!_experienceId.HasValue)
        {
            _errorMessage = "Please select an Experience.";
            return;
        }
        if (!_classroomId.HasValue)
        {
            _errorMessage = "Please select a Classroom.";
            return;
        }

        if (_date.Date < DateTime.Today)
        {
            _errorMessage = "Cannot schedule or modify an experience for a past date.";
            return;
        }

        if (IsDateClosedForPlanning(_date, out var closedPlanReason))
        {
            _errorMessage = closedPlanReason;
            return;
        }

        ValidateTimeOverlap();
        if (!string.IsNullOrEmpty(_conflictWarning))
        {
            _errorMessage = _conflictWarning;
            return;
        }

        _isSaving = true;

        try
        {
            TimeSpan? startTs = _startTime.HasValue ? _startTime.Value.TimeOfDay : null;
            TimeSpan? endTs = _endTime.HasValue ? _endTime.Value.TimeOfDay : null;

            var minOpen = new TimeSpan(8, 0, 0);
            var maxClose = new TimeSpan(19, 0, 0);
            
            if (startTs.HasValue && (startTs.Value < minOpen || startTs.Value >= maxClose)) {
                _errorMessage = "Start time must be within daycare operating hours (8:00 AM to 7:00 PM).";
                _isSaving = false;
                return;
            }
            if (endTs.HasValue && (endTs.Value <= minOpen || endTs.Value > maxClose)) {
                _errorMessage = "End time cannot be after daycare closing time (7:00 PM).";
                _isSaving = false;
                return;
            }
            if (startTs.HasValue && endTs.HasValue && startTs.Value >= endTs.Value) {
                _errorMessage = "Start time must be before end time.";
                _isSaving = false;
                return;
            }
            if (startTs.HasValue && endTs.HasValue) {
                var duration = (endTs.Value - startTs.Value).TotalMinutes;
                if (duration < 15) {
                    _errorMessage = "Experience duration must be at least 15 minutes.";
                    _isSaving = false;
                    return;
                }
                if (duration > 180) {
                    _errorMessage = "Experience duration cannot exceed 3 hours. Please plan a reasonable activity duration.";
                    _isSaving = false;
                    return;
                }
            }
            if (EndOfDayService?.IsBypassedForTesting() != true && _date.Date == DateTime.Today && endTs.HasValue && endTs.Value <= DateTime.Now.TimeOfDay) {
                _errorMessage = "Cannot plan an experience for a time window that has already passed today.";
                _isSaving = false;
                return;
            }

            if (ScheduleId.HasValue)
            {
                var s = await PlannerService.GetScheduleAsync(ScheduleId.Value);
                if (s != null)
                {
                    s.ExperienceId = _experienceId.Value;
                    s.ClassroomId = _classroomId.Value;
                    s.ScheduledDate = DateOnly.FromDateTime(_date);
                    s.TimeOfDay = _timeOfDay;
                    s.PrimaryTeacherId = _teacherId;
                    s.PlannedStartTime = startTs;
                    s.PlannedEndTime = endTs;
                    s.PreparationNotes = _notes;
                    await PlannerService.UpdateScheduleAsync(s);
                }
            }
            else
            {
                await PlannerService.ScheduleExperienceAsync(
                    _experienceId.Value, 
                    _classroomId.Value, 
                    DateOnly.FromDateTime(_date), 
                    _timeOfDay, 
                    _teacherId, 
                    startTs, 
                    endTs, 
                    _notes);
            }
            
            await Close();
            if (OnPlanCreated.HasDelegate)
            {
                await OnPlanCreated.InvokeAsync(_classroomId.Value);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CompletePlan()
    {
        if (ScheduleId.HasValue)
        {
            if (IsDateClosedForPlanning(_date, out var closedReason))
            {
                _errorMessage = closedReason;
                return;
            }
            try
            {
                await PlannerService.CompleteScheduleAsync(ScheduleId.Value, _notes);
                await Close();
                if (OnPlanCreated.HasDelegate)
                {
                    await OnPlanCreated.InvokeAsync(_classroomId ?? Guid.Empty);
                }
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
            }
        }
    }

    private async Task CancelPlan()
    {
        if (ScheduleId.HasValue)
        {
            try
            {
                await PlannerService.CancelScheduleAsync(ScheduleId.Value);
                await Close();
                if (OnPlanCreated.HasDelegate)
                {
                    await OnPlanCreated.InvokeAsync(_classroomId ?? Guid.Empty);
                }
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
            }
        }
    }

    private async Task Delete()
    {
        if (ScheduleId.HasValue)
        {
            try
            {
                await PlannerService.DeleteScheduleAsync(ScheduleId.Value);
                await Close();
                if (OnPlanCreated.HasDelegate)
                {
                    await OnPlanCreated.InvokeAsync(_classroomId ?? Guid.Empty);
                }
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
            }
        }
    }
}
