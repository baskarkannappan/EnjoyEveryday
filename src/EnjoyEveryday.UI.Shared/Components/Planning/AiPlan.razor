<div class="ai-box">
    <div class="ai-label">@Label</div>
    <div class="ai-title">@Title</div>
    <div class="ai-text">@Text</div>
    
    @if (ListItems != null && ListItems.Any())
    {
        <div class="ai-list">
            @foreach (var item in ListItems)
            {
                <div class="ai-item">@item</div>
            }
        </div>
    }
    
    @if (!string.IsNullOrEmpty(ButtonText))
    {
        <button class="ai-button" @onclick="OnButtonClick">@ButtonText</button>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "AI PLAN";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public List<string> ListItems { get; set; } = new();
    [Parameter] public string ButtonText { get; set; } = "";
    [Parameter] public EventCallback OnButtonClick { get; set; }
}
