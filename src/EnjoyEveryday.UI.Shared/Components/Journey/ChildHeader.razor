<div class="child-header">
    <div class="child-identity">
        <div class="child-avatar">
            @AvatarInitials
        </div>
        <div>
            <div class="child-name">@Name</div>
            <div class="child-meta">
                <span>Age @AgeString</span>
                <span>@ClassroomName</span>
            </div>
        </div>
    </div>
    <div class="header-actions">
        <button class="secondary-btn">Download PDF</button>
        <button class="primary-btn">Log Moment</button>
    </div>
</div>

@code {
    [Parameter] public string AvatarInitials { get; set; } = "A";
    [Parameter] public string Name { get; set; } = "Child Name";
    [Parameter] public string AgeString { get; set; } = "3 Years";
    [Parameter] public string ClassroomName { get; set; } = "Classroom";
}
