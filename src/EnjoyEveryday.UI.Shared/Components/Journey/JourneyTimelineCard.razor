<div class="timeline-item">
    <div class="timeline-dot"></div>
    <div class="timeline-date">@DateString</div>
    <div class="timeline-card">
        <div class="timeline-card-top">
            <div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                    <span class="experience-type @TypeCssClass">@Type</span>
                    @if (IsParentVisible.HasValue)
                    {
                        @if (IsParentVisible.Value)
                        {
                            <span style="font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: #eaf2ec; color: #365844; border: 1px solid #c8dacd;">
                                <i class="bi bi-eye"></i> Parent Visible
                            </span>
                        }
                        else
                        {
                            <span style="font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: #f4eee1; color: #735a29; border: 1px solid #e5d8be;">
                                <i class="bi bi-lock"></i> Internal Note
                            </span>
                        }
                    }
                </div>
                <div class="timeline-title">@Title</div>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                @if (OnEdit.HasDelegate)
                {
                    <button @onclick="async () => await OnEdit.InvokeAsync()" style="background: none; border: none; cursor: pointer; color: #557660; font-size: 12px; font-weight: 600;">Edit</button>
                }
                @if (OnDelete.HasDelegate)
                {
                    <button @onclick="async () => await OnDelete.InvokeAsync()" style="background: none; border: none; cursor: pointer; color: #a0aaa4; font-size: 12px; font-weight: 600;">Delete</button>
                }
                @if (!string.IsNullOrEmpty(Time))
                {
                    <span style="font-size: 10px; color: #a0aaa4; margin-left: 4px;">@Time</span>
                }
            </div>
        </div>
        
        <div class="timeline-description">
            @Description
        </div>
        
        @if (!string.IsNullOrEmpty(Quote))
        {
            <div class="quote">"@Quote"</div>
        }

        @if (!string.IsNullOrEmpty(TeacherReflection))
        {
            <div style="margin-top: 10px; padding: 10px 14px; background: #f9fbf9; border-left: 3px solid #52745e; border-radius: 0 8px 8px 0; font-size: 13px; color: #405047;">
                <strong style="color: #26332d; font-size: 11px; text-transform: uppercase; display: block; margin-bottom: 2px;">Teacher Reflection</strong>
                @TeacherReflection
            </div>
        }
        
        @if (Photos != null && Photos.Any())
        {
            @if (IsMediaBlockedByConsent)
            {
                <div style="margin-top: 12px; margin-bottom: 12px; padding: 12px 16px; background: #fff8ef; border: 1px dashed #eec98f; border-radius: 10px; display: flex; align-items: center; gap: 12px;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background: #fce8cc; display: flex; align-items: center; justify-content: center; color: #a06412; font-size: 16px;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <div style="font-size: 12px; font-weight: 700; color: #8a5307;">Media Restricted by Consent Preference</div>
                        <div style="font-size: 11px; color: #9c6c2e;">Photo is masked for parent view because photo release consent is not active.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="timeline-photos" style="display: flex; gap: 8px; margin-top: 12px; margin-bottom: 12px;">
                    @foreach (var photoUrl in Photos.Take(2))
                    {
                        <img src="@photoUrl" style="max-width: 200px; max-height: 150px; border-radius: 8px; object-fit: cover;" alt="Journey Photo" />
                    }
                </div>
            }
        }
        
        @if (Tags != null && Tags.Any())
        {
            <div class="timeline-tags">
                @foreach (var tag in Tags)
                {
                    <div class="tag">@tag</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string DateString { get; set; } = "";
    [Parameter] public string Type { get; set; } = "Discovery";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Time { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Quote { get; set; } = "";
    [Parameter] public string? TeacherReflection { get; set; }
    [Parameter] public string? TeacherName { get; set; }
    [Parameter] public bool? IsParentVisible { get; set; }
    [Parameter] public bool IsMediaBlockedByConsent { get; set; }
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public List<string> Photos { get; set; } = new();
    
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    public string TypeCssClass => Type.ToLower();
}
