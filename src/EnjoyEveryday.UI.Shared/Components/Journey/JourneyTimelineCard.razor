<div class="timeline-item">
    <div class="timeline-dot"></div>
    <div class="timeline-date">@DateString</div>
    <div class="timeline-card">
        <div class="timeline-card-top">
            <div>
                <span class="experience-type @TypeCssClass">@Type</span>
                <div class="timeline-title">@Title</div>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                @if (OnEdit.HasDelegate)
                {
                    <button @onclick="async () => await OnEdit.InvokeAsync()" style="background: none; border: none; cursor: pointer; color: #557660; font-size: 12px; font-weight: 600;">Edit</button>
                }
                @if (OnDelete.HasDelegate)
                {
                    <button @onclick="async () => await OnDelete.InvokeAsync()" style="background: none; border: none; cursor: pointer; color: #a0aaa4; font-size: 12px; font-weight: 600;">Delete</button>
                }
                @if (!string.IsNullOrEmpty(Time))
                {
                    <span style="font-size: 10px; color: #a0aaa4; margin-left: 4px;">@Time</span>
                }
            </div>
        </div>
        
        <div class="timeline-description">
            @Description
        </div>
        
        @if (!string.IsNullOrEmpty(Quote))
        {
            <div class="quote">"@Quote"</div>
        }
        
        @if (Tags != null && Tags.Any())
        {
            <div class="timeline-tags">
                @foreach (var tag in Tags)
                {
                    <div class="tag">@tag</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string DateString { get; set; } = "";
    [Parameter] public string Type { get; set; } = "Discovery";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Time { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Quote { get; set; } = "";
    [Parameter] public List<string> Tags { get; set; } = new();
    
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    public string TypeCssClass => Type.ToLower();
}
