<div class="card ai-card">
    <div class="ai-heading">
        <div class="ai-icon">@Icon</div>
        <div>
            <strong>@Title</strong>
            <small>@Subtitle</small>
        </div>
    </div>
    <div class="ai-text">
        @Text
    </div>
    <div class="ai-suggestion">
        @Suggestion
    </div>
    <button class="ai-button">@ButtonText</button>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "🧠";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "AI Analysis";
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Suggestion { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "Create this experience";
}
