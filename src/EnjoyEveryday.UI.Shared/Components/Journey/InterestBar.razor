<div class="interest">
    <div class="interest-top">
        <span>@Name</span>
        <span>@Value%</span>
    </div>
    <div class="interest-bar">
        <div class="interest-fill" style="width: @Value%;"></div>
    </div>
    @if (!string.IsNullOrEmpty(Note))
    {
        <div class="interest-note">@Note</div>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Value { get; set; } = 0;
    [Parameter] public string Note { get; set; } = "";
}
