@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

<div class="benchmark-table-card">
    <div class="table-header">
        <div>
            <h3 class="table-title">Cross-Branch Benchmarking Matrix</h3>
            <p class="table-subtitle">Direct comparative performance against organizational operational standards.</p>
        </div>
    </div>

    <div class="table-scroll-wrapper">
        <table class="bench-table">
            <thead>
                <tr>
                    <th>Branch Campus</th>
                    <th>Classrooms</th>
                    <th>Capacity / Enrolled</th>
                    <th>Occupancy</th>
                    <th>Attendance</th>
                    <th>Ratio Compliance</th>
                    <th>Planning</th>
                    <th>Collection Rate</th>
                    <th>Health Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sc in Scorecards)
                {
                    <tr>
                        <td>
                            <strong>@sc.BranchName</strong>
                            <div class="branch-loc">@sc.Location</div>
                        </td>
                        <td>@sc.TotalClassrooms</td>
                        <td>@sc.EnrolledChildren / @sc.TotalCapacity</td>
                        <td>
                            <strong>@sc.OccupancyPercentage%</strong>
                        </td>
                        <td>@sc.AttendanceRatePercentage%</td>
                        <td>@sc.RatioCompliancePercentage%</td>
                        <td>@sc.PlanningCoveragePercentage%</td>
                        <td>@sc.TuitionCollectionRatePercentage%</td>
                        <td>
                            <span class="health-pill @sc.RatingCssClass">
                                @sc.CompositeHealthScore • @sc.HealthRating
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public List<BranchHealthScorecard> Scorecards { get; set; } = new();
}
