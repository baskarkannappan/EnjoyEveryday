@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

@if (Scorecards.Any())
{
    <div class="benchmarking-pulse-strip">
        <div class="pulse-card">
            <span class="pulse-card-label">Network Capacity</span>
            <div class="pulse-card-value">@Scorecards.Sum(s => s.EnrolledChildren) / @Scorecards.Sum(s => s.TotalCapacity)</div>
            <span class="pulse-card-sub">
                @Math.Round((double)Scorecards.Sum(s => s.EnrolledChildren) / Math.Max(1, Scorecards.Sum(s => s.TotalCapacity)) * 100, 1)% Total Occupancy
            </span>
        </div>
        <div class="pulse-card">
            <span class="pulse-card-label">Network Attendance</span>
            <div class="pulse-card-value attendance-val">
                @(Math.Round(Scorecards.Average(s => s.AttendanceRatePercentage), 1))%
            </div>
            <span class="pulse-card-sub">30-day average attendance health</span>
        </div>
        <div class="pulse-card">
            <span class="pulse-card-label">Ratio Compliance Rate</span>
            <div class="pulse-card-value compliance-val">
                @(Math.Round(Scorecards.Average(s => s.RatioCompliancePercentage), 1))%
            </div>
            <span class="pulse-card-sub">Statutory educator-to-child ratios</span>
        </div>
        <div class="pulse-card">
            <span class="pulse-card-label">Tuition Collection Health</span>
            <div class="pulse-card-value tuition-val">
                @(Math.Round(Scorecards.Average(s => s.TuitionCollectionRatePercentage), 1))%
            </div>
            <span class="pulse-card-sub">Invoiced tuition collected to date</span>
        </div>
    </div>
}

@code {
    [Parameter] public List<BranchHealthScorecard> Scorecards { get; set; } = new();
}
