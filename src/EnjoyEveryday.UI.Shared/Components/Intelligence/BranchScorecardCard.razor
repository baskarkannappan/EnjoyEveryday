@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

<div class="branch-score-card">
    <div class="scorecard-header">
        <div>
            <h3 class="scorecard-title">@Scorecard.BranchName</h3>
            <span class="scorecard-loc">📍 @Scorecard.Location • @Scorecard.TotalClassrooms Classrooms</span>
        </div>
        <span class="health-pill @Scorecard.RatingCssClass">
            @Scorecard.CompositeHealthScore pts • @Scorecard.HealthRating
        </span>
    </div>

    <!-- Occupancy Bar -->
    <div class="metric-bar-item">
        <div class="metric-bar-header">
            <span>Occupancy Rate (@Scorecard.EnrolledChildren / @Scorecard.TotalCapacity children)</span>
            <strong>@Scorecard.OccupancyPercentage%</strong>
        </div>
        <div class="bar-bg">
            <div class="bar-fill" style="width: @Math.Min(100, Scorecard.OccupancyPercentage)%;"></div>
        </div>
    </div>

    <!-- Attendance Bar -->
    <div class="metric-bar-item">
        <div class="metric-bar-header">
            <span>Attendance Health (30-day)</span>
            <strong>@Scorecard.AttendanceRatePercentage%</strong>
        </div>
        <div class="bar-bg">
            <div class="bar-fill attendance-fill" style="width: @Math.Min(100, Scorecard.AttendanceRatePercentage)%;"></div>
        </div>
    </div>

    <!-- Ratio Compliance Bar -->
    <div class="metric-bar-item">
        <div class="metric-bar-header">
            <span>Statutory Ratio Compliance</span>
            <strong>@Scorecard.RatioCompliancePercentage%</strong>
        </div>
        <div class="bar-bg">
            <div class="bar-fill compliance-fill" style="width: @Math.Min(100, Scorecard.RatioCompliancePercentage)%;"></div>
        </div>
    </div>

    <!-- Planning Coverage Bar -->
    <div class="metric-bar-item">
        <div class="metric-bar-header">
            <span>Weekly Experience Planning Coverage</span>
            <strong>@Scorecard.PlanningCoveragePercentage%</strong>
        </div>
        <div class="bar-bg">
            <div class="bar-fill planning-fill" style="width: @Math.Min(100, Scorecard.PlanningCoveragePercentage)%;"></div>
        </div>
    </div>

    <!-- Tuition Collection Bar -->
    <div class="metric-bar-item">
        <div class="metric-bar-header">
            <span>Tuition Collection Health</span>
            <strong>@Scorecard.TuitionCollectionRatePercentage%</strong>
        </div>
        <div class="bar-bg">
            <div class="bar-fill collection-fill" style="width: @Math.Min(100, Scorecard.TuitionCollectionRatePercentage)%;"></div>
        </div>
    </div>

    <div class="scorecard-actions">
        <a href="/management/roster" class="btn secondary action-link">
            View Staff Roster
        </a>
        <a href="/enrollment" class="btn secondary action-link">
            Admissions Pipeline
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BranchHealthScorecard Scorecard { get; set; } = default!;
}
