@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.UI.Shared.Components
@inject IFacilityProfileService FacilityProfileService
@inject IUserContext UserContext

<div class="facility-editor-container">
    @if (!HasAccess)
    {
        <div class="access-denied-card">
            <span class="denied-icon">🔒</span>
            <h3>Access Restricted</h3>
            <p>Only Organization Administrators and Branch Administrators can customize facility profiles and manage inquiries.</p>
        </div>
    }
    else
    {
        <!-- Header Controls: Scope Selector & View Tabs -->
        <div class="editor-header-bar">
            <div class="scope-selector-group">
                <label for="scopeSelect"><strong>Editing Profile For:</strong></label>
                <select id="scopeSelect" class="scope-dropdown" @onchange="HandleScopeChanged" value="@_selectedScopeKey">
                    @if (IsOrgAdmin)
                    {
                        <option value="org">🏢 Organization Default (All Branches Fallback)</option>
                    }
                    @foreach (var branch in _branches)
                    {
                        <option value="@branch.Id">📍 Branch: @branch.Name (@(branch.Location ?? "Main"))</option>
                    }
                </select>
            </div>

            <div class="tabs-group">
                <button type="button" class="tab-btn @(_activeTab == "editor" ? "active" : "")" @onclick='() => _activeTab = "editor"'>
                    ✏️ Profile Customizer
                </button>
                <button type="button" class="tab-btn @(_activeTab == "inquiries" ? "active" : "")" @onclick='() => _activeTab = "inquiries"'>
                    📬 Received Inquiries @(_newInquiryCount > 0 ? $"({_newInquiryCount} New)" : "")
                </button>
                <button type="button" class="tab-btn @(_activeTab == "preview" ? "active" : "")" @onclick='() => _activeTab = "preview"'>
                    👁️ Parent View Preview
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_notificationMessage))
        {
            <div class="notification-toast @(_isError ? "error-toast" : "success-toast")">
                <span>@(_isError ? "⚠️" : "✅")</span>
                <span>@_notificationMessage</span>
                <button type="button" class="toast-dismiss" @onclick="() => _notificationMessage = null">✕</button>
            </div>
        }

        <!-- Tab 1: Profile Customizer Form -->
        @if (_activeTab == "editor")
        {
            <div class="editor-form-layout">
                <!-- Left Column: Branding, Story & Visuals -->
                <div class="editor-column">
                    <!-- Branding & Identity -->
                    <div class="editor-card">
                        <div class="card-title-row">
                            <span class="card-icon">🎨</span>
                            <h3>Branding &amp; Identity</h3>
                        </div>

                        <div class="form-group">
                            <label>Display Title <span class="req">*</span></label>
                            <input class="form-input" @bind="_editModel.Title" placeholder="e.g. Little Stars Early Learning — Downtown" />
                            <small class="field-hint">Primary name displayed on the banner and hero header.</small>
                        </div>

                        <div class="form-group">
                            <label>Motto / Tagline</label>
                            <input class="form-input" @bind="_editModel.Motto" placeholder="e.g. Nurturing curious minds through wonder, play, and nature." />
                        </div>

                        <div class="photos-upload-grid">
                            <div class="photo-upload-cell">
                                <label>Center / Branch Logo</label>
                                <AvifImageUploader @bind-Value="_editModel.LogoMediaUrl"
                                                   ButtonText="Upload Logo"
                                                   EntityType="FacilityProfile"
                                                   EntityId="_editModel.OrganizationId" />
                                <small class="field-hint">Square image recommended (PNG or AVIF).</small>
                            </div>

                            <div class="photo-upload-cell">
                                <label>Cover / Hero Banner Image</label>
                                <AvifImageUploader @bind-Value="_editModel.CoverMediaUrl"
                                                   ButtonText="Upload Banner"
                                                   EntityType="FacilityProfile"
                                                   EntityId="_editModel.OrganizationId" />
                                <small class="field-hint">Landscape image used as the background hero banner.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Story & Philosophy -->
                    <div class="editor-card">
                        <div class="card-title-row">
                            <span class="card-icon">📖</span>
                            <h3>About Us Story &amp; Philosophy</h3>
                        </div>

                        <div class="form-group">
                            <label>Our Story &amp; Pedagogy</label>
                            <textarea rows="5" class="form-textarea" @bind="_editModel.AboutStory" placeholder="Share your center's history, educational approach (e.g. Reggio, Montessori), and daily dedication to children..."></textarea>
                        </div>

                        <div class="form-group">
                            <label>Core Values / Curriculum Pillars</label>
                            <div class="tags-manager">
                                <div class="tags-flex">
                                    @foreach (var tag in _editModel.CoreValues)
                                    {
                                        <span class="value-tag">
                                            <span>✓ @tag</span>
                                            <button type="button" class="remove-tag-btn" @onclick="() => RemoveValueTag(tag)">✕</button>
                                        </span>
                                    }
                                </div>
                                <div class="add-tag-row">
                                    <input class="form-input tag-input" @bind="_newTagText" placeholder="Add a pillar (e.g. Organic Meals)" @onkeyup="HandleTagKeyUp" />
                                    <button type="button" class="btn secondary" @onclick="AddValueTag">＋ Add</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Campus Photo Gallery -->
                    <div class="editor-card">
                        <div class="card-title-row">
                            <span class="card-icon">🖼️</span>
                            <h3>Campus Photo Gallery</h3>
                        </div>
                        <p class="section-desc">Showcase classrooms, sensory play gardens, and creative ateliers to parents and visitors.</p>

                        <div class="gallery-edit-grid">
                            @foreach (var photo in _editModel.GalleryMediaUrls)
                            {
                                <div class="gallery-edit-item">
                                    <img src="@photo" alt="Campus photo" class="gallery-thumb" />
                                    <button type="button" class="remove-gallery-photo" @onclick="() => RemoveGalleryPhoto(photo)" title="Remove photo">✕</button>
                                </div>
                            }
                        </div>

                        <div class="add-gallery-photo-box">
                            <label>Add New Photo to Gallery:</label>
                            <AvifImageUploader @bind-Value="_newGalleryPhotoUrl"
                                               ButtonText="Add Gallery Photo"
                                               EntityType="FacilityGallery"
                                               EntityId="_editModel.OrganizationId" />
                            @if (!string.IsNullOrEmpty(_newGalleryPhotoUrl))
                            {
                                <button type="button" class="btn secondary add-photo-confirm" @onclick="ConfirmAddGalleryPhoto">
                                    ＋ Insert into Gallery
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Column: Contact, Hours & Location -->
                <div class="editor-column">
                    <!-- Contact Details -->
                    <div class="editor-card">
                        <div class="card-title-row">
                            <span class="card-icon">📞</span>
                            <h3>Direct Contact Numbers &amp; Email</h3>
                        </div>

                        <div class="form-group">
                            <label>Primary Phone <span class="req">*</span></label>
                            <input class="form-input" @bind="_editModel.Phone" placeholder="(416) 555-0100" />
                        </div>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Secondary / Desk Phone</label>
                                <input class="form-input" @bind="_editModel.SecondaryPhone" placeholder="(416) 555-0101" />
                            </div>
                            <div class="form-group">
                                <label>Emergency Direct Line</label>
                                <input class="form-input" @bind="_editModel.EmergencyPhone" placeholder="(416) 555-0911" />
                            </div>
                        </div>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Main Contact Email <span class="req">*</span></label>
                                <input type="email" class="form-input" @bind="_editModel.Email" placeholder="contact@littlestars.com" />
                            </div>
                            <div class="form-group">
                                <label>Inquiries / Admissions Email</label>
                                <input type="email" class="form-input" @bind="_editModel.InquiryEmail" placeholder="admissions@littlestars.com" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Operating Hours</label>
                            <input class="form-input" @bind="_editModel.OperatingHours" placeholder="e.g. Monday – Friday: 7:00 AM – 6:00 PM" />
                        </div>
                    </div>

                    <!-- Campus Location & Directions -->
                    <div class="editor-card">
                        <div class="card-title-row">
                            <span class="card-icon">📍</span>
                            <h3>Campus Location &amp; Directions</h3>
                        </div>

                        <div class="form-group">
                            <label>Street Address</label>
                            <input class="form-input" @bind="_editModel.StreetAddress" placeholder="e.g. 125 King Street West, Suite 200" />
                        </div>

                        <div class="form-row-3">
                            <div class="form-group">
                                <label>City</label>
                                <input class="form-input" @bind="_editModel.City" placeholder="Toronto" />
                            </div>
                            <div class="form-group">
                                <label>State / Province</label>
                                <input class="form-input" @bind="_editModel.State" placeholder="ON" />
                            </div>
                            <div class="form-group">
                                <label>Postal / Zip Code</label>
                                <input class="form-input" @bind="_editModel.PostalCode" placeholder="M5X 1A9" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Country</label>
                            <input class="form-input" @bind="_editModel.Country" placeholder="Canada" />
                        </div>

                        <div class="form-group">
                            <label>Google Maps URL (Optional direct pin)</label>
                            <input class="form-input" @bind="_editModel.MapUrl" placeholder="https://maps.google.com/..." />
                        </div>

                        <div class="form-group">
                            <label>Arrival &amp; Parking Directions</label>
                            <textarea rows="3" class="form-textarea" @bind="_editModel.DirectionsNotes" placeholder="e.g. Stroller parking in lobby; buzzer #200 at security entrance."></textarea>
                        </div>
                    </div>

                    <!-- Action Bar -->
                    <div class="save-action-card">
                        <div class="save-status-info">
                            <strong>Ready to publish?</strong>
                            <p>Changes will immediately be visible on Parent Portal and Daycare staff views.</p>
                        </div>
                        <button type="button" class="primary btn-save-profile" @onclick="HandleSaveProfile" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span>Saving Profile...</span>
                            }
                            else
                            {
                                <span>💾 Save &amp; Publish Profile</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Tab 2: Received Inquiries -->
        @if (_activeTab == "inquiries")
        {
            <div class="inquiries-panel-card">
                <div class="inquiries-filter-row">
                    <div class="inquiries-heading">
                        <h3>Customer &amp; Parent Inquiries</h3>
                        <p>Messages submitted through the public Contact Us form for this campus.</p>
                    </div>
                    <div class="status-filters">
                        <button type="button" class="filter-chip @(_inquiryStatusFilter == null ? "active" : "")" @onclick='() => SetInquiryFilter(null)'>All (@_inquiries.Count)</button>
                        <button type="button" class="filter-chip @(_inquiryStatusFilter == "New" ? "active" : "")" @onclick='() => SetInquiryFilter("New")'>New (@_inquiries.Count(i => i.Status == "New"))</button>
                        <button type="button" class="filter-chip @(_inquiryStatusFilter == "InReview" ? "active" : "")" @onclick='() => SetInquiryFilter("InReview")'>In Review</button>
                        <button type="button" class="filter-chip @(_inquiryStatusFilter == "Resolved" ? "active" : "")" @onclick='() => SetInquiryFilter("Resolved")'>Resolved</button>
                    </div>
                </div>

                @if (_filteredInquiries.Count == 0)
                {
                    <div class="no-inquiries-box">
                        <span class="box-icon">📬</span>
                        <h4>No Inquiries Found</h4>
                        <p>No messages match the selected filter.</p>
                    </div>
                }
                else
                {
                    <div class="inquiries-list">
                        @foreach (var inq in _filteredInquiries)
                        {
                            <div class="inquiry-item-card @(inq.Status == "New" ? "new-inquiry" : "")">
                                <div class="inquiry-item-header">
                                    <div class="sender-info">
                                        <span class="sender-avatar">@inq.SenderName.FirstOrDefault()</span>
                                        <div>
                                            <strong>@inq.SenderName</strong>
                                            <div class="sender-contacts">
                                                <a href="mailto:@inq.SenderEmail">@inq.SenderEmail</a>
                                                @if (!string.IsNullOrEmpty(inq.SenderPhone))
                                                {
                                                    <span>•</span>
                                                    <a href="tel:@inq.SenderPhone">@inq.SenderPhone</a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="inquiry-meta">
                                        <span class="category-badge">@inq.Category</span>
                                        <span class="status-pill status-@inq.Status.ToLower()">@inq.Status</span>
                                        <span class="inquiry-time">@inq.CreatedAt.ToString("MMM d, yyyy h:mm tt")</span>
                                    </div>
                                </div>

                                <div class="inquiry-content">
                                    <h4 class="inquiry-subject">@inq.Subject</h4>
                                    <p class="inquiry-message">@inq.Message</p>
                                </div>

                                <div class="inquiry-actions-row">
                                    @if (inq.Status == "New")
                                    {
                                        <button type="button" class="btn secondary btn-sm" @onclick='() => UpdateStatus(inq.Id, "InReview")'>
                                            Mark In Review
                                        </button>
                                        <button type="button" class="primary btn-sm" @onclick='() => UpdateStatus(inq.Id, "Resolved")'>
                                            ✓ Mark Resolved
                                        </button>
                                    }
                                    else if (inq.Status == "InReview")
                                    {
                                        <button type="button" class="primary btn-sm" @onclick='() => UpdateStatus(inq.Id, "Resolved")'>
                                            ✓ Mark Resolved
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="resolved-note">✓ Resolved @(inq.ResolvedAt.HasValue ? inq.ResolvedAt.Value.ToString("MMM d, yyyy") : "")</span>
                                        <button type="button" class="btn secondary btn-sm" @onclick='() => UpdateStatus(inq.Id, "InReview")'>
                                            Reopen
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Tab 3: Parent View Preview -->
        @if (_activeTab == "preview")
        {
            <div class="preview-wrap-card">
                <div class="preview-banner-note">
                    <span>👁️ <strong>Live Preview</strong>: This is how your customized About Us &amp; Contact Us appears to Parents and Educators.</span>
                </div>
                <FacilityProfileView OrganizationId="_currentOrgId" BranchId="_currentBranchId" />
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid? DefaultBranchId { get; set; }

    [Parameter]
    public string InitialTab { get; set; } = "editor";

    private List<BranchOptionDto> _branches = new();
    private SaveFacilityProfileRequest _editModel = new();
    private List<ContactInquiryDto> _inquiries = new();
    private List<ContactInquiryDto> _filteredInquiries => 
        string.IsNullOrEmpty(_inquiryStatusFilter) 
            ? _inquiries 
            : _inquiries.Where(i => i.Status.Equals(_inquiryStatusFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private string _activeTab = "editor";
    private string _selectedScopeKey = "org";
    private string? _inquiryStatusFilter = null;
    private string? _notificationMessage;
    private bool _isError = false;
    private bool _isSaving = false;
    private string? _newTagText;
    private string? _newGalleryPhotoUrl;
    private int _newInquiryCount => _inquiries.Count(i => i.Status == "New");

    private Guid _currentOrgId => UserContext.OrganizationId ?? Guid.Parse("20000000-0000-0000-0000-000000000001");
    private Guid? _currentBranchId => _selectedScopeKey == "org" ? null : Guid.Parse(_selectedScopeKey);

    private bool IsOrgAdmin => UserContext.Roles.Any(r =>
        r.Equals("OrgAdmin", StringComparison.OrdinalIgnoreCase) ||
        r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
        r.Equals("Superadmin", StringComparison.OrdinalIgnoreCase)) ||
        UserContext.HasPermission("organization.manage");

    private bool HasAccess => IsOrgAdmin || UserContext.Roles.Any(r => r.Equals("BranchAdmin", StringComparison.OrdinalIgnoreCase)) || UserContext.BranchId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialTab))
        {
            _activeTab = InitialTab;
        }
        await LoadBranchesAndProfileAsync();
    }

    private async Task LoadBranchesAndProfileAsync()
    {
        try
        {
            var orgId = _currentOrgId;
            _branches = (await FacilityProfileService.GetEditableBranchesAsync(orgId)).ToList();

            if (DefaultBranchId.HasValue && _branches.Any(b => b.Id == DefaultBranchId.Value))
            {
                _selectedScopeKey = DefaultBranchId.Value.ToString();
            }
            else if (!IsOrgAdmin && _branches.Count > 0)
            {
                _selectedScopeKey = _branches.First().Id.ToString();
            }
            else
            {
                _selectedScopeKey = "org";
            }

            await LoadProfileForCurrentScopeAsync();
            await LoadInquiriesAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = "Failed to load facility configuration: " + ex.Message;
            _isError = true;
        }
    }

    private async Task LoadProfileForCurrentScopeAsync()
    {
        var existing = await FacilityProfileService.GetExactProfileAsync(_currentOrgId, _currentBranchId);
        if (existing != null)
        {
            _editModel = new SaveFacilityProfileRequest
            {
                Id = existing.Id,
                OrganizationId = existing.OrganizationId,
                BranchId = existing.BranchId,
                Title = existing.Title,
                Motto = existing.Motto,
                AboutStory = existing.AboutStory,
                LogoMediaUrl = existing.LogoMediaUrl,
                CoverMediaUrl = existing.CoverMediaUrl,
                GalleryMediaUrls = existing.GalleryMediaUrls ?? new(),
                Phone = existing.Phone,
                SecondaryPhone = existing.SecondaryPhone,
                EmergencyPhone = existing.EmergencyPhone,
                Email = existing.Email,
                InquiryEmail = existing.InquiryEmail,
                OperatingHours = existing.OperatingHours,
                StreetAddress = existing.StreetAddress,
                City = existing.City,
                State = existing.State,
                PostalCode = existing.PostalCode,
                Country = existing.Country ?? "Canada",
                MapUrl = existing.MapUrl,
                DirectionsNotes = existing.DirectionsNotes,
                CoreValues = existing.CoreValues ?? new()
            };
        }
        else
        {
            // Initialize fresh template
            var branchName = _branches.FirstOrDefault(b => b.Id == _currentBranchId)?.Name;
            _editModel = new SaveFacilityProfileRequest
            {
                OrganizationId = _currentOrgId,
                BranchId = _currentBranchId,
                Title = _currentBranchId.HasValue ? $"Little Stars — {branchName} Campus" : "Little Stars Daycare & Early Learning",
                Motto = "Nurturing curious minds through wonder, play, and nature.",
                Country = "Canada",
                OperatingHours = "Monday – Friday: 7:00 AM – 6:00 PM"
            };
        }
    }

    private async Task LoadInquiriesAsync()
    {
        _inquiries = (await FacilityProfileService.GetInquiriesAsync(_currentOrgId, _currentBranchId)).ToList();
    }

    private async Task HandleScopeChanged(ChangeEventArgs e)
    {
        _selectedScopeKey = e.Value?.ToString() ?? "org";
        await LoadProfileForCurrentScopeAsync();
        await LoadInquiriesAsync();
    }

    private async Task HandleSaveProfile()
    {
        if (string.IsNullOrWhiteSpace(_editModel.Title))
        {
            _notificationMessage = "Display Title is required.";
            _isError = true;
            return;
        }

        _isSaving = true;
        _notificationMessage = null;

        try
        {
            _editModel.OrganizationId = _currentOrgId;
            _editModel.BranchId = _currentBranchId;

            await FacilityProfileService.SaveProfileAsync(_editModel);
            _notificationMessage = "Profile updated and published successfully!";
            _isError = false;
        }
        catch (Exception ex)
        {
            _notificationMessage = "Error saving profile: " + ex.Message;
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void AddValueTag()
    {
        if (!string.IsNullOrWhiteSpace(_newTagText) && !_editModel.CoreValues.Contains(_newTagText.Trim()))
        {
            _editModel.CoreValues.Add(_newTagText.Trim());
            _newTagText = string.Empty;
        }
    }

    private void HandleTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddValueTag();
        }
    }

    private void RemoveValueTag(string tag)
    {
        _editModel.CoreValues.Remove(tag);
    }

    private void ConfirmAddGalleryPhoto()
    {
        if (!string.IsNullOrWhiteSpace(_newGalleryPhotoUrl))
        {
            _editModel.GalleryMediaUrls.Add(_newGalleryPhotoUrl);
            _newGalleryPhotoUrl = null;
        }
    }

    private void RemoveGalleryPhoto(string photoUrl)
    {
        _editModel.GalleryMediaUrls.Remove(photoUrl);
    }

    private void SetInquiryFilter(string? status)
    {
        _inquiryStatusFilter = status;
    }

    private async Task UpdateStatus(Guid inquiryId, string newStatus)
    {
        try
        {
            await FacilityProfileService.UpdateInquiryStatusAsync(new UpdateInquiryStatusRequest
            {
                InquiryId = inquiryId,
                Status = newStatus
            });
            await LoadInquiriesAsync();
            _notificationMessage = $"Inquiry updated to {newStatus}.";
            _isError = false;
        }
        catch (Exception ex)
        {
            _notificationMessage = "Failed to update inquiry: " + ex.Message;
            _isError = true;
        }
    }
}

<style>
.facility-editor-container {
    max-width: 1200px;
    margin: 0 auto;
    font-family: var(--ee-font, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    color: var(--text, #26332d);
}

.access-denied-card {
    background: #fff5f5;
    border: 1px solid #fed7d7;
    border-radius: var(--radius, 18px);
    padding: 40px;
    text-align: center;
}

.denied-icon {
    font-size: 36px;
    display: block;
    margin-bottom: 12px;
}

/* Header Bar */
.editor-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface, #ffffff);
    border: 1px solid var(--border, #e4e7df);
    border-radius: var(--radius, 18px);
    box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
    padding: 16px 24px;
    margin-bottom: 24px;
    gap: 16px;
    flex-wrap: wrap;
}

.scope-selector-group {
    display: flex;
    align-items: center;
    gap: 12px;
}

.scope-dropdown {
    padding: 8px 14px;
    border: 1px solid var(--accent, #557c6c);
    border-radius: 8px;
    background: var(--surface-soft, #f8f9f5);
    font-weight: 700;
    font-size: 14px;
    color: var(--accent-dark, #31523c);
    cursor: pointer;
}

.tabs-group {
    display: flex;
    gap: 8px;
}

.tab-btn {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--border, #e4e7df);
    background: var(--surface-soft, #f8f9f5);
    font-weight: 700;
    font-size: 13px;
    color: var(--text, #26332d);
    cursor: pointer;
    transition: all 0.2s ease;
}

.tab-btn.active {
    background: #31523c;
    color: #ffffff;
    border-color: #31523c;
}

/* Toast */
.notification-toast {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-weight: 600;
    font-size: 14px;
}

.success-toast {
    background: var(--accent-light, #e6eee9);
    color: var(--accent-dark, #31523c);
    border: 1px solid #c8dacd;
}

.error-toast {
    background: #fff5f5;
    color: #9b2c2c;
    border: 1px solid #fed7d7;
}

.toast-dismiss {
    margin-left: auto;
    background: transparent;
    border: none;
    font-size: 16px;
    cursor: pointer;
    color: inherit;
}

/* 2-Column Editor Layout */
.editor-form-layout {
