    inset: 0;
    z-index: 1050;
    background-color: rgba(38, 51, 45, 0.45);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.active-session-modal {
    background: var(--surface, #ffffff);
    border-radius: var(--radius, 18px);
    max-width: 820px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 40px rgba(40, 55, 47, 0.16);
    border: 1px solid var(--border, #e4e7df);
    overflow: hidden;
    color: var(--text, #26332d);
}

.active-session-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    background: #f7f8f5;
    border-bottom: 1px solid var(--border, #e4e7df);
}

.session-header-left {
    display: flex;
    align-items: center;
    gap: 14px;
}

.session-header-avatar {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-light, #e6eee9);
    display: flex;
    align-items: center;
    justify-content: center;
}

.session-eyebrow {
    font-size: 10.5px;
    font-weight: 750;
    color: var(--accent, #52745e);
    letter-spacing: 0.5px;
}

.session-title {
    margin: 2px 0 0 0;
    font-size: 19px;
    font-weight: 800;
    color: var(--text, #26332d);
    letter-spacing: -0.3px;
}

.session-meta {
    font-size: 12.5px;
    color: var(--muted, #6c7870);
    margin-top: 2px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.meta-separator {
    color: #c0c6c2;
}

.modal-close-button {
    background: transparent;
    border: none;
    font-size: 18px;
    color: var(--muted, #6c7870);
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
}

.modal-close-button:hover {
    background: #e9ece6;
    color: var(--text, #26332d);
}

.session-modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
}

.section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border, #e4e7df);
}

.section-heading {
    font-size: 15px;
    font-weight: 750;
    color: var(--text, #26332d);
    margin: 0;
}

.section-subheading {
    font-size: 12px;
    color: var(--muted, #6c7870);
    margin: 2px 0 0 0;
}

.notice-banner {
    background: #fdfaf3;
    border: 1px solid #fae8c8;
    border-radius: 9px;
    padding: 9px 12px;
    font-size: 12.5px;
    color: #8c6225;
