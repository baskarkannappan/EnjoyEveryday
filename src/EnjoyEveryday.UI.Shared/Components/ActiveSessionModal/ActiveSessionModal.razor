@namespace EnjoyEveryday.UI.Shared.Components.ActiveSessionModal
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.UI.Shared.Components.ChildJourney
@inject ChildService ChildService
@inject ExecutionService ExecutionService
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Domain.Repositories.IExperienceSessionRepository SessionRepository
@inject ExperienceService ExperienceService
@inject EnjoyEveryday.Application.Services.AttendanceService AttendanceService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject TimeProvider TimeProvider
@if (IsOpen)
{
    <div class="active-session-modal-backdrop" @onclick="CloseDialog">
        <div class="active-session-modal" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="active-session-header">
                <div class="session-header-left">
                    <div class="session-header-avatar">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="session-eyebrow">EXPERIENCE SESSION RUNNER</div>
                        <h2 class="session-title">@(_experienceTitle.Length > 0 ? _experienceTitle : "Active Session")</h2>
                        <div class="session-meta">
                            <span><strong>Classroom:</strong> @_classroomName</span>
                            <span class="meta-separator">•</span>
                            <span><strong>Branch:</strong> @_branchName</span>
                        </div>
                    </div>
                </div>
                <button class="modal-close-button" @onclick="CloseDialog" aria-label="Close modal">✕</button>
            </div>
            
            <div class="session-modal-body">
                @if (_session == null)
                {
                    <div style="padding: 32px; text-align: center; color: var(--muted, #6c7870);">
                        Loading experience session...
                    </div>
                }
                else
                {
                    <!-- Children Participation Section -->
                    <div class="section-header-row">
                        <div>
                            <h3 class="section-heading">Children Participation</h3>
                            <p class="section-subheading">Track attendance and observations for today's experience.</p>
                        </div>
                        <button class="btn secondary btn-sm" @onclick="() => OpenMomentDialog(null)" disabled="@(!_presentChildIds.Any())" title="@(!_presentChildIds.Any() ? "No checked-in children to log observations for" : "Log bulk moment")">
                            + Log Bulk Moment
                        </button>
                    </div>
                    
                    @if (!_children.Any())
                    {
                        <div class="empty-state-card">
                            No children are currently enrolled in this classroom roster. Add children first to record individual observations.
                        </div>
                    }
                    else
                    {
                        @if (!_presentChildIds.Any())
                        {
                            <div class="notice-banner">
                                <span class="notice-icon">ℹ</span>
                                <span>No children are currently checked in for this room today. Check in children from the Classroom Live Roster before logging observations or activities.</span>
                            </div>
                        }

                        <div class="children-cards-grid">
                            @foreach (var child in _children)
                            {
                                var isPresent = _presentChildIds.Contains(child.Id);
                                var status = isPresent ? GetParticipationStatus(child.Id) : "Absent";
                                
                                <div class="child-session-card @(status == "Participated" && isPresent ? "card-participated" : "card-inactive")">
                                    <div class="child-card-top">
                                        <div class="child-info">
                                            <div class="child-avatar-badge">
                                                @(child.FirstName?.FirstOrDefault().ToString() ?? "C")
                                            </div>
                                            <div>
                                                <strong class="child-name">@child.FirstName @child.LastName</strong>
                                                <span class="child-status-badge @(isPresent ? "status-present" : "status-absent")">
                                                    @(isPresent ? "Present Today" : "Absent / Not Checked In")
                                                </span>
                                            </div>
                                        </div>
                                        
                                        @if (isPresent)
                                        {
                                            <select class="participation-select" value="@status" @onchange="@(e => UpdateStatus(child.Id, e.Value?.ToString() ?? "Participated"))">
                                                <option value="Participated">Participated</option>
                                                <option value="Declined">Declined</option>
                                                <option value="Absent">Absent</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span style="font-size: 11px; font-weight: 700; color: #a0aec0; background: #f7fafc; padding: 4px 8px; border-radius: 6px; border: 1px solid #e2e8f0;">
                                                Logs Locked
                                            </span>
                                        }
                                    </div>
                                    
                                    @if (isPresent && status == "Participated")
                                    {
                                        <div class="child-actions-row">
                                            @if (_loggedChildIds.Contains(child.Id))
                                            {
                                                <span class="logged-pill">✓ Moment Logged</span>
                                                <button class="btn secondary btn-xs" @onclick="() => OpenMomentDialog(child.Id)">
                                                    + Log Another
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn secondary btn-xs" @onclick="() => OpenMomentDialog(child.Id)">
                                                    + Log Moment
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    
                    <!-- Session Feedback -->
                    <div class="feedback-section">
                        <h3 class="section-heading">Session Feedback (Optional)</h3>
                        <p class="section-subheading">Quick reflections to refine future experiences.</p>
                        
                        <div class="feedback-row">
                            <div class="rating-stars-wrap">
                                <span class="input-label">Rating</span>
                                <div class="stars-list">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var starValue = i;
                                        <span @onclick="() => _stars = starValue" class="star-icon @(_stars >= starValue ? "star-active" : "star-inactive")">★</span>
                                    }
                                </div>
                            </div>
                            <div class="feedback-select-wrap">
                                <span class="input-label">Experience Reception</span>
                                <select class="feedback-select" @bind="_rating">
                                    <option value="Great">Great - They loved it</option>
                                    <option value="Good">Good - Went as expected</option>
                                    <option value="Okay">Okay - Some challenges</option>
                                    <option value="Poor">Poor - Needs redesign</option>
                                </select>
                            </div>
                        </div>
                        
                        <div style="margin-top: 14px;">
                            <span class="input-label">Teacher Notes &amp; Observations</span>
                            <textarea class="feedback-textarea" @bind="_notes" rows="3" placeholder="Add optional reflections or materials adjustments for next time..."></textarea>
                        </div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="session-modal-footer">
                @if (_showParticipationWarning)
                {
                    <span class="warning-text">No participation recorded. Click again to confirm completion.</span>
                }
                <button class="btn secondary" @onclick="CloseDialog">Close (Keep Active)</button>
                <button class="btn primary btn-end-save" @onclick="TryEndSession">
                    ✓ End Session &amp; Save
                </button>
            </div>
        </div>
    </div>
}

<style>
