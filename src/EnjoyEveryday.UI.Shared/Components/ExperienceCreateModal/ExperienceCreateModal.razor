@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
                <div>
                    <div class="eyebrow">@(IsEditing ? "EDIT" : "CREATE")</div>
                    <h3 style="margin: 0 0 8px 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">@(IsEditing ? "Edit Experience" : "Create an Experience")</h3>
                    <p style="margin: 0; color: var(--muted, #7c877f); font-size: 0.95rem;">Capture what you already know works with your children.</p>
                </div>
                <button class="modal-close" @onclick="OnClose">✕</button>
            </div>

            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Experience Name</label>
                <input value="@Title" @onchange="@(e => TitleChanged.InvokeAsync(e.Value?.ToString()))" placeholder="Build a Rainy-Day City" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div class="field">
                    <label>Age</label>
                    <select value="@Age" @onchange="@(e => AgeChanged.InvokeAsync(e.Value?.ToString()))">
                        <option value="3-4">3–4</option>
                        <option value="4-5">4–5</option>
                        <option value="5-6">5–6</option>
                    </select>
                </div>
                <div class="field">
                    <label>Duration</label>
                    <select value="@Duration" @onchange="@(e => DurationChanged.InvokeAsync(e.Value?.ToString()))">
                        <option value="15 minutes">15 minutes</option>
                        <option value="30 minutes">30 minutes</option>
                        <option value="45 minutes">45 minutes</option>
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div class="field">
                    <label>Type</label>
                    <select value="@Type" @onchange="@(e => TypeChanged.InvokeAsync(e.Value?.ToString()))">
                        <option value="Explore">Explore</option>
                        <option value="Create">Create</option>
                        <option value="Move">Move</option>
                    </select>
                </div>
                <div class="field">
                    <label>Environment</label>
                    <select value="@Environment" @onchange="@(e => EnvironmentChanged.InvokeAsync(e.Value?.ToString()))">
                        <option value="Indoor">Indoor</option>
                        <option value="Outdoor">Outdoor</option>
                    </select>
                </div>
            </div>

            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Experience</label>
                <textarea value="@Description" @onchange="@(e => DescriptionChanged.InvokeAsync(e.Value?.ToString()))" placeholder="Describe what children will experience..."></textarea>
            </div>

            <div class="field" style="margin-bottom: 2rem;">
                <label>Materials</label>
                <input value="@Materials" @onchange="@(e => MaterialsChanged.InvokeAsync(e.Value?.ToString()))" placeholder="Blocks, paper, crayons..." />
            </div>

            <div style="border-top: 1px solid var(--border, #e4e7df); padding-top: 1.5rem; display: flex; justify-content: flex-end; gap: 1rem;">
                @if (IsEditing)
                {
                    <button type="button" class="secondary" style="border-color: #ff4d4d; color: #ff4d4d; margin-right: auto;" @onclick="OnDelete">Delete</button>
                }
                <button type="button" class="secondary" @onclick="OnSaveDraft">Save draft</button>
                <button type="button" class="primary" @onclick="OnSaveLibrary">Save to my library</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback<string?> TitleChanged { get; set; }

    [Parameter] public string? Age { get; set; }
    [Parameter] public EventCallback<string?> AgeChanged { get; set; }

    [Parameter] public string? Duration { get; set; }
    [Parameter] public EventCallback<string?> DurationChanged { get; set; }

    [Parameter] public string? Type { get; set; }
    [Parameter] public EventCallback<string?> TypeChanged { get; set; }

    [Parameter] public string? Environment { get; set; }
    [Parameter] public EventCallback<string?> EnvironmentChanged { get; set; }

    [Parameter] public string? Description { get; set; }
    [Parameter] public EventCallback<string?> DescriptionChanged { get; set; }

    [Parameter] public string? Materials { get; set; }
    [Parameter] public EventCallback<string?> MaterialsChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaveDraft { get; set; }
    [Parameter] public EventCallback OnSaveLibrary { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
