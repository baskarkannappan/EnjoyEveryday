@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

<article class="celebration-card category-@EventCategoryClass" @onclick="() => OnNavigate.InvokeAsync(Event.Id)">
    <!-- Header with Category, Scope, and Status -->
    <div class="card-header">
        <div class="tags-cluster">
            <span class="category-chip @EventCategoryClass">
                <span>@TypeIcon</span>
                <span>@EventCategoryName</span>
            </span>

            @if (!string.IsNullOrWhiteSpace(ScopeDisplay))
            {
                <span class="scope-chip @Event.Scope.ToLowerInvariant()">
                    @ScopeDisplay
                </span>
            }
        </div>

        <span class="status-chip @Event.Status.ToLowerInvariant()">
            <span class="status-dot"></span>
            <span>@Event.Status</span>
        </span>
    </div>

    <!-- Title & Description -->
    <h3 class="card-title">@Event.Title</h3>

    <p class="card-desc">
        @(string.IsNullOrWhiteSpace(Event.Description) 
            ? "Celebration with children and staff. Click to view schedule and preparation." 
            : Event.Description)
    </p>

    <!-- Meta Details Row -->
    <div class="card-meta">
        <span class="meta-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>@Event.EventDate.ToString("MMM dd, yyyy")</span>
        </span>

        <span class="meta-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>@(Event.StartTime?.ToString(@"hh\:mm") ?? "All Day")</span>
        </span>

        <span class="meta-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>@(Event.Location ?? "Daycare Center")</span>
        </span>
    </div>

    <!-- Footer Actions -->
    <div class="card-footer">
        <div class="status-summary">
            <span class="status-indicator-dot @Event.Status.ToLowerInvariant()"></span>
            <span>@StatusSummaryText</span>
        </div>

        <div class="actions-group" @onclick:stopPropagation="true">
            @if (IsAdmin && OnDelete.HasDelegate)
            {
                <button type="button" class="btn-delete" title="Delete Celebration" @onclick="() => OnDelete.InvokeAsync(Event)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>
            }
            <button type="button" class="btn-view" @onclick="() => OnNavigate.InvokeAsync(Event.Id)">
                <span>View Details</span>
                <span class="arrow">&rarr;</span>
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Event Event { get; set; } = default!;
    [Parameter] public string ScopeDisplay { get; set; } = string.Empty;
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback<Guid> OnNavigate { get; set; }
    [Parameter] public EventCallback<Event> OnDelete { get; set; }

    private string EventCategoryClass =>
        Event.Title.Contains("Birthday", StringComparison.OrdinalIgnoreCase) ? "birthday" :
        Event.Title.Contains("Festival", StringComparison.OrdinalIgnoreCase) ? "festival" : "celebration";

    private string EventCategoryName =>
        Event.Title.Contains("Birthday", StringComparison.OrdinalIgnoreCase) ? "Birthday" :
        Event.Title.Contains("Festival", StringComparison.OrdinalIgnoreCase) ? "Cultural Festival" : "Celebration";

    private string TypeIcon =>
        Event.Title.Contains("Birthday", StringComparison.OrdinalIgnoreCase) ? "🎂" :
        Event.Title.Contains("Festival", StringComparison.OrdinalIgnoreCase) ? "🏮" :
        Event.Title.Contains("Graduation", StringComparison.OrdinalIgnoreCase) ? "🎓" :
        Event.Title.Contains("Seasonal", StringComparison.OrdinalIgnoreCase) ? "🍂" : "🎈";

    private string StatusSummaryText => Event.Status switch
    {
        "Planned" => "Scheduled in rhythm",
        "Draft" => "Draft • Admin only",
        "Completed" => "Completed celebration",
        _ => "Approved • Active"
    };
}
