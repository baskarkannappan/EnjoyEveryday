@namespace EnjoyEveryday.UI.Shared.Components

<div class="error-state-container" style="min-height: @(MinHeightPx)px;">
    <div class="error-state-icon">@Icon</div>
    <h3 class="error-state-title">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="error-state-description">@Message</p>
    }
    @if (OnRetry.HasDelegate)
    {
        <button class="primary error-state-retry-btn" @onclick="OnRetry">
            @RetryText
        </button>
    }
</div>

<style>
    .error-state-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 36px 20px;
        background: var(--surface, #ffffff);
        border: 1px solid #fecaca;
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .04));
        width: 100%;
        margin: 16px 0;
        box-sizing: border-box;
    }

    .error-state-icon {
        font-size: 32px;
        line-height: 1;
        margin-bottom: 12px;
        background: #fef2f2;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #fee2e2;
    }

    .error-state-title {
        font-size: 16px;
        font-weight: 750;
        color: #991b1b;
        margin: 0 0 6px 0;
        letter-spacing: -0.3px;
    }

    .error-state-description {
        font-size: 13px;
        color: var(--muted, #6c7870);
        max-width: 440px;
        line-height: 1.5;
        margin: 0 0 16px 0;
    }

    .error-state-retry-btn {
        background: var(--accent, #557c6c) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 11px !important;
        padding: 9px 20px !important;
        font-weight: 700 !important;
        font-size: 13px !important;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .error-state-retry-btn:hover {
        background: var(--accent-dark, #3e6253) !important;
    }
</style>

@code {
    [Parameter] public string Icon { get; set; } = "🍂";
    [Parameter] public string Title { get; set; } = "Something didn't load properly";
    [Parameter] public string? Message { get; set; } = "We encountered a temporary connection issue. Your child's records are safe.";
    [Parameter] public string RetryText { get; set; } = "Try Again";
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public int MinHeightPx { get; set; } = 200;
}
