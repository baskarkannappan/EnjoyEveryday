@namespace EnjoyEveryday.UI.Shared.Components

<span class="@BaseClass @ColorClass">
    @ChildContent
</span>

@code {
    [Parameter] public string BaseClass { get; set; } = "tag";
    [Parameter] public string ColorClass { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
