@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@if (IsOpen)
{
    <div class="modal-backdrop-pipeline" @onclick="OnClose">
        <div class="modal-card-pipeline" @onclick:stopPropagation="true">
            <div class="modal-header-pipeline">
                <h3 class="modal-title">Log Inbound Family Inquiry</h3>
                <button class="close-x" @onclick="OnClose">✕</button>
            </div>
            <div class="modal-body-pipeline">
                <div class="form-row-2">
                    <div class="form-group">
                        <label>Child First Name *</label>
                        <input class="input-field" @bind="Inquiry.ChildFirstName" placeholder="e.g. Leo" />
                    </div>
                    <div class="form-group">
                        <label>Child Last Name *</label>
                        <input class="input-field" @bind="Inquiry.ChildLastName" placeholder="e.g. Sterling" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Date of Birth *</label>
                        <input type="date" class="input-field" @bind="Inquiry.DateOfBirth" />
                    </div>
                    <div class="form-group">
                        <label>Gender</label>
                        <select class="input-field" @bind="Inquiry.Gender">
                            <option value="Unspecified">Select / Unspecified</option>
                            <option value="Female">Female</option>
                            <option value="Male">Male</option>
                            <option value="Non-Binary">Non-Binary</option>
                        </select>
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Parent / Guardian Name *</label>
                        <input class="input-field" @bind="Inquiry.ParentGuardianName" placeholder="e.g. Claire Sterling" />
                    </div>
                    <div class="form-group">
                        <label>Parent Email *</label>
                        <input type="email" class="input-field" @bind="Inquiry.ParentEmail" placeholder="claire@example.com" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Parent Phone *</label>
                        <input class="input-field" @bind="Inquiry.ParentPhone" placeholder="+1 (555) 019-2831" />
                    </div>
                    <div class="form-group">
                        <label>Desired Start Date</label>
                        <input type="date" class="input-field" @bind="Inquiry.DesiredStartDate" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Requested Schedule</label>
                        <select class="input-field" @bind="Inquiry.ScheduleType">
                            <option value="FullTime">Full-Time (Monday - Friday)</option>
                            <option value="PartTime_MWF">Part-Time (3 Days: Mon/Wed/Fri)</option>
                            <option value="PartTime_TTh">Part-Time (2 Days: Tue/Thu)</option>
                            <option value="HalfDay_Morning">Half-Day Morning</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Target Classroom</label>
                        <select class="input-field" @bind="Inquiry.TargetClassroomId">
                            <option value="">-- Auto-assess based on age --</option>
                            @foreach (var c in Classrooms)
                            {
                                <option value="@c.Id">@c.Name (@c.AgeGroup)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Monthly Tuition Rate ($)</label>
                        <input type="number" step="10" class="input-field" @bind="Inquiry.TuitionMonthlyRate" />
                    </div>
                    <div class="form-group">
                        <label>Sibling Discount (%)</label>
                        <input type="number" step="1" class="input-field" @bind="Inquiry.SiblingDiscountPercent" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Admissions Notes / Special Requirements</label>
                    <textarea class="input-field" style="height: 70px;" @bind="Inquiry.InternalNotes" placeholder="e.g. Inquired about dairy allergies, referred by current preschool family."></textarea>
                </div>
            </div>
            <div class="modal-footer-pipeline">
                <button class="btn secondary" @onclick="OnClose">Cancel</button>
                <button class="primary" @onclick="OnSave">Save Inquiry</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public CreateApplicationRequest Inquiry { get; set; } = new();
    [Parameter] public List<Classroom> Classrooms { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
