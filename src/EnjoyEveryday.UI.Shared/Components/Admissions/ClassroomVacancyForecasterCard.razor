@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services

<div class="vacancy-section-card">
    <div class="vacancy-header">
        <div>
            <h3 class="vacancy-title">Classroom Vacancy &amp; Opening Forecaster</h3>
            <p class="vacancy-subtitle">Check available spots by age group before extending an enrollment offer.</p>
        </div>
        <span class="spots-badge">
            @(Overview?.ClassroomVacancies.Sum(v => v.AvailableSpots) ?? 0) Total Open Spots
        </span>
    </div>

    <div class="vacancy-grid">
        @if (Overview?.ClassroomVacancies != null)
        {
            @foreach (var room in Overview.ClassroomVacancies)
            {
                <div class="vacancy-card">
                    <div class="room-header">
                        <div>
                            <span class="room-title">@room.ClassroomName</span>
                            <span class="room-tag">@room.AgeGroup</span>
                        </div>
                        <span class="badge-status @room.StatusBadge.ToLowerInvariant()">
                            @room.StatusBadge (@room.AvailableSpots spots)
                        </span>
                    </div>
                    <div class="capacity-meter-bar">
                        <div class="capacity-meter-fill" style="width: @(room.Capacity > 0 ? Math.Min(100, (double)room.CurrentEnrolled / room.Capacity * 100) : 0)%;"></div>
                    </div>
                    <div class="vacancy-footer">
                        <span>Enrolled: <strong>@room.CurrentEnrolled / @room.Capacity</strong></span>
                        @if (room.PendingOffers > 0)
                        {
                            <span class="pending-offers">(@room.PendingOffers pending offers)</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public PipelineOverviewDto? Overview { get; set; }
}
