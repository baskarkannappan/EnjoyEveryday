@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services

<div class="pipeline-metrics-grid">
    <div class="metric-card metric-inquiries">
        <span class="metric-label">Active Inquiries &amp; Leads</span>
        <span class="metric-value">@(Overview?.EnquiriesCount ?? 0)</span>
        <span class="metric-sub">Prospective families in early review</span>
    </div>
    <div class="metric-card metric-tours">
        <span class="metric-label">Scheduled Visits &amp; Tours</span>
        <span class="metric-value">@(Overview?.ToursScheduledCount ?? 0)</span>
        <span class="metric-sub">Upcoming parent classroom walkthroughs</span>
    </div>
    <div class="metric-card metric-review">
        <span class="metric-label">Under Admissions Review</span>
        <span class="metric-value">@(Overview?.ApplicationsReviewCount ?? 0)</span>
        <span class="metric-sub">Classroom fit &amp; ratio verification</span>
    </div>
    <div class="metric-card metric-tuition">
        <span class="metric-label">Projected Monthly Tuition</span>
        <span class="metric-value">@((Overview?.TotalPipelineProjectedValue ?? 0).ToString("C0"))</span>
        <span class="metric-sub">Combined value across admissions pipeline</span>
    </div>
</div>

@code {
    [Parameter] public PipelineOverviewDto? Overview { get; set; }
}
