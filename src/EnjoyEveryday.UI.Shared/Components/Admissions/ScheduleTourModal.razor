@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services

@if (IsOpen && Application != null)
{
    <div class="modal-backdrop-pipeline" @onclick="OnClose">
        <div class="modal-card-pipeline" @onclick:stopPropagation="true" style="max-width: 480px;">
            <div class="modal-header-pipeline">
                <h3 class="modal-title">Schedule Campus Tour</h3>
                <button class="close-x" @onclick="OnClose">✕</button>
            </div>
            <div class="modal-body-pipeline">
                <p class="modal-intro">
                    Booking visit for <strong>@Application.ChildFullName</strong> with guardian <strong>@Application.ParentGuardianName</strong>.
                </p>
                <div class="form-group">
                    <label>Tour Date &amp; Time *</label>
                    <input type="datetime-local" class="input-field" @bind="TourDateTime" />
                </div>
                <div class="form-group">
                    <label>Tour Preparation Notes</label>
                    <textarea class="input-field" style="height: 70px;" @bind="TourNotes" placeholder="e.g. Introduce to lead infant teacher, tour outdoor play yard."></textarea>
                </div>
            </div>
            <div class="modal-footer-pipeline">
                <button class="btn secondary" @onclick="OnClose">Cancel</button>
                <button class="primary" @onclick="HandleConfirm">Confirm Tour</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EnrollmentPipelineApplicationDto? Application { get; set; }
    [Parameter] public DateTime TourDateTime { get; set; }
    [Parameter] public EventCallback<DateTime> TourDateTimeChanged { get; set; }
    [Parameter] public string TourNotes { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TourNotesChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private async Task HandleConfirm()
    {
        await OnSave.InvokeAsync();
    }
}
