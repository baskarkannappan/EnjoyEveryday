@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services

<div class="app-card">
    <!-- Subtle Whimsical Sky/Rainbow Corner (Top-Right) -->
    <div class="app-card-deco-rainbow" aria-hidden="true">
        <svg width="125" height="90" viewBox="0 0 125 90" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M 12 90 A 70 70 0 0 1 112 90" stroke="#f87171" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
            <path d="M 20 90 A 62 62 0 0 1 104 90" stroke="#fbbf24" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
            <path d="M 28 90 A 54 54 0 0 1 96 90" stroke="#34d399" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
            <path d="M 36 90 A 46 46 0 0 1 88 90" stroke="#60a5fa" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
            <path d="M 44 90 A 38 38 0 0 1 80 90" stroke="#a78bfa" stroke-width="6" stroke-linecap="round" opacity="0.6"/>
            <!-- Twinkling stars -->
            <polygon points="16,36 18,40 22,40 19,43 20,47 16,44 12,47 13,43 10,40 14,40" fill="#facc15" opacity="0.8"/>
        </svg>
    </div>

    <div class="app-card-header">
        <div class="avatar-wrap">
            <div class="avatar-circle">
                @(string.IsNullOrWhiteSpace(Application.ChildFirstName) ? "C" : Application.ChildFirstName[0].ToString().ToUpper())
            </div>
            <span class="avatar-verified-badge">✓</span>
        </div>
        <div class="header-content">
            <div class="name-stage-row">
                <h4 class="child-name">@Application.ChildFullName</h4>
                <span class="stage-pill @Application.PipelineStage.ToLowerInvariant()">
                    <span class="stage-check">✓</span>
                    <span>@GetStageDisplayName(Application.PipelineStage)</span>
                </span>
            </div>
            <div class="child-meta">
                <span>Age: <strong>@Application.AgeInMonths mos</strong></span>
                <span>&bull;</span>
                <span>DOB: @Application.DateOfBirth.ToString("MMM dd, yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(Application.Gender))
                {
                    <span>&bull;</span>
                    <span>@Application.Gender</span>
                }
            </div>
        </div>
    </div>

    <div class="app-body">
        <!-- 2x2 Grid of Key Information with Icons -->
        <div class="app-info-grid">
            <div class="info-cell">
                <div class="info-icon-box user-box">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div class="info-text-group">
                    <span class="info-cell-label">Parent / Guardian</span>
                    <strong class="info-cell-val">@Application.ParentGuardianName</strong>
                </div>
            </div>

            <div class="info-cell">
                <div class="info-icon-box phone-box">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <div class="info-text-group">
                    <span class="info-cell-label">Contact</span>
                    <span class="info-cell-val contact-val">@Application.ParentEmail | @Application.ParentPhone</span>
                </div>
            </div>

            <div class="info-cell">
                <div class="info-icon-box room-box">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </div>
                <div class="info-text-group">
                    <span class="info-cell-label">Room &amp; Schedule</span>
                    <span class="info-cell-val">
                        @(Application.TargetClassroomName ?? "Adyar Toddlers")
                        <span class="schedule-pill">@FormatSchedule(Application.ScheduleType)</span>
                    </span>
                </div>
            </div>

            <div class="info-cell">
                <div class="info-icon-box tuition-box">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                </div>
                <div class="info-text-group">
                    <span class="info-cell-label">Tuition Plan</span>
                    <strong class="info-cell-val tuition-highlight">
                        @Application.EffectiveMonthlyRate.ToString("C0")/mo
                        @if (Application.SiblingDiscountPercent > 0)
                        {
                            <span class="discount-pill">-@Application.SiblingDiscountPercent% Sibling</span>
                        }
                    </strong>
                </div>
            </div>
        </div>

        @if (Application.TourDate.HasValue)
        {
            <div class="tour-pill-bar">
                <div class="tour-left">
                    <span class="tour-icon">📅</span>
                    <span class="tour-label">Tour Scheduled:</span>
                </div>
                <div class="tour-right">
                    <span class="tour-date-val">📅 @Application.TourDate.Value.ToString("ddd, MMM dd @ h:mm tt")</span>
                    <span class="tour-arrow">&rsaquo;</span>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Application.InternalNotes))
        {
            <div class="notes-pill-card">
                <div class="notes-head">
                    <span class="notes-icon">📄</span>
                    <span class="notes-title">Admissions Notes</span>
                    <span class="notes-chevron">▾</span>
                </div>
                <p class="notes-text">@CleanNotes(Application.InternalNotes)</p>
            </div>
        }
    </div>

    <div class="app-card-footer">
        @if (Application.PipelineStage == "Enquiry")
        {
            <button class="btn secondary pill" @onclick="() => OnScheduleTour.InvokeAsync(Application)">
                📅 Schedule Tour
            </button>
            <button class="primary pill" @onclick='() => OnAdvanceStage.InvokeAsync((Application.Id, "ApplicationSubmitted"))'>
                Submit Application &rarr;
            </button>
        }
        else if (Application.PipelineStage == "TourScheduled")
        {
            <button class="btn secondary pill" @onclick="() => OnScheduleTour.InvokeAsync(Application)">
                Reschedule Tour
            </button>
            <button class="primary pill" @onclick='() => OnAdvanceStage.InvokeAsync((Application.Id, "UnderReview"))'>
                Tour Complete &amp; Review &rarr;
            </button>
        }
        else if (Application.PipelineStage == "ApplicationSubmitted" || Application.PipelineStage == "UnderReview")
        {
            <button class="btn secondary pill" @onclick='() => OnAdvanceStage.InvokeAsync((Application.Id, "Waitlisted"))'>
                Waitlist
            </button>
            <button class="primary pill" @onclick='() => OnAdvanceStage.InvokeAsync((Application.Id, "OfferSent"))'>
                Extend Offer ✉️
            </button>
        }
        else if (Application.PipelineStage == "OfferSent")
        {
            <button class="primary pill full-width" @onclick="() => OnAcceptOffer.InvokeAsync(Application)">
                ✓ Accept Offer &amp; Finalize Tuition Contract
            </button>
        }
        else if (Application.PipelineStage == "Enrolled")
        {
            <div class="enrolled-status-bar">
                <span class="enrolled-badge">✓ Actively Enrolled Child</span>
                <a href="/children" class="btn secondary pill link-btn">
                    View in Child Directory
                </a>
            </div>
        }
        else
        {
            <button class="btn secondary pill" @onclick='() => OnAdvanceStage.InvokeAsync((Application.Id, "UnderReview"))'>
                Re-open Application
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EnrollmentPipelineApplicationDto Application { get; set; } = default!;
    [Parameter] public EventCallback<EnrollmentPipelineApplicationDto> OnScheduleTour { get; set; }
    [Parameter] public EventCallback<(Guid AppId, string NextStage)> OnAdvanceStage { get; set; }
    [Parameter] public EventCallback<EnrollmentPipelineApplicationDto> OnAcceptOffer { get; set; }

    private static string GetStageDisplayName(string stage) => stage switch
    {
        "Enquiry" => "New Enquiry",
        "TourScheduled" => "Tour Booked",
        "ApplicationSubmitted" => "Applied",
        "UnderReview" => "Under Review",
        "OfferSent" => "Offer Extended",
        "Enrolled" => "Enrolled Active",
        "Waitlisted" => "Waitlisted",
        "Declined" => "Closed / Declined",
        _ => stage
    };

    private static string FormatSchedule(string scheduleType) => scheduleType switch
    {
        "FullTime" => "Full-Time (M-F)",
        "PartTime_MWF" => "Part-Time (MWF)",
        "PartTime_TTh" => "Part-Time (T/Th)",
        "HalfDay_Morning" => "Half-Day (Mornings)",
        _ => scheduleType
    };

    private static string CleanNotes(string? rawNotes)
    {
        if (string.IsNullOrWhiteSpace(rawNotes)) return string.Empty;
        var lines = rawNotes.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Where(l => !l.Contains("Contract ID", StringComparison.OrdinalIgnoreCase) &&
                        !l.Contains("Initial invoice created", StringComparison.OrdinalIgnoreCase));
        var cleaned = string.Join(" ", lines).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? rawNotes : cleaned;
    }
}
