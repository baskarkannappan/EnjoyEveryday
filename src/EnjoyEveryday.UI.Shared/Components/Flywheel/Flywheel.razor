@namespace EnjoyEveryday.UI.Shared.Components

<div class="flywheel">
    @for (int i = 0; i < Steps.Count; i++)
    {
        var step = Steps[i];
        <div class="flywheel-step @(step.IsActive ? "active" : "")">
            <span>@(i + 1)</span>
            <strong>@step.Name</strong>
        </div>
        
        @if (i < Steps.Count - 1)
        {
            <span>→</span>
        }
    }
</div>

@code {
    [Parameter] public List<FlywheelStep> Steps { get; set; } = new();
}
