@namespace EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard
@using Microsoft.AspNetCore.Components.Forms

<div class="field" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem;">
    <div style="width: 80px; height: 80px; border-radius: 50%; background: #e4e7df; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
        {
            <img src="@Model.ProfilePhotoUrl" style="width: 100%; height: 100%; object-fit: cover;" />
        }
        else
        {
            <span style="color: #666; font-size: 2rem;">👤</span>
        }
    </div>
    <div style="flex-grow: 1;">
        <label>Profile Photo (Upload or Paste URL)</label>
        <div style="display: flex; gap: 10px; flex-direction: column;">
            <AvifImageUploader @bind-Value="Model.ProfilePhotoUrl" ButtonText="Upload Image (Auto-Converts to AVIF)" />
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 12px; color: #666;">OR</span>
                <input @bind="Model.ProfilePhotoUrl" type="text" placeholder="https://example.com/photo.jpg" style="flex-grow: 1;" />
            </div>
        </div>
    </div>
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>First Name</label>
    <input @bind="Model.FirstName" type="text" placeholder="e.g. Jane" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Last Name</label>
    <input @bind="Model.LastName" type="text" placeholder="e.g. Doe" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Preferred Name</label>
    <input @bind="Model.PreferredName" type="text" placeholder="Optional" />
</div>

@code {
    [Parameter] public TeacherCreationWizard.TeacherWizardModel Model { get; set; } = default!;
}