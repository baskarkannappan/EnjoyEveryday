@namespace EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard
@using Microsoft.AspNetCore.Components.Forms

<div class="field" style="margin-bottom: 1.5rem;">
    <label>Profile Photo</label>
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div style="width: 80px; height: 80px; border-radius: 14px; background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
            {
                <img src="@Model.ProfilePhotoUrl" style="width: 100%; height: 100%; object-fit: cover;" alt="Teacher photo" />
            }
            else
            {
                <span style="color: var(--accent-dark, #31523c); font-size: 2rem;">👤</span>
            }
        </div>
        <div style="flex: 1; min-width: 240px;">
            <div style="display: flex; gap: 10px; flex-direction: column;">
                <AvifImageUploader @bind-Value="Model.ProfilePhotoUrl" ButtonText="Upload Image (AVIF)" />
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 11px; color: var(--muted, #6c7870); font-weight: 700;">OR</span>
                    <input @bind="Model.ProfilePhotoUrl" type="text" placeholder="Paste image URL (https://...)" style="flex-grow: 1;" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="field" style="margin-bottom: 1.5rem;">
    <label>First Name</label>
    <input @bind="Model.FirstName" type="text" placeholder="e.g. Jane" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Last Name</label>
    <input @bind="Model.LastName" type="text" placeholder="e.g. Doe" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Preferred Name</label>
    <input @bind="Model.PreferredName" type="text" placeholder="Optional" />
</div>

@code {
    [Parameter] public TeacherCreationWizard.TeacherWizardModel Model { get; set; } = default!;
}