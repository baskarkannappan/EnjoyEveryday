@namespace EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard

@if (Model.Certifications.Any())
{
    <div style="margin-bottom: 2rem;">
        <h4 style="margin-bottom: 1rem; color: #52745e;">Added Certifications</h4>
        @foreach (var cert in Model.Certifications)
        {
            <div style="padding: 1rem; border: 1px solid #e4e7df; border-radius: 8px; margin-bottom: 0.5rem; background: #f9faf9;">
                <strong style="display: block;">@cert.CertificationName</strong>
                <span>@cert.IssuingAuthority (No: @cert.CertificateNumber)</span>
                <span style="color: #666; font-size: 0.85rem; margin-left: 0.5rem;">Exp: @cert.CertificationExpirationDate?.ToString("yyyy-MM-dd")</span>
            </div>
        }
    </div>
}

<h4 style="margin-bottom: 1rem; color: #52745e;">Add New Certification</h4>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Certification Name</label>
    <input @bind="_newCertification.CertificationName" type="text" placeholder="e.g. Standard Childcare Certificate" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Issuing Authority</label>
    <input @bind="_newCertification.IssuingAuthority" type="text" placeholder="e.g. State Board of Education" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Certificate Number</label>
    <input @bind="_newCertification.CertificateNumber" type="text" placeholder="e.g. 123456789" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Expiration Date</label>
    <input type="date" @bind="_newCertification.CertificationExpirationDate" />
</div>
<button type="button" class="secondary" @onclick="() => { Model.Certifications.Add(_newCertification); _newCertification = new(); }">Add Certification</button>

@code {
    [Parameter] public TeacherCreationWizard.TeacherWizardModel Model { get; set; } = default!;
    private TeacherCreationWizard.CertificationEntry _newCertification = new();
}
