@namespace EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard

@if (Model.Experiences.Any())
{
    <div style="margin-bottom: 2rem;">
        <h4 style="margin-bottom: 1rem; color: #52745e;">Added Experience</h4>
        @foreach (var exp in Model.Experiences)
        {
            <div style="padding: 1rem; border: 1px solid #e4e7df; border-radius: 8px; margin-bottom: 0.5rem; background: #f9faf9;">
                <strong style="display: block;">@exp.OrganizationName</strong>
                <span>@exp.Position (@exp.AgeGroup)</span>
                <span style="color: #666; font-size: 0.85rem; margin-left: 0.5rem;">Since: @exp.ExperienceStartDate?.ToString("MMM yyyy")</span>
            </div>
        }
    </div>
}

<h4 style="margin-bottom: 1rem; color: #52745e;">Add New Experience</h4>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Organization Name</label>
    <input @bind="_newExperience.OrganizationName" type="text" placeholder="e.g. Sunny Days Academy" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Position</label>
    <input @bind="_newExperience.Position" type="text" placeholder="e.g. Lead Teacher" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Age Group</label>
    <input @bind="_newExperience.AgeGroup" type="text" placeholder="e.g. Toddlers (1-3 yrs)" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Start Date</label>
    <input type="date" @bind="_newExperience.ExperienceStartDate" />
</div>
<button type="button" class="secondary" @onclick="() => { Model.Experiences.Add(_newExperience); _newExperience = new(); }">Add Experience</button>

@code {
    [Parameter] public TeacherCreationWizard.TeacherWizardModel Model { get; set; } = default!;
    private TeacherCreationWizard.ExperienceEntry _newExperience = new();
}
