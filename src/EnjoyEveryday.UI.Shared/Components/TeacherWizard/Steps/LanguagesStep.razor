@namespace EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard

@if (Model.Languages.Any())
{
    <div style="margin-bottom: 2rem;">
        <h4 style="margin-bottom: 1rem; color: #52745e;">Added Languages</h4>
        @foreach (var lang in Model.Languages)
        {
            <div style="padding: 1rem; border: 1px solid #e4e7df; border-radius: 8px; margin-bottom: 0.5rem; background: #f9faf9;">
                <strong style="display: block;">@lang.Language</strong>
                <span>@lang.Proficiency</span>
                @if (lang.IsPrimaryLanguage)
                {
                    <span style="color: #52745e; font-size: 0.85rem; margin-left: 0.5rem; font-weight: bold;">(Primary)</span>
                }
            </div>
        }
    </div>
}

<h4 style="margin-bottom: 1rem; color: #52745e;">Add New Language</h4>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Language</label>
    <input @bind="_newLanguage.Language" type="text" placeholder="e.g. Spanish" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Proficiency</label>
    <select @bind="_newLanguage.Proficiency">
        <option value="">Select...</option>
        <option value="Native">Native</option>
        <option value="Fluent">Fluent</option>
        <option value="Intermediate">Intermediate</option>
        <option value="Beginner">Beginner</option>
    </select>
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; text-transform: none; font-weight: normal; color: #26332d; font-size: 14px;">
        <input type="checkbox" @bind="_newLanguage.IsPrimaryLanguage" style="width: auto;" /> <span>This is the primary language</span>
    </label>
</div>
<button type="button" class="secondary" @onclick="() => { Model.Languages.Add(_newLanguage); _newLanguage = new(); }">Add Language</button>

@code {
    [Parameter] public TeacherCreationWizard.TeacherWizardModel Model { get; set; } = default!;
    private TeacherCreationWizard.LanguageEntry _newLanguage = new();
}
