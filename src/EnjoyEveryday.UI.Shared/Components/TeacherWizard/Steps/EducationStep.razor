@namespace EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard

@if (Model.Educations.Any())
{
    <div style="margin-bottom: 2rem;">
        <h4 style="margin-bottom: 1rem; color: #52745e;">Added Education</h4>
        @foreach (var ed in Model.Educations)
        {
            <div style="padding: 1rem; border: 1px solid #e4e7df; border-radius: 8px; margin-bottom: 0.5rem; background: #f9faf9;">
                <strong style="display: block;">@ed.InstitutionName</strong>
                <span>@ed.Degree in @ed.FieldOfStudy</span>
                <span style="color: #666; font-size: 0.85rem; margin-left: 0.5rem;">(@ed.GraduationYear)</span>
            </div>
        }
    </div>
}

<h4 style="margin-bottom: 1rem; color: #52745e;">Add New Education</h4>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Institution Name</label>
    <input @bind="_newEducation.InstitutionName" type="text" placeholder="e.g. University of Example" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Degree / Diploma</label>
    <input @bind="_newEducation.Degree" type="text" placeholder="e.g. Bachelor of Early Childhood Education" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Field of Study</label>
    <input @bind="_newEducation.FieldOfStudy" type="text" placeholder="e.g. Education" />
</div>
<div class="field" style="margin-bottom: 1.5rem;">
    <label>Graduation Year</label>
    <input @bind="_newEducation.GraduationYear" type="number" placeholder="e.g. 2020" />
</div>
<button type="button" class="secondary" @onclick="() => { Model.Educations.Add(_newEducation); _newEducation = new(); }">Add Education</button>

@code {
    [Parameter] public TeacherCreationWizard.TeacherWizardModel Model { get; set; } = default!;
    private TeacherCreationWizard.EducationEntry _newEducation = new();
}
