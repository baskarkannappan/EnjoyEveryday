@namespace EnjoyEveryday.UI.Shared.Components
@using Microsoft.AspNetCore.Components

<div class="wizard">
    <!-- Sidebar -->
    <div class="wizard-sidebar">
        <WizardSidebar 
            Steps="@_steps" 
            CurrentStep="@_currentStep" 
            MaxAllowedStep="@_maxAllowedStep" 
            OnStepClicked="NavigateToStep" />
    </div>

    <!-- Content -->
    <div class="wizard-content">
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <div class="eyebrow">STEP @_currentStep</div>
            <div style="font-size: 0.85rem; font-weight: 600; color: #52745e;">
                Profile Completion: @GetCompletionPercentage()%
                <div style="width: 100px; height: 6px; background: #e4e7df; border-radius: 3px; display: inline-block; margin-left: 10px; vertical-align: middle;">
                    <div style="width: @GetCompletionPercentage()%; height: 100%; background: #52745e; border-radius: 3px;"></div>
                </div>
            </div>
        </div>
        <h3 style="margin: 0 0 24px 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">@_steps[_currentStep - 1]</h3>

        @if (_currentStep == 1)
        {
            <EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps.PersonalInfoStep Model="Model" />
        }
        else if (_currentStep == 2)
        {
            <EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps.ContactInfoStep Model="Model" />
        }
        else if (_currentStep == 3) // Emergency Contact
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Contact Name</label>
                <input @bind="Model.EmergencyContactName" type="text" placeholder="e.g. John Doe" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Relationship</label>
                <input @bind="Model.EmergencyContactRelationship" type="text" placeholder="e.g. Spouse" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Phone Number</label>
                <input @bind="Model.EmergencyContactPhone" type="tel" placeholder="e.g. (555) 987-6543" />
            </div>
        }
        else if (_currentStep == 3) // Emergency Contact
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Contact Name</label>
                <input @bind="Model.EmergencyContactName" type="text" placeholder="e.g. John Doe" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Relationship</label>
                <input @bind="Model.EmergencyContactRelationship" type="text" placeholder="e.g. Spouse" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Phone Number</label>
                <input @bind="Model.EmergencyContactPhone" type="tel" placeholder="e.g. (555) 987-6543" />
            </div>
        }
        else if (_currentStep == 4) // Employment
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Employee Number</label>
                <input @bind="Model.EmployeeNumber" type="text" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Job Title</label>
                <input @bind="Model.JobTitle" type="text" placeholder="e.g. Lead Teacher" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Employment Type</label>
                <select @bind="Model.EmploymentType">
                    <option value="">Select...</option>
                    <option value="Full-time">Full-time</option>
                    <option value="Part-time">Part-time</option>
                    <option value="Substitute">Substitute</option>
                </select>
            </div>
        }
        else if (_currentStep == 5) // Qualifications
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Highest Qualification Achieved</label>
                <select @bind="Model.HighestQualification">
                    <option value="">Select...</option>
                    <option value="High School">High School Diploma</option>
                    <option value="Associate Degree">Associate Degree</option>
                    <option value="Bachelor Degree">Bachelor Degree</option>
                    <option value="Master Degree">Master Degree</option>
                    <option value="Doctorate">Doctorate</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; text-transform: none; font-weight: normal; color: #26332d; font-size: 14px;">
                    <input type="checkbox" @bind="Model.MeetsStateRequirements" style="width: auto;" /> <span>Meets state minimum childcare requirements</span>
                </label>
            </div>
        }
        else if (_currentStep == 5) // Qualifications
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Highest Qualification Achieved</label>
                <select @bind="Model.HighestQualification">
                    <option value="">Select...</option>
                    <option value="High School">High School Diploma</option>
                    <option value="Associate Degree">Associate Degree</option>
                    <option value="Bachelor Degree">Bachelor Degree</option>
                    <option value="Master Degree">Master Degree</option>
                    <option value="Doctorate">Doctorate</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; text-transform: none; font-weight: normal; color: #26332d; font-size: 14px;">
                    <input type="checkbox" @bind="Model.MeetsStateRequirements" style="width: auto;" /> <span>Meets state minimum childcare requirements</span>
                </label>
            </div>
        }
        else if (_currentStep == 6) // Education
        {
            <EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps.EducationStep Model="Model" />
        }
        else if (_currentStep == 7) // Certifications
        {
            <EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps.CertificationsStep Model="Model" />
        }
        else if (_currentStep == 8) // Skills
        {
            <p style="margin-bottom: 1.5rem; color: #666;">Select the skills this teacher possesses.</p>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSkillStorytelling" /> <span>Storytelling</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSkillMusic" /> <span>Music & Arts</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSkillOutdoor" /> <span>Outdoor Learning</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSkillFirstAid" /> <span>First Aid / CPR</span>
                </label>
            </div>
        }
        else if (_currentStep == 9) // Experience
        {
            <EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps.ExperienceStep Model="Model" />
        }
        else if (_currentStep == 10) // Languages
        {
            <EnjoyEveryday.UI.Shared.Components.TeacherWizard.Steps.LanguagesStep Model="Model" />
        }
        else if (_currentStep == 11) // Childcare Specialties
        {
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSpecialtyInfantCare" /> <span>Infant Care</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSpecialtySpecialNeeds" /> <span>Special Needs</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.HasSpecialtyMontessori" /> <span>Montessori Method</span>
                </label>
            </div>
            
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Specialty Level</label>
                <input @bind="Model.SpecialtyLevel" type="text" placeholder="e.g. Certified Specialist" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Years of Experience in Specialty</label>
                <input @bind="Model.SpecialtyYearsExperience" type="number" placeholder="e.g. 5" />
            </div>
        }
        else if (_currentStep == 12) // Classroom Assignments
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Assign to Branch</label>
                <select @bind="Model.AssignedBranch">
                    @if (AvailableBranches == null || !AvailableBranches.Any())
                    {
                        <option value="">Default Branch</option>
                    }
                    else
                    {
                        <option value="">Select Branch...</option>
                        @foreach(var b in AvailableBranches)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Assign to Classroom</label>
                <select @bind="Model.AssignedClassroom" disabled="@(string.IsNullOrWhiteSpace(Model.AssignedBranch) && AvailableBranches != null && AvailableBranches.Any())">
                    <option value="">Select Classroom...</option>
                    @if (AvailableClassrooms != null)
                    {
                        @foreach(var c in AvailableClassrooms.Where(c => string.IsNullOrWhiteSpace(Model.AssignedBranch) || c.BranchId.ToString() == Model.AssignedBranch))
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; text-transform: none; font-weight: normal; color: #26332d; font-size: 14px;">
                    <input type="checkbox" @bind="Model.IsPrimaryTeacher" style="width: auto;" /> <span>Set as Primary Teacher for this classroom</span>
                </label>
            </div>
        }
        else if (_currentStep == 13) // Work Schedule
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Day of Week</label>
                <select @bind="Model.ScheduleDayOfWeek">
                    <option value="">Select Day...</option>
                    <option value="Monday">Monday</option>
                    <option value="Tuesday">Tuesday</option>
                    <option value="Wednesday">Wednesday</option>
                    <option value="Thursday">Thursday</option>
                    <option value="Friday">Friday</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Start Time</label>
                <input type="time" @bind="Model.ScheduleStartTime" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>End Time</label>
                <input type="time" @bind="Model.ScheduleEndTime" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Shift Type</label>
                <input @bind="Model.ScheduleShiftType" type="text" placeholder="e.g. Morning Shift" />
            </div>
        }
        else if (_currentStep == 14) // Availability
        {
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.CanWorkMornings" /> <span>Available Mornings</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.CanWorkAfternoons" /> <span>Available Afternoons</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.CanWorkEvenings" /> <span>Available Evenings</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.CanWorkWeekends" /> <span>Available Weekends</span>
                </label>
            </div>
            
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Maximum Hours per Week</label>
                <input @bind="Model.MaxHoursPerWeek" type="number" placeholder="e.g. 40" />
            </div>
        }
        else if (_currentStep == 15) // Professional Development
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Course Name</label>
                <input @bind="Model.PdCourseName" type="text" placeholder="e.g. Advanced Child Psychology" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Provider</label>
                <input @bind="Model.PdProvider" type="text" placeholder="e.g. National Education Assoc." />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Hours Completed</label>
                <input @bind="Model.PdHoursCompleted" type="number" step="0.5" placeholder="e.g. 10.5" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Completion Date</label>
                <input type="date" @bind="Model.PdCompletionDate" />
            </div>
        }
        else if (_currentStep == 16) // Documents
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Document Type</label>
                <select @bind="Model.DocumentType">
                    <option value="">Select Type...</option>
                    <option value="Resume">Resume</option>
                    <option value="Background Check">Background Check</option>
                    <option value="ID Proof">ID Proof</option>
                    <option value="Contract">Contract</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Upload File</label>
                <input type="file" @bind="Model.DocumentFileName" style="padding: 9px 14px;" />
                <p style="font-size: 11px; color: #666; margin-top: 4px;">For demonstration, just the filename is bound.</p>
            </div>
        }
        else if (_currentStep == 17) // Training
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Training Name</label>
                <input @bind="Model.TrainingName" type="text" placeholder="e.g. Annual Fire Safety" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Status</label>
                <select @bind="Model.TrainingStatus">
                    <option value="">Select Status...</option>
                    <option value="Not Started">Not Started</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Completion Date</label>
                <input type="date" @bind="Model.TrainingCompletionDate" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; text-transform: none; font-weight: normal; color: #26332d; font-size: 14px;">
                    <input type="checkbox" @bind="Model.IsTrainingMandatory" style="width: auto;" /> <span>This training is mandatory</span>
                </label>
            </div>
        }
        else if (_currentStep == 18) // Permissions
        {
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.CanEditCurriculum" /> <span>Can Edit Curriculum</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.CanViewAllChildren" /> <span>Can View All Children in Branch</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="Model.IsSystemAdmin" /> <span style="color: red; font-weight: bold;">Is System Administrator</span>
                </label>
            </div>
        }
        else if (_currentStep == 19) // Status
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Teacher Profile Status</label>
                <select @bind="Model.TeacherStatus">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="On Leave">On Leave</option>
                    <option value="Probation">Probation</option>
                </select>
            </div>
        }
        else if (_currentStep == 20) // Observations
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Last Observation Date</label>
                <input type="date" @bind="Model.LastObservationDate" />
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Rating</label>
                <select @bind="Model.ObservationRating">
                    <option value="">Select Rating...</option>
                    <option value="Excellent">Excellent</option>
                    <option value="Good">Good</option>
                    <option value="Needs Improvement">Needs Improvement</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Feedback</label>
                <textarea @bind="Model.ObservationFeedback" rows="4" placeholder="Enter observation feedback here..."></textarea>
            </div>
        }
        else if (_currentStep == 21) // Preferences
        {
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Preferred Age Group</label>
                <select @bind="Model.PreferredAgeGroup">
                    <option value="">Select...</option>
                    <option value="Infants">Infants (0-1 yr)</option>
                    <option value="Toddlers">Toddlers (1-3 yrs)</option>
                    <option value="Preschool">Preschool (3-5 yrs)</option>
                </select>
            </div>
            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Preferred Schedule</label>
                <input @bind="Model.PreferredSchedule" type="text" placeholder="e.g. Morning Shifts Only" />
            </div>
        }
        else if (_currentStep == _steps.Count) // Review
        {
            <div style="background: #f9f9f9; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
                <div style="margin-bottom: 1rem;">
                    <strong style="display: block; font-size: 0.85rem; color: #666; text-transform: uppercase;">Name</strong>
                    <div>@Model.FirstName @Model.LastName</div>
                </div>
                <div style="margin-bottom: 1rem;">
                    <strong style="display: block; font-size: 0.85rem; color: #666; text-transform: uppercase;">Email</strong>
                    <div>@Model.Email</div>
                </div>
                <div style="margin-bottom: 1rem;">
                    <strong style="display: block; font-size: 0.85rem; color: #666; text-transform: uppercase;">Job Title</strong>
                    <div>@Model.JobTitle</div>
                </div>
            </div>
            
            <p>Click "Activate" to save the teacher profile.</p>
        }
        else
        {
            <p style="color: #666; font-style: italic;">Placeholder for @_steps[_currentStep - 1] form fields. These will be implemented later according to requirements.</p>
        }

        <div style="border-top: 1px solid var(--border, #e4e7df); padding-top: 1.5rem; margin-top: 2rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <button class="secondary" @onclick="HandleCancel">Cancel</button>
                @if (!string.IsNullOrEmpty(_validationError))
                {
                    <span style="color: red; margin-left: 1rem; font-size: 0.9rem;">@_validationError</span>
                }
            </div>
            
            <div style="display: flex; gap: 1rem;">
                @if (_currentStep > 1)
                {
                    <button class="secondary" @onclick="GoBack">Back</button>
                }
                
                <button class="secondary" @onclick="HandleSaveDraft">Save Draft</button>
                
                @if (_currentStep < _steps.Count)
                {
                    <button class="primary" @onclick="GoNext">Next</button>
                }
                else
                {
                    <button class="primary" @onclick="HandleActivate">Activate</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public TeacherWizardModel Model { get; set; } = new();
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TeacherWizardModel> OnSaveDraft { get; set; }
    [Parameter] public EventCallback<TeacherWizardModel> OnActivate { get; set; }
    [Parameter] public List<EnjoyEveryday.Domain.Entities.Classroom>? AvailableClassrooms { get; set; }
    [Parameter] public List<EnjoyEveryday.Domain.Entities.Branch>? AvailableBranches { get; set; }

    protected override void OnParametersSet()
    {
        // When model is loaded with existing data, allow navigating up to the first invalid step
        if (_maxAllowedStep == 1)
        {
            int maxValid = 1;
            while (maxValid < _steps.Count)
            {
                int previousStep = _currentStep;
                _currentStep = maxValid;
                bool isValid = IsCurrentStepValid();
                _currentStep = previousStep;
                
                if (isValid)
                {
                    maxValid++;
                }
                else
                {
                    break;
                }
            }
            _validationError = null; // Clear any side-effect from checking
            _maxAllowedStep = maxValid;
        }
    }

    private int _currentStep = 1;
    private int _maxAllowedStep = 1;
    private List<string> _steps = new() 
    { 
        "Personal Information", "Contact Information", "Emergency Contact", "Employment Information", 
        "Qualifications", "Education", "Certifications", "Skills", "Experience", "Languages", 
        "Childcare Specialties", "Classroom Assignments", "Work Schedule", "Availability", 
        "Professional Development", "Documents", "Training", "Permissions", "Status", 
        "Performance & Observations", "Teacher Preferences", "Review & Activate" 
    };

    public class TeacherWizardModel
    {
        public string ProfilePhotoUrl { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string PreferredName { get; set; } = "";
        
        public string EmployeeNumber { get; set; } = "";
        public string JobTitle { get; set; } = "";
        public string EmploymentType { get; set; } = "";
        
        // Emergency Contact
        public string EmergencyContactName { get; set; } = "";
        public string EmergencyContactRelationship { get; set; } = "";
        public string EmergencyContactPhone { get; set; } = "";

        // Qualifications
        public string HighestQualification { get; set; } = "";
        public bool MeetsStateRequirements { get; set; }
        
        public bool HasSkillStorytelling { get; set; }
        public bool HasSkillMusic { get; set; }
        public bool HasSkillOutdoor { get; set; }
        public bool HasSkillFirstAid { get; set; }

        // Education
        public List<EducationEntry> Educations { get; set; } = new();

        // Certification
        public List<CertificationEntry> Certifications { get; set; } = new();

        // Experience
        public List<ExperienceEntry> Experiences { get; set; } = new();
        
        // Language
        public List<LanguageEntry> Languages { get; set; } = new();
        
        // Childcare Specialties
        public string SpecialtyLevel { get; set; } = "";
        public int? SpecialtyYearsExperience { get; set; }
        public bool HasSpecialtyInfantCare { get; set; }
        public bool HasSpecialtySpecialNeeds { get; set; }
        public bool HasSpecialtyMontessori { get; set; }

        // Classroom Assignments
        public string AssignedBranch { get; set; } = "";
        public string AssignedClassroom { get; set; } = "";
        public bool IsPrimaryTeacher { get; set; }

        // Work Schedule
        public string ScheduleDayOfWeek { get; set; } = "";
        public TimeOnly? ScheduleStartTime { get; set; }
        public TimeOnly? ScheduleEndTime { get; set; }
        public string ScheduleShiftType { get; set; } = "";

        // Availability
        public bool CanWorkMornings { get; set; }
        public bool CanWorkAfternoons { get; set; }
        public bool CanWorkEvenings { get; set; }
        public bool CanWorkWeekends { get; set; }
        public int MaxHoursPerWeek { get; set; }

        // Professional Development
        public string PdCourseName { get; set; } = "";
        public string PdProvider { get; set; } = "";
        public decimal PdHoursCompleted { get; set; }
        public DateTime? PdCompletionDate { get; set; }

        // Documents
        public string DocumentType { get; set; } = "";
        public string DocumentFileName { get; set; } = ""; // Normally handled via InputFile but simulated here

        // Training
        public string TrainingName { get; set; } = "";
        public bool IsTrainingMandatory { get; set; }
        public DateTime? TrainingCompletionDate { get; set; }
        public string TrainingStatus { get; set; } = "";

        // Permissions
        public bool CanEditCurriculum { get; set; }
        public bool CanViewAllChildren { get; set; }
        public bool IsSystemAdmin { get; set; }

        // Status
        public string TeacherStatus { get; set; } = "Active";

        // Observations
        public string ObservationRating { get; set; } = "";
        public string ObservationFeedback { get; set; } = "";
        public DateTime? LastObservationDate { get; set; }

        // Preferences
        public string PreferredAgeGroup { get; set; } = "";
        public string PreferredSchedule { get; set; } = "";

        public int GetCompletionPercentage()
        {
            int totalFields = 15;
            int filledFields = 0;
            
            if (!string.IsNullOrWhiteSpace(FirstName)) filledFields++;
            if (!string.IsNullOrWhiteSpace(LastName)) filledFields++;
            if (!string.IsNullOrWhiteSpace(Email)) filledFields++;
            if (!string.IsNullOrWhiteSpace(EmergencyContactName)) filledFields++;
            if (!string.IsNullOrWhiteSpace(JobTitle)) filledFields++;
            if (!string.IsNullOrWhiteSpace(HighestQualification)) filledFields++;
            if (Educations.Any()) filledFields++;
            if (Certifications.Any()) filledFields++;
            if (Experiences.Any()) filledFields++;
            if (Languages.Any()) filledFields++;
            if (!string.IsNullOrWhiteSpace(AssignedClassroom)) filledFields++;
            if (!string.IsNullOrWhiteSpace(ScheduleShiftType)) filledFields++;
            if (!string.IsNullOrWhiteSpace(PdCourseName)) filledFields++;
            if (!string.IsNullOrWhiteSpace(TrainingName)) filledFields++;
            if (!string.IsNullOrWhiteSpace(TeacherStatus)) filledFields++;

            double percentage = (double)filledFields / totalFields * 100;
            return (int)Math.Round(percentage);
        }
    }

    private void NavigateToStep(int step)
    {
        if (step <= _maxAllowedStep)
        {
            _currentStep = step;
        }
    }

    private bool IsCurrentStepValid()
    {
        switch (_currentStep)
        {
            case 1: // Personal Info
                if (string.IsNullOrWhiteSpace(Model.FirstName) || string.IsNullOrWhiteSpace(Model.LastName))
                {
                    _validationError = "First Name and Last Name are required.";
                    return false;
                }
                break;
            case 2: // Contact Info
                if (string.IsNullOrWhiteSpace(Model.Email))
                {
                    _validationError = "Email is required.";
                    return false;
                }
                break;
            // Add more cases for other steps as needed
        }
        
        _validationError = null;
        return true;
    }

    private string? _validationError;

    private void GoNext()
    {
        if (!IsCurrentStepValid()) return;

        if (_currentStep < _steps.Count)
        {
            _currentStep++;
            if (_currentStep > _maxAllowedStep)
            {
                _maxAllowedStep = _currentStep;
            }
        }
    }

    private void GoBack()
    {
        if (_currentStep > 1)
        {
            _currentStep--;
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }

    private async Task HandleSaveDraft()
    {
        if (OnSaveDraft.HasDelegate)
            await OnSaveDraft.InvokeAsync(Model);
    }

    private async Task HandleActivate()
    {
        if (OnActivate.HasDelegate)
            await OnActivate.InvokeAsync(Model);
    }

    private int GetCompletionPercentage() => Model.GetCompletionPercentage();

