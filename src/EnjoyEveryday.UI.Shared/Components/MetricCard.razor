@namespace EnjoyEveryday.UI.Shared.Components

<div class="metric">
    <small>@Label</small>
    <strong>@Value</strong>
    <span>@Subtext</span>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Subtext { get; set; } = "";
}
