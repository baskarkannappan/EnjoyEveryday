@namespace EnjoyEveryday.UI.Shared.Components

<div class="section-card ai-card">
    <div class="ai-header">
        <div class="ai-icon">✦</div>
        <div>
            <strong>@Title</strong>
            <small>@Subtitle</small>
        </div>
    </div>
    <div class="ai-message">
        @Message
    </div>
    <button class="ai-action" @onclick="OnActionClick">
        @ButtonText &rarr;
    </button>
</div>

@code {
    [Parameter] public string Title { get; set; } = "EnjoyEveryday Intelligence";
    [Parameter] public string Subtitle { get; set; } = "Watching the month with you";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "Add suggestion";
    [Parameter] public EventCallback OnActionClick { get; set; }
}
