@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
                <div>
                    <div class="eyebrow">@(IsEditing ? "EDIT" : "ADD")</div>
                    <h3 style="margin: 0 0 8px 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">@(IsEditing ? "Edit Classroom" : "Add Classroom")</h3>
                </div>
                <button class="modal-close" @onclick="OnClose">✕</button>
            </div>

            <div class="field" style="margin-bottom: 1rem;">
                <label>Name</label>
                <input value="@Name" @onchange="@(e => NameChanged.InvokeAsync(e.Value?.ToString()))" type="text" placeholder="e.g. Bluebirds" />
            </div>

            <div class="field" style="margin-bottom: 1rem;">
                <label>Age Group</label>
                <input value="@AgeGroup" @onchange="@(e => AgeGroupChanged.InvokeAsync(e.Value?.ToString()))" type="text" placeholder="e.g. 3-4" />
            </div>

            <div class="field" style="margin-bottom: 1.5rem;">
                <label>Capacity</label>
                <input type="number" value="@Capacity" @onchange="@(e => { if(int.TryParse(e.Value?.ToString(), out var c)) CapacityChanged.InvokeAsync(c); else CapacityChanged.InvokeAsync(null); })" />
            </div>

            <div style="border-top: 1px solid var(--border, #e4e7df); padding-top: 1.5rem; display: flex; justify-content: flex-end; gap: 1rem;">
                @if (IsEditing)
                {
                    <button type="button" class="secondary" style="border-color: #ff4d4d; color: #ff4d4d; margin-right: auto;" @onclick="OnDelete">Delete</button>
                }
                <button type="button" class="secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="primary" @onclick="OnSave">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public string? Name { get; set; }
    [Parameter] public EventCallback<string?> NameChanged { get; set; }

    [Parameter] public string? AgeGroup { get; set; }
    [Parameter] public EventCallback<string?> AgeGroupChanged { get; set; }

    [Parameter] public int? Capacity { get; set; }
    [Parameter] public EventCallback<int?> CapacityChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
