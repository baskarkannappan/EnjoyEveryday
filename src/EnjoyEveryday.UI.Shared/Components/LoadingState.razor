@namespace EnjoyEveryday.UI.Shared.Components

<div class="loading-state-container" style="min-height: @(MinHeightPx)px; @(Center ? "display: flex; flex-direction: column; align-items: center; justify-content: center;" : "")">
    <div class="loading-spinner"></div>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="loading-message">@Message</p>
    }
    @if (!string.IsNullOrWhiteSpace(SubMessage))
    {
        <small class="loading-submessage">@SubMessage</small>
    }
</div>

<style>
    .loading-state-container {
        padding: 32px 16px;
        text-align: center;
        width: 100%;
    }

    .loading-spinner {
        width: 38px;
        height: 38px;
        border: 3.5px solid var(--accent-light, #e6eee9);
        border-top-color: var(--accent, #557c6c);
        border-radius: 50%;
        animation: enjoyLoadingSpin 0.9s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite;
        margin: 0 auto 14px;
    }

    @@keyframes enjoyLoadingSpin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .loading-message {
        font-size: 14px;
        font-weight: 700;
        color: var(--text, #26332d);
        margin: 0 0 4px 0;
        letter-spacing: -0.2px;
    }

    .loading-submessage {
        font-size: 12px;
        color: var(--muted, #6c7870);
    }
</style>

@code {
    [Parameter] public string Message { get; set; } = "Loading...";
    [Parameter] public string? SubMessage { get; set; }
    [Parameter] public bool Center { get; set; } = true;
    [Parameter] public int MinHeightPx { get; set; } = 200;
}
