@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnClose">
        <div class="modal modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">@(IsEditing ? "EDIT" : "ADD")</div>
                    <h3 class="modal-title">@(IsEditing ? "Edit Teacher" : "Add Teacher")</h3>
                </div>
                <button class="modal-close" @onclick="OnClose" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                <div class="field" style="margin-bottom: 12px;">
                    <label>First Name</label>
                    <input value="@FirstName" @onchange="@(e => FirstNameChanged.InvokeAsync(e.Value?.ToString()))" type="text" placeholder="e.g. Jane" />
                </div>

                <div class="field" style="margin-bottom: 12px;">
                    <label>Last Name</label>
                    <input value="@LastName" @onchange="@(e => LastNameChanged.InvokeAsync(e.Value?.ToString()))" type="text" placeholder="e.g. Doe" />
                </div>

                <div class="field" style="margin-bottom: 14px;">
                    <label>Email</label>
                    <input value="@Email" @onchange="@(e => EmailChanged.InvokeAsync(e.Value?.ToString()))" type="email" placeholder="e.g. jane@example.com" />
                </div>
            </div>

            <div class="modal-footer">
                @if (IsEditing)
                {
                    <button type="button" class="secondary" style="border-color: #fca5a5; color: #9b2c2c; margin-right: auto;" @onclick="OnDelete">Delete</button>
                }
                <button type="button" class="secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="primary" @onclick="OnSave">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public string? FirstName { get; set; }
    [Parameter] public EventCallback<string?> FirstNameChanged { get; set; }

    [Parameter] public string? LastName { get; set; }
    [Parameter] public EventCallback<string?> LastNameChanged { get; set; }

    [Parameter] public string? Email { get; set; }
    [Parameter] public EventCallback<string?> EmailChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
