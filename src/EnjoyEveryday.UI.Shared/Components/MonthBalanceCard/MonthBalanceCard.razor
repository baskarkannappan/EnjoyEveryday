@namespace EnjoyEveryday.UI.Shared.Components

<div class="section-card">
    <div class="section-header">
        <h2>@Title</h2>
        <span>@Subtitle</span>
    </div>

    @if (Stats != null)
    {
        foreach (var stat in Stats)
        {
            <div class="moment">
                <div class="moment-name" style="display: flex; justify-content: space-between;">
                    <span>@stat.Label</span>
                    <span>@stat.Value</span>
                </div>
                <div style="height: 4px; background: #e8ece9; border-radius: 2px; margin-top: 5px; overflow: hidden;">
                    <div style="width: @(stat.Percentage)%; height: 100%; background: #89a995;"></div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Month balance";
    [Parameter] public string Subtitle { get; set; } = "Program rhythm";
    [Parameter] public IEnumerable<BalanceStat> Stats { get; set; } = Array.Empty<BalanceStat>();
}
