@namespace EnjoyEveryday.UI.Shared.Components

<div class="setting">
    <div>
        <strong>@Title</strong>
        <span>@Description</span>
    </div>
    <button class="secondary" @onclick="OnConfigure">
        @ButtonText
    </button>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "Configure";
    [Parameter] public EventCallback OnConfigure { get; set; }
}
