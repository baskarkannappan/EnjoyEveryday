@namespace EnjoyEveryday.UI.Shared.Components.Organization

<div class="pulse">
    <div class="pulse-left">
        <div class="pulse-icon">@Icon</div>
        <div>
            <div class="pulse-title">@Title</div>
            <div class="pulse-text">@Text</div>
        </div>
    </div>
    <button class="pulse-action" @onclick="OnActionClick">
        @ActionText →
    </button>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "🌱";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string ActionText { get; set; } = "";
    [Parameter] public EventCallback OnActionClick { get; set; }
}
