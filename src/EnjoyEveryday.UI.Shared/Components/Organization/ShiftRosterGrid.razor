@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services

<div class="shift-grid">
    @foreach (var shift in Shifts)
    {
        <div class="shift-card @(shift.IsOnLeave ? "on-leave" : "")">
            <div class="shift-card-header">
                <div class="shift-teacher-identity">
                    <div class="teacher-avatar">
                        @(shift.TeacherName.FirstOrDefault().ToString())
                    </div>
                    <div>
                        <div class="teacher-name">@shift.TeacherName</div>
                        <div class="teacher-room">@shift.ClassroomName</div>
                    </div>
                </div>
                @if (shift.IsOnLeave)
                {
                    <span class="leave-tag">🏖️ @shift.LeaveNote</span>
                }
                else if (shift.IsClockedIn)
                {
                    <span class="clock-tag clocked-in">● Active</span>
                }
                else
                {
                    <span class="clock-tag scheduled">Scheduled</span>
                }
            </div>
            <div class="shift-timing">
                ☀️ @shift.ShiftType
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<TeacherShiftItem> Shifts { get; set; } = Enumerable.Empty<TeacherShiftItem>();
}
