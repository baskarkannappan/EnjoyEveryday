@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

<div class="roster-kpi-grid">
    <div class="kpi-card kpi-scheduled">
        <div class="kpi-header">
            <span class="kpi-lbl">Educators Scheduled</span>
            <span class="kpi-icon">👥</span>
        </div>
        <span class="kpi-num">@TotalTeachersScheduled</span>
    </div>
    <div class="kpi-card kpi-clocked">
        <div class="kpi-header">
            <span class="kpi-lbl">Clocked In Now</span>
            <span class="kpi-icon">⏱️</span>
        </div>
        <span class="kpi-num">@TotalTeachersClockedIn</span>
    </div>
    <div class="kpi-card kpi-understaffed @(UnderstaffedRoomsCount > 0 ? "has-understaffed" : "is-healthy")">
        <div class="kpi-header">
            <span class="kpi-lbl">Understaffed Rooms</span>
            <span class="kpi-icon">⚠️</span>
        </div>
        <span class="kpi-num">@UnderstaffedRoomsCount</span>
    </div>
    <div class="kpi-card kpi-leaves">
        <div class="kpi-header">
            <span class="kpi-lbl">Staff On Leave Today</span>
            <span class="kpi-icon">🏖️</span>
        </div>
        <span class="kpi-num">@TotalLeavesToday</span>
    </div>
</div>

@code {
    [Parameter] public int TotalTeachersScheduled { get; set; }
    [Parameter] public int TotalTeachersClockedIn { get; set; }
    [Parameter] public int UnderstaffedRoomsCount { get; set; }
    [Parameter] public int TotalLeavesToday { get; set; }
}
