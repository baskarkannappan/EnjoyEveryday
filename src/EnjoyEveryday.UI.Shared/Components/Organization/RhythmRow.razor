@namespace EnjoyEveryday.UI.Shared.Components.Organization

<div class="rhythm-row">
    <div class="rhythm-name">@Name</div>
    <div class="rhythm-bar">
        <div class="rhythm-segment" style="width:@Percent%; background:@Color"></div>
    </div>
    <div class="rhythm-value">@Percent%</div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Percent { get; set; }
    [Parameter] public string Color { get; set; } = "#8ca891";
}
