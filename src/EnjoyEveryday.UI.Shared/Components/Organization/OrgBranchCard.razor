@namespace EnjoyEveryday.UI.Shared.Components.Organization

<article class="branch-card" data-status="@StatusClass">
    <div class="branch-head">
        <div class="branch-title-row">
            <div class="branch-icon">@Icon</div>
            <div>
                <div class="branch-name">@Name</div>
                <div class="branch-location">@Location</div>
            </div>
        </div>
        <span class="status @StatusClass">@StatusText</span>
    </div>

    <div class="branch-stats">
        <div class="branch-stat">
            <div class="branch-stat-number">@Children</div>
            <div class="branch-stat-label">Children</div>
        </div>
        <div class="branch-stat">
            <div class="branch-stat-number">@Classrooms</div>
            <div class="branch-stat-label">Classrooms</div>
        </div>
        <div class="branch-stat">
            <div class="branch-stat-number">@Experiences</div>
            <div class="branch-stat-label">Experiences</div>
        </div>
    </div>

    <div class="rhythm-label">
        <span>Experience rhythm</span>
        <span>@RhythmPercent%</span>
    </div>
    <div class="progress">
        <div class="progress-fill" style="width:@RhythmPercent%"></div>
    </div>

    <div class="branch-note">
        @Note
    </div>

    <div class="branch-footer">
        <div class="teacher-stack">
            @if (TeacherInitials != null)
            {
                @foreach (var teacher in TeacherInitials)
                {
                    <div class="avatar">@teacher</div>
                }
            }
        </div>
        <button class="view-link" @onclick="OnViewClick">
            Open branch →
        </button>
    </div>
</article>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Location { get; set; } = "";
    [Parameter] public string StatusClass { get; set; } = "good";
    [Parameter] public string StatusText { get; set; } = "Healthy rhythm";
    [Parameter] public int Children { get; set; }
    [Parameter] public int Classrooms { get; set; }
    [Parameter] public int Experiences { get; set; }
    [Parameter] public int RhythmPercent { get; set; }
    [Parameter] public string Note { get; set; } = "";
    [Parameter] public List<string> TeacherInitials { get; set; } = new();
    [Parameter] public EventCallback OnViewClick { get; set; }
}
