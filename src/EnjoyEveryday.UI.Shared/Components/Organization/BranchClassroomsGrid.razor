@namespace EnjoyEveryday.UI.Shared.Components.Organization
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components

<div class="classrooms-section">
    @if (Classrooms == null)
    {
        <div class="loading-state">
            <p>Loading classrooms...</p>
        </div>
    }
    else if (!Classrooms.Any())
    {
        <EmptyState Icon="🚪"
                    Title="No classrooms yet"
                    Description="Add a classroom to begin assigning children and teachers to this branch."
                    ActionText="＋ Add Classroom"
                    OnAction="OnAddClassroom" />
    }
    else
    {
        <div class="list-grid">
            @foreach (var room in Classrooms)
            {
                <div class="list-card" @onclick="() => OnSelectClassroom.InvokeAsync(room.Id)">
                    <div class="room-title">@room.Name</div>
                    <div class="room-meta">
                        Age: @room.AgeGroup &bull; Capacity: @room.Capacity
                    </div>
                    <div class="room-footer">
                        <span class="enrollment-count">@room.CurrentEnrollment children</span>
                        <span class="room-status @room.Status.ToLower()">@room.Status</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<Classroom>? Classrooms { get; set; }
    [Parameter] public EventCallback OnAddClassroom { get; set; }
    [Parameter] public EventCallback<Guid> OnSelectClassroom { get; set; }
}
