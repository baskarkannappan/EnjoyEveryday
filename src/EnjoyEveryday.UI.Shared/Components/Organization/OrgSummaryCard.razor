@namespace EnjoyEveryday.UI.Shared.Components.Organization

<div class="summary-card">
    <div class="summary-label">@Label</div>
    <div class="summary-number">@Value</div>
    <div class="summary-detail">
        @if (!string.IsNullOrEmpty(PositiveHighlight))
        {
            <span class="positive">@PositiveHighlight </span>
        }
        @DetailText
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string DetailText { get; set; } = "";
    [Parameter] public string PositiveHighlight { get; set; } = "";
}
