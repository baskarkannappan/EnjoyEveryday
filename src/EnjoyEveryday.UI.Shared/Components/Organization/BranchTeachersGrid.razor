@namespace EnjoyEveryday.UI.Shared.Components.Organization
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components

<div class="teachers-section">
    @if (Teachers == null)
    {
        <div class="loading-state">
            <p>Loading teachers...</p>
        </div>
    }
    else if (!Teachers.Any())
    {
        <EmptyState Icon="👩‍🏫"
                    Title="No teachers assigned yet"
                    Description="Educators assigned to this branch and its classrooms will be shown here." />
    }
    else
    {
        <div class="list-grid">
            @foreach (var teacher in Teachers)
            {
                <div class="list-card">
                    <div class="teacher-row">
                        <div class="teacher-avatar">
                            @(teacher.FirstName?.FirstOrDefault().ToString() ?? "T")
                        </div>
                        <div class="teacher-info">
                            <div class="teacher-name">@teacher.FullName</div>
                            <div class="teacher-status">@teacher.Status</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<Teacher>? Teachers { get; set; }
}
