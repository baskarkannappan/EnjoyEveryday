@namespace EnjoyEveryday.UI.Shared.Components.Organization
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components

<div class="children-section">
    @if (Children == null)
    {
        <div class="loading-state">
            <p>Loading children...</p>
        </div>
    }
    else if (!Children.Any())
    {
        <EmptyState Icon="👶"
                    Title="No children enrolled yet"
                    Description="Children enrolled into classrooms at this branch will appear here." />
    }
    else
    {
        <div class="list-grid">
            @foreach (var child in Children)
            {
                <div class="list-card">
                    <div class="child-row">
                        <div class="child-avatar">
                            @(child.FirstName?.FirstOrDefault().ToString() ?? "C")
                        </div>
                        <div class="child-info">
                            <div class="child-name">@child.FirstName @child.LastName</div>
                            <div class="child-sub">DoB: @child.DateOfBirth?.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<Child>? Children { get; set; }
}
