@namespace EnjoyEveryday.UI.Shared.Components

<div class="story">
    <div class="story-art">
        @Icon
    </div>
    <div class="story-content">
        <div class="story-date">@Date</div>
        <h2>@Title</h2>
        <p>@Content</p>

        @if (!string.IsNullOrEmpty(MomentTitle) || !string.IsNullOrEmpty(MomentText))
        {
            <div class="little-moment">
                @if (!string.IsNullOrEmpty(MomentTitle))
                {
                    <strong>@MomentTitle</strong>
                }
                @if (!string.IsNullOrEmpty(MomentText))
                {
                    <p>@MomentText</p>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(ActionText))
        {
            <button class="primary" @onclick="OnActionClick">@ActionText</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Date { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Content { get; set; } = "";
    [Parameter] public string MomentTitle { get; set; } = "";
    [Parameter] public string MomentText { get; set; } = "";
    [Parameter] public string ActionText { get; set; } = "";
    [Parameter] public EventCallback OnActionClick { get; set; }
}
