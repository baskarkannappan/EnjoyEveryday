@namespace EnjoyEveryday.UI.Shared.Components.SafetyTrust

<div class="trust-banner">
    <div class="trust-left">
        <div class="trust-icon">@Icon</div>
        <div>
            <div class="trust-title">@Title</div>
            <div class="trust-text">@Description</div>
        </div>
    </div>
    <div class="trust-status">
        <span class="status-dot"></span>
        @StatusText
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "🛡️";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string StatusText { get; set; } = "";
}
