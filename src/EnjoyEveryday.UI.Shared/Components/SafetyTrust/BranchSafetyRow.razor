@namespace EnjoyEveryday.UI.Shared.Components.SafetyTrust

<div class="branch-row">
    <div class="branch-avatar">
        @((MarkupString)Avatar)
    </div>
    <div class="branch-info">
        <div class="branch-name">@Name</div>
        <div class="branch-detail">@Detail</div>
    </div>
    <div class="branch-score">
        <div class="score @ScoreClass">
            @ScoreText
        </div>
        <div class="score-label">
            @ScoreLabel
        </div>
    </div>
</div>

@code {
    [Parameter] public string Avatar { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Detail { get; set; } = "";
    [Parameter] public string ScoreText { get; set; } = "";
    [Parameter] public string ScoreClass { get; set; } = "good";
    [Parameter] public string ScoreLabel { get; set; } = "";
}
