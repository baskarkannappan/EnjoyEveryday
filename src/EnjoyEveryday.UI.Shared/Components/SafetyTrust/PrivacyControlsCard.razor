@namespace EnjoyEveryday.UI.Shared.Components.SafetyTrust

<div class="privacy-card">
    <div class="privacy-title">@Title</div>
    @if (Controls != null)
    {
        @foreach (var control in Controls)
        {
            <div class="privacy-line">
                <span>@control.Key</span>
                <span class="privacy-value">@control.Value</span>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Privacy controls";
    [Parameter] public Dictionary<string, string> Controls { get; set; } = new();
}
