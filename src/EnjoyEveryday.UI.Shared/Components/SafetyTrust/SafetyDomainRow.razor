@namespace EnjoyEveryday.UI.Shared.Components.SafetyTrust

<div class="safety-row">
    <div class="safety-icon @IconClass">
        @((MarkupString)Icon)
    </div>
    <div class="safety-content">
        <div class="safety-name">@Name</div>
        <div class="safety-description">@Description</div>
    </div>
    <div class="mini-status @StatusClass">
        @StatusText
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string IconClass { get; set; } = "green-icon";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string StatusText { get; set; } = "";
    [Parameter] public string StatusClass { get; set; } = "mini-good";
}
