@namespace EnjoyEveryday.UI.Shared.Components.SafetyTrust

<div class="summary-card">
    <div class="summary-header">
        <span class="summary-label">@Label</span>
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="summary-icon-pill">@Icon</div>
        }
    </div>
    <div class="summary-number">@Value</div>

    @if (ProgressPercent.HasValue)
    {
        <div class="progress-bar-track">
            <div class="progress-bar-fill @(StatusClass == "attention" ? "fill-attention" : "fill-good")"
                 style="width: @(Math.Clamp(ProgressPercent.Value, 0, 100))%;"></div>
        </div>
    }

    <div class="summary-detail">
        <span class="status-badge-pill @(StatusClass == "attention" ? "badge-attention" : "badge-good")">
            <span class="badge-dot"></span>
            @DetailText
        </span>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string DetailText { get; set; } = "";
    [Parameter] public string StatusClass { get; set; } = "good";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public int? ProgressPercent { get; set; }
}
