@namespace EnjoyEveryday.UI.Shared.Components

<div class="dna-card full magic-card">
    <div class="dna-label">
        ✦ MAGIC MOMENT
        <button class="dna-add">+</button>
    </div>
    <div class="dna-content">
        @if (string.IsNullOrWhiteSpace(Content))
        {
            <span class="dna-empty">@Placeholder</span>
        }
        else
        {
            @Content
        }
    </div>
</div>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "What makes this magic?";
}
