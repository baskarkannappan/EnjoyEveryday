@namespace EnjoyEveryday.UI.Shared.Components

<div class="dna-card @(IsFull ? "full" : "")">
    <div class="dna-label">
        @Label
        <button class="dna-add">+</button>
    </div>
    <div class="dna-content">
        @if (Content == null)
        {
            <span class="dna-empty">@Placeholder</span>
        }
        else
        {
            @Content
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Add content...";
    [Parameter] public bool IsFull { get; set; } = false;
}
