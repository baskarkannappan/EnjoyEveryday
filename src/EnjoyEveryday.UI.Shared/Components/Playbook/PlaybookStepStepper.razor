@namespace EnjoyEveryday.UI.Shared.Components

<div class="deck-card chapters-deck">
    <div class="deck-header">
        <div class="deck-title">
            <span class="deck-icon">📋</span>
            <h3>Manual Steps</h3>
        </div>
        <span class="duration-badge">~@TotalDuration min total</span>
    </div>
    <div class="chapter-stepper">
        @for (int i = 0; i < Steps.Count; i++)
        {
            var index = i;
            var ch = Steps[i];
            var isCurrent = (index + 1) == CurrentStepIndex;
            var isPassed = (index + 1) < CurrentStepIndex;

            <button class="step-item @(isCurrent ? "current" : "") @(isPassed ? "completed" : "")" @onclick="() => OnStepSelected.InvokeAsync(index + 1)">
                <div class="step-num">
                    @if (isPassed)
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    }
                    else
                    {
                        <span style="font-size: 13px;">@(!string.IsNullOrWhiteSpace(ch.Icon) ? ch.Icon : (index + 1).ToString())</span>
                    }
                </div>
                <div class="step-details">
                    <div class="step-title">@ch.Title</div>
                    <div class="step-phase">@ch.PhaseTag • @ch.Duration</div>
                </div>
            </button>
        }
    </div>
</div>

@code {
    public class StepItem
    {
        public string Title { get; set; } = string.Empty;
        public string PhaseTag { get; set; } = string.Empty;
        public string Duration { get; set; } = string.Empty;
        public string? Icon { get; set; }
    }

    [Parameter] public List<StepItem> Steps { get; set; } = new();
    [Parameter] public int CurrentStepIndex { get; set; } = 1;
    [Parameter] public string TotalDuration { get; set; } = "30";
    [Parameter] public EventCallback<int> OnStepSelected { get; set; }
}
