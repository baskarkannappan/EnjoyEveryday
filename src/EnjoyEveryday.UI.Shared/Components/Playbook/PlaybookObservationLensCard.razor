@namespace EnjoyEveryday.UI.Shared.Components

<div class="deck-card cues-deck">
    <div class="deck-header">
        <div class="deck-title">
            <span class="deck-icon">👀</span>
            <h3>Teacher's Observation Lens</h3>
        </div>
    </div>
    <div class="cue-block">
        <span class="cue-tag watch-tag">WATCH FOR</span>
        <p>@(!string.IsNullOrWhiteSpace(Watch) ? Watch : "Observe how children first approach the materials, nonverbal cues of fascination, and collaborative invitations.")</p>
    </div>
    <div class="cue-block">
        <span class="cue-tag ask-tag">ASK WONDERING QUESTIONS</span>
        <p>@(!string.IsNullOrWhiteSpace(Ask) ? Ask : "What does this feel like? What do you notice when you hold it up to the light? What should we try next?")</p>
    </div>
    <div class="cue-block">
        <span class="cue-tag try-tag">TRY THIS</span>
        <p>@(!string.IsNullOrWhiteSpace(Try) ? Try : "Gently step back and let the children lead the narrative. Follow their natural curiosity wherever it blossoms.")</p>
    </div>
</div>

@code {
    [Parameter] public string? Watch { get; set; }
    [Parameter] public string? Ask { get; set; }
    [Parameter] public string? Try { get; set; }
}
