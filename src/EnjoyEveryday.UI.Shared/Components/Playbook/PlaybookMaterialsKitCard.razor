@namespace EnjoyEveryday.UI.Shared.Components

<div class="deck-card materials-deck">
    <div class="deck-header">
        <div class="deck-title">
            <span class="deck-icon">🌿</span>
            <h3>Materials &amp; Setup Kit</h3>
        </div>
        <span class="item-count">@Materials.Count items</span>
    </div>
    <div class="materials-list">
        @foreach (var item in Materials)
        {
            <label class="material-checkbox">
                <input type="checkbox" />
                <span>@item</span>
            </label>
        }
    </div>
</div>

@code {
    [Parameter] public List<string> Materials { get; set; } = new();
}
