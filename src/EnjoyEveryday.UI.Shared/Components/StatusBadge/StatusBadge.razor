@namespace EnjoyEveryday.UI.Shared.Components

<span class="status-badge status-@NormalizedStatus @CustomClass">
    <span class="status-dot"></span>
    <span class="status-text">@(Label ?? Status)</span>
</span>

@code {
    [Parameter] public string Status { get; set; } = "Active";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string CustomClass { get; set; } = "";

    private string NormalizedStatus => (Status ?? "").Trim().ToLowerInvariant().Replace(" ", "-").Replace("_", "-");
}
