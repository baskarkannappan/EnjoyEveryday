@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services

@if (Memory != null)
{
    <div class="modal-backdrop-custom" @onclick="OnClose">
        <div class="modal-card-custom" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <div>
                    <span class="category-badge @GetCategoryCssClass(Memory.Category)">@Memory.Category</span>
                    <h2 class="modal-title-custom">@Memory.Title</h2>
                    <span class="modal-subtext">@Memory.EventDate.ToString("f")</span>
                </div>
                <button class="close-btn-custom" @onclick="OnClose">✕</button>
            </div>

            <div class="modal-body-custom">
                @if (!string.IsNullOrEmpty(Memory.MediaUrl))
                {
                    <div class="modal-media-wrap">
                        <img src="@Memory.MediaUrl" alt="@Memory.Title" class="modal-full-img" />
                    </div>
                }

                <div class="detail-section">
                    <label class="detail-label">Story &amp; Observations</label>
                    <p class="detail-text">@Memory.Description</p>
                </div>

                @if (!string.IsNullOrEmpty(Memory.ExperienceTitle))
                {
                    <div class="detail-section highlight-box">
                        <label class="detail-label">Linked Learning Experience</label>
                        <p class="detail-text"><strong>@Memory.ExperienceTitle</strong></p>
                    </div>
                }

                <div class="detail-grid">
                    <div class="grid-item">
                        <label class="detail-label">Child</label>
                        <span>@(Memory.ChildName ?? "Child")</span>
                    </div>
                    <div class="grid-item">
                        <label class="detail-label">Recorded By</label>
                        <span>@(Memory.TeacherName ?? "Educator")</span>
                    </div>
                    <div class="grid-item">
                        <label class="detail-label">Classroom</label>
                        <span>@(Memory.ClassroomName ?? "General Room")</span>
                    </div>
                    <div class="grid-item">
                        <label class="detail-label">Audience Visibility</label>
                        <span>@(Memory.IsParentVisible ? "Family & Educators" : "Educators Only")</span>
                    </div>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button class="btn secondary" @onclick="OnClose">Close</button>
                @if (Memory.ChildId.HasValue)
                {
                    <a href="/journey/@Memory.ChildId.Value" class="btn primary" style="text-decoration: none;">
                        Open Child Journey
                    </a>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public MemoryEvent? Memory { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static string GetCategoryCssClass(string category) => category switch
    {
        "Learning Experiences" => "cat-learning",
        "Observations" => "cat-observations",
        "Milestones" => "cat-milestones",
        "Celebrations" => "cat-celebrations",
        "Daily Care" => "cat-dailycare",
        _ => "cat-default"
    };
}
