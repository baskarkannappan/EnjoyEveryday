@namespace EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities

@if (Child != null)
{
    <div class="child-hero-card">
        <div class="child-avatar-badge">
            @if (!string.IsNullOrEmpty(Child.PhotoUrl))
            {
                <img src="@Child.PhotoUrl" alt="@Child.FirstName" class="child-img" />
            }
            else
            {
                <span class="child-initials">@Child.FirstName.FirstOrDefault()@Child.LastName.FirstOrDefault()</span>
            }
        </div>
        <div class="child-hero-info">
            <div class="child-hero-title">
                <h2>@Child.FirstName @Child.LastName</h2>
                <span class="status-pill active-pill">Active Journey</span>
            </div>
            <p class="child-hero-subtitle">
                Classroom: <strong>@(string.IsNullOrEmpty(ClassroomName) ? "General" : ClassroomName)</strong>
                @if (Child.DateOfBirth.HasValue)
                {
                    <span class="separator-dot">•</span>
                    <span>Age @CalculateAge(Child.DateOfBirth.Value)</span>
                }
            </p>
        </div>
        <div class="memory-count-badge">
            <span class="count-number">@MemoriesCount</span>
            <span class="count-label">Memories</span>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Child Child { get; set; } = default!;
    [Parameter] public string? ClassroomName { get; set; }
    [Parameter] public int MemoriesCount { get; set; }

    private string CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var months = (today.Year - dateOfBirth.Year) * 12 + today.Month - dateOfBirth.Month;
        if (today.Day < dateOfBirth.Day) months--;

        if (months < 24)
            return $"{months} mo";
        
        var years = months / 12;
        var remMonths = months % 12;
        return remMonths == 0 ? $"{years} yr" : $"{years} yr {remMonths} mo";
    }
}
