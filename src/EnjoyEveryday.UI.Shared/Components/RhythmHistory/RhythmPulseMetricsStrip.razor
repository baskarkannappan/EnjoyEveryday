@namespace EnjoyEveryday.UI.Shared.Components.RhythmHistory

<div class="pulse-grid">
    <div class="pulse-card pulse-date-card">
        <div class="stat-label">Rhythm for date</div>
        <div class="stat-number stat-date">@SelectedDate.ToString("dddd, MMM d")</div>
        <div class="stat-note">@TotalActivitiesCount total activities recorded</div>
    </div>

    <div class="pulse-card pulse-exp-card">
        <div class="stat-label">Experiences Run</div>
        <div class="stat-number">@ExperiencesCount</div>
        <div class="stat-note">Classroom learning sessions</div>
    </div>

    <div class="pulse-card pulse-celeb-card">
        <div class="stat-label">Celebrations Held</div>
        <div class="stat-number">@CelebrationsCount</div>
        <div class="stat-note">Events & special days</div>
    </div>

    <div class="pulse-card pulse-photo-card">
        <div class="stat-label">Photos Captured</div>
        <div class="stat-number">@PhotosCount</div>
        <div class="stat-note">Saved in AVIF format</div>
    </div>
</div>

@code {
    [Parameter] public DateOnly SelectedDate { get; set; }
    [Parameter] public IReadOnlyList<HistoricalRhythmItem> TimelineItems { get; set; } = Array.Empty<HistoricalRhythmItem>();

    private int TotalActivitiesCount => TimelineItems.Count;
    private int ExperiencesCount => TimelineItems.Count(t => !t.IsEvent);
    private int CelebrationsCount => TimelineItems.Count(t => t.IsEvent);
    private int PhotosCount => TimelineItems.Sum(t => t.PhotoUrls?.Length ?? 0);
}
