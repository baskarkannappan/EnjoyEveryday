@namespace EnjoyEveryday.UI.Shared.Components.RhythmHistory

<div class="welcome-header">
    <div class="welcome-info">
        @if (OnBackClick.HasDelegate || !string.IsNullOrEmpty(BackHref))
        {
            @if (OnBackClick.HasDelegate)
            {
                <button type="button" class="back-pill-btn" @onclick="OnBackClick">
                    <span>&larr;</span> @BackText
                </button>
            }
            else
            {
                <a href="@BackHref" class="back-pill-btn">
                    <span>&larr;</span> @BackText
                </a>
            }
        }
        <h1 class="welcome-title">@Title</h1>
        <p class="welcome-subtitle">@Subtitle</p>
    </div>

    <RhythmQuickDatePills SelectedDate="@SelectedDate" 
                          Today="@Today" 
                          OnDateSelected="OnDateSelected" />
</div>

@code {
    [Parameter] public string Title { get; set; } = "Past Rhythm History ✦";
    [Parameter] public string Subtitle { get; set; } = "Explore the daily flow of past days — review structured experiences, milestones, and celebrations across Little Stars.";
    [Parameter] public string BackText { get; set; } = "Back to Today";
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public EventCallback OnBackClick { get; set; }
    [Parameter] public DateOnly SelectedDate { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }
}
