@namespace EnjoyEveryday.UI.Shared.Components.RhythmHistory

<div class="date-pills-bar">
    <button type="button" 
            class="date-pill-btn @(SelectedDate == Today.AddDays(-1) ? "active" : "")" 
            @onclick="() => SelectDate(Today.AddDays(-1))">
        Yesterday
    </button>
    <button type="button" 
            class="date-pill-btn @(SelectedDate == Today.AddDays(-2) ? "active" : "")" 
            @onclick="() => SelectDate(Today.AddDays(-2))">
        2 Days Ago
    </button>
    <button type="button" 
            class="date-pill-btn @(SelectedDate == Today.AddDays(-7) ? "active" : "")" 
            @onclick="() => SelectDate(Today.AddDays(-7))">
        1 Week Ago
    </button>
    <button type="button" 
            class="date-pill-btn @(SelectedDate == Today ? "active" : "")" 
            @onclick="() => SelectDate(Today)">
        Today
    </button>
</div>

@code {
    [Parameter] public DateOnly SelectedDate { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }

    private async Task SelectDate(DateOnly date)
    {
        await OnDateSelected.InvokeAsync(date);
    }
}
