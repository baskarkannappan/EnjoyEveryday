@namespace EnjoyEveryday.UI.Shared.Components.RhythmHistory

<div class="date-pills-bar">
    <button type="button" 
            class="date-pill-btn @(SelectedDate == EffectiveToday.AddDays(-1) ? "active" : "")" 
            @onclick="() => SelectDate(EffectiveToday.AddDays(-1))">
        Yesterday
    </button>
    <button type="button" 
            class="date-pill-btn @(SelectedDate == EffectiveToday.AddDays(-2) ? "active" : "")" 
            @onclick="() => SelectDate(EffectiveToday.AddDays(-2))">
        2 Days Ago
    </button>
    <button type="button" 
            class="date-pill-btn @(SelectedDate == EffectiveToday.AddDays(-7) ? "active" : "")" 
            @onclick="() => SelectDate(EffectiveToday.AddDays(-7))">
        1 Week Ago
    </button>
    <button type="button" 
            class="date-pill-btn @(SelectedDate == EffectiveToday ? "active" : "")" 
            @onclick="() => SelectDate(EffectiveToday)">
        Today
    </button>
</div>

@code {
    [Parameter] public DateOnly SelectedDate { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }

    private DateOnly EffectiveToday => Today != default ? Today : DateOnly.FromDateTime(DateTime.Today);
    
    private async Task SelectDate(DateOnly date)
    {
        await OnDateSelected.InvokeAsync(date);
    }
}
