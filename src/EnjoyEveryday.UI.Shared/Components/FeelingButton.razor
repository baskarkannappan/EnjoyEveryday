@namespace EnjoyEveryday.UI.Shared.Components

<button class="feeling @(IsActive ? "active" : "")" @onclick="OnClick">
    <span class="feeling-icon">@Icon</span>
    <span class="feeling-name">@Name</span>
</button>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool IsActive { get; set; } = false;
    [Parameter] public EventCallback OnClick { get; set; }
}
