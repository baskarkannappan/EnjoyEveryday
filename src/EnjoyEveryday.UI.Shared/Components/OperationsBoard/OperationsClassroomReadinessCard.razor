@using EnjoyEveryday.Application.Services

<div class="board-section-card">
    <div class="section-title-row">
        <div>
            <h2>Classroom Readiness</h2>
            <p class="section-sub">Standard opening and safety verifications</p>
        </div>
    </div>

    <div class="readiness-list">
        @if (Checklist != null)
        {
            @foreach (var item in Checklist)
            {
                <div class="readiness-item @(item.IsCompleted ? "completed" : "pending")">
                    <div class="check-box @(item.IsCompleted ? "checked" : "")">
                        @(item.IsCompleted ? "✓" : "○")
                    </div>
                    <div class="readiness-text">
                        <strong>@item.Label</strong>
                        <p>@item.Description</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ReadinessChecklistItem>? Checklist { get; set; }
}
