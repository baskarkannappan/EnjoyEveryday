@using EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <div>
                    <h3>📸 Celebration Photos</h3>
                    <p>@Title</p>
                </div>
                <button type="button" class="close-btn" @onclick="Close">✕</button>
            </div>
            <EventPhotoUploader Photos="@Photos"
                                PhotosChanged="OnPhotosChanged"
                                MaxPhotos="@MaxPhotos"
                                ReadOnly="false"
                                IsCompleted="true" />
            <div class="modal-footer">
                <button type="button" class="btn primary" @onclick="Close">Done</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string[] Photos { get; set; } = Array.Empty<string>();
    [Parameter] public int MaxPhotos { get; set; } = 3;

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string[]> PhotosChanged { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task OnPhotosChanged(string[] updated)
    {
        await PhotosChanged.InvokeAsync(updated);
    }
}
