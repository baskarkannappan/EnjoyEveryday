@using EnjoyEveryday.Application.Services

<div class="pulse-metrics-container">
    <div class="pulse-card main-summary">
        <div class="pulse-tag">✦ LIVE DAYCARE STATUS</div>
        <div class="pulse-headline">
            @(Board.CheckedInChildrenCount > 0 ? $"{Board.CheckedInChildrenCount} children on site" : "Ready for today's arrivals")
        </div>
        <div class="pulse-sub">
            <span><strong>@Board.ExpectedChildrenCount</strong> expected</span>
            <span class="dot">•</span>
            <span><strong>@Board.TotalClassroomsCount</strong> active classrooms</span>
            <span class="dot">•</span>
            <span><strong>@Board.PlannedExperiencesCount</strong> experiences today</span>
        </div>
    </div>

    <div class="pulse-card">
        <div class="stat-label">Children Here</div>
        <div class="stat-number highlight-accent">@Board.CheckedInChildrenCount</div>
        <div class="stat-note">
            @(Board.ExpectedNotArrivedCount > 0 ? $"{Board.ExpectedNotArrivedCount} not yet arrived" : "All expected checked in")
        </div>
    </div>

    <div class="pulse-card">
        <div class="stat-label">Staff On Site</div>
        <div class="stat-number @(Board.UnderstaffedClassroomsCount > 0 ? "highlight-warning" : "")">
            @Board.PresentStaffCount
        </div>
        <div class="stat-note">
            @(Board.UnderstaffedClassroomsCount > 0 ? $"⚠️ {Board.UnderstaffedClassroomsCount} room coverage alert" : "All classrooms covered")
        </div>
    </div>

    <div class="pulse-card">
        <div class="stat-label">Care Records</div>
        <div class="stat-number @(Board.MissingCareRecordsCount > 0 ? "highlight-attention" : "")">
            @(Board.CheckedInChildrenCount - Board.MissingCareRecordsCount) / @Board.CheckedInChildrenCount
        </div>
        <div class="stat-note">
            @(Board.MissingCareRecordsCount > 0 ? $"{Board.MissingCareRecordsCount} children missing records" : "All records up to date")
        </div>
    </div>

    @if (Board.HasFinanceAccess)
    {
        <div class="pulse-card">
            <div class="stat-label">Outstanding Dues</div>
            <div class="stat-number @(Board.OverdueInvoicesCount > 0 ? "highlight-danger" : "")">
                ₹@(Board.OutstandingReceivables.ToString("N0"))
            </div>
            <div class="stat-note">
                @(Board.OverdueInvoicesCount > 0 ? $"{Board.OverdueInvoicesCount} overdue invoices" : "Billing healthy")
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public OperationsBoardModel Board { get; set; } = new();
}
