@using EnjoyEveryday.Application.Services

<div class="today-care-banner">
    <div class="banner-header">
        <div class="banner-status-tag">
            <span class="status-dot"></span>
            <span>TODAY'S CARE STATUS</span>
        </div>
        <div class="banner-subtext">
            <span><strong>@Board.TotalClassroomsCount</strong> active classrooms</span>
            <span class="sep">•</span>
            <span><strong>@Board.PlannedExperiencesCount</strong> experiences planned</span>
        </div>
    </div>

    <div class="banner-headline">
        @(Board.ExpectedChildrenCount > 0 
            ? $"{Board.ExpectedChildrenCount} little ones are expected today" 
            : "Welcome to today's daily overview")
    </div>
    <p class="banner-motto">
        @(Board.CheckedInChildrenCount > 0
            ? $"{Board.CheckedInChildrenCount} children on site — welcome children, check staff coverage, and nurture today's discoveries."
            : "Welcome children, check staff coverage, and prepare today's experiences.")
    </p>

    <!-- Embedded high-scan operational metric tiles -->
    <div class="banner-tiles-grid">
        <div class="banner-tile tile-green">
            <div class="tile-label">Children Present</div>
            <div class="tile-val">
                <span class="val-num">@Board.CheckedInChildrenCount</span>
                <span class="val-denom">/ @Board.ExpectedChildrenCount</span>
            </div>
            <div class="tile-footer">
                @(Board.ExpectedNotArrivedCount > 0 ? $"{Board.ExpectedNotArrivedCount} not yet arrived" : "All expected present")
            </div>
        </div>

        <div class="banner-tile tile-blue">
            <div class="tile-label">Staff On Site</div>
            <div class="tile-val">
                <span class="val-num">@Board.PresentStaffCount</span>
                <span class="val-denom">teachers</span>
            </div>
            <div class="tile-footer">
                @(Board.UnderstaffedClassroomsCount > 0 ? $"⚠️ {Board.UnderstaffedClassroomsCount} room coverage alert" : "All classrooms covered")
            </div>
        </div>

        <div class="banner-tile tile-amber">
            <div class="tile-label">Actions Needed</div>
            <div class="tile-val">
                <span class="val-num">@(Board.Alerts?.Count ?? 0)</span>
                <span class="val-denom">alerts</span>
            </div>
            <div class="tile-footer">
                @((Board.Alerts?.Count ?? 0) > 0 ? $"{Board.Alerts!.Count} require review" : "Everything running smoothly")
            </div>
        </div>

        <div class="banner-tile tile-warm">
            <div class="tile-label">Care Records</div>
            <div class="tile-val">
                <span class="val-num">@(Board.CheckedInChildrenCount - Board.MissingCareRecordsCount)</span>
                <span class="val-denom">/ @Board.CheckedInChildrenCount</span>
            </div>
            <div class="tile-footer">
                @(Board.MissingCareRecordsCount > 0 ? $"{Board.MissingCareRecordsCount} missing logs" : "All records logged")
            </div>
        </div>

        @if (Board.HasFinanceAccess)
        {
            <div class="banner-tile tile-purple">
                <div class="tile-label">Outstanding Dues</div>
                <div class="tile-val">
                    <span class="val-num">₹@(Board.OutstandingReceivables.ToString("N0"))</span>
                </div>
                <div class="tile-footer">
                    @(Board.OverdueInvoicesCount > 0 ? $"{Board.OverdueInvoicesCount} overdue" : "Billing healthy")
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public OperationsBoardModel Board { get; set; } = new();
}
