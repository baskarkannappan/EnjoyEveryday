@if (!string.IsNullOrEmpty(PhotoUrl))
{
    <div class="photo-lightbox" @onclick="Close">
        <div class="lightbox-content" @onclick:stopPropagation>
            <button class="lightbox-close" @onclick="Close" title="Close">✕</button>
            <img src="@PhotoUrl" alt="@(Caption ?? "Preview")" class="lightbox-img" />
            @if (!string.IsNullOrEmpty(Caption) || ShowDownload)
            {
                <div class="lightbox-caption">
                    <span>@(Caption ?? "")</span>
                    @if (ShowDownload)
                    {
                        <a href="@PhotoUrl" download="@DownloadFileName" class="download-link">⬇ Download</a>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public bool ShowDownload { get; set; }
    [Parameter] public string DownloadFileName { get; set; } = "event-photo.avif";
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
