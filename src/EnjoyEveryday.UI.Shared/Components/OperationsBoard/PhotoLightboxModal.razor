@if (!string.IsNullOrEmpty(PhotoUrl))
{
    <div class="photo-lightbox" @onclick="Close">
        <div class="lightbox-content" @onclick:stopPropagation>
            <button class="lightbox-close" @onclick="Close">✕</button>
            <img src="@PhotoUrl" alt="Preview" class="lightbox-img" />
        </div>
    </div>
}

@code {
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
