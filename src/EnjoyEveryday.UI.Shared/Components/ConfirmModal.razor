@namespace EnjoyEveryday.UI.Shared.Components

@if (IsOpen)
{
    <div class="ee-confirm-backdrop" @onclick="HandleCancelAsync" role="dialog" aria-modal="true" aria-labelledby="ee-confirm-title">
        <div class="ee-confirm-card" @onclick:stopPropagation="true">
            <div class="ee-confirm-header">
                <h3 id="ee-confirm-title" class="ee-confirm-title">@Title</h3>
            </div>
            <div class="ee-confirm-body">
                <p>@Message</p>
            </div>
            <div class="ee-confirm-actions">
                <button type="button" class="btn secondary" @onclick="HandleCancelAsync" disabled="@IsBusy">
                    @CancelText
                </button>
                <button type="button"
                        class="@(IsDanger ? "ee-btn-danger" : "primary")"
                        @onclick="HandleConfirmAsync"
                        disabled="@IsBusy">
                    @(IsBusy ? "Working..." : ConfirmText)
                </button>
            </div>
        </div>
    </div>
}

<style>
    .ee-confirm-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(38, 51, 45, 0.36);
        backdrop-filter: blur(2px);
        z-index: 2600;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .ee-confirm-card {
        width: 100%;
        max-width: 420px;
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: 0 20px 50px rgba(38, 51, 45, 0.18);
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .ee-confirm-title {
        margin: 0;
        font-size: 16px;
        font-weight: 750;
        color: var(--text, #26332d);
        letter-spacing: -0.2px;
    }

    .ee-confirm-body p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
        color: var(--muted, #6c7870);
    }

    .ee-confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 6px;
    }

    .ee-btn-danger {
        background: #c53030;
        color: #ffffff;
        border: none;
        padding: 8px 16px;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
    }

    .ee-btn-danger:hover {
        background: #9b2c2c;
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsDanger { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to continue?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleConfirmAsync()
    {
        if (IsBusy) return;
        await OnConfirm.InvokeAsync();
    }

    private async Task HandleCancelAsync()
    {
        if (IsBusy) return;
        await OnCancel.InvokeAsync();
    }
}
