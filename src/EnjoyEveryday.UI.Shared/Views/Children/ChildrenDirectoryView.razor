@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Services

@inject ChildService ChildService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject OrganizationService OrgService
@inject NavigationManager NavigationManager
@inject IAppNotificationService NotificationService
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Domain.Repositories.IAccessScopeRepository AccessScopeRepo

<div class="content">
    <PageHero Eyebrow="@(_isTeacherOnly ? "MY CLASSROOM" : (_isBranchAdmin ? "BRANCH OPERATIONS" : "PEOPLE"))"
              Title="@(_isTeacherOnly ? "Classroom Children" : (_isBranchAdmin ? "Branch Children" : "Children"))"
              Subtitle="@(_isTeacherOnly ? "Children roster, contacts and profiles in your assigned classroom." : (_isBranchAdmin ? "Children roster, admissions and room placements for your branch." : "See the children behind the experiences."))">

        <RightContent>
            @if (!_isTeacherOnly)
            {
                <a href="/enrollment" class="btn secondary" style="margin-right: 8px; text-decoration: none; display: inline-flex; align-items: center; padding: 10px 16px; border-radius: 11px; border: 1px solid var(--border); font-weight: 700; color: var(--text); background: white;">
                    Admissions Pipeline
                </a>
                <a href="/enrollment?action=new-inquiry" id="addChildButton" class="btn primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; padding: 10px 16px; border-radius: 0px; font-weight: 700; color: #ffffff; background: #31523c;">
                    + Start New Admission
                </a>
            }
        </RightContent>

    </PageHero>

    @if (!_isTeacherOnly)
    {
        <div style="margin-bottom: 24px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
            @if (_isOrgAdmin)
            {
                <select @bind="SelectedBranchId" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 13px; cursor: pointer;">
                    <option value="@Guid.Empty">All Branches</option>
                    @foreach (var branch in _branches.Values)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </select>
            }
            else
            {
                <div style="padding: 8px 14px; border-radius: 11px; background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; font-weight: 700; font-size: 13px; color: var(--accent-dark, #31523c); display: inline-flex; align-items: center; gap: 6px;">
                    🏛️ <span>@(_branches.Values.FirstOrDefault()?.Name ?? "Assigned Branch")</span>
                </div>
            }
            
            <select @bind="SelectedClassroomId" disabled="@(!_classrooms.Any())" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 13px; cursor: pointer;">
                <option value="@Guid.Empty">All Classrooms</option>
                @foreach (var cls in _classrooms.Values.Where(c => _selectedBranchId == Guid.Empty || c.BranchId == _selectedBranchId))
                {
                    <option value="@cls.Id">@cls.Name</option>
                }
            </select>
        </div>
    }
    else if (_classrooms.Count > 1)
    {
        <div style="margin-bottom: 24px; display: flex; gap: 12px;">
            <select @bind="SelectedClassroomId" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 13px; cursor: pointer;">
                <option value="@Guid.Empty">All My Assigned Classrooms</option>
                @foreach (var cls in _classrooms.Values)
                {
                    <option value="@cls.Id">@cls.Name</option>
                }
            </select>
        </div>
    }

    @if (FilteredChildren == null)
    {
        <LoadingState Message="Loading children directory..." />
    }
    else if (!FilteredChildren.Any())
    {
        <EmptyState Icon="👶"
                    Title="No children found"
                    Description="No children match the selected branch or classroom filters. Onboard new children through the official Admissions pipeline."
                    ActionText="+ Start New Admission"
                    OnAction='() => NavigationManager.NavigateTo("/enrollment?action=new-inquiry")' />
    }
    else
    {
        <div id="childrenGrid" class="people-grid">
            @foreach (var child in FilteredChildren)
            {
                var className = "Unassigned";
                var branchName = "Unassigned";
                
                if (child.ClassroomId.HasValue && _classrooms.TryGetValue(child.ClassroomId.Value, out var cls))
                {
                    className = cls.Name;
                    if (_branches.TryGetValue(cls.BranchId, out var br))
                    {
                        branchName = br.Name;
                    }
                }

                <div @onclick="() => OpenEditChildModal(child)" style="cursor: pointer;">
                    <PersonCard AvatarInitials="@GetInitials(child.FirstName)"
                                PhotoUrl="@child.PhotoUrl"
                                Name="@child.FullName"
                                Subtitle="@($"{branchName} • {className}")"
                                Progress="@child.ProfileCompletionPercentage"
                                Status="@child.EnrollmentStatus"
                                LargeAvatar="true" />
                </div>
            }
        </div>
    }

    <ChildFormModal IsOpen="_isModalOpen"
                    IsEditing="_isEditing"
                    PhotoUrl="@_currentChild.PhotoUrl"
                    @bind-FirstName="_currentChild.FirstName"
                    @bind-LastName="_currentChild.LastName"
                    @bind-DateOfBirth="_currentChild.DateOfBirth"
                    OnClose="CloseDialog"
                    OnSave="SaveChildAsync"
                    OnDelete="DeleteChildAsync" />
</div>

@code {
    private IEnumerable<Child>? _children;
    private Dictionary<Guid, Branch> _branches = new();
    private Dictionary<Guid, Classroom> _classrooms = new();
    
    private Child _currentChild = new();
    private bool _isModalOpen = false;
    private bool _isEditing = false;

    private Guid _selectedBranchId = Guid.Empty;
    private Guid SelectedBranchId
    {
        get => _selectedBranchId;
        set
        {
            if (_selectedBranchId != value)
            {
                _selectedBranchId = value;
                SelectedClassroomId = Guid.Empty; // Reset classroom filter
            }
        }
    }

    private Guid _selectedClassroomId = Guid.Empty;
    private Guid SelectedClassroomId
    {
        get => _selectedClassroomId;
        set
        {
            if (_selectedClassroomId != value)
            {
                _selectedClassroomId = value;
            }
        }
    }

    private bool _isOrgAdmin = false;
    private bool _isBranchAdmin = false;
    private bool _isTeacherOnly = false;
    private HashSet<Guid> _assignedClassroomIds = new();
    private HashSet<Guid> _assignedBranchIds = new();

    private IEnumerable<Child>? FilteredChildren
    {
        get
        {
            if (_children == null) return null;
            
            var query = _children;
            
            if (_selectedBranchId != Guid.Empty)
            {
                var branchClassrooms = _classrooms.Values.Where(c => c.BranchId == _selectedBranchId).Select(c => c.Id).ToHashSet();
                query = query.Where(c => c.ClassroomId.HasValue && branchClassrooms.Contains(c.ClassroomId.Value));
            }
            
            if (_selectedClassroomId != Guid.Empty)
            {
                query = query.Where(c => c.ClassroomId == _selectedClassroomId);
            }
            
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantContext.TenantId;
        var userId = UserContext.UserId;
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();
        _isOrgAdmin = userRoles.Any(r =>
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase));
        _isBranchAdmin = !_isOrgAdmin && userRoles.Any(r => r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        var orgs = await OrgService.GetOrganizationsAsync();
        var defaultOrg = (UserContext.OrganizationId.HasValue
            ? orgs.FirstOrDefault(o => o.Id == UserContext.OrganizationId.Value)
            : null) ?? orgs.FirstOrDefault();

        if (tenantId != Guid.Empty && userId != Guid.Empty)
        {
            var classroomIds = await AccessScopeRepo.GetAssignedClassroomIdsAsync(tenantId, userId);
            _assignedClassroomIds = new HashSet<Guid>(classroomIds);

            if (defaultOrg != null)
            {
                var branchIds = await AccessScopeRepo.GetAssignedBranchIdsAsync(tenantId, defaultOrg.Id, userId);
                _assignedBranchIds = new HashSet<Guid>(branchIds);
            }
        }

        _isTeacherOnly = !_isOrgAdmin && !_isBranchAdmin;

        if (defaultOrg != null)
        {
            var branchesList = await BranchService.GetBranchesAsync(defaultOrg.Id);
            _branches = branchesList.ToDictionary(b => b.Id);

            var classList = await ClassroomService.GetClassroomsByOrganizationAsync(defaultOrg.Id);
            _classrooms = classList.ToDictionary(c => c.Id);
        }
        else
        {
            var classList = await ClassroomService.GetAllClassroomsAsync();
            _classrooms = classList.ToDictionary(c => c.Id);
        }

        if (_isBranchAdmin)
        {
            // Scope branches and classrooms strictly to branch admin's assignments
            if (_assignedBranchIds.Count > 0)
            {
                _branches = _branches.Where(kvp => _assignedBranchIds.Contains(kvp.Key))
                                     .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                _classrooms = _classrooms.Where(kvp => _assignedBranchIds.Contains(kvp.Value.BranchId))
                                         .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                _selectedBranchId = _assignedBranchIds.First();
            }
        }
        else if (_isTeacherOnly)
        {
            // Scope classrooms strictly to teacher's assignments
            _classrooms = _classrooms.Where(kvp => _assignedClassroomIds.Contains(kvp.Key))
                                     .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

            var allowedBranches = _classrooms.Values.Select(c => c.BranchId).ToHashSet();
            _branches = _branches.Where(kvp => allowedBranches.Contains(kvp.Key))
                                 .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

            if (_classrooms.Count == 1)
            {
                _selectedClassroomId = _classrooms.Keys.First();
            }
        }

        await LoadChildrenAsync();
    }

    private string? _toastMessage;
    private bool _toastIsError;

    private void ShowToast(string message, bool isError = false)
    {
        _toastMessage = message;
        _toastIsError = isError;
        StateHasChanged();
    }

    private async Task LoadChildrenAsync()
    {
        try
        {
            var allChildren = await ChildService.GetChildrenAsync();
            if (_isBranchAdmin && _assignedBranchIds.Count > 0)
            {
                // Boundary enforcement: Branch admins only see children in their branch classrooms
                var branchClassroomIds = _classrooms.Keys.ToHashSet();
                _children = allChildren.Where(c => c.ClassroomId.HasValue && branchClassroomIds.Contains(c.ClassroomId.Value)).ToList();
            }
            else if (_isTeacherOnly)
            {
                // Boundary enforcement: Teachers only see children in their assigned classrooms
                _children = allChildren.Where(c => c.ClassroomId.HasValue && _assignedClassroomIds.Contains(c.ClassroomId.Value)).ToList();
            }
            else
            {
                _children = allChildren;
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to load children: {ex.Message}", isError: true);
            await NotificationService.HandleExceptionAsync(ex);
        }
    }

    private void OpenAddChildModal()
    {
        NavigationManager.NavigateTo("/enrollment?action=new-inquiry");
    }

    private void OpenEditChildModal(Child child)
    {
        NavigationManager.NavigateTo($"/children/edit/{child.Id}");
    }

    private void CloseDialog()
    {
        _isModalOpen = false;
    }

    private async Task SaveChildAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentChild.FirstName) ||
            string.IsNullOrWhiteSpace(_currentChild.LastName))
        {
            ShowToast("Child first and last name are required.", isError: true);
            return;
        }

        try
        {
            if (_isEditing)
            {
                await ChildService.UpdateChildAsync(_currentChild);
                ShowToast("Child profile updated successfully.", isError: false);
            }
            else
            {
                // Direct child creation is prohibited. Redirect to admissions pipeline.
                CloseDialog();
                NavigationManager.NavigateTo("/enrollment?action=new-inquiry");
                return;
            }

            await LoadChildrenAsync();
            CloseDialog();
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to save child: {ex.Message}", isError: true);
            await NotificationService.HandleExceptionAsync(ex);
        }
    }

    private async Task DeleteChildAsync()
    {
        if (_currentChild.Id != Guid.Empty)
        {
            try
            {
                await ChildService.DeleteChildAsync(_currentChild.Id);
                ShowToast("Child record removed.", isError: false);
                await LoadChildrenAsync();
                CloseDialog();
            }
            catch (Exception ex)
            {
                ShowToast($"Failed to delete child: {ex.Message}", isError: true);
                await NotificationService.HandleExceptionAsync(ex);
            }
        }
    }

    private static string GetInitials(string? firstName)
    {
        if (string.IsNullOrWhiteSpace(firstName))
            return "?";

        return firstName.Substring(0, 1).ToUpperInvariant();
    }
}

<!-- FLOATING TOAST NOTIFICATION -->
@if (!string.IsNullOrEmpty(_toastMessage))
{
    <div style="position: fixed; bottom: 24px; right: 24px; z-index: 10000; background: @(_toastIsError ? "#782828" : "#263a32"); color: white; padding: 14px 20px; border-radius: 0px; box-shadow: 0 8px 30px rgba(0,0,0,0.3); display: flex; align-items: center; gap: 12px; font-weight: 650; font-size: 13px; border: 1px solid @(_toastIsError ? "#a83232" : "#3e6253"); max-width: 480px;">
        <span style="font-size: 16px;">@(_toastIsError ? "⚠️" : "✨")</span>
        <span style="line-height: 1.4; flex: 1;">@_toastMessage</span>
        <button type="button" @onclick="() => _toastMessage = null" style="background: none; border: none; color: white; cursor: pointer; font-size: 16px; margin-left: 12px; opacity: 0.8;" title="Dismiss">✕</button>
    </div>
}
