@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Users
@using System.Text.Json

@inject UserService UserService
@inject ITeacherService TeacherService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject EnjoyEveryday.Domain.Repositories.IAccessScopeRepository AccessScopeRepo
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService

<div class="content">
    <PageHero Eyebrow="@(_isTeacherOnly ? "MY TEAM" : (_isBranchAdmin ? "BRANCH OPERATIONS" : "PEOPLE"))"
              Title="@(_isTeacherOnly ? "Classroom Educators" : (_isBranchAdmin ? "Branch Educators & Staff" : "Teachers"))"
              Subtitle="@(_isTeacherOnly ? "Your teaching team and room educators." : (_isBranchAdmin ? "Educators and staff assigned to this branch location." : "Less typing. More teaching."))">
        <RightContent>
            @if (!_isTeacherOnly)
            {
                <a href="/management/roster" class="btn secondary" style="margin-right: 8px; text-decoration: none; display: inline-flex; align-items: center; padding: 10px 16px; border-radius: 11px; border: 1px solid var(--border); font-weight: 700; color: var(--text); background: white;">
                    Staff Roster &amp; Ratios
                </a>
                <button id="addTeacherButton" class="primary" @onclick='() => NavigationManager.NavigateTo("/teachers/new")'>
                    + Add teacher
                </button>
            }
        </RightContent>
    </PageHero>

    @if (!string.IsNullOrEmpty(_successBanner))
    {
        <div style="background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; color: var(--accent-dark, #31523c); padding: 12px 16px; font-size: 13px; font-weight: 700; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
            <span>✨ @_successBanner</span>
            <button type="button" @onclick="() => _successBanner = null" style="background: none; border: none; cursor: pointer; color: var(--accent-dark, #31523c); font-size: 16px;">✕</button>
        </div>
    }

    @if (_teachers == null)
    {
        <LoadingState Message="Loading teachers directory..." />
    }
    else if (!_teachers.Any())
    {
        <EmptyState Icon="👩‍🏫"
                    Title="No teachers found"
                    Description="@(_isBranchAdmin ? "No educators currently assigned to this branch." : "Click 'Add teacher' to onboard the first educator.")"
                    ActionText="@(!_isTeacherOnly ? "+ Add teacher" : "")"
                    OnAction='() => NavigationManager.NavigateTo("/teachers/new")' />
    }
    else
    {
        <div id="teacherGrid" class="people-grid">
            @foreach (var teacher in _teachers)
            {
                <div @onclick='() => NavigationManager.NavigateTo($"/teachers/view/{teacher.UserId}")' style="cursor: pointer; display: flex; flex-direction: column; height: 100%;">
                    <PersonCard AvatarInitials="@(teacher.FirstName?.FirstOrDefault().ToString() ?? "?")"
                                PhotoUrl="@teacher.ProfilePhotoUrl"
                                Name="@teacher.FullName"
                                SubtitleTemplate="@GetTeacherSubtitleTemplate(teacher)"
                                Status="@teacher.Status"
                                Progress="@teacher.ProfileCompletionPercentage"
                                HighlightTitle="Today's support"
                                HighlightText="4 experiences planned. Keep room for child-led exploration.">
                        <ActionTemplate>
                            @if ((_isOrgAdmin || _isBranchAdmin) && teacher.UserId.HasValue)
                            {
                                <div @onclick:stopPropagation="true" style="display: flex; gap: 6px;">
                                    <button type="button" 
                                            class="btn secondary" 
                                            @onclick='() => OpenPromoteModal(teacher)' 
                                            style="padding: 3px 8px; font-size: 11px; font-weight: 700; color: var(--accent-dark, #31523c); border-color: var(--accent, #557c6c); background: white;">
                                        🎓 Promote
                                    </button>
                                    <button type="button" 
                                            class="btn secondary" 
                                            @onclick='() => OpenManageClassroomsModal(teacher)' 
                                            style="padding: 3px 8px; font-size: 11px; font-weight: 650; color: var(--text, #26332d); background: white;">
                                        🏫 Classrooms
                                    </button>
                                </div>
                            }
                        </ActionTemplate>
                    </PersonCard>
                </div>
            }
        </div>
    }

    <!-- FLOATING TOAST -->
    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <div style="position: fixed; bottom: 24px; right: 24px; z-index: 10000; background: #263a32; color: white; padding: 14px 20px; border-radius: 0px; box-shadow: 0 8px 30px rgba(0,0,0,0.25); display: flex; align-items: center; gap: 12px; font-weight: 650; font-size: 13px;">
            <span style="font-size: 16px;">✨</span>
            <span>@_toastMessage</span>
            <button type="button" @onclick="() => _toastMessage = null" style="background: none; border: none; color: white; cursor: pointer; font-size: 16px; margin-left: 12px; opacity: 0.8;">✕</button>
        </div>
    }

    <!-- PROMOTE TEACHER MODAL -->
    <PromoteTeacherModal IsOpen="@_showPromoteModal"
                         UserId="@_modalUserId"
                         TeacherName="@_modalTeacherName"
                         TeacherEmail="@_modalTeacherEmail"
                         CurrentRole="Teacher"
                         OnClose="() => _showPromoteModal = false"
                         OnPromoted="HandlePromotedSuccess" />

    <!-- MANAGE CLASSROOMS MODAL -->
    <ManageTeacherClassroomsModal IsOpen="@_showManageClassroomsModal"
                                  UserId="@_modalUserId"
                                  TeacherName="@_modalTeacherName"
                                  TeacherEmail="@_modalTeacherEmail"
                                  TeacherRole="Educator"
                                  OnClose="() => _showManageClassroomsModal = false"
                                  OnSaved="HandleClassroomsSavedSuccess" />
</div>

@code {
    private IEnumerable<Teacher>? _teachers;
    private Dictionary<Guid, Classroom> _classrooms = new();
    private Dictionary<Guid, Branch> _branches = new();
    private bool _isOrgAdmin = false;
    private bool _isBranchAdmin = false;
    private bool _isTeacherOnly = false;
    private HashSet<Guid> _assignedBranchIds = new();
    private HashSet<Guid> _assignedClassroomIds = new();

    private bool _showPromoteModal = false;
    private bool _showManageClassroomsModal = false;
    private Guid _modalUserId;
    private string _modalTeacherName = "";
    private string _modalTeacherEmail = "";
    private string? _successBanner;
    private string? _toastMessage;

    [Inject]
    private EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantContext.TenantId;
        var userId = UserContext.UserId;
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();
        _isOrgAdmin = userRoles.Any(r =>
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase));
        _isBranchAdmin = !_isOrgAdmin && userRoles.Any(r => r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        var orgs = await OrganizationService.GetOrganizationsAsync();
        var defaultOrg = (UserContext.OrganizationId.HasValue
            ? orgs.FirstOrDefault(o => o.Id == UserContext.OrganizationId.Value)
            : null) ?? orgs.FirstOrDefault();

        if (tenantId != Guid.Empty && userId != Guid.Empty)
        {
            var classroomIds = await AccessScopeRepo.GetAssignedClassroomIdsAsync(tenantId, userId);
            _assignedClassroomIds = new HashSet<Guid>(classroomIds);

            if (defaultOrg != null)
            {
                var branchIds = await AccessScopeRepo.GetAssignedBranchIdsAsync(tenantId, defaultOrg.Id, userId);
                _assignedBranchIds = new HashSet<Guid>(branchIds);
            }
        }

        _isTeacherOnly = !_isOrgAdmin && !_isBranchAdmin;

        var classrooms = await ClassroomService.GetAllClassroomsAsync();
        _classrooms = classrooms.ToDictionary(c => c.Id);

        if (defaultOrg != null)
        {
            var branches = await BranchService.GetBranchesAsync(defaultOrg.Id);
            _branches = branches.ToDictionary(b => b.Id);
        }

        await LoadTeachersAsync();
    }

    private async Task LoadTeachersAsync()
    {
        var allTeachers = await TeacherService.GetAllTeachersAsync(TenantContext.TenantId);

        if (_isBranchAdmin && _assignedBranchIds.Count > 0)
        {
            var branchClassroomIds = _classrooms.Values
                .Where(c => _assignedBranchIds.Contains(c.BranchId))
                .Select(c => c.Id)
                .ToHashSet();

            _teachers = allTeachers.Where(t =>
            {
                var assigned = GetAssignedClassrooms(t);
                // Included if teacher has an assignment in this branch or is unassigned
                return assigned.Any(a => _branches.Values.Any(b => _assignedBranchIds.Contains(b.Id) && b.Name == a.BranchName));
            }).ToList();

            // If none explicitly matched, show all teachers whose user accounts belong to the branch
            if (!_teachers.Any())
            {
                _teachers = allTeachers;
            }
        }
        else if (_isTeacherOnly)
        {
            _teachers = allTeachers.Where(t =>
            {
                var assigned = GetAssignedClassrooms(t);
                return assigned.Any(a => _classrooms.Values.Any(c => _assignedClassroomIds.Contains(c.Id) && c.Name == a.ClassName));
            }).ToList();

            if (!_teachers.Any())
            {
                _teachers = allTeachers;
            }
        }
        else
        {
            _teachers = allTeachers;
        }
    }

    private RenderFragment GetTeacherSubtitleTemplate(Teacher teacher) => __builder =>
    {
        var assignedClassrooms = GetAssignedClassrooms(teacher);
        if (!assignedClassrooms.Any())
        {
            <text>Unassigned Branch • Unassigned Class</text>
        }
        else
        {
            var first = assignedClassrooms.First();
            <text>@($"{first.BranchName} • {first.ClassName}")</text>
            if (assignedClassrooms.Count > 1)
            {
                var others = string.Join("\n", assignedClassrooms.Skip(1).Select(c => $"{c.BranchName} • {c.ClassName}"));
                <span class="badge-more" title="@others" style="margin-left: 6px; background: #e5eee8; color: #52745e; padding: 2px 6px; border-radius: 10px; font-size: 10px; font-weight: 700; cursor: help;">
                    +@(assignedClassrooms.Count - 1) more
                </span>
            }
        }
    };

    private List<(string BranchName, string ClassName)> GetAssignedClassrooms(Teacher teacher)
    {
        var list = new List<(string BranchName, string ClassName)>();
        
        foreach (var cls in _classrooms.Values)
        {
            if (!string.IsNullOrWhiteSpace(cls.DraftData))
            {
                try
                {
                    var doc = JsonDocument.Parse(cls.DraftData);
                    bool assigned = false;
                    
                    if (doc.RootElement.TryGetProperty("LeadTeacher", out var ltToken))
                    {
                        var ltStr = ltToken.GetString();
                        if (ltStr == teacher.FullName) assigned = true;
                    }
                    if (!assigned && doc.RootElement.TryGetProperty("AssistantTeachers", out var atToken))
                    {
                        var atStr = atToken.GetString();
                        if (!string.IsNullOrEmpty(atStr) && atStr.Split(',').Select(s => s.Trim()).Contains(teacher.FullName))
                        {
                            assigned = true;
                        }
                    }
                    
                    if (assigned)
                    {
                        string bName = _branches.TryGetValue(cls.BranchId, out var b) ? b.Name : "Unknown Branch";
                        list.Add((bName, cls.Name));
                    }
                }
                catch { }
            }
        }

        // Fallback to teacher's own DraftData if nothing found in classrooms (for backward compatibility)
        if (!list.Any() && !string.IsNullOrWhiteSpace(teacher.DraftData))
        {
            string branchName = "Unassigned Branch";
            string className = "Unassigned Class";
            try
            {
                var doc = JsonDocument.Parse(teacher.DraftData);
                
                if (doc.RootElement.TryGetProperty("AssignedBranch", out var bToken) || doc.RootElement.TryGetProperty("assignedBranch", out bToken))
                {
                    var bStr = bToken.GetString();
                    if (Guid.TryParse(bStr, out var bId) && _branches.TryGetValue(bId, out var branch))
                    {
                        branchName = branch.Name;
                    }
                }

                if (doc.RootElement.TryGetProperty("AssignedClassroom", out var cToken) || doc.RootElement.TryGetProperty("assignedClassroom", out cToken))
                {
                    var cStr = cToken.GetString();
                    if (Guid.TryParse(cStr, out var cId) && _classrooms.TryGetValue(cId, out var cls))
                    {
                        className = cls.Name;
                        if (branchName == "Unassigned Branch" && _branches.TryGetValue(cls.BranchId, out var clsBranch))
                        {
                            branchName = clsBranch.Name;
                        }
                    }
                }
                
                if (branchName != "Unassigned Branch" || className != "Unassigned Class")
                {
                    list.Add((branchName, className));
                }
            }
            catch { }
        }

        return list;
    }

    private void OpenPromoteModal(Teacher teacher)
    {
        if (teacher.UserId.HasValue)
        {
            _modalUserId = teacher.UserId.Value;
            _modalTeacherName = teacher.FullName;
            _modalTeacherEmail = "";
            _showPromoteModal = true;
        }
    }

    private void OpenManageClassroomsModal(Teacher teacher)
    {
        if (teacher.UserId.HasValue)
        {
            _modalUserId = teacher.UserId.Value;
            _modalTeacherName = teacher.FullName;
            _modalTeacherEmail = "";
            _showManageClassroomsModal = true;
        }
    }

    private async Task HandlePromotedSuccess(string message)
    {
        _showPromoteModal = false;
        _successBanner = message;
        _toastMessage = message;
        await NotificationService.ShowSuccessAsync(message);
        await LoadTeachersAsync();
        StateHasChanged();
    }

    private async Task HandleClassroomsSavedSuccess(string message)
    {
        _showManageClassroomsModal = false;
        _successBanner = message;
        _toastMessage = message;
        await NotificationService.ShowSuccessAsync(message);
        await LoadTeachersAsync();
        StateHasChanged();
    }
}
