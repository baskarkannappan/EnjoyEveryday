@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ChildJourney

@inject ExperienceService ExperienceService
@inject FeedbackService FeedbackService
@inject PlannerService PlannerService
@inject ExecutionService ExecutionService
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject UserService UserService
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject HarvestService HarvestService
@inject IEndOfDayService EndOfDayService
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService

<div class="content">
    <PageHero Eyebrow="EXPERIENCE MEMORY"
              Title="Harvest &amp; Insights"
              Subtitle="What happened matters more than simply completing the activity.">
    </PageHero>

    @if (IsDaycareClosed)
    {
        <div class="closed-daycare-banner" style="display: flex; align-items: center; justify-content: space-between; gap: 14px;">
            <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                <span class="closed-banner-icon">🌙</span>
                <div>
                    <div class="closed-banner-title">Classroom &amp; Daycare Closed — Harvest Actions Locked</div>
                    <div class="closed-banner-sub">@_closedReason Rating experiences, logging child moments, and recording or modifying feedback are prohibited while the classroom is closed.</div>
                </div>
            </div>
            <button type="button" class="btn secondary" style="background: white; border: 1px solid #fed7aa; color: #9a3412; font-size: 11.5px; padding: 6px 12px; border-radius: 9px; font-weight: 700; white-space: nowrap; cursor: pointer;" @onclick="BypassDaycareClosedForTesting" title="Override daycare closed restrictions for testing">
                ⚡ Bypass for Testing
            </button>
        </div>
    }
    else if (EndOfDayService.IsBypassedForTesting())
    {
        <div style="background: #eef7f0; border: 1px solid #c3e6cb; border-radius: 12px; padding: 9px 16px; margin-bottom: 18px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: #1e6333;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>⚡</span>
                <span><strong>Testing Override Active</strong>: Daycare closed restrictions are bypassed. All actions are unlocked.</span>
            </div>
            <button type="button" class="btn secondary" style="background: white; border: 1px solid #c3e6cb; color: #1e6333; font-size: 11px; padding: 4px 10px; border-radius: 8px; font-weight: 700; cursor: pointer;" @onclick="ReenableDaycareClosedGuards">
                Re-enable Guards
            </button>
        </div>
    }

    <div class="action-required-panel">
        <h3>Action Required</h3>
        <p>You ran these experiences recently. How did they go?</p>
        <div class="pending-actions-grid">
            @if (_experiences.Any()) {
                foreach(var exp in _experiences.Where(e => e.Status != "Idea" && e.Status != "Draft").Take(2)) {
                    <button class="btn-pending primary-pending"
                            disabled="@IsDaycareClosed"
                            title="@(IsDaycareClosed ? _closedReason : $"Rate {exp.Title}")"
                            @onclick="() => OpenFeedbackDialogFor(exp.Id.ToString())">
                        ⭐ Rate "@exp.Title"
                    </button>
                }
            }
            <button class="btn-pending"
                    disabled="@IsDaycareClosed"
                    title="@(IsDaycareClosed ? _closedReason : "Log Child Moment")"
                    @onclick="OpenMomentDialog">
                📸 Log Child Moment
            </button>
            <button class="btn-pending"
                    disabled="@IsDaycareClosed"
                    title="@(IsDaycareClosed ? _closedReason : "Log Other Feedback")"
                    @onclick="OpenFeedbackDialog">
                + Log Other Feedback
            </button>
        </div>
    </div>

    <h3 class="section-title">AI Insights</h3>
    <HarvestInsightCard Title="Your daycare is learning."
                        Message="@($"{_metrics.TotalExperiences} experiences happened this month. {_metrics.TotalFeedbacks} received teacher feedback. {_metrics.PatternsDiscovered} patterns were discovered.")" />

    <!-- CURRICULUM DOMAIN BALANCE & QUALITY INSIGHTS -->
    <div class="curriculum-domain-insights-card" style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); padding: 20px; margin: 18px 0; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
            <div>
                <div style="font-size: 11px; font-weight: 800; color: var(--accent-dark, #31523c); text-transform: uppercase;">Curriculum Health</div>
                <h4 style="font-size: 16px; font-weight: 800; color: var(--text, #26332d); margin: 2px 0 0;">Early Learning Domain Coverage</h4>
            </div>
            <span style="font-size: 12px; font-weight: 700; color: #2e7d32; background: #e8f5e9; padding: 4px 10px; border-radius: 6px;">
                ✓ Well-Balanced Pedagogy
            </span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px;">
            <!-- 1. Creative Arts -->
            <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px; text-align: center;">
                <div style="font-size: 18px; margin-bottom: 4px;">🎨</div>
                <div style="font-size: 11.5px; font-weight: 750; color: var(--text, #26332d);">Creative Arts</div>
                <div style="font-size: 15px; font-weight: 800; color: var(--accent-dark, #31523c); margin: 2px 0;">32%</div>
                <div style="height: 4px; background: #e0e5de; border-radius: 2px; overflow: hidden; margin-top: 6px;">
                    <div style="width: 32%; height: 100%; background: #52745e;"></div>
                </div>
            </div>

            <!-- 2. Cognitive Inquiry -->
            <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px; text-align: center;">
                <div style="font-size: 18px; margin-bottom: 4px;">🧠</div>
                <div style="font-size: 11.5px; font-weight: 750; color: var(--text, #26332d);">Cognitive Inquiry</div>
                <div style="font-size: 15px; font-weight: 800; color: var(--accent-dark, #31523c); margin: 2px 0;">26%</div>
                <div style="height: 4px; background: #e0e5de; border-radius: 2px; overflow: hidden; margin-top: 6px;">
                    <div style="width: 26%; height: 100%; background: #31523c;"></div>
                </div>
            </div>

            <!-- 3. Social & Emotional -->
            <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px; text-align: center;">
                <div style="font-size: 18px; margin-bottom: 4px;">🤝</div>
                <div style="font-size: 11.5px; font-weight: 750; color: var(--text, #26332d);">Social &amp; Emotional</div>
                <div style="font-size: 15px; font-weight: 800; color: var(--accent-dark, #31523c); margin: 2px 0;">21%</div>
                <div style="height: 4px; background: #e0e5de; border-radius: 2px; overflow: hidden; margin-top: 6px;">
                    <div style="width: 21%; height: 100%; background: #8c5717;"></div>
                </div>
            </div>

            <!-- 4. Physical & Motor -->
            <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px; text-align: center;">
                <div style="font-size: 18px; margin-bottom: 4px;">🏃</div>
                <div style="font-size: 11.5px; font-weight: 750; color: var(--text, #26332d);">Physical &amp; Motor</div>
                <div style="font-size: 15px; font-weight: 800; color: var(--accent-dark, #31523c); margin: 2px 0;">12%</div>
                <div style="height: 4px; background: #e0e5de; border-radius: 2px; overflow: hidden; margin-top: 6px;">
                    <div style="width: 12%; height: 100%; background: #557c6c;"></div>
                </div>
            </div>

            <!-- 5. Language & Story -->
            <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px; text-align: center;">
                <div style="font-size: 18px; margin-bottom: 4px;">📖</div>
                <div style="font-size: 11.5px; font-weight: 750; color: var(--text, #26332d);">Language &amp; Story</div>
                <div style="font-size: 15px; font-weight: 800; color: var(--accent-dark, #31523c); margin: 2px 0;">9%</div>
                <div style="height: 4px; background: #e0e5de; border-radius: 2px; overflow: hidden; margin-top: 6px;">
                    <div style="width: 9%; height: 100%; background: #3e6253;"></div>
                </div>
            </div>
        </div>
    </div>

    <h3 class="section-title">Experience Performance</h3>

    <div class="harvest-layout">
        <ExperiencePerformanceGrid Items="@_performanceItems"
                                   IsActionDisabled="@IsDaycareClosed"
                                   DisabledReason="@_closedReason"
                                   OnViewClick="OnViewClick" />

        <TeacherFeedbackList Items="@_feedbackItems"
                             OnItemClick="EditFeedback" />
    </div>

    <Flywheel Steps="@_flywheelSteps" />

    <FeedbackFormModal IsOpen="@_isModalOpen"
                       IsEditing="@_currentFeedbackId.HasValue"
                       @bind-SelectedExperienceId="_selectedExperienceId"
                       @bind-Rating="_rating"
                       @bind-FeedbackText="_feedbackText"
                       ExperienceOptions="@(_experiences.Select(e => new KeyValuePair<string, string>(e.Id.ToString(), e.Title)))"
                       OnClose="CloseDialog"
                       OnSave="ConfirmFeedback"
                       OnDelete="DeleteFeedback" />

    <AddJourneyMomentDialog @ref="_addMomentDialog" TeacherId="@UserContext.UserId" OnSaved="OnMomentSaved" />
</div>

@code {
    private AddJourneyMomentDialog _addMomentDialog = default!;

    private HarvestMetricsDto _metrics = new HarvestMetricsDto();
    private IQueryable<ExperiencePerformanceItem> _performanceItems = new List<ExperiencePerformanceItem>().AsQueryable();

    private List<FlywheelStep> _flywheelSteps = new()
    {
        new FlywheelStep { Name = "Create", IsActive = true },
        new FlywheelStep { Name = "Schedule", IsActive = true },
        new FlywheelStep { Name = "Experience", IsActive = true },
        new FlywheelStep { Name = "Harvest", IsActive = true },
        new FlywheelStep { Name = "Improve", IsActive = false },
        new FlywheelStep { Name = "Reuse", IsActive = false },
    };

    private List<Experience> _experiences = new();
    private List<ExperienceSchedule> _schedules = new();
    private List<ExperienceFeedback> _feedbacks = new();
    private Dictionary<Guid, string> _userNames = new();

    private IEnumerable<FeedbackItem> _feedbackItems =>
        _feedbacks.Select(f => new FeedbackItem
        {
            Id = f.Id,
            Notes = f.Notes ?? "",
            Author = _userNames.TryGetValue(f.TeacherId, out var name) ? $"{name} • Teacher" : "Teacher",
            Rating = f.Rating,
            CreatedAt = f.CreatedAt
        });

    private string _feedbackText = string.Empty;
    private string _rating = "Good";
    private string? _selectedExperienceId;

    private Guid? _currentFeedbackId;
    private bool _isModalOpen = false;
    private string _closedReason = string.Empty;
    private bool IsDaycareClosed => ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out _closedReason);

    protected override async Task OnInitializedAsync()
    {
        _experiences = (await ExperienceService.GetExperiencesAsync()).ToList();

        var teachers = await UserService.GetTeachersAsync();
        _userNames = teachers.ToDictionary(u => u.Id, u => string.IsNullOrWhiteSpace(u.FirstName) ? "User" : u.FirstName);

        _metrics = await HarvestService.GetMonthlyMetricsAsync();
        var dtos = await HarvestService.GetPerformanceItemsAsync();
        _performanceItems = dtos.Select(d => new ExperiencePerformanceItem
        {
            ExperienceId = d.ExperienceId,
            Title = d.Title,
            Subtitle = d.Subtitle,
            Uses = d.Uses,
            Response = d.Response
        }).AsQueryable();

        await LoadFeedbacks();
    }

    private async Task LoadFeedbacks()
    {
        _feedbacks = (await FeedbackService.GetAllFeedbackAsync()).ToList();
        StateHasChanged();
    }

    private async Task OpenFeedbackDialog()
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        _currentFeedbackId = null;
        _isModalOpen = true;
        _feedbackText = string.Empty;
        _rating = "Good";
        if (_experiences.Any()) { _selectedExperienceId = _experiences.First().Id.ToString(); }
    }

    private async Task OpenFeedbackDialogFor(string experienceId)
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        _currentFeedbackId = null;
        _isModalOpen = true;
        _feedbackText = string.Empty;
        _rating = "Good";
        _selectedExperienceId = experienceId;
    }

    private async Task OpenMomentDialog()
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        await _addMomentDialog.OpenAsync();
    }

    private void OnMomentSaved()
    {
        StateHasChanged();
    }

    private async Task EditFeedback(FeedbackItem item)
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        var feedback = _feedbacks.FirstOrDefault(f => f.Id == item.Id);
        if (feedback != null)
        {
            _currentFeedbackId = feedback.Id;
            _feedbackText = feedback.Notes ?? "";
            _rating = feedback.Rating ?? "Good";
            _isModalOpen = true;
        }
    }

    private async Task DeleteFeedback()
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        if (_currentFeedbackId.HasValue)
        {
            try
            {
                await FeedbackService.DeleteFeedbackAsync(_currentFeedbackId.Value);
                await NotificationService.ShowSuccessAsync("Feedback deleted.");
                await LoadFeedbacks();
                CloseDialog();
            }
            catch (Exception ex)
            {
                await NotificationService.HandleExceptionAsync(ex);
            }
        }
    }

    private void CloseDialog() => _isModalOpen = false;

    private async Task ConfirmFeedback()
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        if (string.IsNullOrEmpty(_selectedExperienceId) || string.IsNullOrEmpty(_feedbackText)) return;

        try
        {
            var teacherId = UserContext.UserId != Guid.Empty ? UserContext.UserId : Guid.Parse("50000000-0000-0000-0000-000000000001");
            var expId = Guid.Parse(_selectedExperienceId);

            if (_currentFeedbackId.HasValue)
            {
                var feedback = await FeedbackService.GetFeedbackByIdAsync(_currentFeedbackId.Value);
                if (feedback != null)
                {
                    feedback.Notes = _feedbackText;
                    feedback.Rating = _rating;
                    await FeedbackService.UpdateFeedbackAsync(feedback);
                    await NotificationService.ShowSuccessAsync("Feedback updated successfully.");
                }
            }
            else
            {
                var orgs = await OrganizationService.GetOrganizationsAsync();
                var org = orgs.FirstOrDefault();
                if (org == null)
                {
                    await NotificationService.ShowWarningAsync("No organization found to record feedback.");
                    return;
                }
                var branch = (await BranchService.GetBranchesAsync(org.Id)).FirstOrDefault();
                if (branch == null)
                {
                    await NotificationService.ShowWarningAsync("No branch found to record feedback.");
                    return;
                }
                var classroom = (await ClassroomService.GetClassroomsAsync(branch.Id)).FirstOrDefault();
                if (classroom == null)
                {
                    await NotificationService.ShowWarningAsync("No classroom found to record feedback.");
                    return;
                }

                // Check for existing schedule for this experience and classroom today
                var schedulesToday = (await PlannerService.GetSchedulesForDateAsync(DateOnly.FromDateTime(DateTime.Today))).ToList();
                var existingSchedule = schedulesToday.FirstOrDefault(s => s.ExperienceId == expId && s.ClassroomId == classroom.Id);

                Guid scheduleId;
                if (existingSchedule != null)
                {
                    scheduleId = existingSchedule.Id;
                }
                else
                {
                    // Find an open time slot that doesn't conflict with existing classroom schedules
                    var bookedSlots = schedulesToday
                        .Where(s => s.ClassroomId == classroom.Id && !string.Equals(s.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                        .Select(s => s.TimeOfDay.Trim().ToLowerInvariant())
                        .ToHashSet();

                    string chosenSlot = "Morning";
                    if (bookedSlots.Contains("morning"))
                    {
                        if (!bookedSlots.Contains("mid-day")) chosenSlot = "Mid-Day";
                        else if (!bookedSlots.Contains("afternoon")) chosenSlot = "Afternoon";
                        else chosenSlot = "Evening";
                    }

                    var schedule = await PlannerService.ScheduleExperienceAsync(expId, classroom.Id, DateOnly.FromDateTime(DateTime.Today), chosenSlot);
                    scheduleId = schedule.Id;
                }

                await FeedbackService.CreateFeedbackAsync(scheduleId, teacherId, _rating, _feedbackText);
                await NotificationService.ShowSuccessAsync("Feedback saved successfully.");
            }

            await LoadFeedbacks();
            CloseDialog();
        }
        catch (Exception ex)
        {
            await NotificationService.HandleExceptionAsync(ex);
        }
    }

    private async Task OnViewClick(ExperiencePerformanceItem item)
    {
        if (ExecutionService.IsDaycareClosedForActivity(DateOnly.FromDateTime(DateTime.Today), out var closedReason))
        {
            await NotificationService.ShowWarningAsync(closedReason);
            return;
        }
        if (item.ExperienceId != Guid.Empty)
        {
            await _addMomentDialog.OpenForExperienceAsync(item.ExperienceId, item.Title);
        }
    }

    private void BypassDaycareClosedForTesting()
    {
        EndOfDayService.SetRuntimeBypass(true);
        StateHasChanged();
    }

    private void ReenableDaycareClosedGuards()
    {
        EndOfDayService.SetRuntimeBypass(false);
        StateHasChanged();
    }
}
