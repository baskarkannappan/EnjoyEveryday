@namespace EnjoyEveryday.Parent.Web.Components.Shared

<div class="chat-bubble-row @(IsFromParent ? "from-parent" : "from-teacher")">
    @if (!IsFromParent)
    {
        <div class="chat-avatar" title="@SenderName">
            👩‍🏫
        </div>
    }

    <div class="chat-bubble">
        @if (!IsFromParent && !string.IsNullOrEmpty(SenderName))
        {
            <div class="chat-sender-name">@SenderName</div>
        }

        <div class="chat-bubble-text">
            @Content
        </div>

        <div class="chat-bubble-meta">
            <span class="chat-time">@Timestamp.ToString("h:mm tt")</span>
            @if (IsFromParent)
            {
                <MessageStatus Status="@DeliveryStatus" />
            }
        </div>
    </div>
</div>

<style>
    .chat-bubble-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
        max-width: 85%;
    }

    .chat-bubble-row.from-parent {
        align-self: flex-end;
        margin-left: auto;
    }

    .chat-bubble-row.from-teacher {
        align-self: flex-start;
        margin-right: auto;
    }

    .chat-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--accent-light, #e6eee9);
        display: grid;
        place-items: center;
        font-size: 16px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .chat-bubble {
        padding: 10px 14px;
        border-radius: 16px;
        position: relative;
        word-break: break-word;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.04);
    }

    .from-parent .chat-bubble {
        background: var(--accent, #557c6c);
        color: #ffffff;
        border-bottom-right-radius: 4px;
    }

    .from-teacher .chat-bubble {
        background: var(--surface, #ffffff);
        color: var(--text, #26332d);
        border: 1px solid var(--border, #e4e7df);
        border-bottom-left-radius: 4px;
    }

    .chat-sender-name {
        font-size: 11px;
        font-weight: 750;
        color: var(--accent-dark, #3e6253);
        margin-bottom: 3px;
    }

    .chat-bubble-text {
        font-size: 13.5px;
        line-height: 1.45;
        white-space: pre-wrap;
    }

    .chat-bubble-meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        margin-top: 4px;
    }

    .from-parent .chat-time {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.8);
    }

    .from-teacher .chat-time {
        font-size: 10px;
        color: var(--muted, #6c7870);
    }
</style>

@code {
    [Parameter] public string SenderName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Content { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset Timestamp { get; set; } = DateTimeOffset.UtcNow;
    [Parameter] public bool IsFromParent { get; set; }
    [Parameter] public string? DeliveryStatus { get; set; }
}
