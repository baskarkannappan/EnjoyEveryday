        background: var(--surface-soft, #f8f9f5);
    }

    .modal-eyebrow {
        font-size: 11px;
        font-weight: 800;
        color: var(--accent, #557c6c);
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .modal-title {
        font-size: 17px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin: 2px 0 0;
    }

    .close-btn {
        background: transparent;
        border: none;
        font-size: 16px;
        color: var(--muted, #6c7870);
        cursor: pointer;
        padding: 4px;
