    }

    .pickup-name {
        font-size: 14px;
        font-weight: 750;
        color: var(--text, #26332d);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .primary-pill {
        font-size: 10px;
        background: var(--accent-dark, #3e6253);
