        color: var(--accent-dark, #3e6253);
        display: block;
        margin-bottom: 2px;
    }

    .security-alert-box p {
        margin: 0;
        font-size: 12px;
        color: var(--text, #26332d);
        line-height: 1.4;
    }

    .pickups-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pickup-card {
        display: flex;
        align-items: center;
