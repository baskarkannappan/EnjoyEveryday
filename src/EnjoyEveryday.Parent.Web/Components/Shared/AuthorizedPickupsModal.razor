@inject IParentService ParentService
@inject ParentLocalizationService Localization

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <span class="modal-eyebrow">@Localization.T("Action.AuthorizedPickups")</span>
                    <h3 class="modal-title">Security & Pickup Authorization</h3>
                </div>
                <button class="close-btn" @onclick="Close" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (isLoading)
                {
                    <div class="loading-wrap">
                        <LoadingState Message="Loading authorized guardians..." />
                    </div>
                }
                else if (securityProfile == null || securityProfile.AuthorizedPickups.Count == 0)
                {
                    <EmptyState Title="No Pickups Configured"
                                Message="No authorized pickup persons on file. Please contact your center administrator."
                                Icon="🛡️" />
                }
                else
                {
                    <div class="security-alert-box">
                        <span class="shield-icon">🛡️</span>
                        <div>
                            <strong>Daycare Security Check</strong>
                            <p>Staff verify government photo ID or guardian digital pickup code for any adult releasing @ChildName.</p>
                        </div>
                    </div>

                    <div class="pickups-list">
                        @foreach (var pickup in securityProfile.AuthorizedPickups)
                        {
                            <div class="pickup-card">
                                <div class="pickup-avatar">
                                    @(string.IsNullOrWhiteSpace(pickup.FullName) ? "G" : pickup.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div class="pickup-details">
                                    <div class="pickup-name">
                                        @pickup.FullName
                                        @if (pickup.IsPrimaryGuardian)
                                        {
                                            <span class="primary-pill">Primary</span>
                                        }
                                    </div>
                                    <div class="pickup-rel">@pickup.Relationship @(!string.IsNullOrWhiteSpace(pickup.Phone) ? $"• {pickup.Phone}" : "")</div>
                                </div>
                                <div class="pickup-status">
                                    <span class="verified-tag">✓ Verified</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <span class="footer-note">To add or modify permanent legal guardians, submit a verified request at the front desk.</span>
                <button class="primary" @onclick="Close">@Localization.T("Action.Close")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid ChildId { get; set; }
    [Parameter] public string ChildName { get; set; } = "Your child";
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool isLoading = true;
    private ChildPickupSecurityProfile? securityProfile = null;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && ChildId != Guid.Empty)
        {
            isLoading = true;
            try
            {
                securityProfile = await ParentService.GetChildPickupSecurityProfileAsync(ChildId);
            }
            catch
            {
                securityProfile = null;
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(38, 51, 45, 0.45);
        backdrop-filter: blur(4px);
        display: flex;
