@namespace EnjoyEveryday.Parent.Web.Components.Shared

@if (HasMore)
{
    <div class="load-more-container">
        <button class="secondary load-more-btn" @onclick="HandleClick" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="load-more-spinner"></span>
                <span>Loading more...</span>
            }
            else
            {
                <span>@ButtonText</span>
            }
        </button>
        @if (TotalCount.HasValue && LoadedCount.HasValue)
        {
            <div class="load-more-count">
                Showing @LoadedCount of @TotalCount items
            </div>
        }
    </div>
}

<style>
    .load-more-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        margin: 20px 0;
        width: 100%;
    }

    .load-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 22px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        border-radius: 11px !important;
        cursor: pointer;
    }

    .load-more-count {
        font-size: 11.5px;
        color: var(--muted, #6c7870);
    }

    .load-more-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid var(--border, #e4e7df);
        border-top-color: var(--accent, #557c6c);
        border-radius: 50%;
        animation: loadMoreSpin 0.8s linear infinite;
    }

    @@keyframes loadMoreSpin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter] public bool HasMore { get; set; } = true;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string ButtonText { get; set; } = "Load More";
    [Parameter] public int? LoadedCount { get; set; }
    [Parameter] public int? TotalCount { get; set; }
    [Parameter] public EventCallback OnLoadMore { get; set; }

    private async Task HandleClick() => await OnLoadMore.InvokeAsync();
}
