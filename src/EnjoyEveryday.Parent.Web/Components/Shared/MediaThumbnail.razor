@namespace EnjoyEveryday.Parent.Web.Components.Shared

<div class="media-thumb-card" 
     @onclick="HandleClick"
     @onkeydown="HandleKeyDown"
     tabindex="0" 
     role="button"
     aria-label="@(Title ?? "View media")">
    <div class="media-thumb-img-wrap">
        <img src="@(ThumbnailUrl ?? ImageUrl)" 
             alt="@(Title ?? "Photo")" 
             class="media-thumb-img" 
             loading="lazy" 
             decoding="async" />
        @if (IsVideo)
        {
            <div class="media-video-badge" aria-label="Video">▶</div>
        }
        @if (!string.IsNullOrEmpty(Category))
        {
            <div class="media-cat-pill">@Category</div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(DateLabel))
    {
        <div class="media-thumb-caption">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="media-thumb-title">@Title</div>
            }
            @if (!string.IsNullOrEmpty(DateLabel))
            {
                <div class="media-thumb-date">@DateLabel</div>
            }
        </div>
    }
</div>

<style>
    .media-thumb-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.03);
        outline: none;
    }

    .media-thumb-card:hover,
    .media-thumb-card:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(40, 55, 47, 0.08);
        border-color: var(--accent, #557c6c);
    }

    .media-thumb-img-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        background: var(--surface-soft, #f8f9f5);
        overflow: hidden;
    }

    .media-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.25s ease;
    }

    .media-thumb-card:hover .media-thumb-img {
        transform: scale(1.03);
    }

    .media-video-badge {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 36px;
        height: 36px;
        background: rgba(38, 51, 45, 0.85);
        color: #ffffff;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 14px;
        backdrop-filter: blur(4px);
    }

    .media-cat-pill {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(255, 255, 255, 0.9);
        color: var(--text, #26332d);
        font-size: 9.5px;
        font-weight: 750;
        padding: 2px 7px;
        border-radius: 6px;
        backdrop-filter: blur(4px);
    }

    .media-thumb-caption {
        padding: 8px 10px;
        background: var(--surface, #ffffff);
    }

    .media-thumb-title {
        font-size: 12.5px;
        font-weight: 750;
        color: var(--text, #26332d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .media-thumb-date {
        font-size: 10.5px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }
</style>

@code {
    [Parameter, EditorRequired] public string ImageUrl { get; set; } = string.Empty;
    [Parameter] public string? ThumbnailUrl { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? DateLabel { get; set; }
    [Parameter] public string? Category { get; set; }
    [Parameter] public bool IsVideo { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick() => await OnClick.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await OnClick.InvokeAsync();
        }
    }
}
