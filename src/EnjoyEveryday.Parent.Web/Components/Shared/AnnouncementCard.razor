@namespace EnjoyEveryday.Parent.Web.Components.Shared

<div class="announcement-card @(IsUrgent ? "urgent" : "")">
    <div class="announcement-top">
        <div class="announcement-tag-wrap">
            <span class="announcement-icon">@(IsUrgent ? "📢" : "📌")</span>
            <span class="announcement-tag @(IsUrgent ? "urgent" : "")">@Tag</span>
        </div>
        <span class="announcement-date">@Date.ToString("MMM dd, yyyy")</span>
    </div>
    <h4 class="announcement-title">@Title</h4>
    <p class="announcement-content">@Content</p>
</div>

<style>
    .announcement-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 14px;
        padding: 14px 16px;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.03);
        margin-bottom: 12px;
    }

    .announcement-card.urgent {
        border-color: #fca5a5;
        background: #fffafa;
    }

    .announcement-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .announcement-tag-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .announcement-icon {
        font-size: 13px;
    }

    .announcement-tag {
        font-size: 9.5px;
        font-weight: 750;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        padding: 2px 7px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .announcement-tag.urgent {
        background: #fee2e2;
        color: #991b1b;
    }

    .announcement-date {
        font-size: 11px;
        color: var(--muted, #6c7870);
    }

    .announcement-title {
        font-size: 14px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin: 0 0 4px 0;
    }

    .announcement-content {
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        line-height: 1.45;
        margin: 0;
    }
</style>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Content { get; set; } = string.Empty;
    [Parameter] public DateTime Date { get; set; } = DateTime.Today;
    [Parameter] public string Tag { get; set; } = "Notice";
    [Parameter] public bool IsUrgent { get; set; }
}
