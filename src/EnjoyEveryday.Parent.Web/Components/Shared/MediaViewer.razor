@namespace EnjoyEveryday.Parent.Web.Components.Shared

@if (IsOpen && CurrentItem != null)
{
    <div class="media-viewer-backdrop" 
         @onclick="HandleClose"
         @onkeydown="HandleKeyDown"
         tabindex="0"
         role="dialog"
         aria-modal="true"
         aria-label="@(CurrentItem.Title ?? "Media viewer")">

        <div class="media-viewer-container" @onclick:stopPropagation>
            <!-- Top bar -->
            <div class="media-viewer-topbar">
                <div class="media-viewer-info">
                    <span class="media-viewer-title">@CurrentItem.Title</span>
                    <span class="media-viewer-date">@CurrentItem.Date.ToString("MMMM dd, yyyy · h:mm tt")</span>
                </div>
                <button class="media-viewer-close-btn" 
                        @onclick="HandleClose" 
                        aria-label="Close media viewer">
                    ✕
                </button>
            </div>

            <!-- Main media content -->
            <div class="media-viewer-content">
                @if (HasPrevious)
                {
                    <button class="media-nav-btn prev" 
                            @onclick="HandlePrevious" 
                            aria-label="Previous photo">
                        ‹
                    </button>
                }

                <div class="media-display-frame">
                    @if (CurrentItem.IsVideo)
                    {
                        <video src="@CurrentItem.Url" 
                               controls 
                               playsinline 
                               class="media-full-asset" 
                               autoplay="false" />
                    }
                    else
                    {
                        <img src="@CurrentItem.Url" 
                             alt="@CurrentItem.Title" 
                             class="media-full-asset" />
                    }
                </div>

                @if (HasNext)
                {
                    <button class="media-nav-btn next" 
                            @onclick="HandleNext" 
                            aria-label="Next photo">
                        ›
                    </button>
                }
            </div>

            <!-- Bottom caption -->
            @if (!string.IsNullOrEmpty(CurrentItem.Caption))
            {
                <div class="media-viewer-caption">
                    <p>@CurrentItem.Caption</p>
                </div>
            }
        </div>
    </div>
}

<style>
    .media-viewer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(18, 27, 22, 0.88);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        box-sizing: border-box;
        outline: none;
    }

    .media-viewer-container {
        max-width: 900px;
        width: 100%;
        max-height: 94vh;
        background: #1c2b20;
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .media-viewer-topbar {
        padding: 14px 20px;
        background: rgba(28, 43, 32, 0.95);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .media-viewer-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .media-viewer-title {
        color: #ffffff;
        font-weight: 750;
        font-size: 15px;
        letter-spacing: -0.2px;
    }

    .media-viewer-date {
        color: #a0b2a6;
        font-size: 11.5px;
    }

    .media-viewer-close-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        border: none;
        font-size: 16px;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background 0.15s ease;
    }

    .media-viewer-close-btn:hover {
        background: rgba(255, 255, 255, 0.25);
    }

    .media-viewer-content {
        position: relative;
        flex: 1;
        min-height: 280px;
        max-height: 68vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #121b16;
        overflow: hidden;
    }

    .media-display-frame {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        box-sizing: border-box;
    }

    .media-full-asset {
        max-width: 100%;
        max-height: 65vh;
        object-fit: contain;
        border-radius: 8px;
    }

    .media-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(28, 43, 32, 0.85);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 24px;
        display: grid;
        place-items: center;
        cursor: pointer;
        z-index: 10;
        transition: background 0.15s ease;
    }

    .media-nav-btn:hover {
        background: rgba(62, 98, 83, 0.95);
    }

    .media-nav-btn.prev {
        left: 12px;
    }

    .media-nav-btn.next {
        right: 12px;
    }

    .media-viewer-caption {
        padding: 12px 20px;
        background: rgba(28, 43, 32, 0.95);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .media-viewer-caption p {
        margin: 0;
        font-size: 13px;
        color: #e2ece5;
        line-height: 1.5;
    }

    @@media (max-width: 640px) {
        .media-viewer-backdrop {
            padding: 0;
        }

        .media-viewer-container {
            max-height: 100vh;
            height: 100vh;
            border-radius: 0;
        }

        .media-nav-btn {
            width: 38px;
            height: 38px;
            font-size: 20px;
        }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public MediaItemModel? CurrentItem { get; set; }
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    private async Task HandleClose() => await OnClose.InvokeAsync();
    private async Task HandlePrevious() => await OnPrevious.InvokeAsync();
    private async Task HandleNext() => await OnNext.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await HandleClose();
        }
        else if (e.Key == "ArrowLeft" && HasPrevious)
        {
            await HandlePrevious();
        }
        else if (e.Key == "ArrowRight" && HasNext)
        {
            await HandleNext();
        }
    }
}
