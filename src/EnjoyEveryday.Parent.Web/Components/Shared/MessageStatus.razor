@namespace EnjoyEveryday.Parent.Web.Components.Shared

<span class="message-status-icon @StatusClass" title="@StatusTitle">
    @StatusIcon
</span>

<style>
    .message-status-icon {
        font-size: 10px;
        display: inline-flex;
        align-items: center;
        opacity: 0.85;
    }

    .message-status-icon.sending {
        opacity: 0.6;
    }

    .message-status-icon.failed {
        color: #fca5a5;
        font-weight: bold;
    }
</style>

@code {
    [Parameter] public string? Status { get; set; }

    private string StatusClass => (Status?.ToLowerInvariant()) switch
    {
        "sending" => "sending",
        "failed" or "deliveryfailed" => "failed",
        _ => "delivered"
    };

    private string StatusIcon => (Status?.ToLowerInvariant()) switch
    {
        "sending" => "⏳",
        "failed" or "deliveryfailed" => "⚠️",
        "read" => "✓✓",
        _ => "✓"
    };

    private string StatusTitle => (Status?.ToLowerInvariant()) switch
    {
        "sending" => "Sending...",
        "failed" or "deliveryfailed" => "Delivery failed",
        "read" => "Read",
        _ => "Sent"
    };
}
