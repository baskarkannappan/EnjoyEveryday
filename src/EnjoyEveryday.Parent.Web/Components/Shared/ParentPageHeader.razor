@namespace EnjoyEveryday.Parent.Web.Components.Shared

<div class="parent-hero-banner">
    <div class="parent-hero-main">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <div class="parent-hero-eyebrow">@Eyebrow</div>
        }
        <h1 class="parent-hero-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="parent-hero-subtitle">@Subtitle</div>
        }
        @if (SubtitleContent != null)
        {
            <div class="parent-hero-subtitle">
                @SubtitleContent
            </div>
        }
    </div>

    @if (RightContent != null)
    {
        <div class="parent-hero-right">
            @RightContent
        </div>
    }
</div>

<style>
    .parent-hero-banner {
        background: linear-gradient(135deg, #f7f9f6 0%, #ffffff 100%);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        padding: 18px 22px;
        margin-bottom: 20px;
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .05));
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        box-sizing: border-box;
    }

    .parent-hero-main {
        flex: 1;
        min-width: 220px;
    }

    .parent-hero-eyebrow {
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 1px;
        color: var(--accent, #557c6c);
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .parent-hero-title {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.4px;
        color: var(--text, #26332d);
        margin: 0 0 4px 0;
        line-height: 1.25;
    }

    .parent-hero-subtitle {
        font-size: 13px;
        color: var(--muted, #6c7870);
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .parent-hero-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    @@media (max-width: 640px) {
        .parent-hero-banner {
            padding: 14px 16px;
            margin-bottom: 16px;
        }

        .parent-hero-title {
            font-size: 19px;
        }

        .parent-hero-subtitle {
            font-size: 12px;
        }

        .parent-hero-right {
            width: 100%;
            justify-content: flex-start;
        }
    }
</style>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? SubtitleContent { get; set; }
    [Parameter] public RenderFragment? RightContent { get; set; }
}
