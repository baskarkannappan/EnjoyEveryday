@namespace EnjoyEveryday.Parent.Web.Components.Shared
@using EnjoyEveryday.UI.Shared.Components

<div class="media-gallery-container">
    @if (ShowFilters && Items != null && Items.Any())
    {
        <div class="media-gallery-filters">
            <button class="media-filter-btn @(_activeFilter == "All" ? "active" : "")" 
                    @onclick='() => SetFilter("All")'>
                All (@Items.Count)
            </button>
            <button class="media-filter-btn @(_activeFilter == "Celebration" ? "active" : "")" 
                    @onclick='() => SetFilter("Celebration")'>
                Celebrations (@Items.Count(i => i.Category == "Celebration"))
            </button>
            <button class="media-filter-btn @(_activeFilter == "Journey" ? "active" : "")" 
                    @onclick='() => SetFilter("Journey")'>
                Journey &amp; Discoveries (@Items.Count(i => i.Category == "Journey"))
            </button>
        </div>
    }

    @if (FilteredItems == null || !FilteredItems.Any())
    {
        <EmptyState Icon="📸"
                    Title="@(SelectedDate.HasValue ? $"No Memories on {SelectedDate.Value:MMM dd, yyyy}" : "No Memories Found")"
                    Description="@(SelectedDate.HasValue ? "No photos or observations were recorded on the selected date. Try selecting another date or viewing all dates." : "Photos and videos captured by educators during activities and celebrations will appear here.")"
                    ActionText="@(SelectedDate.HasValue && OnClearDate.HasDelegate ? "Show All Dates" : null)"
                    OnAction="OnClearDate"
                    MinHeightPx="180" />
    }
    else
    {
        <div class="media-gallery-grid">
            @foreach (var item in PagedItems)
            {
                <MediaThumbnail ImageUrl="@item.Url"
                                ThumbnailUrl="@item.ThumbnailUrl"
                                Title="@item.Title"
                                DateLabel="@item.Date.ToString("MMM dd, yyyy")"
                                Category="@item.Category"
                                IsVideo="@item.IsVideo"
                                OnClick="@(() => OnSelectMedia.InvokeAsync(item))" />
            }
        </div>

        @if (TotalFilteredCount > 0)
        {
            <div class="media-pagination-bar">
                <div class="media-pagination-summary">
                    Showing <strong>@PageStartItem&ndash;@PageEndItem</strong> of <strong>@TotalFilteredCount</strong> memories
                    <span class="media-page-pill">Page @SafeCurrentPage of @TotalPages</span>
                </div>
                <div class="media-pagination-actions">
                    <button type="button"
                            class="btn-media-page secondary"
                            disabled="@(SafeCurrentPage <= 1)"
                            @onclick="PrevPage">
                        &larr; Previous
                    </button>
                    <button type="button"
                            class="btn-media-page primary"
                            disabled="@(SafeCurrentPage >= TotalPages)"
                            @onclick="NextPage">
                        Next &rarr;
                    </button>
                </div>
            </div>
        }
    }
</div>

<style>
    .media-gallery-container {
        width: 100%;
        box-sizing: border-box;
    }

    .media-gallery-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .media-filter-btn {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 650;
        color: var(--muted, #6c7870);
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .media-filter-btn:hover {
        background: var(--surface-soft, #f8f9f5);
        color: var(--text, #26332d);
    }

    .media-filter-btn.active {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        border-color: #bcd3c5;
        font-weight: 750;
    }

    .media-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }

    @@media (min-width: 768px) {
        .media-gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 16px;
        }
    }

    .media-pagination-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 20px;
        padding: 14px 18px;
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 16px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, 0.06));
    }

    .media-pagination-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        flex-wrap: wrap;
    }

    .media-pagination-summary strong {
        color: var(--text, #26332d);
        font-weight: 800;
    }

    .media-page-pill {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        border: 1px solid #c8dacd;
        font-size: 11px;
        font-weight: 750;
    }

    .media-pagination-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-media-page {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 15px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.18s ease;
    }

    .btn-media-page.secondary {
        background: #ffffff;
        border: 1px solid var(--border, #e4e7df);
        color: var(--text, #26332d);
    }

    .btn-media-page.secondary:hover:not(:disabled) {
        background: var(--surface-soft, #f8f9f5);
        border-color: #c8dacd;
        transform: translateY(-1px);
    }

    .btn-media-page.primary {
        background: var(--accent, #52745e);
        border: 1px solid var(--accent-dark, #31523c);
        color: #ffffff;
    }

    .btn-media-page.primary:hover:not(:disabled) {
        background: var(--accent-dark, #31523c);
        transform: translateY(-1px);
    }

    .btn-media-page:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
    }
</style>

@code {
    [Parameter] public IReadOnlyList<MediaItemModel>? Items { get; set; }
    [Parameter] public bool ShowFilters { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public EventCallback OnClearDate { get; set; }
    [Parameter] public EventCallback<MediaItemModel> OnSelectMedia { get; set; }

    private string _activeFilter = "All";
    private int _currentPage = 1;
    private DateOnly? _previousSelectedDate;
    private int _previousItemsCount;

    protected override void OnParametersSet()
    {
        var currentCount = Items?.Count ?? 0;
        if (_previousSelectedDate != SelectedDate || _previousItemsCount != currentCount)
        {
            _currentPage = 1;
            _previousSelectedDate = SelectedDate;
            _previousItemsCount = currentCount;
        }
    }

    private IEnumerable<MediaItemModel> FilteredItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<MediaItemModel>();
            if (_activeFilter == "All") return Items;
            return Items.Where(i => string.Equals(i.Category, _activeFilter, StringComparison.OrdinalIgnoreCase));
        }
    }

    private int TotalFilteredCount => FilteredItems.Count();
    private int EffectivePageSize => Math.Max(1, PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / EffectivePageSize));
    private int SafeCurrentPage => Math.Clamp(_currentPage, 1, TotalPages);
    private int PageStartItem => TotalFilteredCount == 0 ? 0 : ((SafeCurrentPage - 1) * EffectivePageSize) + 1;
    private int PageEndItem => Math.Min(SafeCurrentPage * EffectivePageSize, TotalFilteredCount);

    private IEnumerable<MediaItemModel> PagedItems =>
        FilteredItems.Skip((SafeCurrentPage - 1) * EffectivePageSize).Take(EffectivePageSize);

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
        _currentPage = 1;
    }

    private void PrevPage()
    {
        if (SafeCurrentPage > 1)
        {
            _currentPage = SafeCurrentPage - 1;
        }
    }

    private void NextPage()
    {
        if (SafeCurrentPage < TotalPages)
        {
            _currentPage = SafeCurrentPage + 1;
        }
    }
}
