@namespace EnjoyEveryday.Parent.Web.Components.Shared
@using EnjoyEveryday.Domain.Entities

<div class="care-summary-card">
    <div class="care-summary-header">
        <div>
            <h3 class="care-summary-title">Today at EnjoyEveryday</h3>
            <span class="care-summary-subtitle">Daily care &amp; wellbeing summary</span>
        </div>
        <div class="care-summary-pill">Wellbeing</div>
    </div>

    @if (Report != null)
    {
        <!-- 2x2 Care KPI Grid -->
        <div class="care-kpi-grid">
            <!-- Diapers -->
            <div class="care-kpi-item">
                <div class="care-kpi-icon">👶</div>
                <div class="care-kpi-val">@Report.DiaperChangesCount</div>
                <div class="care-kpi-label">Diaper changes</div>
            </div>

            <!-- Rest -->
            <div class="care-kpi-item">
                <div class="care-kpi-icon">🌙</div>
                <div class="care-kpi-val">@Report.RestTimeFormatted</div>
                <div class="care-kpi-label">Rest time</div>
            </div>

            <!-- Lunch -->
            <div class="care-kpi-item">
                <div class="care-kpi-icon">🍴</div>
                <div class="care-kpi-val">Lunch</div>
                <div class="care-kpi-label">@Report.LunchMealStatus</div>
            </div>

            <!-- Mood -->
            <div class="care-kpi-item">
                <div class="care-kpi-icon">❤️</div>
                <div class="care-kpi-val">@Report.PrimaryMoodObservation</div>
                <div class="care-kpi-label">Comfort &amp; mood</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Report.DailyReassuranceText))
        {
            <div class="care-reassurance-box">
                <p class="care-reassurance-text">
                    &ldquo;@Report.DailyReassuranceText&rdquo;
                </p>
            </div>
        }

        @if (Report.LowSupplies != null && Report.LowSupplies.Count > 0)
        {
            <div class="care-supply-alert">
                <span class="care-supply-icon">📦</span>
                <div class="care-supply-info">
                    <strong>Cubby Replenishment Needed:</strong>
                    @string.Join(", ", Report.LowSupplies.Select(s => s.SupplyType))
                </div>
            </div>
        }

        <div class="care-transparency-note">
            The report is generated from verified classroom records and observations.
        </div>
    }
    else
    {
        <div class="care-routines-notice">
            <span class="care-routines-icon">🥣</span>
            <div class="care-routines-text">
                <strong>Meals &amp; Rest Routines:</strong> Detailed feeding and nap logs are recorded during designated rest hours.
            </div>
        </div>
    }
</div>

<style>
    .care-summary-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        padding: 18px 20px;
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .05));
        margin-top: 16px;
        box-sizing: border-box;
    }

    .care-summary-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 14px;
    }

    .care-summary-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--text, #26332d);
        margin: 0 0 2px 0;
        letter-spacing: -0.3px;
    }

    .care-summary-subtitle {
        font-size: 11.5px;
        color: var(--muted, #6c7870);
    }

    .care-summary-pill {
        font-size: 10px;
        font-weight: 750;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        padding: 3px 8px;
        border-radius: 8px;
    }

    .care-kpi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 14px;
    }

    .care-kpi-item {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .care-kpi-icon {
        font-size: 16px;
        margin-bottom: 2px;
    }

    .care-kpi-val {
        font-size: 16px;
        font-weight: 800;
        color: var(--text, #26332d);
        line-height: 1.2;
    }

    .care-kpi-label {
        font-size: 11.5px;
        color: var(--muted, #6c7870);
        font-weight: 600;
        margin-top: 2px;
    }

    .care-reassurance-box {
        background: #edf3ee;
        border-left: 3px solid var(--accent, #557c6c);
        border-radius: 0 10px 10px 0;
        padding: 12px 14px;
        margin-bottom: 12px;
    }

    .care-reassurance-text {
        margin: 0;
        font-size: 12.5px;
        color: var(--text, #26332d);
        font-style: italic;
        line-height: 1.45;
    }

    .care-supply-alert {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .care-supply-icon {
        font-size: 16px;
    }

    .care-supply-info {
        font-size: 12px;
        color: #92400e;
    }

    .care-transparency-note {
        font-size: 10.5px;
        color: var(--muted, #6c7870);
        font-style: italic;
    }

    .care-routines-notice {
        background: var(--surface-soft, #f8f9f5);
        border: 1px dashed var(--border, #e4e7df);
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .care-routines-icon {
        font-size: 20px;
    }

    .care-routines-text {
        font-size: 12px;
        color: var(--muted, #6c7870);
    }
</style>

@code {
    [Parameter] public ParentDailyCareReport? Report { get; set; }
}
