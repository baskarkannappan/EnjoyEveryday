@inject IParentService ParentService
@inject ParentLocalizationService Localization

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <span class="modal-eyebrow">@Localization.T("Action.ViewInvoices")</span>
                    <h3 class="modal-title">Tuition & Billing Statements</h3>
                </div>
                <button class="close-btn" @onclick="Close" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (isLoading)
                {
                    <div class="loading-wrap">
                        <LoadingState Message="Loading invoices..." />
                    </div>
                }
                else if (invoices.Count == 0)
                {
                    <EmptyState Title="No Invoices Found"
                                Message="All tuition and fee accounts are settled. No outstanding invoices for your family."
                                Icon="💳" />
                }
                else
                {
                    <div class="invoices-list">
                        @foreach (var inv in invoices)
                        {
                            <div class="invoice-item-card">
                                <div class="invoice-info">
                                    <div class="invoice-num">#@inv.InvoiceNumber</div>
                                    <div class="invoice-desc">@(string.IsNullOrWhiteSpace(inv.Description) ? "Daycare Monthly Tuition" : inv.Description)</div>
                                    <div class="invoice-date">Due: @inv.DueDate.ToString("d MMM yyyy")</div>
                                </div>
                                <div class="invoice-amount-block">
                                    <div class="amount">₹@inv.TotalAmount.ToString("N0")</div>
                                    @if (inv.Status == InvoiceStatus.Paid)
                                    {
                                        <span class="status-badge paid">Paid</span>
                                    }
                                    else if (inv.Status == InvoiceStatus.PartiallyPaid)
                                    {
                                        <span class="status-badge partial">Bal: ₹@inv.BalanceDue.ToString("N0")</span>
                                    }
                                    else if (inv.Status == InvoiceStatus.Overdue)
                                    {
                                        <span class="status-badge overdue">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge unpaid">Due</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <span class="footer-note">Online payments via Razorpay / UPI are supported through the finance office.</span>
                <button class="primary" @onclick="Close">@Localization.T("Action.Close")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid ChildId { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool isLoading = true;
    private List<Invoice> invoices = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && ChildId != Guid.Empty)
        {
            isLoading = true;
            try
            {
                invoices = await ParentService.GetChildInvoicesAsync(ChildId);
            }
            catch
            {
                invoices = new();
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

<style>
