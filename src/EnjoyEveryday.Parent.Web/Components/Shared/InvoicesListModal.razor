@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IParentService ParentService
@inject IOrgFeeManagementService FeeService
@inject ParentLocalizationService Localization
@inject ICurrencyService CurrencyService
@inject ParentSessionState SessionState

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <span class="modal-eyebrow">@Localization.T("Action.ViewInvoices")</span>
                    <h3 class="modal-title">Tuition &amp; Billing Statements</h3>
                </div>
                <button class="close-btn" @onclick="Close" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="alert @(_isSuccess ? "alert-success" : "alert-error")">
                        <span>@(_isSuccess ? "✨" : "⚠️") @_statusMessage</span>
                        <button type="button" class="alert-dismiss" @onclick="() => _statusMessage = null">✕</button>
                    </div>
                }

                @if (isLoading)
                {
                    <div class="loading-wrap">
                        <LoadingState Message="Loading invoices..." />
                    </div>
                }
                else if (invoices.Count == 0)
                {
                    <EmptyState Title="No Invoices Found"
                                Message="All tuition and fee accounts are settled. No outstanding invoices for your family."
                                Icon="💳" />
                }
                else
                {
                    <div class="invoices-list">
                        @foreach (var inv in invoices)
                        {
                            var curr = !string.IsNullOrWhiteSpace(inv.Currency) ? inv.Currency : SessionState.SelectedChild?.Currency;
                            <div class="invoice-item-card" style="flex-direction: column; align-items: stretch; gap: 10px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                                    <div class="invoice-info">
                                        <div class="invoice-num">#@inv.InvoiceNumber @if (!string.IsNullOrWhiteSpace(inv.FeeMethod)) { <span style="font-size: 11px; padding: 2px 7px; border-radius: 6px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); margin-left: 6px;">@(inv.FeeMethod == FeeMethods.FlatRate ? "Flat-Rate" : "Tariff")</span> }</div>
                                        <div class="invoice-desc">@(string.IsNullOrWhiteSpace(inv.Description) ? "Daycare Tuition Statement" : inv.Description)</div>
                                        <div class="invoice-date">Due: @inv.DueDate.ToString("d MMM yyyy")</div>
                                    </div>
                                    <div class="invoice-amount-block">
                                        <div class="amount">@CurrencyService.Format(inv.EffectivePayableAmount, curr)</div>
                                        @if (inv.Status == InvoiceStatus.Paid)
                                        {
                                            <span class="status-badge paid">Paid</span>
                                        }
                                        else if (inv.Status == InvoiceStatus.PartiallyPaid)
                                        {
                                            <span class="status-badge partial">Outstanding: @CurrencyService.Format(inv.BalanceDue, curr)</span>
                                        }
                                        else if (inv.Status == InvoiceStatus.Overdue)
                                        {
                                            <span class="status-badge overdue">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge unpaid">@inv.Status</span>
                                        }
                                    </div>
                                </div>

                                <div class="ee-invoice-breakdown-row">
                                    <div><span style="color: var(--muted);">Total Fee:</span><br /><strong>@CurrencyService.Format(inv.EffectivePayableAmount, curr)</strong></div>
                                    <div><span style="color: var(--muted);">Verified Paid:</span><br /><strong style="color: var(--accent-dark, #31523c);">@CurrencyService.Format(inv.AmountPaid, curr)</strong></div>
                                    <div><span style="color: var(--muted);">Awaiting Verify:</span><br /><strong style="color: #b7791f;">@CurrencyService.Format(inv.PendingVerificationAmount, curr)</strong></div>
                                    <div><span style="color: var(--muted);">Balance Due:</span><br /><strong>@CurrencyService.Format(inv.BalanceDue, curr)</strong></div>
                                </div>

                                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                                    <button type="button" class="btn-pay-now" style="background: var(--surface, #fff); color: var(--accent-dark, #31523c); border: 1px solid var(--border, #e4e7df);" @onclick="() => ToggleInvoiceDetailsAsync(inv)">
                                        @(_expandedInvoiceId == inv.Id ? "Hide Details" : (inv.BalanceDue > 0 && inv.Status != InvoiceStatus.Paid ? "Pay / View Details" : "View History"))
                                    </button>
                                </div>

                                @if (_expandedInvoiceId == inv.Id)
                                {
                                    <div style="border-top: 1px solid var(--border, #e4e7df); padding-top: 12px; display: flex; flex-direction: column; gap: 12px;">
                                        @if (_activeSnapshot?.BankAccount != null)
                                        {
                                            <div style="background: var(--warm, #f4eee1); padding: 10px 12px; border-radius: 8px; font-size: 12px;">
                                                <strong>Bank Transfer Details</strong>
                                                <div style="margin-top: 4px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px;">
                                                    <span>Account Holder: @_activeSnapshot.BankAccount.AccountHolderName</span>
                                                    <span>Bank: @_activeSnapshot.BankAccount.BankName (@_activeSnapshot.BankAccount.BranchName)</span>
                                                    <span>Account #: @_activeSnapshot.BankAccount.AccountNumber</span>
                                                    <span>IFSC / MICR: @_activeSnapshot.BankAccount.IfscCode @(!string.IsNullOrWhiteSpace(_activeSnapshot.BankAccount.MicrCode) ? $"/ {_activeSnapshot.BankAccount.MicrCode}" : "")</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(_activeSnapshot.BankAccount.AdditionalInstructions))
                                                {
                                                    <div style="margin-top: 4px; color: var(--muted);">@_activeSnapshot.BankAccount.AdditionalInstructions</div>
                                                }
                                            </div>
                                        }

                                        @if (_activeSnapshot?.QrCodes?.Any(q => q.IsActive) == true)
                                        {
                                            <div>
                                                <strong style="font-size: 12px;">Scan QR Code to Pay</strong>
                                                <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px;">
                                                    @foreach (var qr in _activeSnapshot.QrCodes.Where(q => q.IsActive))
                                                    {
                                                        <div style="border: 1px solid var(--border, #e4e7df); border-radius: 8px; padding: 8px; text-align: center; background: #fff; width: 145px;">
                                                            <img src="@qr.QrImageDataUri" alt="@qr.DisplayName" style="width: 110px; height: 110px; object-fit: contain;" />
                                                            <div style="font-size: 11.5px; font-weight: 700; margin-top: 4px;">@qr.DisplayName</div>
                                                            @if (!string.IsNullOrWhiteSpace(qr.PaymentPurpose))
                                                            {
                                                                <div style="font-size: 10.5px; color: var(--muted);">@qr.PaymentPurpose</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (_activeInstallments.Any())
                                        {
                                            var instDisplayList = CalculateInstallmentItems(inv.AmountPaid, _activeInstallments);
                                            <div style="font-size: 12px; background: #ffffff; padding: 10px 12px; border: 1px solid var(--border, #e4e7df); border-radius: 8px;">
                                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                                    <strong>Planned Installment Schedule (@_activeInstallments.Count)</strong>
                                                    <span style="font-size: 11px; color: var(--muted);">Click an installment to pay</span>
                                                </div>
                                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                                    @foreach (var inst in instDisplayList)
                                                    {
                                                        var isChosen = _submitRequest.Amount == inst.RemainingAmountOnThisInstallment && !inst.IsPaid;
                                                        <button type="button"
                                                                style="padding: 6px 10px; border-radius: 6px; font-size: 11.5px; border: 1px solid @(isChosen ? "var(--accent-dark, #31523c)" : "var(--border, #e4e7df)"); background: @(inst.IsPaid ? "#f8faf8" : isChosen ? "var(--accent-light, #e6eee9)" : "#fff"); color: var(--text, #26332d); cursor: @(inst.IsPaid ? "default" : "pointer");"
                                                                @onclick="() => { if (!inst.IsPaid) SelectInstallmentAmount(inst); }">
                                                            <strong>#@inst.Installment.InstallmentNumber:</strong> @CurrencyService.Format(inst.Installment.AmountDue, curr)
                                                            <span style="color: var(--muted); font-size: 10.5px;">(Due @inst.Installment.DueDate.ToString("d MMM"))</span>
                                                            @if (inst.IsPaid)
                                                            {
                                                                <span style="margin-left: 4px; color: #2e7d32; font-weight: 700;">✓ Paid</span>
                                                            }
                                                            else if (inst.IsOverdue)
                                                            {
                                                                <span style="margin-left: 4px; color: #c62828; font-weight: 700;">⚠️ Overdue</span>
                                                            }
                                                            else if (inst.IsNextDue)
                                                            {
                                                                <span style="margin-left: 4px; color: #2e7d32; font-weight: 700;">🔔 Due Now</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (_activePayments.Any())
                                        {
                                            <div style="font-size: 12px;">
                                                <strong>Payment History</strong>
                                                @foreach (var p in _activePayments)
                                                {
                                                    <div style="display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed var(--border, #e4e7df);">
                                                        <span>@p.PaymentDate.ToString("d MMM yyyy") • @p.Method • Ref: @(p.TransactionId ?? p.PaymentReference)</span>
                                                        <span>
                                                            <strong>@CurrencyService.Format(p.Amount, curr)</strong>
                                                            @if (p.Status == PaymentStatus.Completed && p.IsVerified)
                                                            {
                                                                <span class="status-badge paid" style="margin-left: 6px;">Verified</span>
                                                            }
                                                            else if (p.Status == PaymentStatus.PendingVerification)
                                                            {
                                                                <span class="status-badge partial" style="margin-left: 6px;">Awaiting Verification</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="status-badge overdue" style="margin-left: 6px;">@p.Status</span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (inv.BalanceDue > 0 && inv.Status != InvoiceStatus.Paid && inv.Status != InvoiceStatus.Cancelled && inv.Status != InvoiceStatus.Void)
                                        {
                                            <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                                                <strong style="font-size: 13px;">Submit Payment (Full or Partial)</strong>
                                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                                    <div>
                                                        <label style="font-size: 11px; color: var(--muted);">Amount Paid *</label>
                                                        <input type="number" step="0.01" max="@inv.BalanceDue" @bind="_submitRequest.Amount" style="width: 100%; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px;" />
                                                    </div>
                                                    <div>
                                                        <label style="font-size: 11px; color: var(--muted);">Payment Method *</label>
                                                        <select @bind="_submitRequest.Method" style="width: 100%; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px;">
                                                            <option value="@PaymentMethods.QrCode">QR Code Payment</option>
                                                            <option value="@PaymentMethods.BankTransfer">Bank Transfer</option>
                                                            @if (_activeSnapshot?.BankAccount?.AllowParentCashDeclaration == true)
                                                            {
                                                                <option value="@PaymentMethods.Cash">Cash (Daycare Verification Required)</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                                    <div>
                                                        <label style="font-size: 11px; color: var(--muted);">Transaction ID / Reference</label>
                                                        <input type="text" @bind="_submitRequest.TransactionId" placeholder="UPI / UTR / Ref #" style="width: 100%; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px;" />
                                                    </div>
                                                    <div>
                                                        <label style="font-size: 11px; color: var(--muted);">Payment Date</label>
                                                        <input type="date" @bind="_submitPaymentDate" style="width: 100%; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px;" />
                                                    </div>
                                                </div>
                                                <div>
                                                    <label style="font-size: 11px; color: var(--muted);">Remarks (Optional)</label>
                                                    <input type="text" @bind="_submitRequest.Remarks" placeholder="Optional note for daycare staff" style="width: 100%; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px;" />
                                                </div>
                                                <div>
                                                    <label style="font-size: 11px; color: var(--muted);">Payment Proof / Screenshot @(_activeSnapshot?.BankAccount?.RequirePaymentProof == true ? "(Required)" : "(Optional)")</label>
                                                    <InputFile OnChange="OnProofFileSelectedAsync" accept="image/*,.pdf" />
                                                    @if (!string.IsNullOrWhiteSpace(_proofFileName))
                                                    {
                                                        <span style="font-size: 11px; color: var(--accent-dark);">Attached: @_proofFileName</span>
                                                    }
                                                </div>
                                                <div style="display: flex; justify-content: flex-end;">
                                                    <button type="button" class="btn-pay-now" @onclick="() => SubmitParentPaymentAsync(inv)" disabled="@_isProcessingPayment">
                                                        @(_isProcessingPayment ? "Submitting..." : "Submit Payment for Verification")
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <span class="footer-note">Payments submitted via QR, Bank Transfer, or Cash are manually verified by your daycare team.</span>
                <button class="primary" @onclick="Close">@Localization.T("Action.Close")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid ChildId { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool isLoading = true;
    private bool _isProcessingPayment = false;
    private Guid? _expandedInvoiceId;
    private string? _statusMessage;
    private bool _isSuccess = true;
    private List<Invoice> invoices = new();
    private PaymentInstructionsSnapshotDto? _activeSnapshot;
    private List<InvoiceInstallment> _activeInstallments = new();
    private List<Payment> _activePayments = new();
    private SubmitParentPaymentRequest _submitRequest = new();
    private DateTime _submitPaymentDate = DateTime.Today;
    private string? _proofFileName;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && ChildId != Guid.Empty)
        {
            await LoadInvoicesAsync();
        }
    }

    private async Task LoadInvoicesAsync()
    {
        isLoading = true;
        try
        {
            invoices = await FeeService.GetParentChildInvoicesAsync(ChildId);
        }
        catch
        {
            invoices = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleInvoiceDetailsAsync(Invoice inv)
    {
        if (_expandedInvoiceId == inv.Id)
        {
            _expandedInvoiceId = null;
            return;
        }

        _expandedInvoiceId = inv.Id;
        _submitRequest = new SubmitParentPaymentRequest
        {
            ChildId = ChildId,
            InvoiceId = inv.Id,
            Amount = inv.BalanceDue,
            Method = PaymentMethods.QrCode
        };
        _submitPaymentDate = DateTime.Today;
        _proofFileName = null;

        try
        {
            _activeSnapshot = await FeeService.GetInvoicePaymentInstructionsAsync(inv.Id);
            _activeInstallments = await FeeService.GetParentChildInvoiceInstallmentsAsync(ChildId, inv.Id);
            _activePayments = await FeeService.GetParentChildInvoicePaymentsAsync(ChildId, inv.Id);

            if (_activeInstallments.Any())
            {
                var items = CalculateInstallmentItems(inv.AmountPaid, _activeInstallments);
                var nextDue = items.FirstOrDefault(i => i.IsNextDue);
                if (nextDue != null && nextDue.RemainingAmountOnThisInstallment > 0)
                {
                    _submitRequest.Amount = nextDue.RemainingAmountOnThisInstallment;
                    _submitRequest.Remarks = $"Installment #{nextDue.Installment.InstallmentNumber}";
                }
            }
        }
        catch
        {
            _activeSnapshot = null;
            _activeInstallments = new();
            _activePayments = new();
        }
    }

    private void SelectInstallmentAmount(InstallmentDisplayItem inst)
    {
        _submitRequest.Amount = inst.RemainingAmountOnThisInstallment > 0 ? inst.RemainingAmountOnThisInstallment : inst.Installment.AmountDue;
        _submitRequest.Remarks = $"Installment #{inst.Installment.InstallmentNumber}";
    }

    private static List<InstallmentDisplayItem> CalculateInstallmentItems(decimal totalAmountPaid, List<InvoiceInstallment> installments)
    {
        var list = new List<InstallmentDisplayItem>();
        decimal cumulativePrev = 0m;
        bool nextDueAssigned = false;

        var sorted = installments.OrderBy(i => i.InstallmentNumber).ToList();
        foreach (var inst in sorted)
        {
            var cumCurrent = cumulativePrev + inst.AmountDue;
            decimal paidOnThis = 0m;
            decimal remainingOnThis = inst.AmountDue;

            if (totalAmountPaid >= cumCurrent)
            {
                paidOnThis = inst.AmountDue;
                remainingOnThis = 0m;
            }
            else if (totalAmountPaid > cumulativePrev)
            {
                paidOnThis = totalAmountPaid - cumulativePrev;
                remainingOnThis = inst.AmountDue - paidOnThis;
            }
            else
            {
                paidOnThis = 0m;
                remainingOnThis = inst.AmountDue;
            }

            var item = new InstallmentDisplayItem
            {
                Installment = inst,
                CumulativeRequired = cumCurrent,
                PaidAmountOnThisInstallment = paidOnThis,
                RemainingAmountOnThisInstallment = remainingOnThis
            };

            if (!item.IsPaid && !nextDueAssigned)
            {
                item.IsNextDue = true;
                nextDueAssigned = true;
            }

            list.Add(item);
            cumulativePrev = cumCurrent;
        }

        return list;
    }

    public class InstallmentDisplayItem
    {
        public InvoiceInstallment Installment { get; set; } = null!;
        public decimal CumulativeRequired { get; set; }
        public decimal PaidAmountOnThisInstallment { get; set; }
        public decimal RemainingAmountOnThisInstallment { get; set; }
        public bool IsPaid => RemainingAmountOnThisInstallment <= 0;
        public bool IsNextDue { get; set; }
        public bool IsOverdue => !IsPaid && Installment.DueDate < DateTime.Today;
    }

    private async Task OnProofFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        const long maxBytes = 2 * 1024 * 1024;
        using var stream = file.OpenReadStream(maxBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _submitRequest.ProofStorageKey = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        _proofFileName = file.Name;
    }

    private async Task SubmitParentPaymentAsync(Invoice inv)
    {
        _isProcessingPayment = true;
        _statusMessage = null;
        try
        {
            _submitRequest.ChildId = ChildId;
            _submitRequest.InvoiceId = inv.Id;
            _submitRequest.PaymentDate = new DateTimeOffset(DateTime.SpecifyKind(_submitPaymentDate.Date, DateTimeKind.Utc), TimeSpan.Zero);
            await FeeService.SubmitParentPaymentAsync(_submitRequest);

            _isSuccess = true;
            _statusMessage = "Payment Submitted – Waiting for Daycare Verification.";
            await LoadInvoicesAsync();
            _activePayments = await FeeService.GetParentChildInvoicePaymentsAsync(ChildId, inv.Id);
        }
        catch (Exception ex)
        {
            _isSuccess = false;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isProcessingPayment = false;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(38, 51, 45, 0.45);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1100;
        padding: 16px;
    }

    .modal-card {
        background: #ffffff;
        border: 1px solid var(--border, #e4e7df);
        border-radius: 0px;
        box-shadow: 0 16px 40px rgba(40, 55, 47, 0.16);
        max-width: 600px;
        width: 100%;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .modal-header {
        padding: 18px 24px;
        border-bottom: 1px solid var(--border, #e4e7df);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-eyebrow {
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.5px;
        color: var(--accent-dark, #31523c);
        text-transform: uppercase;
        display: block;
        margin-bottom: 2px;
    }

    .modal-title {
        margin: 0;
        font-size: 18px;
        font-weight: 750;
        color: var(--text, #26332d);
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: var(--muted, #6c7870);
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
    }

    .invoices-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .invoice-item-card {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 0px;
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .invoice-num {
        font-size: 13.5px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin-bottom: 2px;
    }

    .invoice-desc {
        font-size: 12px;
        color: var(--muted, #6c7870);
        margin-bottom: 4px;
    }

    .invoice-date {
        font-size: 11px;
        color: var(--muted, #6c7870);
        font-weight: 600;
    }

    .invoice-amount-block {
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
    }

    .amount {
        font-size: 16px;
        font-weight: 800;
        color: var(--text, #26332d);
    }

    .status-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 0px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .status-badge.paid {
        background: #e6f4ea;
        color: #137333;
        border: 1px solid #ceead6;
    }

    .status-badge.partial {
        background: #fef7e0;
        color: #b06000;
        border: 1px solid #feefc3;
    }

    .status-badge.overdue {
        background: #fce8e6;
        color: #c5221f;
        border: 1px solid #fad2cf;
    }

    .status-badge.unpaid {
        background: #eef2ed;
        color: var(--text, #26332d);
        border: 1px solid #d9e2db;
    }

    .btn-pay-now {
        background: #31523c;
        color: #ffffff;
        border: none;
        padding: 5px 12px;
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: background 0.15s ease;
    }

    .btn-pay-now:hover:not(:disabled) {
        background: #23412f;
    }

    .btn-pay-now:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .alert {
        padding: 10px 14px;
        font-size: 12.5px;
        font-weight: 600;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
