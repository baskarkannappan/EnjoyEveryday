@namespace EnjoyEveryday.Parent.Web.Components.Shared
@using EnjoyEveryday.Application.Services

<div class="daily-update-card">
    <div class="daily-update-time">
        <span class="daily-time-badge">@Item.TimeLabel</span>
    </div>
    <div class="daily-update-content">
        <div class="daily-update-top">
            <div class="daily-update-title-wrap">
                <span class="daily-category-icon">@GetCategoryIcon(Item.Category)</span>
                <span class="daily-update-title">@Item.Title</span>
            </div>
            @if (Item.IsCompleted)
            {
                <span class="daily-status-completed">Completed</span>
            }
            else
            {
                <span class="daily-status-planned">Planned</span>
            }
        </div>
        <p class="daily-update-desc">@Item.Description</p>
        @if (!string.IsNullOrEmpty(Item.PhotoUrl))
        {
            <div class="daily-update-media">
                <img src="@Item.PhotoUrl" alt="@Item.Title" class="daily-update-img" loading="lazy" />
            </div>
        }
    </div>
</div>

<style>
    .daily-update-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 14px;
        padding: 12px 16px;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.03);
        display: flex;
        gap: 12px;
        box-sizing: border-box;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .daily-update-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(40, 55, 47, 0.05);
    }

    .daily-update-time {
        min-width: 58px;
        text-align: center;
        flex-shrink: 0;
    }

    .daily-time-badge {
        font-size: 10px;
        font-weight: 750;
        color: var(--accent-dark, #3e6253);
        background: var(--accent-light, #e6eee9);
        padding: 3px 6px;
        border-radius: 6px;
        display: inline-block;
        white-space: nowrap;
    }

    .daily-update-content {
        flex: 1;
        min-width: 0;
    }

    .daily-update-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 4px;
    }

    .daily-update-title-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 1;
        min-width: 0;
    }

    .daily-category-icon {
        font-size: 14px;
        flex-shrink: 0;
    }

    .daily-update-title {
        font-weight: 750;
        font-size: 13.5px;
        color: var(--text, #26332d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .daily-status-completed {
        font-size: 9.5px;
        font-weight: 700;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        padding: 2px 7px;
        border-radius: 8px;
        flex-shrink: 0;
    }

    .daily-status-planned {
        font-size: 9.5px;
        font-weight: 700;
        background: var(--surface-soft, #f8f9f5);
        color: var(--muted, #6c7870);
        padding: 2px 7px;
        border-radius: 8px;
        border: 1px solid var(--border, #e4e7df);
        flex-shrink: 0;
    }

    .daily-update-desc {
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        line-height: 1.45;
        margin: 0;
        word-break: break-word;
    }

    .daily-update-media {
        margin-top: 8px;
    }

    .daily-update-img {
        max-width: 100%;
        height: 120px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid var(--border, #e4e7df);
    }
</style>

@code {
    [Parameter, EditorRequired] public ChildDailyTimelineItem Item { get; set; } = default!;

    private string GetCategoryIcon(string category) => category switch
    {
        "Attendance" => "📍",
        "Experience" => "🎨",
        "Moment" => "✨",
        "Care" => "🌱",
        "Diaper" => "👶",
        "Rest" => "🌙",
        "Meal" => "🍴",
        _ => "📝"
    };
}
