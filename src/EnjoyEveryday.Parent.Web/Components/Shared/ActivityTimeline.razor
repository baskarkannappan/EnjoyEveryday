@namespace EnjoyEveryday.Parent.Web.Components.Shared
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.UI.Shared.Components

<div class="activity-timeline-container">
    <div class="activity-timeline-header">
        <h2 class="activity-timeline-title">@Title</h2>
        <span class="activity-timeline-count">
            @(Items?.Count ?? 0) recorded updates
        </span>
    </div>

    @if (Items == null || Items.Count == 0)
    {
        <EmptyState Icon="☀️"
                    Title="Quiet Start to the Day"
                    Description="Daily activities, check-ins, and teacher observations will appear here as the day unfolds."
                    MinHeightPx="160" />
    }
    else
    {
        <div class="activity-timeline-list">
            @foreach (var item in Items)
            {
                <DailyUpdateCard Item="@item" />
            }
        </div>
    }
</div>

<style>
    .activity-timeline-container {
        width: 100%;
        box-sizing: border-box;
    }

    .activity-timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 14px;
    }

    .activity-timeline-title {
        font-size: 17px;
        font-weight: 800;
        color: var(--text, #26332d);
        margin: 0;
        letter-spacing: -0.3px;
    }

    .activity-timeline-count {
        font-size: 12px;
        color: var(--muted, #6c7870);
        font-weight: 500;
    }

    .activity-timeline-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Today's Timeline";
    [Parameter] public IReadOnlyList<ChildDailyTimelineItem>? Items { get; set; }
}
