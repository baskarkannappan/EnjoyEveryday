@namespace EnjoyEveryday.Parent.Web.Components.Layout
@inject IParentService ParentService
@inject ParentSessionState SessionState
@inject ParentLocalizationService Localization
@inject NavigationManager Navigation
@inject EnjoyEveryday.Parent.Web.Services.ParentRealtimeNotificationCenter RealtimeNotificationCenter
@implements IDisposable

<nav class="custom-nav" aria-label="Desktop Navigation">
    <div class="nav-content-top">
        <!-- BRANDING HEADER -->
        <div class="brand-header">
            <div class="brand-avatar">
                🌱
            </div>
            <div>
                <div class="brand-name">EnjoyEveryday</div>
                <div class="brand-sub">Parent &amp; Family Portal</div>
            </div>
        </div>

        <!-- CHILD SELECTOR CARD USING REUSABLE CHILDSWITCHER -->
        <ChildSwitcher SelectedChild="@SessionState.SelectedChild" 
                       Children="@_children" 
                       Loading="@_loading" 
                       OnChildSelected="OnChildSelectChanged" />

        <!-- NAVIGATION LINKS -->
        <div class="nav-section-label">MY FAMILY</div>

        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <FluentIcon Value="@(new Icons.Regular.Size20.WeatherSunny())" Color="Color.Custom" CustomColor="#d97706" />
            <span>@Localization.T("Nav.Today")</span>
        </NavLink>

        <NavLink class="nav-item" href="/journey">
            <FluentIcon Value="@(new Icons.Regular.Size20.Heart())" Color="Color.Custom" CustomColor="#e11d48" />
            <span>@Localization.T("Nav.Journey")</span>
        </NavLink>

        <NavLink class="nav-item" href="/memories">
            <FluentIcon Value="@(new Icons.Regular.Size20.Image())" Color="Color.Custom" CustomColor="#059669" />
            <span>@Localization.T("Nav.Memories")</span>
        </NavLink>

        <NavLink class="nav-item" href="/events">
            <FluentIcon Value="@(new Icons.Regular.Size20.CalendarLtr())" Color="Color.Custom" CustomColor="#7c3aed" />
            <span>Events &amp; Celebrations</span>
        </NavLink>

        <NavLink class="nav-item" href="/messages">
            <FluentIcon Value="@(new Icons.Regular.Size20.ChatMultiple())" Color="Color.Custom" CustomColor="#0284c7" />
            <span>@Localization.T("Nav.Messages")</span>
            @if (_unreadEducatorMessages > 0)
            {
                <span class="nav-msg-badge">@_unreadEducatorMessages</span>
            }
        </NavLink>

        <NavLink class="nav-item" href="/family">
            <FluentIcon Value="@(new Icons.Regular.Size20.PersonHeart())" Color="Color.Custom" CustomColor="#52745e" />
            <span>@Localization.T("Nav.Family")</span>
        </NavLink>
    </div>

    <!-- LOGOUT / AUTH FOOTER -->
    <div class="nav-footer">
        <a href="/auth/logout" data-enhance-nav="false" class="nav-item signout-btn">
            <FluentIcon Value="@(new Icons.Regular.Size20.SignOut())" Color="Color.Custom" CustomColor="#dc2626" />
            <span>Sign Out</span>
        </a>
    </div>
</nav>

<style>
    .custom-nav {
        padding: 12px 10px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #fbfcf9;
        box-sizing: border-box;
    }

    .brand-header {
        display: flex;
        gap: 9px;
        align-items: center;
        padding: 4px 4px 12px;
    }

    .brand-avatar {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        display: grid;
        place-items: center;
        font-size: 16px;
        font-weight: bold;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.05);
    }

    .brand-name {
        font-weight: 800;
        font-size: 14px;
        letter-spacing: -0.3px;
        color: var(--text, #26332d);
        line-height: 1.2;
    }

    .brand-sub {
        font-size: 10px;
        color: var(--muted, #6c7870);
        font-weight: 500;
        margin-top: 1px;
    }

    .nav-section-label {
        font-size: 9px;
        font-weight: 800;
        color: var(--muted, #6c7870);
        letter-spacing: 0.8px;
        margin: 12px 6px 6px;
        text-transform: uppercase;
    }

    .nav-footer {
        border-top: 1px solid var(--border, #e4e7df);
        padding-top: 10px;
        margin-top: 12px;
    }

    .signout-btn {
        color: #b91c1c !important;
        font-weight: 650;
    }

    .signout-btn:hover {
        background: #fef2f2 !important;
    }

    .nav-msg-badge {
        margin-left: auto;
        background: #e11d48;
        color: white;
        font-size: 11px;
        font-weight: 750;
        padding: 1px 7px;
        border-radius: 10px;
        line-height: 1.4;
    }
</style>

@code {
    private List<ParentAuthorizedChild> _children = new();
    private bool _loading = true;
    private int _unreadEducatorMessages = 0;

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChildChanged += StateHasChanged;
        Localization.OnLanguageChanged += StateHasChanged;
        RealtimeNotificationCenter.OnEducatorMessageReceived += HandleLiveEducatorMessage;
        Navigation.LocationChanged += OnLocationChanged;
        await LoadChildrenAsync();
    }

    private async Task HandleLiveEducatorMessage(EnjoyEveryday.Application.Services.ParentMessageNotification notification)
    {
        if (!Navigation.Uri.Contains("/messages"))
        {
            _unreadEducatorMessages++;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (e.Location.Contains("/messages"))
        {
            _unreadEducatorMessages = 0;
            StateHasChanged();
        }
    }

    private async Task LoadChildrenAsync()
    {
        try
        {
            _loading = true;
            var children = (await ParentService.GetAuthorizedChildrenAsync()).ToList();
            _children = children;
            SessionState.SetAuthorizedChildren(_children);
        }
        catch (Exception)
        {
            _children = new List<ParentAuthorizedChild>();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnChildSelectChanged(Guid childId)
    {
        SessionState.SelectChild(childId);
    }

    public void Dispose()
    {
        SessionState.OnChildChanged -= StateHasChanged;
        Localization.OnLanguageChanged -= StateHasChanged;
        RealtimeNotificationCenter.OnEducatorMessageReceived -= HandleLiveEducatorMessage;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
