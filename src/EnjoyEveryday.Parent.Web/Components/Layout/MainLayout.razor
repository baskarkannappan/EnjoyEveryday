@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components

<FluentLayout>
    <!-- MOBILE ONLY HEADER -->
    <FluentLayoutItem Area="LayoutArea.Header" class="mobile-header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="15">
            <FluentLayoutHamburger />
            <div style="display: flex; gap: 8px; align-items: center;">
                <div style="width: 24px; height: 24px; border-radius: 6px; background: #eef5ef; color: #2d5a3c; display: grid; place-items: center; font-size: 14px;">
                    🌱
                </div>
                <div style="font-weight: 750; font-size: 14px; letter-spacing: -0.5px; color: var(--text, #1c2b20);">EnjoyEveryday Parents</div>
            </div>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Width="260px">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        <div style="padding: 24px 32px; max-width: 1200px; margin: 0 auto;">
            @Body
        </div>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />
