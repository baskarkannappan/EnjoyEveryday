@inherits LayoutComponentBase
@namespace EnjoyEveryday.Parent.Web.Components.Layout
@inject ParentSessionState SessionState
@implements IDisposable

<div class="parent-portal-app">
    <!-- MOBILE TOPBAR -->
    <header class="mobile-portal-topbar" aria-label="Mobile Header">
        <div class="mobile-brand">
            <div class="mobile-brand-icon">🌱</div>
            <div class="mobile-brand-title">EnjoyEveryday</div>
        </div>

        <div class="mobile-top-right">
            @if (SessionState.SelectedChild != null)
            {
                <a href="/family" class="mobile-child-pill" title="Active Child">
                    <span class="mobile-child-dot"></span>
                    <span class="mobile-child-name">@SessionState.SelectedChild.FirstName</span>
                </a>
            }
            <a href="/auth/logout" data-enhance-nav="false" class="mobile-signout-icon" title="Sign Out" aria-label="Sign Out">
                <span style="font-size: 15px;">🚪</span>
            </a>
        </div>
    </header>

    <div class="parent-portal-body">
        <!-- DESKTOP SIDEBAR -->
        <aside class="parent-portal-sidebar">
            <NavMenu />
        </aside>

        <!-- MAIN SCROLLABLE CONTENT -->
        <main class="parent-portal-main">
            <div class="parent-content-wrapper">
                <GlobalErrorBoundary>
                    @Body
                </GlobalErrorBoundary>
            </div>
        </main>
    </div>

    <!-- MOBILE BOTTOM NAVIGATION -->
    <ParentMobileNav />
</div>

<ReconnectModal />
<FluentProviders />

@code {
    protected override void OnInitialized()
    {
        SessionState.OnChildChanged += HandleChildChanged;
    }

    private void HandleChildChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionState.OnChildChanged -= HandleChildChanged;
    }
}
