@inherits LayoutComponentBase
@namespace EnjoyEveryday.Parent.Web.Components.Layout
@inject ParentSessionState SessionState
@implements IDisposable
<PageTitle>Parent Portal</PageTitle>

<div class="parent-portal-app">
    <!-- RETENTION NOTICE TOAST / BANNER (Disappears after 10 seconds) -->
    @if (_showRetentionNotice)
    {
        <div class="photo-retention-banner @(_isDismissingRetentionNotice ? "fading-out" : "")" role="alert" aria-live="polite">
            <div class="retention-content">
                <span class="retention-icon">📸</span>
                <div class="retention-text">
                    <strong>Photo Storage Notice:</strong> Classroom photos &amp; celebration memories are stored for <strong>3 months</strong>. Please download photos you wish to keep before they expire.
                </div>
            </div>
            <div class="retention-actions">
                <a href="/memories" class="retention-link">Go to Memories &amp; Download</a>
                <button type="button" class="retention-close" title="Dismiss" @onclick="DismissRetentionNotice">✕</button>
            </div>
        </div>
    }

    <!-- MOBILE TOPBAR -->
    <header class="mobile-portal-topbar" aria-label="Mobile Header">
        <div class="mobile-brand">
            <div class="mobile-brand-icon">🌱</div>
            <div class="mobile-brand-title">EnjoyEveryday</div>
        </div>

        <div class="mobile-top-right">
            @if (SessionState.SelectedChild != null)
            {
                <a href="/family" class="mobile-child-pill" title="Active Child">
                    <span class="mobile-child-dot"></span>
                    <span class="mobile-child-name">@SessionState.SelectedChild.FirstName</span>
                </a>
            }
            <a href="/auth/logout" data-enhance-nav="false" class="mobile-signout-icon" title="Sign Out" aria-label="Sign Out">
                <span style="font-size: 15px;">🚪</span>
            </a>
        </div>
    </header>

    <div class="parent-portal-body">
        <!-- DESKTOP SIDEBAR -->
        <aside class="parent-portal-sidebar">
            <NavMenu />
        </aside>

        <!-- MAIN SCROLLABLE CONTENT -->
        <main class="parent-portal-main">
            <div class="parent-content-wrapper">
                <GlobalErrorBoundary>
                    @Body
                </GlobalErrorBoundary>
                <div class="mobile-bottom-spacer" aria-hidden="true"></div>
            </div>
        </main>
    </div>

    <!-- MOBILE BOTTOM NAVIGATION -->
    <ParentMobileNav />
</div>

<ReconnectModal />
<FluentProviders />

@code {
    private bool _showRetentionNotice;
    private bool _isDismissingRetentionNotice;
    private CancellationTokenSource? _retentionCts;

    protected override void OnInitialized()
    {
        SessionState.OnChildChanged += HandleChildChanged;

        if (!SessionState.HasSeenPhotoRetentionNotice)
        {
            SessionState.HasSeenPhotoRetentionNotice = true;
            _showRetentionNotice = true;
            StartRetentionAutoDismiss();
        }
    }

    private void StartRetentionAutoDismiss()
    {
        _retentionCts?.Cancel();
        _retentionCts = new CancellationTokenSource();
        var token = _retentionCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(10000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        _isDismissingRetentionNotice = true;
                        StateHasChanged();
                        await Task.Delay(400, token);
                        _showRetentionNotice = false;
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Task was dismissed manually or disposed
            }
        }, token);
    }

    private void DismissRetentionNotice()
    {
        _retentionCts?.Cancel();
        _showRetentionNotice = false;
    }

    private void HandleChildChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _retentionCts?.Cancel();
        _retentionCts?.Dispose();
        SessionState.OnChildChanged -= HandleChildChanged;
    }
}
