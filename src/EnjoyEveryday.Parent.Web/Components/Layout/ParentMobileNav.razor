@namespace EnjoyEveryday.Parent.Web.Components.Layout
@inject ParentLocalizationService Localization
@implements IDisposable

<nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
    <NavLink class="mobile-nav-item" href="/" Match="NavLinkMatch.All">
        <span class="mobile-nav-icon">☀️</span>
        <span class="mobile-nav-label">@Localization.T("Nav.Today")</span>
    </NavLink>

    <NavLink class="mobile-nav-item" href="/journey">
        <span class="mobile-nav-icon">🌿</span>
        <span class="mobile-nav-label">@Localization.T("Nav.Journey")</span>
    </NavLink>

    <NavLink class="mobile-nav-item" href="/memories">
        <span class="mobile-nav-icon">📸</span>
        <span class="mobile-nav-label">@Localization.T("Nav.Memories")</span>
    </NavLink>

    <NavLink class="mobile-nav-item" href="/messages">
        <span class="mobile-nav-icon">💬</span>
        <span class="mobile-nav-label">@Localization.T("Nav.Messages")</span>
        @if (UnreadCount > 0)
        {
            <span class="mobile-unread-badge">@UnreadCount</span>
        }
    </NavLink>

    <NavLink class="mobile-nav-item" href="/family">
        <span class="mobile-nav-icon">👤</span>
        <span class="mobile-nav-label">@Localization.T("Nav.Family")</span>
    </NavLink>
</nav>

<style>
    .mobile-bottom-nav {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 64px;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-top: 1px solid var(--border, #e4e7df);
        box-shadow: 0 -4px 20px rgba(40, 55, 47, 0.05);
        z-index: 999;
        justify-content: space-around;
        align-items: center;
        padding: 0 4px;
        padding-bottom: env(safe-area-inset-bottom, 0);
        box-sizing: border-box;
    }

    .mobile-nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--muted, #6c7870);
        padding: 6px 10px;
        border-radius: 10px;
        flex: 1;
        min-width: 0;
        height: 52px;
        position: relative;
        transition: color 0.15s ease;
    }

    .mobile-nav-icon {
        font-size: 20px;
        line-height: 1;
        margin-bottom: 2px;
    }

    .mobile-nav-label {
        font-size: 10.5px;
        font-weight: 650;
        letter-spacing: -0.1px;
    }

    .mobile-nav-item.active {
        color: var(--accent-dark, #3e6253);
    }

    .mobile-nav-item.active .mobile-nav-label {
        font-weight: 800;
    }

    .mobile-nav-item.active::after {
        content: '';
        position: absolute;
        bottom: 2px;
        width: 16px;
        height: 3px;
        background: var(--accent, #557c6c);
        border-radius: 2px;
    }

    .mobile-unread-badge {
        position: absolute;
        top: 4px;
        right: 18%;
        background: #e11d48;
        color: #ffffff;
        font-size: 9.5px;
        font-weight: 800;
        padding: 1px 5px;
        border-radius: 10px;
        line-height: 1.2;
    }

    @@media (max-width: 768px) {
        .mobile-bottom-nav {
            display: flex;
        }
    }
</style>

@code {
    [Parameter] public int UnreadCount { get; set; }

    protected override void OnInitialized()
    {
        Localization.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Localization.OnLanguageChanged -= StateHasChanged;
    }
}
