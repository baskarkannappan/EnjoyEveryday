@page "/billing"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IParentService ParentService
@inject IOrgFeeManagementService FeeService
@inject ParentSessionState SessionState
@inject ICurrencyService CurrencyService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>My Billing &amp; Invoices — EnjoyEveryday Parent Portal</PageTitle>

<div class="content" style="max-width: 1040px; margin: 0 auto; font-family: var(--ee-font, 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);">
    <PageHero Eyebrow="CHILDCARE BILLING"
              Title="My Billing &amp; Invoices"
              Subtitle="View your child's monthly childcare invoices, installment payment schedules, verified payments, and pay online or via manual payment options.">
        <RightContent>
            @if (_children.Any())
            {
                <select style="padding: 8px 12px; border: 1px solid var(--border, #e4e7df); background: var(--surface, #fff); font-weight: 600; border-radius: 6px;" value="@_selectedChildId" @onchange="OnChildChangedAsync">
                    @foreach (var ch in _children)
                    {
                        <option value="@ch.ChildId">@ch.FirstName @ch.LastName (@ch.OrganizationName)</option>
                    }
                </select>
            }
        </RightContent>
    </PageHero>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div style="padding: 12px 16px; margin-bottom: 16px; border: 1px solid @(_isSuccess ? "#c8dacd" : "#fed7d7"); background: @(_isSuccess ? "var(--accent-light, #e6eee9)" : "#fff5f5"); color: @(_isSuccess ? "var(--accent-dark, #31523c)" : "#9b2c2c"); border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 500;">@(_isSuccess ? "✓" : "⚠️") @_statusMessage</span>
            <button style="background: none; border: none; cursor: pointer; font-size: 14px; color: inherit;" @onclick="() => _statusMessage = null">✕</button>
        </div>
    }

    @if (_isLoading)
    {
        <LoadingState Message="Loading your child's billing history and payment schedules..." />
    }
    else
    {
        <!-- Summary Cards -->
        <div class="ee-p-kpi-grid">
            <div class="ee-p-card">
                <span class="ee-p-label">TOTAL INVOICED</span>
                <div class="ee-p-val ee-tnum">@CurrencyService.Format(_invoices.Where(i => i.Status != InvoiceStatus.Cancelled && i.Status != InvoiceStatus.Void).Sum(i => i.EffectivePayableAmount), _currency, forceDecimals: true)</div>
            </div>
            <div class="ee-p-card">
                <span class="ee-p-label">VERIFIED PAID</span>
                <div class="ee-p-val ee-tnum" style="color: var(--accent-dark, #31523c);">@CurrencyService.Format(_invoices.Sum(i => i.AmountPaid), _currency, forceDecimals: true)</div>
            </div>
            <div class="ee-p-card">
                <span class="ee-p-label">AWAITING VERIFICATION</span>
                <div class="ee-p-val ee-tnum" style="color: #b7791f;">@CurrencyService.Format(_invoices.Sum(i => i.PendingVerificationAmount), _currency, forceDecimals: true)</div>
            </div>
            <div class="ee-p-card">
                <span class="ee-p-label">OUTSTANDING BALANCE</span>
                <div class="ee-p-val ee-tnum" style="color: #c62828;">@CurrencyService.Format(_invoices.Where(i => i.Status != InvoiceStatus.Cancelled && i.Status != InvoiceStatus.Void).Sum(i => i.BalanceDue), _currency, forceDecimals: true)</div>
            </div>
            <div class="ee-p-card">
                <span class="ee-p-label">NEXT DUE DATE</span>
                <div class="ee-p-val" style="font-size: 16px;">@(_nextDueDate?.ToString("d MMM yyyy") ?? "All Settled")</div>
            </div>
        </div>

        <!-- Monthly Billing History Table -->
        <div class="ee-p-card" style="margin-bottom: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h4 style="margin: 0; font-size: 15px; font-weight: 750; color: var(--text, #26332d);">Monthly Billing History</h4>
                <span style="font-size: 12px; color: var(--muted, #6c7870);">@_invoices.Count invoice statement(s)</span>
            </div>

            @if (!_invoices.Any())
            {
                <EmptyState Title="No Childcare Invoices Yet"
                            Message="Your daycare organization has not issued any invoices for this child yet."
                            Icon="💳" />
            }
            else
            {
                <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
                    <table style="width: 100%; min-width: 680px; border-collapse: collapse; font-size: 13px;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border, #e4e7df); text-align: left; color: var(--muted, #6c7870); font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px;">
                                <th style="padding: 10px 8px;">Month / Period</th>
                                <th style="padding: 10px 8px;">Invoice #</th>
                                <th style="padding: 10px 8px;">Issue Date</th>
                                <th style="padding: 10px 8px;">Due Date</th>
                                <th style="padding: 10px 8px; text-align: right;">Amount</th>
                                <th style="padding: 10px 8px; text-align: right;">Paid</th>
                                <th style="padding: 10px 8px; text-align: right;">Outstanding</th>
                                <th style="padding: 10px 8px; text-align: center;">Status</th>
                                <th style="padding: 10px 8px; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in _invoices)
                            {
                                var curr = string.IsNullOrWhiteSpace(inv.Currency) ? _currency : inv.Currency;
                                var isExpanded = _selectedInvoice?.Id == inv.Id;
                                var hasInstallments = _invoiceInstallments.TryGetValue(inv.Id, out var instList) && instList.Any();
                                <tr style="border-bottom: 1px dashed var(--border, #e4e7df); background: @(isExpanded ? "#f4f8f5" : "transparent"); transition: background 0.15s ease;">
                                    <td style="padding: 10px 8px;">
                                        <strong>@(string.IsNullOrWhiteSpace(inv.BillingPeriod) ? inv.IssueDate.ToString("MMM yyyy") : inv.BillingPeriod)</strong>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <div style="font-weight: 700; font-family: monospace; color: var(--accent-dark, #31523c);">
                                            #@inv.InvoiceNumber
                                        </div>
                                        @if (hasInstallments)
                                        {
                                            var instItems = CalculateInstallmentItems(inv.AmountPaid, instList!);
                                            var nextDueItem = instItems.FirstOrDefault(i => i.IsNextDue);
                                            <div class="ee-table-inst-pill" title="This invoice has scheduled installments">
                                                <span>📅 @instList!.Count Installments</span>
                                                @if (nextDueItem != null && inv.BalanceDue > 0)
                                                {
                                                    <span>• Next: <strong>@CurrencyService.Format(nextDueItem.RemainingAmountOnThisInstallment, curr, forceDecimals: true)</strong> (Due @nextDueItem.Installment.DueDate.ToString("d MMM"))</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px; color: var(--text, #26332d);">@inv.IssueDate.ToString("d MMM yyyy")</td>
                                    <td style="padding: 10px 8px; color: var(--text, #26332d);">@inv.DueDate.ToString("d MMM yyyy")</td>
                                    <td style="padding: 10px 8px; text-align: right; font-weight: 600;" class="ee-tnum">@CurrencyService.Format(inv.EffectivePayableAmount, curr, forceDecimals: true)</td>
                                    <td style="padding: 10px 8px; text-align: right; color: var(--accent-dark); font-weight: 600;" class="ee-tnum">@CurrencyService.Format(inv.AmountPaid, curr, forceDecimals: true)</td>
                                    <td style="padding: 10px 8px; text-align: right; font-weight: 700; color: @(inv.BalanceDue > 0 ? "#c62828" : "inherit");" class="ee-tnum">
                                        @CurrencyService.Format(inv.BalanceDue, curr, forceDecimals: true)
                                    </td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        <span class="ee-p-badge @(inv.Status == InvoiceStatus.Paid ? "paid" : inv.Status == InvoiceStatus.Overdue ? "overdue" : "pending")">
                                            @inv.Status
                                        </span>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right;">
                                        <button class="secondary" style="padding: 4px 10px; font-size: 12px; border-radius: 4px;" @onclick="() => SelectInvoiceAsync(inv)">
                                            @(isExpanded ? "Hide" : (inv.BalanceDue > 0 && inv.Status != InvoiceStatus.Paid ? (hasInstallments ? "Pay Installment" : "Pay / Details") : "View Details"))
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Selected Invoice Details & Payment Panel -->
        @if (_selectedInvoice != null)
        {
            var curr = string.IsNullOrWhiteSpace(_selectedInvoice.Currency) ? _currency : _selectedInvoice.Currency;
            var nextDue = _installmentItems.FirstOrDefault(i => i.IsNextDue);

            <div class="ee-p-card" style="border-left: 4px solid var(--accent, #557c6c);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; border-bottom: 1px solid var(--surface-soft, #f8f9f5); padding-bottom: 10px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 16px;">📄</span>
                            <h4 style="margin: 0; font-size: 15px; font-weight: 750;">Invoice #@_selectedInvoice.InvoiceNumber — @_selectedInvoice.Description</h4>
                        </div>
                        <div style="font-size: 12px; color: var(--muted, #6c7870); margin-top: 4px;">
                            Fee Method: <strong>@(_selectedInvoice.FeeMethod ?? "TariffBased")</strong> • Issued <strong>@_selectedInvoice.IssueDate.ToString("d MMM yyyy")</strong> • Due <strong>@_selectedInvoice.DueDate.ToString("d MMM yyyy")</strong>
                        </div>
                    </div>
                    <button class="secondary" style="padding: 4px 12px; font-size: 12px; border-radius: 4px;" @onclick="() => _selectedInvoice = null">Close</button>
                </div>

                <!-- PLANNED INSTALLMENT SCHEDULE (If invoice has installments) -->
                @if (_selectedInstallments.Any())
                {
                    <div class="ee-inst-schedule-card">
                        <div class="ee-inst-header">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-size: 18px;">📅</span>
                                <div>
                                    <h5 style="margin: 0; font-size: 13.5px; font-weight: 750; color: var(--text, #26332d);">Planned Installment Schedule (@_selectedInstallments.Count Installments)</h5>
                                    <span style="font-size: 12px; color: var(--muted, #6c7870);">
                                        This invoice is scheduled into multiple installments. Click any installment card or button below to set your payment amount.
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="ee-inst-grid">
                            @foreach (var item in _installmentItems)
                            {
                                var isChosen = _paymentModeSelection == "Installment" && _selectedInstallmentId == item.Installment.Id;
                                <div class="ee-inst-card @(item.IsPaid ? "paid" : isChosen ? "selected" : item.IsOverdue ? "overdue" : item.IsNextDue ? "current-due" : "upcoming")"
                                     @onclick='() => { if (!item.IsPaid) SelectPaymentMode("Installment", item); }'>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                        <strong style="font-size: 12.5px; color: var(--text, #26332d);">Installment #@item.Installment.InstallmentNumber</strong>
                                        <span class="ee-inst-badge @item.StatusBadgeCss">@item.StatusText</span>
                                    </div>

                                    <div style="font-size: 11.5px; color: var(--muted, #6c7870); margin-bottom: 6px;">
                                        Due Date: <strong>@item.Installment.DueDate.ToString("d MMM yyyy")</strong>
                                    </div>

                                    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 4px;">
                                        <span style="font-size: 11px; color: var(--muted, #6c7870);">Amount Due:</span>
                                        <span style="font-size: 14.5px; font-weight: 800; font-variant-numeric: tabular-nums;">
                                            @CurrencyService.Format(item.Installment.AmountDue, curr, forceDecimals: true)
                                        </span>
                                    </div>

                                    @if (item.PaidAmountOnThisInstallment > 0 && !item.IsPaid)
                                    {
                                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--accent-dark); margin-top: 2px;">
                                            <span>Already Paid:</span>
                                            <span>@CurrencyService.Format(item.PaidAmountOnThisInstallment, curr, forceDecimals: true)</span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: #c62828; margin-top: 2px;">
                                            <span>Balance Remaining:</span>
                                            <span>@CurrencyService.Format(item.RemainingAmountOnThisInstallment, curr, forceDecimals: true)</span>
                                        </div>
                                    }

                                    @if (!item.IsPaid && _selectedInvoice.BalanceDue > 0)
                                    {
                                        <button type="button" class="ee-inst-btn @(isChosen ? "active" : "")"
                                                @onclick:stopPropagation="true"
                                                @onclick='() => SelectPaymentMode("Installment", item)'>
                                            @(isChosen ? "✓ Selected to Pay" : $"Pay {CurrencyService.Format(item.RemainingAmountOnThisInstallment, curr, forceDecimals: true)}")
                                        </button>
                                    }
                                    else if (item.IsPaid)
                                    {
                                        <div style="margin-top: 8px; font-size: 11.5px; color: var(--accent-dark); font-weight: 700; text-align: center;">
                                            ✓ Fully Settled
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Payment History -->
                @if (_selectedPayments.Any())
                {
                    <div style="margin-bottom: 16px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 12px 14px;">
                        <strong style="font-size: 13px; color: var(--text, #26332d);">Payment &amp; Transaction History (@_selectedPayments.Count)</strong>
                        <div style="margin-top: 6px;">
                            @foreach (var p in _selectedPayments)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px dashed var(--border); font-size: 12.5px;">
                                    <div>
                                        <span style="font-weight: 600;">@p.PaymentDate.ToString("d MMM yyyy HH:mm")</span> • <span class="ee-table-inst-pill">@p.Method</span>
                                        @if (!string.IsNullOrWhiteSpace(p.TransactionId ?? p.PaymentReference))
                                        {
                                            <span style="color: var(--muted); margin-left: 4px; font-family: monospace;">(Ref: @(p.TransactionId ?? p.PaymentReference))</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                                        {
                                            <span style="color: var(--muted); margin-left: 6px;">— @p.Notes</span>
                                        }
                                    </div>
                                    <div>
                                        <strong class="ee-tnum" style="color: var(--accent-dark);">@CurrencyService.Format(p.Amount, curr, forceDecimals: true)</strong>
                                        <span class="ee-p-badge @(p.Status == "Completed" && p.IsVerified ? "paid" : p.Status == "PendingVerification" ? "pending" : "overdue")" style="margin-left: 6px;">
                                            @(p.Status == "Completed" && p.IsVerified ? "Verified" : p.Status == "PendingVerification" ? "Pending Verification" : p.Status)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_selectedInvoice.BalanceDue > 0 && _selectedInvoice.Status != InvoiceStatus.Paid && _selectedInvoice.Status != InvoiceStatus.Cancelled && _selectedInvoice.Status != InvoiceStatus.Void)
                {
                    <!-- QUICK AMOUNT SELECTION PILLS (When installments are present) -->
                    @if (_selectedInstallments.Any())
                    {
                        <div style="margin-bottom: 14px; padding: 12px 14px; background: #ffffff; border: 1px solid var(--border, #e4e7df); border-radius: 10px;">
                            <label style="font-size: 11.5px; font-weight: 750; color: var(--muted, #6c7870); display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;">
                                Select Payment Amount:
                            </label>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                @foreach (var inst in _installmentItems.Where(i => !i.IsPaid))
                                {
                                    var isChosen = _paymentModeSelection == "Installment" && _selectedInstallmentId == inst.Installment.Id;
                                    <button type="button" class="ee-choice-pill @(isChosen ? "active" : "")" @onclick='() => SelectPaymentMode("Installment", inst)'>
                                        📌 Installment #@inst.Installment.InstallmentNumber: @CurrencyService.Format(inst.RemainingAmountOnThisInstallment, curr, forceDecimals: true)
                                    </button>
                                }
                                <button type="button" class="ee-choice-pill @(_paymentModeSelection == "Full" ? "active" : "")" @onclick='() => SelectPaymentMode("Full")'>
                                    💰 Full Balance: @CurrencyService.Format(_selectedInvoice.BalanceDue, curr, forceDecimals: true)
                                </button>
                                <button type="button" class="ee-choice-pill @(_paymentModeSelection == "Custom" ? "active" : "")" @onclick='() => SelectPaymentMode("Custom")'>
                                    ✏️ Custom Amount
                                </button>
                            </div>
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
                        @if (_gatewayStatus.CanAcceptOnlinePayments)
                        {
                            <div style="background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; border-radius: 12px; padding: 16px;">
                                <h5 style="margin: 0 0 6px; color: var(--accent-dark, #31523c); font-size: 13.5px; font-weight: 750;">Pay Online via Organization Razorpay (@_gatewayStatus.Environment)</h5>
                                <div style="font-size: 12px; color: var(--muted, #6c7870); margin-bottom: 8px;">
                                    Instant automated payment confirmation.
                                </div>
                                <label style="font-size: 12px; font-weight: 600; color: var(--text, #26332d);">
                                    Amount to Pay (max @CurrencyService.Format(_selectedInvoice.BalanceDue, curr, forceDecimals: true))
                                </label>
                                <input type="number" step="0.01" max="@_selectedInvoice.BalanceDue" @bind="_razorpayAmount" style="width: 100%; padding: 8px 10px; margin: 6px 0 10px; border: 1px solid var(--border); border-radius: 6px; background: #fff; font-size: 14px; font-weight: 700;" class="ee-tnum" />
                                <button class="primary" style="width: 100%; padding: 10px;" @onclick="PayWithOrgRazorpayAsync" disabled="@_isBusy">
                                    @(_isBusy ? "Opening Checkout..." : $"Pay {CurrencyService.Format(_razorpayAmount, curr, forceDecimals: true)} Now")
                                </button>
                            </div>
                        }

                        <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border); border-radius: 12px; padding: 16px;">
                            <h5 style="margin: 0 0 6px; font-size: 13.5px; font-weight: 750; color: var(--text, #26332d);">Manual Payment Options (QR / Bank Transfer / Cash)</h5>
                            <div style="font-size: 12px; color: var(--muted, #6c7870); margin-bottom: 8px;">
                                Submit payment proof or transaction ID for daycare review.
                            </div>

                            @if (_snapshot?.BankAccount != null)
                            {
                                <div style="font-size: 12px; margin-bottom: 8px; background: #ffffff; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px;">
                                    <strong>@_snapshot.BankAccount.BankName</strong> • A/C: @_snapshot.BankAccount.AccountNumber • IFSC: @_snapshot.BankAccount.IfscCode
                                </div>
                            }
                            @if (_snapshot?.QrCodes?.Any(q => q.IsActive) == true)
                            {
                                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px;">
                                    @foreach (var qr in _snapshot.QrCodes.Where(q => q.IsActive))
                                    {
                                        <div style="text-align: center; background: #fff; padding: 8px; border: 1px solid var(--border); border-radius: 8px;">
                                            <img src="@qr.QrImageDataUri" alt="@qr.DisplayName" style="width: 90px; height: 90px; object-fit: contain;" />
                                            <div style="font-size: 11px; font-weight: 700; margin-top: 4px;">@qr.DisplayName</div>
                                        </div>
                                    }
                                </div>
                            }
                            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
                                <div>
                                    <label style="font-size: 11.5px; font-weight: 600; color: var(--muted, #6c7870);">Amount Paid</label>
                                    <input type="number" step="0.01" max="@_selectedInvoice.BalanceDue" @bind="_manualSubmit.Amount" placeholder="Amount Paid" style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px; font-weight: 700; font-size: 14px;" class="ee-tnum" />
                                </div>
                                <div>
                                    <label style="font-size: 11.5px; font-weight: 600; color: var(--muted, #6c7870);">Payment Method</label>
                                    <select @bind="_manualSubmit.Method" style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px; background: #fff;">
                                        <option value="@PaymentMethods.QrCode">QR Code</option>
                                        <option value="@PaymentMethods.BankTransfer">Bank Transfer</option>
                                        @if (_snapshot?.BankAccount?.AllowParentCashDeclaration == true)
                                        {
                                            <option value="@PaymentMethods.Cash">Cash</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size: 11.5px; font-weight: 600; color: var(--muted, #6c7870);">Transaction ID / Reference Number</label>
                                    <input type="text" @bind="_manualSubmit.TransactionId" placeholder="UPI / UTR / Transaction Reference" style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px;" />
                                </div>
                                <div>
                                    <label style="font-size: 11.5px; font-weight: 600; color: var(--muted, #6c7870);">Payment Notes / Installment Remarks (Optional)</label>
                                    <input type="text" @bind="_manualSubmit.Remarks" placeholder="e.g. Installment #1 payment" style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px;" />
                                </div>
                                <div>
                                    <label style="font-size: 11.5px; font-weight: 600; color: var(--muted, #6c7870);">Upload Payment Proof / Screenshot (Optional)</label>
                                    <InputFile OnChange="OnProofSelectedAsync" accept="image/*,.pdf" style="width: 100%;" />
                                </div>
                                <button class="primary" style="padding: 10px; margin-top: 4px;" @onclick="SubmitManualAsync" disabled="@_isBusy">
                                    @(_isBusy ? "Submitting..." : "Submit Manual Payment for Verification")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .ee-p-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40,55,47,.06));
        padding: 18px 20px;
    }

    .ee-p-label {
        font-size: 11px;
        font-weight: 750;
        color: var(--muted, #6c7870);
        letter-spacing: 0.5px;
    }

    .ee-p-val {
        font-size: 22px;
        font-weight: 800;
        color: var(--text, #26332d);
        margin-top: 4px;
        line-height: 1.2;
    }

    .ee-p-badge {
        display: inline-block;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 700;
        border-radius: 6px;
        background: var(--surface-soft, #f8f9f5);
        color: var(--text, #26332d);
        border: 1px solid var(--border, #e4e7df);
    }
    .ee-p-badge.paid {
