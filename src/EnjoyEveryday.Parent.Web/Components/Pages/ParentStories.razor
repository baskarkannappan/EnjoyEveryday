@page "/stories"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject ChildService ChildService
@inject JourneyService JourneyService
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@rendermode InteractiveServer
<PageHero 
    Eyebrow="PARENT CONNECTION" 
    Title="Parent Stories" 
    Subtitle="Let parents feel their child's day.">
</PageHero>
@if (_stories != null && _stories.Count > 0) {
    @foreach (var story in _stories) {
        <StoryCard 
            Icon="💖" 
            Date="@(story.CreatedAt.ToString("MMM dd") + " · BLUEBIRDS")" 
            Title="Story Update" 
            Content="@story.Content" 
            MomentTitle="Little Moment" 
            MomentText="A special memory captured today." 
            ActionText="Preview parent story" 
        />
    }
} else {
    <StoryCard 
        Icon="💖" 
        Date="TODAY · BLUEBIRDS" 
        Title="✨ Aarav's Day" 
        Content="Today Aarav discovered a tiny ladybug, built a little garden with his friends, and tried again when their bridge fell." 
        MomentTitle="Little Moment" 
        MomentText="“Aarav was watching from a distance. Then he came closer and said, ‘I found one!’”" 
        ActionText="Preview parent story" 
    />
}

@code {
    private List<Child> _children = new();
    private Child? _activeChild;
    private string? _selectedChildId;
    private List<ChildStory> _stories = new();
    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org != null)
        {
            var branches = await BranchService.GetBranchesAsync(org.Id);
            var branch = branches.FirstOrDefault();
            if (branch != null)
            {
                var classrooms = (await ClassroomService.GetClassroomsAsync(branch.Id)).ToList();
                var classroom = classrooms.FirstOrDefault();
                if (classroom != null)
                {
                    _children = (await ChildService.GetChildrenByClassroomAsync(classroom.Id)).ToList();
                    _activeChild = _children.FirstOrDefault();
                    if (_activeChild != null)
                    {
                        _selectedChildId = _activeChild.Id.ToString();
                        await LoadChildData();
                    }
                }
            }
        }
    }

    private async Task LoadChildData()
    {
        if (Guid.TryParse(_selectedChildId, out var id))
        {
            _activeChild = _children.FirstOrDefault(c => c.Id == id);
            if (_activeChild != null)
            {
                _stories = (await JourneyService.GetChildStoriesAsync(_activeChild.Id)).ToList();
            }
        }
    }
}
