@page "/messages"
@attribute [Authorize]
@namespace EnjoyEveryday.Parent.Web.Components.Pages.Communication
@inject IParentService ParentService
@inject ParentSessionState SessionState
@inject ParentLocalizationService Localization
@inject NavigationManager Navigation
@inject EnjoyEveryday.Parent.Web.Services.ParentRealtimeNotificationCenter RealtimeNotificationCenter
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Messages — EnjoyEveryday</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading conversation..." 
                  SubMessage="Connecting securely to classroom educator thread" />
}
else if (SessionState.SelectedChild == null)
{
    <EmptyState Icon="🌱"
                Title="No Authorized Child Selected"
                Description="Please connect an active child enrollment to message your child's teachers."
                ActionText="Connect Demo Child"
                OnAction='() => Navigation.NavigateTo("/auth/login")' />
}
else
{
    <!-- HEADER -->
    <ParentPageHeader Eyebrow="COMMUNICATION · EDUCATORS & FAMILY"
                      Title="Classroom Messages"
                      Subtitle="Direct, secure messaging with verified educators for your child.">
        <RightContent>
            <LanguageSwitcher />
            <div class="message-channel-badge">
                <span class="message-channel-dot"></span>
                <span>Active Classroom Channel</span>
            </div>
        </RightContent>
    </ParentPageHeader>

    <div class="chat-container">
        <!-- QUIET HOURS BANNER -->
        <div class="quiet-hours-banner">
            <span class="quiet-icon">🕒</span>
            <span>@Localization.T("Action.QuietHours")</span>
        </div>

        <!-- TEACHER / CLASSROOM CONVERSATION HEADER -->
        <div class="chat-thread-header">
            <div class="chat-thread-avatar">
                👩‍🏫
            </div>
            <div class="chat-thread-details">
                <div class="chat-thread-title">
                    @(SessionState.SelectedChild.ClassroomName ?? "Classroom") Educators
                </div>
                <div class="chat-thread-sub">
                    @(SessionState.SelectedChild.OrganizationName ?? "Daycare Center") &middot; @(SessionState.SelectedChild.FirstName)'s Teachers
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="chat-error-banner">
                <span>⚠️ @_errorMessage</span>
                <button class="chat-error-close" @onclick="() => _errorMessage = null">✕</button>
            </div>
        }

        <!-- MESSAGE STREAM -->
        <div class="chat-messages-stream" id="chatStream">
            @if (_messages.Count == 0)
            {
                <EmptyState Icon="💬"
                            Title="Start a Conversation"
                            Description="Have a question or update about your child today? Send a message to the classroom team below."
                            MinHeightPx="180" />
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <ChatMessageBubble SenderName="@msg.SenderName"
                                       Content="@msg.Content"
                                       Timestamp="@msg.Timestamp"
                                       IsFromParent="@msg.IsFromParent"
                                       DeliveryStatus="@msg.DeliveryStatus" />
                }
            }
        </div>

        <!-- QUICK REPLIES BAR -->
        <div class="quick-replies-toolbar">
            <span class="quick-reply-label">Quick reply:</span>
            <button class="quick-reply-chip" @onclick='() => HandleSendMessage("Thank you for the update! 😊")'>
                Thank you! 😊
            </button>
            <button class="quick-reply-chip" @onclick='() => HandleSendMessage("On my way for pickup 🚗")'>
                On my way 🚗
            </button>
            <button class="quick-reply-chip" @onclick='() => HandleSendMessage("Running 10-15 minutes late for pickup.")'>
                Running 10m late
            </button>
            <button class="quick-reply-chip" @onclick='() => HandleSendMessage("Please check their backpack for jacket/supplies.")'>
                Check backpack 🎒
            </button>
        </div>

        <!-- MOBILE-FRIENDLY COMPOSER -->
        <div class="chat-composer-footer">
            <ChatComposer Placeholder="@($"Message {SessionState.SelectedChild.FirstName}'s teachers...")"
                          IsSending="@_isSending"
                          OnSend="HandleSendMessage" />
        </div>
    </div>
}

<style>
    .message-channel-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        border: 1px solid #c8dacd;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 11.5px;
        font-weight: 750;
    }

    .message-channel-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
    }

    .chat-container {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .05));
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 520px;
        max-height: 78vh;
        box-sizing: border-box;
    }

    .chat-thread-header {
        padding: 16px 20px;
        background: var(--surface-soft, #f8f9f5);
        border-bottom: 1px solid var(--border, #e4e7df);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-thread-avatar {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        display: grid;
        place-items: center;
        font-size: 22px;
        border: 1px solid #d0e0d6;
        flex-shrink: 0;
    }

    .chat-thread-details {
        flex: 1;
        min-width: 0;
    }

    .chat-thread-title {
        font-weight: 750;
        font-size: 15px;
        color: var(--text, #26332d);
    }

    .chat-thread-sub {
        font-size: 11.5px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }

    .chat-error-banner {
        background: #fef2f2;
        border-bottom: 1px solid #fecaca;
        color: #991b1b;
        padding: 8px 16px;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-error-close {
        background: none;
        border: none;
        cursor: pointer;
        color: #991b1b;
        font-size: 14px;
    }

    .chat-messages-stream {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        background: #fafbf9;
    }

    .quiet-hours-banner {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fdfaf3;
        border-bottom: 1px solid #f2e9d8;
        padding: 8px 16px;
        font-size: 12px;
        color: #7d6b46;
        line-height: 1.35;
    }

    .quiet-icon {
        font-size: 14px;
        flex-shrink: 0;
    }

    .quick-replies-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: var(--surface, #ffffff);
        border-top: 1px solid var(--border, #e4e7df);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .quick-reply-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--muted, #6c7870);
        white-space: nowrap;
        text-transform: uppercase;
    }

    .quick-reply-chip {
        display: inline-flex;
        align-items: center;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 16px;
        padding: 5px 12px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text, #26332d);
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .quick-reply-chip:hover {
        background: var(--accent-light, #e6eee9);
        border-color: var(--accent, #557c6c);
        color: var(--accent-dark, #3e6253);
    }

    .chat-composer-footer {
        padding: 10px 16px 14px;
        background: var(--surface, #ffffff);
        border-top: 1px solid var(--border, #e4e7df);
    }

    @@media (max-width: 768px) {
        .chat-container {
            min-height: unset;
            max-height: none;
            overflow: visible;
            border-radius: 14px;
        }

        .chat-messages-stream {
            max-height: none;
            overflow: visible;
            padding: 14px 12px;
        }
    }
</style>

@code {
    private List<ParentChatMessage> _messages = new();
    private bool _loading = true;
    private bool _isSending = false;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChildChanged += OnChildSelectionChanged;
        Localization.OnLanguageChanged += StateHasChanged;
        RealtimeNotificationCenter.OnEducatorMessageReceived += HandleLiveIncomingEducatorMessage;
        await LoadMessagesAsync();
        _ = StartPollingLoopAsync();
    }

    private async void OnChildSelectionChanged()
    {
        await LoadMessagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartPollingLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!_isSending && !_loading && SessionState.SelectedChild != null)
                {
                    var msgs = (await ParentService.GetChildMessagesAsync(SessionState.SelectedChild.ChildId, take: 50)).ToList();
                    
                    var hasChanges = msgs.Count != _messages.Count ||
                        (msgs.Count > 0 && _messages.Count > 0 && msgs.Last().Id != _messages.Last().Id);

                    if (hasChanges)
                    {
                        _messages = msgs;
                        await InvokeAsync(StateHasChanged);
                        _ = ScrollToBottomAsync();
                    }
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[Parent Messages] Polling tick error: {ex.Message}");
        }
    }

    private async Task LoadMessagesAsync()
    {
        if (SessionState.SelectedChild == null)
        {
            _loading = false;
            return;
        }

        try
        {
            _loading = true;
            var msgs = await ParentService.GetChildMessagesAsync(SessionState.SelectedChild.ChildId, take: 50);
            _messages = msgs.ToList();
            _ = ScrollToBottomAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load messages: {ex.Message}";
            _messages = new List<ParentChatMessage>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSendMessage(string text)
    {
        if (SessionState.SelectedChild == null || string.IsNullOrWhiteSpace(text)) return;

        try
        {
            _isSending = true;
            _errorMessage = null;

            // Optimistic addition
            var optimistic = new ParentChatMessage
            {
                Id = Guid.NewGuid(),
                ChildId = SessionState.SelectedChild.ChildId,
                SenderName = "You",
                Content = text,
                Timestamp = DateTimeOffset.UtcNow,
                IsFromParent = true,
                DeliveryStatus = "Sending"
            };
            _messages.Add(optimistic);
            _ = ScrollToBottomAsync();

            // Persist to database
            var sent = await ParentService.SendParentMessageAsync(SessionState.SelectedChild.ChildId, text);
            optimistic.DeliveryStatus = sent.DeliveryStatus;
            optimistic.Id = sent.Id;
            _ = ScrollToBottomAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to deliver message: {ex.Message}. You can retry sending.";
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task HandleLiveIncomingEducatorMessage(ParentMessageNotification notification)
    {
        await InvokeAsync(async () =>
        {
            if (SessionState.SelectedChild != null && SessionState.SelectedChild.ChildId == notification.ChildId)
            {
                if (!_messages.Any(m => m.Id == notification.MessageId))
                {
                    _messages.Add(new ParentChatMessage
                    {
                        Id = notification.MessageId,
                        ChildId = notification.ChildId,
                        SenderName = notification.SenderName,
                        Content = notification.Content,
                        Timestamp = notification.Timestamp,
                        IsFromParent = false,
                        DeliveryStatus = "Delivered"
                    });
                    StateHasChanged();
                    await ScrollToBottomAsync();
                }
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottomAsync();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                setTimeout(function() {
                    var el = document.getElementById('chatStream');
                    if (el) { el.scrollTop = el.scrollHeight; }
                }, 60);
            ");
        }
        catch { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        RealtimeNotificationCenter.OnEducatorMessageReceived -= HandleLiveIncomingEducatorMessage;
        SessionState.OnChildChanged -= OnChildSelectionChanged;
        Localization.OnLanguageChanged -= StateHasChanged;
    }
}
