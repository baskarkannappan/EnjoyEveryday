@page "/teachers"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject UserService UserService
<PageHero 
    Eyebrow="PEOPLE" 
    Title="Teachers" 
    Subtitle="Less typing. More teaching.">
    <RightContent>
        <button id="addTeacherButton" class="primary" @onclick="OpenAddTeacherModal">
            + Add teacher
        </button>
    </RightContent>
</PageHero>
<div id="teacherGrid" class="people-grid">
    @if (_teachers != null) {
        @foreach (var teacher in _teachers) {
            <PersonCard AvatarInitials="@teacher.FirstName.Substring(0,1)" Name="@teacher.FirstName" Subtitle="Experience Facilitator" HighlightTitle="Today's support" HighlightText="4 experiences planned. Keep room for child-led exploration." />
        }
    }
</div>
@code {
    private IEnumerable<User>? _teachers;
    private User _newTeacher = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadTeachersAsync();
    }
    private async Task LoadTeachersAsync()
    {
        _teachers = await UserService.GetTeachersAsync();
    }
    private void OpenAddTeacherModal()
    {
        _newTeacher = new User();
    }
    private void CloseDialog()
    {
    }
    private async Task SaveTeacherAsync()
    {
        if (!string.IsNullOrWhiteSpace(_newTeacher.FirstName) && !string.IsNullOrWhiteSpace(_newTeacher.LastName) && !string.IsNullOrWhiteSpace(_newTeacher.Email))
        {
            await UserService.CreateUserAsync(_newTeacher.Email, _newTeacher.FirstName, _newTeacher.LastName, "TEMP_HASH_REPLACE_ME", "Teacher");
            await LoadTeachersAsync();
        }
    }
}

