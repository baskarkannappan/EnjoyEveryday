@code {
    private ChildDailySummary? _summary;
    private List<DaycareAnnouncement> _announcements = new();
    private bool _loading = true;
    private bool _showAbsenceModal = false;
    private bool _showPickupsModal = false;
    private bool _showInvoicesModal = false;
    private bool _isPrivacyApproved = true;
    private bool _showPrivacyModal = false;
    private bool _isApprovingPrivacy = false;

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChildChanged += OnChildSelectionChanged;
        Localization.OnLanguageChanged += StateHasChanged;

        if (SessionState.SelectedChild == null)
        {
            try
            {
                var children = (await ParentService.GetAuthorizedChildrenAsync()).ToList();
                SessionState.SetAuthorizedChildren(children);
            }
            catch { }
        }

        await LoadSummaryAsync();
    }

    private async void OnChildSelectionChanged()
    {
        await LoadSummaryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSummaryAsync()
    {
        if (SessionState.SelectedChild == null)
        {
            _loading = false;
            return;
        }

        try
        {
            _loading = true;
            _summary = await ParentService.GetChildDailySummaryAsync(SessionState.SelectedChild.ChildId, DateTime.Today);
            _isPrivacyApproved = await ParentService.IsPrivacyAndTrustApprovedAsync(SessionState.SelectedChild.ChildId);

            try
            {
                var tenantId = SessionState.SelectedChild?.TenantId ?? Guid.Parse("10000000-0000-0000-0000-000000000001");
                if (tenantId == Guid.Empty) tenantId = Guid.Parse("10000000-0000-0000-0000-000000000001");
                var annList = await AnnouncementService.GetAnnouncementsAsync(tenantId, SessionState.SelectedChild?.OrganizationId, SessionState.SelectedChild?.BranchId);
                _announcements = annList.ToList();
            }
            catch { }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR LoadSummaryAsync] {ex}");
            _summary = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApprovePrivacyModalAsync()
    {
        if (SessionState.SelectedChild == null) return;
        try
        {
            _isApprovingPrivacy = true;
            var person = await ParentService.GetParentProfileAsync();
            var name = person != null ? $"{person.FirstName} {person.LastName}".Trim() : "Parent Guardian";
            await ParentService.ApprovePrivacyAndTrustAsync(SessionState.SelectedChild.ChildId, name);
            _isPrivacyApproved = true;
            _showPrivacyModal = false;
            await LoadSummaryAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR ApprovePrivacyModal] {ex.Message}");
        }
        finally
        {
            _isApprovingPrivacy = false;
        }
    }

    public void Dispose()
    {
        SessionState.OnChildChanged -= OnChildSelectionChanged;
        Localization.OnLanguageChanged -= StateHasChanged;
    }
}
