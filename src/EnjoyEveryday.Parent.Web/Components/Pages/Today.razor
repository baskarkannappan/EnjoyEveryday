@page "/"
@page "/today"
@attribute [Authorize]
@namespace EnjoyEveryday.Parent.Web.Components.Pages
@inject IParentService ParentService
@inject IDaycareAnnouncementService AnnouncementService
@inject ParentSessionState SessionState
@inject ParentLocalizationService Localization
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Parent Portal — Today</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading today's moments..." 
                  SubMessage="Retrieving verified classroom activities &amp; wellbeing routines" />
}
else if (SessionState.SelectedChild == null)
{
    <EmptyState Icon="🌱"
                Title="No Authorized Children Linked"
                Description="Your account is not currently linked to an active child enrollment. Please contact your daycare center administrator to verify your family relationship."
                ActionText="Connect Demo Child"
                OnAction='() => Navigation.NavigateTo("/auth/login")' />
}
else
{
    <!-- DAYCARE ANNOUNCEMENTS BROADCAST BANNER -->
    @if (_announcements?.Any() == true)
    {
        <div class="today-announcements-broadcast">
            @foreach (var ann in _announcements.Take(2))
            {
                <div class="announcement-broadcast-card @(ann.IsUrgent ? "urgent" : "")">
                    <span class="announcement-broadcast-badge @(ann.IsUrgent ? "badge-urgent" : "")">
                        @(ann.IsUrgent ? "🚨 URGENT NOTICE" : $"📢 {ann.Tag.ToUpper()}")
                    </span>
                    <div class="announcement-broadcast-text">
                        <strong class="announcement-broadcast-title">@ann.Title:</strong>
                        <span class="announcement-broadcast-body">@ann.Content</span>
                    </div>
                    <span class="announcement-broadcast-date">@ann.CreatedAt.ToLocalTime().ToString("MMM dd")</span>
                </div>
            }
        </div>
    }

    <!-- HERO HEADER -->
    <ParentPageHeader Eyebrow="@($"TODAY · {DateTime.Today:dddd, MMMM dd, yyyy}".ToUpper())"
                      Title="@($"{SessionState.SelectedChild.FirstName}'s Day")"
                      Subtitle="@($"📍 {SessionState.SelectedChild.ClassroomName ?? "Classroom"} · {SessionState.SelectedChild.OrganizationName ?? "Daycare"}")">
        <RightContent>
            <LanguageSwitcher />

            <!-- ATTENDANCE BADGE -->
            <div class="attendance-badge-card">
                <div class="attendance-badge-label">Attendance Status</div>
                <div class="attendance-badge-status">
                    @if (_summary?.Attendance?.DepartureTime.HasValue == true || _summary?.Attendance?.Status == "Departed" || _summary?.Attendance?.Status == "CheckedOut")
                    {
                        <span class="attendance-dot departed"></span>
                        <strong class="attendance-text departed">Picked Up</strong>
                        @if (_summary.Attendance.DepartureTime.HasValue)
                        {
                            <span class="attendance-time">(@DateTime.Today.Add(_summary.Attendance.DepartureTime.Value).ToString("h:mm tt"))</span>
                        }
                    }
                    else if (_summary?.Attendance?.Status == "Present")
                    {
                        <span class="attendance-dot present"></span>
                        <strong class="attendance-text present">Checked In</strong>
                        @if (_summary.Attendance.ArrivalTime.HasValue)
                        {
                            <span class="attendance-time">(@DateTime.Today.Add(_summary.Attendance.ArrivalTime.Value).ToString("h:mm tt"))</span>
                        }
                    }
                    else if (_summary?.Attendance?.Status == "Absent")
                    {
                        <span class="attendance-dot absent"></span>
                        <strong class="attendance-text absent">Absent</strong>
                    }
                    else
                    {
                        <span class="attendance-dot pending"></span>
                        <strong class="attendance-text pending">Not Yet Arrived</strong>
                    }
                </div>
            </div>
        </RightContent>
    </ParentPageHeader>

    <!-- EVERYDAY QUICK ACTIONS TOOLBAR -->
    <div class="everyday-actions-bar">
        <button class="action-chip" @onclick="() => _showAbsenceModal = true">
            <span class="chip-icon">📅</span>
            <span>@Localization.T("Action.ReportAbsence")</span>
        </button>
        <button class="action-chip" @onclick="() => _showPickupsModal = true">
            <span class="chip-icon">🛡️</span>
            <span>@Localization.T("Action.AuthorizedPickups")</span>
        </button>
        <button class="action-chip" @onclick="() => _showInvoicesModal = true">
            <span class="chip-icon">💳</span>
            <span>@Localization.T("Action.ViewInvoices")</span>
            @if (_summary?.UnpaidInvoicesCount > 0)
            {
                <span class="chip-counter">@_summary.UnpaidInvoicesCount</span>
            }
        </button>
        <NavLink href="/messages" class="action-chip">
            <span class="chip-icon">💬</span>
            <span>@Localization.T("Nav.Messages")</span>
            @if (_summary?.UnreadMessagesCount > 0)
            {
                <span class="chip-counter">@_summary.UnreadMessagesCount</span>
            }
        </NavLink>
        <button class="action-chip" @onclick="() => _showPrivacyModal = true">
            <span class="chip-icon">🔒</span>
            <span>@Localization.T("Nav.TrustCenter")</span>
            @if (!_isPrivacyApproved || _summary?.PendingConsentCount > 0)
            {
                <span class="chip-counter alert">!</span>
            }
        </button>
    </div>

    @if (!_isPrivacyApproved && SessionState.SelectedChild != null)
    {
        <div class="today-action-alerts privacy-alert-banner" style="background: #fef8ee; border: 1px solid #fbd38d; border-left: 5px solid #d97706; margin-bottom: 16px;">
            <div class="alert-icon" style="color: #d97706;">🛡️</div>
            <div class="alert-content" style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <strong style="color: #92400e;">Privacy &amp; Trust Center Approval Required</strong>
                        <p style="margin: 2px 0 0; font-size: 12px; color: #78350f;">
                            Please review and accept the child data privacy &amp; custody terms for @(SessionState.SelectedChild.FirstName) to activate full system trust compliance.
                        </p>
                    </div>
                    <button class="primary" style="padding: 6px 14px; font-size: 12px; border-radius: 9px; font-weight: 700; white-space: nowrap;" @onclick="() => _showPrivacyModal = true">
                        Review &amp; Approve &rarr;
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_summary != null && (_summary.UnreadMessagesCount > 0 || _summary.PendingConsentCount > 0 || _summary.UnpaidInvoicesCount > 0))
    {
        <div class="today-action-alerts">
            <div class="alert-icon">⚠️</div>
            <div class="alert-content">
                <strong>@Localization.T("Today.ActionRequired")</strong>
                <div class="alert-items">
                    @if (_summary.UnreadMessagesCount > 0)
                    {
                        <NavLink href="/messages" class="alert-link">
                            • @Localization.T("Today.UnreadMessage") (@_summary.UnreadMessagesCount)
                        </NavLink>
                    }
                    @if (_summary.PendingConsentCount > 0)
                    {
                        <NavLink href="/family-profile" class="alert-link">
                            • @Localization.T("Today.PendingConsent")
                        </NavLink>
                    }
                    @if (_summary.UnpaidInvoicesCount > 0)
                    {
                        <a href="javascript:void(0)" class="alert-link" @onclick="() => _showInvoicesModal = true">
                            • @Localization.T("Today.UnpaidInvoice") (@_summary.UnpaidInvoicesCount)
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- MAIN TWO-COLUMN CONTENT (Responsive Stack on Mobile) -->
    <div class="today-columns-grid">
        
        <!-- LEFT COLUMN: DAILY TIMELINE & CARE REPORT -->
        <div class="today-column">
            <!-- REUSABLE ACTIVITY TIMELINE -->
            <ActivityTimeline Title="Today's Timeline" Items="@_summary?.TimelineItems" />

            <!-- REUSABLE CARE SUMMARY CARD -->
            <CareSummaryCard Report="@_summary?.DailyCareReport" />
        </div>

        <!-- RIGHT COLUMN: CAPTURED MOMENTS & CELEBRATIONS -->
        <div class="today-column">
            <!-- CAPTURED MOMENTS -->
            <div class="today-section">
                <div class="today-section-header">
                    <h3 class="today-section-title">Captured Moments</h3>
                    <NavLink href="/journey" class="today-section-link">View All Journey &rarr;</NavLink>
                </div>

                @if (_summary?.ApprovedMoments == null || _summary.ApprovedMoments.Count == 0)
                {
                    <div class="today-moments-empty">
                        <span style="font-size: 22px;">📸</span>
                        <div class="today-moments-empty-title">No photos or shared moments yet today.</div>
                        <div class="today-moments-empty-sub">Teacher-approved moments will show up here immediately.</div>
                    </div>
                }
                else
                {
                    <div class="today-moments-list">
                        @foreach (var moment in _summary.ApprovedMoments)
                        {
                            <div class="today-moment-card">
                                <div class="today-moment-top">
                                    <span class="today-moment-sparkle">✨</span>
                                    <span class="today-moment-title">@(moment.Title ?? "Little Moment")</span>
                                    <span class="today-moment-time">@moment.ObservationDate.ToString("h:mm tt")</span>
                                </div>
                                <p class="today-moment-obs">@moment.Observation</p>
                                @if (moment.Photos != null && moment.Photos.Any())
                                {
                                    <div class="today-moment-photos" style="display: flex; gap: 8px; margin: 10px 0; flex-wrap: wrap;">
                                        @foreach (var photo in moment.Photos.Take(2))
                                        {
                                            <img src="@photo" style="max-width: 140px; max-height: 100px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border, #e4e7df);" alt="Moment Photo" />
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(moment.ChildVoice))
                                {
                                    <div class="today-moment-voice">
                                        &ldquo;@moment.ChildVoice&rdquo;
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- UPCOMING EVENTS & CELEBRATIONS -->
            <div class="today-section" style="margin-top: 20px;">
                <div class="today-section-header">
                    <h3 class="today-section-title">Upcoming Celebrations</h3>
                    <NavLink href="/events" class="today-section-link">View All &rarr;</NavLink>
                </div>

                @if (_summary?.UpcomingEvents == null || _summary.UpcomingEvents.Count == 0)
                {
                    <div class="today-moments-empty">
                        <span style="font-size: 22px;">🎈</span>
                        <div class="today-moments-empty-title">No celebrations scheduled this week.</div>
                    </div>
                }
                else
                {
                    <div class="today-events-list">
                        @foreach (var evt in _summary.UpcomingEvents)
                        {
                            <div class="today-event-card">
                                <div class="today-event-top">
                                    <span class="today-event-title">@evt.Title</span>
                                    <span class="today-event-date">@evt.EventDate.ToString("MMM dd")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(evt.Location))
                                {
                                    <div class="today-event-loc">📍 @evt.Location</div>
                                }
                                <div style="margin-top: 8px;">
                                    <NavLink href="/events" class="today-event-rsvp-link">
                                        View Event &amp; RSVP &rarr;
                                    </NavLink>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- EVERYDAY ACTION MODALS -->
    @if (SessionState.SelectedChild != null)
    {
        <ReportAbsenceModal @bind-IsOpen="_showAbsenceModal"
                            ChildId="SessionState.SelectedChild.ChildId"
                            ChildName="@SessionState.SelectedChild.FirstName" />

        <InvoicesListModal @bind-IsOpen="_showInvoicesModal"
                           ChildId="SessionState.SelectedChild.ChildId" />

        <AuthorizedPickupsModal @bind-IsOpen="_showPickupsModal"
                                ChildId="SessionState.SelectedChild.ChildId"
                                ChildName="@SessionState.SelectedChild.FirstName" />
    }

    @if (_showPrivacyModal)
    {
        <div class="modal-backdrop" @onclick="() => _showPrivacyModal = false">
            <div class="modal-card" style="max-width: 520px;" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div>
                        <span class="modal-eyebrow">SAFETY &amp; TRUST CENTER</span>
                        <h3 class="modal-title">Privacy &amp; Custody Trust Acceptance</h3>
                    </div>
                    <button class="close-btn" @onclick="() => _showPrivacyModal = false">✕</button>
                </div>
                <div class="modal-body" style="padding: 20px; font-size: 13px; line-height: 1.5; color: var(--text, #26332d); max-height: 65vh; overflow-y: auto;">
                    <p style="margin-top: 0;">
                        To protect <strong>@(SessionState.SelectedChild?.FirstName ?? "your child")</strong> and ensure verified compliance across educators, branch staff, and administration, please review and accept the child data privacy terms:
                    </p>
                    
                    <div style="display: flex; flex-direction: column; gap: 12px; margin: 16px 0;">
                        <div style="display: flex; gap: 10px; background: var(--surface-soft, #f8f9f5); padding: 12px; border-radius: 10px; border: 1px solid var(--border, #e4e7df);">
                            <span style="font-size: 18px;">📷</span>
                            <div>
                                <strong>Photo &amp; Media Privacy</strong>
                                <p style="margin: 2px 0 0; font-size: 12px; color: var(--muted, #6c7870);">Photos and learning moments are strictly restricted to verified family and teachers. Never exposed publicly.</p>
                            </div>
                        </div>
                        <div style="display: flex; gap: 10px; background: var(--surface-soft, #f8f9f5); padding: 12px; border-radius: 10px; border: 1px solid var(--border, #e4e7df);">
                            <span style="font-size: 18px;">👥</span>
                            <div>
                                <strong>Authorized Pickup &amp; Custody</strong>
                                <p style="margin: 2px 0 0; font-size: 12px; color: var(--muted, #6c7870);">Children are released only to verified guardians and registered pickup contacts with ID or PIN verification.</p>
                            </div>
                        </div>
                        <div style="display: flex; gap: 10px; background: var(--surface-soft, #f8f9f5); padding: 12px; border-radius: 10px; border: 1px solid var(--border, #e4e7df);">
                            <span style="font-size: 18px;">📑</span>
                            <div>
                                <strong>Safeguarding &amp; Regulatory Rights</strong>
                                <p style="margin: 2px 0 0; font-size: 12px; color: var(--muted, #6c7870);">Attendance and observations are securely maintained in full compliance with education standards.</p>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; padding: 10px; background: #f0fdf4; border-radius: 8px; border: 1px solid #bbf7d0;">
                        <span style="color: #166534; font-size: 14px;">✓</span>
                        <span style="font-size: 11.5px; color: #166534;">By clicking approve, you grant official parent acknowledgment for the current school term. This status is permanently logged and immediately visible to teachers and staff.</span>
                    </div>
                </div>
                <div class="modal-footer" style="padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px; background: var(--surface-soft, #f8f9f5); border-top: 1px solid var(--border, #e4e7df);">
                    <button class="btn secondary" @onclick="() => _showPrivacyModal = false">Cancel</button>
                    <button class="primary" disabled="@_isApprovingPrivacy" @onclick="ApprovePrivacyModalAsync">
                        @(_isApprovingPrivacy ? "Approving..." : "✓ Accept & Approve Privacy & Trust")
                    </button>
                </div>
            </div>
        </div>
    }
}

<style>
    .attendance-badge-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 8px 14px;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.03);
    }

    .attendance-badge-label {
        font-size: 10px;
        font-weight: 750;
        color: var(--muted, #6c7870);
        margin-bottom: 2px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .attendance-badge-status {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .attendance-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .attendance-dot.present { background: #22c55e; }
    .attendance-dot.departed { background: #3b82f6; }
    .attendance-dot.absent { background: #ef4444; }
    .attendance-dot.pending { background: #94a3b8; }

    .attendance-text {
        font-size: 13.5px;
    }

    .attendance-text.present { color: #166534; }
    .attendance-text.departed { color: #1e40af; }
    .attendance-text.absent { color: #991b1b; }
    .attendance-text.pending { color: var(--muted, #6c7870); }

    .attendance-time {
        font-size: 12px;
        color: var(--muted, #6c7870);
    }

    .today-columns-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
        gap: 20px;
        align-items: start;
    }

    .today-column {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .today-section {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        padding: 18px 20px;
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .05));
    }

    .today-section-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 12px;
    }

    .today-section-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--text, #26332d);
        margin: 0;
        letter-spacing: -0.3px;
    }

    .today-section-link {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--accent, #557c6c);
        text-decoration: none;
    }

    .today-section-link:hover {
        text-decoration: underline;
    }

    .today-moments-empty {
        padding: 24px 16px;
        text-align: center;
        background: var(--surface-soft, #f8f9f5);
        border-radius: 12px;
        border: 1px dashed var(--border, #e4e7df);
    }

    .today-moments-empty-title {
        font-weight: 650;
        font-size: 12.5px;
        color: var(--text, #26332d);
        margin-top: 4px;
    }

    .today-moments-empty-sub {
        font-size: 11px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }

    .today-moments-list,
    .today-events-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .today-moment-card,
    .today-event-card {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 12px 14px;
    }

    .today-moment-top,
    .today-event-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }

    .today-moment-sparkle {
        font-size: 14px;
    }

    .today-moment-title,
    .today-event-title {
        font-weight: 750;
        font-size: 13.5px;
        color: var(--text, #26332d);
        flex: 1;
    }

    .today-moment-time {
        font-size: 10.5px;
        color: var(--muted, #6c7870);
    }

    .today-event-date {
        font-size: 10.5px;
        font-weight: 750;
        color: var(--accent-dark, #31523c);
        background: var(--accent-light, #e6eee9);
        padding: 2px 7px;
        border-radius: 6px;
    }

    .today-moment-obs {
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        margin: 0;
        line-height: 1.45;
    }

    .today-moment-voice {
        margin-top: 8px;
        background: var(--surface, #ffffff);
        border-left: 3px solid var(--accent, #557c6c);
        padding: 6px 10px;
        font-size: 11.5px;
        font-style: italic;
        color: var(--text, #26332d);
        border-radius: 0 6px 6px 0;
    }

    .today-event-loc {
        font-size: 11.5px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }

    .today-event-rsvp-link {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--accent, #557c6c);
        text-decoration: underline;
    }

    .everyday-actions-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        overflow-x: auto;
        padding: 4px 0 14px;
        margin-bottom: 12px;
        -webkit-overflow-scrolling: touch;
    }

    .action-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text, #26332d);
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.15s ease;
        box-shadow: 0 1px 3px rgba(40, 55, 47, 0.04);
    }

    .action-chip:hover {
        background: var(--surface-soft, #f8f9f5);
        border-color: var(--accent, #557c6c);
        color: var(--accent-dark, #31523c);
    }

    .chip-icon {
        font-size: 14px;
    }

    .chip-counter {
        background: var(--accent-dark, #31523c);
        color: white;
        font-size: 10px;
        padding: 1px 6px;
        border-radius: 10px;
        margin-left: 2px;
    }

    .chip-counter.alert {
        background: #c53030;
    }

    .today-action-alerts {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #fffdf5;
        border: 1px solid #f6e05e;
        border-radius: 14px;
        padding: 12px 16px;
        margin-bottom: 18px;
    }

    .alert-icon {
        font-size: 20px;
        flex-shrink: 0;
    }

    .alert-content strong {
        font-size: 13px;
        color: #744210;
        display: block;
        margin-bottom: 4px;
    }

    .alert-items {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .alert-link {
        font-size: 12.5px;
        font-weight: 700;
        color: #744210;
        text-decoration: underline;
        cursor: pointer;
    }

    .today-announcements-broadcast {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 20px;
    }

    .announcement-broadcast-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 14px;
        padding: 12px 18px;
        box-shadow: 0 2px 8px rgba(40, 55, 47, 0.04);
    }

    .announcement-broadcast-card.urgent {
        background: #fffdf8;
        border: 1.5px solid #f59e0b;
        border-left: 5px solid #d97706;
    }

    .announcement-broadcast-badge {
        font-size: 11px;
        font-weight: 800;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        padding: 3px 8px;
        border-radius: 6px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .announcement-broadcast-badge.badge-urgent {
        background: #fef3c7;
        color: #b45309;
    }

