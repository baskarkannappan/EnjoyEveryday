@page "/harvest"
@using EnjoyEveryday.UI.Shared.Components

<PageHero 
    Eyebrow="EXPERIENCE MEMORY" 
    Title="Harvest & Insights" 
    Subtitle="What happened matters more than simply completing the activity.">
</PageHero>

<HarvestInsightCard 
    Title="Your daycare is learning."
    Message="42 experiences happened this month. 31 received teacher feedback. 8 patterns were discovered." />

<div class="harvest-layout">
    <ExperiencePerformanceGrid Items="@_performanceItems" OnViewClick="OnViewClick" />

    <TeacherFeedbackList 
        Items="@_feedbackItems" />
</div>

<Flywheel Steps="@_flywheelSteps" />

@code {
    private IQueryable<ExperiencePerformanceItem> _performanceItems = new List<ExperiencePerformanceItem>
    {
        new ExperiencePerformanceItem { Title = "Our Little City", Subtitle = "Created by Priya", Uses = 12, Response = "💬 10" },
        new ExperiencePerformanceItem { Title = "Frog Rescue", Subtitle = "AI + Teacher", Uses = 8, Response = "💬 6" },
        new ExperiencePerformanceItem { Title = "Giant Painting", Subtitle = "Created by Daniel", Uses = 6, Response = "💬 5" }
    }.AsQueryable();

    private List<FeedbackItem> _feedbackItems = new List<FeedbackItem>
    {
        new FeedbackItem { Id = Guid.NewGuid(), Notes = "The children loved jumping but lost interest after five minutes.", Author = "Priya • Bluebirds" },
        new FeedbackItem { Id = Guid.NewGuid(), Notes = "Adding animals completely changed the experience.", Author = "Sarah • Butterflies" }
    };

    private List<FlywheelStep> _flywheelSteps = new()
    {
        new FlywheelStep { Name = "Create", IsActive = true },
        new FlywheelStep { Name = "Schedule", IsActive = true },
        new FlywheelStep { Name = "Experience", IsActive = true },
        new FlywheelStep { Name = "Harvest", IsActive = true },
        new FlywheelStep { Name = "Improve", IsActive = false },
        new FlywheelStep { Name = "Reuse", IsActive = false },
    };

    private void OnViewClick(ExperiencePerformanceItem item)
    {
        // View logic
    }
}
