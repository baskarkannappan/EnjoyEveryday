@page "/events"
@attribute [Authorize]
@namespace EnjoyEveryday.Parent.Web.Components.Pages.Learning
@inject IParentService ParentService
@inject ParentSessionState SessionState
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Events &amp; Celebrations — EnjoyEveryday</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading celebrations &amp; events..." 
                  SubMessage="Retrieving classroom gatherings, dates, and RSVP status" />
}
else if (SessionState.SelectedChild == null)
{
    <EmptyState Icon="🎈"
                Title="No Authorized Child Selected"
                Description="Please connect an active child enrollment to see classroom events."
                ActionText="Connect Demo Child"
                OnAction='() => Navigation.NavigateTo("/auth/login")' />
}
else
{
    <!-- HEADER -->
    <ParentPageHeader Eyebrow="COMMUNITY · CELEBRATIONS & MEMORIES"
                      Title="Classroom & Daycare Events"
                      Subtitle="Join in celebrations, respond to classroom invitations, and browse approved memories." />

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="events-feedback-banner">
            <span>✓ @_feedbackMessage</span>
            <button class="events-feedback-close" @onclick="() => _feedbackMessage = null">✕</button>
        </div>
    }

    <!-- EVENTS LIST -->
    @if (_events.Count == 0)
    {
        <EmptyState Icon="🎈"
                    Title="No Published Events"
                    Description="When upcoming celebrations, field experiences, or classroom gatherings are scheduled, invitations will appear here."
                    MinHeightPx="180" />
    }
    else
    {
        <div class="events-card-list">
            @foreach (var evt in _events)
            {
                var isCompleted = string.Equals(evt.Status, "Completed", StringComparison.OrdinalIgnoreCase);

                <div class="event-card">
                    <div class="event-card-top">
                        <div>
                            <div class="event-title-row">
                                <h3 class="event-title">@evt.Title</h3>
                                <span class="event-status-pill @(isCompleted ? "completed" : "upcoming")">
                                    @(isCompleted ? "Completed" : "Upcoming")
                                </span>
                            </div>
                            <div class="event-meta-row">
                                <span>📅 @evt.EventDate.ToString("dddd, MMMM dd, yyyy")</span>
                                @if (!string.IsNullOrEmpty(evt.Location))
                                {
                                    <span>📍 @evt.Location</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(evt.Description))
                    {
                        <p class="event-description">
                            @evt.Description
                        </p>
                    }

                    <!-- PHOTOS FOR COMPLETED EVENTS -->
                    @if (isCompleted && evt.PhotoUrls != null && evt.PhotoUrls.Length > 0)
                    {
                        <div class="event-photos-section">
                            <div class="event-photos-label">Celebration Memories &amp; Photos:</div>
                            <div class="event-photos-grid">
                                @for (int i = 0; i < evt.PhotoUrls.Length; i++)
                                {
                                    var photo = evt.PhotoUrls[i];
                                    <div class="event-photo-wrap" @onclick="() => OpenPhoto(photo, evt.Title, evt.EventDate)">
                                        <img src="@photo" alt="@evt.Title photo" class="event-photo-img" loading="lazy" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- RSVP INTERACTION IF UPCOMING -->
                    @if (!isCompleted)
                    {
                        <div class="event-rsvp-bar">
                            <div class="event-rsvp-prompt">
                                <span class="event-rsvp-label">Family RSVP:</span>
                                <span class="event-rsvp-hint">Will your family attend this celebration?</span>
                            </div>
                            <div class="event-rsvp-actions">
                                <button class="primary event-rsvp-btn attending" 
                                        @onclick='() => SubmitRsvp(evt.Id, "Attending")'>
                                    ✓ Attending
                                </button>
                                <button class="secondary event-rsvp-btn decline" 
                                        @onclick='() => SubmitRsvp(evt.Id, "Declined")'>
                                    Cannot Attend
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- LIGHTBOX FOR EVENT PHOTOS -->
    <MediaViewer IsOpen="@_viewerOpen"
                 CurrentItem="@_activePhoto"
                 HasPrevious="false"
                 HasNext="false"
                 OnClose="() => _viewerOpen = false" />
}

<style>
    .events-feedback-banner {
        background: #eef5ef;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        color: #166534;
        font-size: 13.5px;
        font-weight: 650;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .events-feedback-close {
        background: none;
        border: none;
        cursor: pointer;
        color: #166534;
        font-size: 14px;
    }

    .events-card-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .event-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        padding: 20px 22px;
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .05));
    }

    .event-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .event-title-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .event-title {
        font-size: 16.5px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin: 0;
    }

    .event-status-pill {
        font-size: 10px;
        font-weight: 750;
        padding: 2px 8px;
        border-radius: 8px;
    }

    .event-status-pill.completed {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
    }

    .event-status-pill.upcoming {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .event-meta-row {
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        margin-top: 4px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .event-description {
        font-size: 13.5px;
        color: var(--text, #26332d);
        line-height: 1.5;
        margin: 0 0 14px 0;
    }

    .event-photos-section {
        margin-top: 14px;
        margin-bottom: 14px;
    }

    .event-photos-label {
        font-size: 11.5px;
        font-weight: 750;
        color: var(--muted, #6c7870);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .event-photos-grid {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .event-photo-wrap {
        width: 130px;
        height: 95px;
        border-radius: 10px;
        overflow: hidden;
        cursor: pointer;
        border: 1px solid var(--border, #e4e7df);
        transition: transform 0.15s ease;
    }

    .event-photo-wrap:hover {
        transform: scale(1.03);
    }

    .event-photo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .event-rsvp-bar {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .event-rsvp-prompt {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .event-rsvp-label {
        font-size: 13px;
        font-weight: 750;
        color: var(--text, #26332d);
    }

    .event-rsvp-hint {
        font-size: 12px;
        color: var(--muted, #6c7870);
    }

    .event-rsvp-actions {
        display: flex;
        gap: 8px;
    }

    .event-rsvp-btn {
        padding: 6px 14px !important;
        font-size: 12px !important;
        border-radius: 8px !important;
    }

    @@media (max-width: 640px) {
        .event-card {
            padding: 14px 16px;
        }

        .event-rsvp-bar {
            flex-direction: column;
            align-items: flex-start;
        }

        .event-rsvp-actions {
            width: 100%;
        }

        .event-rsvp-btn {
            flex: 1;
            text-align: center;
        }
    }
</style>

@code {
    private List<Event> _events = new();
    private bool _loading = true;
    private string? _feedbackMessage;
    private bool _viewerOpen;
    private MediaItemModel? _activePhoto;

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChildChanged += OnChildSelectionChanged;
        await LoadEventsAsync();
    }

    private async void OnChildSelectionChanged()
    {
        await LoadEventsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadEventsAsync()
    {
        if (SessionState.SelectedChild == null)
        {
            _loading = false;
            return;
        }

        try
        {
            _loading = true;
            _events = (await ParentService.GetApprovedEventsAsync(SessionState.SelectedChild.ChildId)).ToList();
        }
        catch (Exception)
        {
            _events = new List<Event>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitRsvp(Guid eventId, string status)
    {
        if (SessionState.SelectedChild == null) return;

        try
        {
            await ParentService.SubmitEventRsvpAsync(eventId, SessionState.SelectedChild.ChildId, status, "Submitted via Parent Portal");
            _feedbackMessage = $"Thank you! Your RSVP has been recorded as '{status}'.";
            await LoadEventsAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Could not update RSVP: {ex.Message}";
        }
    }

    private void OpenPhoto(string url, string title, DateOnly date)
    {
        _activePhoto = new MediaItemModel
        {
            Url = url,
            Title = title,
            Date = date.ToDateTime(TimeOnly.MinValue),
            Category = "Celebration"
        };
        _viewerOpen = true;
    }

    public void Dispose()
    {
        SessionState.OnChildChanged -= OnChildSelectionChanged;
    }
}
