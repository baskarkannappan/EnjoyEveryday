@page "/experiences"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject ExperienceService ExperienceService
 <section id="page-experiences" class="page active">


    <div class="page-header">

        <div>

            <div class="eyebrow">
                YOUR EXPERIENCE LIBRARY
            </div>

            <h2>
                My Experiences
            </h2>

            <p>
                Your daycare's growing collection.
                Every experience gets better with use.
            </p>

        </div>


        <button id="createExperienceButton" class="primary">

            + Create experience

        </button>

    </div>


    <div class="tabs">


        <button class="tab active" data-filter="all">

            All

        </button>


        <button class="tab" data-filter="created">

            Created by us

        </button>


        <button class="tab" data-filter="platform">

            Platform

        </button>


        <button class="tab" data-filter="ai">

            AI created

        </button>


    </div>


    <div class="search-row">

        <input id="experienceSearch" class="search" placeholder="Search experiences...">


        <select id="ageFilter" class="filter">

            <option value="all">
                All ages
            </option>

            <option value="3–4">
                3–4
            </option>

            <option value="4–5">
                4–5
            </option>

        </select>


        <select id="typeFilter" class="filter">

            <option value="all">
                All types
            </option>

            <option value="Explore">
                Explore
            </option>

            <option value="Create">
                Create
            </option>

            <option value="Move">
                Move
            </option>

            <option value="Together">
                Together
            </option>

        </select>

    </div>


    <div id="experienceGrid" class="experience-grid">

            <article class="experience">

                <div class="experience-top">

                    <span class="chip green">
                        Create
                    </span>

                    <span class="chip gray">
                        Tenant Approved
                    </span>

                </div>


                <h3>
                    Our Little City
