                <div class="experience-meta">

                    <span>
                        3–4
                    </span>

                    <span>
                        25 min
                    </span>

                    <span>
                        Indoor
                    </span>

                </div>


                <div class="experience-bottom">

                    <span class="experience-usage">
                        12
                        uses ·
                        v3
                    </span>


                    <button class="text-button view-experience" data-id="city">

