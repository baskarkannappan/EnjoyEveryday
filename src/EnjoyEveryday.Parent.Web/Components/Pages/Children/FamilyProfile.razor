@page "/family"
@page "/family-profile"
@page "/profile"
@page "/settings"
@attribute [Authorize]
@namespace EnjoyEveryday.Parent.Web.Components.Pages.Children
@using EnjoyEveryday.Domain.Entities
@inject IParentService ParentService
@inject IConsentService ConsentService
@inject IDaycareAnnouncementService AnnouncementService
@inject ParentSessionState SessionState
@inject ParentLocalizationService Localization
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Family Profile — EnjoyEveryday</PageTitle>

<!-- HEADER -->
<ParentPageHeader Eyebrow="SECURITY · CONTACT & FAMILY"
                  Title="Family & Guardian Profile"
                  Subtitle="Review your linked children, authorized pickups, privacy compliance, and communication preferences.">
    <RightContent>
        <LanguageSwitcher />
    </RightContent>
</ParentPageHeader>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="family-status-banner">
        <span>✓ @_statusMessage</span>
        <button class="family-status-close" @onclick="() => _statusMessage = null">✕</button>
    </div>
}

<div class="family-profile-grid">

    <!-- LEFT COLUMN: CONTACT DETAILS & CONSENT STATUS -->
    <div class="family-profile-column">
        
        <!-- PRIMARY CONTACT PREFERENCES -->
        <div class="family-card">
            <h2 class="family-card-title">Primary Contact Details</h2>
            <p class="family-card-subtitle">Self-service communication preferences</p>

            @if (_loadingProfile)
            {
                <LoadingState Message="Loading profile details..." MinHeightPx="120" />
            }
            else
            {
                <div class="family-form">
                    <div class="family-field">
                        <label class="family-label">Guardian Name</label>
                        <input class="family-input disabled"
                               value="@(_person?.FirstName + " " + _person?.LastName)" disabled />
                        <span class="family-hint">Legal name modifications require daycare administration approval.</span>
                    </div>

                    <div class="family-field">
                        <label class="family-label">Email Address</label>
                        <input class="family-input disabled"
                               value="@_person?.Email" disabled />
                    </div>

                    <div class="family-field">
                        <label class="family-label active">Mobile Phone</label>
                        <input class="family-input"
                               @bind="_mobilePhone" placeholder="Enter mobile phone number" />
                    </div>

                    <div class="family-field">
                        <label class="family-label active">Preferred Contact Method</label>
                        <select class="family-select" @bind="_preferredContactMethod">
                            <option value="Mobile">Mobile SMS &amp; Phone</option>
                            <option value="Email">Email Only</option>
                        </select>
                    </div>

                    <div class="family-field">
                        <label class="family-label active">Preferred Portal Language</label>
                        <select class="family-select" @bind="_preferredLanguage">
                            <option value="en">English</option>
                            <option value="ta">தமிழ் (Tamil)</option>
                            <option value="te">తెలుగు (Telugu)</option>
                            <option value="hi">हिन्दी (Hindi)</option>
                            <option value="kn">ಕನ್ನಡ (Kannada)</option>
                        </select>
                    </div>

                    <div style="margin-top: 10px;">
                        <button class="primary family-save-btn" 
                                disabled="@_isSaving"
                                @onclick="SaveContactDetails">
                            @if (_isSaving)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Preferences</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- CHILD CONSENT STATUS -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">Consent &amp; Permissions</h2>
                    <p class="family-card-subtitle">Photo permissions, emergency medical, and agreements</p>
                </div>
                <span class="family-consent-pill">Safety</span>
            </div>

            @if (_loadingConsent)
            {
                <LoadingState Message="Loading consent documents..." MinHeightPx="100" />
            }
            else if (_consentDocuments.Count == 0)
            {
                <div class="family-consent-empty">
                    <span>🛡️</span>
                    <span>All baseline daycare consent agreements are up to date.</span>
                </div>
            }
            else
            {
                <div class="family-consent-list">
                    @foreach (var doc in _consentDocuments)
                    {
                        <ConsentStatusCard Document="@doc" OnReview="HandleReviewConsent" />
                    }
                </div>
            }
        </div>

    </div>

    <!-- RIGHT COLUMN: AUTHORIZED CHILDREN, PICKUPS, DAYCARE ANNOUNCEMENTS & PRIVACY -->
    <div class="family-profile-column">
        
        <!-- AUTHORIZED CHILDREN -->
        <div class="family-card">
            <h2 class="family-card-title">Authorized Children</h2>
            <p class="family-card-subtitle">Enrolled children linked to your family account</p>

            <div class="family-children-list">
                @foreach (var child in SessionState.AuthorizedChildren)
                {
                    <div class="family-child-item @(child.ChildId == SessionState.SelectedChild?.ChildId ? "active" : "")"
                         @onclick="() => SessionState.SelectChild(child.ChildId)">
                        <div class="family-child-avatar">
                            @if (!string.IsNullOrEmpty(child.PhotoUrl))
                            {
                                <img src="@child.PhotoUrl" alt="@child.FirstName" class="family-child-img" />
                            }
                            else
                            {
                                <span>@(child.FirstName.Length > 0 ? child.FirstName[0].ToString() : "🧒")</span>
                            }
                        </div>
                        <div class="family-child-info">
                            <div class="family-child-name-row">
                                <strong class="family-child-name">@child.FirstName @child.LastName</strong>
                                @if (child.ChildId == SessionState.SelectedChild?.ChildId)
                                {
                                    <span class="family-active-badge">Selected</span>
                                }
                            </div>
                            <div class="family-child-rel">
                                Relationship: <strong>@child.Relationship</strong> @(child.IsPrimary ? "(Primary Guardian)" : "")
                            </div>
                            <div class="family-child-class">
                                @(child.ClassroomName ?? "Classroom") &middot; @(child.OrganizationName ?? "Daycare")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- AUTHORIZED PICKUPS REGISTRY (SYNCED ACROSS PORTALS) -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">Authorized Pickups</h2>
                    <p class="family-card-subtitle">Individuals authorized to collect @(SessionState.SelectedChild?.FirstName ?? "your child") (synced to teacher checkout)</p>
                </div>
                <button class="primary" style="padding: 6px 14px; font-size: 12px; font-weight: 700; border-radius: 9px;" @onclick="OpenAddPickupModal">
                    ＋ Add Pickup
                </button>
            </div>

            @if (_loadingPickups)
            {
                <LoadingState Message="Loading authorized pickup contacts..." MinHeightPx="100" />
            }
            else if (_pickups.Count == 0)
            {
                <div class="family-consent-empty" style="background: #fff8f0; border-color: #fed7aa; padding: 14px;">
                    <span style="font-size: 20px;">⚠️</span>
                    <span style="color: #9a3412; font-weight: 600;">Action Mandatory: No authorized pickup contacts registered yet. Enrolling a primary authorized guardian is mandatory for safe child checkout.</span>
                </div>
            }
            else
            {
                @if (!_pickups.Any(p => p.IsPrimaryGuardian))
                {
                    <div class="family-consent-empty" style="background: #fff8f0; border-color: #fed7aa; padding: 10px 14px; margin-bottom: 12px;">
                        <span style="font-size: 18px;">⚠️</span>
                        <span style="color: #9a3412; font-size: 12.5px; font-weight: 600;">Notice: Please designate at least one contact as Primary Guardian for child release compliance.</span>
                    </div>
                }
                <div class="family-pickups-list">
                    @foreach (var p in _pickups)
                    {
                        <div class="family-pickup-item">
                            <div class="family-pickup-avatar">
                                @(string.IsNullOrWhiteSpace(p.FullName) ? "G" : p.FullName.Substring(0, 1).ToUpper())
                            </div>
                            <div class="family-pickup-info">
                                <div class="family-child-name-row">
                                    <strong class="family-child-name">@p.FullName</strong>
                                    <span class="family-active-badge @(p.IsPrimaryGuardian ? "primary-badge" : "")">
                                        @(p.IsPrimaryGuardian ? "Primary Guardian" : "Authorized Pickup")
                                    </span>
                                </div>
                                <div class="family-child-rel">
                                    Relationship: <strong>@p.Relationship</strong> @(!string.IsNullOrWhiteSpace(p.Phone) ? $"· {p.Phone}" : "")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.Notes))
                                {
                                    <div class="family-pickup-note">
                                        Note: @p.Notes
                                    </div>
                                }
                            </div>
                            <div class="family-pickup-actions">
                                <button class="btn secondary pickup-action-btn" @onclick="() => EditPickup(p)">
                                    Edit
                                </button>
                                @if (!p.IsPrimaryGuardian)
                                {
                                    <button class="btn secondary pickup-delete-btn" @onclick="() => DeletePickup(p.Id)">
                                        Remove
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="family-safety-synced-note">
                <span>🔄</span>
                <span>Updates sync immediately to Teacher Workspace, Check-Out verification, and Daycare Administration.</span>
            </div>
        </div>

        <!-- DAYCARE ANNOUNCEMENTS FEED -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">Daycare Announcements</h2>
                    <p class="family-card-subtitle">Official center updates from organization &amp; branch leaders</p>
                </div>
                <span style="font-size: 16px;">📢</span>
            </div>

            @if (_loadingAnnouncements)
            {
                <LoadingState Message="Loading announcements..." MinHeightPx="80" />
            }
            else if (_announcements.Count == 0)
            {
                <div class="family-consent-empty">
                    <span>📢</span>
                    <span>No active announcements from the center today.</span>
                </div>
            }
            else
            {
                <div class="family-announcements-list">
                    @foreach (var ann in _announcements)
                    {
                        <AnnouncementCard Title="@ann.Title"
                                          Content="@ann.Content"
                                          Date="@ann.CreatedAt.ToLocalTime()"
                                          Tag="@ann.Tag"
                                          IsUrgent="@ann.IsUrgent" />
                    }
                </div>
            }
        </div>

        <!-- PRIVACY & TRUST CENTER -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">@Localization.T("Privacy.Title")</h2>
                    <p class="family-card-subtitle">Transparent child safety, consent, and data ownership</p>
                </div>
                <span style="font-size: 18px;">🛡️</span>
            </div>

            @if (_isPrivacyApproved)
            {
                <div class="privacy-status-banner approved">
                    <span class="privacy-status-icon">🛡️</span>
                    <div>
                        <strong>Privacy &amp; Trust Terms Approved</strong>
                        <p>
                            Verified for @(SessionState.SelectedChild?.FirstName). Approved on
                            @(_privacyApprovedDate?.ToString("MMM dd, yyyy") ?? "Today") by @(_person?.FirstName ?? "Guardian").
                            Active across all teacher, branch admin, and organization portals.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="privacy-status-banner pending">
                    <span class="privacy-status-icon">⚠️</span>
                    <div style="flex: 1;">
                        <strong>Action Required: Review &amp; Accept Privacy &amp; Trust</strong>
                        <p>
                            Please accept the child safety and data terms for @(SessionState.SelectedChild?.FirstName) to activate security compliance.
                        </p>
                        <button class="primary" style="margin-top: 8px; padding: 7px 16px; font-size: 12px; border-radius: 9px; font-weight: 700;"
                                disabled="@_isApprovingPrivacy"
                                @onclick="ApprovePrivacyTrust">
                            @(_isApprovingPrivacy ? "Approving..." : "✓ Accept & Approve Privacy & Trust")
                        </button>
                    </div>
                </div>
            }

            <div class="trust-center-items">
                <div class="trust-item">
                    <span class="trust-icon">📷</span>
                    <div>
                        <strong>Photo &amp; Media Privacy</strong>
                        <p>Photos and videos of your child are restricted to verified family members. No photos are exposed through public URLs or shared with third parties.</p>
                    </div>
                </div>

                <div class="trust-item">
                    <span class="trust-icon">👥</span>
                    <div>
                        <strong>Individual Guardian Access</strong>
                        <p>Each parent or guardian has their own authenticated account. Access is never shared automatically by surname or email domain.</p>
                    </div>
                </div>

                <div class="trust-item">
                    <span class="trust-icon">📑</span>
                    <div>
                        <strong>Data Retention &amp; Rights</strong>
                        <p>Child learning observations and attendance records are securely retained per education regulatory requirements. You may request data correction or export at any time.</p>
                    </div>
                </div>

                <div class="trust-contact-box">
                    <span>Contact Center Data Protection Officer:</span>
                    <strong>dpo@enjoyeveryday.daycare</strong>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- AUTHORIZED PICKUP MODAL -->
@if (_showPickupModal)
{
    <div class="family-modal-backdrop" @onclick="ClosePickupModal">
        <div class="family-modal-card" @onclick:stopPropagation="true">
            <div class="family-modal-header">
                <div>
                    <span class="modal-eyebrow">CHILD SECURITY &amp; CUSTODY</span>
                    <h3 class="modal-title">@(_isEditingPickup ? "Edit Authorized Pickup" : "Add Authorized Pickup")</h3>
                </div>
                <button class="modal-close-btn" @onclick="ClosePickupModal">✕</button>
            </div>

            <div class="family-modal-body">
                @if (!string.IsNullOrEmpty(_pickupModalError))
                {
                    <div class="family-modal-error">
                        <span>⚠️ @_pickupModalError</span>
                    </div>
                }

                <div class="family-field">
                    <label class="family-label active">Full Legal Name *</label>
                    <input class="family-input" @bind="_pickupForm.FullName" placeholder="e.g. Grandma Helen or John Doe" />
                </div>

                <div class="family-field">
                    <label class="family-label active">Relationship *</label>
                    <select class="family-select" @bind="_pickupForm.Relationship">
                        <option value="Grandparent">Grandparent</option>
                        <option value="Aunt / Uncle">Aunt / Uncle</option>
                        <option value="Relative">Relative</option>
                        <option value="Family Friend">Family Friend</option>
                        <option value="Babysitter / Nanny">Babysitter / Nanny</option>
                        <option value="Emergency Contact">Emergency Contact</option>
                        <option value="Guardian">Guardian</option>
                        <option value="Other">Other Authorized Individual</option>
                    </select>
                </div>

                <div class="family-field">
                    <label class="family-label active">Mobile Phone Number *</label>
                    <input class="family-input" @bind="_pickupForm.Phone" placeholder="Mobile phone for front-desk ID verification" />
                    <span class="family-hint">Staff call this number if identity verification is required at checkout.</span>
                </div>

                <div class="family-field">
                    <label class="family-label active">4-Digit Pickup PIN (Optional)</label>
                    <input class="family-input" @bind="_pickupForm.PickupCode" placeholder="Optional security PIN" maxlength="6" />
                </div>

                <div class="family-field">
                    <label class="family-label active">Authorization Notes / Schedule</label>
                    <textarea class="family-input" style="height: 60px; resize: vertical;" @bind="_pickupForm.Notes" placeholder="e.g. Authorized for Friday afternoons or regular daily pickup"></textarea>
                </div>

                <div class="family-field" style="margin-top: 10px; display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="isPrimaryGuardian" @bind="_pickupForm.IsPrimaryGuardian" style="width: 18px; height: 18px; accent-color: var(--accent, #557c6c);" />
                    <label for="isPrimaryGuardian" style="font-size: 13px; font-weight: 700; color: var(--text, #26332d); cursor: pointer; margin: 0;">
                        Primary Guardian Contact (Mandatory for at least one pickup)
                    </label>
                </div>
            </div>

            <div class="family-modal-footer">
                <button class="btn secondary" @onclick="ClosePickupModal">Cancel</button>
                <button class="primary" disabled="@_isSavingPickup" @onclick="SavePickup">
                    @(_isSavingPickup ? "Saving..." : "Save Authorized Pickup")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .family-status-banner {
        background: #eef5ef;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        color: #166534;
        font-size: 13.5px;
        font-weight: 650;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .family-status-close {
        background: none;
        border: none;
        cursor: pointer;
        color: #166534;
        font-size: 16px;
    }

    .family-profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
        margin-top: 10px;
    }

    .family-profile-column {
        display: flex;
        flex-direction: column;
    }

    .family-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        padding: 24px;
    }

    .family-card-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .family-card-title {
        font-size: 17px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin: 0;
        letter-spacing: -0.3px;
    }

    .family-card-subtitle {
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        margin: 4px 0 0 0;
    }

    .family-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 18px;
    }

    .family-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .family-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--muted, #6c7870);
    }

    .family-label.active {
        color: var(--text, #26332d);
    }

    .family-input, .family-select {
        border: 1px solid var(--border, #e4e7df);
        background: var(--surface-soft, #f8f9f5);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13.5px;
        color: var(--text, #26332d);
        outline: none;
        transition: border-color 0.15s ease;
        font-family: inherit;
    }

    .family-input:focus, .family-select:focus {
        border-color: var(--accent, #557c6c);
        background: #ffffff;
    }

    .family-input.disabled {
        background: #f1f3ee;
        color: #78827c;
        cursor: not-allowed;
    }

    .family-hint {
        font-size: 11px;
        color: var(--muted, #6c7870);
    }

    .family-save-btn {
        padding: 10px 22px;
        border-radius: 11px;
        font-size: 13.5px;
    }

    .family-consent-pill {
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        border-radius: 6px;
        padding: 3px 8px;
        border: 1px solid #c8dacd;
    }

    .family-consent-empty {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px;
        border-radius: 12px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        font-size: 13px;
        color: var(--muted, #6c7870);
    }

    .family-children-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 14px;
    }

    .family-child-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .family-child-item:hover, .family-child-item.active {
        background: #ffffff;
        border-color: var(--accent, #557c6c);
        box-shadow: 0 4px 14px rgba(40, 55, 47, 0.05);
    }

    .family-child-avatar {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #eef2ed;
        display: grid;
        place-items: center;
        font-size: 20px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .family-child-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .family-child-info {
        flex: 1;
        min-width: 0;
    }

    .family-child-name-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .family-child-name {
        font-size: 14px;
        color: var(--text, #26332d);
    }

    .family-active-badge {
        font-size: 9.5px;
        font-weight: 750;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        padding: 2px 6px;
        border-radius: 6px;
    }

    .family-active-badge.primary-badge {
        background: #e0f2fe;
        color: #0369a1;
    }

    .family-child-rel {
        font-size: 12px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }

    .family-child-class {
        font-size: 11px;
        color: var(--muted, #6c7870);
        margin-top: 1px;
    }

    /* AUTHORIZED PICKUPS STYLES */
    .family-pickups-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 12px;
    }

    .family-pickup-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
    }

    .family-pickup-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        display: grid;
        place-items: center;
        font-weight: 750;
        font-size: 16px;
        flex-shrink: 0;
    }

    .family-pickup-info {
        flex: 1;
        min-width: 0;
    }

    .family-pickup-note {
        font-size: 11px;
        color: var(--accent-dark, #31523c);
        margin-top: 3px;
        font-style: italic;
    }

    .family-pickup-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pickup-action-btn {
        padding: 4px 10px;
        font-size: 11.5px;
        border-radius: 8px;
    }

    .pickup-delete-btn {
        padding: 4px 8px;
        font-size: 11.5px;
        border-radius: 8px;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .family-safety-synced-note {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 8px 12px;
        border-radius: 9px;
        background: #f0fdf4;
