@page "/family"
@attribute [Authorize]
@namespace EnjoyEveryday.Parent.Web.Components.Pages.Children
@inject IParentService ParentService
@inject IConsentService ConsentService
@inject ParentSessionState SessionState
@inject ParentLocalizationService Localization
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Family Profile — EnjoyEveryday</PageTitle>

<!-- HEADER -->
<ParentPageHeader Eyebrow="SECURITY · CONTACT & FAMILY"
                  Title="Family & Guardian Profile"
                  Subtitle="Review your linked children, active consent documents, and manage your communication preferences.">
    <RightContent>
        <LanguageSwitcher />
    </RightContent>
</ParentPageHeader>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="family-status-banner">
        <span>✓ @_statusMessage</span>
        <button class="family-status-close" @onclick="() => _statusMessage = null">✕</button>
    </div>
}

<div class="family-profile-grid">

    <!-- LEFT COLUMN: CONTACT DETAILS & CONSENT STATUS -->
    <div class="family-profile-column">
        
        <!-- PRIMARY CONTACT PREFERENCES -->
        <div class="family-card">
            <h2 class="family-card-title">Primary Contact Details</h2>
            <p class="family-card-subtitle">Self-service communication preferences</p>

            @if (_loadingProfile)
            {
                <LoadingState Message="Loading profile details..." MinHeightPx="120" />
            }
            else
            {
                <div class="family-form">
                    <div class="family-field">
                        <label class="family-label">Guardian Name</label>
                        <input class="family-input disabled"
                               value="@(_person?.FirstName + " " + _person?.LastName)" disabled />
                        <span class="family-hint">Legal name modifications require daycare administration approval.</span>
                    </div>

                    <div class="family-field">
                        <label class="family-label">Email Address</label>
                        <input class="family-input disabled"
                               value="@_person?.Email" disabled />
                    </div>

                    <div class="family-field">
                        <label class="family-label active">Mobile Phone</label>
                        <input class="family-input"
                               @bind="_mobilePhone" placeholder="Enter mobile phone number" />
                    </div>

                    <div class="family-field">
                        <label class="family-label active">Preferred Contact Method</label>
                        <select class="family-select" @bind="_preferredContactMethod">
                            <option value="Mobile">Mobile SMS &amp; Phone</option>
                            <option value="Email">Email Only</option>
                        </select>
                    </div>

                    <div class="family-field">
                        <label class="family-label active">Preferred Portal Language</label>
                        <select class="family-select" @bind="_preferredLanguage">
                            <option value="en">English</option>
                            <option value="ta">தமிழ் (Tamil)</option>
                            <option value="te">తెలుగు (Telugu)</option>
                            <option value="hi">हिन्दी (Hindi)</option>
                            <option value="kn">ಕನ್ನಡ (Kannada)</option>
                        </select>
                    </div>

                    <div style="margin-top: 10px;">
                        <button class="primary family-save-btn" 
                                disabled="@_isSaving"
                                @onclick="SaveContactDetails">
                            @if (_isSaving)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Preferences</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- CHILD CONSENT STATUS -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">Consent &amp; Permissions</h2>
                    <p class="family-card-subtitle">Photo permissions, emergency medical, and agreements</p>
                </div>
                <span class="family-consent-pill">Safety</span>
            </div>

            @if (_loadingConsent)
            {
                <LoadingState Message="Loading consent documents..." MinHeightPx="100" />
            }
            else if (_consentDocuments.Count == 0)
            {
                <div class="family-consent-empty">
                    <span>🛡️</span>
                    <span>All baseline daycare consent agreements are up to date.</span>
                </div>
            }
            else
            {
                <div class="family-consent-list">
                    @foreach (var doc in _consentDocuments)
                    {
                        <ConsentStatusCard Document="@doc" OnReview="HandleReviewConsent" />
                    }
                </div>
            }
        </div>

    </div>

    <!-- RIGHT COLUMN: AUTHORIZED CHILDREN & DAYCARE ANNOUNCEMENTS -->
    <div class="family-profile-column">
        
        <!-- AUTHORIZED CHILDREN -->
        <div class="family-card">
            <h2 class="family-card-title">Authorized Children</h2>
            <p class="family-card-subtitle">Enrolled children linked to your family account</p>

            <div class="family-children-list">
                @foreach (var child in SessionState.AuthorizedChildren)
                {
                    <div class="family-child-item @(child.ChildId == SessionState.SelectedChild?.ChildId ? "active" : "")"
                         @onclick="() => SessionState.SelectChild(child.ChildId)">
                        <div class="family-child-avatar">
                            @if (!string.IsNullOrEmpty(child.PhotoUrl))
                            {
                                <img src="@child.PhotoUrl" alt="@child.FirstName" class="family-child-img" />
                            }
                            else
                            {
                                <span>@(child.FirstName.Length > 0 ? child.FirstName[0].ToString() : "🧒")</span>
                            }
                        </div>
                        <div class="family-child-info">
                            <div class="family-child-name-row">
                                <strong class="family-child-name">@child.FirstName @child.LastName</strong>
                                @if (child.ChildId == SessionState.SelectedChild?.ChildId)
                                {
                                    <span class="family-active-badge">Selected</span>
                                }
                            </div>
                            <div class="family-child-rel">
                                Relationship: <strong>@child.Relationship</strong> @(child.IsPrimary ? "(Primary Guardian)" : "")
                            </div>
                            <div class="family-child-class">
                                @(child.ClassroomName ?? "Classroom") &middot; @(child.OrganizationName ?? "Daycare")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- SAFETY & CUSTODY NOTICE -->
            <div class="family-safety-notice">
                🔒 <strong>Safety Notice:</strong> To add authorized pick-up contacts, modify emergency custody, or update medical consent forms, please contact your daycare center director directly.
            </div>
        </div>

        <!-- DAYCARE ANNOUNCEMENTS FEED -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">Daycare Announcements</h2>
                    <p class="family-card-subtitle">Important notices and center updates</p>
                </div>
                <span style="font-size: 16px;">📢</span>
            </div>

            <div class="family-announcements-list">
                <AnnouncementCard Title="Seasonal Weather Reminder"
                                  Content="As morning outdoor exploration continues, please ensure your child has weather-appropriate layer clothing and labelled waterproof boots in their cubby."
                                  Date="@DateTime.Today"
                                  Tag="Notice"
                                  IsUrgent="false" />

                <AnnouncementCard Title="Upcoming Parent-Teacher Conferences"
                                  Content="Quarterly learning journey reflections and conference schedules will be published next week. Look for an invitation in your messages."
                                  Date="@DateTime.Today.AddDays(-2)"
                                  Tag="Reminder"
                                  IsUrgent="false" />
            </div>
        </div>

        <!-- PRIVACY & TRUST CENTER -->
        <div class="family-card" style="margin-top: 20px;">
            <div class="family-card-top-row">
                <div>
                    <h2 class="family-card-title">@Localization.T("Privacy.Title")</h2>
                    <p class="family-card-subtitle">Transparent child safety, consent, and data ownership</p>
                </div>
                <span style="font-size: 18px;">🛡️</span>
            </div>

            <div class="trust-center-items">
                <div class="trust-item">
                    <span class="trust-icon">📷</span>
                    <div>
                        <strong>Photo &amp; Media Privacy</strong>
                        <p>Photos and videos of your child are restricted to verified family members. No photos are exposed through public URLs or shared with third parties.</p>
                    </div>
                </div>

                <div class="trust-item">
                    <span class="trust-icon">👥</span>
                    <div>
                        <strong>Individual Guardian Access</strong>
                        <p>Each parent or guardian has their own authenticated account. Access is never shared automatically by surname or email domain.</p>
                    </div>
                </div>

                <div class="trust-item">
                    <span class="trust-icon">📑</span>
                    <div>
                        <strong>Data Retention &amp; Rights</strong>
                        <p>Child learning observations and attendance records are securely retained per education regulatory requirements. You may request data correction or export at any time.</p>
                    </div>
                </div>

                <div class="trust-contact-box">
                    <span>Contact Center Data Protection Officer:</span>
                    <strong>dpo@enjoyeveryday.daycare</strong>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .family-status-banner {
        background: #eef5ef;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        color: #166534;
        font-size: 13.5px;
        font-weight: 650;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .family-status-close {
        background: none;
        border: none;
        cursor: pointer;
        color: #166534;
        font-size: 14px;
    }

    .family-profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
        gap: 20px;
        align-items: start;
    }

    .family-profile-column {
        display: flex;
        flex-direction: column;
    }

    .family-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        padding: 22px 24px;
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .05));
    }

    .family-card-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 14px;
    }

    .family-card-title {
        font-size: 17px;
        font-weight: 800;
        color: var(--text, #26332d);
        margin: 0 0 2px 0;
        letter-spacing: -0.3px;
    }

    .family-card-subtitle {
        font-size: 12px;
        color: var(--muted, #6c7870);
        margin: 0 0 14px 0;
    }

    .family-consent-pill {
        font-size: 10px;
        font-weight: 750;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        padding: 2px 8px;
        border-radius: 6px;
    }

    .family-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .family-field {
        display: flex;
        flex-direction: column;
    }

    .family-label {
        font-size: 11px;
        font-weight: 750;
        color: var(--muted, #6c7870);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .family-label.active {
        color: var(--text, #26332d);
    }

    .family-input,
    .family-select {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid var(--border, #e4e7df);
        border-radius: 10px;
        font-size: 13.5px;
        box-sizing: border-box;
        font-family: inherit;
        outline: none;
    }

    .family-input:focus,
    .family-select:focus {
        border-color: var(--accent, #557c6c);
    }

    .family-input.disabled {
        background: var(--surface-soft, #f8f9f5);
        color: var(--muted, #6c7870);
        cursor: not-allowed;
    }

    .family-hint {
        font-size: 10.5px;
        color: var(--muted, #6c7870);
        margin-top: 3px;
    }

    .family-save-btn {
        padding: 9px 20px !important;
        font-size: 13px !important;
        border-radius: 10px !important;
    }

    .family-consent-empty {
        padding: 16px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px dashed var(--border, #e4e7df);
        border-radius: 12px;
        font-size: 12.5px;
        color: var(--muted, #6c7870);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .family-consent-list,
    .family-children-list,
    .family-announcements-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .family-child-item {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 14px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    .family-child-item:hover {
        background: #f0f4f1;
        border-color: #c8dacd;
    }

    .family-child-item.active {
        border-color: var(--accent, #557c6c);
        background: #f2f7f4;
    }

    .family-child-avatar {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 16px;
        overflow: hidden;
        flex-shrink: 0;
        border: 1px solid #d0e0d6;
    }

    .family-child-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .family-child-info {
        flex: 1;
        min-width: 0;
    }

    .family-child-name-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .family-child-name {
        font-size: 14px;
        color: var(--text, #26332d);
    }

    .family-active-badge {
        font-size: 9.5px;
        font-weight: 750;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e6253);
        padding: 2px 6px;
        border-radius: 6px;
    }

    .family-child-rel {
        font-size: 12px;
        color: var(--muted, #6c7870);
        margin-top: 2px;
    }

    .family-child-class {
        font-size: 11px;
        color: var(--muted, #6c7870);
        margin-top: 1px;
    }

    .family-safety-notice {
        margin-top: 16px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 11.5px;
        color: #92400e;
        line-height: 1.5;
    }

    .trust-center-items {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .trust-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 14px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
    }

    .trust-icon {
        font-size: 18px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .trust-item strong {
        font-size: 13.5px;
        color: var(--text, #26332d);
        display: block;
        margin-bottom: 2px;
    }

    .trust-item p {
        margin: 0;
        font-size: 12px;
        color: var(--muted, #6c7870);
        line-height: 1.4;
    }

    .trust-contact-box {
        margin-top: 4px;
        padding: 10px 14px;
        background: var(--accent-light, #e6eee9);
        border: 1px solid #c8dacd;
        border-radius: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: var(--accent-dark, #3e6253);
    }

    @@media (max-width: 640px) {
        .family-profile-grid {
            grid-template-columns: 1fr;
        }

        .family-card {
            padding: 16px;
        }

        .trust-contact-box {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
    }
</style>

@code {
    private Person? _person;
    private List<ChildConsentDocument> _consentDocuments = new();
    private bool _loadingProfile = true;
    private bool _loadingConsent = true;
    private bool _isSaving = false;
    private string? _mobilePhone;
    private string _preferredContactMethod = "Mobile";
    private string _preferredLanguage = "en";
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChildChanged += OnChildSelectionChanged;
        Localization.OnLanguageChanged += StateHasChanged;
        await LoadProfile();
        await LoadConsentDocuments();
    }

    private async void OnChildSelectionChanged()
    {
        await LoadConsentDocuments();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProfile()
    {
        try
        {
            _loadingProfile = true;
            _person = await ParentService.GetParentProfileAsync();
            if (_person != null)
            {
                _mobilePhone = _person.MobilePhone;
                _preferredContactMethod = _person.PreferredContactMethod ?? "Mobile";
                _preferredLanguage = !string.IsNullOrWhiteSpace(_person.PreferredLanguage) ? _person.PreferredLanguage : "en";
            }
        }
        finally
        {
            _loadingProfile = false;
        }
    }

    private async Task LoadConsentDocuments()
    {
        if (SessionState.SelectedChild == null)
        {
            _loadingConsent = false;
            return;
        }

        try
        {
            _loadingConsent = true;
            var docs = await ConsentService.GetDocumentsAsync(childId: SessionState.SelectedChild.ChildId);
            _consentDocuments = docs.ToList();
        }
        catch (Exception)
        {
            _consentDocuments = new List<ChildConsentDocument>();
        }
        finally
        {
            _loadingConsent = false;
        }
    }

    private async Task SaveContactDetails()
    {
        try
        {
            _isSaving = true;
            await ParentService.UpdateParentContactAsync(_mobilePhone, _preferredContactMethod, _preferredLanguage);
            Localization.SetLanguage(_preferredLanguage);
            _statusMessage = "Contact preferences and language updated successfully.";
            await LoadProfile();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void HandleReviewConsent(Guid documentId)
    {
        Navigation.NavigateTo($"/consent/sign/{documentId}");
    }

    public void Dispose()
    {
        SessionState.OnChildChanged -= OnChildSelectionChanged;
        Localization.OnLanguageChanged -= StateHasChanged;
    }
}
