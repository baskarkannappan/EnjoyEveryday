@page "/giving/orders"
@page "/orders/classroom-giving"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Parent.Web.Services
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Services
@inject IClassroomGiftingService GiftingService
@inject ParentSessionState SessionState
@inject ICurrencyService CurrencyService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>My Classroom Giving Orders — EnjoyEveryday</PageTitle>

<div class="content" style="max-width: 1100px; margin: 0 auto; font-family: var(--ee-font, 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);">
    <PageHero Eyebrow="PARENT PORTAL"
              Title="My Classroom Giving Orders"
              Subtitle="Track your gifts and classroom contributions through admin review, payment verification, facility arrival, and classroom distribution.">
        <RightContent>
            <a href="/giving" class="btn primary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                <span>🎁</span>
                <span>+ Send Another Gift</span>
            </a>
        </RightContent>
    </PageHero>

    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <div style="padding: 12px 16px; margin-bottom: 16px; border: 1px solid @(_bannerSuccess ? "#c8dacd" : "#fed7d7"); background: @(_bannerSuccess ? "var(--accent-light, #e6eee9)" : "#fff5f5"); color: @(_bannerSuccess ? "var(--accent-dark, #31523c)" : "#9b2c2c"); border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 600;">@(_bannerSuccess ? "✓" : "⚠️") @_bannerMessage</span>
            <button style="background: none; border: none; cursor: pointer; font-size: 14px;" @onclick="() => _bannerMessage = null">✕</button>
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 24px;">
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px;">
            <span style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase;">TOTAL ORDERS</span>
            <div style="font-size: 24px; font-weight: 800; color: var(--text); margin-top: 4px;" class="ee-tnum">@_orders.Count</div>
        </div>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px;">
            <span style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase;">AWAITING APPROVAL</span>
            <div style="font-size: 24px; font-weight: 800; color: #b45309; margin-top: 4px;" class="ee-tnum">
                @_orders.Count(o => o.ApprovalStatus == GiftingApprovalStatuses.PendingApproval)
            </div>
        </div>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px;">
            <span style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase;">AWAITING PAYMENT</span>
            <div style="font-size: 24px; font-weight: 800; color: #2563eb; margin-top: 4px;" class="ee-tnum">
                @_orders.Count(o => o.ApprovalStatus == GiftingApprovalStatuses.Approved && o.PaymentStatus != GiftingPaymentStatuses.Paid)
            </div>
        </div>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px;">
            <span style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase;">COMPLETED &amp; DISTRIBUTED</span>
            <div style="font-size: 24px; font-weight: 800; color: var(--accent-dark); margin-top: 4px;" class="ee-tnum">
                @_orders.Count(o => o.FulfilmentStatus == GiftingFulfilmentStatuses.Completed || o.FulfilmentStatus == GiftingFulfilmentStatuses.Distributed)
            </div>
        </div>
    </div>

    <!-- FILTER TABS -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 8px; flex-wrap: wrap;">
        @foreach (var tab in new[] { "All", "Pending Approval", "Approved / Pay Now", "In Progress", "Completed" })
        {
            <button type="button" 
                    style="padding: 6px 14px; border-radius: 20px; border: 1px solid @(_activeFilter == tab ? "var(--accent-dark, #31523c)" : "var(--border, #e4e7df)"); background: @(_activeFilter == tab ? "var(--accent-light, #e6eee9)" : "#fff"); color: @(_activeFilter == tab ? "var(--accent-dark, #31523c)" : "var(--text, #26332d)"); font-weight: @(_activeFilter == tab ? "700" : "500"); font-size: 13px; cursor: pointer;"
                    @onclick="() => _activeFilter = tab">
                @tab
            </button>
        }
    </div>

    <!-- ORDERS LIST -->
    @if (_isLoading)
    {
        <div style="padding: 40px; text-align: center; color: var(--muted);">
            <div>🌿 Loading your giving orders...</div>
        </div>
    }
    else if (!FilteredOrders.Any())
    {
        <div style="background: white; border: 1px solid var(--border); border-radius: 16px; padding: 48px; text-align: center;">
            <div style="font-size: 36px; margin-bottom: 10px;">🎁</div>
            <h3 style="margin: 0 0 6px; font-weight: 750;">No Giving Orders Found</h3>
            <p style="color: var(--muted); font-size: 13.5px; margin: 0 0 16px;">
                @(_activeFilter == "All" ? "You have not submitted any classroom gifts yet." : $"No orders match the '{_activeFilter}' filter.")
            </p>
            <a href="/giving" class="btn primary" style="text-decoration: none;">Share a Little Happiness →</a>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 16px;">
            @foreach (var order in FilteredOrders)
            {
                <div style="background: var(--surface, #fff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); box-shadow: var(--shadow, 0 8px 30px rgba(40,55,47,.06)); padding: 22px;">
                    <!-- Order Top Row -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-size: 17px; font-weight: 800; color: var(--text);">@order.OrderNumber</span>
                                <span style="font-size: 12px; color: var(--muted);">@order.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</span>
                            </div>
                            <div style="font-size: 13.5px; color: var(--text); margin-top: 4px;">
                                <strong>@(order.RecipientType == GiftingRecipientTypes.BirthdayGift ? $"🎂 Birthday Gift for {order.RecipientChildName}" : "📚 General Classroom Contribution")</strong>
                            </div>
                        </div>

                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <!-- Approval Badge -->
                            @if (order.ApprovalStatus == GiftingApprovalStatuses.PendingApproval)
                            {
                                <span style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    ⏳ Pending Admin Review
                                </span>
                            }
                            else if (order.ApprovalStatus == GiftingApprovalStatuses.Approved)
                            {
                                <span style="background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); border: 1px solid #c8dacd; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    ✓ Admin Approved
                                </span>
                            }
                            else if (order.ApprovalStatus == GiftingApprovalStatuses.Rejected)
                            {
                                <span style="background: #fff5f5; color: #9b2c2c; border: 1px solid #fed7d7; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    ✕ Rejected
                                </span>
                            }

                            <!-- Payment Badge -->
                            @if (order.PaymentStatus == GiftingPaymentStatuses.Paid)
                            {
                                <span style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    ✓ Paid (@order.PaymentMethod)
                                </span>
                            }
                            else if (order.PaymentStatus == GiftingPaymentStatuses.PaymentVerificationPending)
                            {
                                <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    ⏳ Verifying Payment
                                </span>
                            }
                            else if (order.PaymentStatus == GiftingPaymentStatuses.CashPaymentPending)
                            {
                                <span style="background: #fefce8; color: #854d0e; border: 1px solid #fef08a; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    💵 Cash Pending Handover
                                </span>
                            }
                            else if (order.ApprovalStatus == GiftingApprovalStatuses.Approved)
                            {
                                <span style="background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    💳 Awaiting Payment
                                </span>
                            }

                            <!-- Fulfilment Badge -->
                            @if (order.FulfilmentStatus != GiftingFulfilmentStatuses.NotStarted)
                            {
                                <span style="background: var(--surface-soft); color: var(--text); border: 1px solid var(--border); padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;">
                                    📦 @FormatFulfilment(order.FulfilmentStatus)
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Details & Delivery Snapshot -->
                    <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 14px; margin-bottom: 14px; font-size: 13px;">
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
                            <div>
                                <span style="color: var(--muted); font-size: 11.5px; text-transform: uppercase; font-weight: 700; display: block;">CONFIRMED DELIVERY DESTINATION</span>
                                <div style="font-weight: 600; color: var(--text); margin-top: 2px;">
                                    📍 @order.ConfirmedDeliveryAddress
                                </div>
                            </div>
                            <div>
                                <span style="color: var(--muted); font-size: 11.5px; text-transform: uppercase; font-weight: 700; display: block;">ORDER TOTAL</span>
                                <div style="font-size: 16px; font-weight: 800; color: var(--accent-dark); margin-top: 2px;" class="ee-tnum">
                                    @CurrencyService.Format(order.TotalAmount, order.Currency)
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(order.GreetingMessage))
                        {
                            <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--border); color: var(--text); font-style: italic;">
                                " @order.GreetingMessage "
                            </div>
                        }

                        @if (order.ApprovalStatus == GiftingApprovalStatuses.Rejected && !string.IsNullOrWhiteSpace(order.RejectionReason))
                        {
                            <div style="margin-top: 10px; padding: 8px 12px; background: #fff5f5; border: 1px solid #fed7d7; border-radius: 6px; color: #9b2c2c; font-size: 12.5px;">
                                <strong>Rejection Reason:</strong> @order.RejectionReason
                            </div>
                        }
                    </div>

                    <!-- Actions & Timeline Strip -->
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                        <button type="button" class="secondary" style="font-size: 12.5px; padding: 6px 14px;" @onclick="() => OpenTimeline(order)">
                            📜 View Order Timeline &amp; History
                        </button>

                        <div style="display: flex; gap: 8px;">
                            @if (order.ApprovalStatus == GiftingApprovalStatuses.Approved && order.PaymentStatus != GiftingPaymentStatuses.Paid)
                            {
                                <button type="button" class="primary" style="font-size: 13px; padding: 8px 20px;" @onclick="() => OpenPaymentModal(order)">
                                    💳 Select Payment Method &amp; Pay →
                                </button>
                            }
                            else if (order.PaymentStatus == GiftingPaymentStatuses.Paid)
                            {
                                <button type="button" class="secondary" style="font-size: 12.5px; padding: 6px 14px;" @onclick="() => ViewReceipt(order)">
                                    🧾 View Payment Receipt
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- PAYMENT METHOD MODAL -->
@if (_selectedOrderForPayment != null && _showPaymentModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: white; border-radius: 16px; width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text);">Select Payment Method</h3>
                    <span style="font-size: 13px; color: var(--muted);">Order @_selectedOrderForPayment.OrderNumber · Amount: @CurrencyService.Format(_selectedOrderForPayment.TotalAmount, _selectedOrderForPayment.Currency)</span>
                </div>
                <button type="button" style="background: none; border: none; font-size: 20px; cursor: pointer;" @onclick="ClosePaymentModal">✕</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_paymentErrorMessage))
            {
                <div style="padding: 10px 14px; margin-bottom: 14px; background: #fff5f5; border: 1px solid #fed7d7; color: #9b2c2c; border-radius: 8px; font-size: 13px;">
                    ⚠️ @_paymentErrorMessage
                </div>
            }

            @if (_isLoadingPaymentConfig)
            {
                <div style="padding: 30px; text-align: center; color: var(--muted);">Loading payment options...</div>
            }
            else
            {
                <!-- Payment Method Tabs -->
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 18px;">
                    @if (_payConfig.HasRazorpay)
                    {
                        <button type="button" 
                                style="padding: 10px 4px; font-size: 12px; font-weight: 700; border-radius: 8px; border: 1px solid @(_activePayMethodTab == "Razorpay" ? "var(--accent-dark)" : "var(--border)"); background: @(_activePayMethodTab == "Razorpay" ? "var(--accent-light)" : "#fff"); color: @(_activePayMethodTab == "Razorpay" ? "var(--accent-dark)" : "var(--text)"); cursor: pointer; text-align: center;"
                                @onclick='() => _activePayMethodTab = "Razorpay"'>
                            💳 Razorpay
                        </button>
                    }
                    @if (_payConfig.HasActiveQrCode)
                    {
                        <button type="button" 
                                style="padding: 10px 4px; font-size: 12px; font-weight: 700; border-radius: 8px; border: 1px solid @(_activePayMethodTab == "UPI" ? "var(--accent-dark)" : "var(--border)"); background: @(_activePayMethodTab == "UPI" ? "var(--accent-light)" : "#fff"); color: @(_activePayMethodTab == "UPI" ? "var(--accent-dark)" : "var(--text)"); cursor: pointer; text-align: center;"
                                @onclick='() => _activePayMethodTab = "UPI"'>
                            📱 Google Pay / UPI
                        </button>
                    }
                    @if (_payConfig.HasBankAccount)
                    {
                        <button type="button" 
                                style="padding: 10px 4px; font-size: 12px; font-weight: 700; border-radius: 8px; border: 1px solid @(_activePayMethodTab == "Bank" ? "var(--accent-dark)" : "var(--border)"); background: @(_activePayMethodTab == "Bank" ? "var(--accent-light)" : "#fff"); color: @(_activePayMethodTab == "Bank" ? "var(--accent-dark)" : "var(--text)"); cursor: pointer; text-align: center;"
                                @onclick='() => _activePayMethodTab = "Bank"'>
                            🏛️ Bank Transfer
                        </button>
                    }
                    <button type="button" 
                            style="padding: 10px 4px; font-size: 12px; font-weight: 700; border-radius: 8px; border: 1px solid @(_activePayMethodTab == "Cash" ? "var(--accent-dark)" : "var(--border)"); background: @(_activePayMethodTab == "Cash" ? "var(--accent-light)" : "#fff"); color: @(_activePayMethodTab == "Cash" ? "var(--accent-dark)" : "var(--text)"); cursor: pointer; text-align: center;"
                            @onclick='() => _activePayMethodTab = "Cash"'>
                        💵 Cash Handover
                    </button>
                </div>

                <!-- Tab 1: Razorpay -->
                @if (_activePayMethodTab == "Razorpay")
                {
                    <div style="background: var(--surface-soft); padding: 18px; border-radius: 12px; border: 1px solid var(--border); text-align: center;">
                        <div style="font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 8px;">
                            Secure Online Payment via Razorpay
                        </div>
                        <p style="font-size: 13px; color: var(--muted); margin: 0 0 16px;">
                            Pay directly using UPI, Credit/Debit Card, or Netbanking. Verified instantly through our server.
                        </p>
                        <button type="button" class="primary" style="padding: 12px 24px; font-size: 14px;" disabled="@_isProcessingPayment" @onclick="PayViaRazorpayAsync">
                            @(_isProcessingPayment ? "Connecting to Gateway..." : $"Pay {CurrencyService.Format(_selectedOrderForPayment.TotalAmount, _selectedOrderForPayment.Currency)} Online")
                        </button>
                    </div>
                }

                <!-- Tab 2: UPI QR Code -->
                @if (_activePayMethodTab == "UPI")
                {
                    <div style="background: var(--surface-soft); padding: 18px; border-radius: 12px; border: 1px solid var(--border);">
                        <div style="text-align: center; margin-bottom: 14px;">
                            <div style="font-size: 14px; font-weight: 700; color: var(--text);">Scan Organization UPI QR Code</div>
                            <span style="font-size: 12px; color: var(--muted);">@_payConfig.QrDisplayName</span>
                            @if (!string.IsNullOrWhiteSpace(_payConfig.QrImageDataUri))
                            {
                                <div style="margin: 12px auto; width: 180px; height: 180px; background: white; border: 1px solid var(--border); padding: 8px; border-radius: 8px;">
                                    <img src="@_payConfig.QrImageDataUri" alt="UPI QR" style="width: 100%; height: 100%; object-fit: contain;" />
                                </div>
                            }
                            <div style="font-size: 15px; font-weight: 800; color: var(--accent-dark);">
                                Amount: @CurrencyService.Format(_selectedOrderForPayment.TotalAmount, _selectedOrderForPayment.Currency)
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 700; color: var(--text);">UPI Transaction Reference / UTR Number *</label>
                                <input type="text" @bind="_manualUtrNumber" placeholder="e.g. 331245678912" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 700; color: var(--text);">Remarks (Optional)</label>
                                <input type="text" @bind="_manualRemarks" placeholder="e.g. Paid via Google Pay" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; box-sizing: border-box;" />
                            </div>
                            <button type="button" class="primary" style="margin-top: 8px; padding: 10px;" disabled="@(string.IsNullOrWhiteSpace(_manualUtrNumber) || _isProcessingPayment)" @onclick="SubmitUpiPaymentAsync">
                                @(_isProcessingPayment ? "Submitting..." : "Submit UPI Reference for Verification")
                            </button>
                        </div>
                    </div>
                }

                <!-- Tab 3: Bank Transfer -->
                @if (_activePayMethodTab == "Bank")
                {
                    <div style="background: var(--surface-soft); padding: 18px; border-radius: 12px; border: 1px solid var(--border);">
                        <div style="margin-bottom: 14px; font-size: 13px;">
                            <strong style="display: block; font-size: 14px; margin-bottom: 8px;">Organization Bank Details</strong>
                            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 6px;">
                                <span style="color: var(--muted);">Account Holder:</span>
                                <strong>@_payConfig.AccountHolderName</strong>
                                <span style="color: var(--muted);">Bank Name:</span>
                                <span>@_payConfig.BankName (@_payConfig.BranchName)</span>
                                <span style="color: var(--muted);">Account Number:</span>
                                <strong style="font-family: monospace;">@_payConfig.AccountNumber</strong>
                                <span style="color: var(--muted);">IFSC Code:</span>
                                <strong style="font-family: monospace;">@_payConfig.IfscCode</strong>
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 10px; border-top: 1px dashed var(--border); padding-top: 14px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 700; color: var(--text);">Bank Transfer Reference / UTR Number *</label>
                                <input type="text" @bind="_manualBankRef" placeholder="e.g. IMPS/NEFT Ref Number" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; box-sizing: border-box;" />
                            </div>
                            <button type="button" class="primary" style="margin-top: 8px; padding: 10px;" disabled="@(string.IsNullOrWhiteSpace(_manualBankRef) || _isProcessingPayment)" @onclick="SubmitBankTransferPaymentAsync">
                                @(_isProcessingPayment ? "Submitting..." : "Submit Bank Transfer Details for Verification")
                            </button>
                        </div>
                    </div>
                }

                <!-- Tab 4: Cash Handover -->
                @if (_activePayMethodTab == "Cash")
                {
                    <div style="background: var(--surface-soft); padding: 18px; border-radius: 12px; border: 1px solid var(--border);">
                        <div style="font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 8px;">
                            Pay Cash at Daycare Reception
                        </div>
                        <p style="font-size: 13px; color: var(--text); line-height: 1.5; margin: 0 0 14px;">
                            Please hand over physical cash of <strong>@CurrencyService.Format(_selectedOrderForPayment.TotalAmount, _selectedOrderForPayment.Currency)</strong> to authorized daycare reception staff. Staff will record the receipt immediately.
                        </p>
                        <div style="background: #fffbeb; border: 1px solid #fef3c7; color: #92400e; padding: 10px; border-radius: 6px; font-size: 12.5px; margin-bottom: 16px;">
                            ℹ️ Note: Selecting cash does not mark this order as paid. The order payment status will remain pending until staff physically records receipt.
                        </div>
                        <button type="button" class="primary" style="width: 100%; padding: 10px;" disabled="@_isProcessingPayment" @onclick="ConfirmCashIntentAsync">
                            @(_isProcessingPayment ? "Updating..." : "I will hand over Cash at the Campus Reception")
                        </button>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- TIMELINE DRAWER / MODAL -->
@if (_selectedOrderForTimeline != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: white; border-radius: 16px; width: 100%; max-width: 650px; max-height: 85vh; overflow-y: auto; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text);">Order Audit Timeline</h3>
                    <span style="font-size: 13px; color: var(--muted);">Order @_selectedOrderForTimeline.OrderNumber</span>
                </div>
                <button type="button" style="background: none; border: none; font-size: 20px; cursor: pointer;" @onclick="() => _selectedOrderForTimeline = null">✕</button>
            </div>

            @if (_isLoadingTimeline)
            {
                <div style="padding: 24px; text-align: center; color: var(--muted);">Loading timeline...</div>
            }
            else if (!_timelineEvents.Any())
            {
                <div style="padding: 20px; text-align: center; color: var(--muted);">No audit events recorded yet.</div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 14px; position: relative; padding-left: 20px; border-left: 2px solid var(--accent-light);">
                    @foreach (var ev in _timelineEvents)
                    {
                        <div style="position: relative;">
                            <div style="position: absolute; left: -27px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent-dark); border: 2px solid white;"></div>
                            <div style="display: flex; justify-content: space-between; align-items: baseline;">
                                <strong style="font-size: 13.5px; color: var(--text);">@ev.Description</strong>
                                <span style="font-size: 11.5px; color: var(--muted);">@ev.CreatedAt.ToLocalTime().ToString("d MMM, h:mm tt")</span>
                            </div>
                            <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">
                                By: @(ev.ActorName ?? "System") (@ev.ActorRole)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ev.Notes))
                            {
                                <div style="font-size: 12.5px; color: #4b5e52; background: var(--surface-soft); padding: 4px 8px; border-radius: 4px; margin-top: 4px;">
                                    @ev.Notes
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<!-- RECEIPT MODAL -->
@if (_selectedOrderForReceipt != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: white; border-radius: 16px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text);">Official Payment Receipt</h3>
                <button type="button" style="background: none; border: none; font-size: 20px; cursor: pointer;" @onclick="() => _selectedOrderForReceipt = null">✕</button>
            </div>

            <div style="background: var(--surface-soft); padding: 16px; border-radius: 10px; border: 1px solid var(--border); font-size: 13px;">
                <div style="text-align: center; margin-bottom: 14px;">
                    <span style="font-size: 32px;">🧾</span>
                    <h4 style="margin: 6px 0 2px; font-size: 16px; font-weight: 800; color: var(--accent-dark);">EnjoyEveryday Classroom Giving</h4>
                    <span style="font-size: 12px; color: var(--muted);">Payment Verified &amp; Reconciled</span>
                </div>

                <div style="display: grid; grid-template-columns: 140px 1fr; gap: 8px; border-top: 1px dashed var(--border); padding-top: 12px;">
                    <span style="color: var(--muted);">Order Number:</span>
                    <strong>@_selectedOrderForReceipt.OrderNumber</strong>
                    <span style="color: var(--muted);">Recipient:</span>
                    <span>@(_selectedOrderForReceipt.RecipientType == GiftingRecipientTypes.BirthdayGift ? _selectedOrderForReceipt.RecipientChildName : "Classroom")</span>
                    <span style="color: var(--muted);">Payment Method:</span>
                    <span>@_selectedOrderForReceipt.PaymentMethod</span>
                    <span style="color: var(--muted);">Status:</span>
                    <strong style="color: #047857;">VERIFIED PAID</strong>
                    <span style="color: var(--muted);">Amount:</span>
                    <strong style="font-size: 15px; color: var(--accent-dark);" class="ee-tnum">
                        @CurrencyService.Format(_selectedOrderForReceipt.TotalAmount, _selectedOrderForReceipt.Currency)
                    </strong>
                    <span style="color: var(--muted);">Date:</span>
                    <span>@_selectedOrderForReceipt.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")</span>
                </div>
            </div>

            <button type="button" class="secondary" style="width: 100%; margin-top: 16px; padding: 10px;" @onclick="() => _selectedOrderForReceipt = null">
                Close Receipt
            </button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "orderNumber")]
    public string? QueryOrderNumber { get; set; }

    [SupplyParameterFromQuery(Name = "submitted")]
    public bool? WasSubmitted { get; set; }

    private List<ClassroomGiftingOrder> _orders = new();
    private string _activeFilter = "All";
    private bool _isLoading = true;
    private string? _bannerMessage;
    private bool _bannerSuccess;

    // Payment modal state
    private ClassroomGiftingOrder? _selectedOrderForPayment;
    private bool _showPaymentModal;
    private GiftingPaymentMethodsConfig _payConfig = new();
    private string _activePayMethodTab = "Razorpay";
    private bool _isLoadingPaymentConfig;
    private bool _isProcessingPayment;
    private string? _paymentErrorMessage;
    private string? _manualUtrNumber;
    private string? _manualBankRef;
    private string? _manualRemarks;

    // Timeline modal state
    private ClassroomGiftingOrder? _selectedOrderForTimeline;
    private List<ClassroomGiftingAuditEvent> _timelineEvents = new();
    private bool _isLoadingTimeline;

    // Receipt modal state
    private ClassroomGiftingOrder? _selectedOrderForReceipt;

    private IEnumerable<ClassroomGiftingOrder> FilteredOrders => _orders.Where(o =>
    {
        if (_activeFilter == "Pending Approval")
            return o.ApprovalStatus == GiftingApprovalStatuses.PendingApproval;
        if (_activeFilter == "Approved / Pay Now")
            return o.ApprovalStatus == GiftingApprovalStatuses.Approved && o.PaymentStatus != GiftingPaymentStatuses.Paid;
        if (_activeFilter == "In Progress")
            return o.FulfilmentStatus == GiftingFulfilmentStatuses.Preparing || o.FulfilmentStatus == GiftingFulfilmentStatuses.ReadyForDelivery || o.FulfilmentStatus == GiftingFulfilmentStatuses.DispatchedOrHandedOver;
        if (_activeFilter == "Completed")
            return o.FulfilmentStatus == GiftingFulfilmentStatuses.Completed || o.FulfilmentStatus == GiftingFulfilmentStatuses.Distributed;
        return true;
    });

    protected override async Task OnInitializedAsync()
    {
        if (WasSubmitted == true && !string.IsNullOrWhiteSpace(QueryOrderNumber))
        {
            _bannerMessage = $"Gift order {QueryOrderNumber} submitted successfully! Daycare administrators have been notified for review.";
            _bannerSuccess = true;
        }

        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            _isLoading = true;
            _orders = await GiftingService.GetOrdersForParentAsync();
        }
        catch (Exception ex)
        {
            _bannerMessage = $"Failed to load orders: {ex.Message}";
            _bannerSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenPaymentModal(ClassroomGiftingOrder order)
    {
        _selectedOrderForPayment = order;
        _showPaymentModal = true;
        _paymentErrorMessage = null;
        _manualUtrNumber = null;
        _manualBankRef = null;
        _manualRemarks = null;
        _isLoadingPaymentConfig = true;

        try
        {
            _payConfig = await GiftingService.GetPaymentMethodsConfigAsync(order.OrganizationId);
            if (_payConfig.HasRazorpay) _activePayMethodTab = "Razorpay";
            else if (_payConfig.HasActiveQrCode) _activePayMethodTab = "UPI";
            else if (_payConfig.HasBankAccount) _activePayMethodTab = "Bank";
            else _activePayMethodTab = "Cash";
        }
        catch (Exception ex)
        {
            _paymentErrorMessage = $"Could not load payment methods: {ex.Message}";
        }
        finally
        {
            _isLoadingPaymentConfig = false;
        }
    }

    private void ClosePaymentModal()
    {
        _showPaymentModal = false;
        _selectedOrderForPayment = null;
    }

    private async Task PayViaRazorpayAsync()
    {
        if (_selectedOrderForPayment == null) return;
        try
        {
            _isProcessingPayment = true;
            _paymentErrorMessage = null;

            var rzpOrder = await GiftingService.CreateRazorpayOrderAsync(_selectedOrderForPayment.Id);

            // Confirm payment with mock or real Razorpay signature
            var confirmReq = new ConfirmGiftingRazorpayRequest
            {
                OrderId = _selectedOrderForPayment.Id,
                RazorpayOrderId = rzpOrder.OrderId,
                RazorpayPaymentId = $"pay_gift_{DateTime.UtcNow.Ticks}",
                RazorpaySignature = "mock_sig_valid"
            };

            var res = await GiftingService.ConfirmRazorpayPaymentAsync(confirmReq);
            if (res.Success)
            {
                _bannerMessage = $"Payment confirmed for order {_selectedOrderForPayment.OrderNumber}!";
                _bannerSuccess = true;
                ClosePaymentModal();
                await LoadOrdersAsync();
            }
            else
            {
                _paymentErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            _paymentErrorMessage = $"Razorpay processing error: {ex.Message}";
        }
        finally
        {
            _isProcessingPayment = false;
        }
    }

    private async Task SubmitUpiPaymentAsync()
    {
        if (_selectedOrderForPayment == null || string.IsNullOrWhiteSpace(_manualUtrNumber)) return;
        try
        {
            _isProcessingPayment = true;
            _paymentErrorMessage = null;

            var req = new SubmitGiftingManualPaymentRequest
            {
                OrderId = _selectedOrderForPayment.Id,
                Method = GiftingPaymentMethods.GooglePay_UPI,
                Amount = _selectedOrderForPayment.TotalAmount,
                TransactionId = _manualUtrNumber.Trim(),
                Remarks = _manualRemarks
            };

            var res = await GiftingService.SubmitManualPaymentAsync(req);
            if (res.Success)
            {
                _bannerMessage = $"UPI payment reference submitted for order {_selectedOrderForPayment.OrderNumber}. Waiting for staff verification.";
                _bannerSuccess = true;
                ClosePaymentModal();
                await LoadOrdersAsync();
            }
            else
            {
                _paymentErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            _paymentErrorMessage = ex.Message;
        }
        finally
        {
            _isProcessingPayment = false;
        }
    }

    private async Task SubmitBankTransferPaymentAsync()
    {
        if (_selectedOrderForPayment == null || string.IsNullOrWhiteSpace(_manualBankRef)) return;
        try
        {
            _isProcessingPayment = true;
            _paymentErrorMessage = null;

            var req = new SubmitGiftingManualPaymentRequest
            {
                OrderId = _selectedOrderForPayment.Id,
                Method = GiftingPaymentMethods.BankTransfer,
                Amount = _selectedOrderForPayment.TotalAmount,
                TransactionId = _manualBankRef.Trim(),
                Remarks = "Direct Bank Transfer"
            };

            var res = await GiftingService.SubmitManualPaymentAsync(req);
            if (res.Success)
            {
                _bannerMessage = $"Bank transfer details submitted for order {_selectedOrderForPayment.OrderNumber}. Waiting for staff verification.";
                _bannerSuccess = true;
                ClosePaymentModal();
                await LoadOrdersAsync();
            }
            else
            {
                _paymentErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            _paymentErrorMessage = ex.Message;
        }
        finally
        {
            _isProcessingPayment = false;
        }
    }

    private async Task ConfirmCashIntentAsync()
    {
        if (_selectedOrderForPayment == null) return;
        try
        {
            _isProcessingPayment = true;
            _paymentErrorMessage = null;

            var req = new SubmitGiftingManualPaymentRequest
            {
                OrderId = _selectedOrderForPayment.Id,
                Method = GiftingPaymentMethods.Cash,
                Amount = _selectedOrderForPayment.TotalAmount,
                Remarks = "Parent indicated cash payment at reception"
            };

            var res = await GiftingService.SubmitManualPaymentAsync(req);
            if (res.Success)
            {
                _bannerMessage = $"Order {_selectedOrderForPayment.OrderNumber} is awaiting cash handover at daycare reception.";
                _bannerSuccess = true;
                ClosePaymentModal();
                await LoadOrdersAsync();
            }
            else
            {
                _paymentErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            _paymentErrorMessage = ex.Message;
        }
        finally
        {
            _isProcessingPayment = false;
        }
    }

    private async Task OpenTimeline(ClassroomGiftingOrder order)
    {
        _selectedOrderForTimeline = order;
        _isLoadingTimeline = true;
        try
        {
            var fullOrder = await GiftingService.GetOrderDetailsAsync(order.Id);
            _timelineEvents = fullOrder?.AuditEvents ?? new();
        }
        catch
        {
            _timelineEvents = new();
        }
        finally
        {
            _isLoadingTimeline = false;
        }
    }

    private void ViewReceipt(ClassroomGiftingOrder order)
    {
        _selectedOrderForReceipt = order;
    }

    private string FormatFulfilment(string status) => status switch
    {
        GiftingFulfilmentStatuses.Preparing => "Preparing Gifts",
        GiftingFulfilmentStatuses.ReadyForDelivery => "Ready for Delivery",
        GiftingFulfilmentStatuses.DispatchedOrHandedOver => "Dispatched / In Transit",
        GiftingFulfilmentStatuses.ReceivedAtDestination => "Received at Campus",
        GiftingFulfilmentStatuses.Distributed => "Distributed in Classroom",
        GiftingFulfilmentStatuses.Completed => "Completed",
        _ => status
    };
}

