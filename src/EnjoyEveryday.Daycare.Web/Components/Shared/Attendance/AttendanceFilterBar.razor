@using EnjoyEveryday.Domain.Entities

<div class="filters">
    <input class="control" type="date" @bind="SelectedDate" @bind:event="oninput">
    <select class="control" @bind="BranchFilter" @bind:event="oninput">
        <option value="all">All branches</option>
        @foreach (var b in Branches)
        {
            <option value="@b.Name">@b.Name</option>
        }
    </select>
    <select class="control" @bind="TypeFilter" @bind:event="oninput">
        <option value="both">Children &amp; teachers</option>
        <option value="children">Children only</option>
        <option value="teachers">Teachers only</option>
    </select>
    <input class="control search" placeholder="Search branches, classrooms or people..." @bind="SearchQuery" @bind:event="oninput">
</div>

@code {
    private DateTime _selectedDate;
    [Parameter]
    public DateTime SelectedDate 
    { 
        get => _selectedDate;
        set { if (_selectedDate != value) { _selectedDate = value; SelectedDateChanged.InvokeAsync(value); } } 
    }
    [Parameter] public EventCallback<DateTime> SelectedDateChanged { get; set; }

    private string _branchFilter = "all";
    [Parameter]
    public string BranchFilter
    {
        get => _branchFilter;
        set { if (_branchFilter != value) { _branchFilter = value; BranchFilterChanged.InvokeAsync(value); } }
    }
    [Parameter] public EventCallback<string> BranchFilterChanged { get; set; }

    private string _typeFilter = "both";
    [Parameter]
    public string TypeFilter
    {
        get => _typeFilter;
        set { if (_typeFilter != value) { _typeFilter = value; TypeFilterChanged.InvokeAsync(value); } }
    }
    [Parameter] public EventCallback<string> TypeFilterChanged { get; set; }

    private string _searchQuery = "";
    [Parameter]
    public string SearchQuery
    {
        get => _searchQuery;
        set { if (_searchQuery != value) { _searchQuery = value; SearchQueryChanged.InvokeAsync(value); } }
    }
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }

    [Parameter] public IEnumerable<Branch> Branches { get; set; } = Array.Empty<Branch>();
}
