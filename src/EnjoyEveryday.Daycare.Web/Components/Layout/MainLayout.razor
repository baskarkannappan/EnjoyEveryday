@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@implements IDisposable

<FluentLayout>
    <!-- MOBILE ONLY HEADER -->
    <FluentLayoutItem Area="LayoutArea.Header" class="mobile-header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="15">
            <FluentLayoutHamburger @ref="_hamburger" />
            <div style="display: flex; gap: 8px; align-items: center;">
                <div style="width: 24px; height: 24px; border-radius: 0px; background: var(--accent-light); color: var(--accent-dark); display: grid; place-items: center; font-size: 14px;">
                    ✨
                </div>
                <div style="font-weight: 750; font-size: 14px; letter-spacing: -0.5px; color: var(--text);">EnjoyEveryday</div>
            </div>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Width="228px">
        @if (_isSuspended)
        {
            <div style="padding: 24px 16px; height: 100%; display: flex; flex-direction: column; justify-content: space-between; background: var(--surface, #ffffff); border-right: 1px solid var(--border, #e4e7df); box-sizing: border-box;">
                <div>
                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 24px;">
                        <div style="width: 28px; height: 28px; border-radius: 0px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); display: grid; place-items: center; font-size: 14px;">
                            ✨
                        </div>
                        <div style="font-weight: 750; font-size: 14px; letter-spacing: -0.3px; color: var(--text, #26332d);">EnjoyEveryday</div>
                    </div>

                    <div style="background: #fff5f5; border: 1px solid #fed7d7; border-radius: 10px; padding: 14px 12px; color: #9b2c2c; text-align: center;">
                        <div style="font-size: 20px; margin-bottom: 6px;">🔒</div>
                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">Account Locked</div>
                        <div style="font-size: 11px; margin-top: 4px; color: #742a2a; line-height: 1.4;">Operations frozen while suspended.</div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="/select-organization" style="display: block; text-align: center; padding: 10px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 0px; font-size: 12px; font-weight: 700; color: var(--text, #26332d); text-decoration: none;">
                        Switch Org
                    </a>
                    <form method="post" action="/auth/logout" style="margin: 0;">
                        <AntiforgeryToken />
                        <button type="submit" style="width: 100%; padding: 10px; background: #31523c; border: none; border-radius: 0px; font-size: 12px; font-weight: 700; color: #ffffff; cursor: pointer;">
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <CascadingValue Value="CloseMobileMenuAsync" Name="CloseMobileMenu">
                <NavMenu />
            </CascadingValue>
        }
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        <GlobalErrorBoundary>
            @if (_isSuspended)
            {
                <EnjoyEveryday.Daycare.Web.Components.Pages.AccountSuspended />
            }
            else
            {
                @Body
            }
        </GlobalErrorBoundary>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

@code {
    private FluentLayoutHamburger? _hamburger;
    private bool _isDisposed = false;
    private bool _isSuspended = false;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        await CheckSuspensionAsync();
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_isDisposed) return;
        await CloseMobileMenuAsync();
        await CheckSuspensionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckSuspensionAsync()
    {
        if (_isDisposed) return;
        try
        {
            var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].ToLowerInvariant();
            if (uri == "select-organization" || uri == "auth/logout" || uri == "logout")
            {
                _isSuspended = false;
                return;
            }

            var profile = await PageAuth.GetUserProfileAsync();
            _isSuspended = profile.IsOrganizationSuspended && !profile.IsPlatformAdmin;
        }
        catch
        {
            _isSuspended = false;
        }
    }

    private async Task CloseMobileMenuAsync()
    {
        if (_isDisposed) return;
        if (_hamburger is not null)
        {
            try
            {
                await _hamburger.HideAsync();
            }
            catch
            {
                // Ignore if hamburger dialog is not currently open
            }
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
