        background: var(--color-danger, #c53030);
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7);
        animation: nav-badge-pulse 1.8s infinite;
    }

    .nav-unread-badge {
        margin-left: auto;
        background: var(--color-danger, #c53030);
