@* Streamlined Role-Tailored Collapsible Navigation Menu with Multiple Groups & Submenus *@
@using Microsoft.AspNetCore.Components.Authorization
@using EnjoyEveryday.Shared.Authorization
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject EnjoyEveryday.Daycare.Web.Services.DaycareRealtimeNotificationCenter NotificationCenter
@inject EnjoyEveryday.Domain.Repositories.IParentCommunicationRepository CommunicationRepo
@inject EnjoyEveryday.Domain.Repositories.IAccessScopeRepository AccessScopeRepo
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject EnjoyEveryday.Daycare.Web.Services.IUserViewPreferenceService ViewPreference
@inject EnjoyEveryday.Daycare.Web.Services.IBranchOperationalUiGuard BranchUiGuard
@implements IDisposable

<nav class="custom-nav" style="padding: 10px 8px; height: 100%; display: flex; flex-direction: column;">
    
    <div style="flex-grow: 1; overflow-y: auto; padding-right: 3px;">
    
    <!-- BRANDING HEADER -->
    <a href="/" @onclick="HandleNavItemClickAsync" style="text-decoration: none; display: flex; gap: 9px; align-items: center; padding: 6px 8px 10px;">
        <div style="width: 32px; height: 32px; border-radius: 0px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); display: grid; place-items: center; font-size: 16px; box-shadow: 0 2px 6px rgba(85, 124, 108, 0.12);">
            <img src="/images/logo.png" alt="EnjoyEveryday" style="width: 22px; height: 22px; object-fit: contain;" />
        </div>
        <div>
            <div style="font-weight: 800; font-size: 14px; letter-spacing: -0.3px; color: var(--text, #26332d); line-height: 1.2;">EnjoyEveryday</div>
            <div style="font-size: 10px; color: var(--muted, #6c7870); font-weight: 600;">
                @if (_currentNavView == "Teacher")
                {
                    <span>My Classroom</span>
                }
                else if (_currentNavView == "LeadTeacher")
                {
                    <span>Lead Classroom Coordination</span>
                }
                else if (_currentNavView == "BranchAdmin")
                {
                    <span>Branch Operations</span>
                }
                else
                {
                    <span>Organization Management</span>
                }
            </div>
        </div>
    </a>

    <!-- QUICK SEARCH TRIGGER -->
    <button type="button" class="nav-quick-search-btn" @onclick="HandleOpenQuickSearchAsync" title="Quick Search (Ctrl+K)">
        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Custom" CustomColor="var(--muted, #6c7870)" />
        <span class="nav-quick-search-text">Quick search…</span>
        <kbd class="nav-quick-search-kbd">Ctrl K</kbd>
    </button>

    @if (IsBranchUiLocked())
    {
        <div class="nav-branch-closed-pill" title="Unavailable – Branch Closed">
            <span>🔒</span>
            <span>Branch Closed — Operations Locked</span>
        </div>
    }

    @* ========================================================================= *@
    @* DATA-DRIVEN ROLE-TAILORED COLLAPSIBLE NAVIGATION                          *@
    @* ========================================================================= *@
    @foreach (var group in GetActiveNavGroups())
    {
        <div class="nav-group-header" @onclick="() => ToggleGroup(group.Key)">
            <div class="nav-group-header-label">
                <FluentIcon Value="@group.Icon" Width="15px" Color="Color.Custom" CustomColor="@group.Color" />
                <span class="nav-group-header-title">@group.Title</span>
            </div>
            <span class="nav-group-header-chevron">@(IsGroupOpen(group.Key) ? "▾" : "▸")</span>
        </div>
        @if (IsGroupOpen(group.Key))
        {
            <div class="nav-group">
                @foreach (var item in group.Items)
                {
                    @if (item.SubItems is not null && !string.IsNullOrEmpty(item.SubmenuKey))
                    {
                        var submenuKey = item.SubmenuKey;
                        <div class="nav-item nav-submenu-toggle @(IsSubmenuActive(submenuKey) ? "active-parent" : "")" @onclick="() => ToggleSubmenu(submenuKey)">
                            <div style="display: flex; align-items: center; gap: 9px;">
                                @if (item.Icon is not null)
                                {
                                    <FluentIcon Value="@item.Icon" Color="Color.Custom" CustomColor="@item.CustomColor" />
                                }
                                <span>@item.Text</span>
                            </div>
                            <span class="nav-submenu-chevron">@(IsSubmenuOpen(submenuKey) ? "▾" : "▸")</span>
                        </div>
                        @if (IsSubmenuOpen(submenuKey))
                        {
                            <div class="nav-submenu-group" @onclick="HandleNavItemClickAsync">
                                @foreach (var sub in item.SubItems)
                                {
                                    <AppNavLink Href="@sub.Href" Text="@sub.Text" IsSubmenuItem="true" OnClick="HandleNavItemClickAsync" />
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <AppNavLink Href="@item.Href"
                                    Text="@item.Text"
                                    Icon="@item.Icon"
                                    CustomColor="@item.CustomColor"
                                    Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                    IsLocked="@(item.CheckBranchLock && IsNavLocked(item.Href))"
                                    BadgeCount="@GetBadgeCount(item.BadgeKey)"
                                    OnClick="HandleNavItemClickAsync" />
                    }
                }
            </div>
        }
    }

    </div>
    
    <!-- USER PROFILE SECTION WITH VIEW SWITCHER -->
    <AuthorizeView>
        <Authorized>
            @{
                var userName = !string.IsNullOrWhiteSpace(_userDisplayName)
                    ? _userDisplayName
                    : (context.User.Identity?.Name 
                    ?? context.User.FindFirst("DisplayName")?.Value 
                    ?? UserContext.Email 
                    ?? "Educator");
                var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpper() : "E";
            }
            <div class="nav-profile-footer">
                <div class="nav-profile-row" @onclick="HandleNavItemClickAsync">
                    <!-- Avatar and user info -->
                    <a href="/profile" class="nav-profile-info" title="View Profile">
                        <div class="nav-profile-avatar">
                            @initial
                        </div>
                        <div class="nav-profile-meta">
                            <span class="nav-profile-name" title="@userName">@userName</span>
                            <span class="nav-profile-role">@(_currentNavView == "OrgAdmin" ? "Org Admin" : _currentNavView == "BranchAdmin" ? "Branch Admin" : _currentNavView == "LeadTeacher" ? "Lead Teacher" : "Educator")</span>
                        </div>
                    </a>

                    <!-- Action buttons -->
                    <div class="nav-profile-actions">
                        @if (_assignedBranchIds.Count > 1)
                        {
                            <a href="/select-branch" 
                               title="Switch Branch" 
                               class="nav-action-btn">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Building())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                            </a>
                        }
                        <a href="/select-organization" 
                           title="Switch Organization" 
                           class="nav-action-btn">
                            <FluentIcon Value="@(new Icons.Regular.Size16.BuildingSwap())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                        </a>
                        <a href="/auth/logout" 
                           data-enhance-nav="false" 
                           title="Sign Out" 
                           class="nav-action-btn nav-signout-btn">
                            <FluentIcon Value="@(new Icons.Regular.Size20.SignOut())" Color="Color.Custom" CustomColor="#dc2626" Width="15px" />
                        </a>
                    </div>
                </div>

                @if (_availableViewsCount > 1)
                {
                    <div class="nav-view-switcher">
                        <label for="nav-view-select" class="nav-view-label">View:</label>
                        <select id="nav-view-select" class="nav-view-select" @onchange="HandleSwitchView">
                            @if (_availableViews.Contains("Teacher"))
                            {
                                <option value="/?view=teacher" selected="@(_currentNavView == "Teacher")">Educator</option>
                            }
                            @if (_availableViews.Contains("LeadTeacher"))
                            {
                                <option value="/?view=leadteacher" selected="@(_currentNavView == "LeadTeacher")">Lead Teacher</option>
                            }
                            @if (_availableViews.Contains("BranchAdmin"))
                            {
                                <option value="/?view=branchadmin" selected="@(_currentNavView == "BranchAdmin")">Branch Admin</option>
                            }
                            @if (_availableViews.Contains("OrgAdmin"))
                            {
                                <option value="/?view=orgadmin" selected="@(_currentNavView == "OrgAdmin")">Org Admin</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

<style>
    .nav-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 9px 10px 8px 10px;
        margin-top: 6px;
        cursor: pointer;
        user-select: none;
        border-radius: 6px;
        border-top: 1px solid rgba(228, 231, 223, 0.75);
        transition: background 0.15s ease, color 0.15s ease;
        -webkit-tap-highlight-color: transparent;
        min-height: 38px;
        box-sizing: border-box;
    }

    .nav-group-header:hover {
        background: rgba(82, 116, 94, 0.08);
    }

    .nav-group-header:active {
        background: rgba(82, 116, 94, 0.14);
    }

    .nav-group-header-label {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 0;
    }

    .nav-group-header-title {
        font-size: 12px !important;
        font-weight: 700 !important;
        text-transform: none !important;
        letter-spacing: 0.2px !important;
        color: var(--muted, #6c7870) !important;
        margin: 0 !important;
        line-height: 1.2;
    }

    .nav-group-header:hover .nav-group-header-title,
    .nav-group-header:hover .nav-group-header-chevron {
        color: var(--accent-dark, #31523c) !important;
    }

    .nav-group-header-chevron {
        font-size: 11px;
        color: var(--muted, #6c7870);
        font-weight: 700;
        padding: 4px 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .nav-group {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-bottom: 4px;
        padding-bottom: 2px;
    }

    .custom-nav .nav-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 10px;
        min-height: 36px;
        box-sizing: border-box;
        border-radius: 6px;
        color: var(--text, #26332d);
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .custom-nav .nav-item:hover {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
    }

    .custom-nav .nav-item:focus-visible {
        outline: 2px solid var(--accent, #52745e);
        outline-offset: 1px;
    }

    .custom-nav .nav-item.active {
        background: var(--accent-light, #e6eee9) !important;
        color: var(--accent-dark, #31523c) !important;
        font-weight: 600;
    }

    /* Submenu Parent & Toggle */
    .nav-submenu-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between !important;
        cursor: pointer;
        user-select: none;
        padding: 7px 10px;
        min-height: 36px;
        box-sizing: border-box;
        border-radius: 6px;
        -webkit-tap-highlight-color: transparent;
    }

    .nav-submenu-toggle.active-parent {
        color: var(--accent-dark, #31523c);
        font-weight: 600;
    }

    .nav-submenu-chevron {
        font-size: 11px;
        color: var(--muted, #6c7870);
        font-weight: 700;
        margin-left: auto;
        padding: 4px 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .nav-submenu-group {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-left: 18px;
        padding-left: 10px;
        border-left: 1.5px solid var(--border, #e4e7df);
        margin-top: 1px;
        margin-bottom: 5px;
    }

    .custom-nav .nav-sub-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 8px;
        min-height: 34px;
        box-sizing: border-box;
        border-radius: 6px;
        color: var(--text, #26332d);
        font-size: 11.5px;
        font-weight: 400;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .custom-nav .nav-sub-item:hover {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
    }

    .custom-nav .nav-sub-item.active {
        background: var(--accent-light, #e6eee9) !important;
        color: var(--accent-dark, #31523c) !important;
        font-weight: 600;
    }

    .nav-unread-dot {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 8px;
        height: 8px;
        background: var(--color-danger, #c53030);
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7);
        animation: nav-badge-pulse 1.8s infinite;
    }

    .nav-unread-badge {
        margin-left: auto;
        background: var(--color-danger, #c53030);
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        padding: 1px 7px;
        border-radius: 999px;
        box-shadow: 0 1px 4px rgba(197, 48, 48, 0.3);
    }

    @@keyframes nav-badge-pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7); }
        70% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(197, 48, 48, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0); }
    }

    /* Redesigned Profile Footer & View Switcher */
    .nav-profile-footer {
        border-top: 1px solid rgba(228, 231, 223, 0.75);
        padding-top: 10px;
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex-shrink: 0;
    }

    .nav-profile-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
    }

    .nav-profile-info {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        min-width: 0;
        flex: 1;
        border-radius: 8px;
        padding: 3px 4px;
        transition: background 0.15s ease;
    }

    .nav-profile-info:hover {
        background: rgba(82, 116, 94, 0.08);
    }

    .nav-profile-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        display: grid;
        place-items: center;
        font-size: 13.5px;
        font-weight: 750;
        border: 1.5px solid #c8dacd;
        flex-shrink: 0;
    }

    .nav-profile-meta {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
    }

    .nav-profile-name {
        font-size: 11.5px;
        font-weight: 750;
        color: var(--text, #26332d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.25;
    }

    .nav-profile-role {
        font-size: 9.5px;
        font-weight: 600;
        color: var(--muted, #6c7870);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
    }

    .nav-profile-actions {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
    }

    .nav-action-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        display: grid;
        place-items: center;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .nav-action-btn:hover {
        background: var(--accent-light, #e6eee9);
        border-color: var(--accent, #52745e);
    }

    .nav-signout-btn {
        background: #fff5f5;
        border-color: #fecaca;
    }

    .nav-signout-btn:hover {
        background: #fee2e2;
        border-color: #f87171;
    }

    .nav-view-switcher {
        display: flex;
        align-items: center;
        gap: 6px;
        padding-top: 6px;
        border-top: 1px dashed var(--border, #e4e7df);
    }

    .nav-view-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--muted, #6c7870);
        flex-shrink: 0;
        text-transform: none;
        letter-spacing: 0.2px;
    }

    .nav-view-select {
        flex: 1;
        min-width: 0;
        border: 1px solid var(--border, #e4e7df);
        border-radius: 6px;
        padding: 3px 6px;
        font-size: 11px;
        font-weight: 700;
        color: var(--accent-dark, #31523c);
        background: var(--surface-soft, #f8f9f5);
        cursor: pointer;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .nav-view-select:hover, .nav-view-select:focus {
        border-color: var(--accent, #52745e);
    }

    .nav-quick-search-btn {
        display: flex;
        align-items: center;
        gap: 7px;
        width: 100%;
        padding: 7px 9px;
        margin: 0 0 6px 0;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 8px;
        cursor: pointer;
        color: var(--muted, #6c7870);
        font-size: 11.5px;
        font-weight: 500;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

    .nav-quick-search-btn:hover {
        background: var(--accent-light, #e6eee9);
        border-color: #c8dacd;
        color: var(--accent-dark, #31523c);
    }

    .nav-quick-search-text {
        flex: 1;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nav-quick-search-kbd {
        font-size: 9.5px;
        font-weight: 700;
        padding: 1px 5px;
        border-radius: 4px;
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        color: var(--muted, #6c7870);
    }
</style>


@code {
    private RenderFragment LockedNavItem(string label) =>
        @<span class="nav-item nav-item-locked" title="Unavailable – Branch Closed" aria-disabled="true">
            <span class="nav-lock-icon" aria-hidden="true">🔒</span>
            <span>@label</span>
        </span>;
}
