<style>
    .nav-section-label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-section-label fluent-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .nav-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 7px 8px 5px 8px;
        margin-top: 6px;
        cursor: pointer;
        user-select: none;
        border-radius: 0px;
        border-top: 1px solid rgba(228, 231, 223, 0.75);
        transition: background 0.15s ease;
    }

    .nav-section-header:hover {
        background: rgba(82, 116, 94, 0.08);
    }

    .nav-section-header:hover .nav-section-title,
    .nav-section-header:hover .nav-section-chevron {
        color: var(--accent-dark, #31523c) !important;
    }

    .nav-section-header:hover .nav-section-label fluent-icon {
        transform: scale(1.08);
        transition: transform 0.15s ease;
    }

    .nav-section-title {
        color: var(--muted, #6c7870);
        font-size: 11.5px !important;
        font-weight: 700 !important;
        letter-spacing: 0.2px !important;
        text-transform: none !important;
        margin: 0 !important;
    }

    .nav-section-chevron {
        font-size: 10px;
        color: var(--muted, #6c7870);
        font-weight: 700;
    }

    .nav-group {
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin-bottom: 6px;
        padding-bottom: 2px;
    }

    .custom-nav .nav-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 6px 10px;
        border-radius: 0px;
        color: var(--text, #26332d);
        font-size: 12px;
        font-weight: 400;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .custom-nav .nav-item:hover {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
    }

    .custom-nav .nav-item:focus-visible {
        outline: 2px solid var(--accent, #52745e);
        outline-offset: 1px;
    }

    .custom-nav .nav-item.active {
        background: var(--accent-light, #e6eee9) !important;
        color: var(--accent-dark, #31523c) !important;
        font-weight: 400;
    }

    .nav-unread-dot {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 8px;
        height: 8px;
        background: var(--color-danger, #c53030);
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7);
        animation: nav-badge-pulse 1.8s infinite;
    }

    .nav-unread-badge {
        margin-left: auto;
        background: var(--color-danger, #c53030);
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        padding: 1px 7px;
        border-radius: 999px;
        box-shadow: 0 1px 4px rgba(197, 48, 48, 0.3);
    }

    @@keyframes nav-badge-pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7); }
        70% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(197, 48, 48, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0); }
    }

    /* Redesigned Profile Footer & View Switcher */
    .nav-profile-footer {
        border-top: 1px solid rgba(228, 231, 223, 0.75);
        padding-top: 10px;
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex-shrink: 0;
    }

    .nav-profile-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
    }

    .nav-profile-info {
        display: flex;
        align-items: center;
        gap: 8px;
