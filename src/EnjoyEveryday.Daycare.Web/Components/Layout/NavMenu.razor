        background: rgba(82, 116, 94, 0.08);
    }

    .nav-profile-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        display: grid;
        place-items: center;
        font-size: 13.5px;
        font-weight: 750;
        border: 1.5px solid #c8dacd;
