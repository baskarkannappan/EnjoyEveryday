                <AppNavLink Href="/announcements" Text="Daycare Announcements" Icon="@(new Icons.Regular.Size20.Megaphone())" CustomColor="#ea580c" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/stories" Text="Family Stories &amp; Feedback" Icon="@(new Icons.Regular.Size20.Chat())" CustomColor="#0284c7" OnClick="HandleNavItemClickAsync" />
            </div>
        }

        <!-- GROUP 8: BUSINESS & SETTINGS -->
        <div class="nav-group-header" @onclick='() => ToggleGroup("org_business")'>
            <div class="nav-group-header-label">
                <FluentIcon Value="@(new Icons.Regular.Size20.Receipt())" Width="15px" Color="Color.Custom" CustomColor="#b47836" />
                <span class="nav-group-header-title">Business &amp; Settings</span>
            </div>
            <span class="nav-group-header-chevron">@(IsGroupOpen("org_business") ? "▾" : "▸")</span>
        </div>
        @if (IsGroupOpen("org_business"))
        {
            <div class="nav-group" @onclick="HandleNavItemClickAsync">
                <AppNavLink Href="/management/billing" Text="Parent Billing &amp; Invoices" Icon="@(new Icons.Regular.Size20.Receipt())" CustomColor="#059669" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/management/fee-reports" Text="Fee &amp; Payment Reports" Icon="@(new Icons.Regular.Size20.DataTrending())" CustomColor="#059669" OnClick="HandleNavItemClickAsync" />
                @if (_isOrgAdmin)
                {
                <AppNavLink Href="/management/payment-gateway" Text="Payment Gateway (Razorpay)" Icon="@(new Icons.Regular.Size20.Payment())" CustomColor="#31523c" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/management/platform-billing" Text="Platform Billing" Icon="@(new Icons.Regular.Size20.Building())" CustomColor="#52745e" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/management/subscription" Text="Subscription &amp; Plans" Icon="@(new Icons.Regular.Size20.Ribbon())" CustomColor="#31523c" OnClick="HandleNavItemClickAsync" />
                }
                <AppNavLink Href="/billing/reports" Text="Financial Reports" Icon="@(new Icons.Regular.Size20.ChartMultiple())" CustomColor="#0891b2" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/audit" Text="Account Book &amp; Audit" Icon="@(new Icons.Regular.Size20.Book())" CustomColor="#475569" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/organization/settings" Text="Organization Settings" Icon="@(new Icons.Regular.Size20.Settings())" CustomColor="#4b5563" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/organization/profile-customizer" Text="Customize About &amp; Contact" Icon="@(new Icons.Regular.Size20.Edit())" CustomColor="#52745e" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/organization/inquiries" Text="Received Inquiries" Icon="@(new Icons.Regular.Size20.Mail())" CustomColor="#31523c" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/organization/branch-info" Text="Campus Info &amp; About Us" Icon="@(new Icons.Regular.Size20.Building())" CustomColor="#059669" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/organization/storage-metrics" Text="Storage &amp; Media Explorer" Icon="@(new Icons.Regular.Size20.Storage())" CustomColor="#0d9488" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/settings/ai-agents" Text="AI Agent Settings" Icon="@(new Icons.Regular.Size20.Bot())" CustomColor="#7c3aed" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/profile" Text="My Profile" Icon="@(new Icons.Regular.Size20.Person())" CustomColor="#6366f1" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/support" Text="Help &amp; Support" Icon="@(new Icons.Regular.Size20.QuestionCircle())" CustomColor="#0ea5e9" OnClick="HandleNavItemClickAsync" />
                <AppNavLink Href="/version" Text="Version &amp; Releases" Icon="@(new Icons.Regular.Size20.Info())" CustomColor="#52745e" OnClick="HandleNavItemClickAsync" />
            </div>
        }
    }

    </div>
    
    <!-- USER PROFILE SECTION WITH VIEW SWITCHER -->
    <AuthorizeView>
        <Authorized>
            @{
                var userName = !string.IsNullOrWhiteSpace(_userDisplayName)
                    ? _userDisplayName
                    : (context.User.Identity?.Name 
                    ?? context.User.FindFirst("DisplayName")?.Value 
                    ?? UserContext.Email 
                    ?? "Educator");
                var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpper() : "E";
            }
            <div class="nav-profile-footer">
                <div class="nav-profile-row" @onclick="HandleNavItemClickAsync">
                    <!-- Avatar and user info -->
                    <a href="/profile" class="nav-profile-info" title="View Profile">
                        <div class="nav-profile-avatar">
                            @initial
                        </div>
                        <div class="nav-profile-meta">
                            <span class="nav-profile-name" title="@userName">@userName</span>
                            <span class="nav-profile-role">@(_currentNavView == "OrgAdmin" ? "Org Admin" : _currentNavView == "BranchAdmin" ? "Branch Admin" : _currentNavView == "LeadTeacher" ? "Lead Teacher" : "Educator")</span>
                        </div>
                    </a>

                    <!-- Action buttons -->
                    <div class="nav-profile-actions">
                        @if (_assignedBranchIds.Count > 1)
                        {
                            <a href="/select-branch" 
                               title="Switch Branch" 
                               class="nav-action-btn">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Building())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                            </a>
                        }
                        <a href="/select-organization" 
                           title="Switch Organization" 
                           class="nav-action-btn">
                            <FluentIcon Value="@(new Icons.Regular.Size16.BuildingSwap())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                        </a>
                        <a href="/auth/logout" 
                           data-enhance-nav="false" 
                           title="Sign Out" 
                           class="nav-action-btn nav-signout-btn">
                            <FluentIcon Value="@(new Icons.Regular.Size20.SignOut())" Color="Color.Custom" CustomColor="#dc2626" Width="15px" />
                        </a>
                    </div>
                </div>

                @if (_availableViewsCount > 1)
                {
                    <div class="nav-view-switcher">
                        <label for="nav-view-select" class="nav-view-label">View:</label>
                        <select id="nav-view-select" class="nav-view-select" @onchange="HandleSwitchView">
                            @if (_availableViews.Contains("Teacher"))
                            {
                                <option value="/?view=teacher" selected="@(_currentNavView == "Teacher")">Educator</option>
                            }
                            @if (_availableViews.Contains("LeadTeacher"))
                            {
                                <option value="/?view=leadteacher" selected="@(_currentNavView == "LeadTeacher")">Lead Teacher</option>
                            }
                            @if (_availableViews.Contains("BranchAdmin"))
                            {
                                <option value="/?view=branchadmin" selected="@(_currentNavView == "BranchAdmin")">Branch Admin</option>
                            }
                            @if (_availableViews.Contains("OrgAdmin"))
                            {
                                <option value="/?view=orgadmin" selected="@(_currentNavView == "OrgAdmin")">Org Admin</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

<style>
    .nav-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 7px 8px 6px 8px;
        margin-top: 6px;
        cursor: pointer;
        user-select: none;
        border-radius: 0px;
        border-top: 1px solid rgba(228, 231, 223, 0.75);
        transition: background 0.15s ease;
    }

    .nav-group-header:hover {
        background: rgba(82, 116, 94, 0.08);
    }

    .nav-group-header-label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-group-header-title {
        font-size: 11.5px !important;
        font-weight: 700 !important;
        text-transform: none !important;
        letter-spacing: 0.2px !important;
        color: var(--muted, #6c7870) !important;
        margin: 0 !important;
        line-height: 1.2;
    }

    .nav-group-header:hover .nav-group-header-title,
    .nav-group-header:hover .nav-group-header-chevron {
        color: var(--accent-dark, #31523c) !important;
    }

    .nav-group-header-chevron {
        font-size: 10px;
        color: var(--muted, #6c7870);
        font-weight: 700;
    }

    .nav-group {
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin-bottom: 4px;
        padding-bottom: 2px;
    }

    .custom-nav .nav-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 6px 10px;
        border-radius: 0px;
        color: var(--text, #26332d);
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .custom-nav .nav-item:hover {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
    }

    .custom-nav .nav-item:focus-visible {
        outline: 2px solid var(--accent, #52745e);
        outline-offset: 1px;
    }

    .custom-nav .nav-item.active {
        background: var(--accent-light, #e6eee9) !important;
        color: var(--accent-dark, #31523c) !important;
        font-weight: 600;
    }

    /* Submenu Parent & Toggle */
    .nav-submenu-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between !important;
        cursor: pointer;
        user-select: none;
    }

    .nav-submenu-toggle.active-parent {
        color: var(--accent-dark, #31523c);
        font-weight: 600;
    }

    .nav-submenu-chevron {
        font-size: 10px;
        color: var(--muted, #6c7870);
        font-weight: 700;
        margin-left: auto;
    }

    .nav-submenu-group {
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin-left: 18px;
        padding-left: 10px;
        border-left: 1.5px solid var(--border, #e4e7df);
        margin-top: 1px;
        margin-bottom: 5px;
    }

    .custom-nav .nav-sub-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px;
        border-radius: 0px;
        color: var(--text, #26332d);
        font-size: 11.5px;
        font-weight: 400;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .custom-nav .nav-sub-item:hover {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
    }

    .custom-nav .nav-sub-item.active {
        background: var(--accent-light, #e6eee9) !important;
        color: var(--accent-dark, #31523c) !important;
        font-weight: 600;
    }

    .nav-unread-dot {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 8px;
        height: 8px;
        background: var(--color-danger, #c53030);
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7);
        animation: nav-badge-pulse 1.8s infinite;
    }

    .nav-unread-badge {
        margin-left: auto;
        background: var(--color-danger, #c53030);
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        padding: 1px 7px;
        border-radius: 999px;
        box-shadow: 0 1px 4px rgba(197, 48, 48, 0.3);
    }

    @@keyframes nav-badge-pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7); }
        70% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(197, 48, 48, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0); }
    }

    /* Redesigned Profile Footer & View Switcher */
    .nav-profile-footer {
        border-top: 1px solid rgba(228, 231, 223, 0.75);
        padding-top: 10px;
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex-shrink: 0;
    }

    .nav-profile-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
    }

    .nav-profile-info {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        min-width: 0;
        flex: 1;
        border-radius: 8px;
        padding: 3px 4px;
        transition: background 0.15s ease;
    }

    .nav-profile-info:hover {
        background: rgba(82, 116, 94, 0.08);
    }

    .nav-profile-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        display: grid;
        place-items: center;
        font-size: 13.5px;
        font-weight: 750;
        border: 1.5px solid #c8dacd;
        flex-shrink: 0;
    }

    .nav-profile-meta {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
    }

    .nav-profile-name {
        font-size: 11.5px;
        font-weight: 750;
        color: var(--text, #26332d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.25;
    }

    .nav-profile-role {
        font-size: 9.5px;
        font-weight: 600;
        color: var(--muted, #6c7870);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
    }

    .nav-profile-actions {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
    }

    .nav-action-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        display: grid;
        place-items: center;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .nav-action-btn:hover {
        background: var(--accent-light, #e6eee9);
        border-color: var(--accent, #52745e);
    }

    .nav-signout-btn {
        background: #fff5f5;
        border-color: #fecaca;
    }

    .nav-signout-btn:hover {
        background: #fee2e2;
        border-color: #f87171;
    }

    .nav-view-switcher {
        display: flex;
        align-items: center;
        gap: 6px;
        padding-top: 6px;
        border-top: 1px dashed var(--border, #e4e7df);
    }

    .nav-view-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--muted, #6c7870);
        flex-shrink: 0;
        text-transform: none;
        letter-spacing: 0.2px;
    }

    .nav-view-select {
        flex: 1;
        min-width: 0;
        border: 1px solid var(--border, #e4e7df);
        border-radius: 6px;
        padding: 3px 6px;
        font-size: 11px;
        font-weight: 700;
        color: var(--accent-dark, #31523c);
        background: var(--surface-soft, #f8f9f5);
        cursor: pointer;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .nav-view-select:hover, .nav-view-select:focus {
        border-color: var(--accent, #52745e);
    }
</style>


@code {
    private RenderFragment LockedNavItem(string label) =>
        @<span class="nav-item nav-item-locked" title="Unavailable – Branch Closed" aria-disabled="true">
            <span class="nav-lock-icon" aria-hidden="true">🔒</span>
            <span>@label</span>
        </span>;
}
