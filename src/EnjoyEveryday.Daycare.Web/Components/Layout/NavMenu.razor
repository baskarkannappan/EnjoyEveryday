@code {
    [CascadingParameter(Name = "CloseMobileMenu")]
    public Func<Task>? CloseMobileMenu { get; set; }

    private bool _isDisposed = false;

    private async Task HandleNavItemClickAsync()
    {
        if (_isDisposed) return;
        if (CloseMobileMenu is not null)
        {
            try
            {
                await CloseMobileMenu.Invoke();
            }
            catch
            {
                // Ignore if mobile drawer is already closed or closing
            }
        }
    }

    // Teacher section toggles - collapsed by default
    private bool _teacherMyDayOpen = false;
    private bool _teacherChildrenOpen = false;
    private bool _teacherExperiencesOpen = false;
    private bool _teacherFamilyOpen = false;
    private bool _teacherSafetyOpen = false;
    private bool _teacherAccountOpen = false;

    // Branch Admin section toggles - collapsed by default
    private bool _branchOpsOpen = false;
    private bool _branchPeopleOpen = false;
    private bool _branchCareOpen = false;
    private bool _branchMgmtOpen = false;
    private bool _branchAccountOpen = false;

    // Org Admin section toggles - collapsed by default
    private bool _orgOverviewOpen = false;
    private bool _orgOrgOpen = false;
    private bool _orgOpsOpen = false;
    private bool _orgFinanceOpen = false;
    private bool _orgConfigOpen = false;
    private bool _orgAccountOpen = false;

    private int _chatUnreadCount = 0;

    private bool _leadCoordOpen = false;

    // Roles and Scopes
    private bool _isOrgAdmin = false;
    private bool _isBranchAdmin = false;
    private bool _isLeadTeacher = false;
    private bool _isTeacher = false;
    private List<string> _availableViews = new();
    private int _availableViewsCount = 0;
    private string _currentNavView = "Teacher";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        ViewPreference.OnViewChanged += HandlePreferenceViewChanged;
        await ResolveNavigationScopeAsync();
        AutoExpandCurrentRoute();

        NotificationCenter.OnParentMessageReceived += HandleIncomingMessage;
        NotificationCenter.OnMessagesRead += HandleMessagesRead;

        try
        {
            _chatUnreadCount = await CommunicationRepo.GetUnreadCountForEducatorAsync(TenantContext.TenantId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] Error loading unread count: {ex.Message}");
        }
    }

    private async void HandlePreferenceViewChanged()
    {
        if (_isDisposed) return;
        try
        {
            await ResolveNavigationScopeAsync();
            if (!_isDisposed)
            {
                await InvokeAsync(() =>
                {
                    if (!_isDisposed)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // Component or service scope is disposed in mobile view
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] HandlePreferenceViewChanged ignored: {ex.Message}");
        }
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_isDisposed) return;
        try
        {
            await ResolveNavigationScopeAsync();
            AutoExpandCurrentRoute();
            if (!_isDisposed)
            {
                await InvokeAsync(() =>
                {
                    if (!_isDisposed)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // Component or service scope is disposed in mobile view
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] HandleLocationChanged ignored: {ex.Message}");
        }
    }

    private async Task ResolveNavigationScopeAsync()
    {
        if (_isDisposed) return;
        try
        {
            var profile = await PageAuth.GetUserProfileAsync();
            if (_isDisposed) return;

            _isOrgAdmin = profile.IsOrgAdmin;
            _isBranchAdmin = profile.IsBranchAdmin;
            _isLeadTeacher = profile.IsLeadTeacher;
            _isTeacher = profile.IsTeacher;
            _availableViews = profile.AvailableViews;
            _availableViewsCount = _availableViews.Count;

            // 1. Detect active view from URL query if present and authorized
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var v))
            {
                var requested = v.ToString();
                var match = _availableViews.FirstOrDefault(x => x.Equals(requested, StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    _currentNavView = match;
                    ViewPreference.SetCurrentView(match);
                    return;
                }
            }

            // 2. Active Session Preference (persisted across menu clicks!)
            if (!string.IsNullOrEmpty(ViewPreference.CurrentView))
            {
                var match = _availableViews.FirstOrDefault(x => x.Equals(ViewPreference.CurrentView, StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    _currentNavView = match;
                    return;
                }
            }

            // 3. Safe authorized default view (Role Hierarchy fallback)
            if (_isOrgAdmin) _currentNavView = "OrgAdmin";
            else if (_isBranchAdmin) _currentNavView = "BranchAdmin";
            else if (_isLeadTeacher) _currentNavView = "LeadTeacher";
            else _currentNavView = "Teacher";

            ViewPreference.SetCurrentView(_currentNavView);
        }
        catch (ObjectDisposedException)
        {
            // Scope disposed
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] Error in ResolveNavigationScopeAsync: {ex.Message}");
            if (!_isDisposed)
            {
                _currentNavView = "OrgAdmin";
            }
        }
    }

    private void HandleSwitchView(ChangeEventArgs e)
    {
        if (_isDisposed) return;
        var targetUrl = e.Value?.ToString() ?? "/";
        var uri = NavigationManager.ToAbsoluteUri(targetUrl);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var v))
        {
            var requested = v.ToString();
            var match = _availableViews.FirstOrDefault(x => x.Equals(requested, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                ViewPreference.SetCurrentView(match);
                _currentNavView = match;
            }
        }
        NavigationManager.NavigateTo(targetUrl, forceLoad: false);
    }

    private async Task HandleIncomingMessage(EnjoyEveryday.Application.Services.ParentMessageNotification notification)
    {
        if (_isDisposed) return;
        try
        {
            _chatUnreadCount++;
            if (!_isDisposed)
            {
                await InvokeAsync(() =>
                {
                    if (!_isDisposed)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (ObjectDisposedException) { }
    }

    private async Task HandleMessagesRead(Guid childId)
    {
        if (_isDisposed) return;
        try
        {
            try
            {
                _chatUnreadCount = await CommunicationRepo.GetUnreadCountForEducatorAsync(TenantContext.TenantId);
            }
            catch
            {
                _chatUnreadCount = Math.Max(0, _chatUnreadCount - 1);
            }

            if (!_isDisposed)
            {
                await InvokeAsync(() =>
                {
                    if (!_isDisposed)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _isDisposed = true;
        NavigationManager.LocationChanged -= HandleLocationChanged;
        ViewPreference.OnViewChanged -= HandlePreferenceViewChanged;
        NotificationCenter.OnParentMessageReceived -= HandleIncomingMessage;
        NotificationCenter.OnMessagesRead -= HandleMessagesRead;
    }

    private void ToggleSection(string sectionName)
    {
        switch (sectionName)
        {
            // Teacher sections
            case nameof(_teacherMyDayOpen):
                _teacherMyDayOpen = !_teacherMyDayOpen;
                break;
            case nameof(_teacherChildrenOpen):
                _teacherChildrenOpen = !_teacherChildrenOpen;
                break;
            case nameof(_teacherExperiencesOpen):
                _teacherExperiencesOpen = !_teacherExperiencesOpen;
                break;
            case nameof(_teacherFamilyOpen):
                _teacherFamilyOpen = !_teacherFamilyOpen;
                break;
            case nameof(_teacherSafetyOpen):
                _teacherSafetyOpen = !_teacherSafetyOpen;
                break;
            case nameof(_teacherAccountOpen):
                _teacherAccountOpen = !_teacherAccountOpen;
                break;

            // Branch Admin sections
            case nameof(_branchOpsOpen):
                _branchOpsOpen = !_branchOpsOpen;
                break;
            case nameof(_branchPeopleOpen):
                _branchPeopleOpen = !_branchPeopleOpen;
                break;
            case nameof(_branchCareOpen):
                _branchCareOpen = !_branchCareOpen;
                break;
            case nameof(_branchMgmtOpen):
                _branchMgmtOpen = !_branchMgmtOpen;
                break;
            case nameof(_branchAccountOpen):
                _branchAccountOpen = !_branchAccountOpen;
                break;

            // Org Admin sections
            case nameof(_orgOverviewOpen):
                _orgOverviewOpen = !_orgOverviewOpen;
                break;
            case nameof(_orgOrgOpen):
                _orgOrgOpen = !_orgOrgOpen;
                break;
            case nameof(_orgOpsOpen):
                _orgOpsOpen = !_orgOpsOpen;
                break;
            case nameof(_orgFinanceOpen):
                _orgFinanceOpen = !_orgFinanceOpen;
                break;
            case nameof(_orgConfigOpen):
                _orgConfigOpen = !_orgConfigOpen;
                break;
            case nameof(_orgAccountOpen):
                _orgAccountOpen = !_orgAccountOpen;
                break;
        }
    }

    private void AutoExpandCurrentRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();

        if (relativePath.StartsWith("management/billing") || relativePath.StartsWith("billing"))
        {
            _orgFinanceOpen = true;
        }
        else if (relativePath.StartsWith("experiences") || relativePath.StartsWith("planning") || relativePath.StartsWith("studio") || relativePath.StartsWith("events"))
        {
            _teacherExperiencesOpen = true;
            _branchCareOpen = true;
            _orgOpsOpen = true;
        }
        else if (relativePath.StartsWith("enrollment"))
        {
            _branchMgmtOpen = true;
            _orgFinanceOpen = true;
        }
        else if (relativePath.StartsWith("journey") || relativePath.StartsWith("memories"))
        {
            _teacherChildrenOpen = true;
            _branchCareOpen = true;
            _orgOpsOpen = true;
        }
        else if (relativePath.StartsWith("children") || relativePath.StartsWith("classrooms") || relativePath.StartsWith("teachers") || relativePath.StartsWith("users"))
        {
            _teacherChildrenOpen = true;
            _branchPeopleOpen = true;
            _orgOrgOpen = true;
            _orgOpsOpen = true;
        }
        else if (relativePath.StartsWith("organization") || relativePath.StartsWith("roles"))
        {
            _branchMgmtOpen = true;
            _orgOrgOpen = true;
        }
        else if (relativePath.StartsWith("settings") || relativePath.StartsWith("safety") || relativePath.StartsWith("policies") || relativePath.StartsWith("audit"))
        {
            _teacherSafetyOpen = true;
            _branchOpsOpen = true;
            _branchMgmtOpen = true;
            _orgConfigOpen = true;
        }
        else if (relativePath.StartsWith("classroom-messages") || relativePath.StartsWith("notifications"))
        {
            _teacherFamilyOpen = true;
            _branchCareOpen = true;
            _orgOpsOpen = true;
        }
        else if (relativePath.StartsWith("profile") || relativePath.StartsWith("support"))
        {
            _teacherAccountOpen = true;
            _branchAccountOpen = true;
            _orgAccountOpen = true;
        }
        // When at root or empty path, keep sections collapsed by default as requested
    }
}
