@* Streamlined Daycare Workflow Navigation Menu *@
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject EnjoyEveryday.Daycare.Web.Services.DaycareRealtimeNotificationCenter NotificationCenter
@inject EnjoyEveryday.Domain.Repositories.IParentCommunicationRepository CommunicationRepo
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@implements IDisposable

<nav class="custom-nav" style="padding: 10px 8px; height: 100%; display: flex; flex-direction: column;">
    
    <div style="flex-grow: 1; overflow-y: auto; padding-right: 3px;">
    
    <!-- BRANDING HEADER -->
    <a href="/" style="text-decoration: none; display: flex; gap: 9px; align-items: center; padding: 6px 8px 12px;">
        <div style="width: 32px; height: 32px; border-radius: 9px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 16px; box-shadow: 0 2px 6px rgba(85, 124, 108, 0.12);">
            ✨
        </div>
        <div>
            <div style="font-weight: 800; font-size: 14px; letter-spacing: -0.3px; color: var(--text, #26332d); line-height: 1.2;">EnjoyEveryday</div>
            <div style="font-size: 10px; color: var(--muted, #6c7870); font-weight: 500;">Daycare Management</div>
        </div>
    </a>

    @* ================= SECTION 1: DAILY CARE & ATTENDANCE ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_dailyOpen))">
        <span class="nav-section-title">DAILY CARE</span>
        <span class="nav-section-chevron">@(_dailyOpen ? "▾" : "▸")</span>
    </div>

    @if (_dailyOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                <FluentIcon Value="@(new Icons.Regular.Size20.WeatherSunny())" Color="Color.Custom" CustomColor="#b47836" />
                <span>Today's Overview</span>
            </NavLink>
            <NavLink class="nav-item" href="/daily-care" Match="NavLinkMatch.Prefix">
                <FluentIcon Value="@(new Icons.Regular.Size20.Heart())" Color="Color.Custom" CustomColor="#b85d43" />
                <span>Child Daily Care</span>
            </NavLink>
            <NavLink class="nav-item" href="/management/attendance" Match="NavLinkMatch.Prefix">
                <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Live Attendance</span>
            </NavLink>
            <NavLink class="nav-item" href="/rhythm-history">
                <FluentIcon Value="@(new Icons.Regular.Size20.History())" Color="Color.Custom" CustomColor="#6c7870" />
                <span>Past Rhythm &amp; Logs</span>
            </NavLink>
            <NavLink class="nav-item nav-chat-item" href="/classroom-messages" Match="NavLinkMatch.Prefix">
                <div style="position: relative; display: flex; align-items: center;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Chat())" Color="Color.Custom" CustomColor="#4a7863" />
                    @if (_chatUnreadCount > 0)
                    {
                        <span class="nav-unread-dot"></span>
                    }
                </div>
                <span>Parent Messages</span>
                @if (_chatUnreadCount > 0)
                {
                    <span class="nav-unread-badge">@_chatUnreadCount</span>
                }
            </NavLink>
        </div>
    }

    @* ================= SECTION 2: DAYCARE DIRECTORY ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_directoryOpen))">
        <span class="nav-section-title">DIRECTORY</span>
        <span class="nav-section-chevron">@(_directoryOpen ? "▾" : "▸")</span>
    </div>

    @if (_directoryOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/children">
                <FluentIcon Value="@(new Icons.Regular.Size20.PersonAvailable())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Children</span>
            </NavLink>
            <NavLink class="nav-item" href="/classrooms">
                <FluentIcon Value="@(new Icons.Regular.Size20.Board())" Color="Color.Custom" CustomColor="#b47836" />
                <span>Classrooms</span>
            </NavLink>
            <NavLink class="nav-item" href="/teachers">
                <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="Color.Custom" CustomColor="#4a7863" />
                <span>Teachers &amp; Educators</span>
            </NavLink>
            <NavLink class="nav-item" href="/users-by-role">
                <FluentIcon Value="@(new Icons.Regular.Size20.PeopleTeam())" Color="Color.Custom" CustomColor="#5a6e63" />
                <span>Staff &amp; Users by Role</span>
            </NavLink>
        </div>
    }

    @* ================= SECTION 3: ADMISSIONS & ENROLLMENT ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_admissionsOpen))">
        <span class="nav-section-title">ADMISSIONS &amp; GROWTH</span>
        <span class="nav-section-chevron">@(_admissionsOpen ? "▾" : "▸")</span>
    </div>

    @if (_admissionsOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/enrollment">
                <FluentIcon Value="@(new Icons.Regular.Size20.CalendarAdd())" Color="Color.Custom" CustomColor="#b47836" />
                <span>Admissions &amp; Pipeline</span>
            </NavLink>
            <NavLink class="nav-item" href="/journey">
                <FluentIcon Value="@(new Icons.Regular.Size20.LeafOne())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Child Journey &amp; Milestones</span>
            </NavLink>
            <NavLink class="nav-item" href="/memories">
                <FluentIcon Value="@(new Icons.Regular.Size20.Heart())" Color="Color.Custom" CustomColor="#b85d43" />
                <span>Memories Timeline</span>
            </NavLink>
        </div>
    }

    @* ================= SECTION 4: EXPERIENCES & CURRICULUM ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_experiencesOpen))">
        <span class="nav-section-title">EXPERIENCES</span>
        <span class="nav-section-chevron">@(_experiencesOpen ? "▾" : "▸")</span>
    </div>

    @if (_experiencesOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/planning">
                <FluentIcon Value="@(new Icons.Regular.Size20.CalendarMonth())" Color="Color.Custom" CustomColor="#b47836" />
                <span>Experience Planning</span>
            </NavLink>
            <NavLink class="nav-item" href="/experiences">
                <FluentIcon Value="@(new Icons.Regular.Size20.Library())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Experience Library</span>
            </NavLink>
            <NavLink class="nav-item" href="/events">
                <FluentIcon Value="@(new Icons.Regular.Size20.Gift())" Color="Color.Custom" CustomColor="#ab7c38" />
                <span>Celebrations &amp; Events</span>
            </NavLink>
            <NavLink class="nav-item" href="/studio">
                <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Custom" CustomColor="#4a7863" />
                <span>Experience Studio</span>
            </NavLink>
            <NavLink class="nav-item" href="/marketplace">
                <FluentIcon Value="@(new Icons.Regular.Size20.BuildingShop())" Color="Color.Custom" CustomColor="#637d4e" />
                <span>Experience Marketplace</span>
            </NavLink>
            <NavLink class="nav-item" href="/harvest">
                <FluentIcon Value="@(new Icons.Regular.Size20.LeafTwo())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Harvest &amp; Insights</span>
            </NavLink>
        </div>
    }

    @* ================= SECTION 5: MATERIALS & SUPPLIES ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_suppliesOpen))">
        <span class="nav-section-title">MATERIALS &amp; SUPPLIES</span>
        <span class="nav-section-chevron">@(_suppliesOpen ? "▾" : "▸")</span>
    </div>

    @if (_suppliesOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/materials-marketplace">
                <FluentIcon Value="@(new Icons.Regular.Size20.Box())" Color="Color.Custom" CustomColor="#b47836" />
                <span>Materials Marketplace</span>
            </NavLink>
            <NavLink class="nav-item" href="/materials-orders">
                <FluentIcon Value="@(new Icons.Regular.Size20.ClipboardTask())" Color="Color.Custom" CustomColor="#6c7870" />
                <span>Orders &amp; Loans</span>
            </NavLink>
        </div>
    }

    @* ================= SECTION 6: FINANCE & BILLING ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_financeOpen))">
        <span class="nav-section-title">FINANCE &amp; BILLING</span>
        <span class="nav-section-chevron">@(_financeOpen ? "▾" : "▸")</span>
    </div>

    @if (_financeOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/management/billing" Match="NavLinkMatch.Prefix">
                <FluentIcon Value="@(new Icons.Regular.Size20.Receipt())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Billing &amp; Invoices</span>
            </NavLink>
            <NavLink class="nav-item" href="/management" Match="NavLinkMatch.All">
                <FluentIcon Value="@(new Icons.Regular.Size20.Board())" Color="Color.Custom" CustomColor="#3e5c49" />
                <span>Financial Overview</span>
            </NavLink>
        </div>
    }

    @* ================= SECTION 7: OPERATIONS & SETTINGS ================= *@
    <div class="nav-section-header" @onclick="() => ToggleSection(nameof(_adminOpen))">
        <span class="nav-section-title">OPERATIONS &amp; SETTINGS</span>
        <span class="nav-section-chevron">@(_adminOpen ? "▾" : "▸")</span>
    </div>

    @if (_adminOpen)
    {
        <div class="nav-group">
            <NavLink class="nav-item" href="/management/roster" Match="NavLinkMatch.Prefix">
                <FluentIcon Value="@(new Icons.Regular.Size20.CalendarLtr())" Color="Color.Custom" CustomColor="#52745e" />
                <span>Staff Roster &amp; Ratios</span>
            </NavLink>
            <NavLink class="nav-item" href="/safety-trust" Match="NavLinkMatch.All">
                <FluentIcon Value="@(new Icons.Regular.Size20.ShieldCheckmark())" Color="Color.Custom" CustomColor="#b85d43" />
                <span>Safety &amp; Emergency</span>
            </NavLink>
            <NavLink class="nav-item" href="/intelligence">
                <FluentIcon Value="@(new Icons.Regular.Size20.BrainCircuit())" Color="Color.Custom" CustomColor="#4a7863" />
                <span>Daycare Intelligence</span>
            </NavLink>
            <NavLink class="nav-item" href="/settings">
                <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.Custom" CustomColor="#6c7870" />
                <span>Organization Settings</span>
            </NavLink>
        </div>
    }

    </div>
    
    <!-- USER PROFILE SECTION -->
    <AuthorizeView>
        <Authorized>
            @{
                var userName = context.User.Identity?.Name 
                    ?? context.User.FindFirst("DisplayName")?.Value 
                    ?? UserContext.Email 
                    ?? "Educator";
                var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpper() : "E";
            }
            <div style="border-top: 1px solid var(--border, #e4e7df); padding-top: 14px; margin-top: 10px;">
                <div style="display: flex; gap: 10px; align-items: center;">
                    <a href="/profile" style="text-decoration: none; display: flex; gap: 10px; align-items: center; flex-grow: 1; min-width: 0;">
                        <div style="width: 34px; height: 34px; border-radius: 50%; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 14px; font-weight: 750; flex-shrink: 0;">
                            @initial
                        </div>
                        <div style="overflow: hidden; min-width: 0;">
                            <div style="font-weight: 700; font-size: 13px; color: var(--text, #26332d); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;" title="@userName">@userName</div>
                            <div style="display: flex; gap: 8px; font-size: 11px; margin-top: 2px;">
                                <span style="color: var(--muted, #6c7870); text-decoration: underline;">Profile</span>
                                <span style="color: var(--border, #e4e7df);">|</span>
                                <a href="/select-organization" style="color: var(--accent, #557c6c); text-decoration: none; font-weight: 700;">Switch Org</a>
                            </div>
                        </div>
                    </a>
                    <a href="/auth/logout" data-enhance-nav="false" style="font-size: 12px; color: #b55a5a; text-decoration: none; padding-left: 8px; border-left: 1px solid var(--border, #e4e7df); flex-shrink: 0; font-weight: 600;">Sign Out</a>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

<style>
    .nav-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 5px 8px 3px 8px;
        margin-top: 8px;
        cursor: pointer;
        user-select: none;
        border-radius: 6px;
        transition: background 0.15s ease;
    }

    .nav-section-header:hover {
        background: rgba(82, 116, 94, 0.08);
    }

    .nav-section-title {
        color: var(--muted, #6c7870);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.6px;
        text-transform: uppercase;
    }

    .nav-section-chevron {
        font-size: 10px;
        color: var(--muted, #6c7870);
        font-weight: 700;
    }

    .nav-group {
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin-bottom: 2px;
    }

    .custom-nav .nav-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 6px 10px;
        border-radius: 8px;
        color: var(--text, #26332d);
        font-size: 12px;
        font-weight: 550;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .custom-nav .nav-item:hover {
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e5c49);
    }

    .custom-nav .nav-item:focus-visible {
        outline: 2px solid var(--accent, #52745e);
        outline-offset: 1px;
    }

    .custom-nav .nav-item.active {
        background: var(--accent-light, #e6eee9) !important;
        color: var(--accent-dark, #3e5c49) !important;
        font-weight: 750;
    }

    .nav-unread-dot {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 8px;
        height: 8px;
        background: var(--color-danger, #c53030);
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7);
        animation: nav-badge-pulse 1.8s infinite;
    }

    .nav-unread-badge {
        margin-left: auto;
        background: var(--color-danger, #c53030);
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        padding: 1px 7px;
        border-radius: 999px;
        box-shadow: 0 1px 4px rgba(197, 48, 48, 0.3);
    }

    @@keyframes nav-badge-pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0.7); }
        70% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(197, 48, 48, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 48, 48, 0); }
    }
</style>

@code {
    private bool _dailyOpen = true;
    private bool _directoryOpen = true;
    private bool _admissionsOpen = true;
    private bool _experiencesOpen = false;
    private bool _suppliesOpen = false;
    private bool _financeOpen = false;
    private bool _adminOpen = false;
    private int _chatUnreadCount = 0;

    protected override async Task OnInitializedAsync()
    {
        AutoExpandCurrentRoute();
        NotificationCenter.OnParentMessageReceived += HandleIncomingMessage;
        NotificationCenter.OnMessagesRead += HandleMessagesRead;

        try
        {
            _chatUnreadCount = await CommunicationRepo.GetUnreadCountForEducatorAsync(TenantContext.TenantId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] Error loading unread count: {ex.Message}");
        }
    }

    private async Task HandleIncomingMessage(EnjoyEveryday.Application.Services.ParentMessageNotification notification)
    {
        _chatUnreadCount++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMessagesRead(Guid childId)
    {
        try
        {
            _chatUnreadCount = await CommunicationRepo.GetUnreadCountForEducatorAsync(TenantContext.TenantId);
        }
        catch
        {
            _chatUnreadCount = Math.Max(0, _chatUnreadCount - 1);
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotificationCenter.OnParentMessageReceived -= HandleIncomingMessage;
        NotificationCenter.OnMessagesRead -= HandleMessagesRead;
    }

    private void ToggleSection(string sectionName)
    {
        switch (sectionName)
        {
            case nameof(_dailyOpen):
                _dailyOpen = !_dailyOpen;
                break;
            case nameof(_directoryOpen):
                _directoryOpen = !_directoryOpen;
                break;
            case nameof(_admissionsOpen):
                _admissionsOpen = !_admissionsOpen;
                break;
            case nameof(_experiencesOpen):
                _experiencesOpen = !_experiencesOpen;
                break;
            case nameof(_suppliesOpen):
                _suppliesOpen = !_suppliesOpen;
                break;
            case nameof(_financeOpen):
                _financeOpen = !_financeOpen;
                break;
            case nameof(_adminOpen):
                _adminOpen = !_adminOpen;
                break;
        }
    }

    private void AutoExpandCurrentRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();

        if (relativePath.StartsWith("management/billing") || relativePath.StartsWith("billing"))
        {
            _financeOpen = true;
        }
        else if (relativePath.StartsWith("materials"))
        {
            _suppliesOpen = true;
        }
        else if (relativePath.StartsWith("experiences") || 
            relativePath.StartsWith("planning") || 
            relativePath.StartsWith("events") || 
            relativePath.StartsWith("studio") || 
            relativePath.StartsWith("marketplace") || 
            relativePath.StartsWith("harvest"))
        {
            _experiencesOpen = true;
        }
        else if (relativePath.StartsWith("enrollment") || 
                 relativePath.StartsWith("journey") || 
                 relativePath.StartsWith("memories"))
        {
            _admissionsOpen = true;
        }
        else if (relativePath.StartsWith("children") || 
                 relativePath.StartsWith("classrooms") || 
                 relativePath.StartsWith("teachers") || 
                 relativePath.StartsWith("users"))
        {
            _directoryOpen = true;
        }
        else if (relativePath.StartsWith("management") || 
                 relativePath.StartsWith("settings") || 
                 relativePath.StartsWith("safety-trust") || 
                 relativePath.StartsWith("intelligence"))
        {
            _adminOpen = true;
        }
        else
        {
            _dailyOpen = true;
        }
    }
}
