    <!-- USER PROFILE SECTION WITH VIEW SWITCHER -->
    <AuthorizeView>
        <Authorized>
            @{
                var userName = !string.IsNullOrWhiteSpace(_userDisplayName)
                    ? _userDisplayName
                    : (context.User.Identity?.Name 
                    ?? context.User.FindFirst("DisplayName")?.Value 
                    ?? UserContext.Email 
                    ?? "Educator");
                var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpper() : "E";
            }
            <div class="nav-profile-footer">
                <div class="nav-profile-row" @onclick="HandleNavItemClickAsync">
                    <!-- Avatar and user info -->
                    <a href="/profile" class="nav-profile-info" title="View Profile">
                        <div class="nav-profile-avatar">
                            @initial
                        </div>
                        <div class="nav-profile-meta">
                            <span class="nav-profile-name" title="@userName">@userName</span>
                            <span class="nav-profile-role">@(_currentNavView == "OrgAdmin" ? "Org Admin" : _currentNavView == "BranchAdmin" ? "Branch Admin" : _currentNavView == "LeadTeacher" ? "Lead Teacher" : "Educator")</span>
                        </div>
                    </a>

                    <!-- Action buttons -->
                    <div class="nav-profile-actions">
                        @if (_assignedBranchIds.Count > 1)
                        {
                            <a href="/select-branch" 
                               title="Switch Branch" 
                               class="nav-action-btn">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Building())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                            </a>
                        }
                        <a href="/select-organization" 
                           title="Switch Organization" 
                           class="nav-action-btn">
                            <FluentIcon Value="@(new Icons.Regular.Size16.BuildingSwap())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                        </a>
                        <a href="/auth/logout" 
                           data-enhance-nav="false" 
                           title="Sign Out" 
                           class="nav-action-btn nav-signout-btn">
                            <FluentIcon Value="@(new Icons.Regular.Size20.SignOut())" Color="Color.Custom" CustomColor="#dc2626" Width="15px" />
                        </a>
                    </div>
                </div>

                @if (_availableViewsCount > 1)
                {
                    <div class="nav-view-switcher">
                        <label for="nav-view-select" class="nav-view-label">View:</label>
                        <select id="nav-view-select" class="nav-view-select" @onchange="HandleSwitchView">
                            @if (_availableViews.Contains("Teacher"))
                            {
                                <option value="/?view=teacher" selected="@(_currentNavView == "Teacher")">Educator</option>
                            }
                            @if (_availableViews.Contains("LeadTeacher"))
                            {
                                <option value="/?view=leadteacher" selected="@(_currentNavView == "LeadTeacher")">Lead Teacher</option>
                            }
                            @if (_availableViews.Contains("BranchAdmin"))
                            {
                                <option value="/?view=branchadmin" selected="@(_currentNavView == "BranchAdmin")">Branch Admin</option>
                            }
                            @if (_availableViews.Contains("OrgAdmin"))
                            {
                                <option value="/?view=orgadmin" selected="@(_currentNavView == "OrgAdmin")">Org Admin</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
