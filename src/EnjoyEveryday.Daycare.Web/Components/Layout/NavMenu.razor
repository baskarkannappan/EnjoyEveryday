@* Navigation menu matching the approved EnjoyEveryday wireframe sidebar *@

@using Microsoft.AspNetCore.Components.Authorization
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext

<nav class="custom-nav" style="padding: 15px; height: 100%; display: flex; flex-direction: column;">
    
    <div style="flex-grow: 1; overflow-y: auto; padding-right: 5px;">
    
    <!-- BRANDING HEADER -->
    <div style="display: flex; gap: 12px; align-items: center; padding: 12px 10px 24px;">
        <div style="width: 40px; height: 40px; border-radius: 13px; background: var(--accent-light); color: var(--accent-dark); display: grid; place-items: center; font-size: 22px;">
            ✨
        </div>
        <div>
            <div style="font-weight: 750; font-size: 16px; letter-spacing: -0.5px; color: var(--text);">EnjoyEveryday</div>
            <!-- <div style="font-size: 11px; color: var(--muted); margin-top: 3px;">Every child deserves a wonderful day</div> -->
        </div>
    </div>



    @* DAILY *@
    <div class="nav-section">DAILY</div>
    <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
        <FluentIcon Value="@(new Icons.Regular.Size20.WeatherSunny())" Color="Color.Custom" CustomColor="#d97706" />
        <span>Today</span>
    </NavLink>
    <NavLink class="nav-item" href="/daily-care" Match="NavLinkMatch.Prefix">
        <FluentIcon Value="@(new Icons.Regular.Size20.Heart())" Color="Color.Custom" CustomColor="#e11d48" />
        <span>Child Daily Care</span>
    </NavLink>
    <NavLink class="nav-item" href="/rhythm-history">
        <FluentIcon Value="@(new Icons.Regular.Size20.History())" Color="Color.Custom" CustomColor="#b45309" />
        <span>Past Rhythm</span>
    </NavLink>

    @* EXPERIENCES *@
    <div class="nav-section">EXPERIENCES</div>
    <NavLink class="nav-item" href="/events">
        <FluentIcon Value="@(new Icons.Regular.Size20.Gift())" Color="Color.Custom" CustomColor="#7c3aed" />
        <span>Celebrations &amp; Events</span>
    </NavLink>
    <NavLink class="nav-item" href="/studio">
        <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Custom" CustomColor="#0891b2" />
        <span>Experience Studio</span>
    </NavLink>
    <NavLink class="nav-item" href="/experiences">
        <FluentIcon Value="@(new Icons.Regular.Size20.Library())" Color="Color.Custom" CustomColor="#059669" />
        <span>Experience Library</span>
    </NavLink>
    <NavLink class="nav-item" href="/marketplace">
        <FluentIcon Value="@(new Icons.Regular.Size20.BuildingShop())" Color="Color.Custom" CustomColor="#4f46e5" />
        <span>Experience Marketplace</span>
    </NavLink>
    <NavLink class="nav-item" href="/planning">
        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarMonth())" Color="Color.Custom" CustomColor="#c28b26" />
        <span>Experience Planning</span>
    </NavLink>
    <NavLink class="nav-item" href="/harvest">
        <FluentIcon Value="@(new Icons.Regular.Size20.LeafTwo())" Color="Color.Custom" CustomColor="#16a34a" />
        <span>Harvest &amp; Insights</span>
    </NavLink>

    @* PEOPLE *@
    <div class="nav-section">PEOPLE</div>
    <NavLink class="nav-item" href="/children">
        <FluentIcon Value="@(new Icons.Regular.Size20.PersonAvailable())" Color="Color.Custom" CustomColor="#0284c7" />
        <span>Children</span>
    </NavLink>
    <NavLink class="nav-item" href="/classrooms">
        <FluentIcon Value="@(new Icons.Regular.Size20.Board())" Color="Color.Custom" CustomColor="#ea580c" />
        <span>Classrooms</span>
    </NavLink>
    <NavLink class="nav-item" href="/teachers">
        <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="Color.Custom" CustomColor="#0d9488" />
        <span>Teachers</span>
    </NavLink>
    <NavLink class="nav-item" href="/users-by-role">
        <FluentIcon Value="@(new Icons.Regular.Size20.PeopleTeam())" Color="Color.Custom" CustomColor="#9333ea" />
        <span>Users by Role</span>
    </NavLink>

    @* UNDERSTAND *@
    <div class="nav-section">UNDERSTAND</div>
    <NavLink class="nav-item" href="/intelligence">
        <FluentIcon Value="@(new Icons.Regular.Size20.BrainCircuit())" Color="Color.Custom" CustomColor="#c026d3" />
        <span>Intelligence</span>
    </NavLink>
    <NavLink class="nav-item" href="/journey">
        <FluentIcon Value="@(new Icons.Regular.Size20.LeafOne())" Color="Color.Custom" CustomColor="#65a30d" />
        <span>Child Journey</span>
    </NavLink>
    <NavLink class="nav-item" href="/memories">
        <FluentIcon Value="@(new Icons.Regular.Size20.Heart())" Color="Color.Custom" CustomColor="#f43f5e" />
        <span>Memories</span>
    </NavLink>

    @* MANAGEMENT *@
    <div class="nav-section">MANAGEMENT</div>
    <div style="font-size: 12px; font-weight: 700; color: var(--muted); margin: 10px 0 5px 15px; text-transform: uppercase;">Organization</div>
    
    <NavLink class="nav-item" href="/management" Match="NavLinkMatch.All" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.Board())" Color="Color.Custom" CustomColor="#2563eb" />
        <span>Overview</span>
    </NavLink>
    
    <NavLink class="nav-item" href="/management/attendance" Match="NavLinkMatch.Prefix" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="#10b981" />
        <span>Attendance</span>
    </NavLink>
    
    <NavLink class="nav-item" href="/settings" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.Custom" CustomColor="#64748b" />
        <span>Organization Settings</span>
    </NavLink>
    
    <NavLink class="nav-item" href="/management/roles" Match="NavLinkMatch.Prefix" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.PeopleTeam())" Color="Color.Custom" CustomColor="#8b5cf6" />
        <span>Custom Roles</span>
    </NavLink>
    
    <NavLink class="nav-item" href="/management/billing" Match="NavLinkMatch.Prefix" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.Receipt())" Color="Color.Custom" CustomColor="#059669" />
        <span>Billing &amp; Invoices</span>
    </NavLink>

    @* SAFETY & TRUST *@
    <div class="nav-section">SAFETY & TRUST</div>
    <NavLink class="nav-item" href="/safety-trust" Match="NavLinkMatch.All">
        <FluentIcon Value="@(new Icons.Regular.Size20.ShieldCheckmark())" Color="Color.Custom" CustomColor="#dc2626" />
        <span>Safety &amp; Trust</span>
    </NavLink>
    <NavLink class="nav-item" href="/safety-trust/floor-maps" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.Board())" Color="Color.Custom" CustomColor="#ea580c" />
        <span>Emergency Floor Maps</span>
    </NavLink>
    <NavLink class="nav-item" href="/safety-trust/emergency-contacts" style="padding-left: 30px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.PersonAvailable())" Color="Color.Custom" CustomColor="#e11d48" />
        <span>Emergency Contacts</span>
    </NavLink>

    </div>
    
    <!-- USER PROFILE SECTION -->
    <AuthorizeView>
        <Authorized>
            @{
                var userName = context.User.Identity?.Name 
                    ?? context.User.FindFirst("DisplayName")?.Value 
                    ?? UserContext.Email 
                    ?? "Teacher";
                var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpper() : "T";
            }
            <div style="border-top: 1px solid var(--border); padding-top: 15px; margin-top: 10px;">
                <div style="font-size: 11px; font-weight: 700; color: var(--muted); margin-bottom: 8px; text-transform: uppercase;">Logged In As</div>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <a href="/profile" style="text-decoration: none; display: flex; gap: 10px; align-items: center; flex-grow: 1; min-width: 0;">
                        <div style="width: 34px; height: 34px; border-radius: 50%; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 14px; font-weight: 750; flex-shrink: 0;">
                            @initial
                        </div>
                        <div style="overflow: hidden; min-width: 0;">
                            <div style="font-weight: 700; font-size: 13px; color: var(--text); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;" title="@userName">@userName</div>
                            <div style="display: flex; gap: 8px; font-size: 11px; margin-top: 2px;">
                                <span style="color: var(--muted); text-decoration: underline;">View Profile</span>
                                <span style="color: var(--border);">|</span>
                                <a href="/select-organization" style="color: var(--accent, #557c6c); text-decoration: none; font-weight: 700;">Switch Org</a>
                            </div>
                        </div>
                    </a>
                    <a href="/auth/logout" data-enhance-nav="false" style="font-size: 12px; color: #b55a5a; text-decoration: none; padding-left: 8px; border-left: 1px solid var(--border); flex-shrink: 0;">Sign Out</a>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

<script>
    if (!window.navAutoCloseSetup) {
        window.navAutoCloseSetup = true;
        document.addEventListener('click', function(e) {
            var navItem = e.target.closest('.nav-item');
            if (navItem && window.innerWidth <= 768) {
                // Find the fluent layout hamburger button and click it to close the drawer
                var hamburger = document.querySelector('.mobile-header fluent-button');
                if (!hamburger) {
                    // Fallback to searching by tag if class is missing or different
                    hamburger = document.querySelector('fluent-button');
                }
                
                if (hamburger) {
                    setTimeout(function() {
                        hamburger.click();
                    }, 50);
                }
            }
        });
    }
</script>
