@page "/not-found"
@inject NavigationManager Navigation

<PageTitle>Not Found — EnjoyEveryday</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="10"
             HorizontalAlignment="HorizontalAlignment.Center"
             Style="margin-top: 80px;">
    <FluentText Size="TextSize.Size600" Weight="TextWeight.Bold">Page Not Found</FluentText>
    <FluentText Size="TextSize.Size200" Color="Color.Default">
        The page you are looking for does not exist.
    </FluentText>
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo("/"))" Style="margin-top: 16px;">
        Go to Today
    </FluentButton>
</FluentStack>
