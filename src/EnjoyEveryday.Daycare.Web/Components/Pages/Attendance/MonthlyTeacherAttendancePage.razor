@page "/attendance/monthly-teachers"
@page "/management/attendance/monthly-teachers"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Entities.Attendance
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Daycare.Web.Services
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Attendance
@inject AttendanceService AttendanceService
@inject NavigationManager Navigation
@inject IPageAuthorizationService PageAuth
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Daycare Web — Staff Monthly Attendance</PageTitle>

<div class="content">
    <PageHero Eyebrow="STAFF ATTENDANCE REGISTER"
              Title="Staff &amp; Educators Monthly Attendance Register"
              Subtitle="Comprehensive read-only monthly attendance register for teachers, educators, and daycare staff.">
        <RightContent>
            <button class="btn secondary" @onclick="ExportCsvComplianceReportAsync" title="Export monthly compliance record in CSV format">
                <span>📥 Export CSV</span>
            </button>
            <button class="btn secondary" @onclick="PrintReportAsync" title="Print-ready compliance record">
                <span>🖨️ Print / PDF</span>
            </button>
            <a href="/management/attendance" class="btn secondary">
                <span>Today's Daily Overview</span>
            </a>
            <a href="/attendance/monthly-children" class="btn secondary">
                <span>🎒 Children Register</span>
            </a>
        </RightContent>
    </PageHero>

    <!-- Context Header: Organisation, Branch, Location, Month Switcher -->
    <MonthlyAttendanceHeader 
        OrganizationName="@_organizationName"
        BranchName="@_branchName"
        Location="@_location"
        AccessibleBranches="@_accessibleBranches"
        SelectedBranchId="@_selectedBranchId"
        SelectedBranchIdChanged="OnBranchChanged"
        SelectedYear="@_selectedYear"
        SelectedMonth="@_selectedMonth"
        MonthChanged="OnMonthChanged"
        ActiveView="teachers"
        ActiveViewChanged="OnActiveViewChanged"
        ShowClassroomFilter="false"
        IsOrgAdmin="@_isOrgAdmin" />

    <!-- Teacher Attendance Register Grid -->
    <MonthlyTeacherAttendanceGrid 
        Rows="@_rows"
        Summary="@_summary"
        Year="@_selectedYear"
        Month="@_selectedMonth"
        IsLoading="@_isLoading" />
</div>

@code {
    private bool _isAuthorized = false;
    private bool _isOrgAdmin = false;
    private bool _isLoading = true;

    private string _organizationName = string.Empty;
    private string _branchName = string.Empty;
    private string _location = string.Empty;

    private List<BranchLocationContextDto> _accessibleBranches = new();
    private Guid _selectedBranchId = Guid.Empty;

    private int _selectedYear = DateTime.Today.Year;
    private int _selectedMonth = DateTime.Today.Month;

    private List<TeacherMonthlyRegisterRow> _rows = new();
    private MonthlyRegisterSummary _summary = new();

    protected override async Task OnInitializedAsync()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        _isAuthorized = await PageAuth.EnsureAuthorizedAsync("/attendance");
        if (!_isAuthorized) return;

        var profile = await PageAuth.GetUserProfileAsync();
        _isOrgAdmin = profile.IsOrgAdmin;

        await LoadAccessibleBranchesAsync();
        await LoadRegisterDataAsync();
    }

    private async Task LoadAccessibleBranchesAsync()
    {
        var branches = (await AttendanceService.GetUserAccessibleBranchesAsync(_isOrgAdmin)).ToList();
        _accessibleBranches = branches;

        if (_accessibleBranches.Count > 0)
        {
            var primary = _accessibleBranches.FirstOrDefault(b => b.IsPrimary) ?? _accessibleBranches[0];
            _selectedBranchId = primary.BranchId;
            _organizationName = primary.OrganizationName;
            _branchName = primary.BranchName;
            _location = primary.Location;
        }
    }

    private async Task LoadRegisterDataAsync()
    {
        if (_selectedBranchId == Guid.Empty)
        {
            _isLoading = false;
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            // Update branch location info
            var context = await AttendanceService.GetBranchLocationContextAsync(_selectedBranchId);
            if (context != null)
            {
                _organizationName = context.OrganizationName;
                _branchName = context.BranchName;
                _location = context.Location;
            }

            // Load monthly teacher register from stored procedure
            var (rows, summary) = await AttendanceService.GetMonthlyTeacherRegisterAsync(
                _selectedBranchId, _selectedYear, _selectedMonth);

            _rows = rows;
            _summary = summary;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MonthlyTeacherAttendancePage] Error loading data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnBranchChanged(Guid branchId)
    {
        if (_selectedBranchId != branchId)
        {
            _selectedBranchId = branchId;
            await LoadRegisterDataAsync();
        }
    }

    private async Task OnMonthChanged((int Year, int Month) target)
    {
        if (_selectedYear != target.Year || _selectedMonth != target.Month)
        {
            _selectedYear = target.Year;
            _selectedMonth = target.Month;
            await LoadRegisterDataAsync();
        }
    }

    private void OnActiveViewChanged(string view)
    {
        if (view == "children")
        {
            Navigation.NavigateTo("/attendance/monthly-children");
        }
    }

    private async Task ExportCsvComplianceReportAsync()
    {
        if (_rows == null || _rows.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# EnjoyEveryday State Licensing Staff Attendance & Ratio Compliance Report");
        sb.AppendLine($"# Organization: \"{_organizationName}\", Branch: \"{_branchName}\", Location: \"{_location}\"");
        sb.AppendLine($"# Period: {_selectedYear}-{_selectedMonth:D2}, Generated At: {DateTime.UtcNow:yyyy-MM-dd HH:mm:ss} UTC");
        sb.AppendLine($"# Total Staff: {_summary.TotalEnrolledOrStaff}, Working Days: {_summary.WorkingDaysElapsed}");
        sb.AppendLine();
        sb.AppendLine("\"Staff Name\",\"Employee #\",\"Role\",\"Date\",\"Day of Week\",\"Status\",\"Check-In Time\",\"Check-Out Time\",\"Attendance Code\",\"Notes\"");

        foreach (var row in _rows)
        {
            var staffName = (row.FullName ?? string.Empty).Replace("\"", "\"\"");
            var empNum = (row.EmployeeNumber ?? string.Empty).Replace("\"", "\"\"");
            var role = (row.JobTitle ?? "Educator").Replace("\"", "\"\"");

            foreach (var cell in row.DailyCells)
            {
                if (cell.IsWeekend && string.IsNullOrWhiteSpace(cell.RawStatus)) continue;

                var dateStr = cell.Date.ToString("yyyy-MM-dd");
                var dayOfWeek = cell.Date.ToString("dddd");
                var status = (cell.RawStatus ?? (cell.IsFuture ? "Scheduled" : "No Record")).Replace("\"", "\"\"");
                var inTime = cell.InTime.HasValue ? cell.InTime.Value.ToString(@"hh\:mm") : "-";
                var outTime = cell.OutTime.HasValue ? cell.OutTime.Value.ToString(@"hh\:mm") : "-";
                var code = cell.Code;
                var notes = (cell.Notes ?? string.Empty).Replace("\"", "\"\"");

                sb.AppendLine($"\"{staffName}\",\"{empNum}\",\"{role}\",\"{dateStr}\",\"{dayOfWeek}\",\"{status}\",\"{inTime}\",\"{outTime}\",\"{code}\",\"{notes}\"");
            }
        }

        var fileName = $"Compliance_Staff_Attendance_{_branchName.Replace(" ", "_")}_{_selectedYear}_{_selectedMonth:D2}.csv";
        await JS.InvokeVoidAsync("window.downloadFile", fileName, "text/csv;charset=utf-8", sb.ToString());
    }

    private async Task PrintReportAsync()
    {
        await JS.InvokeVoidAsync("window.printCurrentPage");
    }
}

<style>
@@media print {
    .btn, nav, .sidebar, .header-actions, .search-row, .tabs {
        display: none !important;
    }
    body, .content {
        background: white !important;
        color: black !important;
        padding: 0 !important;
        margin: 0 !important;
        zoom: 0.9 !important;
    }
    .monthly-grid-wrapper, .attendance-table {
        box-shadow: none !important;
        border: 1px solid #333 !important;
    }
}
</style>

