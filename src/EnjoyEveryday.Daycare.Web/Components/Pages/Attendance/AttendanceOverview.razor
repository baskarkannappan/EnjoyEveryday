@page "/management/attendance"
@page "/attendance"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.Daycare.Web.Services
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject AttendanceService AttendanceService
@inject EnjoyEveryday.Domain.Repositories.IAccessScopeRepository AccessScopeRepo
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Nav
@inject IPageAuthorizationService PageAuth
@inject IUserViewPreferenceService ViewPreference
@rendermode InteractiveServer

<div class="content">
    <AttendanceOverviewView 
        Branches="Branches"
        Classrooms="AllClassrooms"
        Summary="Summary"
        IsTeacherOnly="_isTeacherOnly"
        SelectedDate="SelectedDate"
        SelectedDateChanged="OnDateSelected"
        SelectedBranchFilter="@SelectedBranchFilter"
        SelectedBranchFilterChanged="@((v) => SelectedBranchFilter = v)"
        SelectedTypeFilter="@SelectedTypeFilter"
        SelectedTypeFilterChanged="@((v) => SelectedTypeFilter = v)"
        SearchQuery="@SearchQuery"
        SearchQueryChanged="@((v) => SearchQuery = v)" />
</div>

<ToastNotification />

@code {
    private IEnumerable<EnjoyEveryday.Domain.Entities.Branch> Branches = new List<EnjoyEveryday.Domain.Entities.Branch>();
    private AttendanceSummary? Summary;
    private DateTime SelectedDate = DateTime.Today;
    private string SelectedBranchFilter = "all";
    private string SelectedTypeFilter = "both";
    private string SearchQuery = "";
    private bool _isOrgAdmin = false;
    private bool _isBranchAdmin = false;
    private bool _isTeacherOnly = false;
    private HashSet<Guid> _assignedClassroomIds = new();
    private HashSet<Guid> _assignedBranchIds = new();

    private List<EnjoyEveryday.Domain.Entities.Classroom> AllClassrooms = new();

    protected override async Task OnInitializedAsync()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        var routeToCheck = relativePath.StartsWith("management/attendance", StringComparison.OrdinalIgnoreCase)
            ? "/management/attendance"
            : "/attendance";
        var isAuthorized = await PageAuth.EnsureAuthorizedAsync(routeToCheck);
        if (!isAuthorized) return;

        var userProfile = await PageAuth.GetUserProfileAsync();
        var tenantId = TenantContext.TenantId;
        var userId = userProfile.UserId;

        _isOrgAdmin = userProfile.IsOrgAdmin;
        _isBranchAdmin = userProfile.IsBranchAdmin && !_isOrgAdmin;
        _assignedBranchIds = userProfile.AssignedBranchIds;
        _assignedClassroomIds = userProfile.AssignedClassroomIds;
        _isTeacherOnly = !_isOrgAdmin && !_isBranchAdmin;

        var orgs = (await OrganizationService.GetOrganizationsAsync()).ToList();
        var targetOrgId = UserContext.OrganizationId ?? (userProfile.OrganizationId != Guid.Empty ? userProfile.OrganizationId : (Guid?)null);
        var org = targetOrgId.HasValue
            ? orgs.FirstOrDefault(o => o.Id == targetOrgId.Value) ?? orgs.FirstOrDefault()
            : orgs.FirstOrDefault();

        if (org != null)
        {
            var allBranches = (await BranchService.GetBranchesAsync(org.Id))
                .GroupBy(b => b.Id)
                .Select(g => g.First())
                .ToList();

            AllClassrooms.Clear();
            foreach (var b in allBranches)
            {
                var classrooms = await ClassroomService.GetClassroomsAsync(b.Id);
                AllClassrooms.AddRange(classrooms);
            }
            AllClassrooms = AllClassrooms.GroupBy(c => c.Id).Select(g => g.First()).ToList();

            if (_isBranchAdmin && _assignedBranchIds.Count > 0)
            {
                Branches = allBranches.Where(b => _assignedBranchIds.Contains(b.Id)).ToList();
                AllClassrooms = AllClassrooms.Where(c => _assignedBranchIds.Contains(c.BranchId)).ToList();
                var activeBranch = (ViewPreference.ActiveBranchId.HasValue && Branches.Any(b => b.Id == ViewPreference.ActiveBranchId.Value))
                    ? Branches.First(b => b.Id == ViewPreference.ActiveBranchId.Value)
                    : ((UserContext.BranchId.HasValue && Branches.Any(b => b.Id == UserContext.BranchId.Value))
                        ? Branches.First(b => b.Id == UserContext.BranchId.Value)
                        : Branches.FirstOrDefault());
                SelectedBranchFilter = activeBranch?.Name ?? "all";
            }
            else if (_isTeacherOnly)
            {
                AllClassrooms = AllClassrooms.Where(c => _assignedClassroomIds.Contains(c.Id)).ToList();
                Branches = allBranches.Where(b => AllClassrooms.Any(c => c.BranchId == b.Id)).ToList();
            }
            else
            {
                Branches = allBranches;
            }
        }

        if (!_isTeacherOnly)
        {
            await LoadData();
        }
    }

    private async Task OnDateSelected(DateTime dt)
    {
        SelectedDate = dt;
        if (!_isTeacherOnly)
        {
            await LoadData();
        }
        StateHasChanged();
    }

    private async Task LoadData()
    {
        if (_isBranchAdmin && _assignedBranchIds.Count > 0)
        {
            var activeBranchId = (ViewPreference.ActiveBranchId.HasValue && _assignedBranchIds.Contains(ViewPreference.ActiveBranchId.Value))
                ? ViewPreference.ActiveBranchId.Value
                : ((UserContext.BranchId.HasValue && _assignedBranchIds.Contains(UserContext.BranchId.Value))
                    ? UserContext.BranchId.Value
                    : _assignedBranchIds.First());
            var branchId = activeBranchId;
            var childAtt = (await AttendanceService.GetChildAttendanceAsync(branchId, SelectedDate)).ToList();
            var teacherAtt = (await AttendanceService.GetTeacherAttendanceAsync(branchId, SelectedDate)).ToList();

            Summary = new AttendanceSummary
            {
                ExpectedChildren = childAtt.Count,
                PresentChildren = childAtt.Count(c => c.Status == "Present"),
                AbsentChildren = childAtt.Count(c => c.Status == "Absent"),
                LateChildren = childAtt.Count(c => c.Status == "Late"),
                ExpectedTeachers = teacherAtt.Count,
                PresentTeachers = teacherAtt.Count(t => t.Status == "Present"),
                AbsentTeachers = teacherAtt.Count(t => t.Status == "Absent"),
                LateTeachers = teacherAtt.Count(t => t.Status == "Late")
            };
        }
        else
        {
            Summary = await AttendanceService.GetOrganizationSummaryAsync(SelectedDate);
        }

        if (Summary != null)
        {
            var classroomSummaries = (await AttendanceService.GetClassroomAttendanceSummariesAsync(SelectedDate, Branches, AllClassrooms)).ToList();
            Summary.AttendanceToFinishClassrooms = classroomSummaries.Count(c => c.StatusCategory == "pending");
            Summary.NeedsAttentionClassrooms = classroomSummaries.Count(c => c.StatusCategory == "attention");
        }
    }
}
