@page "/management/attendance"
@page "/attendance"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components.Attendance
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject AttendanceService AttendanceService
@inject EnjoyEveryday.Domain.Repositories.IAccessScopeRepository AccessScopeRepo
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Nav
@rendermode InteractiveServer


<div class="content">
    <section id="overview">
        <AttendanceOverviewHeader />
        <AttendanceFilterBar 
            @bind-SelectedDate="SelectedDate" 
            @bind-BranchFilter="SelectedBranchFilter" 
            @bind-TypeFilter="SelectedTypeFilter" 
            @bind-SearchQuery="SearchQuery" 
            Branches="Branches" />
        
        @if (!_isTeacherOnly)
        {
            <AttendanceKpiSection Summary="Summary" />
            
            <div class="cols">
                <BranchAttendanceSection Branches="Branches.Where(FilterBranch)" SelectedDate="SelectedDate" />
                <NeedsAttentionSection />
            </div>
        }
        
        <ClassroomAttendanceSection Classrooms="AllClassrooms" Branches="Branches" SelectedDate="SelectedDate" SearchQuery="@SearchQuery" BranchFilter="@SelectedBranchFilter" />
    </section>
</div>

<ToastNotification />



@code {
    private IEnumerable<EnjoyEveryday.Domain.Entities.Branch> Branches = new List<EnjoyEveryday.Domain.Entities.Branch>();
    private AttendanceSummary? Summary;
    private DateTime SelectedDate = DateTime.Today;
    private string SelectedBranchFilter = "all";
    private string SelectedTypeFilter = "both";
    private string SearchQuery = "";
    private bool _isTeacherOnly = false;
    private HashSet<Guid> _assignedClassroomIds = new();

    private List<EnjoyEveryday.Domain.Entities.Classroom> AllClassrooms = new();

    protected override async Task OnInitializedAsync()
    {
        var tenantId = TenantContext.TenantId;
        var userId = UserContext.UserId;
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();
        bool isOrgAdmin = userRoles.Any(r =>
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase));
        bool isBranchAdmin = userRoles.Any(r => r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        if (tenantId != Guid.Empty && userId != Guid.Empty)
        {
            var classroomIds = await AccessScopeRepo.GetAssignedClassroomIdsAsync(tenantId, userId);
            _assignedClassroomIds = new HashSet<Guid>(classroomIds);
        }

        _isTeacherOnly = !isOrgAdmin && !isBranchAdmin;

        if (!_isTeacherOnly)
        {
            await LoadData();
        }

        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();

        if (org != null)
        {
            var allBranches = (await BranchService.GetBranchesAsync(org.Id)).ToList();
            AllClassrooms.Clear();
            foreach (var b in allBranches)
            {
                var classrooms = await ClassroomService.GetClassroomsAsync(b.Id);
                AllClassrooms.AddRange(classrooms);
            }

            if (_isTeacherOnly)
            {
                AllClassrooms = AllClassrooms.Where(c => _assignedClassroomIds.Contains(c.Id)).ToList();
                Branches = allBranches.Where(b => AllClassrooms.Any(c => c.BranchId == b.Id)).ToList();
            }
            else
            {
                Branches = allBranches;
            }
        }
    }

    private async Task LoadData()
    {
        Summary = await AttendanceService.GetOrganizationSummaryAsync(SelectedDate);
    }

    private bool FilterBranch(EnjoyEveryday.Domain.Entities.Branch b)
    {
        if (SelectedBranchFilter != "all" && b.Name != SelectedBranchFilter)
            return false;

        if (!string.IsNullOrWhiteSpace(SearchQuery) &&
            !b.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) &&
            (b.Location == null || !b.Location.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
            return false;

        return true;
    }

    private void GoToBranch(Guid id)
    {
        Nav.NavigateTo($"/management/attendance/branches/{id}");
    }

    private void GoToClassroom(Guid id)
    {
        Nav.NavigateTo($"/management/attendance/classrooms/{id}");
    }

    private void ExportReport()
    {
        // Prototype logic
    }
}
