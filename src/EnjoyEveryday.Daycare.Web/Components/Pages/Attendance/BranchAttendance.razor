@page "/management/attendance/branches/{BranchName}"
@using EnjoyEveryday.Daycare.Web.Components.Shared.Attendance
@inject NavigationManager Nav
@rendermode InteractiveServer

<style>
:root{--bg:#f5f5ef;--paper:#fff;--ink:#263a32;--muted:#7b8981;--line:#e2e8e1;--green:#315640;--soft:#e5eee8;--amber:#f7edcc;--red:#f8e5e1;--shadow:0 8px 24px #1e372a0b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,system-ui,Segoe UI,sans-serif}
button,input,select{font:inherit}
button{cursor:pointer}
.content{padding:28px 32px;max-width:1550px;margin:auto}
</style>

<div class="content">
    <BranchDetailSection BranchName="@BranchName" />
</div>
<ToastNotification />

@code {
    [Parameter]
    public string BranchName { get; set; } = "";
}

