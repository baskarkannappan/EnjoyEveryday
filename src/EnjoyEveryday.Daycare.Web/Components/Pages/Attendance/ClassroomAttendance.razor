@page "/management/attendance/classrooms/{ClassroomName}"
@using EnjoyEveryday.Daycare.Web.Components.Shared.Attendance
@inject NavigationManager Nav
@rendermode InteractiveServer

<style>
.content{padding:28px 32px;max-width:1550px;margin:auto}
</style>

<div class="content">
    <BranchDetailSection BranchName="@BranchName" ClassroomName="@ClassroomName" />
</div>
<ToastNotification />

@code {
    [Parameter]
    public string ClassroomName { get; set; } = "";

    [SupplyParameterFromQuery(Name = "branch")]
    public string BranchName { get; set; } = "Downtown";
}
