@page "/management/attendance/classrooms/{ClassroomName}"
@using EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Daycare.Web.Services
@inject NavigationManager Nav
@inject IPageAuthorizationService PageAuth
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@rendermode InteractiveServer

<PageTitle>@ClassroomName Attendance — EnjoyEveryday</PageTitle>

@if (_isAuthorized)
{
    <div class="content">
        <BranchDetailSection BranchName="@BranchName" ClassroomName="@ClassroomName" />
    </div>
}
<ToastNotification />

@code {
    [Parameter]
    public string ClassroomName { get; set; } = "";

    [SupplyParameterFromQuery(Name = "branch")]
    public string BranchName { get; set; } = "";

    private bool _isAuthorized = false;

    protected override async Task OnInitializedAsync()
    {
        var authorized = await PageAuth.EnsureAuthorizedAsync("/management/attendance");
        if (!authorized) return;

        var profile = await PageAuth.GetUserProfileAsync();
        var allClassrooms = await ClassroomService.GetAllClassroomsAsync();
        var classroom = allClassrooms.FirstOrDefault(c => c.Name.Equals(ClassroomName, StringComparison.OrdinalIgnoreCase));

        if (classroom != null)
        {
            if (!profile.IsOrgAdmin && !profile.IsPlatformAdmin)
            {
                if (profile.IsBranchAdmin)
                {
                    if (!profile.AssignedBranchIds.Contains(classroom.BranchId))
                    {
                        Nav.NavigateTo("/access-denied?reason=branch_mismatch", true);
                        return;
                    }
                }
                else if (profile.IsTeacher)
                {
                    if (!profile.AssignedClassroomIds.Contains(classroom.Id))
                    {
                        Nav.NavigateTo("/access-denied?reason=classroom_mismatch", true);
                        return;
                    }
                }
                else
                {
                    Nav.NavigateTo("/access-denied?reason=unauthorized_role", true);
                    return;
                }
            }

            if (string.IsNullOrEmpty(BranchName))
            {
                var branches = await BranchService.GetBranchesAsync(profile.OrganizationId);
                var b = branches.FirstOrDefault(x => x.Id == classroom.BranchId);
                if (b != null) BranchName = b.Name;
            }
        }
        else
        {
            Nav.NavigateTo("/access-denied?reason=unauthorized_classroom", true);
            return;
        }

        _isAuthorized = true;
    }
}
