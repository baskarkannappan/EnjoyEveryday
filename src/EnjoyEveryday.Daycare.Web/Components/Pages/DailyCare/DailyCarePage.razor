@page "/daily-care"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components.DailyCare

<PageTitle>Child Daily Care &amp; Wellbeing — EnjoyEveryday</PageTitle>

<section class="content daily-care-page">
    <div class="page-header">
        <div>
            <div class="eyebrow">Child Daily Care</div>
            <h1>Today's Daily Care &amp; Wellbeing</h1>
            <p class="header-description">
                Fast routine care recording for teachers: diapers, meals, rest sessions, toileting, hygiene, 
                and comfort observations, with an instant chronological timeline and parent summary syncing.
            </p>
        </div>
        <div class="header-actions">
            <a href="/" class="btn">Today Overview</a>
            <a href="/journey" class="btn primary" style="background: var(--accent); color: white; border-color: var(--accent); font-weight: 700;">📸 Child Journey Moments</a>
            <a href="/daily-care/plans" class="btn">Care Plans</a>
            <a href="/daily-care/supplies" class="btn">Supplies</a>
        </div>
    </div>

    <ChildDailyCareSection />
</section>

<style>
.daily-care-page,
.daily-care-page * {
    box-sizing: border-box;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 25px;
    margin-bottom: 24px;
}

.eyebrow {
    color: var(--green, #557760);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 800;
    margin-bottom: 6px;
}

.page-header h1 {
    margin: 0;
    font-size: 30px;
    letter-spacing: -1px;
    color: var(--text, #26332d);
}

.header-description {
    margin: 8px 0 0;
    max-width: 760px;
    color: var(--muted, #78827c);
    font-size: 13.5px;
    line-height: 1.5;
}

.header-actions {
    display: flex;
    gap: 8px;
}

.btn {
    border: 1px solid var(--border, #e4e7df) !important;
    background: #ffffff !important;
    color: var(--text, #26332d) !important;
    border-radius: 11px !important;
    padding: 7px 15px !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    box-shadow: 0 1px 3px rgba(40, 55, 47, 0.04) !important;
    transition: all 0.15s ease !important;
}

.btn:hover {
    background: var(--surface-soft, #f8f9f5) !important;
    border-color: #cbd9ce !important;
    transform: translateY(-1px);
}

.btn.primary {
    background: var(--accent, #557c6c) !important;
    color: #ffffff !important;
    border-color: var(--accent, #557c6c) !important;
}

.btn.primary:hover {
    background: var(--accent-dark, #3e6253) !important;
    border-color: var(--accent-dark, #3e6253) !important;
}
</style>
