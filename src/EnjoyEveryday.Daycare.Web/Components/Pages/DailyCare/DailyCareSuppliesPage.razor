@page "/daily-care/supplies"
@rendermode InteractiveServer
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.DailyCare
@inject IChildDailyCareService DailyCareService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth

<PageTitle>Personal Care Supplies — EnjoyEveryday</PageTitle>

<div class="content daily-care-supplies-page">
    <PageHero Eyebrow="PERSONAL CARE SUPPLIES"
              Title="Care Supplies &amp; Low-Stock Warnings"
              Subtitle="Monitor child cubby inventories: diapers, wipes, spare clothes, and bottles. Keep track of items running low and trigger reassuring reminders to parents.">
        <RightContent>
            <a href="/daily-care" class="btn secondary">&larr; Back to Today's Care</a>
        </RightContent>
    </PageHero>

    @if (!string.IsNullOrEmpty(_statusMsg))
    {
        <div class="alert-banner success" style="margin-bottom: 20px;">
            <span>✅ @_statusMsg</span>
        </div>
    }

    <ChildCareSuppliesTable Supplies="@_allSupplies"
                            OnSetStatus="HandleSetStatus"
                            OnSendReminder="SendParentReminder" />
</div>

@code {
    private List<ChildCareSupply> _allSupplies = new();
    private string? _statusMsg;

    protected override async Task OnInitializedAsync()
    {
        await LoadSupplies();
    }

    private async Task LoadSupplies()
    {
        var profile = await PageAuth.GetUserProfileAsync();
        var orgs = (await OrganizationService.GetOrganizationsAsync()).ToList();
        var primaryOrg = orgs.FirstOrDefault();
        var allBranches = primaryOrg != null ? (await BranchService.GetBranchesAsync(primaryOrg.Id)).ToList() : new List<Branch>();

        var branches = profile.IsOrgAdmin
            ? allBranches
            : allBranches.Where(b => profile.AssignedBranchIds.Contains(b.Id)).ToList();

        var list = new List<ChildCareSupply>();
        var targetBranches = branches.Count > 0 ? branches : allBranches;

        foreach (var b in targetBranches)
        {
            var overview = (await DailyCareService.GetClassroomOverviewAsync(b.Id, null, DateOnly.FromDateTime(DateTime.Today))).ToList();

            // If educator is teacher/lead teacher, restrict to their assigned classrooms
            if (!profile.IsOrgAdmin && !profile.IsBranchAdmin)
            {
                overview = overview.Where(c => c.ClassroomId.HasValue && profile.AssignedClassroomIds.Contains(c.ClassroomId.Value)).ToList();
            }

            foreach (var child in overview)
            {
                var supplies = await DailyCareService.GetChildSuppliesAsync(child.ChildId);
                foreach (var s in supplies)
                {
                    s.ChildName = child.ChildName;
                    list.Add(s);
                }
            }
        }
        _allSupplies = list;
    }

    private async Task HandleSetStatus((ChildCareSupply supply, string status) args)
    {
        args.supply.Status = args.status;
        await DailyCareService.UpdateSupplyStatusAsync(args.supply);
        _statusMsg = $"{args.supply.SupplyType} for {args.supply.ChildName} updated to {args.status}.";
        await LoadSupplies();
    }

    private void SendParentReminder(ChildCareSupply supply)
    {
        _statusMsg = $"Parent reminder generated for {supply.ChildName}'s {supply.SupplyType}.";
    }
}
