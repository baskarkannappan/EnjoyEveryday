@page "/safety-trust"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.SafetyTrust

<PageTopbar Breadcrumb="Little Stars Daycare / Safety & Trust" Title="Safety & Trust">
    <RightContent>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">
            ♢
        </button>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">
            ?
        </button>
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #dce9df; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #365844;">
            BK
        </div>
    </RightContent>
</PageTopbar>

<section class="content">

    <div class="page-header">
        <div>
            <div class="eyebrow">Safety & Trust</div>
            <h1>Children are protected.<br>Trust is visible.</h1>
            <p class="header-description">
                A calm view of the safeguards protecting children,
                families, teachers and the organization — from consent
                and media permissions to AI governance and accountability.
            </p>
        </div>
        <div class="header-actions">
            <button class="btn">View Policies</button>
            <button class="btn primary">Safety Report</button>
        </div>
    </div>

    <TrustBanner 
        Icon="🛡️"
        Title="Your organization is in a good place."
        Description="Core safety controls are active across all four branches. No unresolved critical safety issues are currently open. There are two items that need routine attention."
        StatusText="Trust controls active" />

    <div class="summary-grid">
        <SafetySummaryCard 
            Label="Children with active consent"
            Value="286 / 286"
            DetailText="100% recorded"
            StatusClass="good" />
        <SafetySummaryCard 
            Label="Media permissions"
            Value="284 / 286"
            DetailText="2 need review"
            StatusClass="attention" />
        <SafetySummaryCard 
            Label="Open safety incidents"
            Value="1"
            DetailText="Routine follow-up"
            StatusClass="muted" />
        <SafetySummaryCard 
            Label="AI safety checks"
            Value="100%"
            DetailText="No blocked bypasses"
            StatusClass="good" />
    </div>

    <FilterTabs 
        Tabs="TrustTabs" 
        ActiveTab="overview" 
        OnTabSelected="(val) => {}" />

    <div class="main-grid">
        
        <section class="panel">
            <div class="panel-header">
                <div>
                    <div class="panel-title">Protection layers</div>
                    <div class="panel-sub">Safeguards working together across the platform</div>
                </div>
                <button class="btn">Framework</button>
            </div>
            <div class="panel-body">
                <SafetyDomainRow 
                    Icon="♡" IconClass="green-icon"
                    Name="Child Safety" Description="Safeguarding rules, authorized relationships, access controls and protected child information."
                    StatusText="Active" StatusClass="mini-good" />
                <SafetyDomainRow 
                    Icon="✓" IconClass="blue-icon"
                    Name="Consent & Privacy" Description="Parent permissions are checked before protected information or experiences are shared."
                    StatusText="Active" StatusClass="mini-good" />
                <SafetyDomainRow 
                    Icon="▣" IconClass="blue-icon"
                    Name="Media Protection" Description="Photos and videos respect child-level permissions, audience restrictions and retention rules."
                    StatusText="2 Review" StatusClass="mini-attention" />
                <SafetyDomainRow 
                    Icon="✦" IconClass="amber-icon"
                    Name="AI Safety" Description="AI recommendations are validated before they become part of the application workflow."
                    StatusText="Protected" StatusClass="mini-good" />
                <SafetyDomainRow 
                    Icon="!" IconClass="red-icon"
                    Name="Incident Management" Description="Safety concerns are recorded, assigned, followed up and retained according to policy."
                    StatusText="1 Open" StatusClass="mini-attention" />
                <SafetyDomainRow 
                    Icon="◌" IconClass="green-icon"
                    Name="Accountability & Audit" Description="Important actions are traceable to the person, purpose, time and affected record."
                    StatusText="Active" StatusClass="mini-good" />
            </div>
        </section>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <div class="panel-title">Branch trust status</div>
                    <div class="panel-sub">Current organization-wide view</div>
                </div>
                <button class="view-link">Details →</button>
            </div>
            <div class="panel-body">
                <BranchSafetyRow Avatar="🌿" Name="Downtown" Detail="Consent · Media · Safety" ScoreText="Good" ScoreClass="good" ScoreLabel="protected" />
                <BranchSafetyRow Avatar="🌳" Name="North" Detail="Consent · Media · Safety" ScoreText="Good" ScoreClass="good" ScoreLabel="protected" />
                <BranchSafetyRow Avatar="☀️" Name="West" Detail="1 routine follow-up" ScoreText="Review" ScoreClass="attention" ScoreLabel="attention" />
                <BranchSafetyRow Avatar="🌊" Name="Lakeside" Detail="Consent · Media · Safety" ScoreText="Good" ScoreClass="good" ScoreLabel="protected" />
                
                <PrivacyControlsCard 
                    Title="Privacy controls" 
                    Controls="@(new Dictionary<string, string> { { "Tenant isolation", "Active" }, { "Role-based access", "Active" }, { "Child-level permissions", "Active" }, { "Audit logging", "Active" } })" />
            </div>
        </section>

    </div>

    <div class="main-grid" style="margin-top:18px;">
        <section class="panel">
            <div class="panel-header">
                <div>
                    <div class="panel-title">AI Safety Guardrails</div>
                    <div class="panel-sub">How EnjoyEveryday keeps AI inside safe boundaries</div>
                </div>
                <button class="btn">View Rules</button>
            </div>
            <div class="panel-body">
                <div class="ai-card">
                    <div class="ai-title">✦ AI proposes. Application validates.</div>
                    <div class="ai-description">
                        AI can help teachers discover experiences, summarize approved information and identify patterns. It does not become the authority over children, safety or permissions.
                    </div>
                    <div class="ai-rules">
                        <div class="ai-rule">✓ Cannot override safety rules</div>
                        <div class="ai-rule">✓ Checked against child consent</div>
                        <div class="ai-rule">✓ Clear provenance labeling</div>
                    </div>
                </div>
            </div>
        </section>
    </div>

</section>

@code {
    private List<FilterTabs.TabItem> TrustTabs = new()
    {
        new FilterTabs.TabItem { Text = "Trust Overview", Value = "overview" },
        new FilterTabs.TabItem { Text = "Consent", Value = "consent" },
        new FilterTabs.TabItem { Text = "Media", Value = "media" },
        new FilterTabs.TabItem { Text = "Incidents", Value = "incidents" },
        new FilterTabs.TabItem { Text = "AI Safety", Value = "ai" },
        new FilterTabs.TabItem { Text = "Audit", Value = "audit" }
    };
}
