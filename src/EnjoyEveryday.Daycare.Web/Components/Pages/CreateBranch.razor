@page "/management/branches/new"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager NavigationManager

<PageTopbar Breadcrumb="Organization · Add Branch" Title="Add Branch">
    <RightContent>
        <button class="icon-button" @onclick="GoBack">✕</button>
    </RightContent>
</PageTopbar>

<section class="content" style="padding: 34px; max-width: 800px; margin: auto;">
    <div class="page-header">
        <h1>Create a new branch</h1>
        <p class="header-description">Add a new location to your organization.</p>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" style="color: red; margin-bottom: 20px;">@ErrorMessage</div>
    }

    <div style="background: white; border: 1px solid var(--line, #e1e6e0); border-radius: 12px; padding: 24px;">
        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: 500; margin-bottom: 8px;">Branch Name</label>
            <input type="text" class="search" style="width: 100%; box-sizing: border-box;" @bind="BranchName" placeholder="e.g. Downtown" />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: 500; margin-bottom: 8px;">Location / Address</label>
            <input type="text" class="search" style="width: 100%; box-sizing: border-box;" @bind="Location" placeholder="e.g. 72 King Street" />
        </div>

        <div style="display: flex; gap: 12px; margin-top: 32px;">
            <button class="btn primary" @onclick="Create" disabled="@IsSubmitting">
                @(IsSubmitting ? "Creating..." : "Create Branch")
            </button>
            <button class="btn" @onclick="GoBack" disabled="@IsSubmitting">Cancel</button>
        </div>
    </div>
</section>

@code {
    private string BranchName = "";
    private string Location = "";
    private string ErrorMessage = "";
    private bool IsSubmitting = false;

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(BranchName))
        {
            ErrorMessage = "Branch name is required.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = "";

        try
        {
            var orgs = await OrganizationService.GetOrganizationsAsync();
            var org = orgs.FirstOrDefault();
            if (org != null)
            {
                var branch = await BranchService.CreateBranchAsync(org.Id, BranchName, Location);
                NavigationManager.NavigateTo($"/management/branches/{branch.Id}");
            }
            else
            {
                ErrorMessage = "Could not find organization context.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to create branch: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/management");
    }
}
