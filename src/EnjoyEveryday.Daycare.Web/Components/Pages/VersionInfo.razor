@page "/version"
@page "/release-notes"
@using System.Reflection
@using System.Runtime.InteropServices
@using EnjoyEveryday.UI.Shared.Components
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

<PageTitle>Version &amp; Release Notes — EnjoyEveryday</PageTitle>

<div class="content version-page">
    <PageHero Eyebrow="PLATFORM &amp; RELEASES"
              Title="Version &amp; Release Notes"
              Subtitle="Read-only build metadata, last published timestamp, and recent platform updates.">
        <RightContent>
            <span class="version-readonly-badge">READ-ONLY</span>
        </RightContent>
    </PageHero>

    <!-- Build & Environment Summary Cards -->
    <div class="version-meta-grid">
        <div class="version-meta-card">
            <span class="meta-label">Application Version</span>
            <strong class="meta-value accent">v@_appVersion</strong>
            <span class="meta-sub">EnjoyEveryday Daycare Web</span>
        </div>

        <div class="version-meta-card">
            <span class="meta-label">Build Version</span>
            <strong class="meta-value mono">@_buildVersion</strong>
            <span class="meta-sub">@_runtimeDescription</span>
        </div>

        <div class="version-meta-card">
            <span class="meta-label">Last Published Date</span>
            <strong class="meta-value">@_lastPublishedDate</strong>
            <span class="meta-sub">@_lastPublishedTime</span>
        </div>

        <div class="version-meta-card">
            <span class="meta-label">Environment</span>
            <strong class="meta-value">@HostEnvironment.EnvironmentName</strong>
            <span class="meta-sub">Status: Healthy</span>
        </div>
    </div>

    <!-- Latest Release Details -->
    <div class="release-notes-section">
        <div class="section-head">
            <h2>Release History</h2>
            <p>Latest feature implementations, bug fixes, and UI improvements.</p>
        </div>

        <div class="release-list">
            @foreach (var release in _releases)
            {
                <article class="release-card @(release.IsLatest ? "release-latest" : "")">
                    <div class="release-card-header">
                        <div class="release-title-group">
                            <span class="release-version-pill">@release.Version</span>
                            <h3>@release.Title</h3>
                            @if (release.IsLatest)
                            {
                                <span class="release-latest-tag">Latest Release</span>
                            }
                        </div>
                        <span class="release-date">@release.PublishedDate</span>
                    </div>

                    @if (release.Features.Count > 0)
                    {
                        <div class="release-group">
                            <div class="release-group-label feature-label">Feature Implementations</div>
                            <ul>
                                @foreach (var item in release.Features)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (release.Fixes.Count > 0)
                    {
                        <div class="release-group">
                            <div class="release-group-label fix-label">Fixes &amp; Stability</div>
                            <ul>
                                @foreach (var item in release.Fixes)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (release.UiUpdates.Count > 0)
                    {
                        <div class="release-group">
                            <div class="release-group-label ui-label">UI &amp; Mobile Polish</div>
                            <ul>
                                @foreach (var item in release.UiUpdates)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</div>

<style>
    .version-page {
        max-width: 1040px !important;
        margin: 0 auto !important;
    }

    .version-readonly-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        border: 1px solid #c8dacd;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.06em;
    }

    .version-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .version-meta-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        padding: 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .version-meta-card .meta-label {
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted, #6c7870);
    }

    .version-meta-card .meta-value {
        font-size: 20px;
        font-weight: 800;
        color: var(--text, #26332d);
        line-height: 1.25;
        word-break: break-word;
    }

    .version-meta-card .meta-value.accent {
        color: var(--accent-dark, #31523c);
    }

    .version-meta-card .meta-value.mono {
        font-size: 16px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .version-meta-card .meta-sub {
        font-size: 12px;
        color: var(--muted, #6c7870);
    }

    .release-notes-section .section-head {
        margin-bottom: 14px;
    }

    .release-notes-section .section-head h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        color: var(--text, #26332d);
    }

    .release-notes-section .section-head p {
        margin: 4px 0 0;
        font-size: 13px;
        color: var(--muted, #6c7870);
    }

    .release-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .release-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .release-card.release-latest {
        border-left: 4px solid var(--accent-dark, #31523c);
    }

    .release-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border, #e4e7df);
    }

    .release-title-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .release-title-group h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 750;
        color: var(--text, #26332d);
    }

    .release-version-pill {
        padding: 4px 10px;
        border-radius: 8px;
        background: var(--accent-dark, #31523c);
        color: #ffffff;
        font-size: 12px;
        font-weight: 800;
    }

    .release-latest-tag {
        padding: 3px 9px;
        border-radius: 999px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #31523c);
        border: 1px solid #c8dacd;
        font-size: 11px;
        font-weight: 750;
    }

    .release-date {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--muted, #6c7870);
    }

    .release-group-label {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 6px;
    }

    .feature-label { color: #31523c; }
    .fix-label { color: #9b2c2c; }
    .ui-label { color: #8c5717; }

    .release-group ul {
        margin: 0;
        padding-left: 18px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--text, #26332d);
    }

    @@media (max-width: 900px) {
        .version-meta-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        .version-meta-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .version-meta-card {
            padding: 14px 16px;
        }

        .release-card {
            padding: 16px;
        }
    }
</style>

@code {
    private string _appVersion = "1.4.0";
    private string _buildVersion = "1.4.0.0";
    private string _lastPublishedDate = "";
    private string _lastPublishedTime = "";
    private string _runtimeDescription = RuntimeInformation.FrameworkDescription;

    private sealed record ReleaseEntry(
        string Version,
        string Title,
        string PublishedDate,
        bool IsLatest,
        List<string> Features,
        List<string> Fixes,
        List<string> UiUpdates);

    private readonly List<ReleaseEntry> _releases = new()
    {
        new ReleaseEntry(
            "v1.4.0",
            "Branch Closure Lockdown, Planning Guards & UI Simplification",
            "November 16, 2026",
            true,
            new()
            {
                "Implemented centralized Branch Closure UI Lockdown (IBranchOperationalUiGuard & BranchRoutePolicy) blocking classroom operational routes, menus, and modals when a branch is closed or suspended.",
                "Added real-time branch status propagation (IBranchStatusRealtimeNotifier) so already logged-in teachers immediately transition to the Branch Closed screen.",
                "Added Branch Closure & Reopening management workflow with full backend enforcement across attendance, planning, execution, and daily care.",
                "Added read-only Version & Release Notes page (/version, /release-notes)."
            },
            new()
            {
                "Fixed Experience Planning & PlanExperienceDialog to scope to the active organization/branch, hide the '+' button on closed days, and prevent planning when a branch is closed.",
                "Fixed PostgreSQL timestamptz UTC DateTimeOffset normalization in PlannerService, AttendanceService, and BranchClosureRepository.",
                "Handled BranchClosedException as a user-friendly warning toast in AppNotificationService and BranchDetailSection.",
                "Fixed SemaphoreSlim ObjectDisposedException during Blazor circuit teardown and duplicate sp_update_teacher_classrooms procedure overload."
            },
            new()
            {
                "Simplified Teacher Dashboard Today's Rhythm strip and Child Name cards.",
                "Styled Branch Classrooms & Capacity cards on the Branch Admin Dashboard.",
                "Improved mobile responsiveness across Experience Planning, Manage Classrooms modal, Child Guardians modal, Announcements, and unified Scandinavian sage-green theme tokens."
            }),
        new ReleaseEntry(
            "v1.3.0",
            "Daily Operations Gates & Classroom Live Cockpit",
            "November 2026",
            false,
            new()
            {
                "Added daily Branch Open/Close and Classroom Open/Close operational gates.",
                "Added Lead Teacher & Educator Classroom Live Roster & Action Cockpit with 1-tap check-in, diaper, meal, nap, and moment logging."
            },
            new()
            {
                "Resolved StaffRosterView loading null-guard edge cases and improved role-based route authorization."
            },
            new()
            {
                "Standardized PageHero, card surfaces, and button patterns across Daycare.Web."
            })
    };

    protected override void OnInitialized()
    {
        var assembly = typeof(VersionInfo).Assembly;
        var infoVer = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        var asmVer = assembly.GetName().Version;

        if (!string.IsNullOrWhiteSpace(infoVer))
        {
            var parts = infoVer.Split('+', 2);
            _appVersion = parts[0];
            _buildVersion = parts.Length > 1 && parts[1].Length > 8
                ? $"{parts[0]}+{parts[1][..8]}"
                : infoVer;
        }
        else if (asmVer != null)
        {
            _appVersion = $"{asmVer.Major}.{asmVer.Minor}.{asmVer.Build}";
            _buildVersion = asmVer.ToString();
        }

        try
        {
            if (!string.IsNullOrWhiteSpace(assembly.Location) && File.Exists(assembly.Location))
            {
                var published = File.GetLastWriteTime(assembly.Location);
                _lastPublishedDate = published.ToString("MMM dd, yyyy");
                _lastPublishedTime = published.ToString("h:mm tt");
                return;
            }
        }
        catch
        {
            // Fallback below if location is unavailable
        }

        var now = DateTime.Now;
        _lastPublishedDate = now.ToString("MMM dd, yyyy");
        _lastPublishedTime = now.ToString("h:mm tt");
    }
}

