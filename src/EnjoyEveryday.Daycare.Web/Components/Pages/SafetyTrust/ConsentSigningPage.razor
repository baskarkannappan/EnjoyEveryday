@page "/consent/sign/{Token}"
@rendermode InteractiveServer
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components.SafetyTrust
@inject IConsentService ConsentService
@inject NavigationManager NavigationManager

<PageTitle>Electronic Consent Signing — EnjoyEveryday</PageTitle>

<div class="signing-container">
    <ConsentSigningCard Session="@_session"
                        IsLoading="@_isLoading"
                        IsSubmitting="@_isSubmitting"
                        IsSignedSuccess="@_isSignedSuccess"
                        ErrorMessage="@_errorMessage"
                        @bind-LegalIntentConfirmed="_legalIntentConfirmed"
                        @bind-TypedLegalName="_typedLegalName"
                        SelectedChoices="@_selectedChoices"
                        OnChoiceChanged="HandleChoiceChanged"
                        OnSubmitSignature="SubmitSignatureAsync"
                        OnDeclineDocument="DeclineDocumentAsync" />
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private bool _isSignedSuccess = false;
    private string? _errorMessage;

    private ParentSigningSession? _session;
    private bool _legalIntentConfirmed = false;
    private string _typedLegalName = string.Empty;
    private Dictionary<string, string> _selectedChoices = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionAsync();
    }

    private async Task LoadSessionAsync()
    {
        _isLoading = true;
        _session = await ConsentService.GetSigningSessionByTokenAsync(Token);
        _isLoading = false;

        if (_session != null && !_session.IsInvalid && !_session.IsAlreadySigned && !_session.IsExpired)
        {
            _typedLegalName = _session.SignerName;
            foreach (var ch in _session.Choices)
            {
                _selectedChoices[ch.SectionKey] = ch.Choice;
            }
        }
    }

    private void HandleChoiceChanged((string SectionKey, string Value) choice)
    {
        _selectedChoices[choice.SectionKey] = choice.Value;
    }

    private async Task SubmitSignatureAsync()
    {
        if (!_legalIntentConfirmed)
        {
            _errorMessage = "Please confirm your electronic signature intent.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_typedLegalName))
        {
            _errorMessage = "Please enter your typed legal name.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var request = new SubmitSignatureRequest
        {
            RawToken = Token,
            TypedLegalName = _typedLegalName.Trim(),
            LegalIntentConfirmed = true,
            Choices = _selectedChoices,
            IpAddress = "127.0.0.1",
            UserAgent = "Browser Client"
        };

        var (success, msg) = await ConsentService.SignDocumentAsync(request);
        _isSubmitting = false;

        if (success)
        {
            _isSignedSuccess = true;
        }
        else
        {
            _errorMessage = msg ?? "Failed to complete signature.";
        }
    }

    private async Task DeclineDocumentAsync()
    {
        var (success, msg) = await ConsentService.DeclineDocumentAsync(Token, "Parent opted out on signing portal.");
        if (success)
        {
            _errorMessage = "Document declined. Daycare staff will be informed.";
            await LoadSessionAsync();
        }
        else
        {
            _errorMessage = msg;
        }
    }
}
