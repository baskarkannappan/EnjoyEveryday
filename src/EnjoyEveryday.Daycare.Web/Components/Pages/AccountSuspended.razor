@page "/account-suspended"
@using EnjoyEveryday.Daycare.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IPageAuthorizationService PageAuth
@inject NavigationManager NavManager
@layout Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Account Locked — EnjoyEveryday</PageTitle>

<div class="lock-wrapper">
    <div class="lock-card">
        <!-- Shield Badge -->
        <div class="shield-badge">
            <span class="shield-icon">🔒</span>
        </div>

        <div class="lock-header">
            <span class="eyebrow">ORGANIZATION ACCESS FROZEN</span>
            <h1>Account Locked</h1>
            <p class="subtitle">
                This daycare organization has been suspended by platform administration. All operational activities, attendance tracking, and daily care logging are temporarily frozen.
            </p>
        </div>

        <!-- Details Card -->
        <div class="details-box">
            <div class="detail-row">
                <span class="detail-label">Organization</span>
                <span class="detail-value">@(_profile?.OrganizationName ?? "Daycare Organization")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Status</span>
                <span class="status-badge">Suspended</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Reason</span>
                <span class="detail-value reason">@(_profile?.SuspensionReason ?? "Administrative review by platform management.")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Support Email</span>
                <span class="detail-value"><a href="mailto:support@enjoyeveryday.com" class="support-link">support@enjoyeveryday.com</a></span>
            </div>
        </div>

        <div class="notice-message">
            Please check with your platform administrator to resolve outstanding items and restore workspace access.
        </div>

        <!-- Actions -->
        <div class="actions-row">
            <a href="/select-organization" class="btn secondary">
                Switch Organization
            </a>
            <form method="post" action="/auth/logout" style="margin: 0;">
                <AntiforgeryToken />
                <button type="submit" class="btn primary">
                    Sign Out
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .lock-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background: var(--bg, #f5f5ef);
        font-family: var(--ee-font, "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    }

    .lock-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        padding: 40px 36px;
        width: 100%;
        max-width: 520px;
        text-align: center;
    }

    .shield-badge {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #fff5f5;
        border: 1.5px solid #fed7d7;
        color: #9b2c2c;
        display: grid;
        place-items: center;
        font-size: 28px;
        margin: 0 auto 20px auto;
        box-shadow: 0 4px 12px rgba(155, 44, 44, 0.08);
    }

    .lock-header .eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.8px;
        color: #9b2c2c;
        margin-bottom: 8px;
    }

    .lock-header h1 {
        font-size: 26px;
        font-weight: 800;
        color: var(--text, #26332d);
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
    }

    .lock-header .subtitle {
        font-size: 14px;
        color: var(--muted, #6c7870);
        margin: 0 0 24px 0;
        line-height: 1.55;
    }

    .details-box {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        text-align: left;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--border, #e4e7df);
        font-size: 13.5px;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: var(--muted, #6c7870);
    }

    .detail-value {
        font-weight: 700;
        color: var(--text, #26332d);
    }

    .detail-value.reason {
        color: #9b2c2c;
        max-width: 260px;
        text-align: right;
        word-break: break-word;
    }

    .status-badge {
        background: #fff5f5;
        color: #9b2c2c;
        border: 1px solid #fed7d7;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .support-link {
        color: var(--accent-dark, #31523c);
        text-decoration: underline;
    }

    .notice-message {
        font-size: 13px;
        color: var(--muted, #6c7870);
        line-height: 1.5;
        margin-bottom: 28px;
    }

    .actions-row {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 20px;
        border-radius: 0px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
    }

    .btn.primary {
        background: #31523c;
        color: #ffffff;
    }

    .btn.primary:hover {
        background: #23412f;
    }

    .btn.secondary {
        background: #ffffff;
        border: 1px solid var(--border, #e4e7df);
        color: var(--text, #26332d);
    }

    .btn.secondary:hover {
        background: var(--surface-soft, #f8f9f5);
    }

    @@media (max-width: 560px) {
        .lock-card {
            padding: 28px 20px;
        }

        .actions-row {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        .detail-value.reason {
            text-align: left;
            max-width: 100%;
        }
    }
</style>

@code {
    private UserRoleProfile? _profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await PageAuth.GetUserProfileAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AccountSuspended] Error resolving profile: {ex.Message}");
        }
    }
}

