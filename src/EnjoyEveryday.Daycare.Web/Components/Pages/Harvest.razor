@page "/harvest"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ChildJourney
@inject ExperienceService ExperienceService
@inject FeedbackService FeedbackService
@inject PlannerService PlannerService
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject UserService UserService
@rendermode InteractiveServer
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject HarvestService HarvestService
<div class="content">
    <PageHero Eyebrow="EXPERIENCE MEMORY"
              Title="Harvest & Insights"
              Subtitle="What happened matters more than simply completing the activity.">
    </PageHero>

    <div class="action-required-panel">
        <h3>Action Required</h3>
        <p>You ran these experiences recently. How did they go?</p>
        <div class="pending-actions-grid">
            @if (_experiences.Any()) {
                foreach(var exp in _experiences.Where(e => e.Status != "Idea" && e.Status != "Draft").Take(2)) {
                    <button class="btn-pending primary-pending" @onclick="() => OpenFeedbackDialogFor(exp.Id.ToString())">
                        ⭐ Rate "@exp.Title"
                    </button>
                }
            }
            <button class="btn-pending" @onclick="OpenMomentDialog">
                📸 Log Child Moment
            </button>
            <button class="btn-pending" @onclick="OpenFeedbackDialog">
                + Log Other Feedback
            </button>
        </div>
    </div>

    <h3 class="section-title">AI Insights</h3>
    <HarvestInsightCard Title="Your daycare is learning."
                        Message="@($"{_metrics.TotalExperiences} experiences happened this month. {_metrics.TotalFeedbacks} received teacher feedback. {_metrics.PatternsDiscovered} patterns were discovered.")" />

    <h3 class="section-title">Experience Performance</h3>

    <div class="harvest-layout">
        <ExperiencePerformanceGrid Items="@_performanceItems" OnViewClick="OnViewClick" />

        <TeacherFeedbackList Items="@_feedbackItems"
                             OnItemClick="EditFeedback" />
    </div>

    <Flywheel Steps="@_flywheelSteps" />

    <FeedbackFormModal IsOpen="@_isModalOpen"
                       IsEditing="@_currentFeedbackId.HasValue"
                       @bind-SelectedExperienceId="_selectedExperienceId"
                       @bind-Rating="_rating"
                       @bind-FeedbackText="_feedbackText"
                       ExperienceOptions="@(_experiences.Select(e => new KeyValuePair<string, string>(e.Id.ToString(), e.Title)))"
                       OnClose="CloseDialog"
                       OnSave="ConfirmFeedback"
                       OnDelete="DeleteFeedback" />

    <AddJourneyMomentDialog @ref="_addMomentDialog" TeacherId="@(Guid.Parse("50000000-0000-0000-0000-000000000001"))" OnSaved="OnMomentSaved" />
</div>
@using EnjoyEveryday.Domain.Repositories
@code {
    private AddJourneyMomentDialog _addMomentDialog = default!;

    private HarvestMetricsDto _metrics = new HarvestMetricsDto();
    private IQueryable<ExperiencePerformanceItem> _performanceItems = new List<ExperiencePerformanceItem>().AsQueryable();

    private List<FlywheelStep> _flywheelSteps = new()
    {
        new FlywheelStep { Name = "Create", IsActive = true },
        new FlywheelStep { Name = "Schedule", IsActive = true },
        new FlywheelStep { Name = "Experience", IsActive = true },
        new FlywheelStep { Name = "Harvest", IsActive = true },
        new FlywheelStep { Name = "Improve", IsActive = false },
        new FlywheelStep { Name = "Reuse", IsActive = false },
    };

    private List<Experience> _experiences = new();
    private List<ExperienceSchedule> _schedules = new();
    private List<ExperienceFeedback> _feedbacks = new();
    private Dictionary<Guid, string> _userNames = new();

    private IEnumerable<FeedbackItem> _feedbackItems =>
        _feedbacks.Select(f => new FeedbackItem
        {
            Id = f.Id,
            Notes = f.Notes ?? "",
            Author = _userNames.TryGetValue(f.TeacherId, out var name) ? $"{name} • Teacher" : "Teacher"
        });

    private string _feedbackText = string.Empty;
    private string _rating = "Good";
    private string? _selectedExperienceId;

    private Guid? _currentFeedbackId;
    private bool _isModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        _experiences = (await ExperienceService.GetExperiencesAsync()).ToList();

        var teachers = await UserService.GetTeachersAsync();
        _userNames = teachers.ToDictionary(u => u.Id, u => string.IsNullOrWhiteSpace(u.FirstName) ? "User" : u.FirstName);

        _metrics = await HarvestService.GetMonthlyMetricsAsync();
        var dtos = await HarvestService.GetPerformanceItemsAsync();
        _performanceItems = dtos.Select(d => new ExperiencePerformanceItem
        {
            ExperienceId = d.ExperienceId,
            Title = d.Title,
            Subtitle = d.Subtitle,
            Uses = d.Uses,
            Response = d.Response
        }).AsQueryable();

        await LoadFeedbacks();
    }

    private async Task LoadFeedbacks()
    {
        _feedbacks = (await FeedbackService.GetAllFeedbackAsync()).ToList();
        StateHasChanged();
    }

    private void OpenFeedbackDialog()
    {
        _currentFeedbackId = null;
        _isModalOpen = true;
        _feedbackText = string.Empty;
        _rating = "Good";
        if (_experiences.Any()) { _selectedExperienceId = _experiences.First().Id.ToString(); }
    }

    private void OpenFeedbackDialogFor(string experienceId)
    {
        _currentFeedbackId = null;
        _isModalOpen = true;
        _feedbackText = string.Empty;
        _rating = "Good";
        _selectedExperienceId = experienceId;
    }

    private async Task OpenMomentDialog()
    {
        await _addMomentDialog.OpenAsync();
    }

    private void OnMomentSaved()
    {
        StateHasChanged();
    }

    private void EditFeedback(FeedbackItem item)
    {
        var feedback = _feedbacks.FirstOrDefault(f => f.Id == item.Id);
        if (feedback != null)
        {
            _currentFeedbackId = feedback.Id;
            _feedbackText = feedback.Notes ?? "";
            _rating = feedback.Rating ?? "Good";
            _isModalOpen = true;
        }
    }

    private async Task DeleteFeedback()
    {
        if (_currentFeedbackId.HasValue)
        {
            await FeedbackService.DeleteFeedbackAsync(_currentFeedbackId.Value);
            await LoadFeedbacks();
            CloseDialog();
        }
    }

    private void CloseDialog() => _isModalOpen = false;

    private async Task ConfirmFeedback()
    {
        if (string.IsNullOrEmpty(_selectedExperienceId) || string.IsNullOrEmpty(_feedbackText)) return;

        var teacherId = UserContext.UserId;
        var expId = Guid.Parse(_selectedExperienceId);

        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org == null) return;
        var branch = (await BranchService.GetBranchesAsync(org.Id)).FirstOrDefault();
        if (branch == null) return;
        var classroom = (await ClassroomService.GetClassroomsAsync(branch.Id)).FirstOrDefault();
        if (classroom == null) return;

        var schedule = await PlannerService.ScheduleExperienceAsync(expId, classroom.Id, DateOnly.FromDateTime(DateTime.Today), "Morning");
        var scheduleId = schedule.Id;

        if (_currentFeedbackId.HasValue)
        {
            var feedback = await FeedbackService.GetFeedbackByIdAsync(_currentFeedbackId.Value);
            if (feedback != null)
            {
                feedback.Notes = _feedbackText;
                feedback.Rating = _rating;
                await FeedbackService.UpdateFeedbackAsync(feedback);
            }
        }
        else
        {
            await FeedbackService.CreateFeedbackAsync(scheduleId, teacherId, _rating, _feedbackText);
        }

        await LoadFeedbacks();
        CloseDialog();
    }

    private async Task OnViewClick(ExperiencePerformanceItem item)
    {
        if (item.ExperienceId != Guid.Empty)
        {
            await _addMomentDialog.OpenForExperienceAsync(item.ExperienceId, item.Title);
        }
    }
}
