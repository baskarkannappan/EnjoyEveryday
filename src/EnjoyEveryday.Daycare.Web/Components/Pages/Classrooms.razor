@page "/classrooms"

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject OrganizationService OrgService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext

<PageHero 
    Eyebrow="ENVIRONMENT" 
    Title="Classrooms" 
    Subtitle="Experiences begin with the environment.">
    <RightContent>
        <button id="addClassroomButton" class="primary" @onclick="OpenAddClassroomModal">
            + Add classroom
        </button>
    </RightContent>
</PageHero>

<div id="classroomGrid" class="people-grid">
    @if (_classrooms != null && _classrooms.Any())
    {
        @foreach (var classroom in _classrooms)
        {
            <div @onclick="() => OpenEditClassroomModal(classroom)" style="cursor: pointer;">
                <IconCard Icon="🏫" Title="@classroom.Name">
                    <p>@(classroom.Capacity?.ToString() ?? "18") children · Ages @(classroom.AgeGroup ?? "3–4")</p>
                    <p>Environment: @(classroom.Environment ?? "Indoor")</p>
                </IconCard>
            </div>
        }
    }
    else if (_classrooms != null && !_classrooms.Any())
    {
        <p>No classrooms found. Generating sample data...</p>
    }
</div>

<ClassroomFormModal IsOpen="_isModalOpen"
                    IsEditing="_isEditing"
                    @bind-Name="_currentClassroom.Name"
                    @bind-AgeGroup="_currentClassroom.AgeGroup"
                    @bind-Capacity="_currentClassroom.Capacity"
                    OnClose="CloseDialog"
                    OnSave="SaveClassroomAsync"
                    OnDelete="DeleteClassroomAsync" />

@code {
    private IEnumerable<Classroom>? _classrooms;
    private Classroom _currentClassroom = new();
    private bool _isModalOpen = false;
    private bool _isEditing = false;
    private Guid _defaultBranchId;

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrgService.GetOrganizationsAsync();
        var defaultOrg = orgs.FirstOrDefault();
        if (defaultOrg != null)
        {
            var branches = await BranchService.GetBranchesAsync(defaultOrg.Id);
            _defaultBranchId = branches.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        
        await LoadClassroomsAsync();

        if (_classrooms != null && !_classrooms.Any() && _defaultBranchId != Guid.Empty)
        {
            await InsertSampleDataAsync();
        }
    }

    private async Task LoadClassroomsAsync()
    {
        if (_defaultBranchId != Guid.Empty)
        {
            _classrooms = await ClassroomService.GetClassroomsAsync(_defaultBranchId);
        }
    }

    private async Task InsertSampleDataAsync()
    {
        await ClassroomService.CreateClassroomAsync(_defaultBranchId, "Bluebirds", "3–4", 18, "Indoor");
        await ClassroomService.CreateClassroomAsync(_defaultBranchId, "Sunflowers", "4–5", 16, "Indoor");
        await LoadClassroomsAsync();
    }

    private void OpenAddClassroomModal()
    {
        _currentClassroom = new Classroom { AgeGroup = "3-4", Capacity = 15, Environment = "Indoor" };
        _isEditing = false;
        _isModalOpen = true;
    }

    private void OpenEditClassroomModal(Classroom classroom)
    {
        _currentClassroom = new Classroom
        {
            Id = classroom.Id,
            TenantId = classroom.TenantId,
            BranchId = classroom.BranchId,
            Name = classroom.Name,
            AgeGroup = classroom.AgeGroup,
            Capacity = classroom.Capacity,
            Environment = classroom.Environment,
            IsActive = classroom.IsActive
        };
        _isEditing = true;
        _isModalOpen = true;
    }

    private void CloseDialog()
    {
        _isModalOpen = false;
    }

    private async Task SaveClassroomAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentClassroom.Name))
        {
            return;
        }

        if (_isEditing)
        {
            await ClassroomService.UpdateClassroomAsync(_currentClassroom);
        }
        else
        {
            await ClassroomService.CreateClassroomAsync(
                _defaultBranchId,
                _currentClassroom.Name,
                _currentClassroom.AgeGroup,
                _currentClassroom.Capacity,
                _currentClassroom.Environment ?? "Indoor");
        }

        await LoadClassroomsAsync();
        CloseDialog();
    }

    private async Task DeleteClassroomAsync()
    {
        if (_currentClassroom.Id != Guid.Empty)
        {
            await ClassroomService.DeleteClassroomAsync(_currentClassroom.Id);
            await LoadClassroomsAsync();
            CloseDialog();
        }
    }
}
