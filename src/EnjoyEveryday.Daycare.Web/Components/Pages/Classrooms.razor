@page "/classrooms"

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject OrganizationService OrgService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject NavigationManager NavigationManager
<div class="content">
    <PageHero Eyebrow="ENVIRONMENT"
              Title="Classrooms"
              Subtitle="Experiences begin with the environment.">
        <RightContent>
            <a id="addClassroomButton" href="/classrooms/new" class="button primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; padding: 8px 16px; border-radius: 4px; font-weight: 500; background-color: #52745e; color: white;">
                + Add classroom
            </a>
        </RightContent>
    </PageHero>

    <div style="margin-bottom: 24px;">
        <select @bind="SelectedBranchId" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 13px; cursor: pointer;">
            <option value="@Guid.Empty">All Branches</option>
            @foreach (var branch in _branches.Values)
            {
                <option value="@branch.Id">@branch.Name</option>
            }
        </select>
    </div>

    <div id="classroomGrid" class="people-grid">
        @if (_classrooms != null && _classrooms.Any())
        {
            @foreach (var classroom in _classrooms)
            {
                var branchName = _branches.TryGetValue(classroom.BranchId, out var b) ? b.Name : "Unassigned Branch";
                <div @onclick='() => NavigationManager.NavigateTo($"/classrooms/view/{classroom.Id}")' style="cursor: pointer;">
                    <PersonCard AvatarInitials="@(classroom.Name?.FirstOrDefault().ToString() ?? "C")"
                                PhotoUrl="@classroom.PhotoUrl"
                                Name="@classroom.Name"
                                Subtitle="@($"{branchName} • {classroom.Capacity ?? 18} children · Ages {classroom.AgeGroup ?? "3–4"}")"
                                Status="@(classroom.Status)"
                                Progress="@classroom.ProfileCompletionPercentage"
                                HighlightTitle="Environment"
                                HighlightText="@(classroom.Environment ?? "Indoor")" />
                </div>
            }
        }
        else if (_classrooms != null && !_classrooms.Any())
        {
            <p>No classrooms found.</p>
        }
    </div>

</div>
@code {
    private IEnumerable<Classroom>? _classrooms;
    private Dictionary<Guid, Branch> _branches = new();
    
    private Guid _selectedBranchId = Guid.Empty;
    private Guid SelectedBranchId
    {
        get => _selectedBranchId;
        set
        {
            if (_selectedBranchId != value)
            {
                _selectedBranchId = value;
                _ = LoadClassroomsAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrgService.GetOrganizationsAsync();
        var defaultOrg = orgs.FirstOrDefault();
        if (defaultOrg != null)
        {
            var branchesList = await BranchService.GetBranchesAsync(defaultOrg.Id);
            _branches = branchesList.ToDictionary(b => b.Id);
        }

        await LoadClassroomsAsync();
    }

    private async Task LoadClassroomsAsync()
    {
        if (_selectedBranchId != Guid.Empty)
        {
            _classrooms = await ClassroomService.GetClassroomsAsync(_selectedBranchId);
        }
        else
        {
            _classrooms = await ClassroomService.GetAllClassroomsAsync();
        }
        StateHasChanged();
    }
}
