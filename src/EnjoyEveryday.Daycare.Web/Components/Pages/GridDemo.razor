@page "/grid-demo"
@using EnjoyEveryday.UI.Shared.Components.DataGrid
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>DataGrid Demo — EnjoyEveryday</PageTitle>

<div class="content">
    <EnjoyDataGrid TItem="ClassroomDemoModel"
                   Items="@_classrooms.AsQueryable()"
                   ShowHeader="false"
                   EnableSearch="false"
                   EnablePagination="true"
                   PageSize="6">
        <ChildContent>
            <PropertyColumn TGridItem="ClassroomDemoModel" TProp="string" Property="@(c => c.Name)" Title="Classroom" Sortable="true" />
            <PropertyColumn TGridItem="ClassroomDemoModel" TProp="string" Property="@(c => c.Branch)" Title="Branch" Sortable="true" />
            <PropertyColumn TGridItem="ClassroomDemoModel" TProp="string" Property="@(c => c.AgeGroup)" Title="Age Group" Sortable="true" />
            <TemplateColumn TGridItem="ClassroomDemoModel" Title="Capacity" Sortable="true" SortBy="@_sortByEnrolled">
                <span>@context.Enrolled / @context.Capacity</span>
            </TemplateColumn>
            <PropertyColumn TGridItem="ClassroomDemoModel" TProp="string" Property="@(c => c.LeadTeacher)" Title="Lead Teacher" Sortable="true" />
            <TemplateColumn TGridItem="ClassroomDemoModel" Title="Status">
                <span>@(context.IsActive ? "Active" : "Closed")</span>
            </TemplateColumn>
        </ChildContent>
    </EnjoyDataGrid>
</div>

@code {
    public class ClassroomDemoModel
    {
        public string Name { get; set; } = string.Empty;
        public string Branch { get; set; } = string.Empty;
        public string AgeGroup { get; set; } = string.Empty;
        public int Enrolled { get; set; }
        public int Capacity { get; set; }
        public string LeadTeacher { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }

    private static readonly GridSort<ClassroomDemoModel> _sortByEnrolled =
        GridSort<ClassroomDemoModel>.ByDescending(c => c.Enrolled);

    private readonly List<ClassroomDemoModel> _classrooms = new()
    {
        new() { Name = "Bluebirds", Branch = "Downtown", AgeGroup = "3-4 yrs", Enrolled = 14, Capacity = 16, LeadTeacher = "Sarah Jenkins", IsActive = true },
        new() { Name = "Sunflowers", Branch = "Downtown", AgeGroup = "4-5 yrs", Enrolled = 16, Capacity = 16, LeadTeacher = "Marcus Rivera", IsActive = true },
        new() { Name = "Rainbow Room", Branch = "Westside", AgeGroup = "2-3 yrs", Enrolled = 11, Capacity = 12, LeadTeacher = "Elena Rostova", IsActive = true },
        new() { Name = "Little Explorers", Branch = "North Branch", AgeGroup = "1-2 yrs", Enrolled = 8, Capacity = 8, LeadTeacher = "David Chen", IsActive = true },
        new() { Name = "Acorns Infant Care", Branch = "Downtown", AgeGroup = "0-1 yrs", Enrolled = 6, Capacity = 6, LeadTeacher = "Chloe Dubois", IsActive = true },
        new() { Name = "Caterpillars", Branch = "Westside", AgeGroup = "2-3 yrs", Enrolled = 10, Capacity = 12, LeadTeacher = "Amina Hassan", IsActive = true },
        new() { Name = "Dolphins", Branch = "North Branch", AgeGroup = "4-5 yrs", Enrolled = 15, Capacity = 18, LeadTeacher = "Liam O'Connor", IsActive = true },
        new() { Name = "Willow Toddlers", Branch = "Downtown", AgeGroup = "1-2 yrs", Enrolled = 7, Capacity = 8, LeadTeacher = "Priya Patel", IsActive = false }
    };
}
