<section class="content" style="padding: 34px; max-width: 1600px; margin: auto;">

    <div class="page-header">
        <div>
            <div class="eyebrow">Organization View</div>
            <h1>Your whole organization, in one view.</h1>
            <p class="header-description">
                See how your branches are creating everyday experiences for children,
                where teams need support, and where something beautiful is happening.
            </p>
        </div>
        <div class="header-actions">
            <button class="btn" @onclick="GoToCreateBranch">＋ Add Branch</button>
            <button class="btn primary">View Organization Report</button>
        </div>
    </div>

    @if (OrgMetrics != null)
    {
        <div class="summary-grid">
            <OrgSummaryCard 
                Label="Branches" 
                Value="@OrgMetrics.TotalBranches.ToString()" 
                PositiveHighlight="@(OrgMetrics.TotalBranches == OrgMetrics.ActiveBranchCount ? "All active" : $"{OrgMetrics.ActiveBranchCount} active")" />
            <OrgSummaryCard 
                Label="Children experiencing today" 
                Value="@OrgMetrics.ChildrenExperiencingToday.ToString()" 
                DetailText="@($"Across {OrgMetrics.TotalClassrooms} classrooms")" />
            <OrgSummaryCard 
                Label="Experiences this week" 
                Value="@OrgMetrics.ExperiencesThisWeek.ToString()" 
                DetailText="@($"{OrgMetrics.ExperiencesThisWeekCompleted} completed · {OrgMetrics.ExperiencesThisWeekUpcoming} upcoming")" />
            <OrgSummaryCard 
                Label="Teacher-created experiences" 
                Value="@OrgMetrics.TeacherCreatedExperiences.ToString()" 
                PositiveHighlight="@($"+{OrgMetrics.TeacherCreatedExperiencesThisMonth}")" 
                DetailText="this month" />
        </div>
    }

    <OrgPulse 
        Icon="🌱" 
        Title="The organization feels alive this week." 
        Text="Children are exploring, creating and working together across all branches. Teachers are adapting experiences frequently — a good sign that the weekly rhythm is supporting curiosity rather than becoming a rigid schedule." 
        ActionText="See what I'm noticing" />

    <div class="toolbar">
        <FilterTabs Tabs="BranchFilters" ActiveTab="@ActiveTab" OnTabSelected="OnTabSelected" />
        <input class="search" type="text" placeholder="Search branches..." @bind="SearchTerm" @bind:event="oninput" />
    </div>

    <div class="branch-grid">
        @if (FilteredBranches != null)
        {
            @if (!FilteredBranches.Any())
            {
                <div class="empty-state">
                    <p>No branches found.</p>
                </div>
            }
            else
            {
                @foreach (var branch in FilteredBranches)
                {
                    <OrgBranchCard 
                        Icon="🌿" 
                        Name="@branch.BranchName" 
                        Location="@branch.Location" 
                        StatusClass="@(branch.AttentionStatus.Contains("support") ? "attention" : branch.AttentionStatus.Contains("Quiet") ? "quiet" : "good")" 
                        StatusText="@branch.AttentionStatus"
                        Children="@branch.Children" 
                        Classrooms="@branch.Classrooms" 
                        Experiences="@branch.Experiences" 
                        RhythmPercent="@branch.ExperienceRhythm" 
                        Note="@branch.RecentInsight"
                        TeacherInitials="@(new List<string> { "P", "M", "A" })" 
                        OnViewClick="@(() => GoToBranchDetail(branch.BranchId))" />
                }
            }
        }
    </div>

    <div class="lower-grid">
        <OrgPanel Title="Experience rhythm across the organization" Subtitle="What children are experiencing most often" ActionText="Explore">
            <RhythmRow Name="Explore" Percent="86" Color="#8ca891" />
            <RhythmRow Name="Create" Percent="78" Color="#9eafa3" />
            <RhythmRow Name="Together" Percent="71" Color="#b0b9a9" />
            <RhythmRow Name="Move" Percent="64" Color="#b9c1b4" />
            <RhythmRow Name="Imagine" Percent="58" Color="#c3c8bc" />
        </OrgPanel>

        <OrgPanel Title="What EnjoyEveryday is noticing" Subtitle="Organization-level signals" ActionText="See all">
            <InsightRow Label="Emerging interest" Text="Building experiences are appearing across three branches. Bridges and shelters are especially popular." />
            <AlertRow Title="Planning gap" Text="West branch has very few experiences planned for next week." />
        </OrgPanel>
    </div>

</section>

@code {
    private OrganizationMetrics? OrgMetrics;
    private IEnumerable<BranchMetrics>? Branches;
    
    private string SearchTerm = "";
    private string ActiveTab = "all";

    private IEnumerable<BranchMetrics>? FilteredBranches =>
        Branches?.Where(b => 
            (ActiveTab == "all" || 
            (ActiveTab == "attention" && b.AttentionStatus.Contains("support", StringComparison.OrdinalIgnoreCase)) ||
            (ActiveTab == "quiet" && b.AttentionStatus.Contains("Quiet", StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(SearchTerm) || b.BranchName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || b.Location.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        );

    private List<FilterTabs.TabItem> BranchFilters = new()
    {
        new FilterTabs.TabItem { Text = "All branches", Value = "all" },
        new FilterTabs.TabItem { Text = "Needs attention", Value = "attention" },
        new FilterTabs.TabItem { Text = "Quiet this week", Value = "quiet" }
    };

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();

        if (org != null)
        {
            OrgMetrics = await DashboardService.GetOrganizationMetricsAsync(org.Id);
            Branches = await DashboardService.GetBranchMetricsAsync(org.Id);
        }
    }

    private void OnTabSelected(string tab)
    {
        ActiveTab = tab;
    }

    private void GoToCreateBranch()
    {
        NavigationManager.NavigateTo("/management/branches/new");
    }

    private void GoToBranchDetail(Guid branchId)
    {
        NavigationManager.NavigateTo($"/management/branches/{branchId}");
    }
}
