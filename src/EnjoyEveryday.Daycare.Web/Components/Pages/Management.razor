@page "/management"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Organization

<PageTopbar Breadcrumb="Organization · 4 branches" Title="Little Stars Daycare">
    <RightContent>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">♢</button>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">?</button>
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #dce9df; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #365844; margin-left: 8px;">
            BK
        </div>
    </RightContent>
</PageTopbar>

<section class="content" style="padding: 34px; max-width: 1600px; margin: auto;">

    <div class="page-header">
        <div>
            <div class="eyebrow">Organization View</div>
            <h1>Your whole organization, in one view.</h1>
            <p class="header-description">
                See how your branches are creating everyday experiences for children,
                where teams need support, and where something beautiful is happening.
            </p>
        </div>
        <div class="header-actions">
            <button class="btn">＋ Add Branch</button>
            <button class="btn primary">View Organization Report</button>
        </div>
    </div>

    <div class="summary-grid">
        <OrgSummaryCard 
            Label="Branches" 
            Value="4" 
            PositiveHighlight="All active" />
        <OrgSummaryCard 
            Label="Children experiencing today" 
            Value="286" 
            DetailText="Across 22 classrooms" />
        <OrgSummaryCard 
            Label="Experiences this week" 
            Value="94" 
            DetailText="81 completed · 13 upcoming" />
        <OrgSummaryCard 
            Label="Teacher-created experiences" 
            Value="37" 
            PositiveHighlight="+8" 
            DetailText="this month" />
    </div>

    <OrgPulse 
        Icon="🌱" 
        Title="The organization feels alive this week." 
        Text="Children are exploring, creating and working together across all four branches. Teachers are adapting experiences frequently — a good sign that the weekly rhythm is supporting curiosity rather than becoming a rigid schedule." 
        ActionText="See what I'm noticing" />

    <div class="toolbar">
        <FilterTabs Tabs="BranchFilters" ActiveTab="all" OnTabSelected="(val) => {}" />
        <input class="search" type="text" placeholder="Search branches..." />
    </div>

    <div class="branch-grid">
        <OrgBranchCard 
            Icon="🌿" Name="Downtown" Location="72 King Street" 
            StatusClass="good" StatusText="Healthy rhythm"
            Children="84" Classrooms="7" Experiences="31" 
            RhythmPercent="92" 
            Note="Teachers are adapting experiences often. Building and outdoor exploration are especially popular this week."
            TeacherInitials="@(new List<string> { "P", "M", "A" })" />

        <OrgBranchCard 
            Icon="🌳" Name="North" Location="18 Maple Avenue" 
            StatusClass="good" StatusText="Healthy rhythm"
            Children="76" Classrooms="6" Experiences="26" 
            RhythmPercent="87" 
            Note="Children have been especially interested in animals, stories and imaginative play."
            TeacherInitials="@(new List<string> { "S", "J", "R" })" />

        <OrgBranchCard 
            Icon="☀️" Name="West" Location="104 Cedar Road" 
            StatusClass="attention" StatusText="Needs support"
            Children="68" Classrooms="5" Experiences="18" 
            RhythmPercent="69" 
            Note="Two classrooms have been replacing planned experiences frequently. The team may need more flexible ideas requiring little preparation."
            TeacherInitials="@(new List<string> { "K", "N" })" />

        <OrgBranchCard 
            Icon="🌊" Name="Lakeside" Location="6 Willow Lane" 
            StatusClass="quiet" StatusText="Quiet week"
            Children="58" Classrooms="4" Experiences="19" 
            RhythmPercent="73" 
            Note="Outdoor experiences dropped this week because of weather. Indoor creative experiences are increasing."
            TeacherInitials="@(new List<string> { "D", "L" })" />
    </div>

    <div class="lower-grid">
        <OrgPanel Title="Experience rhythm across the organization" Subtitle="What children are experiencing most often" ActionText="Explore">
            <RhythmRow Name="Explore" Percent="86" Color="#8ca891" />
            <RhythmRow Name="Create" Percent="78" Color="#9eafa3" />
            <RhythmRow Name="Together" Percent="71" Color="#b0b9a9" />
            <RhythmRow Name="Move" Percent="64" Color="#b9c1b4" />
            <RhythmRow Name="Imagine" Percent="58" Color="#c3c8bc" />
        </OrgPanel>

        <OrgPanel Title="What EnjoyEveryday is noticing" Subtitle="Organization-level signals" ActionText="See all">
            <InsightRow Label="Emerging interest" Text="Building experiences are appearing across three branches. Bridges and shelters are especially popular." />
            <AlertRow Title="Planning gap" Text="West branch has very few experiences planned for next week." />
        </OrgPanel>
    </div>

</section>

@code {
    private List<FilterTabs.TabItem> BranchFilters = new()
    {
        new FilterTabs.TabItem { Text = "All branches", Value = "all" },
        new FilterTabs.TabItem { Text = "Needs attention", Value = "attention" },
        new FilterTabs.TabItem { Text = "Quiet this week", Value = "quiet" }
    };
}
