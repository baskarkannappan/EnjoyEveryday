@page "/classroom-messages"
@page "/messages"
@using System.Threading.Tasks
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Daycare.Web.Services
@using EnjoyEveryday.Daycare.Web.Hubs
@using EnjoyEveryday.UI.Shared.Components.Communication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

@inject DaycareRealtimeNotificationCenter NotificationCenter
@inject IHubContext<ClassroomChatHub> HubContext

<PageTitle>Classroom Messages — EnjoyEveryday</PageTitle>

<ClassroomMessagesView @ref="_messagesView"
                       OnNotificationSent="BroadcastLiveHubNotification" />

@code {
    private ClassroomMessagesView? _messagesView;

    protected override void OnInitialized()
    {
        NotificationCenter.OnParentMessageReceived += HandleLiveIncomingMessage;
    }

    private async Task HandleLiveIncomingMessage(ParentMessageNotification notification)
    {
        if (_messagesView != null)
        {
            await _messagesView.HandleExternalIncomingMessage(notification);
        }
    }

    private async Task BroadcastLiveHubNotification(ParentMessageNotification notification)
    {
        try
        {
            await HubContext.Clients.Group($"child_{notification.ChildId}").SendAsync("ReceiveEducatorMessage", notification);
            await HubContext.Clients.Group($"tenant_{notification.TenantId}").SendAsync("ReceiveEducatorMessage", notification);
            if (notification.ClassroomId.HasValue)
            {
                await HubContext.Clients.Group($"classroom_{notification.ClassroomId.Value}").SendAsync("ReceiveEducatorMessage", notification);
            }
        }
        catch
        {
            // Background broadcast failure tolerance
        }
    }

    public void Dispose()
    {
        NotificationCenter.OnParentMessageReceived -= HandleLiveIncomingMessage;
    }
}
