@page "/classroom"
@page "/my-classroom"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ActiveSessionModal
@using EnjoyEveryday.UI.Shared.Components.ChildJourney
@using EnjoyEveryday.UI.Shared.Components.OperationsBoard
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@inject IDaycareOperationsBoardService OperationsBoardService
@inject ClassroomService ClassroomService
@inject ExecutionService ExecutionService
@inject PlannerService PlannerService
@inject IClassroomCommunicationService CommunicationService
@inject IChildDailyCareService DailyCareService
@inject AttendanceService AttendanceService
@inject IEndOfDayService EndOfDayService
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject Microsoft.Extensions.Logging.ILogger<TeacherWorkspace> Logger

@implements IDisposable

<PageTitle>My Classroom — EnjoyEveryday</PageTitle>

<div class="content teacher-workspace-page">
    @if (_loading)
    {
        <LoadingState Text="Preparing today's teaching workspace and classroom rhythm..." />
    }
    else if (_teacherClassrooms.Count == 0)
    {
        <!-- ================= EMPTY STATE: NO ASSIGNED CLASSROOM ================= -->
        <div class="teacher-empty-card">
            <div class="empty-icon-pill">
                <FluentIcon Value="@(new Icons.Regular.Size32.Door())" Color="Color.Custom" CustomColor="#3e5c49" />
            </div>
            <h2 class="empty-title">Welcome, @GetTeacherDisplayName()!</h2>
            <p class="empty-text">
                You are currently signed in as an educator, but no active classroom has been assigned to your account yet.
            </p>
            <div class="empty-notice-box">
                <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="Color.Custom" CustomColor="#3e5c49" />
                <span>Please contact your Branch Director or Administrator to assign you to your classroom roster.</span>
            </div>
            <div class="empty-actions">
                <a href="/profile" class="btn secondary">View My Profile</a>
                <a href="/classroom-messages" class="btn secondary">Check Messages</a>
                @if (AvailableViews.Count > 1)
                {
                    <button class="primary" @onclick='() => OnChangeView.InvokeAsync("BranchAdmin")'>
                        Switch to Branch View &rarr;
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ================= SECTION A: HERO GREETING ================= -->
        <div class="teacher-hero-header">
            <div class="header-top-row">
                <div class="classroom-eyebrow">
                    @if (_teacherClassrooms.Count > 1)
                    {
                        <div class="classroom-dropdown-wrap">
                            <span class="eyebrow-text">MY CLASSROOM • @(IsLeadTeacher ? "LEAD TEACHER • " : "")</span>
                            <select class="classroom-select-pill" @onchange="HandleClassroomSelected" value="@(_selectedClassroomId?.ToString() ?? "")">
                                @foreach (var room in _teacherClassrooms)
                                {
                                    <option value="@room.Id">@room.Name (@(string.IsNullOrEmpty(room.AgeGroup) ? "General" : room.AgeGroup))</option>
                                }
                            </select>
                        </div>
                    }
                    else if (IsLeadTeacher)
                    {
                        <span class="eyebrow-text">MY CLASSROOM • LEAD TEACHER COORDINATION • @(_activeClassroom?.Name?.ToUpperInvariant() ?? "CLASSROOM")</span>
                    }
                    else
                    {
                        <span class="eyebrow-text">MY CLASSROOM • @(_activeClassroom?.Name?.ToUpperInvariant() ?? "CLASSROOM")</span>
                    }
                </div>

                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="staff-break-pill @(_isOnBreak ? "break-active" : "")" @onclick="ToggleStaffBreak">
                        <span>☕</span>
                        <span>@(_isOnBreak ? "On Break (Click to Return)" : "Staff Break")</span>
                    </button>

                    @if (AvailableViews.Count > 1)
                    {
                        <div class="role-override-wrapper">
                            <select class="role-selector-pill" @onchange="e => OnChangeView.InvokeAsync(e.Value?.ToString() ?? string.Empty)" value="@(IsLeadTeacher ? "LeadTeacher" : "Teacher")">
                                @foreach (var v in AvailableViews)
                                {
                                    <option value="@v">@GetViewDisplayName(v) View</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>

            @if (_isDaycareClosed)
            {
                <div class="daycare-closed-banner">
                    <div class="closed-banner-left">
                        <span class="closed-icon">🌙</span>
                        <div>
                            <div class="closed-title">Daycare is Closed for the Day</div>
                            <div class="closed-subtitle">Operating hours ended at 7:00 PM. Classroom arrivals, attendance, and new learning sessions are closed until tomorrow morning.</div>
                        </div>
                    </div>
                    <span class="closed-status-pill">CLOSED</span>
                </div>
            }

            @if (_isOnBreak)
            {
                <div class="staff-break-banner">
                    <div class="staff-break-banner-left">
                        <span>☕</span>
                        <span>Staff Break in Progress — Started at @(_breakStartTime?.ToString("h:mm tt") ?? "now"). Classroom ratio active.</span>
                    </div>
                    <button class="btn primary sm" @onclick="ToggleStaffBreak">✓ End Break &amp; Return</button>
                </div>
            }

            <h1 class="greeting-heading">@GetGreeting()!</h1>
            <p class="greeting-subtitle">@(_activeClassroom != null ? $"{_activeClassroom.Name} • {(_classroomChildren.Count(c => c.IsCheckedIn))} checked in today" : "Let's make today a wonderful day for the children.")</p>

            @if (_teacherClassrooms.Count > 1)
            {
                <div class="multi-classroom-switcher-bar">
                    <div class="classroom-switcher-title">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Door())" Color="Color.Custom" CustomColor="#52745e" />
                        <span>Assigned Classrooms:</span>
                    </div>
                    <div class="classroom-switcher-tabs">
                        @foreach (var room in _teacherClassrooms)
                        {
                            var isCurrent = room.Id == _selectedClassroomId;
                            <button type="button" 
                                    class="classroom-switch-btn @(isCurrent ? "active-room" : "")" 
                                    @onclick="() => SelectClassroomAsync(room.Id)">
                                <span class="room-icon">🏫</span>
                                <span class="room-name">@room.Name</span>
                                <span class="room-pill">@(string.IsNullOrEmpty(room.AgeGroup) ? "Room" : room.AgeGroup)</span>
                                @if (isCurrent)
                                {
                                    <span class="active-indicator">● Active</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ================= SECTION: DAYCARE PROGRESS TIMELINE ================= -->
        <div class="day-timeline-card" aria-label="Daycare Day Timeline">
            <div class="day-timeline-header">
                <div class="timeline-title-wrap">
                    <span class="timeline-pulse-dot @(_isDaycareClosed ? "closed" : "active")"></span>
                    <span class="timeline-eyebrow">DAYCARE RHYTHM TIMELINE</span>
                </div>
                <div class="timeline-meta-wrap">
                    @if (_isDaycareClosed)
                    {
                        <span class="timeline-closed-pill">🌙 Closed • End of Day Auto-Closed (7:00 PM)</span>
                    }
                    else
                    {
                        <span class="timeline-open-pill">Operating Hours: 7:00 AM – 7:00 PM • Auto-closes at 7:00 PM</span>
                    }
                </div>
            </div>

            <div class="day-timeline-track">
                <!-- Node 1: (started) -->
                <div class="timeline-node node-started @(_isDaycareClosed ? "completed" : "active")" title="Daycare operating day started at 7:00 AM">
                    <div class="node-pill">
                        <span class="node-icon">🌅</span>
                        <span class="node-text">(started)</span>
                    </div>
                    <div class="node-time-wrap">
                        <span class="node-time">7:00 AM</span>
                        <span class="node-sub">Day Started</span>
                    </div>
                </div>

                <!-- Connector 1 -->
                <div class="timeline-connector" aria-hidden="true">
                    <span class="arrow-symbol">➔</span>
                </div>

                <!-- Node 2: (6 children and 2 teacher present) -->
                <div class="timeline-node node-present @(GetChildrenPresentCount() > 0 ? "active" : "")"
                     @onclick='() => Navigation.NavigateTo("/management/attendance")'
                     title="View Classroom Attendance Desk">
                    <div class="node-pill">
                        <span class="node-icon">👥</span>
                        <span class="node-text">(@GetChildrenPresentCount() children and @GetTeachersPresentCount() teacher present)</span>
                    </div>
                    <div class="node-time-wrap">
                        <span class="node-time">@GetAttendanceTimeDisplay()</span>
                        <span class="node-sub">Live Roster</span>
                    </div>
                </div>

                <!-- Connector 2 -->
                <div class="timeline-connector" aria-hidden="true">
                    <span class="arrow-symbol">➔</span>
                </div>

                <!-- Node 3: 4 activity planned (1 started) -->
                <div class="timeline-node node-activities @(GetStartedActivitiesCount() > 0 ? "active" : "")"
                     @onclick='() => Navigation.NavigateTo("/today-activities")'
                     title="View Today's Activities">
                    <div class="node-pill">
                        <span class="node-icon">🎨</span>
                        <span class="node-text">@GetPlannedActivitiesCount() activity planned (@GetStartedActivitiesCount() started)</span>
                    </div>
                    <div class="node-time-wrap">
                        <span class="node-time">@GetActivityTimeDisplay()</span>
                        <span class="node-sub">@(GetStartedActivitiesCount() > 0 ? $"{GetStartedActivitiesCount()} in progress" : "Scheduled")</span>
                    </div>
                </div>

                <!-- Connector 3 -->
                <div class="timeline-connector" aria-hidden="true">
                    <span class="arrow-symbol">➔</span>
                </div>

                <!-- Node 4: (ended) -->
                <div class="timeline-node node-ended @(_isDaycareClosed ? "completed" : "pending")"
                     @onclick="HandleTimelineEndedClickAsync"
                     title="@(_isDaycareClosed ? "Daycare day ended. Remaining attendances and active activities were auto-closed at 7:00 PM." : "At 7:00 PM closing time, any active activity is auto closed and open attendances are auto checked out.")">
                    <div class="node-pill">
                        <span class="node-icon">🌙</span>
                        <span class="node-text">(ended)</span>
                    </div>
                    <div class="node-time-wrap">
                        <span class="node-time">7:00 PM</span>
                        <span class="node-sub">@(_isDaycareClosed ? "Closed" : "Auto-Close")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SECTION B: THREE STAT CARDS (Screenshot 1 Match) ================= -->
        <div class="stats-row">
            <!-- 1. Present -->
            <div class="stat-card" @onclick='() => Navigation.NavigateTo("/management/attendance")' title="Open Attendance Desk">
                <div class="stat-icon-wrap">
                    <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())" Color="Color.Custom" CustomColor="#52745e" />
                </div>
                <div class="stat-number">
                    @_board.CheckedInChildrenCount<span class="stat-denom">/@_board.ExpectedChildrenCount</span>
                </div>
                <div class="stat-label">Present</div>
            </div>

            <!-- 2. Activities -->
            <div class="stat-card" @onclick='() => Navigation.NavigateTo("/experiences")' title="View Scheduled Activities">
                <div class="stat-icon-wrap">
                    <FluentIcon Value="@(new Icons.Regular.Size24.CalendarMonth())" Color="Color.Custom" CustomColor="#52745e" />
                </div>
                <div class="stat-number">@_board.PlannedExperiencesCount</div>
                <div class="stat-label">Activities</div>
            </div>

            <!-- 3. Tasks Left -->
            <div class="stat-card" @onclick='() => Navigation.NavigateTo("/daily-care")' title="View Classroom Care Tasks">
                <div class="stat-icon-wrap">
                    <FluentIcon Value="@(new Icons.Regular.Size24.CheckmarkCircle())" Color="Color.Custom" CustomColor="#52745e" />
                </div>
                <div class="stat-number">@GetPendingTasksCount()</div>
                <div class="stat-label">Tasks left</div>
            </div>
        </div>

        <!-- ================= SECTION C: LEAD TEACHER COORDINATION SHORTCUTS ================= -->
        @if (IsLeadTeacher)
        {
            <div class="lead-teacher-coordination-section">
                <div class="coordination-header-row">
                    <div>
                        <h2 class="coordination-title">
                            <span class="coordination-badge">LEAD TEACHER</span>
                            Classroom Delivery &amp; Team Coordination
                        </h2>
                        <p class="coordination-sub">Oversee classroom readiness, daily care logs, team tasks and staff coverage</p>
                    </div>
                </div>

                <div class="coordination-shortcuts-grid">
                    <!-- 1. Classroom Readiness -->
                    <div class="action-card-btn" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/classrooms")'>
                        <div class="action-card-icon icon-box-leaf">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Building())" Color="Color.Custom" CustomColor="#276749" />
                        </div>
                        <div class="action-card-text">
                            <strong>Classroom Readiness</strong>
                            <span>Environment &amp; room setup</span>
                        </div>
                    </div>

                    <!-- 2. Team Tasks & Handover -->
                    <div class="action-card-btn" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/daily-care")'>
                        <div class="action-card-icon icon-box-blue">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())" Color="Color.Custom" CustomColor="#2b6cb0" />
                        </div>
                        <div class="action-card-text">
                            <strong>Team Tasks &amp; Handover</strong>
                            <span>Classroom shift handover</span>
                        </div>
                    </div>

                    <!-- 3. Review Daily Logs -->
                    <div class="action-card-btn" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/daily-care")'>
                        <div class="action-card-icon icon-box-amber">
                            <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardTask())" Color="Color.Custom" CustomColor="#8c5717" />
                        </div>
                        <div class="action-card-text">
                            <strong>Review Daily Logs</strong>
                            <span>Verify teacher care logs</span>
                        </div>
                    </div>

                    <!-- 4. Review Experience Feedback -->
                    <div class="action-card-btn" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/experiences")'>
                        <div class="action-card-icon icon-box-teal">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Sparkle())" Color="Color.Custom" CustomColor="#22543d" />
                        </div>
                        <div class="action-card-text">
                            <strong>Experience Feedback</strong>
                            <span>Curriculum &amp; session notes</span>
                        </div>
                    </div>

                    <!-- 5. Request Staff Coverage -->
                    <div class="action-card-btn" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/management/roster")'>
                        <div class="action-card-icon icon-box-purple">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PersonCall())" Color="Color.Custom" CustomColor="#553c9a" />
                        </div>
                        <div class="action-card-text">
                            <strong>Request Coverage</strong>
                            <span>Staffing gaps &amp; coverage</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ================= SECTION D: CLASSROOM LIVE ACTION COCKPIT ================= -->
        <div class="cockpit-section">
            <div class="cockpit-header">
                <div class="cockpit-title-wrap">
                    <h2>
                        <FluentIcon Value="@(new Icons.Regular.Size20.PeopleCommunity())" Color="Color.Custom" CustomColor="#52745e" />
                        Classroom Live Roster &amp; Action Cockpit
                    </h2>
                    <p>Execute attendance, diaper changes, meals, rest sessions, and moments with 1 tap.</p>
                </div>
                <div class="cockpit-batch-bar">
                    <button class="batch-btn primary-batch" @onclick="MarkAllScheduledPresentAsync" title="Mark all expected children present">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Custom" CustomColor="#ffffff" />
                        <span>Check-In All</span>
                    </button>
                    <button class="batch-btn" @onclick="() => _showGroupSnackModal = true" title="Record group snack for all checked-in children">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Food())" Color="Color.Custom" CustomColor="#52745e" />
                        <span>Group Snack</span>
                    </button>
                    <button class="batch-btn" @onclick="StartGroupNapAsync" title="Start rest time for all present awake children">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Bed())" Color="Color.Custom" CustomColor="#3730a3" />
                        <span>Group Rest</span>
                    </button>
                </div>
            </div>

            <!-- Filter tabs -->
            <div class="cockpit-filters">
                <button class="cockpit-filter-pill @(_rosterFilter == "All" ? "active" : "")" @onclick='() => _rosterFilter = "All"'>
                    All Children (@_classroomChildren.Count)
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "Present" ? "active" : "")" @onclick='() => _rosterFilter = "Present"'>
                    Checked In (@_classroomChildren.Count(c => c.IsCheckedIn))
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "Expected" ? "active" : "")" @onclick='() => _rosterFilter = "Expected"'>
                    Awaiting Check-In (@_classroomChildren.Count(c => !c.IsCheckedIn && c.AttendanceStatus != "Absent" && c.AttendanceStatus != "CheckedOut"))
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "OutAbsent" ? "active" : "")" @onclick='() => _rosterFilter = "OutAbsent"'>
                    Absent / Checked Out (@_classroomChildren.Count(c => c.AttendanceStatus == "Absent" || c.AttendanceStatus == "CheckedOut"))
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "Resting" ? "active" : "")" @onclick='() => _rosterFilter = "Resting"'>
                    Resting (@_classroomChildren.Count(c => c.IsCheckedIn && c.ActiveNapSession != null))
                </button>
            </div>

            <!-- Roster Cards Grid -->
            @if (!_classroomChildren.Any())
            {
                <div style="padding: 24px; text-align: center; color: var(--muted, #6c7870); font-size: 13.5px;">
                    No children currently enrolled in @(_activeClassroom?.Name ?? "this classroom").
                </div>
            }
            else
            {
                var filtered = GetFilteredChildren();
                <div class="roster-grid">
                    @foreach (var child in filtered)
                    {
                        bool isSleeping = child.IsCheckedIn && child.ActiveNapSession != null;
                        <div class="child-card @(isSleeping ? "is-resting" : "")">
                            <div class="child-card-header">
                                <div class="child-meta-left">
                                    <div class="child-avatar">
                                        @(GetChildInitials(child.ChildName))
                                    </div>
                                    <div class="child-name-wrap">
                                        <h4 class="child-name">@child.ChildName</h4>
                                        <div class="child-sub">
                                            @if (child.IsCheckedIn && child.ArrivalTime.HasValue)
                                            {
                                                <span>Arrived @FormatTimeSpan(child.ArrivalTime.Value)</span>
                                            }
                                            else if (child.AttendanceStatus == "CheckedOut")
                                            {
                                                <span>Departed @(child.DepartureTime.HasValue ? FormatTimeSpan(child.DepartureTime.Value) : "")</span>
                                            }
                                            else
                                            {
                                                <span>@(child.AttendanceStatus ?? "Expected today")</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    @if (isSleeping)
                                    {
                                        <span class="child-badge badge-resting"><span class="pulse-dot"></span> Resting</span>
                                    }
                                    else if (child.IsCheckedIn)
                                    {
                                        <span class="child-badge badge-present">● Present</span>
                                    }
                                    else if (child.AttendanceStatus == "CheckedOut")
                                    {
                                        <span class="child-badge badge-departed">Checked Out</span>
                                    }
                                    else if (child.AttendanceStatus == "Absent")
                                    {
                                        <span class="child-badge badge-absent">Absent</span>
                                    }
                                    else
                                    {
                                        <span class="child-badge badge-expected">Expected</span>
                                    }
                                </div>
                            </div>

                            @if (child.IsCheckedIn)
                            {
                                <!-- Routines Glance -->
                                <div class="child-glance-row">
                                    <div class="glance-chip @(child.LastDiaperEvent == null ? "empty-chip" : "")" title="Last Diaper Change">
                                        <span>🧷</span>
                                        <span>@(child.LastDiaperEvent != null ? $"{child.LastDiaperEvent.DiaperCondition ?? "Checked"} ({child.LastDiaperEvent.EventTime.ToLocalTime().ToString("h:mm tt")})" : "No diaper yet")</span>
                                    </div>
                                    <div class="glance-chip @(child.LastMealEvent == null ? "empty-chip" : "")" title="Last Meal/Snack">
                                        <span>🍎</span>
                                        <span>@(child.LastMealEvent != null ? $"{child.LastMealEvent.AmountConsumed ?? "Recorded"}" : "No meal yet")</span>
                                    </div>
                                    <div class="glance-chip @(!isSleeping ? "empty-chip" : "")" title="Rest Status">
                                        <span>😴</span>
                                        <span>@(isSleeping ? "Resting" : "Awake")</span>
                                    </div>
                                </div>

                                <!-- Action Buttons Row -->
                                <div class="child-actions-row">
                                    <button class="child-action-btn @(_activeDiaperChildId == child.ChildId ? "active-action" : "")" 
                                            @onclick="() => ToggleDiaperPopover(child.ChildId)" 
                                            title="Record Diaper Change">
                                        <span>🧷</span>
                                        <span>Diaper</span>
                                    </button>

                                    <button class="child-action-btn @(_activeMealChildId == child.ChildId ? "active-action" : "")" 
                                            @onclick="() => ToggleMealPopover(child.ChildId)" 
                                            title="Record Meal or Snack">
                                        <span>🍎</span>
                                        <span>Meal</span>
                                    </button>

                                    <button class="child-action-btn @(isSleeping ? "active-action" : "")" 
                                            @onclick="() => ToggleNapAsync(child)" 
                                            title="@(isSleeping ? "Wake up child" : "Start nap timer")">
                                        <span>@(isSleeping ? "⏰" : "😴")</span>
                                        <span>@(isSleeping ? "Wake" : "Rest")</span>
                                    </button>

                                    <button class="child-action-btn" 
                                            @onclick="() => OpenQuickMomentModalAsync(child)" 
                                            title="Capture Moment or Observation">
                                        <span>📸</span>
                                        <span>Moment</span>
                                    </button>

                                    <button class="child-action-btn btn-checkout" 
                                            @onclick="() => CheckOutChildAsync(child.ChildId)" 
                                            title="Record Departure">
                                        <span>🚪</span>
                                        <span>Out</span>
                                    </button>
                                </div>

                                <!-- Quick Diaper Popover -->
                                @if (_activeDiaperChildId == child.ChildId)
                                {
                                    <div class="quick-popover">
                                        <div class="quick-popover-title">
                                            <span>Select Diaper Condition:</span>
                                            <span style="cursor: pointer;" @onclick="() => _activeDiaperChildId = null">✕</span>
                                        </div>
                                        <div class="quick-popover-options">
                                            <button class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Wet")'>💧 Wet</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "BM")'>💩 BM / Dirty</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Wet & BM")'>💧💩 Both</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Clean/Dry")'>✨ Clean &amp; Dry</button>
                                        </div>
                                    </div>
                                }

                                <!-- Quick Meal Popover -->
                                @if (_activeMealChildId == child.ChildId)
                                {
                                    <div class="quick-popover">
                                        <div class="quick-popover-title">
                                            <span>Select Amount Consumed:</span>
                                            <span style="cursor: pointer;" @onclick="() => _activeMealChildId = null">✕</span>
                                        </div>
                                        <div class="quick-popover-options">
                                            <button class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "All (100%)")'>🥣 All (100%)</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "Most (75%)")'>👍 Most (75%)</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "Half (50%)")'>🥪 Half (50%)</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "Some (25%)")'>🤏 Little (25%)</button>
                                            <button class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "None (0%)")'>❌ None</button>
                                        </div>
                                    </div>
                                }
                            }
                            else if (child.AttendanceStatus == "CheckedOut")
                            {
                                <div class="child-locked-notice notice-departed">
                                    <div class="locked-text">
                                        <span>🚪</span>
                                        <span>Checked out • Logs locked</span>
                                    </div>
                                    @if (!_isDaycareClosed)
                                    {
                                        <button class="btn-readmit" @onclick="() => CheckInChildAsync(child.ChildId)" title="Re-admit child if checked out in error">
                                            Re-admit
                                        </button>
                                    }
                                </div>
                            }
                            else if (child.AttendanceStatus == "Absent")
                            {
                                <div class="child-locked-notice notice-absent">
                                    <div class="locked-text">
                                        <span>🚫</span>
                                        <span>Absent today • Logs locked</span>
                                    </div>
                                    @if (!_isDaycareClosed)
                                    {
                                        <button class="btn-readmit" @onclick="() => CheckInChildAsync(child.ChildId)" title="Check in child if arrived late">
                                            Mark Present
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Unchecked state: Large 1-tap Check-In button -->
                                <button class="btn-checkin-large @(_isDaycareClosed ? "closed-btn" : "")" 
                                        @onclick="() => CheckInChildAsync(child.ChildId)" 
                                        title="@(_isDaycareClosed ? "Daycare is closed for the day (operating hours ended at 7:00 PM)" : "Check in child to enable care and activity logs")">
                                    <FluentIcon Value="@(_isDaycareClosed ? (Icon)new Icons.Regular.Size16.LockClosed() : (Icon)new Icons.Regular.Size16.Checkmark())" Color="Color.Custom" CustomColor="#ffffff" />
                                    <span>@(_isDaycareClosed ? "Closed (After 7 PM)" : "Check-In Now to Log")</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ================= SECTION E: MORE CLASSROOM SHORTCUTS ================= -->
        <div class="actions-section">
            <h2 class="section-title">@(IsLeadTeacher ? "Classroom Delivery Shortcuts" : "More Classroom Tools")</h2>
            <div class="actions-grid-3x2">
                <!-- 1. Take Attendance (Signature Dark Sage Highlight) -->
                <div class="action-card action-attendance-featured" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/management/attendance")'>
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ClipboardTask())" Width="26px" Color="Color.Custom" CustomColor="#ffffff" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Take Attendance</div>
                        <div class="action-subtitle">Mark today's arrivals</div>
                    </div>
                </div>

                <!-- 2. Start Activity -->
                <div class="action-card" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/today-activities")'>
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Filled.Size28.Play())" Color="Color.Custom" CustomColor="#476a5b" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Start Activity</div>
                        <div class="action-subtitle">@(ActiveRunningExperience != null ? $"Active: {ActiveRunningExperience.Title}" : "Today's planned experiences")</div>
                    </div>
