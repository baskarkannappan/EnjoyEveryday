@page "/classroom"
@page "/my-classroom"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ActiveSessionModal
@using EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.UI.Shared.Components.ChildJourney
@using EnjoyEveryday.UI.Shared.Components.OperationsBoard
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@inject IDaycareOperationsBoardService OperationsBoardService
@inject ClassroomService ClassroomService
@inject ExecutionService ExecutionService
@inject PlannerService PlannerService
@inject IClassroomCommunicationService CommunicationService
@inject IChildDailyCareService DailyCareService
@inject AttendanceService AttendanceService
@inject IEndOfDayService EndOfDayService
@inject IDailyOperationsService DailyOpsService
@inject IBranchOperationalStatusService BranchOperationalStatusService
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject Microsoft.Extensions.Logging.ILogger<TeacherWorkspace> Logger
@inject IClassroomGiftingService GiftingService
@inject IJSRuntime JS

@implements IDisposable

<PageTitle>Daycare Web — My Classroom</PageTitle>

<div class="content teacher-workspace-page">
    @if (!_loading && _teacherClassrooms.Count == 0)
    {
        <!-- ================= EMPTY STATE: NO ASSIGNED CLASSROOM ================= -->
        <div class="teacher-empty-card">
            <div class="empty-icon-pill">
                <FluentIcon Value="@(new Icons.Regular.Size32.Door())" Color="Color.Custom" CustomColor="#31523c" />
            </div>
            <h2 class="empty-title">Welcome, @GetTeacherDisplayName()!</h2>
            <p class="empty-text">
                You are currently signed in as an educator, but no active classroom has been assigned to your account yet.
            </p>
            <div class="empty-notice-box">
                <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="Color.Custom" CustomColor="#31523c" />
                <span>Please contact your Branch Director or Administrator to assign you to your classroom roster.</span>
            </div>
            <div class="empty-actions">
                <a href="/profile" class="btn secondary">View My Profile</a>
                <a href="/classroom-messages" class="btn secondary">Check Messages</a>
                @if (AvailableViews.Count > 1)
                {
                    @if (AvailableViews.Contains("OrgAdmin"))
                    {
                        <button class="primary" @onclick='() => OnChangeView.InvokeAsync("OrgAdmin")'>
                            Switch to Organization Management &rarr;
                        </button>
                    }
                    else if (AvailableViews.Contains("BranchAdmin"))
                    {
                        <button class="primary" @onclick='() => OnChangeView.InvokeAsync("BranchAdmin")'>
                            Switch to Branch View &rarr;
                        </button>
                    }
                }
                <a href="/select-organization" class="btn secondary" style="display: inline-flex; align-items: center; gap: 6px;">
                    <FluentIcon Value="@(new Icons.Regular.Size16.BuildingSwap())" Color="Color.Custom" CustomColor="var(--accent, #52745e)" />
                    <span>Switch Daycare Organization</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- ================= SECTION A: HERO GREETING ================= -->
        <div class="teacher-hero-header">
            <div class="header-top-row">
                <div class="classroom-eyebrow">
                    @if (_teacherClassrooms.Count > 1)
                    {
                        <div class="classroom-dropdown-wrap">
                            <span class="eyebrow-text">MY CLASSROOM • @(IsLeadTeacher ? "LEAD TEACHER • " : "")</span>
                            <select class="classroom-select-pill" @onchange="HandleClassroomSelected" value="@(_selectedClassroomId?.ToString() ?? "")">
                                @foreach (var room in _teacherClassrooms)
                                {
                                    <option value="@room.Id">@room.Name (@(string.IsNullOrEmpty(room.AgeGroup) ? "General" : room.AgeGroup))</option>
                                }
                            </select>
                        </div>
                    }
                    else if (IsLeadTeacher)
                    {
                        <span class="eyebrow-text">MY CLASSROOM • LEAD TEACHER COORDINATION • @(_activeClassroom?.Name?.ToUpperInvariant() ?? "CLASSROOM")</span>
                    }
                    else
                    {
                        <span class="eyebrow-text">MY CLASSROOM • @(_activeClassroom?.Name?.ToUpperInvariant() ?? "CLASSROOM")</span>
                    }
                </div>

                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="staff-break-pill @(_isOnBreak ? "break-active" : "")" 
                            @onclick="ToggleStaffBreak" 
                            disabled="@IsBranchClosed" 
                            style="@(IsBranchClosed ? "opacity: 0.5; cursor: not-allowed;" : "")" 
                            title="@(IsBranchClosed ? "Branch facility is closed — staff breaks and attendance cannot be recorded" : "")">
                        <span>☕</span>
                        <span>@(_isOnBreak ? "On Break (Click to Return)" : "Staff Break")</span>
                    </button>

                    @if (AvailableViews.Count > 1)
                    {
                        <div class="role-override-wrapper">
                            <select class="role-selector-pill" @onchange="e => OnChangeView.InvokeAsync(e.Value?.ToString() ?? string.Empty)" value="@(IsLeadTeacher ? "LeadTeacher" : "Teacher")">
                                @foreach (var v in AvailableViews)
                                {
                                    <option value="@v">@GetViewDisplayName(v) View</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>

            @if (_isDaycareClosed)
            {
                <div class="daycare-closed-banner">
                    <div class="closed-banner-left">
                        <span class="closed-icon">🌙</span>
                        <div>
                            <div class="closed-title">Daycare is Closed for the Day</div>
                            <div class="closed-subtitle">Operating hours ended at 7:00 PM. Classroom arrivals, attendance, and new learning sessions are closed until tomorrow morning.</div>
                        </div>
                    </div>
                    <span class="closed-status-pill">CLOSED</span>
                </div>
            }

            @if (_isOnBreak)
            {
                <div class="staff-break-banner">
                    <div class="staff-break-banner-left">
                        <span>☕</span>
                        <span>Staff Break in Progress — Started at @(_breakStartTime?.ToString("h:mm tt") ?? "now"). Classroom ratio active.</span>
                    </div>
                    <button class="btn primary sm" @onclick="ToggleStaffBreak">✓ End Break &amp; Return</button>
                </div>
            }

            <h1 class="greeting-heading">@GetGreeting()!</h1>
            <p class="greeting-subtitle">@(_activeClassroom != null ? $"{_activeClassroom.Name} • {(_classroomChildren.Count(c => c.IsCheckedIn))} checked in today" : "Let's make today a wonderful day for the children.")</p>

            @if (_teacherClassrooms.Count > 1)
            {
                <div class="multi-classroom-switcher-bar">
                    <div class="classroom-switcher-title">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Door())" Color="Color.Custom" CustomColor="#52745e" />
                        <span>Assigned Classrooms:</span>
                    </div>
                    <div class="classroom-switcher-tabs">
                        @foreach (var room in _teacherClassrooms)
                        {
                            var isCurrent = room.Id == _selectedClassroomId;
                            <button type="button" 
                                    class="classroom-switch-btn @(isCurrent ? "active-room" : "")" 
                                    @onclick="() => SelectClassroomAsync(room.Id)">
                                <span class="room-icon">🏫</span>
                                <span class="room-name">@room.Name</span>
                                <span class="room-pill">@(string.IsNullOrEmpty(room.AgeGroup) ? "Room" : room.AgeGroup)</span>
                                @if (isCurrent)
                                {
                                    <span class="active-indicator">● Active</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (IsBranchClosed)
        {
            <BranchClosedLockView Title="@(_branchOperationalStatus != null && !_branchOperationalStatus.IsOperational ? $"Branch is {_branchOperationalStatus.OperationalStatus}" : "Branch Facility is Closed")"
                                  BadgeText="@(_branchOperationalStatus != null && !_branchOperationalStatus.IsOperational ? _branchOperationalStatus.OperationalStatus.ToUpperInvariant() : "BRANCH CLOSED")"
                                  BranchName="@_branchOperationalStatus?.BranchName"
                                  ClosureReason="@_branchOperationalStatus?.ActiveClosure?.Reason"
                                  Message="All teacher attendance, classroom readiness, student arrivals, learning activities, and daily care routines are locked until the Branch Admin opens and activates the branch."
                                  AdminInstruction="A Branch Administrator must open and activate the branch before any classroom activity can take place."
                                  ActionLabel="@(AvailableViews.Contains("BranchAdmin") ? "Switch to Branch Admin View" : AvailableViews.Contains("OrgAdmin") ? "Switch to Organization View" : "Go to Branch Dashboard")"
                                  OnActionClick="@(AvailableViews.Contains("BranchAdmin") ? EventCallback.Factory.Create(this, () => OnChangeView.InvokeAsync("BranchAdmin")) : AvailableViews.Contains("OrgAdmin") ? EventCallback.Factory.Create(this, () => OnChangeView.InvokeAsync("OrgAdmin")) : default)"
                                  SecondaryLabel="View My Profile"
                                  SecondaryUrl="/profile" />
        }
        else
        {
        <!-- ================= SECTION A2: CLASSROOM DAILY OPERATIONS GATE ================= -->
        @if (_classroomOpsStatus != null)
        {
            @if (!_classroomOpsStatus.IsBranchOpen)
            {
                <div class="daily-gate-card closed-branch" style="background: #fff8f6; border-left: 4px solid #e53e3e; padding: 16px 20px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span class="gate-icon" style="font-size: 26px;">🔒</span>
                        <div>
                            <div class="gate-title" style="color: #9b2c2c; font-weight: 750; font-size: 15px;">Branch Facility is Closed</div>
                            <div class="gate-desc" style="color: #742a2a; font-size: 13px; margin-top: 4px;">
                                The Branch Admin has not opened the facility for operations yet today. All teacher attendance, classroom readiness, student arrivals, learning activities, and daily care routines are locked until the branch is opened.
                            </div>
                        </div>
                    </div>
                    <span class="closed-status-pill" style="white-space: nowrap; background: #fed7d7; color: #9b2c2c; border: 1px solid #feb2b2; font-weight: 700; padding: 6px 12px; border-radius: 6px;">BRANCH CLOSED</span>
                </div>
            }
            else if (!_classroomOpsStatus.IsOpen && _classroomOpsStatus.ClosedAt == null)
            {
                <div class="daily-gate-card ready-room">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span class="gate-icon">🌅</span>
                        <div>
                            <div class="gate-title">Branch is Open • Classroom Ready to Open</div>
                            <div class="gate-desc">Good morning! Open @(_activeClassroom?.Name ?? "the classroom") to start taking child arrivals, marking attendance, and running today's learning experiences.</div>
                        </div>
                    </div>
                    <button class="btn primary" @onclick="HandleOpenClassroomAsync" style="white-space: nowrap; font-weight: 750;">
                        🌅 Open Classroom
                    </button>
                </div>
            }
            else if (_classroomOpsStatus.IsOpen)
            {
                <div class="daily-gate-card open-room">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span class="status-dot-open"></span>
                        <div>
                            <div class="gate-title" style="color: var(--accent-dark, #31523c);">
                                @(_activeClassroom?.Name ?? "Classroom") Open for Today
                            </div>
                            <div class="gate-desc">
                                Opened at @(_classroomOpsStatus.OpenedAt?.ToString("h:mm tt")) by @(_classroomOpsStatus.OpenedByName ?? "Lead Teacher") • Child check-in &amp; learning activities active.
                            </div>
                        </div>
                    </div>
                    <button class="btn secondary sm" @onclick="OpenClassroomCloseModal" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 750; white-space: nowrap;">
                        <span>🌙</span>
                        <span>Close Classroom (End of Day)</span>
                    </button>
                </div>
            }
            else if (!_classroomOpsStatus.IsOpen && _classroomOpsStatus.ClosedAt != null)
            {
                <div class="daily-gate-card completed-room">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span class="gate-icon">🌙</span>
                        <div>
                            <div class="gate-title">Classroom Closed for the Day</div>
                            <div class="gate-desc">Closed at @(_classroomOpsStatus.ClosedAt?.ToString("h:mm tt")) by @(_classroomOpsStatus.ClosedByName ?? "Teacher"). All children departed and sessions concluded.</div>
                        </div>
                    </div>
                    <span class="closed-status-pill" style="background: #edf2f7; color: #4a5568; border-color: #cbd5e0; white-space: nowrap;">ROOM CLOSED</span>
                </div>
            }
        }

        <!-- ================= SECTION: DAYCARE PROGRESS TIMELINE ================= -->
        <div class="day-timeline-card" aria-label="Daycare Day Timeline">
            <div class="day-timeline-header">
                <div class="timeline-title-wrap">
                    <span class="timeline-pulse-dot @(_isDaycareClosed ? "closed" : "active")"></span>
                    <span class="timeline-eyebrow">Today's Rhythm</span>
                </div>
                <div class="timeline-meta-wrap">
                    @if (_isDaycareClosed)
                    {
                        <span class="timeline-closed-pill">🌙 Closed (7:00 PM)</span>
                    }
                    else
                    {
                        <span class="timeline-open-pill">7:00 AM – 7:00 PM</span>
                    }
                </div>
            </div>

            <div class="day-timeline-track simple-rhythm-grid">
                <div class="rhythm-step @(_isDaycareClosed ? "completed" : "active")" title="Daycare operating day started at 7:00 AM">
                    <span class="rhythm-step-icon">🌅</span>
                    <div class="rhythm-step-text">
                        <strong>Day Started</strong>
                        <span>7:00 AM</span>
                    </div>
                </div>

                <div class="rhythm-step @(GetChildrenPresentCount() > 0 ? "active" : "")"
                     @onclick='() => Navigation.NavigateTo("/management/attendance")'
                     title="View Classroom Attendance Desk">
                    <span class="rhythm-step-icon">👥</span>
                    <div class="rhythm-step-text">
                        <strong>@GetChildrenPresentCount() Children · @GetTeachersPresentCount() Staff</strong>
                        <span>Live Roster</span>
                    </div>
                </div>

                <div class="rhythm-step @(GetStartedActivitiesCount() > 0 ? "active" : "")"
                     @onclick='() => Navigation.NavigateTo("/today-activities")'
                     title="View Today's Activities">
                    <span class="rhythm-step-icon">🎨</span>
                    <div class="rhythm-step-text">
                        <strong>@GetPlannedActivitiesCount() Planned · @GetStartedActivitiesCount() Active</strong>
                        <span>Activities</span>
                    </div>
                </div>

                <div class="rhythm-step @(_isDaycareClosed ? "completed" : "pending")"
                     @onclick="HandleTimelineEndedClickAsync"
                     title="@(_isDaycareClosed ? "Daycare day ended at 7:00 PM." : "Auto-closes at 7:00 PM")">
                    <span class="rhythm-step-icon">🌙</span>
                    <div class="rhythm-step-text">
                        <strong>@(_isDaycareClosed ? "Day Closed" : "Auto-Close")</strong>
                        <span>7:00 PM</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SECTION B: THREE STAT CARDS (Screenshot 1 Match) ================= -->
        <div class="stats-row">
            <!-- 1. Present -->
            <div class="stat-card" @onclick='() => Navigation.NavigateTo("/management/attendance")' title="Open Attendance Desk">
                <div class="stat-icon-wrap">
                    <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())" Color="Color.Custom" CustomColor="#52745e" />
                </div>
                <div class="stat-number">
                    @_board.CheckedInChildrenCount<span class="stat-denom">/@_board.ExpectedChildrenCount</span>
                </div>
                <div class="stat-label">Present</div>
            </div>

            <!-- 2. Activities -->
            <div class="stat-card" @onclick='() => Navigation.NavigateTo("/experiences")' title="View Scheduled Activities">
                <div class="stat-icon-wrap">
                    <FluentIcon Value="@(new Icons.Regular.Size24.CalendarMonth())" Color="Color.Custom" CustomColor="#52745e" />
                </div>
                <div class="stat-number">@_board.PlannedExperiencesCount</div>
                <div class="stat-label">Activities</div>
            </div>

            <!-- 3. Tasks Left -->
            <div class="stat-card" @onclick='() => Navigation.NavigateTo("/daily-care")' title="View Classroom Care Tasks">
                <div class="stat-icon-wrap">
                    <FluentIcon Value="@(new Icons.Regular.Size24.CheckmarkCircle())" Color="Color.Custom" CustomColor="#52745e" />
                </div>
                <div class="stat-number">@GetPendingTasksCount()</div>
                <div class="stat-label">Tasks left</div>
            </div>
        </div>

        <!-- ================= SECTION C: LEAD TEACHER COORDINATION SHORTCUTS ================= -->
        @if (IsLeadTeacher)
        {
            <div class="lead-teacher-coordination-section">
                <div class="coordination-header-row">
                    <div>
                        <h2 class="coordination-title">
                            <span class="coordination-badge">LEAD TEACHER</span>
                            Classroom Delivery &amp; Team Coordination
                        </h2>
                        <p class="coordination-sub">Oversee classroom readiness, daily care logs, team tasks and staff coverage</p>
                    </div>
                </div>

                <div class="coordination-shortcuts-grid">
                    <!-- 1. Classroom Readiness -->
                    <div class="action-card-btn @(IsBranchClosed ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleClassroomReadinessNavigation" title="@(IsBranchClosed ? "Branch is closed — classroom readiness cannot be performed" : "Environment & room setup")">
                        <div class="action-card-icon icon-box-leaf">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Building())" Color="Color.Custom" CustomColor="#31523c" />
                        </div>
                        <div class="action-card-text">
                            <strong>Classroom Readiness</strong>
                            <span>@(IsBranchClosed ? "Locked (Branch Closed)" : "Environment & room setup")</span>
                        </div>
                    </div>

                    <!-- 2. Team Tasks & Handover -->
                    <div class="action-card-btn @(IsBranchClosed ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleTeamTasksNavigation" title="@(IsBranchClosed ? "Branch is closed — handover notes cannot be logged" : "Classroom shift handover")">
                        <div class="action-card-icon icon-box-blue">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())" Color="Color.Custom" CustomColor="#2b6cb0" />
                        </div>
                        <div class="action-card-text">
                            <strong>Team Tasks &amp; Handover</strong>
                            <span>@(IsBranchClosed ? "Locked (Branch Closed)" : "Classroom shift handover")</span>
                        </div>
                    </div>

                    <!-- 3. Review Daily Logs -->
                    <div class="action-card-btn @(IsBranchClosed ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleReviewLogsNavigation" title="@(IsBranchClosed ? "Branch is closed — care logs cannot be modified" : "Verify teacher care logs")">
                        <div class="action-card-icon icon-box-amber">
                            <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardTask())" Color="Color.Custom" CustomColor="#8c5717" />
                        </div>
                        <div class="action-card-text">
                            <strong>Review Daily Logs</strong>
                            <span>@(IsBranchClosed ? "Locked (Branch Closed)" : "Verify teacher care logs")</span>
                        </div>
                    </div>

                    <!-- 4. Review Experience Feedback -->
                    <div class="action-card-btn @(IsBranchClosed || IsClassroomOperationsLocked ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleExperienceFeedbackNavigation" title="@(IsBranchClosed ? "Branch is closed — activities locked" : "Curriculum & session notes")">
                        <div class="action-card-icon icon-box-teal">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Sparkle())" Color="Color.Custom" CustomColor="#31523c" />
                        </div>
                        <div class="action-card-text">
                            <strong>Experience Feedback</strong>
                            <span>@(IsBranchClosed ? "Locked (Branch Closed)" : "Curriculum & session notes")</span>
                        </div>
                    </div>

                    <!-- 5. Request Staff Coverage -->
                    <div class="action-card-btn @(IsBranchClosed ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleRequestCoverageNavigation" title="@(IsBranchClosed ? "Branch is closed — staffing requests locked" : "Staffing gaps & coverage")">
                        <div class="action-card-icon icon-box-purple">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PersonCall())" Color="Color.Custom" CustomColor="#553c9a" />
                        </div>
                        <div class="action-card-text">
                            <strong>Request Coverage</strong>
                            <span>@(IsBranchClosed ? "Locked (Branch Closed)" : "Staffing gaps & coverage")</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ================= SECTION D0: SMART ROUTINE BAR (ZERO-CLICK / LAZY TEACHER) ================= -->
        <div class="smart-routine-bar">
            <div class="smart-routine-top">
                <div class="smart-routine-info">
                    <span class="smart-routine-badge">⚡ AUTO-ROUTINE</span>
                    <strong class="smart-routine-name">@GetCurrentRoutineTitle()</strong>
                    <span class="smart-routine-desc">@GetCurrentRoutineDescription()</span>
                </div>
                <div class="smart-routine-pills">
                    <button type="button" class="routine-tab-pill @(_currentRoutineMode == ClassroomRoutineMode.Auto ? "active" : "")" @onclick="() => SetRoutineMode(ClassroomRoutineMode.Auto)" title="Follows current classroom clock automatically">🕒 Auto Clock</button>
                    <button type="button" class="routine-tab-pill @(_currentRoutineMode == ClassroomRoutineMode.Arrival ? "active" : "")" @onclick="() => SetRoutineMode(ClassroomRoutineMode.Arrival)">🌅 Arrivals</button>
                    <button type="button" class="routine-tab-pill @(_currentRoutineMode == ClassroomRoutineMode.Meal ? "active" : "")" @onclick="() => SetRoutineMode(ClassroomRoutineMode.Meal)">🍽️ Lunch</button>
                    <button type="button" class="routine-tab-pill @(_currentRoutineMode == ClassroomRoutineMode.Rest ? "active" : "")" @onclick="() => SetRoutineMode(ClassroomRoutineMode.Rest)">😴 Nap Rest</button>
                    <button type="button" class="routine-tab-pill @(_currentRoutineMode == ClassroomRoutineMode.Diaper ? "active" : "")" @onclick="() => SetRoutineMode(ClassroomRoutineMode.Diaper)">🧷 Diaper/Potty</button>
                    <button type="button" class="routine-tab-pill @(_currentRoutineMode == ClassroomRoutineMode.Pickup ? "active" : "")" @onclick="() => SetRoutineMode(ClassroomRoutineMode.Pickup)">📋 Pickup</button>
                </div>
            </div>

            <!-- Primary 1-Click Action for the Current Routine -->
            <div class="smart-routine-banner">
                @if (EffectiveRoutine == ClassroomRoutineMode.Arrival)
                {
                    <div class="smart-banner-content">
                        <div>
                            <strong>🌅 Morning Drop-off in Progress</strong>
                            <p>@_classroomChildren.Count(c => c.IsCheckedIn) of @_classroomChildren.Count children checked in. Mark all expected arrivals with 1 tap.</p>
                        </div>
                        <button class="btn primary sm" @onclick="MarkAllScheduledPresentAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)">
                            ✓ 1-Tap Check-In All Expected
                        </button>
                    </div>
                }
                else if (EffectiveRoutine == ClassroomRoutineMode.Meal)
                {
                    <div class="smart-banner-content">
                        <div>
                            <strong>🍽️ Midday Meal / Lunch Table</strong>
                            <p>Record full lunch for all checked-in children at once, then tap exceptions.</p>
                        </div>
                        <button class="btn primary sm" @onclick="RecordWholeTableLunchAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)">
                            🍽️ 1-Tap Record Whole Table Lunch
                        </button>
                    </div>
                }
                else if (EffectiveRoutine == ClassroomRoutineMode.Rest)
                {
                    var restingCount = _classroomChildren.Count(c => c.IsCheckedIn && c.ActiveNapSession != null);
                    var awakeCount = _classroomChildren.Count(c => c.IsCheckedIn && c.ActiveNapSession == null);
                    <div class="smart-banner-content">
                        <div>
                            <strong>😴 Nap &amp; Rest Time (@restingCount Resting · @awakeCount Awake)</strong>
                            <p>Start sleep timers for all awake children with 1 tap. Wake children individually with 1 tap on their cot.</p>
                        </div>
                        @if (awakeCount > 0)
                        {
                            <button class="btn primary sm" @onclick="StartGroupNapAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)">
                                😴 1-Tap Rest All Awake (@awakeCount)
                            </button>
                        }
                        else
                        {
                            <span class="all-resting-badge">✨ All checked-in children are resting</span>
                        }
                    </div>
                }
                else if (EffectiveRoutine == ClassroomRoutineMode.Diaper)
                {
                    <div class="smart-banner-content">
                        <div>
                            <strong>🧷 Diaper &amp; Potty Routine</strong>
                            <p>Use the direct 1-tap chips below on each child card (Wet / BM / Dry) or open the rapid checklist.</p>
                        </div>
                        <button class="btn primary sm" @onclick="OpenPottyChecklistModal" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)">
                            🧷 Open Rapid Potty Checklist
                        </button>
                    </div>
                }
                else if (EffectiveRoutine == ClassroomRoutineMode.Pickup)
                {
                    <div class="smart-banner-content">
                        <div>
                            <strong>📋 Evening Pickup &amp; Doorway Handoff</strong>
                            <p>Tap "Cheat-Sheet" on any child at the door for an instant 15-second parent conversation briefing.</p>
                        </div>
                        <button class="btn secondary sm" @onclick="OpenClassroomCloseModal" disabled="@(IsBranchClosed || IsClassroomOperationsLocked)">
                            🌙 Close Classroom (End of Day)
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- ================= SECTION D: CLASSROOM LIVE ACTION COCKPIT ================= -->
        <div class="cockpit-section">
            <div class="cockpit-header">
                <div class="cockpit-title-wrap">
                    <h2>
                        <FluentIcon Value="@(new Icons.Regular.Size20.PeopleCommunity())" Color="Color.Custom" CustomColor="#52745e" />
                        Classroom Live Roster &amp; Action Cockpit
                    </h2>
                    <p>Execute attendance, diaper changes, meals, rest sessions, and moments with 1 tap.</p>
                </div>
                <div class="cockpit-batch-bar">
                    @if (_showLiveSyncFlash)
                    {
                        <span class="live-sync-flash">🔄 Co-Teacher Live Sync</span>
                    }
                    <button class="batch-btn primary-batch" @onclick="MarkAllScheduledPresentAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(IsBranchClosed ? "Branch is closed — attendance cannot be performed" : IsClassroomOperationsLocked ? "Classroom is closed" : _isDaycareClosed ? "Daycare is closed" : "Mark all expected children present")">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Custom" CustomColor="#ffffff" />
                        <span>Check-In All</span>
                    </button>
                    <button class="batch-btn" @onclick="OpenGroupSnackModal" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(IsBranchClosed ? "Branch is closed — care logs are locked" : "Record group snack for all checked-in children")">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Food())" Color="Color.Custom" CustomColor="#52745e" />
                        <span>Group Snack</span>
                    </button>
                    <button class="batch-btn" @onclick="RecordWholeTableLunchAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(IsBranchClosed ? "Branch is closed — care logs are locked" : "Record lunch (75% Most) for all checked-in children at once")">
                        <span>🍽️</span>
                        <span>Table Lunch</span>
                    </button>
                    <button class="batch-btn" @onclick="OpenPottyChecklistModal" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(IsBranchClosed ? "Branch is closed — care logs are locked" : "Open rapid 1-screen diaper &amp; potty line checklist")">
                        <span>🧷</span>
                        <span>Potty Line</span>
                    </button>
                    <button class="batch-btn" @onclick="StartGroupNapAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(IsBranchClosed ? "Branch is closed — nap sessions are locked" : "Start rest time for all present awake children")">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Bed())" Color="Color.Custom" CustomColor="#3730a3" />
                        <span>Group Rest</span>
                    </button>
                    <button class="batch-btn" @onclick="OpenTimerModal" disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" style="@((IsBranchClosed || IsClassroomOperationsLocked) ? "opacity: 0.5; cursor: not-allowed;" : "")" title="Open Gentle Classroom Transition Timer &amp; Chime">
                        <span>⏳</span>
                        <span>Timer</span>
                    </button>
                    <button class="batch-btn" @onclick="OpenGeneralMomentModalAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" title="Record voice observation hands-free">
                        <span>🎙️</span>
                        <span>Voice Note</span>
                    </button>
                    <button class="batch-btn" @onclick="ManualCoTeacherSyncAsync" title="Refresh live status from co-teachers">
                        <span>🔄</span>
                        <span>Sync</span>
                    </button>
                </div>
            </div>

            <!-- Filter tabs -->
            <div class="cockpit-filters">
                <button class="cockpit-filter-pill @(_rosterFilter == "All" ? "active" : "")" @onclick='() => _rosterFilter = "All"'>
                    All Children (@_classroomChildren.Count)
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "Present" ? "active" : "")" @onclick='() => _rosterFilter = "Present"'>
                    Checked In (@_classroomChildren.Count(c => c.IsCheckedIn))
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "Expected" ? "active" : "")" @onclick='() => _rosterFilter = "Expected"'>
                    Awaiting Check-In (@_classroomChildren.Count(c => !c.IsCheckedIn && c.AttendanceStatus != "Absent" && c.AttendanceStatus != "CheckedOut"))
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "OutAbsent" ? "active" : "")" @onclick='() => _rosterFilter = "OutAbsent"'>
                    Absent / Checked Out (@_classroomChildren.Count(c => c.AttendanceStatus == "Absent" || c.AttendanceStatus == "CheckedOut"))
                </button>
                <button class="cockpit-filter-pill @(_rosterFilter == "Resting" ? "active" : "")" @onclick='() => _rosterFilter = "Resting"'>
                    Resting (@_classroomChildren.Count(c => c.IsCheckedIn && c.ActiveNapSession != null))
                </button>
            </div>

            <!-- Roster Cards Grid -->
            @if (!_classroomChildren.Any())
            {
                <div style="padding: 24px; text-align: center; color: var(--muted, #6c7870); font-size: 13.5px;">
                    No children currently enrolled in @(_activeClassroom?.Name ?? "this classroom").
                </div>
            }
            else
            {
                var filtered = GetFilteredChildren();
                <div class="roster-grid">
                    @foreach (var child in filtered)
                    {
                        bool isSleeping = child.IsCheckedIn && child.ActiveNapSession != null;
                        <div class="child-card @(isSleeping ? "is-resting" : "")">
                            <div class="child-card-header">
                                <div class="child-meta-left">
                                    <div class="child-avatar">
                                        @(GetChildInitials(child.ChildName))
                                    </div>
                                    <div class="child-name-wrap">
                                        <h4 class="child-name">@child.ChildName</h4>
                                        <div class="child-sub">
                                            @if (child.IsCheckedIn && child.ArrivalTime.HasValue)
                                            {
                                                <span>Arrived @FormatTimeSpan(child.ArrivalTime.Value)</span>
                                            }
                                            else if (child.AttendanceStatus == "CheckedOut")
                                            {
                                                <span>Departed @(child.DepartureTime.HasValue ? FormatTimeSpan(child.DepartureTime.Value) : "")</span>
                                            }
                                            else
                                            {
                                                <span>@(child.AttendanceStatus ?? "Expected today")</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="child-badge-right">
                                    @if (isSleeping)
                                    {
                                        <span class="child-badge badge-resting"><span class="pulse-dot"></span> Resting</span>
                                    }
                                    else if (child.IsCheckedIn)
                                    {
                                        <span class="child-badge badge-present">● Present</span>
                                    }
                                    else if (child.AttendanceStatus == "CheckedOut")
                                    {
                                        <span class="child-badge badge-departed">Checked Out</span>
                                    }
                                    else if (child.AttendanceStatus == "Absent")
                                    {
                                        <span class="child-badge badge-absent">Absent</span>
                                    }
                                    else
                                    {
                                        <span class="child-badge badge-expected">Expected</span>
                                    }
                                </div>
                            </div>

                            @if (child.IsCheckedIn)
                            {
                                <!-- 1. Interactive Routine Actions (Combines status glance + 1-tap update) -->
                                <div class="child-routine-actions">
                                    <!-- Diaper Action -->
                                    <button type="button" 
                                            class="routine-action-btn @(_activeDiaperChildId == child.ChildId ? "active-action" : "") @(child.LastDiaperEvent == null ? "empty-routine" : "")"
                                            @onclick="() => ToggleDiaperPopover(child.ChildId)"
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)"
                                            style="@((IsBranchClosed || IsClassroomOperationsLocked) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                            title="@(IsBranchClosed ? "Branch is closed — diaper logs locked" : IsClassroomOperationsLocked ? "Classroom is closed" : "Tap to update diaper change")">
                                        <div class="routine-head">
                                            <span class="routine-icon">🧷</span>
                                            <span class="routine-label">Diaper</span>
                                        </div>
                                        <span class="routine-value">@(child.LastDiaperEvent != null ? $"{child.LastDiaperEvent.DiaperCondition ?? "Checked"} ({child.LastDiaperEvent.EventTime.ToLocalTime():h:mm tt})" : "Log change")</span>
                                    </button>

                                    <!-- Meal Action -->
                                    <button type="button" 
                                            class="routine-action-btn @(_activeMealChildId == child.ChildId ? "active-action" : "") @(child.LastMealEvent == null ? "empty-routine" : "")"
                                            @onclick="() => ToggleMealPopover(child.ChildId)"
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)"
                                            style="@((IsBranchClosed || IsClassroomOperationsLocked) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                            title="@(IsBranchClosed ? "Branch is closed — meal logs locked" : IsClassroomOperationsLocked ? "Classroom is closed" : "Tap to record meal or snack")">
                                        <div class="routine-head">
                                            <span class="routine-icon">🍎</span>
                                            <span class="routine-label">Meal</span>
                                        </div>
                                        <span class="routine-value">@(child.LastMealEvent != null ? $"{child.LastMealEvent.AmountConsumed ?? "Recorded"}" : "Log meal")</span>
                                    </button>

                                    <!-- Rest / Nap Action -->
                                    <button type="button" 
                                            class="routine-action-btn @(isSleeping ? "is-resting active-action" : "")"
                                            @onclick="() => ToggleNapAsync(child)"
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)"
                                            style="@((IsBranchClosed || IsClassroomOperationsLocked) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                            title="@(IsBranchClosed ? "Branch is closed — nap routine locked" : IsClassroomOperationsLocked ? "Classroom is closed" : isSleeping ? "Tap to wake up child" : "Tap to start nap timer")">
                                        <div class="routine-head">
                                            <span class="routine-icon">@(isSleeping ? "⏰" : "😴")</span>
                                            <span class="routine-label">Rest</span>
                                        </div>
                                        <span class="routine-value">@(isSleeping ? "Resting (Wake)" : "Awake (Start)")</span>
                                    </button>
                                </div>

                                <!-- Rapid 1-Tap Care Strip (Zero Popovers / Lazy Teacher Mode) -->
                                <div class="rapid-care-strip">
                                    <span class="rapid-strip-label">1-TAP:</span>
                                    <button type="button" class="rapid-chip chip-wet" 
                                            @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Wet")' 
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" 
                                            title="1-Tap Log Wet Diaper">💧 Wet</button>
                                    <button type="button" class="rapid-chip chip-bm" 
                                            @onclick='() => QuickRecordDiaperAsync(child.ChildId, "BM")' 
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" 
                                            title="1-Tap Log Dirty/BM Diaper">💩 BM</button>
                                    <button type="button" class="rapid-chip chip-dry" 
                                            @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Clean/Dry")' 
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" 
                                            title="1-Tap Log Clean &amp; Dry Diaper">✨ Dry</button>
                                    <span class="rapid-strip-sep"></span>
                                    <button type="button" class="rapid-chip chip-meal" 
                                            @onclick='() => QuickRecordMealAsync(child.ChildId, "All (100%)")' 
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" 
                                            title="1-Tap Log Finished All Meal/Snack">🥣 Ate All</button>
                                    <button type="button" class="rapid-chip chip-meal-half" 
                                            @onclick='() => QuickRecordMealAsync(child.ChildId, "Half (50%)")' 
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" 
                                            title="1-Tap Log Ate Half">🥪 Half</button>
                                </div>

                                <!-- Quick Diaper Popover -->
                                @if (_activeDiaperChildId == child.ChildId)
                                {
                                    <div class="quick-popover">
                                        <div class="quick-popover-title">
                                            <span>Record Diaper for @child.ChildName:</span>
                                            <span class="popover-close-btn" @onclick="() => _activeDiaperChildId = null">✕</span>
                                        </div>
                                        <div class="quick-popover-options">
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Wet")'>💧 Wet</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "BM")'>💩 BM / Dirty</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Wet & BM")'>💧💩 Both</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Clean/Dry")'>✨ Clean &amp; Dry</button>
                                        </div>
                                    </div>
                                }

                                <!-- Quick Meal Popover -->
                                @if (_activeMealChildId == child.ChildId)
                                {
                                    <div class="quick-popover">
                                        <div class="quick-popover-title">
                                            <span>Record Meal for @child.ChildName:</span>
                                            <span class="popover-close-btn" @onclick="() => _activeMealChildId = null">✕</span>
                                        </div>
                                        <div class="quick-popover-options">
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "All (100%)")'>🥣 All (100%)</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "Most (75%)")'>👍 Most (75%)</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "Half (50%)")'>🥪 Half (50%)</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "Some (25%)")'>🤏 Little (25%)</button>
                                            <button type="button" class="popover-option-btn" @onclick='() => QuickRecordMealAsync(child.ChildId, "None (0%)")'>❌ None</button>
                                        </div>
                                    </div>
                                }

                                <!-- 2. Footer Action Bar (Dedicated Observation, Pickup Briefing & Check Out) -->
                                <div class="child-card-footer">
                                    <button type="button" 
                                            class="btn-child-moment" 
                                            @onclick="() => OpenQuickMomentModalAsync(child)"
                                            disabled="@(IsBranchClosed || IsClassroomOperationsLocked)"
                                            style="@((IsBranchClosed || IsClassroomOperationsLocked) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                            title="@(IsBranchClosed ? "Branch is closed — moments locked" : IsClassroomOperationsLocked ? "Classroom is closed" : $"Record photo or learning observation for {child.ChildName}")">
                                        <span class="btn-icon">📸</span>
                                        <span>+ Moment</span>
                                    </button>

                                    <div class="footer-actions-right">
                                        <button type="button" 
                                                class="btn-pickup-cheat" 
                                                @onclick="() => OpenPickupCheatSheet(child)" 
                                                disabled="@(IsBranchClosed || IsClassroomOperationsLocked)"
                                                style="@((IsBranchClosed || IsClassroomOperationsLocked) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                                title="@(IsBranchClosed ? "Branch is closed — pickup briefing locked" : "Open 15-second pickup briefing for talking to parents")">
                                            <span>📋</span>
                                            <span>Cheat-Sheet</span>
                                        </button>

                                        <button type="button" 
                                                class="btn-child-checkout" 
                                                @onclick="() => CheckOutChildAsync(child.ChildId)" 
                                                disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)"
                                                style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                                title="@(IsBranchClosed ? "Branch is closed — departure locked" : IsClassroomOperationsLocked ? "Classroom is closed" : _isDaycareClosed ? "Daycare is closed" : "Record departure / Check out")">
                                            <span class="btn-icon">🚪</span>
                                            <span>Check Out</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (child.AttendanceStatus == "CheckedOut")
                            {
                                <div class="child-locked-notice notice-departed">
                                    <div class="locked-text">
                                        <span>🚪</span>
                                        <span>Checked out • Logs locked</span>
                                    </div>
                                    @if (!_isDaycareClosed && !IsBranchClosed && !IsClassroomOperationsLocked)
                                    {
                                        <button class="btn-readmit" @onclick="() => CheckInChildAsync(child.ChildId)" title="Re-admit child if checked out in error">
                                            Re-admit
                                        </button>
                                    }
                                </div>
                            }
                            else if (child.AttendanceStatus == "Absent")
                            {
                                <div class="child-locked-notice notice-absent">
                                    <div class="locked-text">
                                        <span>🚫</span>
                                        <span>Absent today • Logs locked</span>
                                    </div>
                                    @if (!_isDaycareClosed && !IsBranchClosed && !IsClassroomOperationsLocked)
                                    {
                                        <button class="btn-readmit" @onclick="() => CheckInChildAsync(child.ChildId)" title="Check in child if arrived late">
                                            Mark Present
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Unchecked state: Large 1-tap Check-In button -->
                                <button class="btn-checkin-large @(_isDaycareClosed || IsBranchClosed || IsClassroomOperationsLocked ? "closed-btn" : "")" 
                                        @onclick="() => CheckInChildAsync(child.ChildId)" 
                                        disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)"
                                        style="@((IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed) ? "opacity: 0.5; cursor: not-allowed;" : "")"
                                        title="@(IsBranchClosed ? "Branch facility is closed for operations today" : IsClassroomOperationsLocked ? "Classroom is closed" : _isDaycareClosed ? "Daycare is closed for the day (operating hours ended at 7:00 PM)" : "Check in child to enable care and activity logs")">
                                    <FluentIcon Value="@(_isDaycareClosed || IsBranchClosed || IsClassroomOperationsLocked ? (Icon)new Icons.Regular.Size16.LockClosed() : (Icon)new Icons.Regular.Size16.Checkmark())" Color="Color.Custom" CustomColor="#ffffff" />
                                    <span>@(IsBranchClosed ? "Branch Closed" : IsClassroomOperationsLocked ? "Room Closed" : _isDaycareClosed ? "Closed (After 7 PM)" : "Check In")</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ================= SECTION E: MORE CLASSROOM SHORTCUTS ================= -->
        <div class="actions-section">
            <h2 class="section-title">@(IsLeadTeacher ? "Classroom Delivery Shortcuts" : "More Classroom Tools")</h2>
            <div class="actions-grid-3x2">
                <!-- 1. Take Attendance (Signature Dark Sage Highlight) -->
                <div class="action-card action-attendance-featured @(IsBranchClosed ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleTakeAttendanceNavigation">
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ClipboardTask())" Width="26px" Color="Color.Custom" CustomColor="#ffffff" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Take Attendance</div>
                        <div class="action-subtitle">@(IsBranchClosed ? "Locked (Branch Closed)" : "Mark today's arrivals")</div>
                    </div>
                </div>

                <!-- 2. Start Activity -->
                <div class="action-card @(IsBranchClosed || IsClassroomOperationsLocked ? "disabled-card" : "")" role="button" tabindex="0" @onclick="HandleStartActivityNavigation">
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Filled.Size28.Play())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Start Activity</div>
                        <div class="action-subtitle">@(IsBranchClosed ? "Locked (Branch Closed)" : IsClassroomOperationsLocked ? "Locked (Room Closed)" : ActiveRunningExperience != null ? $"Active: {ActiveRunningExperience.Title}" : "Today's planned experiences")</div>
                    </div>
                    @if (ActiveRunningExperience != null && !IsBranchClosed && !IsClassroomOperationsLocked)
                    {
                        <span class="live-pill"><span class="pulse-dot"></span> Live</span>
                    }
                </div>

                <!-- 3. Voice or Text Child Moment -->
                <div class="action-card @(IsBranchClosed || IsClassroomOperationsLocked ? "disabled-card" : "")" role="button" tabindex="0" @onclick="OpenGeneralMomentModalAsync">
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size28.Mic())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Voice Observation</div>
                        <div class="action-subtitle">@(IsBranchClosed ? "Locked (Branch Closed)" : "Hands-free or text moment")</div>
                    </div>
                </div>

                <!-- 4. Log Care & Routines -->
                <div class="action-card" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/daily-care")'>
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size28.Heart())" Color="Color.Custom" CustomColor="#b85d43" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Log Care &amp; Routines</div>
                        <div class="action-subtitle">Meals, naps &amp; diapers</div>
                    </div>
                </div>

                <!-- 5. Parent Messages -->
                <div class="action-card" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/classroom-messages")'>
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size28.Chat())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Parent Messages</div>
                        <div class="action-subtitle">View conversations</div>
                    </div>
                    @if (_chatUnreadCount > 0)
                    {
                        <span class="chat-badge">@_chatUnreadCount</span>
                    }
                </div>

                <!-- 6. View Today's Schedule -->
                <div class="action-card" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/planning")'>
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarClock())" Width="26px" Color="Color.Custom" CustomColor="#52745e" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Today's Schedule</div>
                        <div class="action-subtitle">View planned routines</div>
                    </div>
                </div>

                <!-- 7. Classroom Gifts & Contributions -->
                <div class="action-card" role="button" tabindex="0" @onclick="OpenClassroomGiftsModal">
                    <div class="action-card-icon">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Gift())" Width="26px" Color="Color.Custom" CustomColor="#d97706" />
                    </div>
                    <div class="action-card-text">
                        <div class="action-title">Classroom Gifts</div>
                        <div class="action-subtitle">Arrivals &amp; Distribution</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SECTION D: NEXT IN YOUR CLASSROOM ================= -->
        <div class="next-activity-section">
            <h2 class="section-title">Next in your classroom</h2>

            @if (NextPlannedExperience != null)
            {
                <div class="next-activity-card">
                    <div class="activity-left">
                        <div class="activity-icon-badge">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PaintBrush())" Color="Color.Custom" CustomColor="#31523c" />
                        </div>
                        <div class="activity-info">
                            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
                                <span style="font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--accent-dark, #31523c); background: var(--accent-light, #e6eee9); padding: 2px 7px; border-radius: 4px;">✨ Planned Experience</span>
                                <span style="font-size: 11.5px; font-weight: 600; color: var(--muted, #6c7870);">@(string.IsNullOrEmpty(NextPlannedExperience.TimeDisplay) ? "Today" : NextPlannedExperience.TimeDisplay)</span>
                            </div>
                            <h3 class="activity-title" style="margin-bottom: 3px;">@NextPlannedExperience.Title</h3>
                            <div class="activity-meta">
                                @if (!string.IsNullOrEmpty(NextPlannedExperience.PreparationNotes))
                                {
                                    <span>💡 @NextPlannedExperience.PreparationNotes</span>
                                }
                                else
                                {
                                    <span>Materials &amp; pedagogical steps ready for your classroom group.</span>
                                }
                            </div>
                            @{
                                var plannedSafetyAlerts = _classroomChildren.Where(c => c.IsCheckedIn && (!string.IsNullOrWhiteSpace(c.ImportantCareAlert) || !string.IsNullOrWhiteSpace(c.DietaryOrAllergyNote))).ToList();
                            }
                            @if (plannedSafetyAlerts.Any())
                            {
                                <div class="safety-shield-banner shield-alert" title="Safety Shield Alert for Present Children">
                                    <span>🛡️⚠️</span>
                                    <span><strong>Safety Shield Alert:</strong> @(string.Join(", ", plannedSafetyAlerts.Select(a => $"{a.ChildName} ({(!string.IsNullOrWhiteSpace(a.ImportantCareAlert) ? a.ImportantCareAlert : a.DietaryOrAllergyNote)})"))) present today. Suggested adaptation: Ensure allergen-free alternative materials.</span>
                                </div>
                            }
                            else
                            {
                                <div class="safety-shield-banner shield-safe" title="Material Safety Shield Verified">
                                    <span>🛡️🟢</span>
                                    <span><strong>Material Safety Shield:</strong> All Safe — No active allergies for the @(_classroomChildren.Count(c => c.IsCheckedIn)) children checked in today.</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="activity-right" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <button class="btn primary btn-sm" @onclick="() => StartSession(NextPlannedExperience.Id)">
                            ▶ Start Session
                        </button>
                        <a href="@($"/experiences/{NextPlannedExperience.Id}/story")" class="btn secondary btn-sm" style="display: inline-flex; align-items: center; gap: 4px;">
                            📖 Storybook
                        </a>
                        <button class="btn secondary btn-sm" @onclick="OpenGeneralMomentModalAsync" title="Record voice or text observation moment">
                            🎙️ Voice / Text Moment
                        </button>
                    </div>
                </div>
            }
            else if (ActiveRunningExperience != null)
            {
                <div class="next-activity-card active-card">
                    <div class="activity-left">
                        <div class="activity-icon-badge active-badge">
                            <FluentIcon Value="@(new Icons.Filled.Size24.Sparkle())" Color="Color.Custom" CustomColor="#31523c" />
                        </div>
                        <div class="activity-info">
                            <div class="live-tag"><span class="pulse-dot"></span> In Progress Now</div>
                            <h3 class="activity-title" style="margin-bottom: 3px;">@ActiveRunningExperience.Title</h3>
                            <div class="activity-meta">
                                <span>@(string.IsNullOrEmpty(ActiveRunningExperience.TimeDisplay) ? "Started" : ActiveRunningExperience.TimeDisplay)</span>
                                <span class="meta-dot">•</span>
                                <span>Children active in classroom exploration</span>
                            </div>
                            @{
                                var activeSafetyAlerts = _classroomChildren.Where(c => c.IsCheckedIn && (!string.IsNullOrWhiteSpace(c.ImportantCareAlert) || !string.IsNullOrWhiteSpace(c.DietaryOrAllergyNote))).ToList();
                            }
                            @if (activeSafetyAlerts.Any())
                            {
                                <div class="safety-shield-banner shield-alert" title="Safety Shield Alert for Present Children">
                                    <span>🛡️⚠️</span>
                                    <span><strong>Safety Shield Alert:</strong> @(string.Join(", ", activeSafetyAlerts.Select(a => $"{a.ChildName} ({(!string.IsNullOrWhiteSpace(a.ImportantCareAlert) ? a.ImportantCareAlert : a.DietaryOrAllergyNote)})"))) present today. Suggested adaptation: Ensure allergen-free alternative materials.</span>
                                </div>
                            }
                            else
                            {
                                <div class="safety-shield-banner shield-safe" title="Material Safety Shield Verified">
                                    <span>🛡️🟢</span>
                                    <span><strong>Material Safety Shield:</strong> All Safe — No active allergies for the @(_classroomChildren.Count(c => c.IsCheckedIn)) children checked in today.</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="activity-right" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <button class="btn primary btn-sm" @onclick="() => OpenActiveSession(ActiveRunningExperience.Id)">
                            ▶ Resume Session
                        </button>
                        <a href="@($"/experiences/{ActiveRunningExperience.Id}/story")" class="btn secondary btn-sm" style="display: inline-flex; align-items: center; gap: 4px;">
                            📖 Storybook
                        </a>
                        <button class="btn secondary btn-sm" @onclick="OpenGeneralMomentModalAsync" title="Record voice or text observation moment">
                            🎙️ Voice / Text Moment
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="next-activity-card empty-activity-card">
                    <div class="activity-left">
                        <div class="activity-icon-badge">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Sparkle())" Color="Color.Custom" CustomColor="#8c5717" />
                        </div>
                        <div class="activity-info">
                            <h3 class="activity-title">No upcoming activities scheduled today</h3>
                            <div class="activity-meta">
                                <span>Browse the experience library to plan an engaging activity for your room.</span>
                            </div>
                        </div>
                    </div>
                    <div class="activity-right">
                        <a href="/experiences" class="activity-open-btn">
                            Browse &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- ================= SECTION E: TODAY'S CLASSROOM RHYTHM TIMELINE ================= -->
        @if (_board.TodayRhythm != null && _board.TodayRhythm.Any())
        {
            <div class="rhythm-card-wrapper">
                <div class="rhythm-header-row">
                    <div>
                        <h2 class="section-title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Clock())" Color="Color.Custom" CustomColor="#52745e" />
                            Classroom Daily Schedule
                        </h2>
                        <p class="section-sub">Planned experiences and routines for @(_activeClassroom?.Name ?? "your room")</p>
                    </div>
                    <a href="/planning" class="btn secondary btn-xs">Planning Calendar &rarr;</a>
                </div>

                <div class="rhythm-items-list">
                    @foreach (var item in _board.TodayRhythm)
                    {
                        bool isRunning = item.Status == "Started" || item.Status == "Active" || item.Status == "InProgress";
                        bool isPlanned = item.Status == "Scheduled" || item.Status == "Planned" || item.Status == "Confirmed";
                        bool isDone = item.Status == "Completed" || item.Status == "Finished";

                        <div class="rhythm-item @(isRunning ? "item-running" : (isDone ? "item-done" : ""))">
                            <div class="rhythm-time-box">
                                <span class="time-text">@item.TimeDisplay</span>
                                <div class="rhythm-dot @(isRunning ? "pulse-dot" : (isDone ? "done-dot" : "plan-dot"))"></div>
                            </div>
                            <div class="rhythm-details">
                                <div class="rhythm-top">
                                    <h4 class="rhythm-title">@item.Title</h4>
                                    <div class="rhythm-actions">
                                        @if (isRunning)
                                        {
                                            <button class="btn secondary btn-xs" @onclick="() => OpenSessionPhotoModal(item)">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Camera())" Color="Color.Custom" CustomColor="#52745e" />
                                                <span>Photos @(item.PhotoUrls?.Length > 0 ? $"({item.PhotoUrls.Length})" : "")</span>
                                            </button>
                                            <button class="btn primary btn-xs" @onclick="() => CloseSession(item.Id)" disabled="@_isDaycareClosed" style="@(_isDaycareClosed ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(_isDaycareClosed ? "Daycare is closed — cannot end activity" : "End Session")">
                                                <span>End Session</span>
                                            </button>
                                            <button class="btn secondary btn-xs" @onclick="() => OpenActiveSession(item.Id)" disabled="@_isDaycareClosed" style="@(_isDaycareClosed ? "opacity: 0.5; cursor: not-allowed;" : "")">
                                                <span>Resume &rarr;</span>
                                            </button>
                                        }
                                        else if (isPlanned)
                                        {
                                            <button class="btn primary btn-xs" @onclick="() => StartSession(item.Id)" disabled="@_isDaycareClosed" style="@(_isDaycareClosed ? "opacity: 0.5; cursor: not-allowed;" : "")" title="@(_isDaycareClosed ? "Daycare is closed — cannot start activity" : "Start")">
                                                <FluentIcon Value="@(new Icons.Filled.Size16.Play())" Color="Color.Custom" CustomColor="#ffffff" />
                                                <span>Start</span>
                                            </button>
                                        }
                                        else if (isDone)
                                        {
                                            <span class="done-badge">✓ Done</span>
                                            @if (item.PhotoUrls?.Length > 0)
                                            {
                                                <button class="btn secondary btn-xs" @onclick="() => OpenSessionPhotoModal(item)">
                                                    <span>@item.PhotoUrls.Length Photos</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(item.PreparationNotes))
                                {
                                    <div class="rhythm-notes">@item.PreparationNotes</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ================= SECTION F: SECONDARY CLASSROOM TOOLS ================= -->
        <div class="secondary-tools-section">
            <h3 class="tools-heading">Classroom Tools</h3>
            <div class="tools-pills-row">
                <a href="/children" class="tool-pill">
                    <FluentIcon Value="@(new Icons.Regular.Size16.PeopleTeam())" Color="Color.Custom" CustomColor="#52745e" />
                    <span>My Classroom Children</span>
                </a>
                <a href="/daily-care" class="tool-pill">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Heart())" Color="Color.Custom" CustomColor="#b85d43" />
                    <span>Child Daily Care</span>
                </a>
                <a href="/journey" class="tool-pill">
                    <FluentIcon Value="@(new Icons.Regular.Size16.LeafOne())" Color="Color.Custom" CustomColor="#52745e" />
                    <span>Journey &amp; Milestones</span>
                </a>
                <a href="/memories" class="tool-pill">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Image())" Color="Color.Custom" CustomColor="#8c5717" />
                    <span>Classroom Memories</span>
                </a>
                <a href="/experiences" class="tool-pill">
                    <FluentIcon Value="@(new Icons.Regular.Size16.BookOpen())" Color="Color.Custom" CustomColor="#31523c" />
                    <span>Storybooks &amp; Experiences</span>
                </a>
            </div>
        </div>
        }
    }

    <!-- ================= FLOATING MOBILE THUMB BAR (STICKY BOTTOM ON <= 768px) ================= -->
    <div class="ee-floating-thumb-bar" role="navigation" aria-label="Quick Mobile Actions">
        <button type="button" class="thumb-btn" @onclick="MarkAllScheduledPresentAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" title="Check-In All">
            <span class="thumb-icon">🌅</span>
            <span class="thumb-txt">Check In</span>
        </button>
        <button type="button" class="thumb-btn" @onclick="RecordWholeTableLunchAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" title="Table Lunch">
            <span class="thumb-icon">🍽️</span>
            <span class="thumb-txt">Lunch All</span>
        </button>
        <button type="button" class="thumb-btn" @onclick="StartGroupNapAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" title="Group Rest">
            <span class="thumb-icon">😴</span>
            <span class="thumb-txt">Rest All</span>
        </button>
        <button type="button" class="thumb-btn" @onclick="OpenPottyChecklistModal" disabled="@(IsBranchClosed || IsClassroomOperationsLocked || _isDaycareClosed)" title="Potty Line">
            <span class="thumb-icon">🧷</span>
            <span class="thumb-txt">Potty Line</span>
        </button>
        <button type="button" class="thumb-btn thumb-btn-voice" @onclick="OpenGeneralMomentModalAsync" disabled="@(IsBranchClosed || IsClassroomOperationsLocked)" title="Voice Observation">
            <span class="thumb-icon">🎙️</span>
            <span class="thumb-txt">Voice Note</span>
        </button>
    </div>
</div>

@* ACTIVE SESSION MODAL *@
@if (_isSessionModalOpen)
{
    <ActiveSessionModal ScheduleId="@_activeSessionScheduleId"
                        OnSessionEnded="OnSessionEnded"
                        OnClose="() => _isSessionModalOpen = false" />
}

@* SESSION PHOTO MODAL *@
<SessionPhotoModal 
    IsOpen="_isSessionPhotoModalOpen"
    ScheduleId="@_sessionPhotoScheduleId"
    Title="@_sessionPhotoTitle"
    Photos="@_sessionPhotoUrls"
    MaxPhotos="5"
    PhotosChanged="OnSessionPhotosSaved"
    OnOpenFullSession="OpenActiveSession"
    OnClose="() => _isSessionPhotoModalOpen = false" />

@* COMPREHENSIVE 2-STEP JOURNEY MOMENT DIALOG WITH MOBILE CAMERA CAPTURE *@
<AddJourneyMomentDialog @ref="_momentDialog"
                        ClassroomId="@_activeClassroom?.Id"
                        TeacherId="@(UserContext.UserId != Guid.Empty ? UserContext.UserId : Guid.Parse("50000000-0000-0000-0000-000000000001"))"
                        OnSaved="OnMomentSavedAsync" />

@* GROUP SNACK MODAL *@
@if (_showGroupSnackModal)
{
    <div class="cockpit-modal-backdrop" @onclick="() => _showGroupSnackModal = false">
        <div class="cockpit-modal" @onclick:stopPropagation="true">
            <div class="cockpit-modal-header">
                <h3>🍎 Record Group Snack / Meal</h3>
                <button class="btn-xs secondary" @onclick="() => _showGroupSnackModal = false">✕</button>
            </div>
            <div class="cockpit-modal-body">
                <p style="font-size: 13px; color: var(--muted); margin: 0;">
                    Record a meal entry for all @(_classroomChildren.Count(c => c.IsCheckedIn)) currently checked-in children in @(_activeClassroom?.Name ?? "this room").
                </p>
                <div>
                    <label style="font-size: 12px; font-weight: 750; color: var(--text); display: block; margin-bottom: 4px;">Meal Type</label>
                    <select class="classroom-select-pill" style="width: 100%; padding: 7px 10px; font-size: 13px;" @bind="_groupSnackType">
                        <option value="MorningSnack">Morning Snack</option>
                        <option value="Lunch">Lunch</option>
                        <option value="AfternoonSnack">Afternoon Snack</option>
                        <option value="Breakfast">Breakfast</option>
                    </select>
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: 750; color: var(--text); display: block; margin-bottom: 4px;">Amount Consumed</label>
                    <select class="classroom-select-pill" style="width: 100%; padding: 7px 10px; font-size: 13px;" @bind="_groupSnackAmount">
                        <option value="All (100%)">All (100%)</option>
                        <option value="Most (75%)">Most (75%)</option>
                        <option value="Half (50%)">Half (50%)</option>
                    </select>
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: 750; color: var(--text); display: block; margin-bottom: 4px;">Notes / Food Description</label>
                    <input type="text" class="classroom-select-pill" style="width: 100%; padding: 7px 10px; font-size: 13px;" @bind="_groupSnackNotes" />
                </div>
            </div>
            <div class="cockpit-modal-footer">
                <button class="btn secondary sm" @onclick="() => _showGroupSnackModal = false">Cancel</button>
                <button class="btn primary sm" @onclick="SaveGroupSnackAsync">Confirm Group Log</button>
            </div>
        </div>
    </div>
}

@* CLOSE CLASSROOM (END OF DAY) MODAL *@
@if (_showCloseClassroomModal && _activeClassroom != null)
{
    var presentCount = _classroomChildren.Count(c => c.IsCheckedIn);
    <div class="cockpit-modal-backdrop" @onclick="() => _showCloseClassroomModal = false">
        <div class="cockpit-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="cockpit-modal-header">
                <div>
                    <div style="font-size: 11px; font-weight: 750; color: var(--accent, #557c6c); text-transform: uppercase; letter-spacing: 0.8px;">
                        END OF DAY OPERATION
                    </div>
                    <h3 style="margin: 2px 0 0; font-size: 17px; font-weight: 800; color: var(--text, #26332d);">
                        Close @_activeClassroom.Name
                    </h3>
                </div>
                <button class="cockpit-modal-close" @onclick="() => _showCloseClassroomModal = false">✕</button>
            </div>
            <div class="cockpit-modal-body" style="padding: 16px 20px;">
                <p style="font-size: 13.5px; color: var(--text, #26332d); line-height: 1.45; margin: 0 0 14px;">
                    Closing the classroom seals all daily attendance marks and concludes running learning sessions for today.
                </p>

                <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 8px; padding: 12px 14px; margin-bottom: 14px;">
                    <div style="font-size: 11px; font-weight: 750; color: var(--muted, #6c7870); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                        Automated Actions Upon Closure
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span>👥</span>
                            <span><strong>@presentCount</strong> children currently present will be auto-checked out.</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span>🎨</span>
                            <span>Any open activity sessions will be marked completed.</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span>🔒</span>
                            <span>Care routine logs (meals, diapers, naps) will be locked for the day.</span>
                        </div>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label style="font-size: 12.5px; font-weight: 700; color: var(--text, #26332d); display: block; margin-bottom: 4px;">
                        Departure &amp; Closure Time *
                    </label>
                    <input type="time" class="form-input" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #e4e7df); border-radius: 6px; font-size: 13.5px;" @bind="_closeClassroomTime" />
                    <small style="color: var(--muted, #6c7870); font-size: 11.5px; display: block; margin-top: 4px;">
                        Timestamp recorded for departures of remaining children and session end.
                    </small>
                </div>
            </div>
            <div class="cockpit-modal-footer" style="padding: 12px 20px; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--border, #e4e7df);">
                <button class="btn secondary sm" @onclick="() => _showCloseClassroomModal = false" disabled="@_isClosingClassroom">
                    Cancel
                </button>
                <button class="btn primary sm" @onclick="HandleConfirmCloseClassroomAsync" disabled="@_isClosingClassroom" style="font-weight: 750;">
                    @(_isClosingClassroom ? "Closing..." : "✓ Confirm & Close Classroom")
                </button>
            </div>
        </div>
    </div>
}

@if (_showSecurePickupModal && _activeClassroom != null)
{
    <SecurePickupModal IsOpen="_showSecurePickupModal"
                       ChildId="_pickupChildId"
                       ChildName="@_pickupChildName"
                       ClassroomId="_activeClassroom.Id"
                       ClassroomName="@_activeClassroom.Name"
                       BranchId="_activeClassroom.BranchId"
                       OnCompleted="HandleSecurePickupCompleted"
                       OnClose="() => _showSecurePickupModal = false" />
}

@* 1. 15-SECOND PICKUP CHEAT SHEET MODAL *@
@if (_activeCheatSheetChild != null)
{
    <div class="cockpit-modal-backdrop" @onclick="() => _activeCheatSheetChild = null">
        <div class="cockpit-modal" @onclick:stopPropagation="true" style="max-width: 520px;">
            <div class="cockpit-modal-header">
                <div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text, #26332d); display: flex; align-items: center; gap: 8px;">
                        <span>📋</span>
                        <span>Pickup Cheat-Sheet — @_activeCheatSheetChild.ChildName</span>
                    </h3>
                    <p style="margin: 2px 0 0; font-size: 12px; color: var(--muted, #6c7870);">
                        Instant 15-second talking points for parent door conversation
                    </p>
                </div>
                <button class="btn-xs secondary" @onclick="() => _activeCheatSheetChild = null">✕</button>
            </div>
            <div class="cockpit-modal-body">
                <div class="cheat-sheet-card">
                    <div class="cheat-bullet-item">
                        <span class="cheat-icon">😴</span>
                        <div>
                            <strong>Rest &amp; Nap:</strong>
                            <div>@GetChildNapSummary(_activeCheatSheetChild)</div>
                        </div>
                    </div>
                    <div class="cheat-bullet-item">
                        <span class="cheat-icon">🥣</span>
                        <div>
                            <strong>Meals &amp; Nutrition:</strong>
                            <div>@GetChildMealSummary(_activeCheatSheetChild)</div>
                        </div>
                    </div>
                    <div class="cheat-bullet-item">
                        <span class="cheat-icon">🎨</span>
                        <div>
                            <strong>Today's Experience:</strong>
                            <div>@GetChildExperienceSummary(_activeCheatSheetChild)</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_activeCheatSheetChild.ImportantCareAlert) || !string.IsNullOrWhiteSpace(_activeCheatSheetChild.DietaryOrAllergyNote))
                    {
                        <div class="cheat-bullet-item" style="color: #8c5717;">
                            <span class="cheat-icon">⚠️</span>
                            <div>
                                <strong>Safety / Allergy Alert:</strong>
                                <div>@(!string.IsNullOrWhiteSpace(_activeCheatSheetChild.ImportantCareAlert) ? _activeCheatSheetChild.ImportantCareAlert : _activeCheatSheetChild.DietaryOrAllergyNote)</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="cheat-quote-box">
                    <strong>💬 Suggested Parent Greeting:</strong>
                    <div>"@GetSuggestedParentGreeting(_activeCheatSheetChild)"</div>
                </div>
            </div>
            <div class="cockpit-modal-footer">
                <button class="btn secondary sm" @onclick="() => _activeCheatSheetChild = null">Close</button>
                <button class="btn primary sm" @onclick="() => CheckOutFromCheatSheet(_activeCheatSheetChild.ChildId)">🚪 Check Out Child</button>
            </div>
        </div>
    </div>
}

@* 4. POST-NAP POTTY & DIAPER LINE CHECKLIST MODAL *@
@if (_showPottyChecklistModal)
{
    <div class="cockpit-modal-backdrop" @onclick="() => _showPottyChecklistModal = false">
        <div class="cockpit-modal" @onclick:stopPropagation="true" style="max-width: 620px;">
            <div class="cockpit-modal-header">
                <div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text, #26332d); display: flex; align-items: center; gap: 8px;">
                        <span>🧷</span>
                        <span>Post-Nap Potty &amp; Diaper Line Checklist</span>
                    </h3>
                    <p style="margin: 2px 0 0; font-size: 12px; color: var(--muted, #6c7870);">
                        1-tap rapid recording down the line for @(_classroomChildren.Count(c => c.IsCheckedIn)) checked-in children
                    </p>
                </div>
                <button class="btn-xs secondary" @onclick="() => _showPottyChecklistModal = false">✕</button>
            </div>
            <div class="cockpit-modal-body" style="max-height: 400px; overflow-y: auto; padding: 0 16px;">
                <table class="potty-table">
                    <thead>
                        <tr>
                            <th>Child</th>
                            <th>Current Log</th>
                            <th>1-Tap Record</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var child in _classroomChildren.Where(c => c.IsCheckedIn))
                        {
                            <tr>
                                <td>
                                    <strong>@child.ChildName</strong>
                                    <div style="font-size: 11px; color: var(--muted, #6c7870);">
                                        @(child.ActiveNapSession != null ? "Resting" : "Awake")
                                    </div>
                                </td>
                                <td>
                                    <span style="font-size: 11.5px; color: var(--accent-dark, #31523c); font-weight: 600;">
                                        @(child.LastDiaperEvent != null ? $"{child.LastDiaperEvent.DiaperCondition} ({child.LastDiaperEvent.EventTime.ToLocalTime():h:mm tt})" : "No log yet")
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                                        <button type="button" class="potty-quick-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Clean/Dry")'>✨ Dry</button>
                                        <button type="button" class="potty-quick-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Wet")'>💧 Wet</button>
                                        <button type="button" class="potty-quick-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "BM")'>💩 BM</button>
                                        <button type="button" class="potty-quick-btn" @onclick='() => QuickRecordDiaperAsync(child.ChildId, "Potty Success")'>🚽 Potty</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="cockpit-modal-footer">
                <button class="btn secondary sm" @onclick="() => _showPottyChecklistModal = false">Done</button>
            </div>
        </div>
    </div>
}

@* 5. TRANSITION CHIME & VISUAL GENTLE TIMER MODAL *@
@if (_showTimerModal)
{
    <div class="cockpit-modal-backdrop" @onclick="() => _showTimerModal = false">
        <div class="cockpit-modal timer-modal" @onclick:stopPropagation="true">
            <div class="cockpit-modal-header">
                <div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text, #26332d); display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span>⏳</span>
                        <span>Gentle Classroom Transition Timer</span>
                    </h3>
                    <p style="margin: 2px 0 0; font-size: 12px; color: var(--muted, #6c7870);">Calm audio chime &amp; visual countdown for transitions</p>
                </div>
                <button class="btn-xs secondary" @onclick="() => _showTimerModal = false">✕</button>
            </div>
            <div class="cockpit-modal-body">
                <div class="timer-display">
                    @FormatTimerSeconds(_timerRemainingSeconds)
                </div>
                
                <div class="timer-progress-bar">
                    <div class="timer-progress-fill" style="width: @(GetTimerProgressPercent())%;"></div>
                </div>

                @if (_timerRemainingSeconds == 0)
                {
                    <div style="background: #e6f4ea; border: 1px solid #b7e1cd; color: #137333; padding: 10px; border-radius: 6px; font-weight: 750; margin-bottom: 12px; font-size: 13px;">
                        🎵 Transition Time: Sing classroom clean-up song!
                    </div>
                }

                <div class="timer-presets">
                    <button type="button" class="timer-preset-btn @(_timerTotalSeconds == 120 ? "active" : "")" @onclick="() => SetTimerPreset(120)">2 min (Quick Clean)</button>
                    <button type="button" class="timer-preset-btn @(_timerTotalSeconds == 300 ? "active" : "")" @onclick="() => SetTimerPreset(300)">5 min (Wind Down)</button>
                    <button type="button" class="timer-preset-btn @(_timerTotalSeconds == 600 ? "active" : "")" @onclick="() => SetTimerPreset(600)">10 min (Circle Prep)</button>
                </div>

                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 10px;">
                    @if (!_isTimerRunning)
                    {
                        <button class="btn primary sm" @onclick="StartTransitionTimer">▶ Start Timer</button>
                    }
                    else
                    {
                        <button class="btn secondary sm" @onclick="PauseTransitionTimer">⏸ Pause</button>
                    }
                    <button class="btn secondary sm" @onclick="ResetTransitionTimer">↺ Reset</button>
                    <button class="btn secondary sm" @onclick="PlayChimeSampleAsync" title="Test the soft Tibetan bell audio chime">🔔 Test Chime</button>
                </div>
            </div>
            <div class="cockpit-modal-footer" style="justify-content: center;">
                <button class="btn secondary sm" @onclick="() => _showTimerModal = false">Done</button>
            </div>
        </div>
    </div>
}

<!-- CLASSROOM GIFTS & CONTRIBUTIONS MODAL -->
@if (_showClassroomGiftsModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: white; border-radius: 16px; width: 100%; max-width: 650px; max-height: 85vh; overflow-y: auto; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text);">Classroom Gifts &amp; Contributions</h3>
                    <span style="font-size: 13px; color: var(--muted);">@(_activeClassroom?.Name ?? "My Classroom") · Physical Receipt &amp; Child Handover</span>
                </div>
                <button type="button" style="background: none; border: none; font-size: 20px; cursor: pointer;" @onclick="() => _showClassroomGiftsModal = false">✕</button>
            </div>

            @if (_isLoadingClassroomGifts)
            {
                <div style="padding: 30px; text-align: center; color: var(--muted);">Loading classroom gifts...</div>
            }
            else if (!_classroomGifts.Any())
            {
                <div style="background: var(--surface-soft, #f8f9f5); padding: 30px; border-radius: 12px; text-align: center; color: var(--muted);">
                    <span style="font-size: 32px; display: block; margin-bottom: 6px;">🎁</span>
                    <p style="margin: 0; font-size: 13.5px;">No gift orders currently pending receipt or distribution for this classroom.</p>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var gift in _classroomGifts)
                    {
                        <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 14px;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                <div>
                                    <strong style="font-size: 14px; color: var(--text);">
                                        @(gift.RecipientType == GiftingRecipientTypes.BirthdayGift ? $"🎂 Birthday Gift for {gift.RecipientChildName}" : "📚 General Classroom Contribution")
                                    </strong>
                                    <div style="font-size: 12px; color: var(--muted);">Order: @gift.OrderNumber · Submitted by: @gift.ParentName</div>
                                </div>
                                <span style="font-size: 11px; font-weight: 700; background: white; border: 1px solid var(--border); padding: 2px 8px; border-radius: 4px;">
                                    @gift.FulfilmentStatus
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(gift.GreetingMessage))
                            {
                                <div style="font-size: 12.5px; font-style: italic; color: #4b5e52; margin-bottom: 10px;">
                                    " @gift.GreetingMessage "
                                </div>
                            }

                            <div style="display: flex; gap: 8px; justify-content: flex-end; border-top: 1px dashed var(--border); padding-top: 8px;">
                                @if (gift.FulfilmentStatus == GiftingFulfilmentStatuses.DispatchedOrHandedOver || gift.FulfilmentStatus == GiftingFulfilmentStatuses.ReadyForDelivery || gift.FulfilmentStatus == GiftingFulfilmentStatuses.Preparing)
                                {
                                    <button type="button" class="primary" style="font-size: 12px; padding: 6px 12px;" @onclick="() => ConfirmReceiptAtClassroomAsync(gift.Id)">
                                        ✓ Confirm Physical Receipt
                                    </button>
                                }
                                else if (gift.FulfilmentStatus == GiftingFulfilmentStatuses.ReceivedAtDestination)
                                {
                                    <button type="button" class="primary" style="font-size: 12px; padding: 6px 12px; background: #047857;" @onclick="() => ConfirmDistributionAsync(gift.Id)">
                                        🎁 Record Distribution to Child / Class
                                    </button>
                                }
                                else if (gift.FulfilmentStatus == GiftingFulfilmentStatuses.Distributed || gift.FulfilmentStatus == GiftingFulfilmentStatuses.Completed)
                                {
                                    <span style="font-size: 12px; color: #047857; font-weight: 700;">✓ Distributed &amp; Complete</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

