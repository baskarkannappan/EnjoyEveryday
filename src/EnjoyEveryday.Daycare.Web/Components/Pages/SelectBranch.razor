@page "/select-branch"
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.Shared.Data
@using EnjoyEveryday.Infrastructure.Data
@using Dapper
@inject IUserContext UserContext
@inject NavigationManager NavManager
@inject IDbConnectionFactory DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Select Branch — EnjoyEveryday</PageTitle>

<div style="min-height: calc(100vh - 100px); display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); padding: 36px 32px; width: 100%; max-width: 460px;">
        <div style="margin-bottom: 24px;">
            <div style="font-size: 11px; font-weight: 800; letter-spacing: 0.8px; color: var(--accent, #557c6c); text-transform: uppercase; margin-bottom: 6px;">
                BRANCH CONTEXT
            </div>
            <h2 style="font-size: 24px; font-weight: 800; color: var(--text, #26332d); margin: 0 0 8px 0; letter-spacing: -0.4px;">
                Select Active Branch
            </h2>
            <p style="font-size: 14px; color: var(--muted, #6c7870); margin: 0; line-height: 1.5;">
                You have access to multiple branch locations in this organization. Please choose which campus you want to enter.
            </p>
        </div>

        @if (_options == null)
        {
            <div style="padding: 24px 0; text-align: center; color: var(--muted, #6c7870); font-weight: 600;">
                Loading authorized branches...
            </div>
        }
        else if (_options.Count == 0)
        {
            <div style="padding: 16px; border-radius: 12px; background: #fff5f5; border: 1px solid #fed7d7; color: #9b2c2c; font-size: 14px; margin-bottom: 20px;">
                You are not currently assigned to any active branches in this organization. Please contact your Organization Administrator.
            </div>
            <a href="/select-organization" class="btn secondary" style="display: block; text-align: center; text-decoration: none;">
                &larr; Switch Organization
            </a>
        }
        else
        {
            <form method="post" action="/auth/set-branch" data-enhance="false">
                <AntiforgeryToken />
                <div style="margin-bottom: 24px;">
                    <label for="branchId" style="display: block; font-size: 12px; font-weight: 700; color: var(--muted, #6c7870); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                        Assigned Campus Location
                    </label>
                    <select id="branchId" name="branchId" required
                            style="width: 100%; height: 46px; padding: 0 14px; border-radius: 0px; border: 1.5px solid var(--border, #e4e7df); background: var(--surface-soft, #f8f9f5); color: var(--text, #26332d); font-size: 15px; font-family: inherit; font-weight: 600; outline: none; cursor: pointer;">
                        @foreach (var b in _options)
                        {
                            <option value="@b.id" selected="@(b.id == _currentBranchId)">@b.name @(!string.IsNullOrEmpty(b.location) ? $"({b.location})" : "")</option>
                        }
                    </select>
                </div>

                <button type="submit" class="primary" style="width: 100%; height: 46px; border-radius: 0px; background: #31523c; color: #fff; font-weight: 700; font-size: 15px; border: none; cursor: pointer; transition: background 0.2s ease;">
                    Enter Branch Dashboard
                </button>
            </form>

            <div style="margin-top: 18px; text-align: center;">
                <a href="/select-organization" style="font-size: 13px; font-weight: 600; color: var(--accent, #557c6c); text-decoration: none;">
                    &larr; Switch Organization
                </a>
            </div>
        }
    </div>
</div>

@code {
    private List<BranchOption>? _options;
    private Guid? _currentBranchId;

    protected override async Task OnInitializedAsync()
    {
        if (!UserContext.IsAuthenticated || UserContext.UserId == Guid.Empty)
        {
            NavManager.NavigateTo("/auth/login", forceLoad: true);
            return;
        }

        if (!UserContext.OrganizationId.HasValue)
        {
            NavManager.NavigateTo("/select-organization", forceLoad: true);
            return;
        }

        _currentBranchId = UserContext.BranchId;

        using var conn = await DbFactory.CreateConnectionAsync();
        var branches = await conn.QueryFunctionAsync<BranchOption>(
            "fn_get_user_assigned_branches",
            new { UserId = UserContext.UserId, OrganizationId = UserContext.OrganizationId.Value });

        _options = branches.ToList();

        // If user is Org Admin and has no explicit branch assignments, allow selecting from all org branches
        if (_options.Count == 0 && (UserContext.Roles.Contains("OrganizationAdmin") || UserContext.Roles.Contains("OrganizationOwner") || UserContext.Roles.Contains("PlatformAdmin")))
        {
            var allBranches = await conn.QueryAsync<BranchOption>(
                "SELECT id, name, location, is_active FROM branches WHERE organization_id = @OrgId AND is_active = true ORDER BY name",
                new { OrgId = UserContext.OrganizationId.Value });
            _options = allBranches.ToList();
        }
    }

    private sealed class BranchOption
    {
        public Guid id { get; set; }
        public string name { get; set; } = string.Empty;
        public string? location { get; set; }
        public bool is_active { get; set; }
    }
}
