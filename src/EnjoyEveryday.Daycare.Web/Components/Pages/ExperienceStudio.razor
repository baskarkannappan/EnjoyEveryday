@page "/studio"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components

<PageHero 
    Eyebrow="Little Stars" 
    Title="Experience Studio" 
    Subtitle="">
</PageHero>

<div class="studio-grid">

    <!-- LEFT PANEL -->
    <div>
        <div class="card idea-card" style="margin-bottom: 20px;">
            <button class="idea-button" style="width: 100%;">
                &#10022; Help me explore
            </button>
        </div>

        <div class="card">
            <div class="card-header">
                <h2>Possible directions</h2>
                <span>AI suggestions</span>
            </div>
            
            <StudioIdeaCard Title="Rain Detectives" Icon="&#x2614;" Subtitle="Listen, look and investigate what changes when rain arrives." />
            <StudioIdeaCard Title="Build a Water World" Icon="&#x1F4A7;" Subtitle="Create rivers, bridges and little worlds using simple materials." />
            <StudioIdeaCard Title="Rainbow Makers" Icon="&#x1F308;" Subtitle="Explore light, colour and unexpected patterns." />
            <StudioIdeaCard Title="Who Lives in the Rain?" Icon="&#x1F438;" Subtitle="Turn rain into an imaginary animal discovery adventure." />
        </div>

        <div class="card">
            <div class="card-header">
                <h2>Experience context</h2>
                <span>Classroom</span>
            </div>
            
            <div class="context-item">
                <div class="context-label">Children</div>
                <div class="context-value">Bluebirds &bull; 18 children</div>
            </div>
            
            <div class="context-item">
                <div class="context-label">Age</div>
                <div class="context-value">3&ndash;4 years</div>
            </div>
        </div>
    </div>

    <!-- CENTER CANVAS -->
    <div>
        <div class="canvas">
            <div class="canvas-top">
                <div class="canvas-title">
                    <input id="experienceTitle" value="Rain Detectives" />
                    <div class="canvas-subtitle">
                        Draft &bull; Created by Priya &bull; September 20, 2026
                    </div>
                </div>
                <div class="status-pill">
                    DRAFT
                </div>
            </div>

            <div class="dna-grid">
                <StudioDnaCard Label="Challenge">
                    <Content>Can we build something that keeps a toy dry?</Content>
                </StudioDnaCard>
                <StudioDnaCard Label="Together">
                    <Content>Build one shelter with a friend.</Content>
                </StudioDnaCard>
                <StudioDnaCard Label="Create">
                    <Content>Design your own rain shelter.</Content>
                </StudioDnaCard>
                <StudioDnaCard Label="Child Choice">
                    <Content>Children choose what they want to protect.</Content>
                </StudioDnaCard>
                
                <StudioMagicMoment Content="The children discover that the same rain can sound completely different on different materials." />

                <StudioDnaCard Label="Accomplishment">
                    <Content>&quot;We made something that kept it dry!&quot;</Content>
                </StudioDnaCard>
                <StudioDnaCard Label="Reflection">
                    <Content>What surprised you?</Content>
                </StudioDnaCard>
                
                <StudioDnaCard IsFull="true" Label="Teacher Guidance">
                    <Content>
                        <strong>Watch:</strong> Notice which materials children choose.<br><br>
                        <strong>Ask:</strong> &quot;What could make it stronger?&quot;<br><br>
                        <strong>Try:</strong> Let children test their own ideas before suggesting a solution.
                    </Content>
                </StudioDnaCard>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <aside class="right-panel">
        <div class="card">
            <div class="card-header">
                <h2>Experience details</h2>
            </div>
            
            <div class="context-item">
                <div class="context-label">Age</div>
                <div class="context-value">3&ndash;4 years</div>
            </div>
            
            <div class="context-item">
                <div class="context-label">Group size</div>
                <div class="context-value">6&ndash;18 children</div>
            </div>
            
            <div class="context-item">
                <div class="context-label">Environment</div>
                <div class="context-value">Indoor / Outdoor</div>
            </div>
            
            <div class="context-item">
                <div class="context-label">Materials</div>
                <div class="tags">
                    <span class="tag">Blocks</span>
                    <span class="tag">Paper</span>
                    <span class="tag">Cups</span>
                    <span class="tag">Water tray</span>
                </div>
            </div>
        </div>

        <div class="card idea-card">
            <div class="idea-heading">
                <div class="idea-icon">&#10022;</div>
                <div>
                    <strong>Improve with AI</strong>
                    <small>Keep the teacher in control.</small>
                </div>
            </div>
            
            <div class="suggestion">
                <div class="suggestion-title">Make it more playful</div>
                <div class="suggestion-text">Add an imaginary mission: &quot;A tiny animal needs a dry home.&quot;</div>
            </div>
            
            <div class="suggestion">
                <div class="suggestion-title">Add more child choice</div>
                <div class="suggestion-text">Let children decide which animal needs help first.</div>
            </div>
            
            <button class="idea-button" style="width: 100%; margin-top: 10px;">
                Improve this experience
            </button>
        </div>
        
        <div class="card">
            <div class="card-header">
                <h2>Versions</h2>
                <span>History</span>
            </div>
            <div class="version">
                <strong>v1</strong>
                <span>Created today</span>
            </div>
            <div class="version">
                <strong style="color:var(--muted)">No previous versions</strong>
                <span>&mdash;</span>
            </div>
        </div>
    </aside>

</div>
