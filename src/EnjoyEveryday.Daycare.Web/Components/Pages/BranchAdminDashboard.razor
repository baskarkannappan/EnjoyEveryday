@page "/management/branch-dashboard"
@page "/branch-dashboard"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ActiveSessionModal
@using EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.UI.Shared.Components.OperationsBoard
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@inject IDaycareOperationsBoardService OperationsBoardService
@inject BranchService BranchService
@inject IDailyOperationsService DailyOpsService
@inject ExecutionService ExecutionService
@inject EventService EventService
@inject IParentCommunicationRepository CommunicationRepo
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject EnjoyEveryday.Daycare.Web.Services.IUserViewPreferenceService ViewPreference

<PageTitle>Daycare Web — Branch Operations</PageTitle>

<div class="content branch-admin-dashboard-page">
    @if (!_loading && _branches.Count == 0)
    {
        <div class="branch-empty-card">
            <div class="empty-icon-pill">
                <FluentIcon Value="@(new Icons.Regular.Size32.Building())" Color="Color.Custom" CustomColor="#31523c" />
            </div>
            <h2 class="empty-title">Welcome, @GetBranchAdminDisplayName()!</h2>
            <p class="empty-text">Your account is not assigned to an active branch. Please contact your Organization Administrator.</p>
            <div class="empty-actions">
                <a href="/profile" class="btn secondary">View Profile</a>
                @if (AvailableViews.Count > 1)
                {
                    <button class="primary" @onclick='() => OnChangeView.InvokeAsync("Teacher")'>
                        Switch to Educator View &rarr;
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ================= SECTION A: BRANCH HERO (GEMINI.md PageHero) ================= -->
        <PageHero Eyebrow="@($"BRANCH OPERATIONS • {(_activeBranch?.Name?.ToUpperInvariant() ?? "BRANCH")}")"
                  Title="@($"{GetGreeting()}, {GetBranchAdminDisplayName()}!")"
                  Subtitle="@($"{TimeProvider.GetLocalNow().ToString("dddd, MMMM d, yyyy")}{(!string.IsNullOrEmpty(_activeBranch?.Name) ? " • " + _activeBranch.Name : "")}")">
            <RightContent>
                <div class="hero-actions-cluster">
                    @if (_branches.Count > 1)
                    {
                        <div class="scope-selector-pill">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Building())" Color="Color.Custom" CustomColor="#52745e" />
                            <select class="scope-dropdown" @onchange="HandleBranchSelected" value="@_selectedBranchId">
                                @foreach (var b in _branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                    }

                    @if (AvailableViews.Count > 1)
                    {
                        <div class="scope-selector-pill">
                            <select class="scope-dropdown" @onchange="e => OnChangeView.InvokeAsync(e.Value?.ToString() ?? string.Empty)" value="BranchAdmin">
                                <option value="BranchAdmin">Branch Admin View</option>
                                @foreach (var v in AvailableViews.Where(v => v != "BranchAdmin"))
                                {
                                    <option value="@v">@GetViewDisplayName(v) View</option>
                                }
                            </select>
                        </div>
                    }

                    <button class="primary" @onclick="() => _isEndOfDayModalOpen = true">
                        <FluentIcon Value="@(new Icons.Regular.Size16.CheckmarkCircle())" Color="Color.Custom" CustomColor="#ffffff" />
                        <span>End of Day</span>
                    </button>
                </div>
            </RightContent>
        </PageHero>

        <!-- ================= SECTION A2: BRANCH DAILY OPERATIONS GATE ================= -->
        @if (_branchOpsStatus != null)
        {
            @if (!_branchOpsStatus.IsOpen && _branchOpsStatus.ClosedAt == null)
            {
                <div class="branch-gate-alert" style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-left: 4px solid #d69e2e; border-radius: var(--radius, 18px); padding: 16px 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));">
                    <div style="display: flex; align-items: flex-start; gap: 14px; flex: 1; min-width: 260px;">
                        <span style="font-size: 28px; line-height: 1;">🌅</span>
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-size: 15px; font-weight: 750; color: var(--text, #26332d); line-height: 1.35;">
                                Morning Operations Gate: Branch is Closed for Today
                            </div>
                            <div style="font-size: 13px; color: var(--muted, #6c7870); margin-top: 4px; line-height: 1.45;">
                                Open @(_activeBranch?.Name ?? "this branch") to activate daily operations. Educators cannot open classrooms or mark attendance until the facility is opened.
                            </div>
                        </div>
                    </div>
                    <button class="primary branch-gate-btn" @onclick="HandleOpenBranchDayAsync" style="font-weight: 750; white-space: nowrap; padding: 10px 18px;">
                        🌅 Open Branch for Today
                    </button>
                </div>
            }
            else if (_branchOpsStatus.IsOpen)
            {
                <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-left: 4px solid var(--accent, #557c6c); border-radius: var(--radius, 18px); padding: 16px 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #38a169; box-shadow: 0 0 0 3px rgba(56, 161, 105, 0.2);"></span>
                        <div>
                            <div style="font-size: 15px; font-weight: 750; color: var(--text, #26332d);">
                                Branch Open for Operations • Opened at @(_branchOpsStatus.OpenedAt?.ToString("h:mm tt")) by @(_branchOpsStatus.OpenedByName ?? "Branch Admin")
                            </div>
                            <div style="font-size: 13px; color: var(--muted, #6c7870); margin-top: 3px;">
                                Classroom Rhythm: <strong>@(_branchOpsStatus.OpenClassrooms)</strong> open, <strong>@(_branchOpsStatus.ClosedClassrooms)</strong> closed (out of @(_branchOpsStatus.TotalClassrooms) total classrooms).
                                @if (_branchOpsStatus.OpenClassrooms > 0)
                                {
                                    <span style="color: #c05621; margin-left: 6px; font-weight: 600;">(All open rooms must be closed by teachers before closing the branch)</span>
                                }
                            </div>
                        </div>
                    </div>
                    <button class="secondary" @onclick="HandleCloseBranchDayAsync" style="font-weight: 750; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 8px 16px;">
                        <span>🌙</span>
                        <span>Close Branch (End of Day)</span>
                    </button>
                </div>
            }
            else if (!_branchOpsStatus.IsOpen && _branchOpsStatus.ClosedAt != null)
            {
                <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-left: 4px solid #718096; border-radius: var(--radius, 18px); padding: 14px 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 24px;">🌙</span>
                        <div>
                            <div style="font-size: 14.5px; font-weight: 750; color: var(--text, #26332d);">Branch Operations Concluded for Today</div>
                            <div style="font-size: 13px; color: var(--muted, #6c7870);">Closed at @(_branchOpsStatus.ClosedAt?.ToString("h:mm tt")) by @(_branchOpsStatus.ClosedByName ?? "Branch Admin"). All classrooms sealed.</div>
                        </div>
                    </div>
                    <span style="font-size: 12px; font-weight: 700; color: #718096; background: #edf2f7; padding: 5px 12px; border-radius: 6px;">DAY COMPLETED</span>
                </div>
            }
        }

        <!-- ================= SECTION B: SNAPSHOT METRICS ================= -->
        <div class="snapshot-metrics-grid">
            <!-- 1. Children Present vs Expected -->
            <div class="snapshot-card" @onclick='() => Navigation.NavigateTo("/attendance")' title="Open Attendance Desk">
                <div class="snapshot-header">
                    <span class="snapshot-lbl">Branch Attendance</span>
                    <span class="snapshot-icon icon-sage">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PersonAvailable())" Color="Color.Custom" CustomColor="#31523c" />
                    </span>
                </div>
                <div class="snapshot-val">
                    <span class="num-large">@_board.CheckedInChildrenCount</span>
                    <span class="num-denom">/ @_board.ExpectedChildrenCount</span>
                </div>
                <div class="snapshot-footer">
                    @if (_board.ExpectedNotArrivedCount > 0)
                    {
                        <span class="status-alert">@_board.ExpectedNotArrivedCount not yet arrived</span>
                    }
                    else
                    {
                        <span class="status-ok">✓ All expected checked in</span>
                    }
                </div>
            </div>

            <!-- 2. Attendance Status -->
            <div class="snapshot-card" @onclick='() => Navigation.NavigateTo("/attendance")' title="Review Attendance">
                <div class="snapshot-header">
                    <span class="snapshot-lbl">Attendance Action</span>
                    <span class="snapshot-icon icon-teal">
                        <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="#31523c" />
                    </span>
                </div>
                <div class="snapshot-val">
                    @if (_board.ExpectedNotArrivedCount > 0)
                    {
                        <span class="num-large text-amber">@_board.ExpectedNotArrivedCount</span>
                        <span class="num-denom">pending</span>
                    }
                    else
                    {
                        <span class="num-large text-green">100%</span>
                        <span class="num-denom">confirmed</span>
                    }
                </div>
                <div class="snapshot-footer">
                    @if (_board.ExpectedNotArrivedCount > 0)
                    {
                        <span class="status-alert">Needs confirmation</span>
                    }
                    else
                    {
                        <span class="status-ok">Attendance up to date</span>
                    }
                </div>
            </div>

            <!-- 3. Scheduled Experiences -->
            <div class="snapshot-card" @onclick='() => Navigation.NavigateTo("/planning")' title="Open Experience Planning">
                <div class="snapshot-header">
                    <span class="snapshot-lbl">Branch Experiences</span>
                    <span class="snapshot-icon icon-amber">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Custom" CustomColor="#8c5717" />
                    </span>
                </div>
                <div class="snapshot-val">
                    <span class="num-large">@_board.PlannedExperiencesCount</span>
                    <span class="num-denom">planned</span>
                </div>
                <div class="snapshot-footer">
                    @if (ActiveRunningExperience != null)
                    {
                        <span class="status-live"><span class="pulse-dot"></span> Active Now</span>
                    }
                    else if (_board.CompletedExperiencesCount > 0)
                    {
                        <span class="status-ok">@_board.CompletedExperiencesCount finished</span>
                    }
                    else
                    {
                        <span>Ready to begin</span>
                    }
                </div>
            </div>

            <!-- 4. Staff Coverage -->
            <div class="snapshot-card" @onclick='() => Navigation.NavigateTo("/management/roster")' title="Open Staff Roster">
                <div class="snapshot-header">
                    <span class="snapshot-lbl">Staff Coverage</span>
                    <span class="snapshot-icon icon-teal">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PeopleTeam())" Color="Color.Custom" CustomColor="#31523c" />
                    </span>
                </div>
                <div class="snapshot-val">
                    <span class="num-large">@_board.PresentStaffCount</span>
                    <span class="num-denom">/ @_board.ExpectedStaffCount</span>
                </div>
                <div class="snapshot-footer">
                    @if (_board.UnderstaffedClassroomsCount > 0)
                    {
                        <span class="status-alert">@_board.UnderstaffedClassroomsCount room(s) ratio alert</span>
                    }
                    else
                    {
                        <span class="status-ok">✓ Staff coverage compliant</span>
                    }
                </div>
            </div>

            <!-- 5. Parent Messages -->
            <div class="snapshot-card" @onclick='() => Navigation.NavigateTo("/classroom-messages")' title="Open Parent Messages">
                <div class="snapshot-header">
                    <span class="snapshot-lbl">Family Communication</span>
                    <span class="snapshot-icon icon-purple">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Chat())" Color="Color.Custom" CustomColor="#553c9a" />
                    </span>
                </div>
                <div class="snapshot-val">
                    @if (_chatUnreadCount > 0)
                    {
                        <span class="num-large text-danger">@_chatUnreadCount</span>
                        <span class="num-denom">unread</span>
                    }
                    else
                    {
                        <span class="num-large text-green">0</span>
                        <span class="num-denom">new</span>
                    }
                </div>
                <div class="snapshot-footer">
                    @if (_chatUnreadCount > 0)
                    {
                        <span class="status-alert">Unread parent message</span>
                    }
                    else
                    {
                        <span class="status-ok">Inbox all caught up</span>
                    }
                </div>
            </div>
        </div>

        <!-- ================= SECTION C: QUICK ACTION TILES ================= -->
        <!-- ================= SECTION C: BRANCH ADMIN HOME-PAGE SHORTCUTS (8 TILES) ================= -->
        <div class="quick-actions-section">
            <div class="actions-header-row" style="margin-bottom: 12px; display: flex; justify-content: space-between; align-items: baseline;">
                <div>
                    <h2 class="section-title" style="font-size: 15px; font-weight: 800; color: var(--text, #26332d); margin: 0;">Branch Operations &amp; Management</h2>
                    <p class="section-sub" style="font-size: 12px; color: var(--muted, #6c7870); margin: 2px 0 0;">Direct access to your branch's operational workflows</p>
                </div>
            </div>
            <div class="actions-cards-grid">
                <!-- 1. Branch Attendance Overview -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/management/attendance")'>
                    <div class="action-card-icon icon-box-green">
                        <FluentIcon Value="@(new Icons.Regular.Size24.CheckmarkCircle())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div class="action-card-text">
                        <strong>Branch Attendance Overview</strong>
                        <span>Live check-ins across branch</span>
                    </div>
                </button>

                <!-- 2. Classroom Occupancy & Staffing -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/classrooms")'>
                    <div class="action-card-icon icon-box-leaf">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Building())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div class="action-card-text">
                        <strong>Classroom Occupancy &amp; Staffing</strong>
                        <span>Capacities, rooms &amp; educator ratios</span>
                    </div>
                </button>

                <!-- 3. Missing Attendance / Incomplete Logs -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/management/attendance")'>
                    <div class="action-card-icon icon-box-amber">
                        <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardTask())" Color="Color.Custom" CustomColor="#8c5717" />
                    </div>
                    <div class="action-card-text">
                        <strong>Missing Attendance &amp; Logs</strong>
                        <span>@(_board.ExpectedNotArrivedCount > 0 ? $"{_board.ExpectedNotArrivedCount} pending check-in(s)" : "Check-in gaps & routine logs")</span>
                    </div>
                </button>

                <!-- 4. Safety Checks -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/safety-trust")'>
                    <div class="action-card-icon icon-box-rose">
                        <FluentIcon Value="@(new Icons.Regular.Size24.ShieldCheckmark())" Color="Color.Custom" CustomColor="#9b2c2c" />
                    </div>
                    <div class="action-card-text">
                        <strong>Safety Checks &amp; Protocols</strong>
                        <span>Floor maps, drills &amp; checklists</span>
                    </div>
                </button>

                <!-- 5. Staff Assignments -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/users-by-role")'>
                    <div class="action-card-icon icon-box-blue">
                        <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())" Color="Color.Custom" CustomColor="#2b6cb0" />
                    </div>
                    <div class="action-card-text">
                        <strong>Staff Assignments</strong>
                        <span>Branch educators &amp; room coverage</span>
                    </div>
                </button>

                <!-- 6. Branch Schedule -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/events")'>
                    <div class="action-card-icon icon-box-teal">
                        <FluentIcon Value="@(new Icons.Regular.Size24.CalendarMonth())" Color="Color.Custom" CustomColor="#2c7a7b" />
                    </div>
                    <div class="action-card-text">
                        <strong>Branch Schedule</strong>
                        <span>Events, celebrations &amp; branch calendar</span>
                    </div>
                </button>

                <!-- 7. Pending Parent Issues -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/classroom-messages")'>
                    <div class="action-card-icon icon-box-purple">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Chat())" Color="Color.Custom" CustomColor="#553c9a" />
                    </div>
                    <div class="action-card-text">
                        <strong>Pending Parent Issues</strong>
                        <span>Family communications &amp; escalations</span>
                    </div>
                    @if (_chatUnreadCount > 0)
                    {
                        <span class="action-badge-unread">@_chatUnreadCount</span>
                    }
                </button>

                <!-- 8. Branch Reports -->
                <button class="action-card-btn" @onclick='() => Navigation.NavigateTo("/insights")'>
                    <div class="action-card-icon icon-box-sage">
                        <FluentIcon Value="@(new Icons.Regular.Size24.BrainCircuit())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div class="action-card-text">
                        <strong>Branch Reports</strong>
                        <span>Attendance, occupancy &amp; operational trends</span>
                    </div>
                </button>
            </div>
        </div>

        <!-- ================= SECTION E: NEEDS ATTENTION ================= -->
        @if (GetAttentionItems().Any())
        {
            <div class="needs-attention-box">
                <div class="attention-header">
                    <span class="attention-badge">
                        <FluentIcon Value="@(new Icons.Filled.Size16.Alert())" Color="Color.Custom" CustomColor="#8c5717" />
                        Branch Needs Attention Today
                    </span>
                    <span class="attention-count">@GetAttentionItems().Count Action Item(s)</span>
                </div>
                <div class="attention-items-list">
                    @foreach (var item in GetAttentionItems())
                    {
                        <div class="attention-row @item.SeverityClass">
                            <span class="attention-icon">@item.Icon</span>
                            <div class="attention-desc">
                                <strong>@item.Title</strong>
                                <span>@item.Description</span>
                            </div>
                            <a href="@item.ActionUrl" class="btn secondary btn-sm attention-btn">
                                @item.ActionText &rarr;
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ================= MAIN TWO-COLUMN WORKSPACE GRID ================= -->
        <div class="workspace-layout-grid">
            <!-- LEFT COLUMN: TODAY'S RHYTHM & SCHEDULE -->
            <div class="workspace-main-col">
                <div class="workspace-card">
                    <div class="card-header-row">
                        <div>
                            <h2 class="card-title">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Clock())" Color="Color.Custom" CustomColor="#52745e" />
                                Today's Branch Operations Rhythm
                            </h2>
                            <p class="card-subtitle">Scheduled activities across branch classrooms</p>
                        </div>
                        <div class="card-header-actions" style="display: flex; gap: 8px;">
                            <button class="btn secondary btn-xs" @onclick="() => _isMaterialsBasketOpen = true" style="display: inline-flex; align-items: center; gap: 5px;">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Box())" Color="Color.Custom" CustomColor="#52745e" />
                                <span>Materials Basket</span>
                            </button>
                            <a href="/planning" class="btn secondary btn-xs" style="display: inline-flex; align-items: center; gap: 5px;">
                                <FluentIcon Value="@(new Icons.Regular.Size16.CalendarAdd())" Color="Color.Custom" CustomColor="#52745e" />
                                <span>Planning Calendar</span>
                            </a>
                        </div>
                    </div>

                    <div class="rhythm-timeline-list">
                        @if (_board.TodayRhythm != null && _board.TodayRhythm.Any())
                        {
                            @foreach (var item in _board.TodayRhythm)
                            {
                                bool isRunning = item.Status == "Started" || item.Status == "Active" || item.Status == "InProgress";
                                bool isPlanned = item.Status == "Scheduled" || item.Status == "Planned" || item.Status == "Confirmed";
                                bool isDone = item.Status == "Completed" || item.Status == "Finished";

                                <div class="rhythm-entry-card @(isRunning ? "is-running" : (isDone ? "is-done" : ""))">
                                    <div class="entry-time-col">
                                        <span class="time-badge">@item.TimeDisplay</span>
                                        <div class="timeline-indicator-dot @(isRunning ? "dot-pulse" : (isDone ? "dot-done" : "dot-planned"))"></div>
                                    </div>

                                    <div class="entry-content-col">
                                        <div class="entry-title-row">
                                            <div>
                                                @if (item.IsCelebration)
                                                {
                                                    <span class="celebration-pill">🎉 Celebration</span>
                                                }
                                                <h3 class="entry-title">@item.Title</h3>
                                                <span class="entry-room">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Door())" Color="Color.Custom" CustomColor="#6c7870" />
                                                    @(string.IsNullOrEmpty(item.ClassroomName) ? "Whole Branch" : item.ClassroomName)
                                                </span>
                                            </div>

                                            <div class="entry-actions-group">
                                                @if (!item.IsCelebration)
                                                {
                                                    @if (isRunning)
                                                    {
                                                        <button class="btn secondary btn-xs" @onclick="() => OpenSessionPhotoModal(item)" title="Add session photos">
                                                            <FluentIcon Value="@(new Icons.Regular.Size16.Camera())" Color="Color.Custom" CustomColor="#52745e" />
                                                            <span>Photos @(item.PhotoUrls?.Length > 0 ? $"({item.PhotoUrls.Length})" : "")</span>
                                                        </button>
                                                        <button class="btn primary btn-xs" @onclick="() => CloseSession(item.Id)">
                                                            <span>End Session</span>
                                                        </button>
                                                        <button class="btn secondary btn-xs text-sage" @onclick="() => OpenActiveSession(item.Id)">
                                                            <span>Open Session &rarr;</span>
                                                        </button>
                                                    }
                                                    else if (isPlanned)
                                                    {
                                                        <button class="btn primary btn-xs" @onclick="() => StartSession(item.Id)">
                                                            <FluentIcon Value="@(new Icons.Filled.Size16.Play())" Color="Color.Custom" CustomColor="#ffffff" />
                                                            <span>Start</span>
                                                        </button>
                                                    }
                                                    else if (isDone)
                                                    {
                                                        <span class="done-tag">✓ Concluded</span>
                                                        @if (item.PhotoUrls?.Length > 0)
                                                        {
                                                            <button class="btn secondary btn-xs" @onclick="() => OpenSessionPhotoModal(item)">
                                                                <FluentIcon Value="@(new Icons.Regular.Size16.Image())" Color="Color.Custom" CustomColor="#52745e" />
                                                                <span>@item.PhotoUrls.Length Photos</span>
                                                            </button>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    @if (isRunning)
                                                    {
                                                        <button class="btn primary btn-xs" @onclick="() => FinishCelebration(item.Id)">
                                                            <span>Conclude Celebration</span>
                                                        </button>
                                                    }
                                                    else if (isPlanned)
                                                    {
                                                        <button class="btn primary btn-xs" @onclick="() => StartCelebration(item.Id)">
                                                            <span>Begin Event</span>
                                                        </button>
                                                    }
                                                    else if (isDone)
                                                    {
                                                        <span class="done-tag">✓ Celebrated</span>
                                                        @if (item.PhotoUrls?.Length > 0)
                                                        {
                                                            <button class="btn secondary btn-xs" @onclick="() => OpenEventPhotoModal(item.Id)">
                                                                <span>@item.PhotoUrls.Length Photos</span>
                                                            </button>
                                                        }
                                                    }
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(item.PreparationNotes))
                                        {
                                            <div class="entry-prep-notes">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Lightbulb())" Color="Color.Custom" CustomColor="#8c5717" />
                                                <span>@item.PreparationNotes</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-rhythm-state">
                                <FluentIcon Value="@(new Icons.Regular.Size32.Sparkle())" Color="Color.Custom" CustomColor="#8c5717" />
                                <h4>No Scheduled Experiences Today</h4>
                                <p>Plan learning experiences from the library or let children lead open exploratory play.</p>
                                <a href="/planning" class="btn primary btn-sm">Schedule Branch Experiences</a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: CLASSROOM ROSTER & TASKS -->
            <div class="workspace-side-col">
                <!-- CLASSROOM HEALTH ROSTER -->
                <div class="workspace-card">
                    <div class="card-header-row">
                        <div>
                            <h3 class="card-title">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Board())" Color="Color.Custom" CustomColor="#52745e" />
                                Branch Classrooms &amp; Capacity
                            </h3>
                            <p class="card-subtitle">Real-time room occupancy and teacher coverage</p>
                        </div>
                    </div>

                    <div class="classroom-roster-board">
                        @if (_board.Classrooms != null && _board.Classrooms.Any())
                        {
                            @foreach (var room in _board.Classrooms)
                            {
                                <div class="classroom-mini-card @(room.IsOverCapacity ? "room-danger" : (room.IsUnderstaffed ? "room-warning" : ""))">
                                    <div class="room-mini-top">
                                        <div>
                                            <h4 class="room-mini-name">@room.ClassroomName</h4>
                                            <span class="room-mini-age">@room.AgeGroup</span>
                                        </div>
                                        <span class="room-occupancy-pill @room.StatusPillCss">
                                            @room.OccupancyPercentage% Full
                                        </span>
                                    </div>

                                    <div class="room-mini-metrics">
                                        <div class="mini-metric">
                                            <span class="lbl">Children</span>
                                            <strong>@room.PresentChildren / @room.Capacity</strong>
                                        </div>
                                        <div class="mini-metric">
                                            <span class="lbl">Staff</span>
                                            <strong class="@(room.IsUnderstaffed ? "text-danger" : "")">@room.PresentStaff / @room.RequiredStaff req</strong>
                                        </div>
                                    </div>

                                    <div class="room-bar-track">
                                        <div class="room-bar-fill @(room.IsOverCapacity ? "bar-red" : (room.IsUnderstaffed ? "bar-amber" : "bar-green"))" 
                                             style="width: @Math.Min(room.OccupancyPercentage, 100)%;"></div>
                                    </div>

                                    @{
                                        var roomExp = _board.TodayRhythm?.FirstOrDefault(r => r.ClassroomId == room.ClassroomId && !r.IsCelebration);
                                    }
                                    @if (roomExp != null)
                                    {
                                        <div style="margin: 8px 0 4px; padding: 6px 8px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 6px; font-size: 11px; display: flex; justify-content: space-between; align-items: center; gap: 6px;">
                                            <span style="color: var(--text, #26332d); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px;">🎨 @roomExp.Title</span>
                                            <span style="color: #2e7d32; font-weight: 700; font-size: 9.5px; background: #e8f5e9; padding: 1px 5px; border-radius: 4px; white-space: nowrap;">✓ Ready</span>
                                        </div>
                                    }

                                    <div class="room-mini-actions">
                                        <a href="/management/attendance" class="room-action-link">Attendance &rarr;</a>
                                        <a href="/daily-care" class="room-action-link">Daily Care &rarr;</a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- DAILY READINESS CHECKLIST -->
                <div class="workspace-card readiness-checklist-box">
                    <div class="card-header-row">
                        <h3 class="card-title">
                            <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="#52745e" />
                            Branch Readiness Protocol
                        </h3>
                    </div>

                    <div class="checklist-items-stack">
                        @if (_board.ReadinessChecklist != null && _board.ReadinessChecklist.Any())
                        {
                            @foreach (var item in _board.ReadinessChecklist)
                            {
                                <div class="checklist-item-row @(item.IsCompleted ? "item-done" : "")" @onclick="() => ToggleChecklistItem(item)">
                                    <div class="chk-box-circle @(item.IsCompleted ? "chk-checked" : "")">
                                        @if (item.IsCompleted)
                                        {
                                            <span>✓</span>
                                        }
                                    </div>
                                    <div class="chk-text">
                                        <strong class="@(item.IsCompleted ? "strike" : "")">@item.Label</strong>
                                        <span>@item.Description</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- END OF DAY CLOSURE -->
                <div class="workspace-card end-of-day-card">
                    <div class="card-header-row">
                        <h3 class="card-title text-sage-dark">
                            <FluentIcon Value="@(new Icons.Regular.Size20.CalendarCheckmark())" Color="Color.Custom" CustomColor="#31523c" />
                            End of Day Closure
                        </h3>
                    </div>
                    <p class="card-subtitle">Verify check-outs, staff departures, and close today's branch operation.</p>
                    <button class="btn primary btn-sm w-100 mt-2" @onclick="() => _isEndOfDayModalOpen = true">
                        Run End of Day Process &rarr;
                    </button>
                </div>

                <!-- PARENT INQUIRIES & CHAT CARD -->
                <div class="workspace-card family-card">
                    <div class="family-card-top">
                        <div class="family-icon">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Chat())" Color="Color.Custom" CustomColor="#553c9a" />
                        </div>
                        <div>
                            <h4 class="family-title">Family Communications</h4>
                            <p class="family-desc">
                                @if (_chatUnreadCount > 0)
                                {
                                    <span class="text-alert font-bold">@_chatUnreadCount unread message(s) from parents</span>
                                }
                                else
                                {
                                    <span>All parent messages answered</span>
                                }
                            </p>
                        </div>
                    </div>
                    <a href="/classroom-messages" class="btn primary btn-sm w-100">
                        Open Classroom Messages
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@* PHOTO LIGHTBOX PREVIEW *@
<PhotoLightboxModal PhotoUrl="@_previewPhoto" OnClose="() => _previewPhoto = null" />

@* ACTIVE SESSION MODAL *@
@if (_isSessionModalOpen)
{
    <ActiveSessionModal ScheduleId="@_activeSessionScheduleId"
                        OnSessionEnded="OnSessionEnded"
                        OnClose="() => _isSessionModalOpen = false" />
}

@* EVENT PHOTO MODAL *@
<EventPhotoModal 
    IsOpen="_isPhotoModalOpen"
    Title="@_photoModalEventTitle"
    Photos="@_photoModalEventPhotos"
    MaxPhotos="3"
    PhotosChanged="OnEventPhotosSaved"
    OnClose="() => _isPhotoModalOpen = false" />

@* SESSION PHOTO MODAL *@
<SessionPhotoModal 
    IsOpen="_isSessionPhotoModalOpen"
    ScheduleId="@_sessionPhotoScheduleId"
    Title="@_sessionPhotoTitle"
    Photos="@_sessionPhotoUrls"
    MaxPhotos="5"
    PhotosChanged="OnSessionPhotosSaved"
    OnOpenFullSession="OpenActiveSession"
    OnClose="() => _isSessionPhotoModalOpen = false" />

@* END OF DAY PROCESS MODAL *@
<EndOfDayProcessModal 
    IsOpen="_isEndOfDayModalOpen"
    BranchId="@(Guid.TryParse(_selectedBranchId, out var bId) ? bId : null)"
    Date="DateTime.Today"
    OnClose="() => _isEndOfDayModalOpen = false"
    OnCompleted="HandleEndOfDayCompleted" />

@* WEEKLY MATERIALS BASKET MODAL *@
@if (_isMaterialsBasketOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1050; background: rgba(38, 51, 45, 0.45); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 20px;" @onclick="() => _isMaterialsBasketOpen = false">
        <div style="background: var(--surface, #ffffff); border-radius: var(--radius, 18px); max-width: 640px; width: 100%; max-height: 85vh; display: flex; flex-direction: column; box-shadow: var(--shadow, 0 16px 40px rgba(40, 55, 47, 0.16)); border: 1px solid var(--border, #e4e7df); overflow: hidden;" @onclick:stopPropagation="true">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--border, #e4e7df); display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; background: var(--accent-light, #e6eee9); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--accent-dark, #31523c);">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Box())" Color="Color.Custom" CustomColor="#31523c" />
                    </div>
                    <div>
                        <div style="font-size: 11px; font-weight: 800; color: var(--accent-dark, #31523c); text-transform: uppercase;">Classroom Readiness</div>
                        <h3 style="font-size: 17px; font-weight: 800; color: var(--text, #26332d); margin: 0;">Weekly Materials Basket</h3>
                    </div>
                </div>
                <button type="button" @onclick="() => _isMaterialsBasketOpen = false" style="background: none; border: none; font-size: 18px; color: var(--muted, #6c7870); cursor: pointer;">✕</button>
            </div>

            <div style="padding: 20px 24px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 16px;">
                <p style="font-size: 13px; color: var(--muted, #6c7870); margin: 0;">
                    Materials required across branch classrooms for this week's scheduled Experience Studio activities:
                </p>

                <!-- 1. Art & Creative Tools -->
                <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 14px;">
                    <div style="font-size: 12px; font-weight: 800; color: #8c5717; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <span>🎨</span>
                        <span>ART &amp; CREATIVE SUPPLIES</span>
                    </div>
                    <ul style="margin: 0; padding-left: 20px; font-size: 12.5px; color: var(--text, #26332d); line-height: 1.6;">
                        <li>Heavy watercolor &amp; finger-paint paper (30 sheets) — <em>Preschool Room</em></li>
                        <li>Non-toxic washable tempera paints (Blue, Teal, Yellow) — <em>Toddler Room</em></li>
                        <li>Chubby paint brushes &amp; natural sponges (12 count) — <em>Toddler &amp; Infant Rooms</em></li>
                    </ul>
                </div>

                <!-- 2. Sensory & Natural Elements -->
                <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 14px;">
                    <div style="font-size: 12px; font-weight: 800; color: #2e7d32; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <span>🌿</span>
                        <span>NATURAL &amp; SENSORY MATERIALS</span>
                    </div>
                    <ul style="margin: 0; padding-left: 20px; font-size: 12.5px; color: var(--text, #26332d); line-height: 1.6;">
                        <li>Sensory water trays &amp; blue food-safe ice cubes — <em>Toddler Room A</em></li>
                        <li>Clean pinecones, smooth river stones &amp; dry autumn leaves — <em>Nature Discovery</em></li>
                        <li>Safe textured fabric ribbons (cotton, burlap, silk) — <em>Infant Sensory Corner</em></li>
                    </ul>
                </div>

                <!-- 3. Household & Loose Parts -->
                <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 10px; padding: 14px;">
                    <div style="font-size: 12px; font-weight: 800; color: #31523c; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <span>📦</span>
                        <span>LOOSE PARTS &amp; RECYCLED EXPLORATION</span>
                    </div>
                    <ul style="margin: 0; padding-left: 20px; font-size: 12.5px; color: var(--text, #26332d); line-height: 1.6;">
                        <li>Clean cardboard cylinders &amp; nesting bowls — <em>Building &amp; Balance</em></li>
                        <li>Wooden scoops &amp; metal measuring spoons — <em>Fine Motor Exploration</em></li>
                    </ul>
                </div>
            </div>

            <div style="padding: 14px 24px; border-top: 1px solid var(--border, #e4e7df); display: flex; justify-content: flex-end; gap: 10px; background: #fafbfa;">
                <button type="button" class="btn secondary" @onclick="() => _isMaterialsBasketOpen = false">Close</button>
                <button type="button" class="btn primary" @onclick='() => NotificationService.ShowSuccessAsync("Materials basket checklist confirmed and saved!")'>
                    ✓ Mark Branch Cubby Verified
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@media (max-width: 640px) {
        .branch-gate-alert {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
            padding: 14px 16px !important;
        }

        .branch-gate-btn {
            width: 100% !important;
            text-align: center !important;
            justify-content: center !important;
        }
    }
</style>

