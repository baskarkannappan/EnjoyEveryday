@page "/studio"
@page "/studio/{ExperienceId:guid}"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using System.Text.Json
@using Microsoft.FluentUI.AspNetCore.Components

@inject ExperienceService ExperienceService
@inject ClassroomService ClassroomService
@inject PlannerService PlannerService
@inject UserService UserService
@inject NavigationManager NavigationManager
@inject IAiIdeaService AiIdeaService
@inject INotificationService ToastService
@inject IJSRuntime JS
@inject EnjoyEveryday.Daycare.Web.Services.StorybookStorageService StorybookStorageService
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject EnjoyEveryday.Application.Services.Ai.IStorybookGenerationService StorybookGenerationService
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject IConfiguration Configuration
<div class="content">
    <PageHero Eyebrow="@_orgName"
              Title="Experience Studio"
              Subtitle="Design and refine developmental experiences with structured DNA, timeline phases, and AI co-creation.">
        <RightContent>
            <a href="/experiences" class="studio-btn studio-btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                📚 Library
            </a>
            <button class="studio-btn studio-btn-secondary" @onclick="GenerateStorybookInteractiveAsync" style="border-color: var(--accent, #557c6c); color: var(--accent-dark, #31523c); background: var(--accent-light, #e6eee9); font-weight: 700;">
                📖 Generate Storybook
            </button>
            <button class="studio-btn studio-btn-secondary" @onclick="CopyGeminiStorybookPromptAsync" title="Copy Master Prompt for Google Gemini to generate 6-panel illustrated picture book">
                ✨ Copy Gemini Storybook Prompt
            </button>
            @if (_experience.Status != "Published")
            {
                <button class="studio-btn studio-btn-secondary" @onclick="OpenHistoryDialog">
                    Compare Versions
                </button>
                <button class="studio-btn studio-btn-secondary" @onclick="OpenPreview">
                    Preview
                </button>
                <button class="studio-btn studio-btn-primary" @onclick="SaveDraftAsync">
                    Save Draft
                </button>
                <button class="studio-btn studio-btn-outline" @onclick="PublishAsync">
                    Publish
                </button>
            }
            else
            {
                <button class="studio-btn studio-btn-secondary" @onclick="OpenDeployModal" style="border-color: var(--accent, #557c6c); color: var(--accent-dark, #31523c); background: var(--accent-light, #e6eee9); font-weight: 700;">
                    🚀 Schedule to Classrooms
                </button>
                <button class="studio-btn studio-btn-primary" @onclick="PlanExperience">
                    Plan Experience
                </button>
            }
        </RightContent>
    </PageHero>

    <!-- Studio Navigation Tabs -->
    <FilterTabs Tabs="StudioTabs" ActiveTab="@_activeStudioTab" OnTabSelected="SetStudioTab" />

    @if (_isLoading)
    {
        <div style="padding: 40px; text-align: center;">Loading Experience...</div>
    }
    else
    {
        <div class="studio-grid studio-view-@_activeStudioTab">

            <!-- LEFT PANEL: AI Inspiration -->
            @if (_activeStudioTab == "all" || _activeStudioTab == "ai")
            {
                <div class="studio-col-ai">
                    <div class="card idea-card" style="margin-bottom: 20px;">
                        <div class="idea-heading" style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                            <div class="idea-icon">&#10022;</div>
                            <div>
                                <strong>Start with an idea</strong>
                                <div style="font-size: 13px; color: var(--muted, #6c7870); margin-top: 2px;">Describe a scenario, select a focus area, or list materials on your table.</div>
                            </div>
                        </div>

                        <!-- Guided Focus Chips -->
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px;">
                            <button type="button" class="studio-btn studio-btn-secondary" style="padding: 4px 8px; font-size: 11px; border-radius: 4px; @(_selectedFocusArea == "Sensory" ? "background: var(--accent-light, #e6eee9); border-color: var(--accent, #557c6c); font-weight: 700; color: var(--accent-dark, #31523c);" : "")" @onclick='() => SelectFocusChip("Sensory", "Sensory tactile exploration")'>🖐️ Sensory</button>
                            <button type="button" class="studio-btn studio-btn-secondary" style="padding: 4px 8px; font-size: 11px; border-radius: 4px; @(_selectedFocusArea == "Nature" ? "background: var(--accent-light, #e6eee9); border-color: var(--accent, #557c6c); font-weight: 700; color: var(--accent-dark, #31523c);" : "")" @onclick='() => SelectFocusChip("Nature", "Outdoor nature studio")'>🌿 Nature</button>
                            <button type="button" class="studio-btn studio-btn-secondary" style="padding: 4px 8px; font-size: 11px; border-radius: 4px; @(_selectedFocusArea == "Motor" ? "background: var(--accent-light, #e6eee9); border-color: var(--accent, #557c6c); font-weight: 700; color: var(--accent-dark, #31523c);" : "")" @onclick='() => SelectFocusChip("Motor", "Movement & gross motor play")'>🏃 Motor</button>
                            <button type="button" class="studio-btn studio-btn-secondary" style="padding: 4px 8px; font-size: 11px; border-radius: 4px; @(_selectedFocusArea == "Language" ? "background: var(--accent-light, #e6eee9); border-color: var(--accent, #557c6c); font-weight: 700; color: var(--accent-dark, #31523c);" : "")" @onclick='() => SelectFocusChip("Language", "Storytelling, vocabulary & naming")'>🗣️ Language</button>
                            <button type="button" class="studio-btn studio-btn-secondary" style="padding: 4px 8px; font-size: 11px; border-radius: 4px; @(_selectedFocusArea == "STEM" ? "background: var(--accent-light, #e6eee9); border-color: var(--accent, #557c6c); font-weight: 700; color: var(--accent-dark, #31523c);" : "")" @onclick='() => SelectFocusChip("STEM", "Loose parts construction & early STEM")'>🧩 STEM</button>
                            <button type="button" class="studio-btn studio-btn-secondary" style="padding: 4px 8px; font-size: 11px; border-radius: 4px; @(_selectedFocusArea == "LowPrep" ? "background: var(--accent-light, #e6eee9); border-color: var(--accent, #557c6c); font-weight: 700; color: var(--accent-dark, #31523c);" : "")" @onclick='() => SelectFocusChip("LowPrep", "Quick setup with everyday items")'>⏱️ Low Prep</button>
                        </div>

                        <textarea @bind="_ideaInput" class="studio-input" style="margin-bottom: 10px; min-height: 90px; resize: vertical;" placeholder="Example: The children are fascinated by shadows, or we set out pinecones on the tray..."></textarea>

                        <!-- Classroom Grounding Controls -->
                        <div style="background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 6px; padding: 10px; margin-bottom: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <span style="font-size: 11px; font-weight: 800; color: var(--accent-dark, #31523c); text-transform: uppercase;">Classroom Grounding</span>
                                <button type="button" style="background: none; border: none; font-size: 11px; color: var(--muted, #6c7870); cursor: pointer;" @onclick="() => _showAdvancedGrounding = !_showAdvancedGrounding">
                                    @(_showAdvancedGrounding ? "▲ Fewer options" : "▼ More options")
                                </button>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                <div>
                                    <label style="font-size: 11px; font-weight: 700; color: var(--text, #26332d); display: block; margin-bottom: 2px;">Age Group</label>
                                    <select class="studio-input" @bind="_selectedAgeTier" style="width: 100%; padding: 4px 6px; font-size: 12px;">
                                        <option value="Toddler (18-36m)">Toddler (18-36m)</option>
                                        <option value="Preschool (3-5y)">Preschool (3-5y)</option>
                                        <option value="Multi-Age (2-6y)">Multi-Age (2-6y)</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size: 11px; font-weight: 700; color: var(--text, #26332d); display: block; margin-bottom: 2px;">Environment</label>
                                    <select class="studio-input" @bind="_selectedEnvironmentSetting" style="width: 100%; padding: 4px 6px; font-size: 12px;">
                                        <option value="Indoor">Indoor</option>
                                        <option value="Outdoor">Outdoor</option>
                                        <option value="Indoor / Outdoor">Indoor / Outdoor</option>
                                    </select>
                                </div>
                            </div>

                            @if (_showAdvancedGrounding)
                            {
                                <div style="margin-top: 8px;">
                                    <label style="font-size: 11px; font-weight: 700; color: var(--text, #26332d); display: block; margin-bottom: 2px;">Materials On-Hand (Comma separated)</label>
                                    <input type="text" class="studio-input" @bind="_materialsOnHandInput" placeholder="e.g. Pinecones, playdough, paper rolls, string" style="width: 100%; padding: 4px 6px; font-size: 12px;" />
                                </div>
                            }
                        </div>

                        <div class="idea-actions" style="margin-top: 6px;">
                            <button class="studio-btn studio-btn-primary" style="width: 100%; padding: 12px; font-weight: 700;" @onclick="GenerateIdeasAsync" disabled="@_isGeneratingIdeas">
                                &#10022; @(_isGeneratingIdeas ? "Synthesizing with Gemini..." : "Help me explore")
                            </button>
                        </div>
                    </div>

                    @if (_showStudioStatusLog)
                    {
                        <div class="card studio-diagnostics-card" style="margin-bottom: 20px; border-left: 4px solid @(GetDiagnosticsAccentColor());">
                            <div class="diagnostics-header">
                                <div class="diagnostics-title-group">
                                    <span class="diagnostics-icon">&#10022;</span>
                                    <strong>AI Engine Status</strong>
                                    <span class="diagnostics-pill diagnostics-pill-@_diagnosticsStatusType">
                                        @if (_isGeneratingIdeas || _isImproving)
                                        {
                                            <span class="diagnostics-spinner"></span>
                                        }
                                        @_diagnosticsBadge
                                    </span>
                                </div>
                                <button type="button" class="diagnostics-toggle-btn" @onclick="() => _isDiagnosticsExpanded = !_isDiagnosticsExpanded">
                                    @(_isDiagnosticsExpanded ? "Hide Logs" : "View Logs")
                                </button>
                            </div>

                            @if (_isDiagnosticsExpanded)
                            {
                                <div class="diagnostics-log-console">
                                    @if (_diagnosticsLogs.Any())
                                    {
                                        @foreach (var log in _diagnosticsLogs)
                                        {
                                            <div class="diagnostics-log-line">@log</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="diagnostics-log-empty">AI Engine ready. Click &ldquo;Help me explore&rdquo; to see live connection and model diagnostics.</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="card">
                        <div class="card-header">
                            <h2>Possible directions</h2>
                            <span>AI suggestions</span>
                        </div>

                        @if (_aiSuggestions.Any())
                        {
                            @foreach (var suggestion in _aiSuggestions)
                            {
                                <div class="suggestion-card" @onclick="() => ApplySuggestion(suggestion)">
                                    <div class="suggestion-title">@suggestion.Title</div>
                                    <div class="suggestion-text">@suggestion.Description</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="padding: 16px; color: #4b5563; font-size: 14px;">Tell me an idea above to get AI suggestions!</div>
                        }
                    </div>
                </div>
            }

            <!-- CENTER CANVAS -->
            @if (_activeStudioTab == "all" || _activeStudioTab == "canvas" || _activeStudioTab == "timeline")
            {
                <div class="studio-col-canvas">
                    <div class="canvas">
                    <div class="canvas-top">
                        <div class="canvas-title">
                            <input id="experienceTitle" @bind="_experience.Title" @bind:after="SaveDraftAsync" placeholder="Experience Title" />
                            <div class="canvas-subtitle">
                                @_experience.Status &bull; Created @_experience.CreatedAt.ToString("MMMM dd, yyyy")
                                @if (_saveMessage != null)
                                {
                                    <span style="margin-left: 10px; color: #456a55; font-weight: bold;">@_saveMessage</span>
                                }
                                @if (_validationMessage != null)
                                {
                                    <span style="margin-left: 10px; color: #c44; font-weight: bold;">@_validationMessage</span>
                                }
                            </div>
                        </div>
                        <div class="status-pill">
                            @_experience.Status.ToUpper()
                        </div>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label class="context-label" style="display: block; margin-bottom: 6px; font-weight: 700; color: var(--text, #26332d);">Experience Mission & Summary</label>
                        <textarea class="studio-input" @bind="_experience.Description" @bind:after="SaveDraftAsync"
                                  placeholder="Describe the learning mission and core experience in clear, teacher-friendly words..."
                                  style="min-height: 72px; width: 100%; border-radius: 0px; border: 1px solid var(--border, #e4e7df); padding: 12px; font-size: 14px; line-height: 1.5; resize: vertical;"></textarea>
                    </div>

                    <div class="dna-grid">
                        <StudioDnaCard Label="Challenge" @bind-TextContent="_dna.Challenge" OnSave="SaveDraftAsync" />
                        <StudioDnaCard Label="Together" @bind-TextContent="_dna.Together" OnSave="SaveDraftAsync" />
                        <StudioDnaCard Label="Create" @bind-TextContent="_dna.Create" OnSave="SaveDraftAsync" />
                        <StudioDnaCard Label="Child Choice" @bind-TextContent="_dna.ChildChoice" OnSave="SaveDraftAsync" />

                        <StudioMagicMoment @bind-Content="_dna.MagicMoment" OnSave="SaveDraftAsync" />

                        <StudioDnaCard Label="Accomplishment" @bind-TextContent="_dna.Accomplishment" OnSave="SaveDraftAsync" />
                        <StudioDnaCard Label="Reflection" @bind-TextContent="_dna.Reflection" OnSave="SaveDraftAsync" />

                        <StudioDnaCard IsFull="true" Label="Teacher Guidance" @bind-TextContent="_dna.TeacherGuidance" OnSave="SaveDraftAsync" />
                    </div>

                    <div style="margin-top: 30px;">
                        <h3 style="font-size: 18px; color: #111827; margin-bottom: 16px;">Activity Timeline (Execution Phases)</h3>
                        @foreach (var phase in _dna.ExecutionGuide.Phases)
                        {
                            <div class="phase-card" draggable="true" 
                                 @ondragstart="() => HandleDragStart(phase)"
                                 @ondragenter="e => HandleDragEnter(e, phase)"
                                 @ondragend="HandleDragEnd"
                                 @ondragover:preventDefault="true"
                                 style="cursor: grab;">
                                <div style="display: flex; align-items: center; margin-right: 8px; cursor: grab; color: #9ca3af;">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M4 6h2v2H4V6zm0 4h2v2H4v-2zm4-4h2v2H8V6zm0 4h2v2H8v-2zm4-4h2v2h-2V6zm0 4h2v2h-2v-2z" />
                                    </svg>
                                </div>
                                <input type="text" @bind="phase.Name" @bind:after="SaveDraftAsync" placeholder="Phase Name (e.g. Introduction)" class="studio-input" style="flex: 1; min-width: 150px;" />
                                <div style="display: flex; align-items: center; gap: 8px; font-size: 15px; color: #374151; font-weight: 600;">
                                    <input type="number" @bind="phase.DurationMinutes" @bind:after="SaveDraftAsync" placeholder="Min" class="studio-input" style="width: 80px; text-align: center;" /> min
                                </div>
                                <button class="studio-btn studio-btn-danger" @onclick="() => RemovePhase(phase)" title="Remove Phase">✕</button>

                                <div style="flex-basis: 100%; display: flex; gap: 10px; margin-top: 8px;">
                                    <div style="flex: 1;">
                                        <div class="context-label">Teacher Does</div>
                                        <textarea @bind="phase.TeacherDoes" @bind:after="SaveDraftAsync" placeholder="Explain the activity..." class="studio-input" style="min-height: 80px; resize: vertical;"></textarea>
                                    </div>
                                    <div style="flex: 1;">
                                        <div class="context-label">Children Do</div>
                                        <textarea @bind="phase.ChildrenDo" @bind:after="SaveDraftAsync" placeholder="Listen and respond..." class="studio-input" style="min-height: 80px; resize: vertical;"></textarea>
                                    </div>
                                </div>
                            </div>
                        }
                        <button class="studio-btn studio-btn-ghost" style="width: 100%; padding: 12px; margin-top: 8px;" @onclick="AddPhase">+ Add another phase</button>
                    </div>
                </div>
            </div>
            }

            <!-- RIGHT PANEL: Details & AI Refinement -->
            @if (_activeStudioTab == "all" || _activeStudioTab == "details")
            {
                <aside class="right-panel studio-col-details">
                <div class="card">
                    <div class="card-header">
                        <h2>Experience details</h2>
                    </div>

                    <div class="context-item">
                        <div class="context-label">Age (Years)</div>
                        <div style="display:flex; gap:12px; align-items:center;">
                            <input type="number" @bind="_dna.AgeMin" @bind:after="SaveDraftAsync" min="0" max="12" class="studio-input" style="text-align: center;" />
                            <span style="font-size: 15px; color: #4b5563; font-weight: 600;">to</span>
                            <input type="number" @bind="_dna.AgeMax" @bind:after="SaveDraftAsync" min="0" max="12" class="studio-input" style="text-align: center;" />
                        </div>
                    </div>

                    <div class="context-item">
                        <div class="context-label">Group size</div>
                        <div style="display:flex; gap:12px; align-items:center;">
                            <input type="number" @bind="_dna.GroupSizeMin" @bind:after="SaveDraftAsync" min="1" class="studio-input" style="text-align: center;" />
                            <span style="font-size: 15px; color: #4b5563; font-weight: 600;">to</span>
                            <input type="number" @bind="_dna.GroupSizeMax" @bind:after="SaveDraftAsync" min="1" class="studio-input" style="text-align: center;" />
                        </div>
                    </div>

                    <div class="context-item">
                        <div class="context-label">Environment</div>
                        <select @bind="_dna.Environment" @bind:after="SaveDraftAsync" class="studio-input" style="cursor: pointer;">
                            <option value="Indoor">Indoor</option>
                            <option value="Outdoor">Outdoor</option>
                            <option value="Indoor / Outdoor">Indoor / Outdoor</option>
                        </select>
                    </div>

                    <div class="context-item">
                        <div class="context-label">Materials</div>
                        <div class="tags" style="margin-bottom: 12px;">
                            @foreach (var material in _dna.Materials.ToList())
                            {
                                <span class="tag" @onclick="() => RemoveMaterial(material)" title="Click to remove">@material <span style="color: #ef4444; margin-left: 6px;">✕</span></span>
                            }
                        </div>
                        <div style="display:flex; gap:8px;">
                            <input type="text" @bind="_newMaterial" placeholder="New material" class="studio-input" />
                            <button class="studio-btn studio-btn-secondary" @onclick="AddMaterial">Add</button>
                            <button class="studio-btn studio-btn-outline" @onclick="SuggestMaterialsAsync" disabled="@_isSuggestingMaterials" title="AI Suggest Materials">✨</button>
                        </div>
                    </div>

                    <div class="context-item">
                        <div class="context-label">Developmental Goals</div>
                        <div class="tags" style="margin-bottom: 12px;">
                            @foreach (var goal in _dna.DevelopmentalGoals.ToList())
                            {
                                <span class="tag" @onclick="() => RemoveGoal(goal)" title="Click to remove">@goal <span style="color: #ef4444; margin-left: 6px; opacity: 0.8;">✕</span></span>
                            }
                        </div>
                        <div style="display:flex; gap:8px;">
                            <input type="text" @bind="_newGoal" placeholder="Add a goal (e.g. Fine Motor)" class="studio-input" />
                            <button class="studio-btn studio-btn-secondary" @onclick="AddGoal">Add</button>
                        </div>
                    </div>

                    <div style="margin-top: 15px; text-align: right;">
                        <button class="studio-btn studio-btn-primary" @onclick="SaveDraftAsync">Save Details</button>
                    </div>
                </div>

                <div class="card idea-card">
                    <div class="idea-heading">
                        <div class="idea-icon">&#10022;</div>
                        <div>
                            <strong>Improve with AI</strong>
                            <small>Keep the teacher in control.</small>
                        </div>
                    </div>

                    <button class="suggestion" @onclick="@(() => ImproveAsync("Make it more playful"))" disabled="@_isImproving" style="background: none; border: none; text-align: left; width: 100%; cursor: pointer; padding: 0;">
                        <div class="suggestion-title" style="text-decoration: underline;">Make it more playful</div>
                        <div class="suggestion-text">Add imaginary elements or game mechanics.</div>
                    </button>

                    <button class="suggestion" @onclick="@(() => ImproveAsync("Add more child choice"))" disabled="@_isImproving" style="background: none; border: none; text-align: left; width: 100%; cursor: pointer; padding: 0; margin-top: 10px;">
                        <div class="suggestion-title" style="text-decoration: underline;">Add more child choice</div>
                        <div class="suggestion-text">Give children more agency in how the experience flows.</div>
                    </button>

                    <div style="margin-top: 15px; display: flex; gap: 8px;">
                        <input type="text" @bind="_customImprovePrompt" placeholder="Custom request..." class="studio-input" />
                        <button class="studio-btn studio-btn-secondary" @onclick="() => ImproveAsync(_customImprovePrompt)" disabled="@(string.IsNullOrWhiteSpace(_customImprovePrompt) || _isImproving)" title="Apply Custom Improvement">✨</button>
                    </div>

                    @if (_isImproving)
                    {
                        <div style="margin-top: 10px; font-size: 13px; color: #456a55;">Thinking...</div>
                    }
                </div>

                <div class="card">
                    <div class="card-header">
                        <h2>Versions</h2>
                        <span>History</span>
                    </div>
                    @if (_versions != null && _versions.Any())
                    {
                        @foreach (var v in _versions)
                        {
                            <div class="version">
                                <strong>v@(v.VersionNumber)</strong>
                                <span>@v.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="version">
                            <strong style="color:var(--muted)">No published versions</strong>
                            <span>&mdash;</span>
                        </div>
                    }
                </div>
            </aside>
            }

        </div>
    }

    <ExperienceViewModal IsOpen="@_isPreviewOpen"
                         Title="@(_experience?.Title ?? "Experience")"
                         Mission="@(_experience?.Description ?? "No description available.")"
                         Discover="@(_dna?.Create ?? "")"
                         Challenge="@(_dna?.Challenge ?? "")"
                         JoyMoment="@(_dna?.MagicMoment ?? "")"
                         ExecutionGuide="@_dna?.ExecutionGuide"
                         OnClose="ClosePreview"
                         OnPrint="PrintExperience" />

    @if (_pendingImprovement != null && _experience != null && _dna != null)
    {
        <div style="position: fixed; inset: 0; z-index: 1100; background: rgba(38, 51, 45, 0.55); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 20px;">
            <div style="background: var(--surface, #ffffff); border-radius: 0px; border: 1px solid var(--border, #e4e7df); box-shadow: var(--shadow, 0 16px 40px rgba(40, 55, 47, 0.16)); width: 940px; max-width: 95%; max-height: 88vh; display: flex; flex-direction: column; overflow: hidden;">
                <!-- Header -->
                <div style="padding: 16px 24px; border-bottom: 1px solid var(--border, #e4e7df); display: flex; justify-content: space-between; align-items: center; background: var(--surface-soft, #f8f9f5);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 20px;">✨</span>
                        <div>
                            <div style="font-size: 11px; font-weight: 800; color: var(--accent-dark, #31523c); text-transform: uppercase;">AI Co-Creation Review</div>
                            <h3 style="font-size: 16px; font-weight: 800; color: var(--text, #26332d); margin: 0;">Review Proposed Improvements</h3>
                        </div>
                    </div>
                    <button type="button" style="background: none; border: none; font-size: 20px; color: var(--muted, #6c7870); cursor: pointer;" @onclick="RejectImprovement">✕</button>
                </div>

                <!-- Rationale Banner -->
                @if (!string.IsNullOrWhiteSpace(_pendingImprovement.Reason))
                {
                    <div style="padding: 12px 24px; background: var(--accent-light, #e6eee9); border-bottom: 1px solid #c8dacd; font-size: 13px; color: var(--accent-dark, #31523c);">
                        <strong>AI Pedagogical Focus:</strong> @_pendingImprovement.Reason
                    </div>
                }

                <!-- Diff Content Body -->
                <div style="overflow-y: auto; flex: 1; padding: 20px 24px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border, #e4e7df); padding-bottom: 8px;">
                        <div style="color: var(--muted, #6c7870);">Current Version</div>
                        <div style="color: var(--accent-dark, #31523c);">Proposed AI Improvement</div>
                    </div>

                    <!-- Title -->
                    <div style="margin-bottom: 16px;">
                        <div style="font-size: 11px; font-weight: 800; color: var(--text, #26332d); margin-bottom: 4px; text-transform: uppercase;">Title</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                            <div style="padding: 10px 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); font-size: 13px;">@_experience.Title</div>
                            <div style="padding: 10px 12px; background: #f0f7f3; border: 1px solid #c2e0cf; font-size: 13px; font-weight: 700; color: var(--accent-dark, #31523c);">@_pendingImprovement.UpdatedData.Title</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div style="margin-bottom: 16px;">
                        <div style="font-size: 11px; font-weight: 800; color: var(--text, #26332d); margin-bottom: 4px; text-transform: uppercase;">Mission & Description</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                            <div style="padding: 10px 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); font-size: 13px; line-height: 1.4;">@_experience.Description</div>
                            <div style="padding: 10px 12px; background: #f0f7f3; border: 1px solid #c2e0cf; font-size: 13px; line-height: 1.4; color: var(--text, #26332d);">@_pendingImprovement.UpdatedData.Description</div>
                        </div>
                    </div>

                    <!-- Challenge -->
                    <div style="margin-bottom: 16px;">
                        <div style="font-size: 11px; font-weight: 800; color: var(--text, #26332d); margin-bottom: 4px; text-transform: uppercase;">Challenge</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                            <div style="padding: 10px 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); font-size: 13px;">@(_dna.Challenge ?? "(Empty)")</div>
                            <div style="padding: 10px 12px; background: #f0f7f3; border: 1px solid #c2e0cf; font-size: 13px; color: var(--text, #26332d);">@(_pendingImprovement.UpdatedData.Challenge ?? "(Empty)")</div>
                        </div>
                    </div>

                    <!-- Child Choice -->
                    <div style="margin-bottom: 16px;">
                        <div style="font-size: 11px; font-weight: 800; color: var(--text, #26332d); margin-bottom: 4px; text-transform: uppercase;">Child Choice & Agency</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                            <div style="padding: 10px 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); font-size: 13px;">@(_dna.ChildChoice ?? "(Empty)")</div>
                            <div style="padding: 10px 12px; background: #f0f7f3; border: 1px solid #c2e0cf; font-size: 13px; color: var(--text, #26332d);">@(_pendingImprovement.UpdatedData.ChildChoice ?? "(Empty)")</div>
                        </div>
                    </div>

                    <!-- Together & Collaboration -->
                    <div style="margin-bottom: 16px;">
                        <div style="font-size: 11px; font-weight: 800; color: var(--text, #26332d); margin-bottom: 4px; text-transform: uppercase;">Collaboration / Together</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                            <div style="padding: 10px 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); font-size: 13px;">@(_dna.Together ?? "(Empty)")</div>
                            <div style="padding: 10px 12px; background: #f0f7f3; border: 1px solid #c2e0cf; font-size: 13px; color: var(--text, #26332d);">@(_pendingImprovement.UpdatedData.Together ?? "(Empty)")</div>
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div style="padding: 16px 24px; border-top: 1px solid var(--border, #e4e7df); display: flex; justify-content: flex-end; gap: 10px; background: var(--surface-soft, #f8f9f5);">
                    <button type="button" class="studio-btn studio-btn-outline" @onclick="RejectImprovement">Discard Changes</button>
                    <button type="button" class="studio-btn studio-btn-primary" @onclick="AcceptImprovement">✓ Accept &amp; Apply Improvements</button>
                </div>
            </div>
        </div>
    }
</div>

<ExperienceVersionCompareModal 
    IsOpen="@(!_hideHistoryDialog)"
    Versions="@_versions"
    CurrentTitle="@_experience?.Title"
    CurrentDescription="@_experience?.Description"
    CurrentDnaJson="@(_dna != null ? JsonSerializer.Serialize(_dna) : "{}")"
    OnClose="CloseHistoryDialog" />

@* SCHEDULE TO CLASSROOMS MODAL *@
@if (_isDeployModalOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1050; background: rgba(38, 51, 45, 0.45); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 20px;" @onclick="() => _isDeployModalOpen = false">
        <div style="background: var(--surface, #ffffff); border-radius: var(--radius, 18px); max-width: 520px; width: 100%; box-shadow: var(--shadow, 0 16px 40px rgba(40, 55, 47, 0.16)); border: 1px solid var(--border, #e4e7df); overflow: hidden;" @onclick:stopPropagation="true">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--border, #e4e7df); display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; background: var(--accent-light, #e6eee9); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--accent-dark, #31523c); font-size: 16px;">
                        🚀
                    </div>
                    <div>
                        <div style="font-size: 11px; font-weight: 800; color: var(--accent-dark, #31523c); text-transform: uppercase;">Curriculum Distribution</div>
                        <h3 style="font-size: 17px; font-weight: 800; color: var(--text, #26332d); margin: 0;">Schedule to Classrooms</h3>
                    </div>
                </div>
                <button type="button" @onclick="() => _isDeployModalOpen = false" style="background: none; border: none; font-size: 18px; color: var(--muted, #6c7870); cursor: pointer;">✕</button>
            </div>

            <div style="padding: 20px 24px; display: flex; flex-direction: column; gap: 16px;">
                <p style="font-size: 13px; color: var(--muted, #6c7870); margin: 0;">
                    Distribute <strong>@_experience?.Title</strong> directly into classroom schedules across your organization.
                </p>

                <!-- 1. Age Tier Selection -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 6px;">Target Age Tier</label>
                    <select class="studio-input" @bind="_selectedDeployTier" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #e4e7df); border-radius: 6px;">
                        <option value="All">All Age Groups (Infant, Toddler, Preschool)</option>
                        <option value="Toddler">Toddlers (18m – 36m)</option>
                        <option value="Preschool">Preschool &amp; Pre-K (3 – 5 yrs)</option>
                        <option value="Infant">Infants (0 – 18m)</option>
                    </select>
                </div>

                <!-- 2. Target Date -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 6px;">Scheduled Date</label>
                    <input type="date" class="studio-input" value="@_deployDate.ToString("yyyy-MM-dd")" @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _deployDate = d; }" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #e4e7df); border-radius: 6px;" />
                </div>

                <!-- 3. Time of Day Slot -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 6px;">Classroom Rhythm Slot</label>
                    <select class="studio-input" @bind="_deployTimeOfDay" style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #e4e7df); border-radius: 6px;">
                        <option value="Morning">Morning Exploration (09:30 AM – 10:15 AM)</option>
                        <option value="Mid-Day">Mid-Day Wonder Circle (01:30 PM – 02:15 PM)</option>
                        <option value="Afternoon">Afternoon Creative Studio (03:30 PM – 04:15 PM)</option>
                    </select>
                </div>
            </div>

            <div style="padding: 14px 24px; border-top: 1px solid var(--border, #e4e7df); display: flex; justify-content: flex-end; gap: 10px; background: #fafbfa;">
                <button type="button" class="studio-btn studio-btn-secondary" @onclick="() => _isDeployModalOpen = false" disabled="@_isDeploying">Cancel</button>
                <button type="button" class="studio-btn studio-btn-primary" @onclick="DeployToClassroomsAsync" disabled="@_isDeploying">
                    @(_isDeploying ? "Scheduling..." : "✓ Schedule to Classrooms")
                </button>
            </div>
        </div>
    </div>
}

