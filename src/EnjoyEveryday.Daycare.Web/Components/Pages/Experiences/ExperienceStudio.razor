    private async Task ImproveAsync(string requestContext)
    {
        _isImproving = true;
        StateHasChanged();

        try
        {
            var payload = new
            {
                Title = _experience.Title,
                Description = _experience.Description,
                Challenge = _dna.Challenge,
                Together = _dna.Together,
                Create = _dna.Create,
                ChildChoice = _dna.ChildChoice,
                MagicMoment = _dna.MagicMoment,
                Accomplishment = _dna.Accomplishment,
                Reflection = _dna.Reflection,
                TeacherGuidance = _dna.TeacherGuidance,
                AgeMin = _dna.AgeMin,
                AgeMax = _dna.AgeMax,
                GroupSizeMin = _dna.GroupSizeMin,
                GroupSizeMax = _dna.GroupSizeMax,
                Environment = _dna.Environment,
                DevelopmentalGoals = _dna.DevelopmentalGoals,
                Materials = _dna.Materials,
                ExecutionGuide = _dna.ExecutionGuide
            };
            var result = await AiIdeaService.ImproveExperienceAsync(payload, requestContext);
            if (result != null)
            {
                _pendingImprovement = result;
            }
            else
            {
                await ToastService.ShowErrorToastAsync("Failed to get improvement suggestions. Please check your connection and API key.");
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorToastAsync($"An error occurred while connecting to the AI: {ex.Message}");
        }
        finally
        {
            _isImproving = false;
            StateHasChanged();
        }
    }

    private void RejectImprovement()
    {
        _pendingImprovement = null;
        _showImprovementCompare = false;
    }

    private async Task AcceptImprovement()
    {
        if (_pendingImprovement != null)
        {
            _experience.Title = _pendingImprovement.UpdatedData.Title;
            _experience.Description = _pendingImprovement.UpdatedData.Description;
            _dna.Challenge = _pendingImprovement.UpdatedData.Challenge;
            _dna.Together = _pendingImprovement.UpdatedData.Together;
            _dna.Create = _pendingImprovement.UpdatedData.Create;
            _dna.ChildChoice = _pendingImprovement.UpdatedData.ChildChoice;
            _dna.MagicMoment = _pendingImprovement.UpdatedData.MagicMoment;
            _dna.Accomplishment = _pendingImprovement.UpdatedData.Accomplishment;
            _dna.Reflection = _pendingImprovement.UpdatedData.Reflection;
            _dna.TeacherGuidance = _pendingImprovement.UpdatedData.TeacherGuidance;
            if (_pendingImprovement.UpdatedData.AgeMin > 0) _dna.AgeMin = _pendingImprovement.UpdatedData.AgeMin;
            if (_pendingImprovement.UpdatedData.AgeMax > 0) _dna.AgeMax = _pendingImprovement.UpdatedData.AgeMax;
            if (_pendingImprovement.UpdatedData.GroupSizeMin > 0) _dna.GroupSizeMin = _pendingImprovement.UpdatedData.GroupSizeMin;
            if (_pendingImprovement.UpdatedData.GroupSizeMax > 0) _dna.GroupSizeMax = _pendingImprovement.UpdatedData.GroupSizeMax;
            if (!string.IsNullOrWhiteSpace(_pendingImprovement.UpdatedData.Environment)) _dna.Environment = _pendingImprovement.UpdatedData.Environment;
            if (_pendingImprovement.UpdatedData.DevelopmentalGoals != null && _pendingImprovement.UpdatedData.DevelopmentalGoals.Count > 0)
            {
                _dna.DevelopmentalGoals = _pendingImprovement.UpdatedData.DevelopmentalGoals;
            }
            _dna.Materials = _pendingImprovement.UpdatedData.Materials ?? new List<string>();
            if (_pendingImprovement.UpdatedData.ExecutionGuide != null)
            {
                _dna.ExecutionGuide = _pendingImprovement.UpdatedData.ExecutionGuide;
            }

            await SaveDraftAsync();
            _pendingImprovement = null;
            _showImprovementCompare = false;
        }
    }
