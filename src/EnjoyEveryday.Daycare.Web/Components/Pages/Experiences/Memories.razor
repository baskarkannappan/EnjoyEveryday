    }

    .timeline-circle.cat-obs {
        background: #fdf6e7;
        color: #8c631b;
        border-color: #eeddb7;
    }

    .timeline-circle.cat-mls {
        background: #fbeef3;
        color: #92315a;
        border-color: #ebc1d3;
    }

    .timeline-circle.cat-cel {
        background: #eef1fb;
        color: #3b549e;
        border-color: #c7d2f4;
    }

    .timeline-circle.cat-care {
        background: #fff8eb;
        color: #b86200;
        border-color: #f7dfa7;
    }

