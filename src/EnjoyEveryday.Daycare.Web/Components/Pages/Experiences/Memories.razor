    }

    .category-badge.cat-obs {
        background: #fdf6e7;
        color: #8c631b;
    }

    .category-badge.cat-mls {
        background: #fbeef3;
        color: #92315a;
    }

    .category-badge.cat-cel {
        background: #eef1fb;
        color: #3b549e;
    }

    .category-badge.cat-care {
        background: #fff8eb;
