        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 10px;
    }

    .timeline-date-marker {
        display: flex;
        align-items: center;
        margin: 18px 0 6px 0;
    }

    .date-badge {
        font-size: 12px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--muted, #6c7870);
        background: var(--surface-soft, #f8f9f5);
        padding: 5px 14px;
        border-radius: 20px;
        border: 1px solid var(--border, #e4e7df);
    }

    .timeline-item {
        display: flex;
        gap: 20px;
        cursor: pointer;
        transition: transform 0.15s ease;
    }

    .timeline-item:hover {
        transform: translateX(4px);
    }

    .timeline-icon-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 44px;
    }

