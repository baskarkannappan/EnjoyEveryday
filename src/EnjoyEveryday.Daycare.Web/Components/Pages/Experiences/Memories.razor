    .memory-search-input:focus {
        border-color: var(--accent, #557c6c);
        box-shadow: 0 0 0 3px var(--accent-light, #e6eee9);
    }

    .clear-search-btn {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        color: var(--muted, #6c7870);
        font-size: 13px;
        cursor: pointer;
    }

    /* Timeline Stream Styles */
