        color: var(--text, #26332d);
    }

    .category-tab.active {
        background: var(--accent, #557c6c);
        color: #ffffff;
        border-color: var(--accent, #557c6c);
        box-shadow: 0 4px 12px rgba(85, 124, 108, 0.2);
    }

    .search-box-wrapper {
        min-width: 320px;
    }

    .search-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        color: var(--muted, #6c7870);
        font-size: 14px;
    }

    .memory-search-input {
        width: 100%;
        padding: 9px 36px 9px 34px;
        border-radius: 11px;
        border: 1px solid var(--border, #e4e7df);
        background: var(--surface, #ffffff);
        font-size: 13px;
        color: var(--text, #26332d);
        outline: none;
        transition: all 0.2s ease;
