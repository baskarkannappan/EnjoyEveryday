    }

    .card-arrow {
        font-size: 16px;
        color: var(--accent, #557c6c);
    }

    .no-child-selected-panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 24px;
        background: var(--surface, #ffffff);
        border: 1px dashed var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .04));
        margin-top: 20px;
    }

    .prompt-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    .no-child-selected-panel h3 {
        font-size: 18px;
        font-weight: 750;
        color: var(--text, #26332d);
        margin: 0 0 6px 0;
    }

    .no-child-selected-panel p {
        font-size: 13.5px;
        color: var(--muted, #6c7870);
        max-width: 420px;
        margin: 0;
    }

    .memory-error-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: #fff5f5;
        border: 1px solid #fed7d7;
