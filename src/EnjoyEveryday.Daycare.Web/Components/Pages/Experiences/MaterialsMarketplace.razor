@code {
    private List<MaterialProduct> _allProducts = new();
    private List<Classroom> _classrooms = new();
    private bool _isLoading = true;
    private int _activeOrdersCount = 0;

    private string _searchQuery = "";
    private string _selectedCategory = "All";
    private string _selectedModelFilter = "All";
    private string _activeTypeTab = "All";

    // Cart and order drawer state
    private MaterialProduct? _selectedProduct;
    private bool _isOrderModalOpen = false;
    private bool _isCartDrawerOpen = false;

    private string _orderMode = "Purchase";
    private int _orderQuantity = 1;
    private int _orderDuration = 14;
    private string _selectedClassroomId = "";

    private List<CartItemModel> _cartItems = new();
    private string _deliveryAddress = "Primary Daycare Facility, Central Branch, Classroom Area";
    private string _contactName = "Daycare Teacher";
    private string _contactPhone = "+91 98450 12345";
    private DateTime? _deliveryDate = DateTime.Today.AddDays(3);
    private string _orderNotes = "";
    private bool _isSubmitting = false;
    private string? _submitError;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        try
        {
            _allProducts = await MaterialService.GetCatalogProductsAsync();

            try
            {
                _classrooms = (await ClassroomService.GetAllClassroomsAsync()).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading classrooms: {ex.Message}");
            }

            var userOrgId = UserContext.OrganizationId ?? Guid.Empty;
            if (userOrgId != Guid.Empty)
            {
                var orders = await MaterialService.GetOrdersForOrganizationAsync(userOrgId);
                _activeOrdersCount = orders.Count(o => o.WorkflowStatus != MaterialWorkflowStatus.Completed && o.WorkflowStatus != MaterialWorkflowStatus.Cancelled);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading marketplace: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<MaterialProduct> FilteredProducts
    {
        get
        {
            var query = _allProducts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(p =>
                    p.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Category.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (p.SafetyInstructions?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (_selectedCategory != "All")
            {
                query = query.Where(p => p.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (_selectedModelFilter == "Buy")
            {
                query = query.Where(p => p.Offering?.AllowPurchase == true);
            }
            else if (_selectedModelFilter == "Borrow")
            {
                query = query.Where(p => p.Offering?.AllowBorrow == true);
            }

            if (_activeTypeTab == "Consumables")
            {
                query = query.Where(p => p.MaterialType == "Consumable");
            }
            else if (_activeTypeTab == "Reusable Kits")
            {
                query = query.Where(p => p.MaterialType == "ActivityKit" || p.MaterialType == "Reusable");
            }

            return query;
        }
    }

    private void SetTypeTab(string tab)
    {
        _activeTypeTab = tab;
    }

    private void OpenProductModal(MaterialProduct prod)
    {
        _selectedProduct = prod;
        _orderMode = prod.Offering?.AllowBorrow == true ? "Borrow" : "Purchase";
        _orderQuantity = 1;
        _orderDuration = prod.Offering?.DefaultLoanDurationDays ?? 14;
        _isOrderModalOpen = true;
    }

    private void OpenOrderDrawer(MaterialProduct prod)
    {
        OpenProductModal(prod);
    }

    private void CloseOrderModal()
    {
        _isOrderModalOpen = false;
        _selectedProduct = null;
    }

    private void SetOrderMode(string mode)
    {
        _orderMode = mode;
    }

    private decimal CalculateItemSubtotal()
    {
        if (_selectedProduct?.Offering == null) return 0;
        var off = _selectedProduct.Offering;
        if (_orderMode == "Purchase")
        {
            return off.PurchasePrice * _orderQuantity;
        }
        else
        {
            return (off.RentalFee + off.RefundableDeposit) * _orderQuantity;
        }
    }

    private void AddToCart()
    {
        if (_selectedProduct == null || _selectedProduct.Offering == null) return;

        var off = _selectedProduct.Offering;
        decimal price = _orderMode == "Purchase" ? off.PurchasePrice : off.RentalFee;
        decimal deposit = _orderMode == "Borrow" ? off.RefundableDeposit : 0;
        decimal lineTotal = (price + deposit) * _orderQuantity;

        _cartItems.Add(new CartItemModel
        {
            ProductId = _selectedProduct.Id,
            ProductName = _selectedProduct.Name,
            FulfilmentMode = _orderMode,
            Quantity = _orderQuantity,
            UnitPrice = price,
            Deposit = deposit,
            LineTotal = lineTotal,
            LoanDurationDays = _orderDuration,
            ClassroomId = string.IsNullOrWhiteSpace(_selectedClassroomId) ? null : Guid.Parse(_selectedClassroomId)
        });

        CloseOrderModal();
        _isCartDrawerOpen = true;
    }

    private void RemoveFromCart(CartItemModel item)
    {
        _cartItems.Remove(item);
    }

    private void OpenCartDrawer()
    {
        _isCartDrawerOpen = true;
    }

    private decimal GetCartTotal()
    {
        return _cartItems.Sum(c => c.LineTotal);
    }

    private async Task SubmitCartOrder()
    {
        _submitError = null;
        if (string.IsNullOrWhiteSpace(_deliveryAddress))
        {
            _submitError = "Please specify a delivery address.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var orgId = UserContext.OrganizationId ?? Guid.Parse("00000000-0000-0000-0000-000000000001");

            var req = new CreateMaterialOrderRequest
            {
                OrganizationId = orgId,
                ClassroomId = _cartItems.FirstOrDefault(c => c.ClassroomId.HasValue)?.ClassroomId,
                DeliveryAddress = _deliveryAddress,
                DeliveryContactName = _contactName,
                DeliveryContactPhone = _contactPhone,
                RequiredDeliveryDate = _deliveryDate.HasValue 
                    ? new DateTimeOffset(DateTime.SpecifyKind(_deliveryDate.Value, DateTimeKind.Utc)) 
                    : DateTimeOffset.UtcNow.AddDays(3),
                Notes = _orderNotes,
                Items = _cartItems.Select(c => new CreateMaterialOrderItemRequest
                {
                    ProductId = c.ProductId,
                    FulfilmentMode = c.FulfilmentMode,
                    Quantity = c.Quantity,
                    LoanDurationDays = c.LoanDurationDays
                }).ToList()
            };

            var order = await MaterialService.SubmitMaterialOrderAsync(req);
            _cartItems.Clear();
            _isCartDrawerOpen = false;

            NavigationManager.NavigateTo("/materials-orders");
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class CartItemModel
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string FulfilmentMode { get; set; } = "Purchase";
        public int Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal Deposit { get; set; }
        public decimal LineTotal { get; set; }
        public int LoanDurationDays { get; set; }
        public Guid? ClassroomId { get; set; }
    }
}
