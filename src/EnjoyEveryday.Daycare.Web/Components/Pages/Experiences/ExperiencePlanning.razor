    <RightContent>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">🔔</button>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">?</button>
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #e7ddd2; display: flex; align-items: center; justify-content: center; font-weight: 750; color: #365844; margin-left: 8px; font-size: 12px;">
            BP
        </div>
    </RightContent>
</PageTopbar> *@

<section class="content" style="padding: 32px 36px 70px; max-width: 1550px; margin: auto;">

    <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px;">
        <div>
            <div style="text-transform: uppercase; letter-spacing: 1.5px; color: #789080; font-size: 10px; font-weight: 800; margin-bottom: 8px;">
                Plan the rhythm · Leave room for discovery
            </div>
            <h1 style="margin: 0; font-size: 31px; letter-spacing: -1.2px;">
                Experience Planning
            </h1>
            <div style="margin-top: 7px; color: var(--muted); font-size: 13px; line-height: 1.55; max-width: 700px;">
                Shape the month and week around meaningful experiences
                without turning childhood into a rigid schedule.
            </div>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            <select @bind="SelectedBranchId" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 12px; cursor: pointer; height: 38px;">
                @if (!_allBranches.Any())
                {
                    <option value="@Guid.Empty">Default Branch</option>
                }
                else
                {
                    @foreach (var branch in _allBranches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                }
            </select>
            <select @bind="SelectedClassroomId" disabled="@(SelectedBranchId == Guid.Empty && _allBranches.Any())" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 12px; cursor: pointer; height: 38px;">
                @foreach (var cls in _allClassrooms.Where(c => !_allBranches.Any() || c.BranchId == SelectedBranchId))
                {
                    <option value="@cls.Id">@cls.Name</option>
                }
            </select>
            <button class="btn" @onclick="() => _isWeeklyAssistantOpen = !_isWeeklyAssistantOpen" style="border: 1px solid #52745e; background: #edf4ee; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 700; color: #31523c; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                ✦ AI Weekly Assistant
            </button>
            <a href="/marketplace" class="btn" style="border: 1px solid var(--line, #e1e6e0); background: #fff; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #47534c; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                📦 Materials
            </a>
            <button class="btn" style="border: 1px solid var(--line, #e1e6e0); background: #fff; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #47534c;">
                Preview plan
            </button>
            <button class="btn primary" @onclick="OpenPlanWizard" style="background: #456a55; border: 1px solid #456a55; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #fff;">
                + Plan Experience
            </button>
        </div>
    </div>

    @if (_isWeeklyAssistantOpen && SelectedClassroomId.HasValue)
    {
        <WeeklyPlanningAssistantModal 
            ClassroomId="@SelectedClassroomId.Value" 
            WeekStartDate="@DateOnly.FromDateTime(DateTime.Today)" 
            OnPlanScheduled="LoadSchedules" />
    }

    <PlanningPhilosophy 
        Title="Plan the rhythm. Leave room for the children."
        Text="This plan gives teachers direction — not instructions. Children can change what happens next." />

    <PlanningControlBar 
        PeriodTitle="@_currentDate.ToString("MMMM yyyy")"
        Filters="@_filters"
        ActiveFilter="@_activeFilter"
        OnFilterSelected="FilterSelected" 
        OnPreviousClick="PreviousMonth"
        OnNextClick="NextMonth" />

    <div class="planning-layout">
        
        <div class="calendar" style="flex: 1;">
            <div class="week">
                <div>SUN</div>
                <div>MON</div>
                <div>TUE</div>
                <div>WED</div>
                <div>THU</div>
                <div>FRI</div>
                <div>SAT</div>
            </div>
            <div id="calendarGrid" class="calendar-grid">
                @{
                    var firstDayOfMonth = new DateTime(_currentDate.Year, _currentDate.Month, 1);
                    var leadingEmptyDays = (int)firstDayOfMonth.DayOfWeek; // 0 for Sunday, 1 for Monday, etc.
                    var totalDaysInMonth = DateTime.DaysInMonth(_currentDate.Year, _currentDate.Month);
                }

                @* Leading empty padding days for correct day-of-week alignment *@
                @for (int pad = 0; pad < leadingEmptyDays; pad++)
                {
                    <div class="day day-empty"></div>
                }

                @for (int day = 1; day <= totalDaysInMonth; day++)
                {
                    var iterDay = day;
                    var currentDate = new DateOnly(_currentDate.Year, _currentDate.Month, iterDay);
                    var dailySchedules = _schedules.Where(s => s.ScheduledDate == currentDate).OrderBy(s => s.TimeOfDay).ToList();
                    <div class="day">
                        <div class="day-number @(currentDate == DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date) ? "today" : "")">
                            @iterDay
                            @if (currentDate >= DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date))
                            {
                                <button class="add-plan-btn" @onclick='() => OpenPlanWizardForDate(currentDate)'>+</button>
                            }
                        </div>
                        @* Planned and Completed Celebrations & Events *@
                        @foreach (var evt in GetEventsForDateAndScope(currentDate))
                        {
                            var isCompleted = evt.Status == "Completed";
                            <div class="scheduled celebration-event @(isCompleted ? "completed" : "")" style="cursor: pointer;" @onclick="() => OpenEventFromCalendar(evt)">
                                <strong style="display: flex; align-items: center; gap: 4px; color: @(isCompleted ? "#52745e" : "#92400e");">
                                    <span>@(isCompleted ? "✓" : "🎉")</span>
                                    <span style="@(isCompleted ? "text-decoration: line-through; opacity: 0.9;" : "")">@evt.Title</span>
                                </strong>
                                <span style="color: @(isCompleted ? "#7c877f" : "#b45309"); font-weight: 600;">
                                    @(isCompleted ? "Completed" : "Celebration") &middot; @(evt.StartTime?.ToString(@"hh\:mm") ?? "All Day")
                                </span>
                            </div>
                        }
                        @foreach (var schedule in dailySchedules)
                        {
                            var experience = _experiences.ContainsKey(schedule.ExperienceId) ? _experiences[schedule.ExperienceId] : null;
                            if (experience != null)
                            {
                                <div class="scheduled @(schedule.Status == "Suggested" ? "suggested" : "") @(schedule.Status == "Completed" || schedule.Status == "Closed" ? "completed" : "")" style="cursor: pointer; position: relative;" @onclick="() => EditSchedule(schedule)">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 4px;">
                                        <strong style="flex: 1;">@experience.Title</strong>
                                        <span @onclick:stopPropagation="true" @onclick="() => OpenMaterialReadiness(schedule, experience)" title="Check Material Readiness" style="display: inline-flex; align-items: center; justify-content: center; background: #eef4f0; color: #3d604e; border-radius: 6px; padding: 2px 6px; font-size: 10px; font-weight: 750; cursor: pointer; border: 1px solid #d5e2d8;">
                                            📦 Kit
                                        </span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 3px;">
                                        <span>@GetExperienceType(experience) &middot; @schedule.TimeOfDay</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <div class="side-column">
            
            <SidePanel Title="Materials & Warehouse" Subtitle="Activity supply chain">
                <div style="background: #fafbf9; border: 1px solid var(--line, #e1e6e0); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 10px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #e6eee9; color: #3e6253; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                            📦
                        </div>
                        <div>
                            <div style="font-weight: 750; font-size: 13px; color: var(--text);">Materials Marketplace</div>
                            <div style="font-size: 11px; color: var(--muted);">Central warehouse delivery</div>
                        </div>
                    </div>
                    <p style="margin: 0; font-size: 12px; color: #47534c; line-height: 1.45;">
                        Buy craft consumables or borrow reusable STEM & sensory kits without leaving your planning calendar.
                    </p>
                    <div style="display: flex; gap: 6px;">
                        <a href="/marketplace" class="btn secondary" style="flex: 1; text-align: center; text-decoration: none; padding: 7px 10px; font-size: 11px; font-weight: 700; border-radius: 8px;">
                            Browse Catalog
                        </a>
                        <a href="/marketplace/orders" class="btn secondary" style="flex: 1; text-align: center; text-decoration: none; padding: 7px 10px; font-size: 11px; font-weight: 700; border-radius: 8px;">
                            Track Orders
                        </a>
                    </div>
                </div>
            </SidePanel>

            <SidePanel Title="Management Direction" Subtitle="Focus areas for this month">
                <ManagementDirection 
                    Label="This month"
                    Title="@_topGoal"
                    Text="Focus on experiences that incorporate this goal based on your schedule."
                    Tags="@_topGoalsList" />
            </SidePanel>

            <SidePanel Title="EnjoyEveryday Intelligence" Subtitle="Observations & AI suggestions">
                <AiPlan 
                    Title="Build on recent interests"
                    Text="@($"Children have been engaging with {_commonMaterial} recently.")"
                    ListItems="@_aiSuggestionsList"
                    ButtonText="Draft a plan around this" />
            </SidePanel>

            <SidePanel Title="Rhythm Balance" Subtitle="Current monthly mix">
                <EnjoyEveryday.UI.Shared.Components.Planning.RhythmRow Icon="🌿" Name="Explore" Count="@_exploreCount" Percentage="@((_exploreCount * 100) / Math.Max(1, _totalRhythmCount))" />
                <EnjoyEveryday.UI.Shared.Components.Planning.RhythmRow Icon="🎨" Name="Create" Count="@_createCount" Percentage="@((_createCount * 100) / Math.Max(1, _totalRhythmCount))" />
                <EnjoyEveryday.UI.Shared.Components.Planning.RhythmRow Icon="🤝" Name="Together" Count="@_togetherCount" Percentage="@((_togetherCount * 100) / Math.Max(1, _totalRhythmCount))" />
                <EnjoyEveryday.UI.Shared.Components.Planning.RhythmRow Icon="🏃" Name="Move" Count="@_moveCount" Percentage="@((_moveCount * 100) / Math.Max(1, _totalRhythmCount))" />
            </SidePanel>

            <SidePanel Title="Flexibility Guide" Subtitle="For when things change">
                <FlexibilityCard 
                    Title="Quick adaptations"
                    Text="Adaptations from your scheduled experiences:"
                    ListItems="@_adaptationsList" />
            </SidePanel>
            
        </div>
    </div>

</section>

<PlanExperienceDialog IsOpen="@_isPlanWizardOpen" DefaultClassroomId="@(_classroom?.Id)" DefaultDate="@_wizardDefaultDate" ScheduleId="@_wizardScheduleId" OnClose="ClosePlanWizard" OnPlanCreated="OnPlanCreatedFromWizard" />

@if (_isCalendarEventModalOpen && _selectedCalendarEvent != null)
{
    <div class="event-modal-backdrop" @onclick="CloseCalendarEventModal">
        <div class="event-modal-card" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #edf0ec; padding-bottom: 16px;">
                <div>
                    <div style="font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #b45309; text-transform: uppercase;">
                        Celebration & Event
                    </div>
                    <h2 style="margin: 4px 0 0 0; font-size: 22px; font-weight: 750; color: #1a251e;">
                        🎉 @_selectedCalendarEvent.Title
                    </h2>
                </div>
                <button type="button" @onclick="CloseCalendarEventModal" style="background: transparent; border: none; font-size: 20px; color: #7c877f; cursor: pointer; padding: 4px;">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_calendarEventErrorMessage))
            {
                <div style="background: #fff5f5; border: 1px solid #fed7d7; border-radius: 10px; padding: 10px 14px; color: #9b2c2c; font-size: 13px; font-weight: 600; display: flex; align-items: flex-start; gap: 8px;">
                    <span style="font-size: 16px;">⚠️</span>
                    <span>@_calendarEventErrorMessage</span>
                </div>
            }

            @* Role Badge Banner / Read Only Status Banner *@
            @if (_selectedCalendarEvent.Status == "Completed")
            {
                <div style="display: flex; align-items: center; justify-content: space-between; background: #eef5ef; border: 1px solid #cbd9ce; border-radius: 12px; padding: 10px 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 16px;">✅</span>
                        <span style="font-size: 12px; font-weight: 650; color: #263d32;">Celebration Completed — Viewing in read-only mode</span>
                    </div>
                    <span style="background: #52745e; color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Completed</span>
                </div>
            }
            else if (IsAdmin)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 12px; padding: 10px 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 16px;">🛡️</span>
                        <span style="font-size: 12px; font-weight: 650; color: #047857;">Administrator Mode — Full editing and deletion enabled</span>
                    </div>
                    <span style="background: #10b981; color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">@_selectedCalendarEvent.Status</span>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; justify-content: space-between; background: #fefce8; border: 1px solid #fef08a; border-radius: 12px; padding: 10px 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 16px;">👁️</span>
                        <span style="font-size: 12px; font-weight: 650; color: #854d0e;">Read-Only View — View only. Only admins can edit or delete celebrations.</span>
                    </div>
                    <span style="background: #f59e0b; color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">@_selectedCalendarEvent.Status</span>
                </div>
            }

            @* Details Body *@
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @if (IsAdmin && _selectedCalendarEvent.Status != "Completed")
                {
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Event Title</label>
                        <input type="text" @bind="_selectedCalendarEvent.Title" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 10px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box;" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Date</label>
                            <input type="date" value="@_selectedCalendarEvent.EventDate.ToString("yyyy-MM-dd")" @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _selectedCalendarEvent.EventDate = d; }" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 9px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box;" />
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Location</label>
                            <input type="text" @bind="_selectedCalendarEvent.Location" placeholder="e.g. Activity Center / Room 2" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 9px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box;" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Status</label>
                            <select @bind="_selectedCalendarEvent.Status" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 9px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box; background: white;">
                                <option value="Draft">Draft</option>
                                <option value="Planned">Planned</option>
                                <option value="Approved">Approved</option>
                                <option value="Published">Published</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Time Window</label>
                            <div style="font-size: 13px; color: #47534c; padding: 9px 0;">
                                @FormatEventTiming(_selectedCalendarEvent)
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Description</label>
                        <textarea @bind="_selectedCalendarEvent.Description" rows="3" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 10px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
                    </div>
                }
                else
                {
                    <div style="background: #fafbf9; border: 1px solid #edf0ec; border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Scheduled Date</div>
                                <div style="font-size: 14px; font-weight: 600; color: #1a251e; margin-top: 2px;">
                                    📅 @_selectedCalendarEvent.EventDate.ToString("MMMM dd, yyyy")
                                </div>
                            </div>
                            <div>
                                <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Location</div>
                                <div style="font-size: 14px; font-weight: 600; color: #1a251e; margin-top: 2px;">
                                    📍 @(_selectedCalendarEvent.Location ?? "Daycare Center")
                                </div>
                            </div>
                        </div>

                        <div>
                            <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Timing</div>
                            <div style="font-size: 13px; color: #47534c; margin-top: 2px;">
                                ⏰ @FormatEventTiming(_selectedCalendarEvent)
                            </div>
                        </div>

                        <div>
                            <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Overview & Purpose</div>
                            <div style="font-size: 13px; color: #47534c; line-height: 1.5; margin-top: 4px;">
                                @(string.IsNullOrWhiteSpace(_selectedCalendarEvent.Description) ? "No detailed description provided for this celebration." : _selectedCalendarEvent.Description)
                            </div>
                        </div>
                    </div>
                }

                @* Preparation Checklist Preview *@
                @if (_selectedCalendarEventTasks.Any())
                {
                    <div style="border-top: 1px solid #edf0ec; padding-top: 14px;">
                        <div style="font-size: 12px; font-weight: 750; color: #1a251e; margin-bottom: 8px;">
                            Preparation Tasks (@_selectedCalendarEventTasks.Count(t => t.IsCompleted)/@_selectedCalendarEventTasks.Count completed)
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            @foreach (var task in _selectedCalendarEventTasks)
                            {
                                <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #47534c;">
                                    <input type="checkbox" checked="@task.IsCompleted" disabled="@(!IsAdmin || _selectedCalendarEvent?.Status == "Completed")" @onchange="() => ToggleCalendarEventTask(task)" />
                                    <span style="@(task.IsCompleted ? "text-decoration: line-through; color: #9ca3af;" : "")">@task.Description</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Footer Action Buttons *@
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf0ec; padding-top: 16px; margin-top: 4px;">
                <div>
                    @if (IsAdmin && _selectedCalendarEvent?.Status != "Completed")
                    {
                        <button type="button" @onclick="DeleteCalendarEvent" style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 11px; padding: 9px 14px; font-size: 12px; font-weight: 650; color: #dc2626; cursor: pointer;">
                            🗑️ Delete Event
                        </button>
                    }
                </div>
                <div style="display: flex; gap: 8px;">
                    @if (_selectedCalendarEvent != null)
                    {
                        <button type="button" @onclick="() => NavigateToCalendarEvent(_selectedCalendarEvent.Id)" style="background: #fff; border: 1px solid #e1e6e0; border-radius: 11px; padding: 9px 14px; font-size: 12px; font-weight: 650; color: #47534c; cursor: pointer;">
                            View Full Details &rarr;
                        </button>
                    }
                    <button type="button" @onclick="CloseCalendarEventModal" style="background: #fff; border: 1px solid #e1e6e0; border-radius: 11px; padding: 9px 14px; font-size: 12px; font-weight: 650; color: #47534c; cursor: pointer;">
                        Close
                    </button>
                    @if (IsAdmin && _selectedCalendarEvent?.Status != "Completed")
                    {
                        <button type="button" @onclick="SaveCalendarEvent" style="background: #456a55; border: 1px solid #456a55; border-radius: 11px; padding: 9px 16px; font-size: 12px; font-weight: 650; color: #fff; cursor: pointer;">
                            Save Changes
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_isMaterialReadinessModalOpen && _selectedReadinessExperience != null)
{
    <div class="event-modal-backdrop" @onclick="CloseMaterialReadiness">
        <div class="event-modal-card" style="max-width: 680px;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #edf0ec; padding-bottom: 16px;">
                <div>
                    <div style="font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #52745e; text-transform: uppercase;">
                        Material Readiness Check
                    </div>
                    <h2 style="margin: 4px 0 0 0; font-size: 22px; font-weight: 750; color: #1a251e;">
                        📦 @_selectedReadinessExperience.Title
                    </h2>
                    <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">
                        Scheduled: @(_selectedReadinessSchedule?.ScheduledDate.ToString("MMMM dd, yyyy") ?? "Planned Activity") &middot; Classroom: @(_classroom?.Name ?? "Selected Classroom")
                    </div>
                </div>
                <button type="button" @onclick="CloseMaterialReadiness" style="background: transparent; border: none; font-size: 20px; color: #7c877f; cursor: pointer; padding: 4px;">✕</button>
            </div>

            @if (_isLoadingReadiness)
            {
                <div style="padding: 40px; text-align: center; color: var(--muted); font-size: 14px;">
                    Checking classroom stock and central warehouse orders...
                </div>
            }
            else if (_readinessSummary != null)
            {
                @if (_readinessSummary.IsFullyReady)
                {
                    <div style="display: flex; align-items: center; justify-content: space-between; background: #eef6f0; border: 1px solid #c2dec9; border-radius: 12px; padding: 12px 16px; margin-top: 14px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 20px;">✅</span>
                            <div>
                                <div style="font-weight: 750; color: #215934; font-size: 13px;">Fully Ready for Scheduled Date</div>
                                <div style="font-size: 12px; color: #356e49;">All @_readinessSummary.TotalRequired required materials are on hand in the classroom or delivered.</div>
                            </div>
                        </div>
                        <span style="background: #52745e; color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;">@_readinessSummary.TotalOnHandOrDelivered / @_readinessSummary.TotalRequired READY</span>
                    </div>
                }
                else if (_readinessSummary.OverallStatusBadge == "Dispatched")
                {
                    <div style="display: flex; align-items: center; justify-content: space-between; background: #fefce8; border: 1px solid #fef08a; border-radius: 12px; padding: 12px 16px; margin-top: 14px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 20px;">🚚</span>
                            <div>
                                <div style="font-weight: 750; color: #854d0e; font-size: 13px;">Supplies Dispatched & In Transit</div>
                                <div style="font-size: 12px; color: #a16207;">A central warehouse order has shipped and is awaiting classroom delivery.</div>
                            </div>
                        </div>
                        <span style="background: #d97706; color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;">IN TRANSIT</span>
                    </div>
                }
                else
                {
                    <div style="display: flex; align-items: center; justify-content: space-between; background: #fff8f5; border: 1px solid #fed7aa; border-radius: 12px; padding: 12px 16px; margin-top: 14px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 20px;">⚠️</span>
                            <div>
                                <div style="font-weight: 750; color: #9a3412; font-size: 13px;">Action Required — Missing Materials</div>
                                <div style="font-size: 12px; color: #c2410c;">@(_readinessSummary.TotalRequired - _readinessSummary.TotalOnHandOrDelivered) required materials need to be purchased or borrowed.</div>
                            </div>
                        </div>
                        <span style="background: #ea580c; color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;">MISSING SUPPLIES</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_readinessActionMessage))
                {
                    <div style="margin-top: 12px; padding: 10px 14px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 10px; color: #065f46; font-size: 12px; font-weight: 650;">
                        @_readinessActionMessage
                    </div>
                }

                <div style="margin-top: 16px;">
                    <div style="font-size: 11px; font-weight: 750; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 8px;">
                        Activity Material Requirements
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var mat in _readinessSummary.Materials)
                        {
                            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #fafbf9; border: 1px solid #e1e6e0; border-radius: 10px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span style="font-size: 16px;">
                                        @(mat.IsAvailableInStock ? "🟢" : (mat.IsOrdered ? "🚚" : (mat.CanBorrow ? "📦" : "🛒")))
                                    </span>
                                    <div>
                                        <div style="font-weight: 700; font-size: 13px; color: var(--text);">@mat.MaterialName</div>
                                        <div style="font-size: 11px; color: var(--muted);">
                                            @if (mat.IsAvailableInStock)
                                            {
                                                <span>Available in classroom stock</span>
                                            }
                                            else if (mat.IsOrdered)
                                            {
                                                <span>Linked Order: @mat.OrderNumber &middot; Status: @mat.FulfilmentStatus</span>
                                            }
                                            else if (mat.CanBorrow)
                                            {
                                                <span>Warehouse Reusable Kit &middot; Rental: ₹@mat.RentalFee (Return required)</span>
                                            }
                                            else
                                            {
                                                <span>Consumable Supply &middot; Buy: ₹@mat.PurchasePrice</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    @if (mat.IsAvailableInStock)
                                    {
                                        <span style="background: #e6eee9; color: #3e6253; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            ✓ Ready
                                        </span>
                                    }
                                    else if (mat.IsOrdered)
                                    {
                                        <span style="background: #fef3c7; color: #92400e; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            @mat.FulfilmentStatus
                                        </span>
                                    }
                                    else if (mat.CanBorrow)
                                    {
                                        <span style="background: #eff6ff; color: #1e40af; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            Borrow Required
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="background: #fff7ed; color: #c2410c; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            Purchase Required
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf0ec; padding-top: 16px; margin-top: 18px;">
                    <div>
                        <a href="/marketplace/orders" class="btn secondary" style="text-decoration: none; font-size: 12px; font-weight: 650; padding: 8px 14px; border-radius: 9px;">
                            View Active Orders &rarr;
                        </a>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" @onclick="CloseMaterialReadiness" class="btn secondary" style="padding: 8px 16px; font-size: 12px; font-weight: 650; border-radius: 9px;">
                            Close
                        </button>
                        @if (!_readinessSummary.IsFullyReady)
                        {
                            <button type="button" class="btn primary" @onclick="OneClickOrderMissingMaterials" disabled="@_isSubmittingOrder" style="padding: 8px 18px; font-size: 12px; font-weight: 700; border-radius: 9px; background: #456a55; color: white;">
                                @(_isSubmittingOrder ? "Submitting Order..." : "⚡ Order Missing Supplies")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}


