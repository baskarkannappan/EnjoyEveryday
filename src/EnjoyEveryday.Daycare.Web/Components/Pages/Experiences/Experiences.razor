@page "/experiences"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.UI.Shared.Components
@inject ExperienceService ExperienceService
@inject ExperienceCurationService CurationService
@inject UserService UserService
@inject PlannerService PlannerService
@using EnjoyEveryday.Domain.Repositories
@inject IClassroomRepository ClassroomRepository
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Daycare.Web.Services.StorybookStorageService StorybookStorageService
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext

<PageTitle>My Experiences — EnjoyEveryday</PageTitle>

<section id="page-experiences" class="page active-page">
    <div class="page-hero-wrapper">
        <div class="hero-text-col">
            <div class="eyebrow-pill">
                <span>🌱</span>
                <span>YOUR EXPERIENCE LIBRARY</span>
            </div>
            <h1 class="hero-title">My Experiences</h1>
            <p class="hero-subtitle">Your daycare's growing collection. Every experience gets better with use.</p>
        </div>
        <div class="hero-actions">
            <a href="/marketplace" class="btn-hero-secondary" style="text-decoration: none; display: flex; align-items: center; gap: 6px;">
                <span>🛒</span>
                <span>Experience Marketplace</span>
            </a>
            <button class="btn-hero-secondary" @onclick='() => NavigationManager.NavigateTo("/studio")'>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                </svg>
                <span>Experience Studio</span>
            </button>
            <button id="createExperienceButton" class="btn-hero-primary" @onclick="OpenAddExperienceModal">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Create experience</span>
            </button>
        </div>
    </div>

    @if (_experiences != null && _experiences.Any())
    {
        <div class="stats-overview-bar">
            <div class="stat-badge">
                <span class="stat-icon">📚</span>
                <div>
                    <span class="stat-val">@(_experiences.Count())</span>
                    <span class="stat-lbl">Experiences</span>
                </div>
            </div>
            <div class="stat-badge-divider"></div>
            <div class="stat-badge">
                <span class="stat-icon">🌱</span>
                <div>
                    <span class="stat-val">@(_experiences.Count(e => string.Equals(e.Status, "Published", StringComparison.OrdinalIgnoreCase)))</span>
                    <span class="stat-lbl">Published</span>
                </div>
            </div>
            <div class="stat-badge-divider"></div>
            <div class="stat-badge">
                <span class="stat-icon">⭐</span>
                <div>
                    <span class="stat-val">@(GetAverageRatingDisplay())</span>
                    <span class="stat-lbl">Avg Rating</span>
                </div>
            </div>
            <div class="stat-badge-divider"></div>
            <div class="stat-badge">
                <span class="stat-icon">✨</span>
                <div>
                    <span class="stat-val">@(_experiences.Count(IsAiCreated))</span>
                    <span class="stat-lbl">AI Enhanced</span>
                </div>
            </div>
        </div>
    }

    <FilterTabs 
        Tabs="ExperienceTabs" 
        ActiveTab="@ActiveFilter" 
        OnTabSelected="(val) => ActiveFilter = val" />

    <SearchFilterRow SearchPlaceholder="Search experiences by title or mission..." @bind-SearchQuery="SearchText">
        <Filters>
            <select id="ageFilter" class="filter" @bind="SelectedAgeFilter">
                <option value="all">All ages</option>
                <option value="3-4">3-4 years</option>
                <option value="4-5">4-5 years</option>
            </select>
            <select id="typeFilter" class="filter" @bind="SelectedTypeFilter">
                <option value="all">All types</option>
                <option value="Explore">Explore</option>
                <option value="Create">Create</option>
                <option value="Move">Move</option>
            </select>
            <select id="sortFilter" class="filter" @bind="SelectedSort">
                <option value="newest">Sort: Newest</option>
                <option value="rating">Sort: Highest Rated</option>
                <option value="title">Sort: Title (A-Z)</option>
            </select>
        </Filters>
    </SearchFilterRow>

    <div id="experienceGrid" class="experience-grid">
        @if (FilteredExperiences.Any())
        {
            @foreach (var exp in FilteredExperiences)
            {
                var type = GetExperienceType(exp);

                <ExperienceCard 
                    Type="@type" 
                    Status="@(exp.Status ?? "Idea")" 
                    Title="@exp.Title" 
                    Description="@exp.Description" 
                    Ages="3-4" 
                    Duration="15 min" 
                    Setting="Indoor" 
                    Uses="1" 
                    Stars="@(_ratings.ContainsKey(exp.Id) ? _ratings[exp.Id].Stars : 0)"
                    ReviewsCount="@(_ratings.ContainsKey(exp.Id) ? _ratings[exp.Id].Count : 0)"
                    Version="v1" 
                    CreatedBy="Teacher"
                    CreatedDate="@exp.CreatedAt.ToString("MMM dd, yyyy")"
                    Id="@exp.Id.ToString()"
                    OnClick="() => OpenViewExperienceModal(exp)"
                    OnDownloadStorybook="DownloadCardStorybookAsync" />
            }
        }
        else if (_experiences != null)
        {
            <div class="empty-state-card">
                <div class="empty-state-icon">🌱</div>
                <h3>No experiences found</h3>
                <p>We couldn't find any experiences matching your current search or filter criteria.</p>
                <div class="empty-state-actions">
                    <button class="btn-hero-secondary" @onclick="ResetFilters">
                        Clear all filters
                    </button>
                    <button class="btn-hero-primary" @onclick="OpenAddExperienceModal">
                        + Create experience
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<ExperienceCreateModal 
    IsOpen="@_isModalOpen"
    IsEditing="@_isEditing"
    @bind-Title="_currentExperience.Title"
    @bind-Description="_currentExperience.Description"
    @bind-Age="experienceAge"
    @bind-Duration="experienceDuration"
    @bind-Type="experienceType"
    @bind-Environment="experienceEnvironment"
    @bind-Materials="experienceMaterials"
    OnClose="CloseDialog"
    OnSaveDraft="SaveDraftAsync"
    OnSaveLibrary="SaveToLibraryAsync"
    OnDelete="DeleteExperienceAsync" />

<ExperienceViewModal 
    IsOpen="@_isViewModalOpen"
    Title="@(_currentExperience?.Title ?? "Experience")"
    Mission="@(_currentExperience?.Description ?? "No description available.")"
    Discover="@(_parsedDna?.Create ?? "")"
    Challenge="@(_parsedDna?.Challenge ?? "")"
    JoyMoment="@(_parsedDna?.MagicMoment ?? "")"
    ExecutionGuide="@_parsedDna?.ExecutionGuide"
    OnClose="CloseViewDialog"
    OnPrint="PrintExperience"
    OnDuplicate="DuplicateExperience"
    OnImprove="ImproveExperience"
    OnCompare="OpenHistoryDialog"
    OnDelete="DeleteExperienceAsync"
    ExperienceId="@_currentExperience?.Id"
    OnOpenStorybook="OpenStorybookPage"
    OnSubmitForCuration="OpenCurationModal"
    Reviews="@_currentReviews"
    OnSubmitReview="HandleSubmitReview" />

<ExperienceCurationSubmitModal 
    IsOpen="@_showCurationModal"
    ExperienceTitle="@_curationExperience?.Title"
    ExperienceDescription="@_curationExperience?.Description"
    StatusMessage="@_curationStatus"
    OnClose="() => _showCurationModal = false"
    OnConfirm="ConfirmCurationSubmissionAsync" />

<ExperienceVersionCompareModal 
    IsOpen="@(!_hideHistoryDialog)"
    Versions="@_versions"
    CurrentTitle="@_currentExperience?.Title"
    CurrentDescription="@_currentExperience?.Description"
    CurrentDnaJson="@(_parsedDna != null ? JsonSerializer.Serialize(_parsedDna) : "{}")"
    OnClose="CloseHistoryDialog" />

<ExperienceScheduleModal 
    IsOpen="@_isScheduleModalOpen"
    @bind-ScheduleDate="_scheduleDate"
    @bind-ScheduleTimeOfDay="_scheduleTimeOfDay"
    OnClose="CloseScheduleModal"
    OnSave="SaveScheduleAsync" />

@code {
    private IEnumerable<Experience>? _experiences;
    private bool _showCurationModal;
    private Experience? _curationExperience;
    private string? _curationStatus;

    private void OpenCurationModal(Guid id)
    {
        _curationExperience = _experiences?.FirstOrDefault(e => e.Id == id);
        if (_curationExperience != null)
        {
            _curationStatus = null;
            _showCurationModal = true;
        }
    }

    private async Task ConfirmCurationSubmissionAsync(string licenseType)
    {
        if (_curationExperience == null) return;
        try
        {
            await CurationService.SubmitForReviewAsync(_curationExperience.Id, licenseType);
            _curationStatus = "Submitted! The Platform Admin team will review your activity.";
            StateHasChanged();
            await Task.Delay(1500);
            _showCurationModal = false;
        }
        catch (Exception ex)
        {
            _curationStatus = $"Error: {ex.Message}";
        }
    }
    
    private string ActiveFilter { get; set; } = "all";
    private string SearchText { get; set; } = "";
    private string SelectedAgeFilter { get; set; } = "all";
    private string SelectedTypeFilter { get; set; } = "all";
    private string SelectedSort { get; set; } = "newest";

    private void ResetFilters()
    {
        SearchText = "";
        ActiveFilter = "all";
        SelectedAgeFilter = "all";
        SelectedTypeFilter = "all";
        SelectedSort = "newest";
    }

    private static bool IsAiCreated(Experience exp)
    {
        if (string.IsNullOrEmpty(exp.DnaPayload)) return false;
        return exp.DnaPayload.Contains("\"source\": \"ai\"", StringComparison.OrdinalIgnoreCase) ||
               exp.DnaPayload.Contains("\"source\":\"ai\"", StringComparison.OrdinalIgnoreCase) ||
               exp.DnaPayload.Contains("ai_generated", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsPlatform(Experience exp)
    {
        return exp.CreatedByUserId != _defaultUserId && !IsAiCreated(exp);
    }

    private static string GetExperienceType(Experience exp)
    {
        if (string.IsNullOrEmpty(exp.DnaPayload)) return "Experience";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(exp.DnaPayload);
            if (doc.RootElement.TryGetProperty("type", out var typeEl))
            {
                return typeEl.GetString() ?? "Experience";
            }
        }
        catch {}
        return "Experience";
    }

    private string GetAverageRatingDisplay()
    {
        if (_ratings == null || !_ratings.Any()) return "4.8";
        var avg = _ratings.Values.Average(r => r.Stars);
        return avg > 0 ? avg.ToString("0.0") : "4.8";
    }

    private IEnumerable<FilterTabs.TabItem> ExperienceTabs
    {
        get
        {
            var allCount = _experiences?.Count() ?? 0;
            var createdCount = _experiences?.Count(e => !IsAiCreated(e) && !IsPlatform(e)) ?? 0;
            var platformCount = _experiences?.Count(e => IsPlatform(e)) ?? 0;
            var aiCount = _experiences?.Count(e => IsAiCreated(e)) ?? 0;

            return new List<FilterTabs.TabItem>
            {
                new() { Text = "All", Value = "all", Count = allCount },
                new() { Text = "Created by us", Value = "created", Count = createdCount },
                new() { Text = "Platform", Value = "platform", Count = platformCount },
                new() { Text = "AI created", Value = "ai", Count = aiCount }
            };
        }
    }

    private IEnumerable<Experience> FilteredExperiences
    {
        get
        {
            if (_experiences == null) return Enumerable.Empty<Experience>();
            var query = _experiences.AsEnumerable();

            // Tab filter
            if (!string.IsNullOrEmpty(ActiveFilter) && ActiveFilter != "all")
            {
                if (ActiveFilter == "created")
                {
                    query = query.Where(e => !IsAiCreated(e) && !IsPlatform(e));
                }
                else if (ActiveFilter == "ai")
                {
                    query = query.Where(e => IsAiCreated(e));
                }
                else if (ActiveFilter == "platform")
                {
                    query = query.Where(e => IsPlatform(e));
                }
            }

            // Search filter
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var st = SearchText.Trim();
                query = query.Where(e =>
                    (e.Title != null && e.Title.Contains(st, StringComparison.OrdinalIgnoreCase)) ||
                    (e.Description != null && e.Description.Contains(st, StringComparison.OrdinalIgnoreCase)));
            }

            // Type filter
            if (!string.IsNullOrEmpty(SelectedTypeFilter) && SelectedTypeFilter != "all")
            {
                query = query.Where(e => GetExperienceType(e).Equals(SelectedTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            // Sort
            if (SelectedSort == "rating")
            {
                query = query.OrderByDescending(e => _ratings.ContainsKey(e.Id) ? _ratings[e.Id].Stars : 0);
            }
            else if (SelectedSort == "title")
            {
                query = query.OrderBy(e => e.Title);
            }
            else
            {
                query = query.OrderByDescending(e => e.CreatedAt);
            }

            return query;
        }
    }
    
    private string experienceAge = "3-4";
    private string experienceDuration = "15 minutes";
    private string experienceType = "Explore";
    private string experienceEnvironment = "Indoor";
    private string experienceMaterials = "";

    private async Task SaveToLibraryAsync()
    {
        _currentExperience.Status = "Idea";
        await SaveExperienceAsync();
    }

    private async Task SaveDraftAsync()
    {
        _currentExperience.Status = "Draft";
        await SaveExperienceAsync();
    }

    private Experience _currentExperience = new();
    private ExperienceDna _parsedDna = new();
    
    // History & Compare
    private List<ExperienceVersion>? _versions;
    private bool _hideHistoryDialog = true;

    private async Task OpenHistoryDialog()
    {
        CloseViewDialog();
        var vlist = await ExperienceService.GetExperienceHistoryAsync(_currentExperience!.Id);
        _versions = vlist.ToList();
        _hideHistoryDialog = false;
    }

    private void CloseHistoryDialog()
    {
        _hideHistoryDialog = true;
    }
    
    private bool _isModalOpen = false;
    private bool _isViewModalOpen = false;
    private IEnumerable<ExperienceFeedback>? _currentReviews;

    private async Task OpenViewExperienceModal(Experience exp)
    {
        _currentExperience = exp;
        _parsedDna = new ExperienceDna();
        if (!string.IsNullOrEmpty(exp.DnaPayload))
        {
            try
            {
                _parsedDna = JsonSerializer.Deserialize<ExperienceDna>(exp.DnaPayload, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new ExperienceDna();
            }
            catch { }
        }
        
        _currentReviews = await ExperienceService.GetFeedbackForExperienceAsync(exp.Id);
        
        _isViewModalOpen = true;
    }

    private async Task HandleSubmitReview((int Stars, string Rating, string Notes) review)
    {
        await ExperienceService.LeaveFeedbackAsync(_currentExperience.Id, _defaultUserId, review.Stars, review.Notes, review.Rating);
        _currentReviews = await ExperienceService.GetFeedbackForExperienceAsync(_currentExperience.Id);
        await LoadExperiencesAsync(); // update card aggregation
    }

    private async Task DuplicateExperience()
    {
        var sourceExp = _currentExperience;
        await ExperienceService.CreateExperienceAsync(
            sourceExp.Title + " (Copy)",
            sourceExp.Description ?? "",
            sourceExp.DnaPayload ?? "{}",
            _defaultUserId,
            "Idea"
        );
        await LoadExperiencesAsync();
        CloseViewDialog();
    }

    private bool _isScheduleModalOpen = false;
    private DateTime _scheduleDate = DateTime.Today;
    private string _scheduleTimeOfDay = "Morning";

    private async Task PrintExperience()
    {
        var js = @"
            var content = document.querySelector('.modal').innerHTML;
            var printWindow = window.open('', '', 'height=800,width=800');
            printWindow.document.write('<html><head><title>Print Experience</title>');
            printWindow.document.write('<style>body { font-family: system-ui, -apple-system, sans-serif; padding: 40px; line-height: 1.6; color: #333; } h2, h3 { color: #111; } .eyebrow { font-size: 12px; font-weight: bold; color: #666; text-transform: uppercase; margin-bottom: 10px; } .detail { margin-top: 20px; margin-bottom: 20px; } .detail label { font-weight: bold; font-size: 14px; color: #555; display: block; margin-bottom: 5px; } .modal-meta { font-weight: bold; color: #444; margin-bottom: 20px; } .modal-footer, .modal-close, button { display: none !important; } ul { padding-left: 20px; } hr { border: none; border-top: 1px dashed #ccc; margin: 30px 0; } </style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(content);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => { printWindow.print(); printWindow.close(); }, 500);
        ";
        await JS.InvokeVoidAsync("eval", js);
    }

    private void CloseScheduleModal()
    {
        _isScheduleModalOpen = false;
    }

    private async Task SaveScheduleAsync()
    {
        var classrooms = await ClassroomRepository.GetAllAsync(TenantContext.TenantId);
        var classroom = classrooms.FirstOrDefault();
        if (classroom != null)
        {
            await PlannerService.ScheduleExperienceAsync(_currentExperience.Id, classroom.Id, DateOnly.FromDateTime(_scheduleDate), _scheduleTimeOfDay);
        }
        _isScheduleModalOpen = false;
    }

    private void CloseViewDialog()
    {
        _isViewModalOpen = false;
    }

    private void ImproveExperience()
    {
        CloseViewDialog();
        NavigationManager.NavigateTo($"/studio/{_currentExperience.Id}");
    }

    private void OpenStorybookPage(Guid expId)
    {
        CloseViewDialog();
        NavigationManager.NavigateTo($"/experiences/{expId}/story");
    }

    private async Task DownloadCardStorybookAsync(string experienceIdStr)
    {
        if (Guid.TryParse(experienceIdStr, out var expId))
        {
            var html = await StorybookStorageService.GetOrGeneratePublishedStorybookAsync(expId);
            if (string.IsNullOrWhiteSpace(html))
            {
                await JS.InvokeVoidAsync("alert", "This storybook is only downloadable once the experience is published.");
                return;
            }

            var exp = _experiences?.FirstOrDefault(e => e.Id == expId);
            var safeFileName = (exp?.Title ?? "Experience")
                .Replace(" ", "_")
                .Replace("/", "_")
                .Replace("\\", "_") + "_Storybook.html";

            await JS.InvokeVoidAsync("window.downloadStandaloneHtml", safeFileName, html);
        }
    }

    private bool _isEditing = false;
    private Guid _defaultUserId = Guid.Parse("50000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync()
    {
        _defaultUserId = UserContext.UserId;

        if (_defaultUserId == Guid.Empty)
        {
            var newUser = await UserService.CreateUserAsync("system@enjoyeveryday.com", "System", "User", "TEMP_HASH");
            _defaultUserId = newUser.Id;
        }
        await LoadExperiencesAsync();
    }

    private Dictionary<Guid, (double Stars, int Count)> _ratings = new();

    private async Task LoadExperiencesAsync()
    {
        _experiences = await ExperienceService.GetExperiencesAsync();
        _ratings.Clear();
        foreach (var exp in _experiences)
        {
            var feedbacks = await ExperienceService.GetFeedbackForExperienceAsync(exp.Id);
            if (feedbacks.Any())
            {
                var avg = feedbacks.Average(f => f.Stars);
                _ratings[exp.Id] = (avg, feedbacks.Count());
            }
        }
    }

    private void OpenAddExperienceModal()
    {
        _currentExperience = new Experience { DnaPayload = "{\"type\": \"Experience\"}" };
        experienceAge = "3-4";
        experienceDuration = "15 minutes";
        experienceType = "Explore";
        experienceEnvironment = "Indoor";
        experienceMaterials = "";

        _isEditing = false;
        _isModalOpen = true;
    }

    private void OpenEditExperienceModal(Experience exp)
    {
        _currentExperience = new Experience
        {
            Id = exp.Id,
            TenantId = exp.TenantId,
            Title = exp.Title,
            Description = exp.Description,
            Status = exp.Status,
            DnaPayload = exp.DnaPayload,
            CreatedByUserId = exp.CreatedByUserId
        };
        _isEditing = true;
        _isModalOpen = true;
    }

    private void CloseDialog()
    {
        _isModalOpen = false;
    }

    private async Task SaveExperienceAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentExperience.Title)) return;

        if (_isEditing)
        {
            await ExperienceService.UpdateExperienceAsync(
                _currentExperience.Id,
                _currentExperience.Title,
                _currentExperience.Description ?? "",
                _currentExperience.DnaPayload ?? "{}",
                _currentExperience.Status ?? "Idea",
                "Manual Update",
                _defaultUserId);
        }
        else
        {
            await ExperienceService.CreateExperienceAsync(
                _currentExperience.Title,
                _currentExperience.Description ?? "",
                _currentExperience.DnaPayload ?? "{}",
                _defaultUserId,
                _currentExperience.Status);
        }

        await LoadExperiencesAsync();
        CloseDialog();
    }

    private async Task DeleteExperienceAsync()
    {
        if (_currentExperience.Id != Guid.Empty)
        {
            await ExperienceService.DeleteExperienceAsync(_currentExperience.Id);
            await LoadExperiencesAsync();
            CloseDialog();
            CloseViewDialog();
        }
    }
}
