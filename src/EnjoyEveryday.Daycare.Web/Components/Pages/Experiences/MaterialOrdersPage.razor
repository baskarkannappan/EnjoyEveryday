@page "/materials-orders"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Materials
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities


<PageTitle>Orders, Loans &amp; Deliveries — EnjoyEveryday</PageTitle>

<div class="content">
    <PageHero Eyebrow="FULFILMENT &amp; TRACKING"
              Title="Materials Orders &amp; Loans"
              Subtitle="Track your material requests, view quotation terms, verify deliveries, and manage reusable kits and return deadlines.">
        <RightContent>
            <a href="/materials-marketplace" class="btn primary" style="display: flex; align-items: center; gap: 8px;">
                <span>+ Browse Marketplace</span>
            </a>
        </RightContent>
    </PageHero>

    <!-- TOP NAVIGATION TABS -->
    <div class="filter-row" style="display: flex; gap: 10px; margin-bottom: 24px; border-bottom: 1px solid var(--border, #e4e7df); padding-bottom: 8px; flex-wrap: wrap;">
        <button class="nav-tab @(_activeTab == "Orders" ? "active" : "")" @onclick='() => SetTab("Orders")'>
            📦 All Orders (@_orders.Count)
        </button>
        <button class="nav-tab @(_activeTab == "Loans" ? "active" : "")" @onclick='() => SetTab("Loans")'>
            🔄 Reusable Loans in Use (@_loans.Count(l => l.ReturnStatus == MaterialLoanStatus.InUse || l.ReturnStatus == MaterialLoanStatus.ReturnDue))
        </button>
        <button class="nav-tab @(_activeTab == "Recurring" ? "active" : "")" @onclick='() => SetTab("Recurring")'>
            🔁 Recurring Schedules (@_schedules.Count)
        </button>
    </div>

    @if (_activeTab == "Orders")
    {
        <!-- ORDER STATUS FILTER -->
        <div style="display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap;">
            @foreach (var filter in new[] { "All", "Pending Review", "Quotation Offered", "Payment Pending", "Dispatched", "Receipt Confirmed", "Completed" })
            {
                <button class="pill-btn @(_selectedStatusFilter == filter ? "active" : "")" @onclick="() => FilterOrders(filter)">
                    @filter
                </button>
            }
        </div>

        @if (_isLoading)
        {
            <div style="padding: 50px; text-align: center; color: var(--muted);">Loading orders...</div>
        }
        else if (!FilteredOrders.Any())
        {
            <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 40px; text-align: center;">
                <div style="font-size: 28px; margin-bottom: 10px;">📋</div>
                <h3 style="margin: 0 0 6px; font-weight: 750;">No orders found in this category</h3>
                <p style="color: var(--muted); font-size: 13px; margin: 0 0 16px;">Browse the Materials Marketplace to request supplies or borrow kits.</p>
                <a href="/materials-marketplace" class="btn primary">+ Go to Marketplace</a>
            </div>
        }
        else
        {
            <div class="orders-list">
                @foreach (var order in FilteredOrders)
                {
                    var isLoanOrder = order.Items.Any(i => i.FulfilmentMode == "Borrow");
                    var isPurchaseOrder = order.Items.Any(i => i.FulfilmentMode == "Purchase");

                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <strong style="font-size: 16px; color: var(--text);">@order.OrderNumber</strong>
                                    <span class="status-pill @GetStatusClass(order.WorkflowStatus)">
                                        @FormatStatus(order.WorkflowStatus)
                                    </span>
                                    @if (order.PaymentStatus == "Completed")
                                    {
                                        <span class="payment-pill paid">✓ Paid</span>
                                    }
                                    else if (order.WorkflowStatus == MaterialWorkflowStatus.RequestSubmitted || order.WorkflowStatus == MaterialWorkflowStatus.UnderReview)
                                    {
                                        <span class="payment-pill review">Awaiting Review</span>
                                    }
                                    else if (order.WorkflowStatus == MaterialWorkflowStatus.QuotationOffered)
                                    {
                                        <span class="payment-pill quote">Quote Offered</span>
                                    }
                                    else
                                    {
                                        <span class="payment-pill unpaid">Payment Pending</span>
                                    }
                                </div>
                                <div class="order-meta">
                                    Placed on @order.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")
                                    @if (order.RequiredDeliveryDate.HasValue)
                                    {
                                        <span>· Needed by: @order.RequiredDeliveryDate.Value.ToLocalTime().ToString("d MMM yyyy")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.ClassroomName))
                                    {
                                        <span>· Classroom: <strong>@order.ClassroomName</strong></span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.PlannedExperienceTitle))
                                    {
                                        <span>· Activity: <strong>@order.PlannedExperienceTitle</strong></span>
                                    }
                                </div>
                            </div>

                            <div style="text-align: right;">
                                <div style="font-size: 18px; font-weight: 800; color: var(--text);">₹@order.TotalAmount.ToString("N2")</div>
                                <div style="font-size: 11.5px; color: var(--muted);">
                                    @order.Items.Sum(i => i.Quantity) items (@(isLoanOrder && isPurchaseOrder ? "Buy & Borrow" : (isLoanOrder ? "Borrow Loan" : "Purchase")))
                                </div>
                            </div>
                        </div>

                        <!-- ITEMS PREVIEW -->
                        <div class="order-items-preview">
                            @foreach (var itm in order.Items)
                            {
                                <div class="item-chip">
                                    <span class="item-mode @itm.FulfilmentMode.ToLowerInvariant()">@itm.FulfilmentMode</span>
                                    <span>@itm.ProductName × @itm.Quantity</span>
                                    @if (itm.FulfilmentMode == "Borrow")
                                    {
                                        <span class="chip-duration">(@itm.LoanDurationDays d)</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- FOOTER ACTIONS -->
                        <div class="order-footer">
                            <div class="next-action-hint">
                                @GetNextActionHint(order)
                            </div>

                            <div style="display: flex; gap: 8px;">
                                @if (order.WorkflowStatus == MaterialWorkflowStatus.QuotationOffered)
                                {
                                    <button class="primary" @onclick="() => AcceptQuotation(order)">
                                        ✓ Accept Quotation
                                    </button>
                                }

                                @if (order.WorkflowStatus == MaterialWorkflowStatus.Confirmed && order.PaymentStatus != "Completed")
                                {
                                    <button class="pay-btn" @onclick="() => PayOrderDirectly(order)" disabled="@(_isProcessingPayment && _processingOrderId == order.Id)">
                                        @if (_isProcessingPayment && _processingOrderId == order.Id)
                                        {
                                            <span>⏳ Launching Razorpay...</span>
                                        }
                                        else
                                        {
                                            <span>💳 Pay with Razorpay (₹@order.TotalAmount.ToString("N0"))</span>
                                        }
                                    </button>
                                    <button class="btn secondary" style="font-size: 11.5px; padding: 7px 11px;" title="Simulate payment instantly without external Razorpay/hCaptcha scripts" @onclick="() => QuickSimulateOrderPayment(order)" disabled="@_isProcessingPayment">
                                        ⚡ Quick Test Pay
                                    </button>
                                }

                                @if (order.WorkflowStatus == MaterialWorkflowStatus.Dispatched)
                                {
                                    <button class="btn secondary" @onclick="() => ConfirmReceipt(order, true)">
                                        ✓ Confirm Delivery Receipt
                                    </button>
                                }

                                <button class="btn secondary" @onclick="() => OpenOrderDetails(order)">
                                    View Details &amp; Timeline ➔
                                </button>

                                @if (order.WorkflowStatus == MaterialWorkflowStatus.RequestSubmitted || 
                                     order.WorkflowStatus == MaterialWorkflowStatus.UnderReview || 
                                     order.WorkflowStatus == MaterialWorkflowStatus.QuotationOffered || 
                                     (order.WorkflowStatus == MaterialWorkflowStatus.Confirmed && order.PaymentStatus != "Completed"))
                                {
                                    <button class="btn-cancel" @onclick="() => PromptCancelOrder(order)">
                                        ✕ Cancel Order
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (_activeTab == "Loans")
    {
        <!-- ACTIVE LOANS SECTION -->
        <div class="loans-grid">
            @if (!_loans.Any())
            {
                <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 40px; text-align: center; grid-column: 1 / -1;">
                    <div style="font-size: 28px; margin-bottom: 10px;">📦</div>
                    <h3 style="margin: 0 0 6px; font-weight: 750;">No active borrowed resources</h3>
                    <p style="color: var(--muted); font-size: 13px; margin: 0;">Borrow reusable STEM sets and activity kits from the marketplace.</p>
                </div>
            }
            else
            {
                @foreach (var loan in _loans)
                {
                    var isDueSoon = loan.DueDate <= DateTimeOffset.UtcNow.AddDays(3);
                    var isOverdue = loan.DueDate < DateTimeOffset.UtcNow;

                    <div class="loan-card @(isOverdue ? "overdue" : (isDueSoon ? "due-soon" : ""))">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                            <div>
                                <span class="loan-status @loan.ReturnStatus.ToLowerInvariant()">
                                    @loan.ReturnStatus
                                </span>
                                <h3 style="margin: 8px 0 2px; font-size: 16px; font-weight: 750;">@loan.ProductName</h3>
                                <div style="font-size: 11.5px; color: var(--muted);">Order: @loan.OrderNumber · Qty: @loan.QuantityIssued</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase;">Due Date</div>
                                <div style="font-size: 14px; font-weight: 800; color: @(isOverdue ? "#b91c1c" : "var(--text)");">
                                    @loan.DueDate.ToLocalTime().ToString("d MMM yyyy")
                                </div>
                            </div>
                        </div>

                        <div style="font-size: 12.5px; color: #4b5850; background: var(--surface-soft); padding: 8px 12px; border-radius: 8px; margin-bottom: 14px;">
                            @if (loan.DepositAmount > 0)
                            {
                                <div><strong>Deposit:</strong> ₹@loan.DepositAmount.ToString("N0") (@loan.DepositStatus)</div>
                            }
                            <div>Keep all accessories clean and repack in original kit container prior to dispatch.</div>
                        </div>

                        <div style="display: flex; justify-content: flex-end; gap: 8px;">
                            @if (loan.ReturnStatus == MaterialLoanStatus.InUse || loan.ReturnStatus == MaterialLoanStatus.ReturnDue)
                            {
                                <button class="primary" @onclick="() => InitiateReturn(loan)">
                                    🔄 Initiate Kit Return
                                </button>
                            }
                            else if (loan.ReturnStatus == MaterialLoanStatus.ReturnInTransit)
                            {
                                <span style="font-size: 12px; font-weight: 700; color: #0369a1; padding: 6px 12px;">
                                    🚚 In transit to EnjoyEveryday Warehouse
                                </span>
                            }
                            else if (loan.ReturnStatus == MaterialLoanStatus.Received)
                            {
                                <span style="font-size: 12px; font-weight: 700; color: #3e6253; padding: 6px 12px;">
                                    🔍 Under Quality &amp; Sanitization Inspection
                                </span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else if (_activeTab == "Recurring")
    {
        <!-- RECURRING REPLENISHMENTS -->
        <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 style="margin: 0 0 4px; font-size: 17px; font-weight: 750;">Scheduled Material Replenishments</h3>
                    <p style="margin: 0; font-size: 13px; color: var(--muted);">Automated orders for consumable supplies or recurring kit rental periods.</p>
                </div>
                <button class="primary" @onclick="OpenNewRecurringModal">+ Schedule Replenishment</button>
            </div>

            @if (!_schedules.Any())
            {
                <div style="padding: 30px; text-align: center; color: var(--muted); font-size: 13.5px;">
                    No recurring material replenishment schedules configured.
                </div>
            }
            else
            {
                <div class="schedules-table">
                    @foreach (var sch in _schedules)
                    {
                        <div class="schedule-row">
                            <div style="flex-grow: 1;">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <strong style="font-size: 14px; color: var(--text);">@sch.ProductName</strong>
                                    <span class="type-badge @(sch.ScheduleType == "RecurringPurchase" ? "consumable" : "activitykit")">
                                        @(sch.ScheduleType == "RecurringPurchase" ? "Consumable Purchase" : "Rental Kit")
                                    </span>
                                    <span class="schedule-badge @sch.Status.ToLowerInvariant()">@sch.Status</span>
                                </div>
                                <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">
                                    Frequency: <strong>@sch.Frequency</strong> · Qty: @sch.Quantity · Next Shipment: <strong>@sch.NextRunDate.ToLocalTime().ToString("d MMM yyyy")</strong>
                                </div>
                            </div>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                @if (sch.Status == "Active")
                                {
                                    <button class="btn secondary" style="font-size: 11px; padding: 6px 10px;" @onclick='() => ToggleScheduleStatus(sch, "Paused")'>Pause</button>
                                }
                                else if (sch.Status == "Paused")
                                {
                                    <button class="btn secondary" style="font-size: 11px; padding: 6px 10px;" @onclick='() => ToggleScheduleStatus(sch, "Active")'>Resume</button>
                                }
                                <button class="btn secondary" style="font-size: 11px; padding: 6px 10px; color: #b91c1c;" @onclick='() => ToggleScheduleStatus(sch, "Cancelled")'>Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- ORDER DETAILS DRAWER WITH LIVE SHARED TIMELINE -->
@if (_selectedOrder != null && _isDetailsDrawerOpen)
{
    var order = _selectedOrder;

    <div class="drawer-overlay" @onclick="() => _isDetailsDrawerOpen = false">
        <div class="details-drawer" @onclick:stopPropagation="true">
            <div class="drawer-header">
                <div>
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <h2 style="margin: 0; font-size: 19px; font-weight: 800; color: var(--text);">Order @order.OrderNumber</h2>
                        <span class="status-pill @GetStatusClass(order.WorkflowStatus)">@FormatStatus(order.WorkflowStatus)</span>
                    </div>
                    <div style="font-size: 12.5px; color: var(--muted); margin-top: 4px;">
                        Placed on @order.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")
                    </div>
                </div>
                <button class="drawer-close-btn" @onclick="() => _isDetailsDrawerOpen = false" title="Close drawer">✕</button>
            </div>

            <div class="drawer-body">
                <!-- SHIPMENT CARD -->
                @if (order.Shipment != null)
                {
                    <div class="shipment-info-card">
                        <div style="font-size: 11.5px; font-weight: 800; color: #0369a1; text-transform: uppercase; letter-spacing: 0.5px;">🚚 Shipment &amp; Live Tracking</div>
                        <div style="font-size: 14px; font-weight: 750; margin: 6px 0; color: #075985;">
                            Carrier: @order.Shipment.CarrierName · Tracking #: <span style="font-family: monospace; font-size: 13px;">@order.Shipment.TrackingReference</span>
                        </div>
                        <div style="font-size: 12px; color: #0c4a6e;">
                            Dispatched on @order.Shipment.DispatchDate.ToLocalTime().ToString("d MMM yyyy") · Status: <strong>@order.Shipment.DeliveryStatus</strong>
                        </div>
                    </div>
                }

                <!-- ITEMS LIST -->
                <div class="drawer-section-title">
                    <span>📦</span>
                    <span>Order Items (@order.Items.Count)</span>
                </div>
                <div class="drawer-items-list">
                    @foreach (var itm in order.Items)
                    {
                        <div class="drawer-item">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 38px; height: 38px; border-radius: 10px; background: var(--accent-light); color: var(--accent-dark); display: grid; place-items: center; font-size: 16px; font-weight: 800; flex-shrink: 0;">
                                    @(itm.FulfilmentMode == "Borrow" ? "🔄" : "📦")
                                </div>
                                <div>
                                    <div style="font-weight: 750; font-size: 13.5px; color: var(--text);">@itm.ProductName</div>
                                    <div style="font-size: 12px; color: var(--muted); display: flex; gap: 8px; align-items: center; margin-top: 2px;">
                                        <span class="item-mode @itm.FulfilmentMode.ToLowerInvariant()">@itm.FulfilmentMode</span>
                                        <span>Qty: <strong>@itm.Quantity</strong></span>
                                        @if (itm.FulfilmentMode == "Borrow")
                                        {
                                            <span>· Loan duration: <strong>@itm.LoanDurationDays days</strong></span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div style="font-weight: 800; font-size: 14.5px; color: var(--text);">
                                ₹@itm.LineTotal.ToString("N2")
                            </div>
                        </div>
                    }
                </div>

                <!-- FINANCIALS -->
                <div class="drawer-section-title" style="margin-top: 24px;">
                    <span>🧾</span>
                    <span>Cost Breakdown</span>
                </div>
                <div class="financials-box">
                    <div class="calc-row">
                        <span>Items Subtotal:</span>
                        <span>₹@((order.TotalPurchaseAmount + order.TotalRentalFee).ToString("N2"))</span>
                    </div>
                    @if (order.TotalDeposit > 0)
                    {
                        <div class="calc-row">
                            <span>Refundable Security Deposit:</span>
                            <span style="color: #0369a1; font-weight: 700;">+ ₹@order.TotalDeposit.ToString("N2")</span>
                        </div>
                    }
                    <div class="calc-row">
                        <span>Shipping &amp; Handling:</span>
                        <span>₹@order.ShippingFee.ToString("N2")</span>
                    </div>
                    <div class="calc-row total">
                        <strong>Grand Total:</strong>
                        <strong style="color: var(--accent-dark); font-size: 17px;">₹@order.TotalAmount.ToString("N2")</strong>
                    </div>
                </div>

                <!-- SHARED DATABASE TIMELINE -->
                <div class="drawer-section-title" style="margin-top: 26px;">
                    <span>🕒</span>
                    <span>Shared Progression &amp; Activity Timeline</span>
                </div>
                <MaterialOrderTimeline Events="@_orderTimeline" />
            </div>

            <div class="drawer-footer">
                <div>
                    @if (order.WorkflowStatus == MaterialWorkflowStatus.RequestSubmitted || 
                         order.WorkflowStatus == MaterialWorkflowStatus.UnderReview || 
                         order.WorkflowStatus == MaterialWorkflowStatus.QuotationOffered || 
                         (order.WorkflowStatus == MaterialWorkflowStatus.Confirmed && order.PaymentStatus != "Completed"))
                    {
                        <button class="btn-cancel" @onclick="() => PromptCancelOrder(order)">
                            ✕ Cancel Order
                        </button>
                    }
                </div>
                <div style="display: flex; gap: 8px;">
                    @if (order.WorkflowStatus == MaterialWorkflowStatus.Confirmed && order.PaymentStatus != "Completed")
                    {
                        <button class="pay-btn" @onclick="() => PayOrderDirectly(order)">
                            💳 Pay with Razorpay (₹@order.TotalAmount.ToString("N0"))
                        </button>
                    }
                    <button class="btn secondary" @onclick="() => _isDetailsDrawerOpen = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- RAZORPAY SECURE PAYMENT MODAL -->
@if (_paymentModalOrder != null)
{
    <div class="modal-backdrop" @onclick="ClosePaymentModal">
        <div class="modal-window" @onclick:stopPropagation="true" style="max-width: 460px;">
            <div class="modal-header">
                <div>
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800;">Razorpay Secure Payment</h3>
                    <div style="font-size: 12px; color: var(--muted);">Order @_paymentModalOrder.OrderNumber</div>
                </div>
                <button class="close-btn" @onclick="ClosePaymentModal">✕</button>
            </div>
            <div class="modal-body" style="text-align: center; padding: 24px;">
                <div style="width: 50px; height: 50px; border-radius: 12px; background: #e0f2fe; color: #0284c7; display: grid; place-items: center; font-size: 24px; margin: 0 auto 12px;">
                    💳
                </div>
                <div style="font-size: 13px; color: var(--muted); margin-bottom: 6px;">Total Payable Amount</div>
                <div style="font-size: 28px; font-weight: 800; color: var(--text); margin-bottom: 16px;">
                    ₹@_paymentModalOrder.TotalAmount.ToString("N2")
                </div>

                @if (!string.IsNullOrWhiteSpace(_paymentErrorMessage))
                {
                    <div style="background: #fff5f5; color: #9b2c2c; border: 1px solid #fed7d7; border-radius: 8px; padding: 10px 14px; font-size: 12px; margin-bottom: 16px; text-align: left;">
                        ⚠️ @_paymentErrorMessage
                    </div>
                }

                <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-size: 12px; color: #405248; text-align: left; margin-bottom: 20px;">
                    <div>• 256-bit encrypted Razorpay checkout</div>
                    <div>• Instant payment confirmation &amp; verified webhook processing</div>
                    <div>• Automatic warehouse notification upon payment capture</div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <button class="primary" style="width: 100%; padding: 12px; font-weight: 750;" @onclick="PayOrderWithRazorpay" disabled="@_isProcessingPayment">
                        @if (_isProcessingPayment)
                        {
                            <span>Launching Razorpay Checkout...</span>
                        }
                        else
                        {
                            <span>💳 Pay with Razorpay Checkout (₹@_paymentModalOrder.TotalAmount.ToString("N0"))</span>
                        }
                    </button>

                    <button class="btn secondary" style="width: 100%; padding: 10px; font-size: 12.5px;" @onclick="SimulateRazorpayPayment" disabled="@_isProcessingPayment">
                        ⚡ Quick Test Payment (Instant Simulation)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CANCEL ORDER CONFIRMATION MODAL -->
@if (_orderToCancel != null)
{
    <div class="modal-backdrop" @onclick="() => _orderToCancel = null">
        <div class="modal-window" @onclick:stopPropagation="true" style="max-width: 440px;">
            <div class="modal-header">
                <div>
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #991b1b;">Cancel Order</h3>
                    <div style="font-size: 12px; color: var(--muted);">Order @_orderToCancel.OrderNumber</div>
                </div>
                <button class="close-btn" @onclick="() => _orderToCancel = null">✕</button>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <p style="font-size: 13.5px; color: var(--text); margin-top: 0; line-height: 1.5;">
                    Are you sure you want to cancel order <strong>@_orderToCancel.OrderNumber</strong>? Any reserved warehouse inventory will be released back to the catalog.
                </p>

                <label class="form-label">Cancellation Reason</label>
                <input @bind="_cancelReason" class="form-input" placeholder="e.g. Activity schedule changed or ordered by mistake" />
            </div>
            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 8px;">
                <button class="btn secondary" @onclick="() => _orderToCancel = null">Keep Order</button>
                <button class="primary" style="background: #b91c1c; border-color: #991b1b;" @onclick="ConfirmCancelOrder">
                    Yes, Cancel Order
                </button>
            </div>
        </div>
    </div>
}
