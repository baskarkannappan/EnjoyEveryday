@page "/rhythm-history"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.OperationsBoard
@using EnjoyEveryday.UI.Shared.Components.RhythmHistory
@using Dapper
@using EnjoyEveryday.Shared.Data
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject ExperienceService ExperienceService
@inject EventService EventService
@inject IDbConnectionFactory DbConnectionFactory
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider
@rendermode InteractiveServer

<PageTitle>Past Rhythm History — EnjoyEveryday</PageTitle>

<div class="rhythm-history-content">
    <!-- HERO / WELCOME HEADER -->
    <RhythmHistoryHero SelectedDate="@_selectedDate"
                       Today="@_today"
                       OnDateSelected="SetDate"
                       OnBackClick='() => NavigationManager.NavigateTo("/")' />

    <!-- FILTER SECTION CARD -->
    <RhythmHistoryFilters Organizations="@_organizations"
                          SelectedOrgId="@_selectedOrgId"
                          OnOrgChanged="HandleOrgChanged"
                          Branches="@_filteredBranches"
                          SelectedBranchId="@_selectedBranchId"
                          OnBranchChanged="HandleBranchChanged"
                          Classrooms="@_filteredClassrooms"
                          SelectedClassroomId="@_selectedClassroomId"
                          OnClassroomChanged="HandleClassroomChanged"
                          SelectedDate="@_selectedDate"
                          OnDateChanged="SetDate" />

    <!-- DAY PULSE / METRICS -->
    <RhythmPulseMetricsStrip SelectedDate="@_selectedDate"
                             TimelineItems="@_timelineItems" />

    <!-- DAILY FLOW TIMELINE -->
    <RhythmTimeline SelectedDate="@_selectedDate"
                    Today="@_today"
                    TimelineItems="@_timelineItems"
                    IsLoading="@_isLoading"
                    OnSetDate="SetDate"
                    OnOpenPhotoModal="OpenPhotoModal"
                    OnTogglePhotoEditor="TogglePhotoEditor"
                    OnEventPhotosUpdated="HandleEventPhotosUpdated" />
</div>

<!-- PHOTO LIGHTBOX MODAL -->
<PhotoLightboxModal PhotoUrl="@_activePreviewPhoto"
                    OnClose="() => _activePreviewPhoto = null"
                    ShowDownload="true"
                    Caption="Optimized AVIF Photo"
                    DownloadFileName="event-photo.avif" />

@code {
    private DateOnly _today;
    private DateOnly _selectedDate;
    private Guid? _selectedOrgId;
    private Guid? _selectedBranchId;
    private Guid? _selectedClassroomId;

    private List<Organization> _organizations = new();
    private List<Branch> _allBranches = new();
    private List<Branch> _filteredBranches = new();
    private List<Classroom> _allClassrooms = new();
    private List<Classroom> _filteredClassrooms = new();
    private List<Experience> _experiences = new();

    private List<HistoricalRhythmItem> _timelineItems = new();
    private bool _isLoading = true;
    private string? _activePreviewPhoto;

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date);
        _selectedDate = _today.AddDays(-1); // Default to yesterday

        try
        {
            _organizations = (await OrganizationService.GetOrganizationsAsync()).ToList();
            if (_organizations.Any())
            {
                var activeOrg = (UserContext.OrganizationId.HasValue 
                    ? _organizations.FirstOrDefault(o => o.Id == UserContext.OrganizationId.Value) 
                    : null) ?? _organizations.First();
                _selectedOrgId = activeOrg.Id;
                _allBranches = (await BranchService.GetBranchesAsync(_selectedOrgId.Value)).ToList();
                _filteredBranches = _allBranches;
            }

            _allClassrooms = _selectedOrgId.HasValue 
                ? (await ClassroomService.GetClassroomsByOrganizationAsync(_selectedOrgId.Value)).ToList()
                : (await ClassroomService.GetAllClassroomsAsync()).ToList();
            _filteredClassrooms = _allClassrooms;
            _experiences = (await ExperienceService.GetExperiencesAsync()).ToList();

            await LoadRhythmForDateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing RhythmHistory: {ex.Message}");
            _isLoading = false;
        }
    }

    private void SetDate(DateOnly date)
    {
        _selectedDate = date;
        _ = LoadRhythmForDateAsync();
    }

    private void HandleOrgChanged(Guid orgId)
    {
        _selectedOrgId = orgId;
        _selectedBranchId = null;
        _selectedClassroomId = null;
        UpdateFilteredLists();
        _ = LoadRhythmForDateAsync();
    }

    private void HandleBranchChanged(Guid? branchId)
    {
        _selectedBranchId = branchId;
        _selectedClassroomId = null;
        UpdateFilteredLists();
        _ = LoadRhythmForDateAsync();
    }

    private void HandleClassroomChanged(Guid? classroomId)
    {
        _selectedClassroomId = classroomId;
        _ = LoadRhythmForDateAsync();
    }

    private void UpdateFilteredLists()
    {
        if (_selectedBranchId.HasValue)
        {
            _filteredClassrooms = _allClassrooms.Where(c => c.BranchId == _selectedBranchId.Value).ToList();
        }
        else
        {
            _filteredClassrooms = _allClassrooms;
        }
    }

    private async Task LoadRhythmForDateAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var tenantId = TenantContext.TenantId;
            using var connection = await DbConnectionFactory.CreateConnectionAsync();

            // 1. Fetch experience schedules for selected date
            var schedSql = @"
                SELECT s.id, s.tenant_id as TenantId, s.experience_id as ExperienceId, 
                       s.classroom_id as ClassroomId, s.scheduled_date as ScheduledDate, 
                       s.time_of_day as TimeOfDay, s.status as Status, s.planned_start_time as PlannedStartTime, 
                       s.planned_end_time as PlannedEndTime, s.preparation_notes as PreparationNotes
                FROM experience_schedules s
                JOIN classrooms c ON s.classroom_id = c.id
                JOIN branches b ON c.branch_id = b.id
                WHERE s.tenant_id = @TenantId
                  AND (@OrgId IS NULL OR b.organization_id = @OrgId)
                  AND s.scheduled_date = @Date
                  AND (@ClassroomId IS NULL OR s.classroom_id = @ClassroomId)
                  AND (@BranchId IS NULL OR c.branch_id = @BranchId)
                ORDER BY s.planned_start_time ASC NULLS LAST, s.time_of_day ASC";

            var schedules = (await connection.QueryAsync<ExperienceSchedule>(schedSql, new
            {
                TenantId = tenantId,
                OrgId = _selectedOrgId,
                Date = _selectedDate.ToDateTime(TimeOnly.MinValue),
                ClassroomId = _selectedClassroomId,
                BranchId = _selectedBranchId
            })).ToList();

            // 2. Fetch events for selected date
            var events = (await EventService.GetEventsForDateAsync(
                _selectedDate,
                _selectedBranchId,
                _selectedClassroomId
            )).ToList();

            // Build map of classrooms for classroom-scoped events
            var eventClassroomMap = new Dictionary<Guid, HashSet<Guid>>();
            foreach (var ev in events.Where(e => e.Scope == "Classroom"))
            {
                var cIds = await EventService.GetEventClassroomsAsync(ev.Id);
                eventClassroomMap[ev.Id] = cIds.ToHashSet();
            }

            var items = new List<HistoricalRhythmItem>();

            // Convert schedules to timeline items
            foreach (var s in schedules)
            {
                var exp = _experiences.FirstOrDefault(e => e.Id == s.ExperienceId);
                var room = _allClassrooms.FirstOrDefault(c => c.Id == s.ClassroomId);
                var timeDisp = s.PlannedStartTime.HasValue
                    ? DateTime.Today.Add(s.PlannedStartTime.Value).ToString("t")
                    : (!string.IsNullOrWhiteSpace(s.TimeOfDay) ? s.TimeOfDay : "Completed");

                items.Add(new HistoricalRhythmItem
                {
                    IsEvent = false,
                    StartTime = s.PlannedStartTime,
                    EndTime = s.PlannedEndTime,
                    TimeDisplay = timeDisp,
                    Title = exp?.Title ?? "Experience",
                    Description = s.PreparationNotes,
                    Scope = "Classroom",
                    ScopeDisplay = room?.Name ?? "Classroom",
                    Status = s.Status,
                    ClassroomId = s.ClassroomId,
                    ScheduleId = s.Id
                });
            }

            // Convert events to timeline items
            foreach (var ev in events)
            {
                var timeDisp = ev.StartTime.HasValue
                    ? DateTime.Today.Add(ev.StartTime.Value).ToString("t")
                    : "All Day";

                string scopeDisplay;
                if (ev.Scope == "Organization")
                {
                    scopeDisplay = "All Branches & Classrooms";
                }
                else if (ev.Scope == "Branch")
                {
                    var b = _allBranches.FirstOrDefault(br => br.Id == ev.BranchId);
                    scopeDisplay = $"{b?.Name ?? "Branch"} (All Rooms)";
                }
                else
                {
                    if (eventClassroomMap.TryGetValue(ev.Id, out var crIds) && crIds.Any())
                    {
                        var names = _allClassrooms.Where(c => crIds.Contains(c.Id)).Select(c => c.Name).ToList();
                        scopeDisplay = string.Join(", ", names);
                    }
                    else
                    {
                        scopeDisplay = "Specific Classrooms";
                    }
                }

                items.Add(new HistoricalRhythmItem
                {
                    IsEvent = true,
                    StartTime = ev.StartTime,
                    EndTime = ev.EndTime,
                    TimeDisplay = timeDisp,
                    Title = ev.Title,
                    Description = ev.Description,
                    Scope = ev.Scope,
                    ScopeDisplay = scopeDisplay,
                    Status = ev.Status,
                    EventId = ev.Id,
                    PhotoUrls = ev.PhotoUrls ?? Array.Empty<string>()
                });
            }

            _timelineItems = items.OrderBy(i => i.StartTime ?? TimeSpan.Zero).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading rhythm history: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void TogglePhotoEditor(HistoricalRhythmItem item)
    {
        item.EditingPhotos = !item.EditingPhotos;
    }

    private async Task HandleEventPhotosUpdated((HistoricalRhythmItem Item, string[] Photos) args)
    {
        if (args.Item.EventId == null) return;
        args.Item.PhotoUrls = args.Photos;
        await EventService.UpdateEventPhotosAsync(args.Item.EventId.Value, args.Photos);
        StateHasChanged();
    }

    private void OpenPhotoModal(string photoUrl)
    {
        _activePreviewPhoto = photoUrl;
    }
}
