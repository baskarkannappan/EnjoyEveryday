@page "/experiences/{ExperienceId:guid}/story"
@page "/experiences/story/{ExperienceId:guid}"
@page "/storybook/{ExperienceId:guid}"
@rendermode InteractiveServer

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Application.Services.Learning
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Entities.Learning
@using System.Text.Json
@using EnjoyEveryday.UI.Shared.Components
@using Microsoft.AspNetCore.Components.Forms

@inject ExperienceService ExperienceService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject EnjoyEveryday.Daycare.Web.Services.StorybookStorageService StorybookStorageService
@inject EnjoyEveryday.Application.Services.Ai.IStorybookGenerationService StorybookGenerationService
@inject Microsoft.FluentUI.AspNetCore.Components.INotificationService ToastService

<PageTitle>Daycare Web — @(string.IsNullOrEmpty(_experience?.Title) ? "Activity Playbook" : $"{_experience.Title} — Playbook")</PageTitle>

<div class="content storybook-page">
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner"></div>
            <p>Loading activity manual and instructional blueprints...</p>
        </div>
    }
    else if (_experience == null)
    {
        <div class="not-found-card">
            <h2>Experience Not Found</h2>
            <p>We couldn't locate the requested experience. It may have been archived or removed.</p>
            <a href="/experiences" class="btn primary">Return to Library</a>
        </div>
    }
    else
    {
        <!-- Top Showcase Header -->
        <div class="storybook-hero">
            <div class="hero-left">
                <a href="/experiences" class="back-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to Experiences</span>
                </a>
                <div class="hero-eyebrow">
                    <span class="sparkle-icon">📐</span>
                    <span>ACTIVITY PLAYBOOK — DIY EDUCATOR MANUAL</span>
                    <span class="badge-pill">Ages @GetAgeRange()</span>
                    <span class="badge-pill setting-pill">@GetSetting()</span>
                    @if (!string.IsNullOrWhiteSpace(GetVersionBadge()))
                    {
                        <span class="badge-pill version-pill">@GetVersionBadge()</span>
                    }
                </div>
                <h1 class="hero-title">@_experience.Title</h1>
                <p class="hero-subtitle">
                    @(!string.IsNullOrWhiteSpace(_experience.Description) ? _experience.Description : "A step-by-step DIY manual with clear visual blueprints designed for daycare educators.")
                </p>
            </div>
            <div class="hero-actions">
                <!-- Dual-Mode Toggle -->
                <div class="mode-toggle-group" style="display: flex; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 0px; padding: 4px; gap: 4px;">
                    <button type="button" class="btn @(_displayMode == StorybookDisplayMode.ChildStory ? "primary" : "secondary")" 
                            style="padding: 6px 14px; font-size: 13px; border-radius: 0px; border: none; font-weight: 700; cursor: pointer;"
                            @onclick="() => SetDisplayMode(StorybookDisplayMode.ChildStory)">
                        📖 Child Story Mode
                    </button>
                    <button type="button" class="btn @(_displayMode == StorybookDisplayMode.TeacherPlaybook ? "primary" : "secondary")" 
                            style="padding: 6px 14px; font-size: 13px; border-radius: 0px; border: none; font-weight: 700; cursor: pointer;"
                            @onclick="() => SetDisplayMode(StorybookDisplayMode.TeacherPlaybook)">
                        📋 Teacher Playbook
                    </button>
                </div>

                @if (IsPublished)
                {
                    <a href="/api/experiences/@ExperienceId/storybook" target="_blank" class="btn secondary" title="Open standalone manual in a separate browser tab">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        <span>Open in New Tab</span>
                    </a>
                    <button class="btn secondary export-btn" @onclick="ExportStandaloneHtml" title="Export stored HTML file you can open offline or share with staff">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Download Manual HTML</span>
                    </button>
                }
                else
                {
                    <button class="btn secondary disabled" disabled title="Manual can only be exported after the experience is published in Experience Studio.">
                        <span>🔒 Publish in Studio to Export</span>
                    </button>
                }
                <button class="btn primary print-manual-btn" @onclick="PrintManual">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                    <span>Print Manual</span>
                </button>
            </div>
        </div>

        <!-- Gemini 3D Storyboard Studio Bar -->
        <div class="deck-card" style="margin-bottom: 12px; padding: 18px 24px; background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: 0px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 40px; height: 40px; border-radius: 0px; background: linear-gradient(135deg, var(--accent, #557c6c), var(--accent-dark, #31523c)); color: white; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                        🎨
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text, #26332d);">Gemini 3D Storyboard Studio</h3>
                            <span style="background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); font-size: 11px; font-weight: 750; padding: 2px 8px; border-radius: 0px;">100% Free Web Flow</span>
                        </div>
                        <p style="margin: 2px 0 0; font-size: 12.5px; color: var(--muted, #6c7870);">Generate 6-page Pixar-style cartoon illustrations with Google Gemini for free, then drop the image below.</p>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <button type="button" class="btn primary" style="padding: 8px 16px; font-size: 13px; font-weight: 700; border-radius: 0px;" @onclick="CopyGeminiPromptAsync">
                        📋 Copy Prompt for Gemini
                    </button>
                    <button type="button" class="btn secondary" style="padding: 8px 14px; font-size: 13px; font-weight: 700; border-radius: 0px;" @onclick="OpenGeminiWebAsync">
                        ↗ Open Gemini Web
                    </button>
                    <label class="btn secondary" style="padding: 8px 14px; font-size: 13px; font-weight: 700; border-radius: 0px; cursor: pointer; margin: 0; display: inline-flex; align-items: center; gap: 6px; @(_isUploadingImage ? "opacity: 0.6; pointer-events: none;" : "")">
                        @(_isUploadingImage ? "⏳ Uploading..." : "📷 Upload 6-Panel Image")
                        <InputFile OnChange="HandleImageUploadAsync" accept="image/*" style="display: none;" disabled="@_isUploadingImage" />
                    </label>
                </div>
            </div>

            @if (_hasGridImage && !string.IsNullOrEmpty(_gridImageUrl))
            {
                <div style="margin-top: 18px; border-top: 1px solid var(--border, #e4e7df); padding-top: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                        <span style="font-size: 13.5px; font-weight: 750; color: var(--text, #26332d); display: flex; align-items: center; gap: 6px;">
                            <span>🖼️</span> 6-Page Illustrated Picture Book (Pixar-Inspired 3D Scene)
                        </span>
                        <div style="display: flex; gap: 8px;">
                            <a href="@_gridImageUrl" target="_blank" class="btn secondary" style="padding: 5px 12px; font-size: 12px;">🔍 Full Size</a>
                            <button type="button" class="btn secondary" style="padding: 5px 12px; font-size: 12px; color: #9b2c2c;" @onclick="RemoveGridImageAsync">🗑️ Remove Image</button>
                        </div>
                    </div>
                    <div style="border-radius: 0px; overflow: hidden; border: 1px solid var(--border, #e4e7df); box-shadow: 0 4px 20px rgba(0,0,0,0.06); text-align: center; background: #fafbfa;">
                        <img src="@_gridImageUrl" alt="Illustrated Storyboard Grid" style="width: 100%; height: auto; max-height: 560px; object-fit: contain; display: block; margin: 0 auto;" />
                    </div>
                </div>
            }
        </div>

        <!-- Split View Layout -->
        <div class="storybook-split-container">
            <!-- Left Column: Step Stepper & Setup Blueprint -->
            <aside class="storybook-sidebar">
                <!-- Step Quick Nav -->
                <PlaybookStepStepper Steps="@(_chapters.Select(c => new PlaybookStepStepper.StepItem { Title = c.Title, PhaseTag = c.PhaseTag, Duration = c.Duration, Icon = c.StepIcon }).ToList())"
                                     CurrentStepIndex="@_currentChapterIndex"
                                     TotalDuration="@GetTotalDuration().ToString()"
                                     OnStepSelected="JumpToChapter" />

                <!-- Materials & Setup Kit -->
                <PlaybookMaterialsKitCard Materials="@GetMaterialsList()" />

                <!-- Teacher's Pedagogical Lens -->
                <PlaybookObservationLensCard Watch="@_dna.ExecutionGuide?.Watch"
                                             Ask="@_dna.ExecutionGuide?.Ask"
                                             Try="@_dna.ExecutionGuide?.Try" />

                <!-- Offline Share Card -->
                <div class="deck-card export-info-deck">
                    <div class="export-banner">
                        <div class="export-icon">@(IsPublished ? "📦" : "🔒")</div>
                        <div>
                            <h4>@(IsPublished ? "Stored Playbook Manual" : "Stored When Published")</h4>
                            <p>
                                @(IsPublished 
                                    ? "This manual is synchronized with the latest published version and ready for offline circle time." 
                                    : "Publishing in Experience Studio stores the manual and unlocks offline downloads and separate tab viewing.")
                            </p>
                        </div>
                    </div>
                    @if (IsPublished)
                    {
                        <div style="display: flex; gap: 8px;">
                            <a href="/api/experiences/@ExperienceId/storybook" target="_blank" class="btn secondary" style="flex: 1; justify-content: center;">
                                <span>↗</span> Open Tab
                            </a>
                            <button class="btn primary" style="flex: 1.2; justify-content: center;" @onclick="ExportStandaloneHtml">
                                <span>📥</span> Download
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn secondary full-width" disabled style="opacity: 0.6; cursor: not-allowed;">
                            <span>🔒</span> Available Once Published
                        </button>
                    }
                </div>
            </aside>

            <!-- Right Column: DIY User Manual Stage (Diagram Beside Instructions) -->
            <main class="storybook-stage-wrapper">
                <!-- Step Progress Header -->
                <div class="stage-top-bar">
                    <div class="progress-info">
                        <span class="progress-pill">Step @_currentChapterIndex of @_chapters.Count</span>
                        <span class="progress-phase">@GetCurrentChapter().PhaseTag</span>
                    </div>
                    <!-- Navigation Arrows -->
                    <div class="stage-nav-arrows">
                        <button class="arrow-btn" @onclick="PreviousChapter" disabled="@(_currentChapterIndex <= 1)" title="Previous step (Left Arrow)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <span class="chapter-dots">
                            @for (int i = 0; i < _chapters.Count; i++)
                            {
                                var dotIdx = i + 1;
                                <span class="dot @(dotIdx == _currentChapterIndex ? "active" : "")" @onclick="() => JumpToChapter(dotIdx)"></span>
                            }
                        </span>
                        <button class="arrow-btn" @onclick="NextChapter" disabled="@(_currentChapterIndex >= _chapters.Count)" title="Next step (Right Arrow)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Main Illustrated DIY Card -->
                <div class="stage-card @(_fadeAnimation ? "fade-in" : "")" id="storyStage">
                    <!-- Dual-Mode Stage Content -->
                    @if (_displayMode == StorybookDisplayMode.ChildStory)
                    {
                        <!-- CHILD STORYBOOK MODE: Immersive Story Screen for Circle Time Presentation -->
                        <div class="child-story-view">
                            <div class="child-story-svg">
                                @((MarkupString)GetSceneSvg(GetCurrentChapter().SvgSceneKey))
                            </div>

                            <div class="child-story-content">
                                <div class="child-story-chapter-badge">
                                    ✨ Chapter @_currentChapterIndex · @GetCurrentChapter().Title
                                </div>
                                <div class="child-story-text">
                                    @(!string.IsNullOrWhiteSpace(GetCurrentChapter().ChildStory) ? GetCurrentChapter().ChildStory : GetCurrentChapter().Narrative)
                                </div>

                                @if (!string.IsNullOrWhiteSpace(GetCurrentChapter().WonderPrompt))
                                {
                                    <div class="child-story-wonder">
                                        <span class="wonder-bulb">💡</span>
                                        <span class="wonder-question">@GetCurrentChapter().WonderPrompt</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- TEACHER PLAYBOOK MODE: DIY Grid: Diagram Left, Step Instructions Right -->
                        <div class="diy-step-grid">
                            <!-- Left Diagram -->
                            <div class="diy-diagram-card">
                                <div class="diagram-tag-bar">
                                    <span>🎨 Instructional Diagram</span>
                                    <span class="step-badge">STEP @_currentChapterIndex</span>
                                </div>
                                <div class="diagram-svg-box">
                                    @((MarkupString)GetSceneSvg(GetCurrentChapter().SvgSceneKey))
                                </div>
                            </div>

                            <!-- Right Instructions -->
                            <div class="diy-instructions-card">
                                <div class="scene-meta">
                                    <span class="scene-chapter-badge">Step @_currentChapterIndex</span>
                                    <span class="scene-duration">⏱️ @GetCurrentChapter().Duration</span>
                                </div>

                                <h2 class="scene-title">@GetCurrentChapter().Title</h2>

                                <!-- Educator Activity Guide Box -->
                                <div class="diy-guide-box">
                                    <div class="guide-badge">Activity Flow</div>
                                    <p class="diy-guide-text">
                                        @GetCurrentChapter().Narrative
                                    </p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(GetCurrentChapter().TeacherScript))
                                {
                                    <div class="teacher-script-callout" style="background: #fbf7ef; border: 1px solid #ebdcc5; padding: 12px 14px; border-radius: 0px; margin-bottom: 14px;">
                                        <div class="script-header" style="display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #8c5a1e; margin-bottom: 4px;">
                                            <span>🗣️</span>
                                            <strong>Teacher's Spoken Script (Say Aloud)</strong>
                                        </div>
                                        <p class="script-text" style="font-size: 13px; font-style: italic; color: #4f3b20; line-height: 1.5; margin: 0;">
                                            @GetCurrentChapter().TeacherScript
                                        </p>
                                    </div>
                                }

                                <!-- Actions Breakdown Grid -->
                                <div class="perspectives-grid">
                                    <div class="perspective-card child-perspective">
                                        <div class="perspective-header">
                                            <span class="perspective-avatar">👧👦</span>
                                            <div>
                                                <strong>Children Action</strong>
                                                <small>Hands-on exploration</small>
                                            </div>
                                        </div>
                                        <p>@GetCurrentChapter().ChildrenAction</p>
                                    </div>

                                    <div class="perspective-card teacher-perspective">
                                        <div class="perspective-header">
                                            <span class="perspective-avatar">🌱</span>
                                            <div>
                                                <strong>Teacher Guidance</strong>
                                                <small>Facilitation & support</small>
                                            </div>
                                        </div>
                                        <p>@GetCurrentChapter().TeacherSpark</p>
                                    </div>
                                </div>

                                <!-- Wonder Callout -->
                                @if (!string.IsNullOrWhiteSpace(GetCurrentChapter().WonderPrompt))
                                {
                                    <div class="wonder-callout">
                                        <span class="wonder-icon">💡</span>
                                        <div class="wonder-text">
                                            <strong>Spark of Wonder:</strong>
                                            <span>@GetCurrentChapter().WonderPrompt</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Stage Bottom Actions -->
                    <div class="stage-bottom-bar">
                        <button class="stage-btn secondary" @onclick="PreviousChapter" disabled="@(_currentChapterIndex <= 1)">
                            <span>← Previous Step</span>
                        </button>

                        <div class="step-summary-pill">
                            <span>Step @_currentChapterIndex of @_chapters.Count</span>
                        </div>

                        @if (_currentChapterIndex < _chapters.Count)
                        {
                            <button class="stage-btn primary" @onclick="NextChapter">
                                <span>Next: @_chapters[_currentChapterIndex].Title →</span>
                            </button>
                        }
                        else
                        {
                            <button class="stage-btn finish-btn" @onclick="() => JumpToChapter(1)">
                                <span>↺ Replay from Step 1</span>
                            </button>
                        }
                    </div>
                </div>
            </main>
        </div>
    }
</div>

@code {
    [Parameter] public Guid ExperienceId { get; set; }

    private Experience? _experience;
    private ExperienceDna _dna = new();
    private bool _isLoading = true;
    private int _currentChapterIndex = 1;
    private bool _fadeAnimation = true;
    private StorybookDisplayMode _displayMode = StorybookDisplayMode.ChildStory;
    private bool _hasGridImage = false;
    private string? _gridImageUrl;
    private bool _isUploadingImage = false;

    private void SetDisplayMode(StorybookDisplayMode mode)
    {
        _displayMode = mode;
        StateHasChanged();
    }

    private List<StoryChapter> _chapters = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadExperienceAsync();
    }

    private async Task LoadExperienceAsync()
    {
        _isLoading = true;
        try
        {
            var exp = await ExperienceService.GetExperienceByIdAsync(ExperienceId);
            if (exp != null)
            {
                _experience = exp;
                if (!string.IsNullOrWhiteSpace(_experience.DnaPayload) && _experience.DnaPayload != "{}")
                {
                    try
                    {
                        _dna = JsonSerializer.Deserialize<ExperienceDna>(_experience.DnaPayload, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new ExperienceDna();
                    }
                    catch
                    {
                        _dna = new ExperienceDna();
                    }
                }
                BuildChapters();
                CheckGridImage();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CheckGridImage()
    {
        _hasGridImage = StorybookStorageService.HasStoredGridImage(ExperienceId);
        _gridImageUrl = _hasGridImage ? $"/api/experiences/{ExperienceId}/storybook/image?t={DateTime.UtcNow.Ticks}" : null;
    }

    private async Task CopyGeminiPromptAsync()
    {
        if (_experience == null) return;
        var prompt = StorybookGenerationService.BuildGeminiStorybookPrompt(_experience, _dna);
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", prompt);
        await ToastService.ShowSuccessToastAsync("✨ Gemini Master Prompt copied to clipboard! Paste into gemini.google.com");
    }

    private async Task OpenGeminiWebAsync()
    {
        await JS.InvokeVoidAsync("open", "https://gemini.google.com", "_blank");
    }

    private async Task HandleImageUploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 25 * 1024 * 1024)
        {
            await ToastService.ShowErrorToastAsync("Image size cannot exceed 25MB.");
            return;
        }

        _isUploadingImage = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            var saved = await StorybookStorageService.SaveGridImageAsync(ExperienceId, stream, file.ContentType);
            if (saved)
            {
                CheckGridImage();
                await ToastService.ShowSuccessToastAsync("🎉 6-page illustrated storybook saved successfully!");
            }
            else
            {
                await ToastService.ShowErrorToastAsync("Could not save the image. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorToastAsync($"Error uploading image: {ex.Message}");
        }
        finally
        {
            _isUploadingImage = false;
            StateHasChanged();
        }
    }

    private async Task RemoveGridImageAsync()
    {
        var deleted = StorybookStorageService.DeleteGridImage(ExperienceId);
        if (deleted)
        {
            CheckGridImage();
            await ToastService.ShowSuccessToastAsync("Illustrated image removed. Storybook reverted to blueprint mode.");
            StateHasChanged();
        }
    }

    private void BuildChapters()
    {
        _chapters = StandaloneHtmlGenerator.BuildChapters(_experience, _dna);
    }

    private StoryChapter GetCurrentChapter()
    {
        if (_chapters == null || _chapters.Count == 0)
            return new StoryChapter();

        var idx = Math.Clamp(_currentChapterIndex - 1, 0, _chapters.Count - 1);
        return _chapters[idx];
    }

    private void JumpToChapter(int chapterNum)
    {
        _currentChapterIndex = Math.Clamp(chapterNum, 1, _chapters.Count);
        TriggerFade();
    }

    private void NextChapter()
    {
        if (_currentChapterIndex < _chapters.Count)
        {
            _currentChapterIndex++;
            TriggerFade();
        }
    }

    private void PreviousChapter()
    {
        if (_currentChapterIndex > 1)
        {
            _currentChapterIndex--;
            TriggerFade();
        }
    }

    private void TriggerFade()
    {
        _fadeAnimation = false;
        StateHasChanged();
        _fadeAnimation = true;
    }

    private string GetAgeRange()
    {
        if (_dna.AgeMin > 0 && _dna.AgeMax > 0)
            return $"{_dna.AgeMin}-{_dna.AgeMax} yrs";
        return "3-5 yrs";
    }

    private string GetSetting()
    {
        return !string.IsNullOrWhiteSpace(_dna.Environment) ? _dna.Environment : "Indoor / Outdoor";
    }

    private string GetVersionBadge()
    {
        if (_experience == null) return string.Empty;
        if (_experience.UpdatedAt > DateTimeOffset.MinValue)
        {
            return $"Updated {_experience.UpdatedAt:MMM dd, yyyy}";
        }
        return $"Created {_experience.CreatedAt:MMM dd, yyyy}";
    }

    private int GetTotalDuration()
    {
        if (_dna.ExecutionGuide?.SuggestedDurationMinutes > 0)
            return _dna.ExecutionGuide.SuggestedDurationMinutes;
        return 25;
    }

    private List<string> GetMaterialsList()
    {
        if (_dna.Materials != null && _dna.Materials.Count > 0)
            return _dna.Materials;
        return new List<string>
        {
            "Cozy exploration mat or round circle rug",
            "Natural sensory items (smooth stones, pinecones, twigs)",
            "Magnifying glasses or wonder mirrors",
            "Child-safe craft clay or modeling sand",
            "Observation notebook or memory clipboard"
        };
    }

    private bool IsPublished => string.Equals(_experience?.Status, "Published", StringComparison.OrdinalIgnoreCase);

    private async Task ExportStandaloneHtml()
    {
        if (!IsPublished)
        {
            await JS.InvokeVoidAsync("alert", "Playbook manuals can only be downloaded once the experience has been published.");
            return;
        }

        var html = await StorybookStorageService.GetOrGeneratePublishedStorybookAsync(ExperienceId);
        if (string.IsNullOrWhiteSpace(html) && _experience != null)
        {
            var prompt = StorybookGenerationService.BuildGeminiStorybookPrompt(_experience, _dna);
            var gridImageBase64 = StorybookStorageService.GetGridImageBase64(ExperienceId);
            html = StandaloneHtmlGenerator.GenerateStorybookHtml(_experience, _dna, _hasGridImage, prompt, ExperienceId, gridImageBase64);
        }

        if (string.IsNullOrWhiteSpace(html))
        {
            await JS.InvokeVoidAsync("alert", "Could not generate manual for this experience.");
            return;
        }

        var safeFileName = (_experience?.Title ?? "Experience")
            .Replace(" ", "_")
            .Replace("/", "_")
            .Replace("\\", "_") + "_DIY_Manual.html";

        await JS.InvokeVoidAsync("window.downloadStandaloneHtml", safeFileName, html);
    }

    private async Task PrintManual()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private string GetSceneSvg(string key)
    {
        return StandaloneHtmlGenerator.GetSvgForKey(key);
    }
}
