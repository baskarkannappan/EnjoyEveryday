@page "/children/add"
@page "/children/edit/{Id:guid}"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components.Admissions
@inject NavigationManager NavManager

<PageTitle>@(Id.HasValue ? "Edit Child" : "Add Child") — EnjoyEveryday</PageTitle>

@if (Id.HasValue)
{
    <ChildEnrollmentWizard Id="Id" />
}
else
{
    <div style="padding: 40px; text-align: center; color: var(--muted, #6c7870); font-weight: 600;">
        Redirecting to official Admissions &amp; Inquiry Pipeline...
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    protected override void OnInitialized()
    {
        if (!Id.HasValue)
        {
            NavManager.NavigateTo("/enrollment?action=new-inquiry", replace: true);
        }
    }
}
