@page "/journey"
@page "/journey/{ChildId:guid}"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Journey
@using EnjoyEveryday.UI.Shared.Components.Planning
@using EnjoyEveryday.UI.Shared.Components.ChildJourney
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Application.Services

@inject IChildJourneyService JourneyService
@inject IChildDailyCareService DailyCareService
@inject ExperienceService ExperienceService
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject ChildService ChildService
@inject OrganizationService OrgService
@inject NavigationManager NavigationManager

