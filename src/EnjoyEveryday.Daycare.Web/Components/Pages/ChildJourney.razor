@page "/journey"
@page "/journey/{ChildId:guid}"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Journey
@using EnjoyEveryday.UI.Shared.Components.Planning
@using EnjoyEveryday.UI.Shared.Components.ChildJourney
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Application.Services

@inject IChildJourneyService JourneyService
@inject ExperienceService ExperienceService

<PageTopbar Breadcrumb="EnjoyEveryday · Little Stars · Bluebirds" Title="Aarav's Journey">
    <RightContent>
        <button class="circle-btn" style="width: 38px; height: 38px; border: 1px solid #e7ebe7; border-radius: 50%; background: white; margin-right: 8px;">🔔</button>
        <button class="circle-btn" style="width: 38px; height: 38px; border: 1px solid #e7ebe7; border-radius: 50%; background: white; margin-right: 8px;">?</button>
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #dce9df; display: flex; align-items: center; justify-content: center; font-weight: 750; color: #365844; font-size: 14px;">
            BP
        </div>
    </RightContent>
</PageTopbar>

<section class="content" style="max-width: 1380px; margin: auto; padding: 34px;">
    
    <div class="child-header">
        <div class="child-identity">
            <div class="child-avatar">A</div>
            <div>
                <div class="child-name">Aarav Patel</div>
                <div class="child-meta">
                    <span>Age 3 Years, 4 Months</span>
                    <span>Bluebirds</span>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <button class="secondary-btn" @onclick='() => OpenModal("share")'>Download PDF</button>
            <button class="primary-btn" @onclick="OpenAddMomentDialog">Log Moment</button>
        </div>
    </div>
        
    <div class="journey-summary">
        <JourneySummaryCard Label="Experiences" Value="124" Text="Total guided and free play moments captured." />
        <JourneySummaryCard Label="Current Focus" Value="Connection" Text="Showing strong growth in social empathy." IsFeatured="true" />
        <JourneySummaryCard Label="AI Highlights" Value="12" Text="Insights generated from recent observations." />
        <JourneySummaryCard Label="Milestones" Value="3" Text="Developmental markers observed this month." />
    </div>

    <div class="main-grid">
        <div>
            <div class="timeline-controls">
                <button class="filter-btn @(_currentFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>All Activity</button>
                <button class="filter-btn @(_currentFilter == "Discovery" ? "active" : "")" @onclick='() => SetFilter("Discovery")'>Discover</button>
                <button class="filter-btn @(_currentFilter == "Create" ? "active" : "")" @onclick='() => SetFilter("Create")'>Create</button>
                <button class="filter-btn @(_currentFilter == "Connection" ? "active" : "")" @onclick='() => SetFilter("Connection")'>Connect</button>
                
                <div style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 14px; color: #666; font-weight: 500;">Date:</span>
                    <input type="date" @bind="_selectedDate" @bind:after="ApplyFilter" style="padding: 6px 12px; border: 1px solid #e4e7df; border-radius: 6px; outline: none; font-family: inherit; color: #26332d;" />
                    @if (_selectedDate.HasValue)
                    {
                        <button style="background: none; border: none; cursor: pointer; color: #666; font-size: 14px;" @onclick="ClearDateFilter">✕</button>
                    }
                </div>
            </div>

            <div class="timeline">
                @if (_entries != null && _entries.Any())
                {
                    @foreach (var entry in _entries)
                    {
                        var entryTags = GetTagsForEntry(entry.Id);
                        
                        <JourneyTimelineCard 
                            DateString="@entry.ObservationDate.ToString("MMM dd")" 
                            Type="@entry.JourneyType" 
                            Title="@(entry.ExperienceId.HasValue ? ("Experience: " + (!string.IsNullOrEmpty(entry.Title) ? entry.Title : (_experienceTitles.ContainsKey(entry.ExperienceId.Value) ? _experienceTitles[entry.ExperienceId.Value] : "Teacher Observation"))) : (string.IsNullOrEmpty(entry.Title) ? "Teacher Observation" : entry.Title))" 
                            Time="@entry.ObservationDate.ToString("t")"
                            Description="@entry.Observation"
                            Quote="@entry.ChildVoice" 
                            Tags="@entryTags"
                            OnDelete="() => DeleteEntry(entry.Id)" />
                    }
                }
                else
                {
                    <div style="padding: 24px; text-align: center; color: #666; background: #f9faf9; border-radius: 8px;">
                        No moments logged yet. Click "Log Moment" to start Aarav's journey!
                    </div>
                }
            </div>
        </div>

        <div>
            <SidePanel Title="Growing Interests" Subtitle="Based on last 30 days">
                <InterestBar Name="Building & Blocks" Value="85" Note="Consistently engages with spatial activities." />
                <InterestBar Name="Color Mixing" Value="60" Note="Recent spike after art class." />
                <InterestBar Name="Animal Stories" Value="45" />
                <InterestBar Name="Music & Rhythm" Value="20" />
            </SidePanel>
            
            <div class="card ai-card">
                <div class="ai-heading">
                    <div class="ai-icon">🧠</div>
                    <div>
                        <strong>Spatial to Social</strong>
                        <small>AI Analysis</small>
                    </div>
                </div>
                <div class="ai-text">
                    Aarav loves building alone. Try introducing a 'City Planning' experience where he has to negotiate space with 2 other children to build a shared town.
                </div>
                <div class="ai-suggestion">
                    Experience: Cooperative City Building
                </div>
                <button class="ai-button" @onclick='() => OpenModal("idea")'>Create this experience</button>
            </div>

            <SidePanel Title="Accomplishments">
                <AccomplishmentRow Icon="🌟" Title="Empathy in Action" Description="Comforted a crying friend." />
                <AccomplishmentRow Icon="🧩" Title="Complex Sorting" Description="Sorted toys by shape and color." />
                <AccomplishmentRow Icon="🎨" Title="Color Theory" Description="Discovered how to mix green." />
            </SidePanel>

            <JourneyMemoryCard Title="First self-portrait" Text="Used the new chalk pastels to draw his family." />
        </div>
    </div>
    
    <div class="journey-note">
        Every child's journey is unique. <strong>EnjoyEveryday</strong> helps you see the patterns.
    </div>

</section>

@if (_isModalOpen)
{
    <div class="modal-overlay show" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseModal">✕</button>
            <h2>@_modalTitle</h2>
            <p>@_modalText</p>
            <div class="modal-options">
                <button class="modal-option" @onclick="CloseModal">Add another memory</button>
                <button class="modal-option" @onclick="CloseModal">Create an experience from this</button>
                <button class="modal-option" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

<AddJourneyMomentDialog @ref="_addMomentDialog" ChildId="@_childId" TeacherId="@(Guid.Parse("50000000-0000-0000-0000-000000000001"))" OnSaved="OnMomentSaved" />

@code {
    [Parameter]
    public Guid? ChildId { get; set; }

    private AddJourneyMomentDialog _addMomentDialog = default!;
    
    private Guid _childId => ChildId ?? Guid.Parse("C0000000-0000-0000-0000-000000000001");
    private List<ChildJourneyEntry>? _allEntries;
    private List<ChildJourneyEntry>? _entries;
    private Dictionary<Guid, List<DevelopmentArea>> _entryAreas = new();
    private Dictionary<Guid, string> _experienceTitles = new();
    
    private string _currentFilter = "all";
    private bool _isModalOpen = false;
    private string _modalTitle = "";
    private string _modalText = "";
    private DateTime? _selectedDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var entries = await JourneyService.GetChildJourneyAsync(_childId);
        _allEntries = entries.ToList();
        
        var allAreas = await JourneyService.GetDevelopmentAreasAsync();
        var areaDict = allAreas.ToDictionary(a => a.Id);
        
        _entryAreas.Clear();
        foreach (var entry in _allEntries)
        {
            var areaIds = await JourneyService.GetDevelopmentAreasForEntryAsync(entry.Id);
            var areas = areaIds.Where(areaDict.ContainsKey).Select(id => areaDict[id]).ToList();
            _entryAreas[entry.Id] = areas;
        }
        
        var allExperiences = await ExperienceService.GetExperiencesAsync();
        _experienceTitles = allExperiences.ToDictionary(e => e.Id, e => e.Title);
        
        ApplyFilter();
    }

    private List<string> GetTagsForEntry(Guid entryId)
    {
        if (_entryAreas.TryGetValue(entryId, out var areas))
        {
            return areas.Select(a => a.Name).ToList();
        }
        return new List<string>();
    }

    private void SetFilter(string filter)
    {
        _currentFilter = filter;
        ApplyFilter();
    }
    
    private void ClearDateFilter()
    {
        _selectedDate = null;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_allEntries == null) return;
        
        var filtered = _allEntries.AsEnumerable();
        
        if (_selectedDate.HasValue)
        {
            filtered = filtered.Where(e => e.ObservationDate.Date == _selectedDate.Value.Date);
        }

        if (_currentFilter == "Discovery")
        {
            filtered = filtered.Where(e => e.JourneyType == "Discovery" || (string.IsNullOrEmpty(e.JourneyType) == false && e.JourneyType.Contains("Discover")));
        }
        else if (_currentFilter == "Create")
        {
            filtered = filtered.Where(e => e.JourneyType == "Create" || GetTagsForEntry(e.Id).Any(t => t.Contains("Creat")));
        }
        else if (_currentFilter == "Connection")
        {
            filtered = filtered.Where(e => e.JourneyType == "Connection" || GetTagsForEntry(e.Id).Any(t => t.Contains("Social") || t.Contains("Emot")));
        }
        
        // Ensure they are ordered by most recent first
        _entries = filtered.OrderByDescending(e => e.ObservationDate).ToList();
    }

    private void OpenModal(string type)
    {
        if (type == "share")
        {
            _modalTitle = "Share Aarav's Journey";
            _modalText = "Create a parent-friendly version of Aarav's journey. Only approved memories, experiences and observations will be included.";
        }
        else if (type == "memory")
        {
            _modalTitle = "Add a Memory";
            _modalText = "Capture something that happened today that feels worth remembering. A memory can be a teacher note, a child's words, a creation or an approved photo.";
        }
        else if (type == "idea")
        {
            _modalTitle = "Aarav's Possible Next Experience";
            _modalText = "Build a Tiny Insect Shelter could combine Aarav's interest in building and bugs while creating an opportunity for collaboration. This is only a suggestion — the teacher decides what happens next.";
        }
        _isModalOpen = true;
    }

    private async Task OpenAddMomentDialog()
    {
        await _addMomentDialog.OpenAsync();
    }

    private async Task OnMomentSaved()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private void CloseModal()
    {
        _isModalOpen = false;
    }
    
    private async Task DeleteEntry(Guid entryId)
    {
        // Simple confirm dialog would be better here, but for MVP we directly delete
        await JourneyService.DeleteJourneyEntryAsync(entryId);
        await LoadDataAsync();
    }
}
