@page "/"
@page "/today"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@inject PlannerService PlannerService
@inject ClassroomService ClassroomService
@inject OrganizationService OrganizationService
@inject BranchService BranchService
@inject ExecutionService ExecutionService
@inject ExperienceService ExperienceService
@inject EventService EventService
@inject ClassroomContextService ContextService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject UserService UserService
@inject TimeProvider TimeProvider
@rendermode InteractiveServer

 
<div class="content">

        <!-- HOME -->
        <section id="home" style="display: block;">

            <div class="welcome">

                <div>
                    @{
                        var hour = DateTime.Now.Hour;
                        var greeting = hour < 12 ? "Good morning" : (hour < 18 ? "Good afternoon" : "Good evening");
                    }
                    <h1>@greeting, @_userFirstName ✦</h1>
                    <p>Here is what is happening at Little Stars today.</p>
                </div>

                <div class="date-pill">
                    @DateTime.Today.ToString("dddd, MMMM d, yyyy")
                </div>

            </div>


            <!-- DAYCARE PULSE -->

            <div class="pulse">

                <div class="pulse-card pulse-main">
                    <div class="pulse-label">Daycare today</div>
                    <div class="pulse-number">A day full of possibility.</div>
                    <div class="pulse-text">
                        @_expectedChildren children • @_totalClassrooms classrooms • @_totalExperiences experiences • @_todayEvents.Count celebrations scheduled
                    </div>
                </div>

                <div class="pulse-card">
                    <div class="stat-label">Children here</div>
                    <div class="stat-number">@_childrenHere</div>
                    <div class="stat-note">of @_expectedChildren expected today</div>
                </div>

                <div class="pulse-card">
                    <div class="stat-label">Experiences</div>
                    <div class="stat-number">@_totalExperiences</div>
                    <div class="stat-note">@_activeExperiences happening now</div>
                </div>

                <div class="pulse-card">
                    <div class="stat-label">Teachers</div>
                    <div class="stat-number">@_totalTeachers</div>
                    <div class="stat-note">All classrooms covered</div>
                </div>

            </div>


            <div class="dashboard-grid">

                <!-- LEFT -->

                <div>

                    <!-- CLASSROOMS -->

                    <!-- CLASSROOMS & LIVE EVENTS -->

                    <div class="section-card">

                        <div class="section-header">
                            <h2>What is happening right now</h2>
                            <span>Live classroom view</span>
                        </div>

                        @* Active Org-wide or Branch-wide Event Banner *@
                        @{
                            var activeBroadEvents = _todayEvents.Where(e => (e.Scope == "Organization" || e.Scope == "Branch") && IsEventActiveNow(e)).ToList();
                            foreach (var actEvt in activeBroadEvents)
                            {
                                var scopeText = actEvt.Scope == "Organization" ? "All branches & classrooms" : $"All classrooms in {GetBranchName(actEvt.BranchId)}";
                                <div class="active-event-alert">
                                    <div class="alert-info">
                                        <span class="alert-icon">🎉</span>
                                        <div>
                                            <div class="alert-title">@actEvt.Title</div>
                                            <div class="alert-meta">
                                                <span class="scope-badge @(actEvt.Scope.ToLower())" style="margin-right: 6px;">@(actEvt.Scope == "Organization" ? "🌐 Org-Wide" : $"🏢 {GetBranchName(actEvt.BranchId)}")</span>
                                                @(actEvt.StartTime?.ToString(@"hh\:mm") ?? "All Day")@((actEvt.EndTime != null) ? $" - {actEvt.EndTime?.ToString(@"hh\:mm")}" : "") • @scopeText
                                            </div>
                                        </div>
                                    </div>
                                    <a href="/events/@actEvt.Id" class="view-btn" style="text-decoration: none; padding: 4px 10px; font-size: 11px;">
                                        Celebration Details &rarr;
                                    </a>
                                </div>
                            }
                        }

                        @{
                            var activeClassroomsCount = 0;
                            foreach(var cr in _classrooms)
                            {
                                var activeSched = _todaySchedules.FirstOrDefault(s => s.ClassroomId == cr.Id && (s.Status == "Started" || s.Status == "Active"));
                                var activeEvtForCr = _todayEvents.FirstOrDefault(e => DoesEventApplyToClassroom(e, cr) && IsEventActiveNow(e));

                                if (activeSched != null || activeEvtForCr != null)
                                {
                                    activeClassroomsCount++;
                                    var expName = activeSched != null 
                                        ? (_experiences.FirstOrDefault(e => e.Id == activeSched.ExperienceId)?.Title ?? "Unknown Experience") 
                                        : null;
                                    
                                    <div class="classroom">
                                        <div class="classroom-top">
                                            <div class="classroom-name">
                                                <div class="classroom-dot" style="background-color: @(activeSched != null ? "var(--green)" : "#f59e0b");"></div>
                                                <div>
                                                    <strong>@cr.Name</strong>
                                                    <small>Capacity: @cr.Capacity • @GetBranchName(cr.BranchId)</small>
                                                </div>
                                            </div>
                                            <div style="display: flex; gap: 6px; align-items: center;">
                                                @if (activeSched != null)
                                                {
                                                    <span class="status active">
                                                        Exploring
                                                    </span>
                                                }
                                                @if (activeEvtForCr != null)
                                                {
                                                    <span class="scope-badge @activeEvtForCr.Scope.ToLower()">
                                                        🎉 @(activeEvtForCr.Scope == "Organization" ? "Org Event" : activeEvtForCr.Scope == "Branch" ? "Branch Event" : "Class Event")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="classroom-bottom">
                                            <div class="mini-info">
                                                Children
                                                <strong>@cr.CurrentEnrollment / @cr.Capacity</strong>
                                            </div>
                                            <div class="mini-info">
                                                @(activeSched != null ? "Experience" : "Celebration")
                                                <strong>@(expName ?? activeEvtForCr?.Title)</strong>
                                            </div>
                                            @if (activeSched != null && !string.IsNullOrWhiteSpace(activeSched.PreparationNotes))
                                            {
                                                <div class="mini-info" style="grid-column: 1 / -1; margin-top: 8px;">
                                                    Preparation Notes
                                                    <strong>@activeSched.PreparationNotes</strong>
                                                </div>
                                            }
                                            else if (activeSched == null && activeEvtForCr != null && !string.IsNullOrWhiteSpace(activeEvtForCr.Description))
                                            {
                                                <div class="mini-info" style="grid-column: 1 / -1; margin-top: 8px;">
                                                    Event Notes
                                                    <strong>@activeEvtForCr.Description</strong>
                                                </div>
                                            }
                                            <a class="view-btn" href="@(activeSched != null ? "/classrooms" : $"/events/{activeEvtForCr?.Id}")" style="text-decoration:none;">
                                                Open &rarr;
                                            </a>
                                        </div>
                                    </div>
                                }
                            }

                            if (activeClassroomsCount == 0 && !activeBroadEvents.Any())
                            {
                                <div class="classroom" style="display:flex; flex-direction: column; align-items:center; justify-content:center; padding: 28px 16px; color: var(--neutral-foreground-hint); text-align: center; border: none; background: transparent; gap: 6px;">
                                    <div>There are no structured experiences or special events actively running right now.</div>
                                    @if (_todayEvents.Any(e => e.Status == "Planned" || e.Status == "Approved" || e.Status == "Published"))
                                    {
                                        <div style="font-size: 12px; color: #0284c7;">
                                            Tip: Click <strong>"▶️ Start"</strong> on any celebration in Today's rhythm below to activate live coverage.
                                        </div>
                                    }
                                    else if (_todayEvents.Any(e => e.Status == "Completed"))
                                    {
                                        <div style="font-size: 12px; color: #059669;">
                                            All of today's celebrations are completed. You can view or add photos below!
                                        </div>
                                    }
                                </div>
                            }
                        }

                    </div>


                    <!-- DAY FLOW / TODAY'S RHYTHM -->

                    <div class="section-card">

                        <div class="section-header" style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h2>Today's rhythm</h2>
                                <span>Experiences & Celebrations across Little Stars</span>
                            </div>
                            <a href="/rhythm-history" style="display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 700; color: #2d5a3f; background: #eaf3ed; border: 1px solid #c8e1d2; padding: 5px 12px; border-radius: 999px; text-decoration: none; transition: all 0.2s; white-space: nowrap;">
                                📜 Past Rhythm &rarr;
                            </a>
                        </div>

                        <div class="timeline">

                            @foreach(var item in _rhythmTimeline)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-dot @(item.IsEvent ? "event-dot" : "")"></div>
                                    <div class="timeline-time">
                                        @item.TimeDisplay
                                    </div>
                                    <div class="timeline-title">
                                        @if (item.IsEvent)
                                        {
                                            <span>🎉 @item.Title</span>
                                            <span class="scope-badge @item.Scope.ToLower()" style="margin-left: 8px;">
                                                @(item.Scope == "Organization" ? "🌐 Org-Wide" : item.Scope == "Branch" ? $"🏢 Branch: {item.ScopeDisplay}" : $"🚪 {item.ScopeDisplay}")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@item.Title</span>
                                            <span style="font-size: 12px; font-weight: normal; color: var(--muted); margin-left: 6px;">
                                                • @item.ScopeDisplay
                                            </span>
                                        }
                                    </div>
                                    <div class="timeline-sub">
                                        Status: @item.Status
                                        @if (!item.IsEvent)
                                        {
                                            @if(item.Status == "Scheduled" || item.Status == "Planned" || item.Status == "Confirmed")
                                            {
                                                <button class="btn btn-sm btn-primary ml-3" @onclick="() => StartSession(item.ScheduleId!.Value)" style="margin-left: 10px; padding: 2px 8px; border-radius: 4px; background-color: #263d32; color: white; border: none; cursor: pointer;">Start</button>
                                            }
                                            else if (item.Status == "Started" || item.Status == "Active")
                                            {
                                                <button class="btn btn-sm btn-outline-success ml-3" @onclick="() => OpenActiveSession(item.ScheduleId!.Value)" style="margin-left: 10px; padding: 2px 8px; border-radius: 4px; border: 1px solid #263d32; color: #263d32; background: transparent; cursor: pointer;">View Active Session</button>
                                            }
                                        }
                                        else
                                        {
                                            @if (item.Status == "Planned" || item.Status == "Approved" || item.Status == "Published")
                                            {
                                                <button class="btn btn-sm" @onclick="() => StartCelebration(item.EventId!.Value)" style="margin-left: 8px; padding: 2px 8px; border-radius: 4px; background-color: #0284c7; color: white; border: none; font-size: 11px; font-weight: 600; cursor: pointer;">
                                                    ▶️ Start
                                                </button>
                                            }
                                            else if (item.Status == "InProgress")
                                            {
                                                <button class="btn btn-sm" @onclick="() => FinishCelebration(item.EventId!.Value)" style="margin-left: 8px; padding: 2px 8px; border-radius: 4px; background-color: #059669; color: white; border: none; font-size: 11px; font-weight: 600; cursor: pointer;">
                                                    🏁 Finish
                                                </button>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <button class="btn btn-sm" @onclick="() => OpenEventPhotoModal(item.EventId!.Value)" style="margin-left: 8px; padding: 2px 8px; border-radius: 4px; background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-size: 11px; font-weight: 600; cursor: pointer;">
                                                    📸 Photos (@(item.PhotoUrls?.Length ?? 0)/3)
                                                </button>
                                            }
                                            <a href="/events/@item.EventId" style="margin-left: 6px; padding: 2px 8px; border-radius: 4px; background-color: #fffbeb; color: #92400e; border: 1px solid #fde68a; text-decoration: none; font-size: 11px; font-weight: 700;">View &rarr;</a>
                                        }
                                    </div>
                                    @if (item.IsEvent && item.PhotoUrls != null && item.PhotoUrls.Length > 0)
                                    {
                                        <div style="display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap;">
                                            @foreach (var photo in item.PhotoUrls)
                                            {
                                                <img src="@photo" alt="Photo" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0; cursor: pointer;" @onclick="() => _previewPhoto = photo" />
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if(!_rhythmTimeline.Any())
                            {
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-time">No plans</div>
                                    <div class="timeline-title">Nothing scheduled for today.</div>
                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- RIGHT -->

                <div>

                    <!-- AI -->

                    <div class="section-card ai-card">

                        <div class="ai-header">

                            <div class="ai-icon">✦</div>

                            <div>
                                <strong>EnjoyEveryday Intelligence</strong>
                                <small>Watching the day with you</small>
                            </div>

                        </div>

                        <div class="ai-message">

                            Three classrooms are especially interested in
                            building and animals this week.

                            <br><br>

                            Bluebirds have repeatedly enjoyed bridges.
                            I found an opportunity to connect that interest
                            with today's animal experience.

                        </div>

                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <button type="button" class="ai-action" @onclick="() => _isRecommendationModalOpen = true" style="border: none; cursor: pointer; text-align: center; width: 100%; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 6px;">
                                ✦ Get Activity Suggestions
                            </button>
                            <a class="ai-action" href="/intelligence" style="text-decoration:none; color:inherit; text-align:center; display:block; opacity: 0.85; font-size: 13px;">
                                Explore the insight
                            </a>
                        </div>
                    </div>


                        <div class="section-card">

                            <div class="section-header">
                                <h2>Little moments</h2>
                                <span>Today</span>
                            </div>

                            @if (_recentMemories.Any())
                            {
                                foreach (var memory in _recentMemories)
                                {
                                    <div class="moment">
                                        <div class="moment-name">
                                            @memory.MomentName
                                        </div>
                                        <div class="moment-text">
                                            “@memory.MomentText”
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="moment">
                                    <div class="moment-name">
                                        BLUEBIRDS • Priya
                                    </div>
                                    <div class="moment-text">
                                        “Aarav rebuilt the bridge after it fell
                                        instead of asking for help.”
                                    </div>
                                </div>
                                <div class="moment">
                                    <div class="moment-name">
                                        SUNFLOWERS • Meena
                                    </div>
                                    <div class="moment-text">
                                        “Maya decided the garden needed a hospital
                                        for injured butterflies.”
                                    </div>
                                </div>
                                <div class="moment">
                                    <div class="moment-name">
                                        BUTTERFLIES • Anitha
                                    </div>
                                    <div class="moment-text">
                                        “The children turned the whole room into
                                        a jungle.”
                                    </div>
                                </div>
                            }

                        </div>


                    <!-- ATTENTION -->

                    <div class="section-card">

                        <div class="section-header">
                            <h2>Worth noticing</h2>
                            <span>Gentle reminders</span>
                        </div>


                        <div class="attention">

                            <div class="attention-icon">✦</div>

                            <div>
                                <strong>Bluebirds love building</strong>
                                <p>
                                    4 recent experiences included bridges,
                                    blocks or construction.
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- QUICK ACTIONS -->

                    <div class="section-card">

                        <div class="section-header">
                            <h2>Quick actions</h2>
                        </div>

                        <div class="quick-actions">

                            <a class="quick" href="/studio" style="text-decoration:none; color:inherit; text-align:left; display:block;">
                                <div class="quick-icon">✦</div>
                                <strong>Create experience</strong>
                                <small>Make something new</small>
                            </a>

                            <a class="quick" href="/planning" style="text-decoration:none; color:inherit; text-align:left; display:block;">
                                <div class="quick-icon">□</div>
                                <strong>Plan the month</strong>
                                <small>View experience calendar</small>
                            </a>

                            <a class="quick" href="/classrooms" style="text-decoration:none; color:inherit; text-align:left; display:block;">
                                <div class="quick-icon">◫</div>
                                <strong>View classrooms</strong>
                                <small>See today's rhythm</small>
                            </a>

                            <a class="quick" href="/intelligence" style="text-decoration:none; color:inherit; text-align:left; display:block;">
                                <div class="quick-icon">♡</div>
                                <strong>Ask AI</strong>
                                <small>Help me think</small>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- OTHER PAGES -->

        <section id="classrooms" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Classrooms</h1>
                    <p>See each classroom as a living environment.</p>
                </div>
            </div>

            <div class="section-card">

                <div class="section-header">
                    <h2>Little Stars today</h2>
                    <span>3 classrooms</span>
                </div>

                <div class="classroom">
                    <div class="classroom-top">
                        <div class="classroom-name">
                            <div class="classroom-dot"></div>
                            <div>
                                <strong>Bluebirds</strong>
                                <small>Age 3–4 • 18 children • Priya</small>
                            </div>
                        </div>
                        <span class="status active">Exploring</span>
                    </div>
                </div>

                <div class="classroom">
                    <div class="classroom-top">
                        <div class="classroom-name">
                            <div class="classroom-dot"></div>
                            <div>
                                <strong>Sunflowers</strong>
                                <small>Age 4–5 • 14 children • Meena</small>
                            </div>
                        </div>
                        <span class="status">Creating</span>
                    </div>
                </div>

                <div class="classroom">
                    <div class="classroom-top">
                        <div class="classroom-name">
                            <div class="classroom-dot"></div>
                            <div>
                                <strong>Butterflies</strong>
                                <small>Age 2–3 • 10 children • Anitha</small>
                            </div>
                        </div>
                        <span class="status">Moving</span>
                    </div>
                </div>

            </div>

        </section>


        <section id="experiences" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Experiences</h1>
                    <p>Everything Little Stars knows how to make happen.</p>
                </div>

                <button class="ai-action" onclick="showModal('Create Experience')">
                    + Create Experience
                </button>
            </div>

            <div class="section-card">

                <div class="section-header">
                    <h2>Experience Library</h2>
                    <span>24 experiences</span>
                </div>

                <div class="classroom">
                    <strong>Our Little City</strong>
                    <small style="display:block;color:#8b958f;margin-top:5px">
                        Building • Together • Age 3–4
                    </small>
                </div>

                <div class="classroom">
                    <strong>Bug Detectives</strong>
                    <small style="display:block;color:#8b958f;margin-top:5px">
                        Discovery • Nature • Age 3–5
                    </small>
                </div>

                <div class="classroom">
                    <strong>Animal Rescue Adventure</strong>
                    <small style="display:block;color:#8b958f;margin-top:5px">
                        Imagination • Movement • Age 3–4
                    </small>
                </div>

            </div>

        </section>


        <section id="calendar" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Experience Calendar</h1>
                    <p>September 2026 • OUR WORLD</p>
                </div>
            </div>

            <div class="section-card">

                <div class="section-header">
                    <h2>This month</h2>
                    <span>Flexible rhythm</span>
                </div>

                <div class="classroom">
                    <strong>Week 1 — Discover</strong>
                    <small style="display:block;color:#8b958f;margin-top:5px">
                        Bugs • Nature • Outdoor exploration
                    </small>
                </div>

                <div class="classroom">
                    <strong>Week 2 — Build</strong>
                    <small style="display:block;color:#8b958f;margin-top:5px">
                        Blocks • Bridges • Our Little City
                    </small>
                </div>

                <div class="classroom">
                    <strong>Week 3 — Imagine</strong>
                    <small style="display:block;color:#8b958f;margin-top:5px">
                        Stories • Animals • Pretend worlds
                    </small>
                </div>

            </div>

        </section>


        <section id="children" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Children</h1>
                    <p>Understand the children, not just the numbers.</p>
                </div>
            </div>

            <div class="section-card">

                <div class="section-header">
                    <h2>Little Stars</h2>
                    <span>42 children</span>
                </div>

                <div class="moment">
                    <div class="moment-name">AARAV • BLUEBIRDS</div>
                    <div class="moment-text">
                        Building • Bugs • Helping friends
                    </div>
                </div>

                <div class="moment">
                    <div class="moment-name">MAYA • BLUEBIRDS</div>
                    <div class="moment-text">
                        Drawing • Plants • Storytelling
                    </div>
                </div>

                <div class="moment">
                    <div class="moment-name">LIAM • BLUEBIRDS</div>
                    <div class="moment-text">
                        Vehicles • Movement • Puzzles
                    </div>
                </div>

            </div>

        </section>


        <section id="memories" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Memories</h1>
                    <p>The beautiful things worth keeping.</p>
                </div>
            </div>

            <div class="section-card">

                <div class="section-header">
                    <h2>Recent memories</h2>
                    <span>September</span>
                </div>

                <div class="moment">
                    <div class="moment-name">BLUEBIRDS</div>
                    <div class="moment-text">
                        The bridge that wouldn't stay up.
                    </div>
                </div>

                <div class="moment">
                    <div class="moment-name">SUNFLOWERS</div>
                    <div class="moment-text">
                        Maya's butterfly hospital.
                    </div>
                </div>

                <div class="moment">
                    <div class="moment-name">BUTTERFLIES</div>
                    <div class="moment-text">
                        The room became a jungle.
                    </div>
                </div>

            </div>

        </section>


        <section id="insights" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Insights</h1>
                    <p>What is Little Stars learning about its children?</p>
                </div>
            </div>

            <div class="section-card">

                <div class="section-header">
                    <h2>Experience insights</h2>
                    <span>Last 30 days</span>
                </div>

                <div class="moment">
                    <div class="moment-name">DISCOVERY</div>
                    <div class="moment-text">
                        Children stayed longer when experiences began
                        with something they could touch or investigate.
                    </div>
                </div>

                <div class="moment">
                    <div class="moment-name">BUILDING</div>
                    <div class="moment-text">
                        Building experiences generated repeated
                        experimentation and collaboration.
                    </div>
                </div>

                <div class="moment">
                    <div class="moment-name">TOGETHER</div>
                    <div class="moment-text">
                        Children often extended experiences when another
                        child joined their idea.
                    </div>
                </div>

            </div>

        </section>


        <section id="team" style="display: none;">

            <div class="welcome">
                <div>
                    <h1>Team</h1>
                    <p>The people who make the day happen.</p>
                </div>
            </div>

            <div class="section-card">

                <div class="moment">
                    <div class="moment-name">BLUEBIRDS</div>
                    <div class="moment-text">
                        Priya — Lead Teacher<br>
                        Ravi — Assistant Teacher
                    </div>
                </div>

                <div class="moment">
