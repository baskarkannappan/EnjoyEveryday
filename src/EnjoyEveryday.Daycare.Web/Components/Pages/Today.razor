@page "/"
@page "/today"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ActiveSessionModal
@inject IDaycareOperationsBoardService OperationsBoardService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject ExecutionService ExecutionService
@inject EventService EventService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@rendermode InteractiveServer

<PageTitle>Live Daycare Operations Board — EnjoyEveryday</PageTitle>

<div class="content operations-board-page">
    @if (_loading)
    {
        <LoadingState Text="Loading live daycare operations board..." />
    }
    else
    {
        <!-- PAGE HERO -->
        <PageHero Eyebrow="LIVE OPERATIONS BOARD"
                  Title="@($"Daycare Operations — {_board.OrganizationName}")"
                  Subtitle="@($"Real-time operational cockpit for {_board.EffectiveRole}: attendance, staffing coverage, live experiences, and actionable care alerts.")">
            <RightContent>
                <!-- Role / Persona Filter (Preselected automatically to user's assigned higher role) -->
                @if (_availableRoles.Count > 0)
                {
                    <div class="role-switcher">
                        <span class="role-lbl">Viewing as:</span>
                        <select class="role-select" value="@_selectedRoleOverride" @onchange="OnRoleChanged" disabled="@(_availableRoles.Count <= 1)">
                            @foreach (var role in _availableRoles)
                            {
                                <option value="@role.RoleKey">@role.DisplayName</option>
                            }
                        </select>
                    </div>
                }

                @if (_board.EffectiveRole != RoleTemplates.PlatformAdmin)
                {
                    <select class="scope-select" value="@_selectedBranchId" @onchange="OnBranchChanged">
                        <option value="">All Branches</option>
                        @foreach (var br in _branches)
                        {
                            <option value="@br.Id">@br.Name</option>
                        }
                    </select>
                }

                <a href="/attendance" class="btn secondary">Attendance Desk</a>
                <a href="/daily-care" class="btn primary">+ Record Daily Care</a>
            </RightContent>
        </PageHero>

        <!-- PULSE METRICS STRIP -->
        <div class="pulse-metrics-container">
            <div class="pulse-card main-summary">
                <div class="pulse-tag">✦ LIVE DAYCARE STATUS</div>
                <div class="pulse-headline">
                    @(_board.CheckedInChildrenCount > 0 ? $"{_board.CheckedInChildrenCount} children on site" : "Ready for today's arrivals")
                </div>
                <div class="pulse-sub">
                    <span><strong>@_board.ExpectedChildrenCount</strong> expected</span>
                    <span class="dot">•</span>
                    <span><strong>@_board.TotalClassroomsCount</strong> active classrooms</span>
                    <span class="dot">•</span>
                    <span><strong>@_board.PlannedExperiencesCount</strong> experiences today</span>
                </div>
            </div>

            <div class="pulse-card">
                <div class="stat-label">Children Here</div>
                <div class="stat-number highlight-accent">@_board.CheckedInChildrenCount</div>
                <div class="stat-note">
                    @(_board.ExpectedNotArrivedCount > 0 ? $"{_board.ExpectedNotArrivedCount} not yet arrived" : "All expected checked in")
                </div>
            </div>

            <div class="pulse-card">
                <div class="stat-label">Staff On Site</div>
                <div class="stat-number @(_board.UnderstaffedClassroomsCount > 0 ? "highlight-warning" : "")">
                    @_board.PresentStaffCount
                </div>
                <div class="stat-note">
                    @(_board.UnderstaffedClassroomsCount > 0 ? $"⚠️ {_board.UnderstaffedClassroomsCount} room coverage alert" : "All classrooms covered")
                </div>
            </div>

            <div class="pulse-card">
                <div class="stat-label">Care Records</div>
                <div class="stat-number @(_board.MissingCareRecordsCount > 0 ? "highlight-attention" : "")">
                    @(_board.CheckedInChildrenCount - _board.MissingCareRecordsCount) / @_board.CheckedInChildrenCount
                </div>
                <div class="stat-note">
                    @(_board.MissingCareRecordsCount > 0 ? $"{_board.MissingCareRecordsCount} children missing records" : "All records up to date")
                </div>
            </div>

            @if (_board.HasFinanceAccess)
            {
                <div class="pulse-card">
                    <div class="stat-label">Outstanding Dues</div>
                    <div class="stat-number @(_board.OverdueInvoicesCount > 0 ? "highlight-danger" : "")">
                        ₹@(_board.OutstandingReceivables.ToString("N0"))
                    </div>
                    <div class="stat-note">
                        @(_board.OverdueInvoicesCount > 0 ? $"{_board.OverdueInvoicesCount} overdue invoices" : "Billing healthy")
                    </div>
                </div>
            }
        </div>

        <!-- ACTIONABLE OPERATIONAL ALERTS (Only shown when there are exceptions) -->
        @if (_board.Alerts.Any())
        {
            <div class="alerts-section">
                <div class="alerts-header">
                    <h3>Operational Alerts Requiring Action</h3>
                    <span class="alerts-badge">@_board.Alerts.Count Actionable</span>
                </div>
                <div class="alerts-grid">
                    @foreach (var alert in _board.Alerts)
                    {
                        <div class="op-alert-card severity-@alert.Severity.ToLower()">
                            <div class="alert-icon-box">
                                @if (alert.AlertType == "Capacity") { <span>⚠️</span> }
                                else if (alert.AlertType == "Staffing") { <span>👥</span> }
                                else if (alert.AlertType == "CareRecord") { <span>📝</span> }
                                else if (alert.AlertType == "Pickup") { <span>⏰</span> }
                                else if (alert.AlertType == "Finance") { <span>💳</span> }
                                else { <span>ℹ️</span> }
                            </div>
                            <div class="alert-body">
                                <div class="alert-title-row">
                                    <strong class="alert-title">@alert.Title</strong>
                                    <span class="alert-time">@alert.SourceContext</span>
                                </div>
                                <p class="alert-desc">@alert.Description</p>
                            </div>
                            <a href="@alert.ActionUrl" class="btn secondary alert-action-btn">
                                @alert.ActionText &rarr;
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- MAIN TWO-COLUMN DASHBOARD GRID -->
        <div class="board-grid">
            <!-- LEFT COLUMN: CLASSROOM LIVE OCCUPANCY & RATIOS -->
            <div class="grid-left">
                <div class="board-section-card">
                    <div class="section-title-row">
                        <div>
                            <h2>Classroom Live Occupancy &amp; Coverage</h2>
                            <p class="section-sub">Real-time attendance vs. licensed capacity and active learning sessions</p>
                        </div>
                        <a href="/classrooms" class="section-link">All Classrooms &rarr;</a>
                    </div>

                    <div class="classrooms-table-wrap">
                        <table class="board-table">
                            <thead>
                                <tr>
                                    <th>Classroom</th>
                                    <th>Branch</th>
                                    <th>Children Here</th>
                                    <th>Occupancy</th>
                                    <th>Staff Ratio</th>
                                    <th>Current Activity</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var room in _board.Classrooms)
                                {
                                    <tr class="@(room.IsOverCapacity ? "row-danger" : (room.IsUnderstaffed ? "row-warning" : ""))">
                                        <td>
                                            <div class="room-name-cell">
                                                <div class="status-indicator @(room.IsOverCapacity ? "dot-danger" : (room.IsUnderstaffed ? "dot-warning" : "dot-ok"))"></div>
                                                <div>
                                                    <strong>@room.ClassroomName</strong>
                                                    <span class="sub-label">@room.AgeGroup</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@room.BranchName</td>
                                        <td>
                                            <strong>@room.PresentChildren</strong> / @room.Capacity
                                        </td>
                                        <td>
                                            <div class="occupancy-bar-container">
                                                <div class="occupancy-bar" style="width: @Math.Min(100, room.OccupancyPercentage)%; background: @(room.IsOverCapacity ? "#c53030" : "var(--accent)");"></div>
                                            </div>
                                            <span class="occupancy-txt">@room.OccupancyPercentage%</span>
                                        </td>
                                        <td>
                                            <span class="ratio-pill @(room.IsUnderstaffed ? "ratio-short" : "ratio-ok")">
                                                @room.PresentStaff : @room.RequiredStaff req
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(room.ActiveExperienceTitle))
                                            {
                                                <span class="activity-pill">
                                                    🎨 @room.ActiveExperienceTitle
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="activity-none">Free Play / Transition</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="/attendance" class="view-link">Open &rarr;</a>
                                        </td>
                                    </tr>
                                }
                                @if (!_board.Classrooms.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="empty-cell">No classrooms match the active scope.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TEACHER CARE TASK BOARD (When viewing as Teacher or Classroom scope) -->
                @if (_board.EffectiveRole == RoleTemplates.ClassroomTeacher || _board.SelectedClassroomId.HasValue)
                {
                    <div class="board-section-card">
                        <div class="section-title-row">
                            <div>
                                <h2>Classroom Care Tracker</h2>
                                <p class="section-sub">Immediate care tasks for children currently in your room</p>
                            </div>
                            <a href="/daily-care" class="section-link">Daily Care Log &rarr;</a>
                        </div>

                        <div class="teacher-care-list">
                            @foreach (var child in _board.TeacherChildrenCareStatus)
                            {
                                <div class="care-child-row @(child.NeedsAttention ? "care-needs-attention" : "")">
                                    <div class="child-avatar">
                                        @child.FullName.FirstOrDefault()
                                    </div>
                                    <div class="child-info">
                                        <strong>@child.FullName</strong>
                                        <span class="care-sub">
                                            Arrival: @(child.ArrivalTime?.ToString(@"hh\:mm") ?? "Present") • 
                                            Last: @child.LastRecordedCareType
                                        </span>
                                    </div>
                                    <div class="care-status-pill">
                                        @if (child.NeedsAttention)
                                        {
                                            <span class="pill-warning">⚠️ No Care Logged</span>
                                        }
                                        else
                                        {
                                            <span class="pill-ok">✓ @child.CareEventsCount logged</span>
                                        }
                                    </div>
                                    <a href="/daily-care" class="btn secondary care-action-btn">+ Log Event</a>
                                </div>
                            }
                            @if (!_board.TeacherChildrenCareStatus.Any())
                            {
                                <div class="empty-hint">No children currently checked into this room.</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN: TODAY'S RHYTHM, READINESS & QUICK ACTIONS -->
            <div class="grid-right">
                <!-- READINESS & OPENING CHECKLIST -->
                <div class="board-section-card">
                    <div class="section-title-row">
                        <div>
                            <h2>Classroom Readiness</h2>
                            <p class="section-sub">Standard opening and safety verifications</p>
                        </div>
                    </div>

                    <div class="readiness-list">
                        @foreach (var item in _board.ReadinessChecklist)
                        {
                            <div class="readiness-item @(item.IsCompleted ? "completed" : "pending")">
                                <div class="check-box @(item.IsCompleted ? "checked" : "")">
                                    @(item.IsCompleted ? "✓" : "○")
                                </div>
                                <div class="readiness-text">
                                    <strong>@item.Label</strong>
                                    <p>@item.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- TODAY'S RHYTHM & EXPERIENCES -->
                <div class="board-section-card">
                    <div class="section-title-row">
                        <div>
                            <h2>Today's Rhythm</h2>
                            <p class="section-sub">Scheduled experiences and celebrations</p>
                        </div>
                        <a href="/rhythm-history" class="section-link">History &rarr;</a>
                    </div>

                    <div class="rhythm-timeline">
                        @foreach (var item in _board.TodayRhythm)
                        {
                            <div class="rhythm-item @(item.IsCelebration ? "is-celebration" : "")">
                                <div class="rhythm-dot @(item.Status == "Completed" ? "dot-completed" : (item.Status == "InProgress" ? "dot-active" : ""))"></div>
                                <div class="rhythm-body">
                                    <div class="rhythm-time">@item.TimeDisplay</div>
                                    <div class="rhythm-title">
                                        @if (item.IsCelebration) { <span>🎉 </span> }
                                        <strong>@item.Title</strong>
                                        <span class="rhythm-scope">@item.ScopeDisplay</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.PreparationNotes))
                                    {
                                        <div class="rhythm-notes">@item.PreparationNotes</div>
                                    }
                                    <div class="rhythm-actions">
                                        <span class="status-pill status-@item.Status.ToLower()">@item.Status</span>
                                        @if (!item.IsCelebration)
                                        {
                                            @if (item.Status == "Scheduled" || item.Status == "Planned" || item.Status == "Confirmed")
                                            {
                                                <button class="btn primary btn-sm" @onclick="() => StartSession(item.Id)">Start</button>
                                            }
                                            else if (item.Status == "Started" || item.Status == "Active")
                                            {
                                                <button class="btn secondary btn-sm" @onclick="() => OpenActiveSession(item.Id)">Active Session</button>
                                            }
                                        }
                                        else
                                        {
                                            @if (item.Status == "Planned" || item.Status == "Approved" || item.Status == "Published")
                                            {
                                                <button class="btn primary btn-sm" @onclick="() => StartCelebration(item.Id)">▶️ Start</button>
                                            }
                                            else if (item.Status == "InProgress")
                                            {
                                                <button class="btn secondary btn-sm" @onclick="() => FinishCelebration(item.Id)">🏁 Finish</button>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <button class="btn secondary btn-sm" @onclick="() => OpenEventPhotoModal(item.Id)">📸 Photos</button>
                                            }
                                            <a href="/events/@item.Id" class="view-link">View &rarr;</a>
                                        }
                                    </div>
                                    @if (item.PhotoUrls != null && item.PhotoUrls.Length > 0)
                                    {
                                        <div class="photo-strip">
                                            @foreach (var photo in item.PhotoUrls)
                                            {
                                                <img src="@photo" alt="Photo" class="thumb-img" @onclick="() => _previewPhoto = photo" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (!_board.TodayRhythm.Any())
                        {
                            <div class="empty-hint">No planned experiences or celebrations scheduled today.</div>
                        }
                    </div>
                </div>

                <!-- QUICK DAYCARE ACTIONS -->
                <div class="board-section-card">
                    <div class="section-title-row">
                        <h2>Quick Actions</h2>
                    </div>
                    <div class="quick-links-grid">
                        <a href="/studio" class="quick-link-box">
                            <span class="quick-icon">✦</span>
                            <div>
                                <strong>Experience Studio</strong>
                                <small>Draft and plan learning</small>
                            </div>
                        </a>
                        <a href="/planning" class="quick-link-box">
                            <span class="quick-icon">📅</span>
                            <div>
                                <strong>Experience Calendar</strong>
                                <small>View month rhythm</small>
                            </div>
                        </a>
                        <a href="/attendance" class="quick-link-box">
                            <span class="quick-icon">📋</span>
                            <div>
                                <strong>Attendance Desk</strong>
                                <small>Check in / departure</small>
                            </div>
                        </a>
                        <a href="/daily-care" class="quick-link-box">
                            <span class="quick-icon">🍼</span>
                            <div>
                                <strong>Daily Care Logs</strong>
                                <small>Meals, naps &amp; wellbeing</small>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* PHOTO LIGHTBOX PREVIEW *@
@if (!string.IsNullOrEmpty(_previewPhoto))
{
    <div class="photo-lightbox" @onclick="() => _previewPhoto = null">
        <div class="lightbox-content" @onclick:stopPropagation>
            <button class="lightbox-close" @onclick="() => _previewPhoto = null">✕</button>
            <img src="@_previewPhoto" alt="Preview" class="lightbox-img" />
        </div>
    </div>
}

@* ACTIVE SESSION MODAL *@
@if (_isSessionModalOpen)
{
    <ActiveSessionModal ScheduleId="@_activeSessionScheduleId"
                        OnSessionEnded="OnSessionEnded"
                        OnClose="() => _isSessionModalOpen = false" />
}

@* EVENT PHOTO MODAL *@
@if (_isPhotoModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <div>
                    <h3>📸 Celebration Photos</h3>
                    <p>@_photoModalEventTitle</p>
                </div>
                <button type="button" class="close-btn" @onclick="() => _isPhotoModalOpen = false">✕</button>
            </div>
            <EventPhotoUploader Photos="@_photoModalEventPhotos"
                                PhotosChanged="OnEventPhotosSaved"
                                MaxPhotos="3"
                                ReadOnly="false"
                                IsCompleted="true" />
            <div class="modal-footer">
                <button type="button" class="btn primary" @onclick="() => _isPhotoModalOpen = false">Done</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private OperationsBoardModel _board = new();
    private List<Branch> _branches = new();
    private string _selectedRoleOverride = "";
    private string _selectedBranchId = "";
    private string? _previewPhoto;

    private List<RoleOption> _availableRoles = new();

    public record RoleOption(string RoleKey, string DisplayName, int Rank);

    // Modals
    private bool _isSessionModalOpen = false;
    private Guid _activeSessionScheduleId;
    private bool _isPhotoModalOpen = false;
    private Guid _photoModalEventId;
    private string _photoModalEventTitle = "";
    private string[] _photoModalEventPhotos = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        InitializeAvailableRoles();
        await LoadBranchesAsync();
        await RefreshBoardAsync();
    }

    private void InitializeAvailableRoles()
    {
        _availableRoles = ResolveAvailableRoles();
        var highestRole = _availableRoles.FirstOrDefault()?.RoleKey;
        if (!string.IsNullOrEmpty(highestRole) && string.IsNullOrEmpty(_selectedRoleOverride))
        {
            _selectedRoleOverride = highestRole;
        }
    }

    private List<RoleOption> ResolveAvailableRoles()
    {
        var options = new List<RoleOption>();
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();

        bool isPlatformAdmin = userRoles.Any(r => 
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) || 
            r.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase));

        bool isOrgAdmin = isPlatformAdmin || userRoles.Any(r => 
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Daycare Admin", StringComparison.OrdinalIgnoreCase));

        bool isBranchAdmin = isPlatformAdmin || userRoles.Any(r => 
            r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        bool isTeacher = isPlatformAdmin || userRoles.Any(r => 
            r.Equals(RoleTemplates.DaycareTeacher, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.ClassroomTeacher, StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Teacher", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("LeadTeacher", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("AssistantTeacher", StringComparison.OrdinalIgnoreCase));

        // 1. Platform Admin (Rank 1: only users holding PlatformAdmin role)
        if (isPlatformAdmin)
        {
            options.Add(new RoleOption(RoleTemplates.PlatformAdmin, "Platform Admin", 1));
        }

        // 2. Org Admin (Rank 2: Organization Owner or Administrator)
        if (isOrgAdmin)
        {
            options.Add(new RoleOption(RoleTemplates.OrganizationAdmin, "Org Admin", 2));
        }

        // 3. Branch Manager (Rank 3: Branch Director or higher administrative supervisor)
        if (isBranchAdmin || isOrgAdmin)
        {
            options.Add(new RoleOption(RoleTemplates.BranchAdmin, "Branch Manager", 3));
        }

        // 4. Teacher (Rank 4: Classroom Educator or supervisory director)
        if (isTeacher || isOrgAdmin || isBranchAdmin)
        {
            options.Add(new RoleOption(RoleTemplates.ClassroomTeacher, "Teacher", 4));
        }

        // Safe fallback if unassigned
        if (!options.Any())
        {
            options.Add(new RoleOption(RoleTemplates.ClassroomTeacher, "Teacher", 4));
        }

        return options.OrderBy(o => o.Rank).ToList();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var orgId = UserContext.OrganizationId ?? Guid.Empty;
            if (orgId != Guid.Empty)
            {
                _branches = (await BranchService.GetBranchesAsync(orgId)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task RefreshBoardAsync()
    {
        _loading = true;
        try
        {
            Guid? branchId = Guid.TryParse(_selectedBranchId, out var bId) ? bId : null;
            var filter = new OperationsBoardFilter
            {
                OrganizationId = UserContext.OrganizationId,
                BranchId = branchId,
                RoleOverride = string.IsNullOrWhiteSpace(_selectedRoleOverride) ? null : _selectedRoleOverride,
                Date = DateTime.Today
            };

            _board = await OperationsBoardService.GetOperationsBoardAsync(filter);
            if (string.IsNullOrEmpty(_selectedRoleOverride))
            {
                _selectedRoleOverride = _board.EffectiveRole;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading operations board: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        _selectedRoleOverride = e.Value?.ToString() ?? "";
        await RefreshBoardAsync();
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        _selectedBranchId = e.Value?.ToString() ?? "";
        await RefreshBoardAsync();
    }

    private async Task StartSession(Guid scheduleId)
    {
        try
        {
            var teacherId = UserContext.UserId != Guid.Empty ? UserContext.UserId : Guid.Parse("50000000-0000-0000-0000-000000000001");
            await ExecutionService.StartExperienceAsync(scheduleId, teacherId);
            await RefreshBoardAsync();
            OpenActiveSession(scheduleId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting session: {ex.Message}");
        }
    }

    private void OpenActiveSession(Guid scheduleId)
    {
        _activeSessionScheduleId = scheduleId;
        _isSessionModalOpen = true;
    }

    private async Task OnSessionEnded()
    {
        _isSessionModalOpen = false;
        await RefreshBoardAsync();
    }

    private async Task StartCelebration(Guid eventId)
    {
        try
        {
            await EventService.UpdateStatusAsync(eventId, "InProgress");
            await RefreshBoardAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting celebration: {ex.Message}");
        }
    }

    private async Task FinishCelebration(Guid eventId)
    {
        try
        {
            await EventService.UpdateStatusAsync(eventId, "Completed");
            await RefreshBoardAsync();
            await OpenEventPhotoModal(eventId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finishing celebration: {ex.Message}");
        }
    }

    private async Task OpenEventPhotoModal(Guid eventId)
    {
        var ev = await EventService.GetEventByIdAsync(eventId);
        if (ev != null)
        {
            _photoModalEventId = ev.Id;
            _photoModalEventTitle = ev.Title;
            _photoModalEventPhotos = ev.PhotoUrls ?? Array.Empty<string>();
            _isPhotoModalOpen = true;
            StateHasChanged();
        }
    }

    private async Task OnEventPhotosSaved(string[] newPhotos)
    {
        _photoModalEventPhotos = newPhotos;
        await EventService.UpdateEventPhotosAsync(_photoModalEventId, newPhotos);
        await RefreshBoardAsync();
    }
}
