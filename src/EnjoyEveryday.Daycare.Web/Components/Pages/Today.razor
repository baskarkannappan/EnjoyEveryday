@page "/"
@page "/today"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ActiveSessionModal
@using EnjoyEveryday.UI.Shared.Components.Attendance
@using EnjoyEveryday.UI.Shared.Components.OperationsBoard
@inject IDaycareOperationsBoardService OperationsBoardService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject ExecutionService ExecutionService
@inject EventService EventService
@inject PlannerService PlannerService
@inject EnjoyEveryday.Domain.Repositories.IExperienceSessionRepository SessionRepository
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@rendermode InteractiveServer

<PageTitle>Live Daycare Operations — Teacher Portal — EnjoyEveryday</PageTitle>

<div class="content operations-board-page">
    @if (_loading)
    {
        <LoadingState Text="Loading live daycare operations board..." />
    }
    else
    {
        <!-- PAGE HERO -->
        <PageHero Eyebrow="LIVE OPERATIONS BOARD"
                  Title="@($"Daycare Operations — {_board.OrganizationName}")"
                  Subtitle="@($"Real-time operational cockpit for {_board.EffectiveRole}: attendance, staffing coverage, live experiences, and actionable care alerts.")">
            <RightContent>
                <OperationsBoardHeroControls 
                    EffectiveRole="@_board.EffectiveRole"
                    SelectedRoleOverride="@_selectedRoleOverride"
                    SelectedBranchId="@_selectedBranchId"
                    AvailableRoles="@_availableRoles"
                    Branches="@_branches"
                    OnRoleChanged="HandleRoleChanged"
                    OnBranchChanged="HandleBranchChanged"
                    OnOpenEndOfDay="() => _isEndOfDayModalOpen = true" />
            </RightContent>
        </PageHero>

        <!-- PULSE METRICS STRIP -->
        <OperationsPulseMetricsStrip Board="@_board" />

        <!-- ACTIONABLE OPERATIONAL ALERTS (Only shown when there are exceptions) -->
        <OperationsAlertsSection Alerts="@_board.Alerts" />

        <!-- MAIN TWO-COLUMN DASHBOARD GRID -->
        <div class="board-grid">
            <!-- LEFT COLUMN: CLASSROOM LIVE OCCUPANCY & RATIOS -->
            <div class="grid-left">
                <OperationsClassroomOccupancyTable Classrooms="@_board.Classrooms" />

                <!-- TEACHER CARE TASK BOARD (When viewing as Teacher or Classroom scope) -->
                @if (_board.EffectiveRole == RoleTemplates.ClassroomTeacher || _board.SelectedClassroomId.HasValue)
                {
                    <OperationsClassroomCareTracker ChildrenCareStatus="@_board.TeacherChildrenCareStatus" />
                }
            </div>

            <!-- RIGHT COLUMN: TODAY'S RHYTHM, READINESS & QUICK ACTIONS -->
            <div class="grid-right">
                <!-- READINESS & OPENING CHECKLIST -->
                <OperationsClassroomReadinessCard Checklist="@_board.ReadinessChecklist" />

                <!-- TODAY'S RHYTHM & EXPERIENCES -->
                <OperationsTodayRhythmTimeline 
                    Items="@_board.TodayRhythm"
                    OnStartSession="StartSession"
                    OnOpenActiveSession="OpenActiveSession"
                    OnCloseSession="CloseSession"
                    OnCancelSession="CancelSession"
                    OnOpenSessionPhotoModal="OpenSessionPhotoModal"
                    OnStartCelebration="StartCelebration"
                    OnFinishCelebration="FinishCelebration"
                    OnOpenEventPhotoModal="OpenEventPhotoModal"
                    OnPreviewPhoto="photo => _previewPhoto = photo" />

                <!-- QUICK DAYCARE ACTIONS -->
                <OperationsQuickActionsCard />
            </div>
        </div>
    }
</div>

@* PHOTO LIGHTBOX PREVIEW *@
<PhotoLightboxModal PhotoUrl="@_previewPhoto" OnClose="() => _previewPhoto = null" />

@* ACTIVE SESSION MODAL *@
@if (_isSessionModalOpen)
{
    <ActiveSessionModal ScheduleId="@_activeSessionScheduleId"
                        OnSessionEnded="OnSessionEnded"
                        OnClose="() => _isSessionModalOpen = false" />
}

@* EVENT PHOTO MODAL *@
<EventPhotoModal 
    IsOpen="_isPhotoModalOpen"
    Title="@_photoModalEventTitle"
    Photos="@_photoModalEventPhotos"
    MaxPhotos="3"
    PhotosChanged="OnEventPhotosSaved"
    OnClose="() => _isPhotoModalOpen = false" />

@* SESSION PHOTO MODAL *@
<SessionPhotoModal 
    IsOpen="_isSessionPhotoModalOpen"
    ScheduleId="@_sessionPhotoScheduleId"
    Title="@_sessionPhotoTitle"
    Photos="@_sessionPhotoUrls"
    MaxPhotos="5"
    PhotosChanged="OnSessionPhotosSaved"
    OnOpenFullSession="OpenActiveSession"
    OnClose="() => _isSessionPhotoModalOpen = false" />

@* END OF DAY PROCESS MODAL *@
<EndOfDayProcessModal 
    IsOpen="_isEndOfDayModalOpen"
    BranchId="@(Guid.TryParse(_selectedBranchId, out var bId) ? bId : null)"
    Date="DateTime.Today"
    OnClose="() => _isEndOfDayModalOpen = false"
    OnCompleted="HandleEndOfDayCompleted" />

@code {
    private bool _loading = true;
    private OperationsBoardModel _board = new();
    private List<Branch> _branches = new();
    private string _selectedRoleOverride = "";
    private string _selectedBranchId = "";
    private string? _previewPhoto;

    private List<OperationsBoardHeroControls.RoleOptionModel> _availableRoles = new();

    // Modals
    private bool _isEndOfDayModalOpen = false;
    private bool _isSessionModalOpen = false;
    private Guid _activeSessionScheduleId;
    private bool _isPhotoModalOpen = false;
    private Guid _photoModalEventId;
    private string _photoModalEventTitle = "";
    private string[] _photoModalEventPhotos = Array.Empty<string>();

    private bool _isSessionPhotoModalOpen = false;
    private Guid _sessionPhotoScheduleId;
    private string _sessionPhotoTitle = "";
    private string[] _sessionPhotoUrls = Array.Empty<string>();
    private static readonly Dictionary<Guid, string[]> _sessionPhotoStore = new();

    protected override async Task OnInitializedAsync()
    {
        InitializeAvailableRoles();
        await LoadBranchesAsync();
        await RefreshBoardAsync();
    }

    private void InitializeAvailableRoles()
    {
        _availableRoles = ResolveAvailableRoles();
        var highestRole = _availableRoles.FirstOrDefault()?.RoleKey;
        if (!string.IsNullOrEmpty(highestRole) && string.IsNullOrEmpty(_selectedRoleOverride))
        {
            _selectedRoleOverride = highestRole;
        }
    }

    private List<OperationsBoardHeroControls.RoleOptionModel> ResolveAvailableRoles()
    {
        var options = new List<OperationsBoardHeroControls.RoleOptionModel>();
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();

        bool isPlatformAdmin = userRoles.Any(r => 
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) || 
            r.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase));

        bool isOrgAdmin = isPlatformAdmin || userRoles.Any(r => 
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Daycare Admin", StringComparison.OrdinalIgnoreCase));

        bool isBranchAdmin = isPlatformAdmin || userRoles.Any(r => 
            r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        bool isTeacher = isPlatformAdmin || userRoles.Any(r => 
            r.Equals(RoleTemplates.DaycareTeacher, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.ClassroomTeacher, StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Teacher", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("LeadTeacher", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("AssistantTeacher", StringComparison.OrdinalIgnoreCase));

        // 1. Platform Admin (Rank 1: only users holding PlatformAdmin role)
        if (isPlatformAdmin)
        {
            options.Add(new OperationsBoardHeroControls.RoleOptionModel(RoleTemplates.PlatformAdmin, "Platform Admin", 1));
        }

        // 2. Org Admin (Rank 2: Organization Owner or Administrator)
        if (isOrgAdmin)
        {
            options.Add(new OperationsBoardHeroControls.RoleOptionModel(RoleTemplates.OrganizationAdmin, "Org Admin", 2));
        }

        // 3. Branch Manager (Rank 3: Branch Director or higher administrative supervisor)
        if (isBranchAdmin || isOrgAdmin)
        {
            options.Add(new OperationsBoardHeroControls.RoleOptionModel(RoleTemplates.BranchAdmin, "Branch Manager", 3));
        }

        // 4. Teacher (Rank 4: Classroom Educator or supervisory director)
        if (isTeacher || isOrgAdmin || isBranchAdmin)
        {
            options.Add(new OperationsBoardHeroControls.RoleOptionModel(RoleTemplates.ClassroomTeacher, "Teacher", 4));
        }

        // Safe fallback if unassigned
        if (!options.Any())
        {
            options.Add(new OperationsBoardHeroControls.RoleOptionModel(RoleTemplates.ClassroomTeacher, "Teacher", 4));
        }

        return options.OrderBy(o => o.Rank).ToList();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var orgId = UserContext.OrganizationId ?? Guid.Empty;
            if (orgId != Guid.Empty)
            {
                _branches = (await BranchService.GetBranchesAsync(orgId)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task RefreshBoardAsync()
    {
        _loading = true;
        try
        {
            Guid? branchId = Guid.TryParse(_selectedBranchId, out var bId) ? bId : null;
            var filter = new OperationsBoardFilter
            {
                OrganizationId = UserContext.OrganizationId,
                BranchId = branchId,
                RoleOverride = string.IsNullOrWhiteSpace(_selectedRoleOverride) ? null : _selectedRoleOverride,
                Date = DateTime.Today
            };

            _board = await OperationsBoardService.GetOperationsBoardAsync(filter);
            if (_board.TodayRhythm != null)
            {
                foreach (var r in _board.TodayRhythm)
                {
                    if (_sessionPhotoStore.TryGetValue(r.Id, out var photos) && photos.Length > 0)
                    {
                        r.PhotoUrls = photos;
                    }
                }
            }

            if (string.IsNullOrEmpty(_selectedRoleOverride))
            {
                _selectedRoleOverride = _board.EffectiveRole;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading operations board: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleEndOfDayCompleted(EndOfDayProcessReport report)
    {
        await RefreshBoardAsync();
        await NotificationService.ShowSuccessAsync($"Day successfully closed! Autoclosed {report.TeachersCheckedOutCount} educators, {report.ChildrenCheckedOutCount} children, and {report.ActivitiesClosedCount + report.EventsClosedCount} activities/events.");
    }

    private async Task HandleRoleChanged(string role)
    {
        _selectedRoleOverride = role;
        await RefreshBoardAsync();
    }

    private async Task HandleBranchChanged(string branchId)
    {
        _selectedBranchId = branchId;
        await RefreshBoardAsync();
    }

    private async Task StartSession(Guid scheduleId)
    {
        try
        {
            var teacherId = UserContext.UserId != Guid.Empty ? UserContext.UserId : Guid.Parse("50000000-0000-0000-0000-000000000001");
            await ExecutionService.StartExperienceAsync(scheduleId, teacherId);
            await RefreshBoardAsync();
            OpenActiveSession(scheduleId);
        }
        catch (Exception ex)
        {
            await NotificationService.HandleExceptionAsync(ex);
        }
    }

    private async Task CloseSession(Guid scheduleId)
    {
        try
        {
            var teacherId = UserContext.UserId != Guid.Empty ? UserContext.UserId : Guid.Parse("50000000-0000-0000-0000-000000000001");
            await ExecutionService.CompleteExperienceAsync(scheduleId, teacherId, 5, "Completed", "Closed from Operations Board");
            await RefreshBoardAsync();
            await NotificationService.ShowSuccessAsync("Experience session completed and closed.");
        }
        catch (Exception ex)
        {
            await NotificationService.HandleExceptionAsync(ex);
        }
    }

    private async Task CancelSession(Guid scheduleId)
    {
        try
        {
            await PlannerService.CancelScheduleAsync(scheduleId);

            var session = await SessionRepository.GetSessionByScheduleIdAsync(scheduleId);
            if (session != null)
            {
                session.Status = "Cancelled";
                session.EndTime = DateTime.UtcNow.TimeOfDay;
                await SessionRepository.UpdateSessionAsync(session);
            }

            await RefreshBoardAsync();
            await NotificationService.ShowSuccessAsync("Experience session cancelled.");
        }
        catch (Exception ex)
        {
            await NotificationService.HandleExceptionAsync(ex);
        }
    }

    private void OpenSessionPhotoModal(RhythmScheduleItem item)
    {
        _sessionPhotoScheduleId = item.Id;
        _sessionPhotoTitle = item.Title;
        if (!_sessionPhotoStore.TryGetValue(item.Id, out var photos))
        {
            photos = item.PhotoUrls ?? Array.Empty<string>();
        }
        _sessionPhotoUrls = photos;
        _isSessionPhotoModalOpen = true;
    }

    private async Task OnSessionPhotosSaved(string[] newPhotos)
    {
        _sessionPhotoUrls = newPhotos;
        _sessionPhotoStore[_sessionPhotoScheduleId] = newPhotos;

        var target = _board.TodayRhythm.FirstOrDefault(r => r.Id == _sessionPhotoScheduleId);
        if (target != null)
        {
            target.PhotoUrls = newPhotos;
        }

        await NotificationService.ShowSuccessAsync("Session photos saved.");
        StateHasChanged();
    }

    private void OpenActiveSession(Guid scheduleId)
    {
        _activeSessionScheduleId = scheduleId;
        _isSessionModalOpen = true;
    }

    private async Task OnSessionEnded()
    {
        _isSessionModalOpen = false;
        await RefreshBoardAsync();
    }

    private async Task StartCelebration(Guid eventId)
    {
        try
        {
            await EventService.UpdateStatusAsync(eventId, "InProgress");
            await RefreshBoardAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting celebration: {ex.Message}");
        }
    }

    private async Task FinishCelebration(Guid eventId)
    {
        try
        {
            await EventService.UpdateStatusAsync(eventId, "Completed");
            await RefreshBoardAsync();
            await OpenEventPhotoModal(eventId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finishing celebration: {ex.Message}");
        }
    }

    private async Task OpenEventPhotoModal(Guid eventId)
    {
        var ev = await EventService.GetEventByIdAsync(eventId);
        if (ev != null)
        {
            _photoModalEventId = ev.Id;
            _photoModalEventTitle = ev.Title;
            _photoModalEventPhotos = ev.PhotoUrls ?? Array.Empty<string>();
            _isPhotoModalOpen = true;
            StateHasChanged();
        }
    }

    private async Task OnEventPhotosSaved(string[] newPhotos)
    {
        _photoModalEventPhotos = newPhotos;
        await EventService.UpdateEventPhotosAsync(_photoModalEventId, newPhotos);
        await RefreshBoardAsync();
    }
}
