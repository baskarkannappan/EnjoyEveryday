                        <div class="section-header">
                            <h2>Today's rhythm</h2>
                            <span>Across Little Stars</span>
                        </div>

                        <div class="timeline">

                            @foreach(var sched in _todaySchedules)
                            {
                                var expTitle = _experiences.FirstOrDefault(e => e.Id == sched.ExperienceId)?.Title ?? "Unknown Experience";
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-time">
                                        @(sched.PlannedStartTime.HasValue ? DateTime.Today.Add(sched.PlannedStartTime.Value).ToString("t") : sched.TimeOfDay)
                                    </div>
                                    <div class="timeline-title">
                                        @expTitle
                                    </div>
                                    <div class="timeline-sub">
                                        Status: @sched.Status
                                        @if(sched.Status == "Scheduled" || sched.Status == "Planned" || sched.Status == "Confirmed")
                                        {
                                            <button class="btn btn-sm btn-primary ml-3" @onclick="() => StartSession(sched.Id)" style="margin-left: 10px; padding: 2px 8px; border-radius: 4px; background-color: #263d32; color: white; border: none; cursor: pointer;">Start</button>
                                        }
                                        else if (sched.Status == "Started" || sched.Status == "Active")
                                        {
                                            <button class="btn btn-sm btn-outline-success ml-3" @onclick="() => OpenActiveSession(sched.Id)" style="margin-left: 10px; padding: 2px 8px; border-radius: 4px; border: 1px solid #263d32; color: #263d32; background: transparent; cursor: pointer;">View Active Session</button>
                                        }
                                    </div>
                                </div>
                            }


