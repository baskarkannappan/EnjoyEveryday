        OnPlanCreated="ReloadEventsAsync" />

@inject EnjoyEveryday.Shared.Data.IDbConnectionFactory DbConnectionFactory
@using Dapper
@inject NavigationManager NavigationManager

@code {
    private bool _isRecommendationModalOpen = false;
    private List<ExperienceSchedule> _todaySchedules = new();
    private List<Event> _todayEvents = new();
    private List<Branch> _branches = new();
    private Dictionary<Guid, HashSet<Guid>> _eventClassroomsMap = new();
    private List<RhythmTimelineItem> _rhythmTimeline = new();
    private List<Experience> _experiences = new();
    private Guid _teacherId = Guid.Parse("50000000-0000-0000-0000-000000000001"); // Mock teacher

    private int _childrenHere = 0;
    private int _expectedChildren = 0;
    private int _totalClassrooms = 0;
    private int _totalExperiences = 0;
    private int _totalTeachers = 0;
    private int _activeExperiences = 0;
    private List<Classroom> _classrooms = new();
    private string _userFirstName = "Baskar";

    public class RhythmTimelineItem
    {
        public bool IsEvent { get; set; }
        public TimeSpan? StartTime { get; set; }
        public TimeSpan? EndTime { get; set; }
        public string TimeDisplay { get; set; } = "";
        public string Title { get; set; } = "";
        public string Scope { get; set; } = "Classroom"; // Organization, Branch, Classroom
        public string ScopeDisplay { get; set; } = "";
        public string Status { get; set; } = "";
        public Guid? ClassroomId { get; set; }
        public Guid? EventId { get; set; }
        public Guid? ScheduleId { get; set; }
        public string[] PhotoUrls { get; set; } = Array.Empty<string>();
        public string? Description { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await UserService.GetUserByIdAsync(UserContext.UserId);
        if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.FirstName))
        {
            _userFirstName = currentUser.FirstName;
        }

        _experiences = (await ExperienceService.GetExperiencesAsync()).ToList();
        using var connection = await DbConnectionFactory.CreateConnectionAsync();
        var today = TimeProvider.GetLocalNow().Date;
        var tenantId = TenantContext.TenantId;
        var sql = "SELECT id, tenant_id as TenantId, experience_id as ExperienceId, classroom_id as ClassroomId, scheduled_date as ScheduledDate, time_of_day as TimeOfDay, status as Status, primary_teacher_id as PrimaryTeacherId, planned_start_time as PlannedStartTime, planned_end_time as PlannedEndTime, preparation_notes as PreparationNotes FROM experience_schedules WHERE scheduled_date = @Date AND tenant_id = @TenantId ORDER BY time_of_day";
        _todaySchedules = (await connection.QueryAsync<ExperienceSchedule>(sql, new { Date = today, TenantId = tenantId })).ToList();
        
        var statsSql = @"
            SELECT 
                (SELECT COUNT(1) FROM children WHERE tenant_id = @TenantId AND is_active = true) as ExpectedChildren,
                (SELECT COUNT(1) FROM child_attendance WHERE tenant_id = @TenantId AND attendance_date = @Date AND status = 'Present') as ChildrenHere,
                (SELECT COUNT(1) FROM classrooms WHERE tenant_id = @TenantId AND is_active = true) as TotalClassrooms,
                (SELECT COUNT(1) FROM teachers WHERE tenant_id = @TenantId AND status != 'Inactive') as TotalTeachers
        ";
        var stats = await connection.QuerySingleAsync<dynamic>(statsSql, new { Date = today, TenantId = tenantId });
        _expectedChildren = (int)stats.expectedchildren;
        _childrenHere = (int)stats.childrenhere;
        _totalClassrooms = (int)stats.totalclassrooms;
        _totalExperiences = _todaySchedules.Count;
        _activeExperiences = _todaySchedules.Count(s => s.Status == "Started" || s.Status == "Active");
        _totalTeachers = (int)stats.totalteachers;
        
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org != null) {
            _classrooms = (await ClassroomService.GetAllClassroomsAsync()).ToList();
            try {
                _branches = (await BranchService.GetBranchesAsync(org.Id)).ToList();
            } catch { }
        }

        try
        {
            _todayEvents = (await EventService.GetEventsForDateAsync(DateOnly.FromDateTime(today))).ToList();
            _eventClassroomsMap.Clear();
            foreach (var ev in _todayEvents.Where(e => e.Scope == "Classroom"))
            {
                var crIds = await EventService.GetEventClassroomsAsync(ev.Id);
                _eventClassroomsMap[ev.Id] = crIds.ToHashSet();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading today events: {ex.Message}");
        }

        BuildRhythmTimeline();
        
        var momentsSql = @"
            SELECT 
                UPPER(cl.name) || ' • ' || u.first_name as MomentName,
                cs.content as MomentText
            FROM child_stories cs
            JOIN children c ON cs.child_id = c.id
            JOIN classrooms cl ON c.classroom_id = cl.id
            JOIN users u ON cs.teacher_id = u.id
            WHERE cs.tenant_id = @TenantId
            ORDER BY cs.created_at DESC
            LIMIT 3
        ";
        try {
            _recentMemories = (await connection.QueryAsync<dynamic>(momentsSql, new { TenantId = tenantId })).ToList();
        } catch { }
    }

    private void BuildRhythmTimeline()
    {
        _rhythmTimeline.Clear();

        foreach (var sched in _todaySchedules)
        {
            var expTitle = _experiences.FirstOrDefault(e => e.Id == sched.ExperienceId)?.Title ?? "Unknown Experience";
            var cls = _classrooms.FirstOrDefault(c => c.Id == sched.ClassroomId);
            var clsName = cls?.Name ?? "Classroom";

            var timeDisp = sched.PlannedStartTime.HasValue 
                ? DateTime.Today.Add(sched.PlannedStartTime.Value).ToString("t") 
                : (!string.IsNullOrWhiteSpace(sched.TimeOfDay) ? sched.TimeOfDay : "Scheduled");

            _rhythmTimeline.Add(new RhythmTimelineItem
            {
                IsEvent = false,
                StartTime = sched.PlannedStartTime,
                TimeDisplay = timeDisp,
                Title = expTitle,
                ClassroomId = sched.ClassroomId,
                Scope = "Classroom",
                ScopeDisplay = clsName,
                Status = sched.Status,
                ScheduleId = sched.Id
            });
        }

        foreach (var ev in _todayEvents)
        {
            var timeDisp = ev.StartTime.HasValue 
                ? DateTime.Today.Add(ev.StartTime.Value).ToString("t") 
                : "All Day";

            string scopeDisplay;
            if (ev.Scope == "Organization")
            {
                scopeDisplay = "All Branches & Classrooms";
            }
            else if (ev.Scope == "Branch")
            {
                var brName = GetBranchName(ev.BranchId);
                scopeDisplay = $"{brName} (All Rooms)";
            }
            else
            {
                if (_eventClassroomsMap.TryGetValue(ev.Id, out var cIds) && cIds.Any())
                {
                    var names = _classrooms.Where(c => cIds.Contains(c.Id)).Select(c => c.Name).ToList();
                    scopeDisplay = string.Join(", ", names);
                }
                else
                {
                    scopeDisplay = "Specific Classrooms";
                }
            }

            _rhythmTimeline.Add(new RhythmTimelineItem
            {
                IsEvent = true,
                StartTime = ev.StartTime,
                EndTime = ev.EndTime,
                TimeDisplay = timeDisp,
                Title = ev.Title,
                Scope = ev.Scope,
                ScopeDisplay = scopeDisplay,
                Status = ev.Status,
                EventId = ev.Id,
                PhotoUrls = ev.PhotoUrls ?? Array.Empty<string>(),
                Description = ev.Description
            });
        }

        _rhythmTimeline = _rhythmTimeline
            .OrderBy(r => r.StartTime ?? TimeSpan.Zero)
            .ToList();
    }

    private string GetBranchName(Guid? branchId)
    {
        if (!branchId.HasValue) return "All Branches";
        var b = _branches.FirstOrDefault(br => br.Id == branchId.Value);
        return b != null ? b.Name : "Branch";
    }

    private bool DoesEventApplyToClassroom(Event evt, Classroom cr)
    {
        if (evt.Scope == "Organization" || evt.IsOrganizationWide) return true;
        if (evt.Scope == "Branch" && evt.BranchId == cr.BranchId) return true;
        if (evt.Scope == "Classroom" && _eventClassroomsMap.TryGetValue(evt.Id, out var crIds) && crIds.Contains(cr.Id)) return true;
        return false;
    }

    private bool IsEventActiveNow(Event evt)
    {
        var nowTime = TimeProvider.GetLocalNow().TimeOfDay;
        if (evt.Status == "InProgress") return true;
        if (evt.Status != "Planned" && evt.Status != "Approved" && evt.Status != "Published") return false;
        if (evt.StartTime == null) return true; // All-day event
        if (nowTime >= evt.StartTime && (evt.EndTime == null || nowTime <= evt.EndTime)) return true;
        return false;
    }

    private List<dynamic> _recentMemories = new();

    private bool _isSessionModalOpen = false;
    private Guid _activeSessionScheduleId;

    private async Task StartSession(Guid scheduleId)
    {
        var sessionId = await ExecutionService.StartExperienceAsync(scheduleId, _teacherId);
        
        // Refresh schedules
        using var connection = await DbConnectionFactory.CreateConnectionAsync();
        var today = TimeProvider.GetLocalNow().Date;
        var tenantId = TenantContext.TenantId;
        var sql = "SELECT id, tenant_id as TenantId, experience_id as ExperienceId, classroom_id as ClassroomId, scheduled_date as ScheduledDate, time_of_day as TimeOfDay, status as Status, primary_teacher_id as PrimaryTeacherId, planned_start_time as PlannedStartTime, planned_end_time as PlannedEndTime, preparation_notes as PreparationNotes FROM experience_schedules WHERE scheduled_date = @Date AND tenant_id = @TenantId ORDER BY time_of_day";
        _todaySchedules = (await connection.QueryAsync<ExperienceSchedule>(sql, new { Date = today, TenantId = tenantId })).ToList();
        
        BuildRhythmTimeline();
        StateHasChanged();
        
        OpenActiveSession(scheduleId);
    }

    private void OpenActiveSession(Guid scheduleId)
    {
        _activeSessionScheduleId = scheduleId;
        _isSessionModalOpen = true;
    }
    
    private async Task OnSessionEnded()
    {
        using var connection = await DbConnectionFactory.CreateConnectionAsync();
        var today = TimeProvider.GetLocalNow().Date;
        var sql = "SELECT id, tenant_id as TenantId, experience_id as ExperienceId, classroom_id as ClassroomId, scheduled_date as ScheduledDate, time_of_day as TimeOfDay, status as Status, primary_teacher_id as PrimaryTeacherId, planned_start_time as PlannedStartTime, planned_end_time as PlannedEndTime, preparation_notes as PreparationNotes FROM experience_schedules WHERE scheduled_date = @Date ORDER BY time_of_day";
        _todaySchedules = (await connection.QueryAsync<ExperienceSchedule>(sql, new { Date = today })).ToList();
        BuildRhythmTimeline();
        StateHasChanged();
    }

    private string? _previewPhoto;
    private bool _isPhotoModalOpen = false;
    private Guid _photoModalEventId;
    private string _photoModalEventTitle = "";
    private string[] _photoModalEventPhotos = Array.Empty<string>();

    private async Task StartCelebration(Guid eventId)
    {
        try
        {
            await EventService.UpdateStatusAsync(eventId, "InProgress");
            await ReloadEventsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting celebration: {ex.Message}");
        }
    }

    private async Task FinishCelebration(Guid eventId)
    {
        try
        {
            await EventService.UpdateStatusAsync(eventId, "Completed");
            await ReloadEventsAsync();
            await OpenEventPhotoModal(eventId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finishing celebration: {ex.Message}");
        }
    }

    private async Task OpenEventPhotoModal(Guid eventId)
    {
        var ev = await EventService.GetEventByIdAsync(eventId);
        if (ev != null)
        {
            _photoModalEventId = ev.Id;
            _photoModalEventTitle = ev.Title;
            _photoModalEventPhotos = ev.PhotoUrls ?? Array.Empty<string>();
            _isPhotoModalOpen = true;
            StateHasChanged();
        }
    }

    private async Task OnEventPhotosSaved(string[] newPhotos)
    {
        _photoModalEventPhotos = newPhotos;
        await EventService.UpdateEventPhotosAsync(_photoModalEventId, newPhotos);
        await ReloadEventsAsync();
        StateHasChanged();
    }

    private async Task ReloadEventsAsync()
    {
        var today = TimeProvider.GetLocalNow().Date;
        _todayEvents = (await EventService.GetEventsForDateAsync(DateOnly.FromDateTime(today))).ToList();
        _eventClassroomsMap.Clear();
        foreach (var ev in _todayEvents.Where(e => e.Scope == "Classroom"))
        {
            var crIds = await EventService.GetEventClassroomsAsync(ev.Id);
            _eventClassroomsMap[ev.Id] = crIds.ToHashSet();
        }
        BuildRhythmTimeline();
        StateHasChanged();
    }
}

@* EVENT PHOTO MODAL *@
@if (_isPhotoModalOpen)
{
    <div style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); display: flex; align-items: center; justify-content: center; z-index: 1200; backdrop-filter: blur(4px);">
        <div style="background: white; border-radius: 18px; padding: 24px; width: min(540px, 94%); max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 50px rgba(0,0,0,0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 750; color: #1e293b;">📸 Celebration Photos</h3>
                    <div style="font-size: 13px; color: #64748b; font-weight: 500;">@_photoModalEventTitle</div>
                </div>
                <button type="button" @onclick="() => _isPhotoModalOpen = false" style="background: none; border: none; font-size: 20px; color: #94a3b8; cursor: pointer; padding: 4px;">✕</button>
            </div>

            <EventPhotoUploader Photos="@_photoModalEventPhotos"
                                PhotosChanged="OnEventPhotosSaved"
                                MaxPhotos="3"
                                ReadOnly="false"
                                IsCompleted="true" />

            <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
                <button type="button" @onclick="() => _isPhotoModalOpen = false" style="background: #263d32; color: white; border: none; padding: 8px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">
                    Done
                </button>
            </div>
        </div>
    </div>
}

@* PHOTO LIGHTBOX PREVIEW *@
@if (!string.IsNullOrEmpty(_previewPhoto))
{
    <div style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); display: flex; align-items: center; justify-content: center; z-index: 2000; padding: 20px; backdrop-filter: blur(4px);" @onclick="() => _previewPhoto = null">
        <div style="position: relative; max-width: 90vw; max-height: 90vh; display: flex; flex-direction: column; align-items: center;" @onclick:stopPropagation>
            <button style="position: absolute; top: -38px; right: 0; background: rgba(255,255,255,0.2); border: none; color: white; font-size: 18px; width: 30px; height: 30px; border-radius: 50%; cursor: pointer;" @onclick="() => _previewPhoto = null">✕</button>
            <img src="@_previewPhoto" alt="Preview" style="max-width: 100%; max-height: 80vh; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); object-fit: contain;" />
            <div style="margin-top: 10px; color: #e2e8f0; font-size: 13px;">Optimized AVIF Photo</div>
        </div>
    </div>
}
