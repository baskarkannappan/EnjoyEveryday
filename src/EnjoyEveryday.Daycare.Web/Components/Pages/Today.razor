@page "/"
@page "/today"
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Shared.Tenancy
@using Microsoft.AspNetCore.WebUtilities

@inject IAccessScopeRepository AccessScopeRepo
@inject ITenantContext TenantContext
@inject IUserContext UserContext
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject EnjoyEveryday.Daycare.Web.Services.IUserViewPreferenceService ViewPreference
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Today — EnjoyEveryday</PageTitle>

@implements IDisposable

@if (_initializing)
{
    <LoadingState Text="Resolving your authorized workspace and classroom context..." />
}
else
{
    @if (_currentView == "LeadTeacher")
    {
        <TeacherWorkspace AssignedClassroomIds="_assignedClassroomIds"
                          IsLeadTeacher="true"
                          AvailableViews="_availableViews"
                          OnChangeView="HandleViewChanged" />
    }
    else if (_currentView == "Teacher")
    {
        <TeacherWorkspace AssignedClassroomIds="_assignedClassroomIds"
                          IsLeadTeacher="false"
                          AvailableViews="_availableViews"
                          OnChangeView="HandleViewChanged" />
    }
    else if (_currentView == "BranchAdmin")
    {
        <BranchAdminDashboard AssignedBranchIds="_assignedBranchIds"
                              AvailableViews="_availableViews"
                              OnChangeView="HandleViewChanged" />
    }
    else
    {
        <OrgAdminDashboard AvailableViews="_availableViews"
                           OnChangeView="HandleViewChanged" />
    }
}

@code {
    private bool _initializing = true;
    private string _currentView = "Teacher";
    private List<string> _availableViews = new();
    private HashSet<Guid> _assignedClassroomIds = new();
    private HashSet<Guid> _assignedBranchIds = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        ViewPreference.OnViewChanged += HandlePreferenceChanged;
        await ResolveUserScopeAndDefaultViewAsync();
    }

    private async void HandlePreferenceChanged()
    {
        if (!string.IsNullOrEmpty(ViewPreference.CurrentView) && _currentView != ViewPreference.CurrentView)
        {
            _currentView = ViewPreference.CurrentView;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResolveUserScopeAndDefaultViewAsync()
    {
        _initializing = true;
        try
        {
            var profile = await PageAuth.GetUserProfileAsync();
            _assignedClassroomIds = profile.AssignedClassroomIds;
            _assignedBranchIds = profile.AssignedBranchIds;
            _availableViews = profile.AvailableViews;

            // 1. Check if URL query requested a specific authorized view
            if (ApplyRequestedViewFromUrl())
            {
                return;
            }

            // If user is OrgAdmin and has no assigned classrooms, default directly to Organization Operations
            if (profile.IsOrgAdmin && _assignedClassroomIds.Count == 0)
            {
                _currentView = "OrgAdmin";
                ViewPreference.SetCurrentView(_currentView);
                return;
            }

            // 2. Check if active session preference is already set
            if (!string.IsNullOrEmpty(ViewPreference.CurrentView))
            {
                var match = _availableViews.FirstOrDefault(v => v.Equals(ViewPreference.CurrentView, StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    _currentView = match;
                    return;
                }
            }

            // 3. Safe authorized default view (Role Hierarchy fallback):
            if (profile.IsOrgAdmin)
            {
                _currentView = "OrgAdmin";
            }
            else if (profile.IsBranchAdmin)
            {
                _currentView = "BranchAdmin";
            }
            else if (profile.IsLeadTeacher)
            {
                _currentView = "LeadTeacher";
            }
            else
            {
                _currentView = "Teacher";
            }

            ViewPreference.SetCurrentView(_currentView);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving dashboard scope: {ex.Message}");
            _currentView = "Teacher";
        }
        finally
        {
            _initializing = false;
        }
    }

    private bool ApplyRequestedViewFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var viewParam))
        {
            var requestedView = viewParam.ToString();
            var match = _availableViews.FirstOrDefault(v => v.Equals(requestedView, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                _currentView = match;
                ViewPreference.SetCurrentView(match);
                return true;
            }
        }
        return false;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (ApplyRequestedViewFromUrl())
        {
            InvokeAsync(StateHasChanged);
        }
        else if (!string.IsNullOrEmpty(ViewPreference.CurrentView) && _currentView != ViewPreference.CurrentView)
        {
            _currentView = ViewPreference.CurrentView;
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleViewChanged(string newView)
    {
        if (_availableViews.Contains(newView))
        {
            _currentView = newView;
            ViewPreference.SetCurrentView(newView);
            Navigation.NavigateTo($"/?view={newView.ToLowerInvariant()}", forceLoad: false);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        ViewPreference.OnViewChanged -= HandlePreferenceChanged;
    }
}
