@page "/"
@page "/today"
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Shared.Tenancy
@using Microsoft.AspNetCore.WebUtilities

@inject IAccessScopeRepository AccessScopeRepo
@inject ITenantContext TenantContext
@inject IUserContext UserContext
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Today — EnjoyEveryday</PageTitle>

@implements IDisposable

@if (_initializing)
{
    <LoadingState Text="Resolving your authorized workspace and classroom context..." />
}
else
{
    @if (_currentView == "LeadTeacher")
    {
        <TeacherWorkspace AssignedClassroomIds="_assignedClassroomIds"
                          IsLeadTeacher="true"
                          AvailableViews="_availableViews"
                          OnChangeView="HandleViewChanged" />
    }
    else if (_currentView == "Teacher")
    {
        <TeacherWorkspace AssignedClassroomIds="_assignedClassroomIds"
                          IsLeadTeacher="false"
                          AvailableViews="_availableViews"
                          OnChangeView="HandleViewChanged" />
    }
    else if (_currentView == "BranchAdmin")
    {
        <BranchAdminDashboard AssignedBranchIds="_assignedBranchIds"
                              AvailableViews="_availableViews"
                              OnChangeView="HandleViewChanged" />
    }
    else
    {
        <OrgAdminDashboard AvailableViews="_availableViews"
                           OnChangeView="HandleViewChanged" />
    }
}

@code {
    private bool _initializing = true;
    private string _currentView = "Teacher";
    private List<string> _availableViews = new();
    private HashSet<Guid> _assignedClassroomIds = new();
    private HashSet<Guid> _assignedBranchIds = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await ResolveUserScopeAndDefaultViewAsync();
    }

    private async Task ResolveUserScopeAndDefaultViewAsync()
    {
        _initializing = true;
        try
        {
            var profile = await PageAuth.GetUserProfileAsync();
            _assignedClassroomIds = profile.AssignedClassroomIds;
            _assignedBranchIds = profile.AssignedBranchIds;
            _availableViews = profile.AvailableViews;

            // Safe authorized default view (Role Hierarchy):
            if (profile.IsOrgAdmin)
            {
                _currentView = "OrgAdmin";
            }
            else if (profile.IsBranchAdmin)
            {
                _currentView = "BranchAdmin";
            }
            else if (profile.IsLeadTeacher)
            {
                _currentView = "LeadTeacher";
            }
            else
            {
                _currentView = "Teacher";
            }

            // Check if URL query requested a specific authorized view
            ApplyRequestedViewFromUrl();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving dashboard scope: {ex.Message}");
            _currentView = "Teacher";
        }
        finally
        {
            _initializing = false;
        }
    }

    private void ApplyRequestedViewFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var viewParam))
        {
            var requestedView = viewParam.ToString();
            if (_availableViews.Any(v => v.Equals(requestedView, StringComparison.OrdinalIgnoreCase)))
            {
                _currentView = _availableViews.First(v => v.Equals(requestedView, StringComparison.OrdinalIgnoreCase));
            }
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ApplyRequestedViewFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void HandleViewChanged(string newView)
    {
        if (_availableViews.Contains(newView))
        {
            _currentView = newView;
            Navigation.NavigateTo($"/?view={newView.ToLowerInvariant()}", forceLoad: false);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
