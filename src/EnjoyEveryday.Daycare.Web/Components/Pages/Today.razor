@page "/"
@page "/today"
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Shared.Tenancy
@using Microsoft.AspNetCore.WebUtilities

@inject IAccessScopeRepository AccessScopeRepo
@inject ITenantContext TenantContext
@inject IUserContext UserContext
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Today — EnjoyEveryday</PageTitle>

@if (_initializing)
{
    <LoadingState Text="Resolving your authorized workspace and classroom context..." />
}
else
{
    @if (_currentView == "Teacher")
    {
        <TeacherWorkspace AssignedClassroomIds="_assignedClassroomIds"
                          AvailableViews="_availableViews"
                          OnChangeView="HandleViewChanged" />
    }
    else if (_currentView == "BranchAdmin")
    {
        <BranchAdminDashboard AssignedBranchIds="_assignedBranchIds"
                              AvailableViews="_availableViews"
                              OnChangeView="HandleViewChanged" />
    }
    else
    {
        <OrgAdminDashboard AvailableViews="_availableViews"
                           OnChangeView="HandleViewChanged" />
    }
}

@code {
    private bool _initializing = true;
    private string _currentView = "Teacher";
    private List<string> _availableViews = new();
    private HashSet<Guid> _assignedClassroomIds = new();
    private HashSet<Guid> _assignedBranchIds = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveUserScopeAndDefaultViewAsync();
    }

    private async Task ResolveUserScopeAndDefaultViewAsync()
    {
        _initializing = true;
        try
        {
            var tenantId = TenantContext.TenantId;
            var orgId = UserContext.OrganizationId ?? Guid.Empty;
            var userId = UserContext.UserId;

            if (tenantId != Guid.Empty && userId != Guid.Empty)
            {
                var classroomIds = await AccessScopeRepo.GetAssignedClassroomIdsAsync(tenantId, userId);
                _assignedClassroomIds = new HashSet<Guid>(classroomIds);

                if (orgId != Guid.Empty)
                {
                    var branchIds = await AccessScopeRepo.GetAssignedBranchIdsAsync(tenantId, orgId, userId);
                    _assignedBranchIds = new HashSet<Guid>(branchIds);
                }
            }

            var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();

            bool isPlatformAdmin = userRoles.Any(r => 
                r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) || 
                r.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase));

            bool isOrgAdmin = isPlatformAdmin || userRoles.Any(r => 
                r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
                r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase) ||
                r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("Daycare Admin", StringComparison.OrdinalIgnoreCase));

            bool isBranchAdmin = isPlatformAdmin || userRoles.Any(r => 
                r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase)) ||
                _assignedBranchIds.Count > 0;

            bool isExplicitTeacher = userRoles.Any(r => 
                r.Equals(RoleTemplates.DaycareTeacher, StringComparison.OrdinalIgnoreCase) ||
                r.Equals(RoleTemplates.ClassroomTeacher, StringComparison.OrdinalIgnoreCase) ||
                r.Equals("Teacher", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("LeadTeacher", StringComparison.OrdinalIgnoreCase) ||
                r.Equals("AssistantTeacher", StringComparison.OrdinalIgnoreCase));

            bool hasAssignedClassroom = _assignedClassroomIds.Count > 0;
            bool isTeacher = isPlatformAdmin || isExplicitTeacher || hasAssignedClassroom;

            // Build available authorized views list
            _availableViews.Clear();
            if (isTeacher) _availableViews.Add("Teacher");
            if (isBranchAdmin) _availableViews.Add("BranchAdmin");
            if (isOrgAdmin) _availableViews.Add("OrgAdmin");

            if (!_availableViews.Any())
            {
                _availableViews.Add("Teacher");
            }

            // Safe authorized default view (Screenshot 3 flowchart):
            // 1. If assigned classrooms exist -> Teacher
            // 2. Else if user is explicitly a Teacher role without Admin -> Teacher
            // 3. Else if user has Organization Admin / Owner / Platform Admin scope -> OrgAdmin
            // 4. Else if user has Branch Admin scope -> BranchAdmin
            // 5. Fallback -> Teacher
            if (hasAssignedClassroom || (isExplicitTeacher && !isOrgAdmin && !isBranchAdmin))
            {
                _currentView = "Teacher";
            }
            else if (isOrgAdmin)
            {
                _currentView = "OrgAdmin";
            }
            else if (isBranchAdmin)
            {
                _currentView = "BranchAdmin";
            }
            else
            {
                _currentView = "Teacher";
            }

            // Check if URL query requested a specific authorized view
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var viewParam))
            {
                var requestedView = viewParam.ToString();
                if (_availableViews.Any(v => v.Equals(requestedView, StringComparison.OrdinalIgnoreCase)))
                {
                    _currentView = _availableViews.First(v => v.Equals(requestedView, StringComparison.OrdinalIgnoreCase));
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving dashboard scope: {ex.Message}");
            _currentView = "Teacher";
        }
        finally
        {
            _initializing = false;
        }
    }

    private void HandleViewChanged(string newView)
    {
        if (_availableViews.Contains(newView))
        {
            _currentView = newView;
            StateHasChanged();
        }
    }
}
