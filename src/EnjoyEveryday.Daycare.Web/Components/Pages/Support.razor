@page "/support"
@using EnjoyEveryday.UI.Shared.Components

<PageTitle>Help & Support — EnjoyEveryday</PageTitle>

<div class="content support-page" style="max-width: 960px; margin: 0 auto; padding: 24px 16px;">
    <PageHero Eyebrow="HELP &amp; SUPPORT"
              Title="How can we help you today?"
              Subtitle="Quick guides, helpful tips, and dedicated assistance for educators, directors, and administrators." />

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-top: 24px;">
        <!-- Card 1: Immediate Assistance -->
        <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); padding: 24px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); display: flex; flex-direction: column; gap: 12px;">
            <div style="width: 42px; height: 42px; border-radius: 12px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e5c49); display: grid; place-items: center; font-size: 20px;">
                💬
            </div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 750; color: var(--text, #26332d);">Educator &amp; Admin Support</h3>
            <p style="margin: 0; font-size: 13px; color: var(--muted, #6c7870); line-height: 1.5;">
                Need help with classroom rhythm, attendance logging, or branch setups? Our team is available Monday through Friday.
            </p>
            <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid var(--border, #e4e7df); font-size: 13px; font-weight: 600; color: var(--accent-dark, #3e5c49);">
                support@enjoyeveryday.daycare
            </div>
        </div>

        <!-- Card 2: Classroom Quick Guides -->
        <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); padding: 24px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); display: flex; flex-direction: column; gap: 12px;">
            <div style="width: 42px; height: 42px; border-radius: 12px; background: #fff7ed; color: #b47836; display: grid; place-items: center; font-size: 20px;">
                📖
            </div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 750; color: var(--text, #26332d);">Everyday Workflow Guides</h3>
            <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: var(--muted, #6c7870); line-height: 1.8;">
                <li><a href="/classroom" style="color: var(--accent, #52745e); font-weight: 600; text-decoration: none;">Classroom Quick Actions</a></li>
                <li><a href="/management/attendance" style="color: var(--accent, #52745e); font-weight: 600; text-decoration: none;">One-tap Attendance Logging</a></li>
                <li><a href="/daily-care" style="color: var(--accent, #52745e); font-weight: 600; text-decoration: none;">Meals, Naps &amp; Routine Logs</a></li>
                <li><a href="/classroom-messages" style="color: var(--accent, #52745e); font-weight: 600; text-decoration: none;">Communicating with Parents</a></li>
            </ul>
        </div>

        <!-- Card 3: Safety & Emergency -->
        <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); padding: 24px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); display: flex; flex-direction: column; gap: 12px;">
            <div style="width: 42px; height: 42px; border-radius: 12px; background: #fff5f5; color: #b85d43; display: grid; place-items: center; font-size: 20px;">
                🛡️
            </div>
            <h3 style="margin: 0; font-size: 17px; font-weight: 750; color: var(--text, #26332d);">Safety &amp; Compliance</h3>
            <p style="margin: 0; font-size: 13px; color: var(--muted, #6c7870); line-height: 1.5;">
                Quickly review branch emergency floor maps, active medical alerts, or contact numbers for authorities and family guardians.
            </p>
            <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid var(--border, #e4e7df);">
                <a href="/safety-trust" style="font-size: 13px; font-weight: 700; color: var(--accent-dark, #3e5c49); text-decoration: none;">View Safety &amp; Trust Center →</a>
            </div>
        </div>
    </div>
</div>
