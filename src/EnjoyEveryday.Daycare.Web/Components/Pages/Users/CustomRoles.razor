@page "/management/roles"
@using Microsoft.FluentUI.AspNetCore.Components
@using EnjoyEveryday.Shared.Tenancy

<PageTitle>Manage Roles - EnjoyEveryday</PageTitle>

<div style="padding: 24px; max-width: 1000px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h1 style="font-family: 'Inter', sans-serif; font-size: 28px; font-weight: 700; color: var(--neutral-foreground-rest); margin: 0;">
                Custom Roles
            </h1>
            <p style="color: var(--neutral-foreground-hint); margin-top: 8px;">
                Create and manage sub-roles strictly scoped to your daycare organization and branches.
            </p>
        </div>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="@( (Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => isDialogOpen = true )">
            Create Custom Role
        </FluentButton>
    </div>

    <!-- Active Custom Roles List -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
        <!-- Mock Card 1 -->
        <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: var(--elevation-shadow-16); border: 1px solid var(--neutral-layer-3);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <h3 style="margin: 0; font-size: 16px; font-weight: 600;">Lead Teacher</h3>
                <span style="padding: 4px 12px; border-radius: 12px; background: #e6f4ea; color: #1e8e3e; font-size: 12px; font-weight: 600;">Active</span>
            </div>
            <p style="color: var(--neutral-foreground-hint); font-size: 13px; margin: 8px 0 16px 0;">
                Full access to experiences and child observations within their assigned classroom.
            </p>
            <div style="font-size: 12px; font-weight: 600; color: var(--neutral-foreground-hint); text-transform: uppercase; margin-bottom: 8px;">Included Permissions:</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <span style="background: #f1f3f4; padding: 2px 8px; border-radius: 12px; font-size: 11px;">experience.execute</span>
                <span style="background: #f1f3f4; padding: 2px 8px; border-radius: 12px; font-size: 11px;">child.observe</span>
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 8px;">
                <FluentButton IconStart="@(new Icons.Regular.Size16.Edit())">Edit</FluentButton>
            </div>
        </div>

        <!-- Mock Card 2 -->
        <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: var(--elevation-shadow-16); border: 1px solid var(--neutral-layer-3);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <h3 style="margin: 0; font-size: 16px; font-weight: 600;">Branch Assistant</h3>
                <span style="padding: 4px 12px; border-radius: 12px; background: #e6f4ea; color: #1e8e3e; font-size: 12px; font-weight: 600;">Active</span>
            </div>
            <p style="color: var(--neutral-foreground-hint); font-size: 13px; margin: 8px 0 16px 0;">
                Can view experiences and schedule, but cannot create or approve them.
            </p>
            <div style="font-size: 12px; font-weight: 600; color: var(--neutral-foreground-hint); text-transform: uppercase; margin-bottom: 8px;">Included Permissions:</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <span style="background: #f1f3f4; padding: 2px 8px; border-radius: 12px; font-size: 11px;">experience.view</span>
                <span style="background: #f1f3f4; padding: 2px 8px; border-radius: 12px; font-size: 11px;">schedule.view</span>
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 8px;">
                <FluentButton IconStart="@(new Icons.Regular.Size16.Edit())">Edit</FluentButton>
            </div>
        </div>
    </div>
</div>

<!-- Create Role Dialog -->
<FluentDialog Hidden="@(!isDialogOpen)" Modal="true" TrapFocus="true">
    <div style="padding: 24px; min-width: 500px;">
        <h2 style="margin-top: 0; font-size: 20px; font-weight: 600;">Create Custom Role</h2>
        <p style="color: var(--neutral-foreground-hint); font-size: 13px; margin-bottom: 24px;">
            This role will be created exclusively within your Daycare Organization.
        </p>

        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div style="display: flex; flex-direction: column; gap: 4px;">
                <label>Role Name</label>
                <input type="text" @bind="newRoleName" style="padding: 8px; border: 1px solid var(--neutral-layer-3); border-radius: 4px; width: 100%;" placeholder="e.g. Floating Teacher" />
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 4px;">
                <label>Description</label>
                <textarea @bind="newRoleDesc" style="padding: 8px; border: 1px solid var(--neutral-layer-3); border-radius: 4px; width: 100%;" rows="3"></textarea>
            </div>

            <div>
                <label style="font-size: 14px; font-weight: 600; margin-bottom: 8px; display: block;">Select Permissions</label>
                <div style="border: 1px solid var(--neutral-layer-3); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 12px; max-height: 200px; overflow-y: auto;">
                    <label><input type="checkbox" @bind="p_expCreate" /> experience.create (Create new experiences)</label>
                    <label><input type="checkbox" @bind="p_expApprove" /> experience.approve (Approve experiences for use)</label>
                    <label><input type="checkbox" @bind="p_expExecute" /> experience.execute (Start and run experiences in classroom)</label>
                    <label><input type="checkbox" @bind="p_childObserve" /> child.observe (Record child observations and harvest)</label>
                    <label><input type="checkbox" @bind="p_attendance" /> attendance.manage (Check children in/out)</label>
                    <label><input type="checkbox" @bind="p_branchManage" /> branch.manage (Manage branch details)</label>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
            <FluentButton OnClick="@( (Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => isDialogOpen = false )">Cancel</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveRoleAsync">Create Role</FluentButton>
        </div>
    </div>
</FluentDialog>

@code {
    private bool isDialogOpen = false;
    private string newRoleName = "";
    private string newRoleDesc = "";
    
    // Checkbox binds
    private bool p_expCreate;
    private bool p_expApprove;
    private bool p_expExecute;
    private bool p_childObserve;
    private bool p_attendance;
    private bool p_branchManage;

    private async Task SaveRoleAsync()
    {
        // Mock save implementation
        // In a real scenario, this would inject a RoleService and create an Organization-scoped role in the DB
        // using the UserContext.OrganizationId and UserContext.TenantId.
        
        isDialogOpen = false;
        
        // Reset form
        newRoleName = "";
        newRoleDesc = "";
        p_expCreate = false;
        p_expApprove = false;
        p_expExecute = false;
        p_childObserve = false;
        p_attendance = false;
        p_branchManage = false;
    }
}
