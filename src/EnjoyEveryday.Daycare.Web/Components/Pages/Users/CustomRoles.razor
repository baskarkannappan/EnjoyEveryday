@page "/management/roles"
@page "/roles"
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Users
@rendermode InteractiveServer

<PageTitle>Role &amp; Permission Matrix — EnjoyEveryday</PageTitle>

<div class="content matrix-page-container">
    <PageHero Eyebrow="ORGANIZATION GOVERNANCE"
              Title="Role &amp; Permission Matrix"
              Subtitle="Dictate which operational roles can access pages and execute functionalities strictly for your daycare organization.">
        <RightContent>
            @if (_hasUnsavedChanges)
            {
                <span class="unsaved-badge" style="background: #fdf6ec; color: #b45309; padding: 4px 10px; border-radius: 0px; font-size: 11.5px; font-weight: 750; border: 1px solid #fde68a;">
                    ● Unsaved Changes
                </span>
            }
            <button class="secondary btn-reset" @onclick="HandleResetAsync">
                ↺ Reset to Defaults
            </button>
            <button class="primary btn-save" @onclick="HandleSaveAsync">
                ✓ Save Permissions
            </button>
        </RightContent>
    </PageHero>

    <RolePermissionMatrixView @ref="_matrixRef" OnUnsavedChangesChanged="HandleUnsavedChanged" />
</div>

@code {
    private RolePermissionMatrixView? _matrixRef;
    private bool _hasUnsavedChanges = false;

    private async Task HandleResetAsync()
    {
        if (_matrixRef != null)
        {
            await _matrixRef.ResetToDefaultsAsync();
        }
    }

    private async Task HandleSaveAsync()
    {
        if (_matrixRef != null)
        {
            await _matrixRef.SavePermissionsAsync();
        }
    }

    private void HandleUnsavedChanged(bool hasChanges)
    {
        _hasUnsavedChanges = hasChanges;
    }
}
