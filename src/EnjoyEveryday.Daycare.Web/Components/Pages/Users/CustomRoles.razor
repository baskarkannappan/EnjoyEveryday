@page "/management/roles"
@page "/roles"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Daycare.Web.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.UI.Shared.Components
@inject IPageAuthorizationService PageAuth
@inject IOrganizationPermissionService OrgPermService
@inject OrganizationService OrgService
@inject ITenantContext TenantContext
@inject NavigationManager Navigation

<PageTitle>Role & Permission Matrix — EnjoyEveryday</PageTitle>

<div class="content matrix-page-container">
    <PageHero Eyebrow="ORGANIZATION GOVERNANCE"
              Title="Role & Permission Matrix"
              Subtitle="Dictate which operational roles can access pages and execute functionalities strictly for your daycare organization.">
        <RightContent>
            @if (_hasUnsavedChanges)
            {
                <span class="unsaved-badge">● Unsaved Changes</span>
            }
            <button class="secondary btn-reset" @onclick="HandleResetToDefaults" disabled="@_isSaving">
                ↺ Reset to Defaults
            </button>
            <button class="primary btn-save" @onclick="HandleSavePermissions" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>✓ Save Permissions</span>
                }
            </button>
        </RightContent>
    </PageHero>

    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading organization permissions...</p>
        </div>
    }
    else if (!_isAuthorized)
    {
        <div class="unauthorized-card">
            <h3>Access Denied</h3>
            <p>This page is restricted to Organization Administrators. Your current role does not have authorization to configure organization-wide security matrices.</p>
            <a href="/" class="btn secondary">Return to Home</a>
        </div>
    }
    else
    {
        <!-- Organization Scope Bar -->
        <div class="org-scope-bar">
            <div class="org-info">
                <div class="org-avatar">🏢</div>
                <div>
                    <div class="org-title-row">
                        <span class="org-label">Current Organization</span>
                        <span class="org-badge">Strict Isolation</span>
                    </div>
                    @if (_availableOrgs.Count > 1)
                    {
                        <div class="org-selector-wrapper">
                            <select class="org-select" value="@_currentOrgId" @onchange="OnOrganizationChanged">
                                @foreach (var org in _availableOrgs)
                                {
                                    <option value="@org.Id">@org.Name (@(org.Location ?? "Main Facility"))</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <h2 class="org-name">@_currentOrgName</h2>
                        <span class="org-meta">@_currentOrgLocation • ID: @_currentOrgId</span>
                    }
                </div>
            </div>

            <div class="scope-alert">
                <span class="scope-icon">ℹ️</span>
                <p>
                    Changes saved here apply <strong>exclusively</strong> to <strong>@_currentOrgName</strong>. Other daycare organizations maintain their own isolated access rules.
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="status-banner @(_isErrorStatus ? "error" : "success")">
                <span>@(_isErrorStatus ? "⚠️" : "✅")</span>
                <span>@_statusMessage</span>
                <button class="close-status" @onclick="() => _statusMessage = null">✕</button>
            </div>
        }

        <!-- Filter & Search Toolbar -->
        <div class="toolbar-card">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input class="search-input" 
                       type="text" 
                       placeholder="Filter by page name, functionality, route (e.g. /attendance)..." 
                       @bind="_searchQuery" 
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button class="clear-search" @onclick="() => _searchQuery = string.Empty">✕</button>
                }
            </div>

            <div class="category-tabs">
                <button class="cat-tab @(_selectedCategory == "All" ? "active" : "")" 
                        @onclick='() => _selectedCategory = "All"'>
                    All (@_allFeatures.Count)
                </button>
                @foreach (var cat in _categories)
                {
                    var count = _allFeatures.Count(f => f.Category == cat);
                    <button class="cat-tab @(_selectedCategory == cat ? "active" : "")" 
                            @onclick="() => _selectedCategory = cat">
                        @cat (@count)
                    </button>
                }
            </div>
        </div>

        <!-- Role Summary Header Cards -->
        <div class="role-overview-grid">
            @foreach (var role in _roles)
            {
                var roleName = OrgPermService.GetRoleDisplayName(role);
                var enabledCount = GetEnabledCountForRole(role);
                var totalCount = _allFeatures.Count;

                <div class="role-stat-card">
                    <div class="role-stat-header">
                        <span class="role-badge-pill @GetRoleCssClass(role)">@roleName</span>
                        <span class="role-stat-ratio">@enabledCount / @totalCount</span>
                    </div>
                    <div class="role-progress-bar">
                        <div class="role-progress-fill @GetRoleCssClass(role)" 
                             style="width: @((int)((double)enabledCount / totalCount * 100))%;"></div>
                    </div>
                    <div class="role-quick-actions">
                        <button class="quick-btn" @onclick="() => SetRoleAccessForFiltered(role, true)">Grant All</button>
                        <span class="sep">•</span>
                        <button class="quick-btn" @onclick="() => SetRoleAccessForFiltered(role, false)">Revoke All</button>
                    </div>
                </div>
            }
        </div>

        <!-- Permission Matrix Table -->
        <div class="matrix-card">
            <div class="table-responsive">
                <table class="matrix-table">
                    <thead>
                        <tr>
                            <th class="col-feature">Page & Functionality</th>
                            @foreach (var role in _roles)
                            {
                                <th class="col-role text-center">
                                    <div class="role-th-content">
                                        <span class="role-th-title">@OrgPermService.GetRoleDisplayName(role)</span>
                                        <span class="role-th-desc">@GetRoleDescription(role)</span>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in GetVisibleCategories())
                        {
                            var catFeatures = GetFeaturesForCategory(category);
                            if (catFeatures.Count == 0) continue;

                            <tr class="category-header-row">
                                <td colspan="@(_roles.Count + 1)">
                                    <div class="category-header-content">
                                        <span class="cat-icon">@GetCategoryIcon(category)</span>
                                        <span class="cat-title">@category</span>
                                        <span class="cat-badge">@catFeatures.Count @(catFeatures.Count == 1 ? "element" : "elements")</span>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var feat in catFeatures)
                            {
                                <tr class="feature-row">
                                    <td class="col-feature-cell">
                                        <div class="feature-info">
                                            <div class="feature-title-line">
                                                <span class="feature-name">@feat.Name</span>
                                                <span class="feature-cat-tag">@feat.Category</span>
                                            </div>
                                            <p class="feature-description">@feat.Description</p>
                                            @if (feat.Routes.Count > 0)
                                            {
                                                <div class="feature-routes">
                                                    @foreach (var route in feat.Routes)
                                                    {
                                                        <span class="route-pill">@route</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    @foreach (var role in _roles)
                                    {
                                        var isAllowed = IsPermissionGranted(role, feat.Key);
                                        var isOrgAdminRole = role == "OrganizationAdmin";

                                        <td class="col-role-cell text-center" 
                                            @onclick="() => TogglePermission(role, feat.Key)">
                                            <div class="checkbox-cell-wrapper" @onclick:stopPropagation="true">
                                                <label class="custom-checkbox-container">
                                                    <input type="checkbox" 
                                                           checked="@isAllowed" 
                                                           @onchange="() => TogglePermission(role, feat.Key)" />
                                                    <span class="checkmark @(isAllowed ? "checked" : "")">
                                                        @if (isAllowed)
                                                        {
                                                            <span>✓</span>
                                                        }
                                                    </span>
                                                </label>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sticky Floating Save Bar when unsaved changes exist -->
        @if (_hasUnsavedChanges)
        {
            <div class="floating-save-bar">
                <div class="floating-save-content">
                    <div class="floating-text">
                        <span class="pulse-dot"></span>
                        <strong>You have unsaved changes in this organization's matrix.</strong>
                    </div>
                    <div class="floating-actions">
                        <button class="secondary" @onclick="HandleDiscardChanges" disabled="@_isSaving">
                            Discard
                        </button>
                        <button class="primary" @onclick="HandleSavePermissions" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isAuthorized = false;
    private bool _isSaving = false;
    private bool _hasUnsavedChanges = false;
    private string? _statusMessage;
    private bool _isErrorStatus = false;

    private Guid _currentOrgId;
    private string _currentOrgName = "Daycare Organization";
    private string _currentOrgLocation = string.Empty;
    private List<Organization> _availableOrgs = new();

    private List<string> _roles = new();
    private List<FeatureDefinition> _allFeatures = new();
    private List<string> _categories = new();
    private string _selectedCategory = "All";
    private string _searchQuery = string.Empty;

    // In-memory working matrix: (RoleName, FeatureKey) -> IsAllowed
    private Dictionary<(string RoleName, string FeatureKey), bool> _matrix = new();
    private Dictionary<(string RoleName, string FeatureKey), bool> _originalMatrix = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Authorization check
        var profile = await PageAuth.GetUserProfileAsync();
        if (!profile.IsAuthenticated || !profile.IsOrgAdmin)
        {
            _isAuthorized = false;
            _isLoading = false;
            return;
        }

        _isAuthorized = true;

        // 2. Load available organizations
        try
        {
            var orgs = (await OrgService.GetOrganizationsAsync(scopeToActiveOrg: false)).ToList();
            _availableOrgs = orgs;

            var activeOrg = orgs.FirstOrDefault(o => o.Id == profile.OrganizationId) 
                         ?? orgs.FirstOrDefault();

            if (activeOrg != null)
            {
                _currentOrgId = activeOrg.Id;
                _currentOrgName = activeOrg.Name;
                _currentOrgLocation = activeOrg.Location ?? "Main Facility";
            }
            else
            {
                _currentOrgId = profile.OrganizationId;
                _currentOrgName = "Daycare Organization";
            }
        }
        catch
        {
            _currentOrgId = profile.OrganizationId;
        }

        // 3. Setup feature catalog and roles
        _roles = OrgPermService.GetConfigurableRoles().ToList();
        _allFeatures = OrgPermService.GetAllFeatures().ToList();
        _categories = _allFeatures.Select(f => f.Category).Distinct().ToList();

        // 4. Load permissions for current organization
        await LoadPermissionsForCurrentOrgAsync();

        _isLoading = false;
    }

    private async Task LoadPermissionsForCurrentOrgAsync()
    {
        _matrix = await OrgPermService.GetPermissionsMatrixAsync(TenantContext.TenantId, _currentOrgId);
        _originalMatrix = new Dictionary<(string RoleName, string FeatureKey), bool>(_matrix);
        _hasUnsavedChanges = false;
    }

    private async Task OnOrganizationChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var newOrgId) && newOrgId != _currentOrgId)
        {
            var selectedOrg = _availableOrgs.FirstOrDefault(o => o.Id == newOrgId);
            if (selectedOrg != null)
            {
                _currentOrgId = selectedOrg.Id;
                _currentOrgName = selectedOrg.Name;
                _currentOrgLocation = selectedOrg.Location ?? "Facility";

                _isLoading = true;
                _statusMessage = null;
                await LoadPermissionsForCurrentOrgAsync();
                _isLoading = false;
            }
        }
    }

    private bool IsPermissionGranted(string role, string featureKey)
    {
        if (_matrix.TryGetValue((role, featureKey), out var allowed))
        {
            return allowed;
        }
        return false;
    }

    private void TogglePermission(string role, string featureKey)
    {
        var current = IsPermissionGranted(role, featureKey);
        _matrix[(role, featureKey)] = !current;
        CheckUnsavedChanges();
    }

    private void SetRoleAccessForFiltered(string role, bool allow)
    {
        var targetFeatures = GetFilteredFeatures();
        foreach (var feat in targetFeatures)
        {
            _matrix[(role, feat.Key)] = allow;
        }
        CheckUnsavedChanges();
    }

    private void CheckUnsavedChanges()
    {
        _hasUnsavedChanges = _matrix.Any(kvp => 
            !_originalMatrix.TryGetValue(kvp.Key, out var orig) || orig != kvp.Value);
    }

    private void HandleDiscardChanges()
    {
        _matrix = new Dictionary<(string RoleName, string FeatureKey), bool>(_originalMatrix);
        _hasUnsavedChanges = false;
        _statusMessage = "Changes discarded.";
        _isErrorStatus = false;
    }

    private async Task HandleSavePermissions()
    {
        _isSaving = true;
        _statusMessage = null;
        try
        {
            await OrgPermService.SavePermissionsMatrixAsync(
                TenantContext.TenantId,
                _currentOrgId,
                _matrix);

            _originalMatrix = new Dictionary<(string RoleName, string FeatureKey), bool>(_matrix);
            _hasUnsavedChanges = false;
            _statusMessage = $"Permissions successfully saved for {_currentOrgName}.";
            _isErrorStatus = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to save permissions: {ex.Message}";
            _isErrorStatus = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleResetToDefaults()
    {
        _isSaving = true;
        _statusMessage = null;
        try
        {
            await OrgPermService.ResetPermissionsMatrixAsync(TenantContext.TenantId, _currentOrgId);
            await LoadPermissionsForCurrentOrgAsync();
            _statusMessage = $"Permissions reset to organization defaults for {_currentOrgName}.";
            _isErrorStatus = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to reset permissions: {ex.Message}";
            _isErrorStatus = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private IEnumerable<string> GetVisibleCategories()
    {
        if (_selectedCategory != "All")
        {
            return new[] { _selectedCategory };
        }
        return _categories;
    }

    private List<FeatureDefinition> GetFeaturesForCategory(string category)
    {
        return GetFilteredFeatures().Where(f => f.Category == category).ToList();
    }

    private List<FeatureDefinition> GetFilteredFeatures()
    {
        var query = _allFeatures.AsEnumerable();

        if (_selectedCategory != "All")
        {
            query = query.Where(f => f.Category == _selectedCategory);
        }

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim().ToLowerInvariant();
            query = query.Where(f =>
                f.Name.ToLowerInvariant().Contains(q) ||
                f.Description.ToLowerInvariant().Contains(q) ||
                f.Key.ToLowerInvariant().Contains(q) ||
                f.Category.ToLowerInvariant().Contains(q) ||
                f.Routes.Any(r => r.ToLowerInvariant().Contains(q)));
        }

        return query.ToList();
    }

    private int GetEnabledCountForRole(string role)
    {
        return _allFeatures.Count(f => IsPermissionGranted(role, f.Key));
    }

    private static string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Executive & Governance" => "🏛️",
            "Branch Operations" => "🏫",
            "Classrooms & Children" => "👶",
            "Daily Care & Learning" => "🌱",
            "Attendance Management" => "📋",
            "Staff & Educators" => "👥",
            _ => "📌"
        };
    }

    private static string GetRoleCssClass(string role)
    {
        return role switch
        {
            "OrganizationAdmin" => "role-org-admin",
            "BranchAdmin" => "role-branch-admin",
            "LeadTeacher" => "role-lead-teacher",
            "Teacher" => "role-teacher",
            _ => "role-default"
        };
    }

    private static string GetRoleDescription(string role)
    {
        return role switch
        {
            "OrganizationAdmin" => "Full organization executive authority",
            "BranchAdmin" => "Branch facility and staff operations",
            "LeadTeacher" => "Classroom learning and mentorship",
            "Teacher" => "Daily child care and activity delivery",
            _ => "Operational role"
        };
    }
}
