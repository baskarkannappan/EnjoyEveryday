@page "/users-by-role"
@page "/management/users-by-role"
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Users
@using Microsoft.FluentUI.AspNetCore.Components
@rendermode InteractiveServer

<PageTitle>Users by Role Hierarchy — EnjoyEveryday</PageTitle>

<div class="content">
    <PageHero Eyebrow="PEOPLE &amp; GOVERNANCE"
              Title="Users by Role Hierarchy"
              Subtitle="All daycare team members, educators, administrators, and families organized by operational role hierarchy.">
        <RightContent>
            <button type="button" class="btn primary" @onclick="() => _viewRef?.OpenAddUserModal()" style="display: inline-flex; align-items: center; gap: 8px;">
                <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Custom" CustomColor="#ffffff" />
                <span>+ Add Team Member</span>
            </button>
            <a href="/management/roles" class="btn secondary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                <FluentIcon Value="@(new Icons.Regular.Size16.Shield())" Color="Color.Default" />
                <span>Role Permissions Matrix</span>
            </a>
        </RightContent>
    </PageHero>

    <UsersByRoleView @ref="_viewRef" />
</div>

@code {
    private UsersByRoleView? _viewRef;
}
