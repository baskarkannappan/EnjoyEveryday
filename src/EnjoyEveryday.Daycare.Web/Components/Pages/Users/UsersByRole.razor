@page "/users-by-role"
@page "/management/users-by-role"
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Authorization
@using EnjoyEveryday.Shared.Tenancy
@inject IUserRepository UserRepository
@inject EnjoyEveryday.Application.Services.BranchService BranchService
@inject ITenantContext TenantContext
@inject IUserContext UserContext
@inject IAccessScopeRepository AccessScopeRepo
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth

<PageTitle>Users by Role Hierarchy — EnjoyEveryday</PageTitle>

<div class="content">
    <!-- HEADER -->
    <PageHero Eyebrow="@(_isBranchAdmin ? "BRANCH OPERATIONS" : "PEOPLE")"
              Title="@(_isBranchAdmin ? "Branch Staff & Roles" : "Users by Role")"
              Subtitle="@(_isBranchAdmin ? "Team members, educators, and roles assigned to this branch location." : "All daycare team members, educators, administrators, and families organized by role hierarchy.")">
        <RightContent>
            <button class="btn primary" @onclick="OpenAddUserModal" style="display: inline-flex; align-items: center; gap: 8px;">
                <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Custom" CustomColor="#ffffff" />
                <span>+ Add Team Member</span>
            </button>
            @if (_isOrgAdmin)
            {
                <a href="/management/roles" class="btn secondary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Shield())" Color="Color.Default" />
                    <span>Role Permissions Matrix</span>
                </a>
            }
        </RightContent>
    </PageHero>

    <!-- SUCCESS NOTIFICATION -->
    @if (!string.IsNullOrEmpty(_successBanner))
    {
        <div style="background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; color: var(--accent-dark, #3e6253); padding: 12px 16px; border-radius: 12px; font-size: 13px; font-weight: 700; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span>✨</span>
                <span>@_successBanner</span>
            </div>
            <button type="button" @onclick="() => _successBanner = null" style="background: none; border: none; font-size: 16px; cursor: pointer; color: var(--accent-dark, #3e6253);">✕</button>
        </div>
    }

    <!-- SEARCH & FILTER ROW (Native EnjoyEveryday Style) -->
    <div class="search-row" style="margin-bottom: 14px;">
        <input class="search" 
               @bind="_searchTerm" 
               @bind:event="oninput" 
               placeholder="Search team members by name, email, or role..." />
               
        <select class="filter" @bind="_selectedFilter" @bind:after="RecomputeGroups" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--border, #e4e7df); font-weight: 650; color: var(--text, #26332d); background: white; font-size: 13px; cursor: pointer;">
            <option value="All">All Roles (@_allUsers.Count)</option>
            <option value="Admin">Leadership &amp; Admins</option>
            <option value="Teacher">Educators &amp; Teachers</option>
            <option value="Parent">Families &amp; Parents</option>
        </select>
    </div>

    <!-- FILTER TABS -->
    <FilterTabs Tabs="UserRoleTabs" ActiveTab="@_selectedFilter" OnTabSelected="SetRoleFilter" />

    <!-- HIERARCHY GROUPS -->
    @if (_isLoading)
    {
        <LoadingState Message="Loading team members and resolving role hierarchy..." />
    }
    else if (!_groupedRoles.Any())
    {
        <EmptyState Icon="👥"
                    Title="No team members found"
                    Description="No users matched your search criteria." />
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 36px;">
            @foreach (var group in _groupedRoles)
            {
                <div>
                    <!-- GROUP HEADER -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border, #e1e6df); flex-wrap: wrap; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 36px; height: 36px; border-radius: 11px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e6253); display: grid; place-items: center; font-size: 18px;">
                                @group.HierarchyIcon
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <h2 style="font-size: 18px; font-weight: 750; color: var(--text, #26332d); margin: 0; letter-spacing: -0.3px;">
                                        @group.RoleDisplayName
                                    </h2>
                                    <span style="background: #eef2ed; color: var(--accent-dark, #3e6253); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        Rank @group.HierarchyRank
                                    </span>
                                    <span style="background: white; border: 1px solid var(--border, #e4e7df); color: var(--muted, #6c7870); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 8px;">
                                        @group.Scope Scope
                                    </span>
                                </div>
                                <p style="margin: 3px 0 0 0; font-size: 13px; color: var(--muted, #6c7870);">@group.Description</p>
                            </div>
                        </div>

                        <span style="font-size: 12px; font-weight: 700; color: var(--muted, #6c7870); background: white; border: 1px solid var(--border, #e4e7df); padding: 4px 12px; border-radius: 12px;">
                            @group.Users.Count member@(group.Users.Count == 1 ? "" : "s")
                        </span>
                    </div>

                    <!-- PEOPLE GRID (Native EnjoyEveryday Grid Layout) -->
                    <div class="people-grid">
                        @foreach (var user in group.Users)
                        {
                            <PersonCard AvatarInitials="@(user.DisplayName.Length > 0 ? user.DisplayName.Substring(0, 1).ToUpper() : (user.Email.Length > 0 ? user.Email.Substring(0, 1).ToUpper() : "?"))"
                                        Name="@user.DisplayName"
                                        Subtitle="@user.Email"
                                        Status="@(user.IsActive ? "Active" : "Inactive")"
                                        HighlightTitle="@(user.ClassroomName != null ? "Classroom Assignment" : (user.AssociatedChildrenCount > 0 ? "Enrolled Children" : (!string.IsNullOrEmpty(user.OrganizationName) ? "Organization" : "Authority Scope")))"
                                        HighlightText="@(user.ClassroomName ?? (user.AssociatedChildrenCount > 0 ? $"{user.AssociatedChildrenCount} child(ren) enrolled" : (!string.IsNullOrEmpty(user.OrganizationName) ? user.OrganizationName : $"{group.Scope} Level Permissions")))" />
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ================= ADD TEAM MEMBER MODAL ================= -->
@if (_showAddUserModal)
{
    <div class="modal-backdrop" @onclick="CloseAddUserModal" style="position: fixed; inset: 0; background: rgba(38, 51, 45, 0.45); backdrop-filter: blur(4px); display: grid; place-items: center; z-index: 1000; padding: 16px;">
        <div class="modal-card" @onclick:stopPropagation="true" style="background: var(--surface, #ffffff); border-radius: var(--radius, 18px); border: 1px solid var(--border, #e4e7df); box-shadow: 0 16px 40px rgba(40, 55, 47, 0.16); max-width: 520px; width: 100%; padding: 28px; box-sizing: border-box;">
            
            <!-- Modal Header -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                <div>
                    <div style="font-size: 11px; font-weight: 750; text-transform: uppercase; letter-spacing: 0.6px; color: var(--accent, #52745e); margin-bottom: 4px;">ORGANIZATION STAFF</div>
                    <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: var(--text, #26332d); letter-spacing: -0.3px;">Add Team Member</h3>
                    <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--muted, #6c7870);">Create a user account and assign organization or branch authority.</p>
                </div>
                <button type="button" @onclick="CloseAddUserModal" style="background: none; border: none; font-size: 18px; color: var(--muted, #6c7870); cursor: pointer; padding: 4px;">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="background: #fff5f5; border: 1px solid #fed7d7; color: #9b2c2c; padding: 10px 14px; border-radius: 10px; font-size: 12.5px; font-weight: 600; margin-bottom: 16px;">
                    @_errorMessage
                </div>
            }

            <div style="display: flex; flex-direction: column; gap: 14px;">
                <!-- Name Fields -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 5px;">First Name</label>
                        <input type="text" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="e.g. Vybe" @bind="_newUserFirstName" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 5px;">Last Name</label>
                        <input type="text" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="e.g. Media" @bind="_newUserLastName" />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 5px;">Email Address <span style="color: #c53030;">*</span></label>
                    <input type="email" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="vybe.media26@gmail.com" @bind="_newUserEmail" />
                </div>

                <!-- Role Selection -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 5px;">Assigned Role <span style="color: #c53030;">*</span></label>
                    <select class="filter" style="width: 100%; box-sizing: border-box; padding: 10px 12px; font-size: 13px; font-weight: 600; border-radius: 10px; background: white;" @bind="_newUserRole">
                        @if (_isOrgAdmin)
                        {
                            <option value="OrganizationAdmin">🏢 Organization Admin (Org Level)</option>
                            <option value="BranchAdmin">🏛️ Branch Admin</option>
                        }
                        <option value="LeadTeacher">🎓 Lead Teacher</option>
                        <option value="ClassroomTeacher">✏️ Teacher / Educator</option>
                        <option value="DaycareTeacher">🧸 Assistant Teacher</option>
                    </select>
                </div>

                <!-- Branch Assignment -->
                @if (_newUserRole == "BranchAdmin" || _newUserRole == "LeadTeacher" || _newUserRole == "ClassroomTeacher" || _newUserRole == "DaycareTeacher")
                {
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 5px;">Assigned Branch Location</label>
                        <select class="filter" style="width: 100%; box-sizing: border-box; padding: 10px 12px; font-size: 13px; font-weight: 600; border-radius: 10px; background: white;" @bind="_selectedBranchId">
                            <option value="">-- All Authorized Branches / None --</option>
                            @foreach (var branch in _branches)
                            {
                                <option value="@branch.Id">@branch.Name @(!string.IsNullOrEmpty(branch.Location) ? $"({branch.Location})" : "")</option>
                            }
                        </select>
                    </div>
                }

                <!-- Password -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 5px;">Temporary Initial Password</label>
                    <input type="text" class="search" style="width: 100%; box-sizing: border-box; padding: 9px 12px; font-size: 13px;" placeholder="Welcome@123" @bind="_newUserPassword" />
                    <span style="font-size: 11px; color: var(--muted, #6c7870); margin-top: 3px; display: block;">User can sign in with this password or directly via Google Single Sign-On with their Gmail.</span>
                </div>
            </div>

            <!-- Actions -->
            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border, #e4e7df);">
                <button type="button" class="btn secondary" @onclick="CloseAddUserModal" disabled="@_isSaving">Cancel</button>
                <button type="button" class="btn primary" @onclick="HandleCreateUserAsync" disabled="@_isSaving" style="min-width: 130px;">
                    @if (_isSaving)
                    {
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create Member</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string _searchTerm = "";
    private string _selectedFilter = "All";
    private List<UserHierarchyRecord> _allUsers = new();
    private List<RoleGroup> _groupedRoles = new();

    // Add Member Modal State
    private bool _showAddUserModal = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successBanner;

    private string _newUserFirstName = "";
    private string _newUserLastName = "";
    private string _newUserEmail = "";
    private string _newUserRole = "BranchAdmin";
    private string _newUserPassword = "Welcome@123";
    private string _selectedBranchId = "";
    private List<Branch> _branches = new();

    public class RoleGroup
    {
        public string RoleKey { get; set; } = string.Empty;
        public string RoleDisplayName { get; set; } = string.Empty;
        public int HierarchyRank { get; set; }
        public string HierarchyIcon { get; set; } = "👤";
        public string Scope { get; set; } = "Organization";
        public string Description { get; set; } = string.Empty;
        public string BgColor { get; set; } = "#f9fafb";
        public string BorderColor { get; set; } = "#e5e7eb";
        public string TextColor { get; set; } = "#1f2937";
        public List<UserHierarchyRecord> Users { get; set; } = new();
    }

    private bool _isOrgAdmin = false;
    private bool _isBranchAdmin = false;
    private HashSet<Guid> _assignedBranchIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await PageAuth.EnsureAuthorizedAsync("/users-by-role"))
        {
            return;
        }

        var tenantId = TenantContext.TenantId;
        var userId = UserContext.UserId;
        var userRoles = (UserContext.Roles ?? Enumerable.Empty<string>()).ToList();
        _isOrgAdmin = userRoles.Any(r =>
            r.Equals(RoleTemplates.PlatformAdmin, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationOwner, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(RoleTemplates.OrganizationAdmin, StringComparison.OrdinalIgnoreCase));
        _isBranchAdmin = !_isOrgAdmin && userRoles.Any(r => r.Equals(RoleTemplates.BranchAdmin, StringComparison.OrdinalIgnoreCase));

        var orgId = UserContext.OrganizationId ?? Guid.Parse("20000000-0000-0000-0000-000000000001");
        if (tenantId != Guid.Empty && userId != Guid.Empty)
        {
            var branchIds = await AccessScopeRepo.GetAssignedBranchIdsAsync(tenantId, orgId, userId);
            _assignedBranchIds = new HashSet<Guid>(branchIds);
        }

        await LoadBranchesAsync();
        await LoadUsersAndRolesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var orgId = UserContext.OrganizationId ?? Guid.Parse("20000000-0000-0000-0000-000000000001");
            var branches = (await BranchService.GetBranchesAsync(orgId)).ToList();
            if (_isBranchAdmin && _assignedBranchIds.Count > 0)
            {
                _branches = branches.Where(b => _assignedBranchIds.Contains(b.Id)).ToList();
            }
            else
            {
                _branches = branches;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UsersByRole] Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadUsersAndRolesAsync()
    {
        _isLoading = true;
        try
        {
            var tenantId = TenantContext.TenantId;
            var users = (await UserRepository.GetUsersHierarchyAsync(tenantId)).ToList();

            if (_isBranchAdmin && _branches.Count > 0)
            {
                var branchNames = _branches.Select(b => b.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
                _allUsers = users.Where(u =>
                    string.IsNullOrEmpty(u.OrganizationName) ||
                    branchNames.Contains(u.OrganizationName) ||
                    (u.ClassroomName != null && branchNames.Any(bn => u.ClassroomName.Contains(bn, StringComparison.OrdinalIgnoreCase))) ||
                    u.CanonicalRoles.Contains("BranchAdmin") ||
                    u.CanonicalRoles.Contains("LeadTeacher") ||
                    u.CanonicalRoles.Contains("ClassroomTeacher") ||
                    u.CanonicalRoles.Contains("DaycareTeacher")
                ).ToList();
            }
            else
            {
                _allUsers = users;
            }

            RecomputeGroups();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddUserModal()
    {
        _errorMessage = null;
        _newUserFirstName = "";
        _newUserLastName = "";
        _newUserEmail = "";
        _newUserRole = _isBranchAdmin ? "ClassroomTeacher" : "BranchAdmin";
        _newUserPassword = "Welcome@123";
        _selectedBranchId = _branches.FirstOrDefault()?.Id.ToString() ?? "";
        _showAddUserModal = true;
    }

    private void CloseAddUserModal()
    {
        _showAddUserModal = false;
        _errorMessage = null;
    }

    private async Task HandleCreateUserAsync()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_newUserEmail))
        {
            _errorMessage = "Please enter an email address.";
            return;
        }

        _isSaving = true;
        try
        {
            var tenantId = TenantContext.TenantId;
            var orgId = UserContext.OrganizationId ?? Guid.Parse("20000000-0000-0000-0000-000000000001");

            var firstName = !string.IsNullOrWhiteSpace(_newUserFirstName) ? _newUserFirstName.Trim() : _newUserEmail.Split('@')[0];
            var lastName = !string.IsNullOrWhiteSpace(_newUserLastName) ? _newUserLastName.Trim() : "Staff";
            var displayName = $"{firstName} {lastName}".Trim();
            var password = !string.IsNullOrWhiteSpace(_newUserPassword) ? _newUserPassword.Trim() : "Welcome@123";

            var newUser = new User
            {
                Id = Guid.NewGuid(),
                TenantId = tenantId,
                Email = _newUserEmail.Trim().ToLowerInvariant(),
                FirstName = firstName,
                LastName = lastName,
                DisplayName = displayName,
                IsActive = true,
                CreatedAt = DateTimeOffset.UtcNow,
                UpdatedAt = DateTimeOffset.UtcNow
            };

            await UserRepository.AddAsync(newUser, password);

            if (!string.IsNullOrEmpty(_newUserRole))
            {
                await UserRepository.AssignOrganizationRoleAsync(tenantId, orgId, newUser.Id, _newUserRole);
            }

            if (Guid.TryParse(_selectedBranchId, out var branchGuid) && branchGuid != Guid.Empty)
            {
                await UserRepository.AssignBranchToUserAsync(tenantId, orgId, branchGuid, newUser.Id, UserContext.UserId);
            }

            _successBanner = $"Team member '{newUser.Email}' successfully added as {_newUserRole}!";
            CloseAddUserModal();
            await LoadUsersAndRolesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create user: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RecomputeGroups()
    {
        // Defined Role Hierarchy Tiers (High to Low)
        var hierarchyDefinitions = new List<RoleGroup>
        {
            new RoleGroup
            {
                RoleKey = RoleTemplates.PlatformAdmin,
                RoleDisplayName = "Platform Administrators",
                HierarchyRank = 1,
                HierarchyIcon = "🛡️",
                Scope = "Platform",
                Description = "Platform system governors with cross-tenant management and infrastructure access.",
                BgColor = "#f4f0f7",
                BorderColor = "#ddd4e8",
                TextColor = "#594273"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.OrganizationOwner,
                RoleDisplayName = "Organization Owners",
                HierarchyRank = 2,
                HierarchyIcon = "👑",
                Scope = "Organization",
                Description = "Owners with legal, financial, and overall executive authority over the daycare organization.",
                BgColor = "#fdf8ee",
                BorderColor = "#ecd9b5",
                TextColor = "#8a6224"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.OrganizationAdmin,
                RoleDisplayName = "Daycare Administrators",
                HierarchyRank = 3,
                HierarchyIcon = "🏢",
                Scope = "Organization",
                Description = "Operations directors overseeing classrooms, educators, enrollments, curriculum approval, and parent updates.",
                BgColor = "#e6eee9",
                BorderColor = "#c8dacd",
                TextColor = "#3e6253"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.BranchAdmin,
                RoleDisplayName = "Branch Directors",
                HierarchyRank = 4,
                HierarchyIcon = "🏛️",
                Scope = "Branch",
                Description = "Center directors managing specific physical daycare branch locations and on-site staff.",
                BgColor = "#f8f4ee",
                BorderColor = "#ded2c0",
                TextColor = "#7c5936"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.LeadTeacher,
                RoleDisplayName = "Lead Teachers",
                HierarchyRank = 5,
                HierarchyIcon = "🎓",
                Scope = "Classroom",
                Description = "Coordinates classroom delivery, teaching team, readiness checks, and daily handover while teaching.",
                BgColor = "#eef4f1",
                BorderColor = "#cbe0d5",
                TextColor = "#346a54"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.ClassroomTeacher,
                RoleDisplayName = "Teachers & Educators",
                HierarchyRank = 6,
                HierarchyIcon = "✏️",
                Scope = "Classroom",
                Description = "Cares for assigned children, conducts activities, records attendance, and logs daily routines.",
                BgColor = "#f4f6f4",
                BorderColor = "#d5ded6",
                TextColor = "#475e50"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.DaycareTeacher,
                RoleDisplayName = "Daycare Educators & Assistants",
                HierarchyRank = 6,
                HierarchyIcon = "✏️",
                Scope = "Classroom",
                Description = "Educators assisting in daily routines, recording care activities, and supporting child development.",
                BgColor = "#f4f6f4",
                BorderColor = "#d5ded6",
                TextColor = "#475e50"
            },
            new RoleGroup
            {
                RoleKey = RoleTemplates.Parent,
                RoleDisplayName = "Parents & Guardians",
                HierarchyRank = 7,
                HierarchyIcon = "👨‍👩‍👧",
                Scope = "Family",
                Description = "Family members with access to child milestones, daily care summaries, and classroom announcements.",
                BgColor = "#fcf1f0",
                BorderColor = "#edd1cf",
                TextColor = "#98433e"
            },
            new RoleGroup
            {
                RoleKey = "Unassigned",
                RoleDisplayName = "Unassigned Members & Staff",
                HierarchyRank = 8,
                HierarchyIcon = "👤",
                Scope = "Member",
                Description = "Registered team accounts awaiting specific role or classroom assignment.",
                BgColor = "#f8f9f5",
                BorderColor = "#e4e7df",
                TextColor = "#6c7870"
            }
        };

        // Filter and distribute users into groups
        var query = _allUsers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLowerInvariant();
            query = query.Where(u =>
                u.DisplayName.ToLowerInvariant().Contains(term) ||
                u.Email.ToLowerInvariant().Contains(term) ||
                (u.OrganizationName != null && u.OrganizationName.ToLowerInvariant().Contains(term)) ||
                (u.ClassroomName != null && u.ClassroomName.ToLowerInvariant().Contains(term)) ||
                u.AssignedRoles.Any(r => r.ToLowerInvariant().Contains(term)));
        }

        var filteredUsers = query.ToList();

        foreach (var user in filteredUsers)
        {
            // Determine highest rank matching group for this user
            var assigned = false;
            foreach (var group in hierarchyDefinitions.OrderBy(g => g.HierarchyRank))
            {
                if (group.RoleKey == "Unassigned")
                {
                    if (!user.AssignedRoles.Any())
                    {
                        group.Users.Add(user);
                        assigned = true;
                        break;
                    }
                }
                else if (user.CanonicalRoles.Any(r => r.Equals(group.RoleKey, StringComparison.OrdinalIgnoreCase)))
                {
                    group.Users.Add(user);
                    assigned = true;
                    break;
                }
            }

            if (!assigned)
            {
                var unassignedGroup = hierarchyDefinitions.First(g => g.RoleKey == "Unassigned");
                unassignedGroup.Users.Add(user);
            }
        }

        // Apply Tab Filter
        if (_selectedFilter == "Admin")
        {
            hierarchyDefinitions = hierarchyDefinitions.Where(g => 
                g.RoleKey == RoleTemplates.PlatformAdmin ||
                g.RoleKey == RoleTemplates.OrganizationOwner ||
                g.RoleKey == RoleTemplates.OrganizationAdmin ||
                g.RoleKey == RoleTemplates.BranchAdmin).ToList();
        }
        else if (_selectedFilter == "Teacher")
        {
            hierarchyDefinitions = hierarchyDefinitions.Where(g => 
                g.RoleKey == RoleTemplates.ClassroomTeacher ||
                g.RoleKey == RoleTemplates.DaycareTeacher).ToList();
        }
        else if (_selectedFilter == "Parent")
        {
            hierarchyDefinitions = hierarchyDefinitions.Where(g => g.RoleKey == RoleTemplates.Parent).ToList();
        }

        // Only show groups that have members (or all if no search query)
        _groupedRoles = hierarchyDefinitions
            .Where(g => g.Users.Any())
            .OrderBy(g => g.HierarchyRank)
            .ToList();
    }

    private IEnumerable<FilterTabs.TabItem> UserRoleTabs => new List<FilterTabs.TabItem>
    {
        new() { Text = "All Users", Value = "All", Count = _allUsers.Count },
        new() { 
            Text = "Leadership & Admins", 
            Value = "Admin", 
            Count = _allUsers.Count(u => u.CanonicalRoles.Any(r => 
                r == RoleTemplates.PlatformAdmin || 
                r == RoleTemplates.OrganizationOwner || 
                r == RoleTemplates.OrganizationAdmin || 
                r == RoleTemplates.BranchAdmin)) 
        },
        new() { 
            Text = "Educators & Teachers", 
            Value = "Teacher", 
            Count = _allUsers.Count(u => u.CanonicalRoles.Any(r => 
                r == RoleTemplates.ClassroomTeacher || 
                r == RoleTemplates.DaycareTeacher)) 
        },
        new() { 
            Text = "Families & Parents", 
            Value = "Parent", 
            Count = _allUsers.Count(u => u.CanonicalRoles.Any(r => r == RoleTemplates.Parent)) 
        }
    };

    private void SetRoleFilter(string filter)
    {
        _selectedFilter = filter;
        RecomputeGroups();
    }
}
