@page "/experiences"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject ExperienceService ExperienceService
<section id="page-experiences" class="page active">
    <PageHero 
        Eyebrow="YOUR EXPERIENCE LIBRARY" 
        Title="My Experiences" 
        Subtitle="Your daycare's growing collection. Every experience gets better with use.">
        <RightContent>
            <button id="createExperienceButton" class="primary" @onclick="OpenAddExperienceModal">
                + Create experience
            </button>
        </RightContent>
    </PageHero>
    <div class="tabs">
        <button class="tab active" data-filter="all">All</button>
        <button class="tab" data-filter="created">Created by us</button>
        <button class="tab" data-filter="platform">Platform</button>
        <button class="tab" data-filter="ai">AI created</button>
    </div>
    <div class="search-row">
        <input id="experienceSearch" class="search" placeholder="Search experiences...">
        <select id="ageFilter" class="filter">
            <option value="all">All ages</option>
            <option value="3–4">3–4</option>
            <option value="4–5">4–5</option>
        </select>
        <select id="typeFilter" class="filter">
            <option value="all">All types</option>
            <option value="Explore">Explore</option>
            <option value="Create">Create</option>
            <option value="Move">Move</option>
            <option value="Together">Together</option>
        </select>
    </div>
    <div id="experienceGrid" class="experience-grid">
        @if (_experiences != null) {
            @foreach (var exp in _experiences) {
                var type = "Experience";
                try {
                    var json = System.Text.Json.JsonDocument.Parse(exp.DnaPayload);
                    if (json.RootElement.TryGetProperty("type", out var typeElement)) {
                        type = typeElement.GetString() ?? "Experience";
                    }
                } catch {}
                <ExperienceCard Type="@type" Status="@exp.Status" Title="@exp.Title" Description="@exp.Description" Ages="3–4" Duration="15 min" Setting="Indoor" Uses="1" Version="v1" Id="@exp.Id.ToString()" />
            }
        }
    </div>
</section>
@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    private IEnumerable<Experience>? _experiences;
    private Experience _newExperience = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadExperiencesAsync();
    }
    private async Task LoadExperiencesAsync()
    {
        _experiences = await ExperienceService.GetExperiencesAsync();
    }
    private void OpenAddExperienceModal()
    {
        _newExperience = new Experience();
    }
    private void CloseDialog()
    {
    }
    private async Task SaveExperienceAsync()
    {
        if (!string.IsNullOrWhiteSpace(_newExperience.Title))
        {
            await ExperienceService.CreateExperienceAsync(_newExperience.Title, _newExperience.Description ?? "", "{}", Guid.NewGuid());
            await LoadExperiencesAsync();
        }
    }
}
