@page "/planning"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Planning
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject PlannerService PlannerService
@inject ClassroomService ClassroomService
@inject ExperienceService ExperienceService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject TimeProvider TimeProvider
@inject EventService EventService
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject NavigationManager NavigationManager

@* <PageTopbar Breadcrumb="Little Stars · Bluebirds · Age 3-4" Title="Experience Planning">
    <RightContent>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">🔔</button>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">?</button>
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #e7ddd2; display: flex; align-items: center; justify-content: center; font-weight: 750; color: #365844; margin-left: 8px; font-size: 12px;">
            BP
        </div>
    </RightContent>
</PageTopbar> *@

<section class="content" style="padding: 32px 36px 70px; max-width: 1550px; margin: auto;">

    <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px;">
        <div>
            <div style="text-transform: uppercase; letter-spacing: 1.5px; color: #789080; font-size: 10px; font-weight: 800; margin-bottom: 8px;">
                Plan the rhythm · Leave room for discovery
            </div>
            <h1 style="margin: 0; font-size: 31px; letter-spacing: -1.2px;">
                Experience Planning
            </h1>
            <div style="margin-top: 7px; color: var(--muted); font-size: 13px; line-height: 1.55; max-width: 700px;">
                Shape the month and week around meaningful experiences
                without turning childhood into a rigid schedule.
            </div>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            <select @bind="SelectedBranchId" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 12px; cursor: pointer; height: 38px;">
                @if (!_allBranches.Any())
                {
                    <option value="@Guid.Empty">Default Branch</option>
                }
                else
                {
                    @foreach (var branch in _allBranches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                }
            </select>
            <select @bind="SelectedClassroomId" disabled="@(SelectedBranchId == Guid.Empty && _allBranches.Any())" style="padding: 10px 14px; border-radius: 11px; border: 1px solid var(--line, #e1e6e0); font-weight: 650; color: #47534c; background: white; font-size: 12px; cursor: pointer; height: 38px;">
                @foreach (var cls in _allClassrooms.Where(c => !_allBranches.Any() || c.BranchId == SelectedBranchId))
                {
                    <option value="@cls.Id">@cls.Name</option>
                }
            </select>
            <button class="btn" style="border: 1px solid var(--line, #e1e6e0); background: #fff; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #47534c;">
                Preview plan
            </button>
            <button class="btn primary" @onclick="OpenPlanWizard" style="background: #456a55; border: 1px solid #456a55; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #fff;">
                + Plan Experience
            </button>
        </div>
    </div>

    <PlanningPhilosophy 
        Title="Plan the rhythm. Leave room for the children."
        Text="This plan gives teachers direction — not instructions. Children can change what happens next." />

    <PlanningControlBar 
        PeriodTitle="@_currentDate.ToString("MMMM yyyy")"
        Filters="@_filters"
        ActiveFilter="@_activeFilter"
        OnFilterSelected="FilterSelected" 
        OnPreviousClick="PreviousMonth"
        OnNextClick="NextMonth" />

    <div class="planning-layout">
        
        <div class="calendar" style="flex: 1;">
            <div class="week">
                <div>MON</div>
                <div>TUE</div>
                <div>WED</div>
                <div>THU</div>
                <div>FRI</div>
            </div>
            <div id="calendarGrid" class="calendar-grid">
                @for (int day = 1; day <= DateTime.DaysInMonth(_currentDate.Year, _currentDate.Month); day++)
                {
                    var iterDay = day;
                    var currentDate = new DateOnly(_currentDate.Year, _currentDate.Month, iterDay);
                    var dailySchedules = _schedules.Where(s => s.ScheduledDate == currentDate).OrderBy(s => s.TimeOfDay).ToList();
                    <div class="day">
                        <div class="day-number @(currentDate == DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date) ? "today" : "")">
                            @iterDay
                            @if (currentDate >= DateOnly.FromDateTime(TimeProvider.GetLocalNow().Date))
                            {
                                <button class="add-plan-btn" @onclick='() => OpenPlanWizardForDate(currentDate)'>+</button>
                            }
                        </div>
                        @* Planned Celebrations & Events *@
                        @foreach (var evt in _events.Where(e => e.EventDate == currentDate && (e.Status == "Planned" || e.Status == "Approved" || e.Status == "Published")))
                        {
                            <div class="scheduled celebration-event" style="cursor: pointer;" @onclick="() => OpenEventFromCalendar(evt)">
                                <strong style="display: flex; align-items: center; gap: 4px; color: #92400e;">
                                    <span>🎉</span>
                                    <span>@evt.Title</span>
                                </strong>
                                <span style="color: #b45309; font-weight: 600;">
                                    Celebration &middot; @(evt.StartTime?.ToString(@"hh\:mm") ?? "All Day")
                                </span>
                            </div>
                        }
                        @foreach (var schedule in dailySchedules)
                        {
                            var experience = _experiences.ContainsKey(schedule.ExperienceId) ? _experiences[schedule.ExperienceId] : null;
                            if (experience != null)
                            {
                                <div class="scheduled @(schedule.Status == "Suggested" ? "suggested" : "") @(schedule.Status == "Completed" || schedule.Status == "Closed" ? "completed" : "")" style="cursor: pointer;" @onclick="() => EditSchedule(schedule)">
                                    <strong>@experience.Title</strong>
                                    <span>
                                        @GetExperienceType(experience) &middot; @schedule.TimeOfDay
                                    </span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <div class="side-column">
            
            <SidePanel Title="Management Direction" Subtitle="Focus areas for this month">
                <ManagementDirection 
                    Label="This month"
                    Title="@_topGoal"
                    Text="Focus on experiences that incorporate this goal based on your schedule."
                    Tags="@_topGoalsList" />
            </SidePanel>

            <SidePanel Title="EnjoyEveryday Intelligence" Subtitle="Observations & AI suggestions">
                <AiPlan 
                    Title="Build on recent interests"
                    Text="@($"Children have been engaging with {_commonMaterial} recently.")"
                    ListItems="@_aiSuggestionsList"
                    ButtonText="Draft a plan around this" />
            </SidePanel>

            <SidePanel Title="Rhythm Balance" Subtitle="Current monthly mix">
                <RhythmRow Icon="🌿" Name="Explore" Count="@_exploreCount" Percentage="@((_exploreCount * 100) / Math.Max(1, _totalRhythmCount))" />
                <RhythmRow Icon="🎨" Name="Create" Count="@_createCount" Percentage="@((_createCount * 100) / Math.Max(1, _totalRhythmCount))" />
                <RhythmRow Icon="🤝" Name="Together" Count="@_togetherCount" Percentage="@((_togetherCount * 100) / Math.Max(1, _totalRhythmCount))" />
                <RhythmRow Icon="🏃" Name="Move" Count="@_moveCount" Percentage="@((_moveCount * 100) / Math.Max(1, _totalRhythmCount))" />
            </SidePanel>

            <SidePanel Title="Flexibility Guide" Subtitle="For when things change">
                <FlexibilityCard 
                    Title="Quick adaptations"
                    Text="Adaptations from your scheduled experiences:"
                    ListItems="@_adaptationsList" />
            </SidePanel>
            
        </div>
    </div>

</section>

<PlanExperienceDialog IsOpen="@_isPlanWizardOpen" DefaultClassroomId="@(_classroom?.Id)" DefaultDate="@_wizardDefaultDate" ScheduleId="@_wizardScheduleId" OnClose="ClosePlanWizard" OnPlanCreated="OnPlanCreatedFromWizard" />

@if (_isCalendarEventModalOpen && _selectedCalendarEvent != null)
{
    <div class="event-modal-backdrop" @onclick="CloseCalendarEventModal">
        <div class="event-modal-card" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #edf0ec; padding-bottom: 16px;">
                <div>
                    <div style="font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #b45309; text-transform: uppercase;">
                        Celebration & Event
                    </div>
                    <h2 style="margin: 4px 0 0 0; font-size: 22px; font-weight: 750; color: #1a251e;">
                        🎉 @_selectedCalendarEvent.Title
                    </h2>
                </div>
                <button type="button" @onclick="CloseCalendarEventModal" style="background: transparent; border: none; font-size: 20px; color: #7c877f; cursor: pointer; padding: 4px;">✕</button>
            </div>

            @* Role Badge Banner *@
            @if (IsAdmin)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 12px; padding: 10px 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 16px;">🛡️</span>
                        <span style="font-size: 12px; font-weight: 650; color: #047857;">Administrator Mode — Full editing and deletion enabled</span>
                    </div>
                    <span style="background: #10b981; color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">@_selectedCalendarEvent.Status</span>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; justify-content: space-between; background: #fefce8; border: 1px solid #fef08a; border-radius: 12px; padding: 10px 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 16px;">👁️</span>
                        <span style="font-size: 12px; font-weight: 650; color: #854d0e;">Read-Only View — View only. Only admins can edit or delete celebrations.</span>
                    </div>
                    <span style="background: #f59e0b; color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">@_selectedCalendarEvent.Status</span>
                </div>
            }

            @* Details Body *@
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @if (IsAdmin)
                {
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Event Title</label>
                        <input type="text" @bind="_selectedCalendarEvent.Title" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 10px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box;" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Date</label>
                            <input type="date" value="@_selectedCalendarEvent.EventDate.ToString("yyyy-MM-dd")" @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _selectedCalendarEvent.EventDate = d; }" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 9px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box;" />
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Location</label>
                            <input type="text" @bind="_selectedCalendarEvent.Location" placeholder="e.g. Activity Center / Room 2" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 9px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box;" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Status</label>
                            <select @bind="_selectedCalendarEvent.Status" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 9px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box; background: white;">
                                <option value="Draft">Draft</option>
                                <option value="Planned">Planned</option>
                                <option value="Approved">Approved</option>
                                <option value="Published">Published</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Time Window</label>
                            <div style="font-size: 13px; color: #47534c; padding: 9px 0;">
                                @FormatEventTiming(_selectedCalendarEvent)
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #536159;">Description</label>
                        <textarea @bind="_selectedCalendarEvent.Description" rows="3" style="border: 1px solid #e1e6e0; border-radius: 10px; padding: 10px 12px; font-size: 13px; outline: none; width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
                    </div>
                }
                else
                {
                    <div style="background: #fafbf9; border: 1px solid #edf0ec; border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Scheduled Date</div>
                                <div style="font-size: 14px; font-weight: 600; color: #1a251e; margin-top: 2px;">
                                    📅 @_selectedCalendarEvent.EventDate.ToString("MMMM dd, yyyy")
                                </div>
                            </div>
                            <div>
                                <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Location</div>
                                <div style="font-size: 14px; font-weight: 600; color: #1a251e; margin-top: 2px;">
                                    📍 @(_selectedCalendarEvent.Location ?? "Daycare Center")
                                </div>
                            </div>
                        </div>

                        <div>
                            <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Timing</div>
                            <div style="font-size: 13px; color: #47534c; margin-top: 2px;">
                                ⏰ @FormatEventTiming(_selectedCalendarEvent)
                            </div>
                        </div>

                        <div>
                            <div style="font-size: 11px; font-weight: 700; color: #7c877f; text-transform: uppercase;">Overview & Purpose</div>
                            <div style="font-size: 13px; color: #47534c; line-height: 1.5; margin-top: 4px;">
                                @(string.IsNullOrWhiteSpace(_selectedCalendarEvent.Description) ? "No detailed description provided for this celebration." : _selectedCalendarEvent.Description)
                            </div>
                        </div>
                    </div>
                }

                @* Preparation Checklist Preview *@
                @if (_selectedCalendarEventTasks.Any())
                {
                    <div style="border-top: 1px solid #edf0ec; padding-top: 14px;">
                        <div style="font-size: 12px; font-weight: 750; color: #1a251e; margin-bottom: 8px;">
                            Preparation Tasks (@_selectedCalendarEventTasks.Count(t => t.IsCompleted)/@_selectedCalendarEventTasks.Count completed)
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            @foreach (var task in _selectedCalendarEventTasks)
                            {
                                <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #47534c;">
                                    <input type="checkbox" checked="@task.IsCompleted" disabled="@(!IsAdmin)" @onchange="() => ToggleCalendarEventTask(task)" style="cursor: @(IsAdmin ? "pointer" : "default");" />
                                    <span style="@(task.IsCompleted ? "text-decoration: line-through; color: #9ca3af;" : "")">@task.Description</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Footer Action Buttons *@
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf0ec; padding-top: 16px; margin-top: 4px;">
                <div>
                    @if (IsAdmin)
                    {
                        <button type="button" @onclick="DeleteCalendarEvent" style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 11px; padding: 9px 14px; font-size: 12px; font-weight: 650; color: #dc2626; cursor: pointer;">
                            🗑️ Delete Event
                        </button>
                    }
                </div>
                <div style="display: flex; gap: 8px;">
                    <button type="button" @onclick="() => NavigateToCalendarEvent(_selectedCalendarEvent.Id)" style="background: #fff; border: 1px solid #e1e6e0; border-radius: 11px; padding: 9px 14px; font-size: 12px; font-weight: 650; color: #47534c; cursor: pointer;">
                        View Full Details &rarr;
                    </button>
                    <button type="button" @onclick="CloseCalendarEventModal" style="background: #fff; border: 1px solid #e1e6e0; border-radius: 11px; padding: 9px 14px; font-size: 12px; font-weight: 650; color: #47534c; cursor: pointer;">
                        Close
                    </button>
                    @if (IsAdmin)
                    {
                        <button type="button" @onclick="SaveCalendarEvent" style="background: #456a55; border: 1px solid #456a55; border-radius: 11px; padding: 9px 16px; font-size: 12px; font-weight: 650; color: #fff; cursor: pointer;">
                            Save Changes
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeFilter = "all";
    private bool _isPlanWizardOpen = false;
    private Guid? _wizardScheduleId;
    private Classroom? _classroom;
    private List<ExperienceSchedule> _schedules = new();
    private Dictionary<Guid, Experience> _experiences = new();
    private List<Event> _events = new();
    private bool _isCalendarEventModalOpen = false;
    private Event? _selectedCalendarEvent;
    private List<EventTask> _selectedCalendarEventTasks = new();

    private bool IsAdmin =>
        UserContext.Roles.Any(r => 
            r.Equals("PlatformAdmin", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("OrganizationOwner", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("OrganizationAdmin", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("BranchAdmin", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Administrator", StringComparison.OrdinalIgnoreCase) ||
            r.Equals("Director", StringComparison.OrdinalIgnoreCase))
        || (!UserContext.Roles.Any(r => r.Equals("Teacher", StringComparison.OrdinalIgnoreCase) || r.Equals("AssistantTeacher", StringComparison.OrdinalIgnoreCase) || r.Equals("Parent", StringComparison.OrdinalIgnoreCase)) && UserContext.HasPermission("event.manage"));


    private List<PlanningControlBar.FilterItem> _filters = new()
    {
        new PlanningControlBar.FilterItem { Text = "All", Value = "all" },
        new PlanningControlBar.FilterItem { Text = "Management", Value = "management" },
        new PlanningControlBar.FilterItem { Text = "Teacher", Value = "teacher" },
        new PlanningControlBar.FilterItem { Text = "AI", Value = "ai" },
        new PlanningControlBar.FilterItem { Text = "Free exploration", Value = "free" }
    };

    private void FilterSelected(string filter)
    {
        _activeFilter = filter;
    }

    private DateTime _currentDate;
    private DateOnly? _wizardDefaultDate;
    private List<Classroom> _allClassrooms = new();
    private List<Branch> _allBranches = new();

    private Guid _selectedBranchId;
    private Guid SelectedBranchId
    {
        get => _selectedBranchId;
        set
        {
            if (_selectedBranchId != value)
            {
                _selectedBranchId = value;
                var cls = _allClassrooms.FirstOrDefault(c => !_allBranches.Any() || c.BranchId == value);
                SelectedClassroomId = cls?.Id;
            }
        }
    }

    private Guid? _selectedClassroomId;
    private Guid? SelectedClassroomId
    {
        get => _selectedClassroomId;
        set
        {
            if (_selectedClassroomId != value)
            {
                _selectedClassroomId = value;
                _classroom = _allClassrooms.FirstOrDefault(c => c.Id == value);
                if (_classroom != null && _classroom.BranchId != _selectedBranchId && _allBranches.Any())
                {
                    _selectedBranchId = _classroom.BranchId;
                }
                _ = RefreshSchedules();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var today = TimeProvider.GetLocalNow().Date;
        _currentDate = new DateTime(today.Year, today.Month, 1);

        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org != null)
        {
            _allBranches = (await BranchService.GetBranchesAsync(org.Id)).ToList();
        }

        _allClassrooms = (await ClassroomService.GetAllClassroomsAsync()).ToList();
        
        // Select first branch and its first classroom by default
        var defaultBranch = _allBranches.FirstOrDefault();
        if (defaultBranch != null)
        {
            _selectedBranchId = defaultBranch.Id;
            _classroom = _allClassrooms.FirstOrDefault(c => c.BranchId == _selectedBranchId);
            _selectedClassroomId = _classroom?.Id;
        }

        var exps = await ExperienceService.GetExperiencesAsync();
        _experiences = exps.ToDictionary(e => e.Id);

        await LoadSchedules();
    }

    private async Task PreviousMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        await LoadSchedules();
    }

    private async Task NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        await LoadSchedules();
    }

    private async Task LoadSchedules()
    {
        if (_classroom != null)
        {
            var schedules = await PlannerService.GetMonthlyScheduleAsync(_classroom.Id, _currentDate.Year, _currentDate.Month);
            _schedules = schedules.ToList();
            CalculateDynamicCards();
        }

        try
        {
            _events = (await EventService.GetEventsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading events for planning calendar: {ex.Message}");
        }
    }

    private int _exploreCount = 0;
    private int _createCount = 0;
    private int _togetherCount = 0;
    private int _moveCount = 0;
    private int _totalRhythmCount = 1;

    private string _topGoal = "Community Building";
    private List<string> _topGoalsList = new() { "Collaboration", "Empathy" };
    
    private string _commonMaterial = "natural materials";
    private List<string> _aiSuggestionsList = new() { "Add more materials to the block area", "Plan a collaborative outdoor experience" };

    private List<string> _adaptationsList = new() { "Indoor obstacle course (Move)", "Storytime with props (Together)" };

    private void CalculateDynamicCards()
    {
        _exploreCount = 0; _createCount = 0; _togetherCount = 0; _moveCount = 0;
        var allGoals = new List<string>();
        var allMaterials = new List<string>();
        var allAdaptations = new List<string>();

        foreach (var s in _schedules)
        {
            if (_experiences.TryGetValue(s.ExperienceId, out var exp))
            {
                if (!string.IsNullOrWhiteSpace(exp.DnaPayload))
                {
                    try 
                    {
                        var dna = System.Text.Json.JsonSerializer.Deserialize<ExperienceDna>(exp.DnaPayload);
                        if (dna != null)
                        {
                            if (!string.IsNullOrWhiteSpace(dna.Challenge)) _exploreCount++;
                            if (!string.IsNullOrWhiteSpace(dna.Create)) _createCount++;
                            if (!string.IsNullOrWhiteSpace(dna.Together)) _togetherCount++;
                            if (dna.Environment != null && dna.Environment.Contains("Outdoor", StringComparison.OrdinalIgnoreCase)) _moveCount++;

                            if (dna.DevelopmentalGoals != null) allGoals.AddRange(dna.DevelopmentalGoals);
                            if (dna.Materials != null) allMaterials.AddRange(dna.Materials);
                            if (dna.ExecutionGuide?.Adaptations != null) allAdaptations.AddRange(dna.ExecutionGuide.Adaptations);
                        }
                    }
                    catch { }
                }
            }
        }

        _totalRhythmCount = _exploreCount + _createCount + _togetherCount + _moveCount;
        if (_totalRhythmCount == 0) _totalRhythmCount = 1;

        if (allGoals.Any())
        {
            var top = allGoals.GroupBy(x => x).OrderByDescending(g => g.Count()).Take(3).Select(g => g.Key).ToList();
            _topGoal = top.First();
            _topGoalsList = top;
        }
        else
        {
            _topGoal = "Community Building";
            _topGoalsList = new List<string> { "Collaboration", "Exploration" };
        }

        if (allMaterials.Any())
        {
            _commonMaterial = allMaterials.GroupBy(x => x).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key ?? "natural materials";
            _aiSuggestionsList = new List<string> 
            { 
                $"Plan an activity centered around {_commonMaterial}", 
                "Combine this with a new environment to spark curiosity" 
            };
        }

        if (allAdaptations.Any())
        {
            _adaptationsList = allAdaptations.Distinct().Take(3).ToList();
        }
        else
        {
            _adaptationsList = new List<string> { "Indoor obstacle course (Move)", "Storytime with props (Together)", "Sensory bins with water/sand (Explore)" };
        }
    }

    private async Task RefreshSchedules()
    {
        await LoadSchedules();
        StateHasChanged();
    }

    private async Task OnPlanCreatedFromWizard(Guid classroomId)
    {
        if (SelectedClassroomId != classroomId)
        {
            SelectedClassroomId = classroomId; // This setter already calls RefreshSchedules
        }
        else
        {
            await RefreshSchedules();
        }
    }

    private void OpenPlanWizard()
    {
        _wizardDefaultDate = GetDefaultPlanDate();
        _wizardScheduleId = null;
        _isPlanWizardOpen = true;
    }

    private void OpenPlanWizardForDate(DateOnly date)
    {
        _wizardDefaultDate = date;
        _wizardScheduleId = null;
        _isPlanWizardOpen = true;
    }

    private void EditSchedule(ExperienceSchedule schedule)
    {
        _wizardDefaultDate = schedule.ScheduledDate;
        _wizardScheduleId = schedule.Id;
        _isPlanWizardOpen = true;
    }

    private DateOnly GetDefaultPlanDate()
    {
        var today = DateTime.Today;
        if (today.Year == _currentDate.Year && today.Month == _currentDate.Month)
        {
            return DateOnly.FromDateTime(today);
        }
        return new DateOnly(_currentDate.Year, _currentDate.Month, 1);
    }

    private void ClosePlanWizard()
    {
        _isPlanWizardOpen = false;
        _wizardScheduleId = null;
    }

    private IEnumerable<ExperienceSchedule> GetSchedulesForDayAndPeriod(DateTime date, string period)
    {
        return _schedules.Where(s => s.ScheduledDate == DateOnly.FromDateTime(date) && s.TimeOfDay == period);
    }

    private string GetExperienceTitle(Guid expId)
    {
        return _experiences.ContainsKey(expId) ? _experiences[expId].Title : "Unknown";
    }

    private string GetExperienceType(Experience experience)
    {
        if (string.IsNullOrEmpty(experience.DnaPayload)) return "Experience";
        try 
        {
            var json = System.Text.Json.JsonDocument.Parse(experience.DnaPayload);
            if (json.RootElement.TryGetProperty("type", out var typeElement))
            {
                return typeElement.GetString() ?? "Experience";
            }
        }
        catch { }
        return "Experience";
    }

    private async Task CancelSchedule(Guid scheduleId)
    {
        var schedule = _schedules.FirstOrDefault(s => s.Id == scheduleId);
        if (schedule != null && schedule.Status != "Cancelled")
        {
            await PlannerService.CancelScheduleAsync(scheduleId);
            await RefreshSchedules();
        }
    }

    private async Task OpenEventFromCalendar(Event evt)
    {
        _selectedCalendarEvent = evt;
        try
        {
            _selectedCalendarEventTasks = (await EventService.GetTasksAsync(evt.Id)).ToList();
        }
        catch
        {
            _selectedCalendarEventTasks = new();
        }
        _isCalendarEventModalOpen = true;
    }

    private void CloseCalendarEventModal()
    {
        _isCalendarEventModalOpen = false;
        _selectedCalendarEvent = null;
        _selectedCalendarEventTasks.Clear();
    }

    private async Task ToggleCalendarEventTask(EventTask task)
    {
        if (!IsAdmin) return;
        task.IsCompleted = !task.IsCompleted;
        task.CompletedAt = task.IsCompleted ? DateTimeOffset.UtcNow : null;
        await EventService.UpdateTaskAsync(task);
    }

    private async Task SaveCalendarEvent()
    {
        if (!IsAdmin || _selectedCalendarEvent == null) return;
        await EventService.UpdateEventAsync(_selectedCalendarEvent);
        await LoadSchedules();
        CloseCalendarEventModal();
    }

    private async Task DeleteCalendarEvent()
    {
        if (!IsAdmin || _selectedCalendarEvent == null) return;
        await EventService.DeleteEventAsync(_selectedCalendarEvent.Id);
        await LoadSchedules();
        CloseCalendarEventModal();
    }

    private string FormatEventTiming(Event evt)
    {
        if (evt.StartTime == null) return "All Day Celebration";
        var start = evt.StartTime.Value.ToString(@"hh\:mm");
        if (evt.EndTime == null) return start;
        var end = evt.EndTime.Value.ToString(@"hh\:mm");
        return $"{start} - {end}";
    }

    private void NavigateToCalendarEvent(Guid id)
    {
        NavigationManager.NavigateTo($"/events/{id}");
    }
}
