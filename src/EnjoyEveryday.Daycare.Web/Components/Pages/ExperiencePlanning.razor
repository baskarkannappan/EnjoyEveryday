@page "/planning"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Planning

<PageTopbar Breadcrumb="Little Stars · Bluebirds · Age 3-4" Title="Experience Planning">
    <RightContent>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">🔔</button>
        <button class="icon-button" style="border: 1px solid var(--line, #e1e6e0); background: white; border-radius: 11px; width: 38px; height: 38px; color: var(--muted);">?</button>
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #e7ddd2; display: flex; align-items: center; justify-content: center; font-weight: 750; color: #365844; margin-left: 8px; font-size: 12px;">
            BP
        </div>
    </RightContent>
</PageTopbar>

<section class="content" style="padding: 32px 36px 70px; max-width: 1550px; margin: auto;">

    <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px;">
        <div>
            <div style="text-transform: uppercase; letter-spacing: 1.5px; color: #789080; font-size: 10px; font-weight: 800; margin-bottom: 8px;">
                Plan the rhythm · Leave room for discovery
            </div>
            <h1 style="margin: 0; font-size: 31px; letter-spacing: -1.2px;">
                Experience Planning
            </h1>
            <div style="margin-top: 7px; color: var(--muted); font-size: 13px; line-height: 1.55; max-width: 700px;">
                Shape the month and week around meaningful experiences
                without turning childhood into a rigid schedule.
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <button class="btn" style="border: 1px solid var(--line, #e1e6e0); background: #fff; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #47534c;">
                Preview plan
            </button>
            <button class="btn primary" style="background: #456a55; border: 1px solid #456a55; border-radius: 11px; padding: 10px 14px; font-size: 12px; font-weight: 650; color: #fff;">
                Publish plan
            </button>
        </div>
    </div>

    <PlanningPhilosophy 
        Title="Plan the rhythm. Leave room for the children."
        Text="This plan gives teachers direction — not instructions. Children can change what happens next." />

    <PlanningControlBar 
        PeriodTitle="Sep 14 – Sep 18"
        Filters="@_filters"
        ActiveFilter="@_activeFilter"
        OnFilterSelected="FilterSelected" />

    <div class="planning-layout">
        
        <PlanningCalendar Days="_days">
            <MorningTemplate>
                @if (context.Name == "Mon")
                {
                    <PlanningExperienceCard Title="Bug Detectives" Type="Management" Tags="@(new List<string> { "20 min", "Outdoor" })" Status="Planned" />
                    <PlanningExperienceCard Title="Little Garden" Type="Teacher" Tags="@(new List<string> { "25 min", "Create" })" Status="Adapted" />
                }
                else if (context.Name == "Tue")
                {
                    <PlanningExperienceCard Title="Our Little City" Type="Management" Tags="@(new List<string> { "30 min", "Together" })" Status="Planned" />
                }
            </MorningTemplate>
            <MidDayTemplate>
                @if (context.Name == "Wed")
                {
                    <PlanningExperienceCard Title="Shadow Puppets" Type="AI" Tags="@(new List<string> { "20 min", "Explore" })" Status="Suggested" />
                }
            </MidDayTemplate>
            <AfternoonTemplate>
                @if (context.Name == "Thu" || context.Name == "Fri")
                {
                    <PlanningExperienceCard Title="Free Exploration" Type="Free" Tags="@(new List<string> { "45 min", "Flexible" })" Status="Routine" />
                }
            </AfternoonTemplate>
        </PlanningCalendar>

        <div class="side-column">
            
            <SidePanel Title="Management Direction" Subtitle="Focus areas for Bluebirds">
                <ManagementDirection 
                    Label="This month"
                    Title="Building community"
                    Text="Focus on experiences that require children to work together."
                    Tags="@(new List<string> { "Collaboration", "Empathy", "Sharing" })" />
            </SidePanel>

            <SidePanel Title="EnjoyEveryday Intelligence" Subtitle="Observations & AI suggestions">
                <AiPlan 
                    Title="Build on recent interests"
                    Text="Children showed high engagement with construction and nature this week."
                    ListItems="@(new List<string> { "Add more natural materials to the block area", "Plan a collaborative outdoor building experience" })"
                    ButtonText="Draft a plan around this" />
            </SidePanel>

            <SidePanel Title="Rhythm Balance" Subtitle="Current weekly mix">
                <RhythmRow Icon="🌿" Name="Explore" Count="8" Percentage="32" />
                <RhythmRow Icon="🎨" Name="Create" Count="6" Percentage="24" />
                <RhythmRow Icon="🤝" Name="Together" Count="5" Percentage="20" />
                <RhythmRow Icon="🏃" Name="Move" Count="6" Percentage="24" />
            </SidePanel>

            <SidePanel Title="Flexibility Guide" Subtitle="For when things change">
                <FlexibilityCard 
                    Title="Quick adaptations"
                    Text="If children are restless or the weather changes:"
                    ListItems="@(new List<string> { "Indoor obstacle course (Move)", "Storytime with props (Together)", "Sensory bins with water/sand (Explore)" })" />
            </SidePanel>
            
        </div>
    </div>

</section>

@code {
    private string _activeFilter = "all";
    private List<PlanningControlBar.FilterItem> _filters = new()
    {
        new PlanningControlBar.FilterItem { Text = "All", Value = "all" },
        new PlanningControlBar.FilterItem { Text = "Management", Value = "management" },
        new PlanningControlBar.FilterItem { Text = "Teacher", Value = "teacher" },
        new PlanningControlBar.FilterItem { Text = "AI", Value = "ai" },
        new PlanningControlBar.FilterItem { Text = "Free exploration", Value = "free" }
    };

    private void FilterSelected(string filter)
    {
        _activeFilter = filter;
    }

    private List<PlanningCalendar.CalendarDay> _days = new()
    {
        new PlanningCalendar.CalendarDay { Name = "Mon", DateString = "14 Sep" },
        new PlanningCalendar.CalendarDay { Name = "Tue", DateString = "15 Sep" },
        new PlanningCalendar.CalendarDay { Name = "Wed", DateString = "16 Sep" },
        new PlanningCalendar.CalendarDay { Name = "Thu", DateString = "17 Sep" },
        new PlanningCalendar.CalendarDay { Name = "Fri", DateString = "18 Sep" }
    };
}
