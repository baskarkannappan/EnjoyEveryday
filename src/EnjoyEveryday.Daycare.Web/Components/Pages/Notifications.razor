@page "/notifications"
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.Daycare.Web.Services
@inject IDaycareAnnouncementService AnnouncementService
@inject IUserContext UserContext
@inject ITenantContext TenantContext
@inject IPageAuthorizationService PageAuth
@inject OrganizationService OrgService
@inject BranchService BranchService
@rendermode InteractiveServer

<PageTitle>Notifications &amp; Announcements — EnjoyEveryday</PageTitle>

<div class="content notifications-page" style="max-width: 960px; margin: 0 auto; padding: 24px 16px;">
    <PageHero Eyebrow="NOTIFICATIONS &amp; BROADCASTS"
              Title="Activity &amp; Announcements"
              Subtitle="Keep track of real-time daycare updates, official center notices, and broadcast messages to parents and educators.">
        <RightContent>
            @if (_canPost)
            {
                <button class="btn primary" @onclick="OpenComposerModal">
                    ＋ Post Announcement
                </button>
            }
        </RightContent>
    </PageHero>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="announcement-success-banner">
            <span>✓ @_successMessage</span>
            <button class="banner-close-btn" @onclick="() => _successMessage = null">✕</button>
        </div>
    }

    <!-- DAYCARE ANNOUNCEMENTS STREAM -->
    <div class="announcements-section-card">
        <div class="section-card-header">
            <div style="display: flex; gap: 12px; align-items: center;">
                <div class="section-icon-badge">
                    📢
                </div>
                <div>
                    <h3 class="section-title">Daycare Announcements</h3>
                    <p class="section-subtitle">Synced across Parent Portals, Teacher Workspaces, and Administration</p>
                </div>
            </div>
            <span class="synced-badge">⚡ Real-time Synced</span>
        </div>

        @if (_loading)
        {
            <div style="padding: 30px; text-align: center; color: var(--muted, #6c7870);">
                Loading announcements...
            </div>
        }
        else if (_announcements.Count == 0)
        {
            <div class="announcements-empty">
                <span style="font-size: 24px;">📯</span>
                <p>No active announcements posted yet.</p>
                @if (_canPost)
                {
                    <button class="btn secondary" style="margin-top: 8px;" @onclick="OpenComposerModal">
                        Create the First Announcement
                    </button>
                }
            </div>
        }
        else
        {
            <div class="announcements-stream">
                @foreach (var item in _announcements)
                {
                    <div class="announcement-row @(item.IsUrgent ? "urgent" : "")">
                        <div class="announcement-row-top">
                            <div class="announcement-tag-group">
                                <span class="announcement-tag @(item.IsUrgent ? "urgent" : "")">@item.Tag</span>
                                @if (item.IsUrgent)
                                {
                                    <span class="urgent-indicator">⚠️ URGENT</span>
                                }
                            </div>
                            <span class="announcement-timestamp">@item.CreatedAt.ToString("MMM dd, yyyy · h:mm tt")</span>
                        </div>
                        <h4 class="announcement-heading">@item.Title</h4>
                        <p class="announcement-body">@item.Content</p>
                        <div class="announcement-author-meta">
                            <span>Author: <strong>@item.AuthorName</strong> (@item.AuthorRole)</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- QUICK ACTIVITY ACCESS CARDS -->
    <div class="quick-access-card" style="margin-top: 24px;">
        <div style="display: flex; gap: 12px; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--border, #e4e7df);">
            <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e5c49); display: grid; place-items: center; font-size: 17px;">
                🔔
            </div>
            <div>
                <h3 style="margin: 0; font-size: 14.5px; font-weight: 750; color: var(--text, #26332d);">Connected Activity Feeds</h3>
                <p style="margin: 0; font-size: 12.5px; color: var(--muted, #6c7870);">Instant access to everyday classroom conversations and attendance</p>
            </div>
        </div>

        <div style="margin-top: 16px; display: flex; flex-direction: column; gap: 10px;">
            <div class="quick-link-item">
                <span style="font-size: 18px;">💬</span>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 700; font-size: 13px; color: var(--text, #26332d);">Family Conversations</span>
                        <span style="font-size: 11px; color: var(--muted, #6c7870);">Live Channel</span>
                    </div>
                    <p style="margin: 3px 0 0 0; font-size: 12px; color: var(--muted, #6c7870);">Direct educator-to-family messages for all enrolled children.</p>
                </div>
                <a href="/classroom-messages" class="btn secondary quick-btn">Open Messages</a>
            </div>

            <div class="quick-link-item">
                <span style="font-size: 18px;">☀️</span>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 700; font-size: 13px; color: var(--text, #26332d);">Classroom Daily Care &amp; Attendance</span>
                        <span style="font-size: 11px; color: var(--muted, #6c7870);">Today</span>
                    </div>
                    <p style="margin: 3px 0 0 0; font-size: 12px; color: var(--muted, #6c7870);">Check check-in/departure statuses, meals, naps, and health checks.</p>
                </div>
                <a href="/management/attendance" class="btn secondary quick-btn">Attendance</a>
            </div>
        </div>
    </div>
</div>

<!-- POST ANNOUNCEMENT MODAL -->
@if (_showComposerModal)
{
    <div class="announcement-modal-backdrop" @onclick="CloseComposerModal">
        <div class="announcement-modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <span class="modal-eyebrow">DAYCARE BROADCAST</span>
                    <h3 class="modal-title">Publish Daycare Announcement</h3>
                </div>
                <button class="close-btn" @onclick="CloseComposerModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_composerError))
                {
                    <div class="composer-error-box">
                        <span>⚠️ @_composerError</span>
                    </div>
                }

                <div class="composer-field">
                    <label class="composer-label">Announcement Title *</label>
                    <input class="composer-input" @bind="_formTitle" placeholder="e.g. Seasonal Weather Notice or Winter Celebration" />
                </div>

                <div class="composer-row">
                    <div class="composer-field" style="flex: 1;">
                        <label class="composer-label">Category / Tag</label>
                        <select class="composer-select" @bind="_formTag">
                            <option value="Notice">Notice</option>
                            <option value="Reminder">Reminder</option>
                            <option value="Weather">Weather</option>
                            <option value="Celebration">Celebration</option>
                            <option value="Health & Safety">Health &amp; Safety</option>
                            <option value="Urgent">Urgent Alert</option>
                        </select>
                    </div>

                    <div class="composer-field" style="flex: 1;">
                        <label class="composer-label">Target Audience / Campus</label>
                        <select class="composer-select" @bind="_formBranchSelection">
                            <option value="">All Branches &amp; Families</option>
                            @foreach (var b in _branches)
                            {
                                <option value="@b.Id.ToString()">@b.Name Campus</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="composer-field">
                    <label class="composer-label">Announcement Message *</label>
                    <textarea class="composer-textarea" @bind="_formContent" placeholder="Enter clear, concise details for families and staff..."></textarea>
                </div>

                <div class="composer-checkbox-wrap">
                    <input type="checkbox" id="urgentCheck" @bind="_formIsUrgent" />
                    <label for="urgentCheck" style="font-size: 12.5px; font-weight: 650; color: #991b1b; cursor: pointer;">
                        Mark as Urgent (Highlights with priority alert for parents and educators)
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseComposerModal">Cancel</button>
                <button class="btn primary" disabled="@_isPublishing" @onclick="PublishAnnouncement">
                    @(_isPublishing ? "Publishing..." : "Broadcast Announcement")
                </button>
            </div>
        </div>
    </div>
}

<style>
