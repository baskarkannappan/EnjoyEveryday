        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        color: #166534;
        font-size: 13.5px;
        font-weight: 650;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .banner-close-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #166534;
        font-size: 16px;
    }

    .announcements-section-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
        padding: 24px;
        box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));
        margin-top: 18px;
    }

    .section-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--border, #e4e7df);
    }

    .section-icon-badge {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: var(--accent-light, #e6eee9);
        color: var(--accent-dark, #3e5c49);
        display: grid;
        place-items: center;
        font-size: 19px;
    }

    .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 750;
        color: var(--text, #26332d);
    }

    .section-subtitle {
        margin: 3px 0 0 0;
        font-size: 12.5px;
        color: var(--muted, #6c7870);
    }

    .synced-badge {
        font-size: 11px;
        font-weight: 750;
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        padding: 3px 9px;
        border-radius: 20px;
    }

    .announcements-empty {
        padding: 40px 20px;
        text-align: center;
        color: var(--muted, #6c7870);
        font-size: 13.5px;
    }

    .announcements-stream {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-top: 18px;
    }

    .announcement-row {
        background: var(--surface-soft, #f8f9f5);
        border: 1px solid var(--border, #e4e7df);
        border-radius: 14px;
        padding: 16px 18px;
        transition: all 0.15s ease;
    }

    .announcement-row:hover {
        background: #ffffff;
        border-color: var(--accent, #557c6c);
        box-shadow: 0 4px 16px rgba(40, 55, 47, 0.04);
    }

    .announcement-row.urgent {
        background: #fffafa;
