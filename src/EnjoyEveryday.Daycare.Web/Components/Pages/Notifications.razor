        margin-bottom: 2px;
    }

    .modal-title {
        margin: 0;
        font-size: 16px;
        font-weight: 750;
        color: var(--text, #26332d);
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 18px;
        color: var(--muted, #6c7870);
        cursor: pointer;
    }

    .modal-body {
        padding: 22px;
