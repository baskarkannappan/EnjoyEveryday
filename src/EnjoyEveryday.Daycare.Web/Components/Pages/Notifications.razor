    /* COMPOSER MODAL */
    .announcement-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(30, 42, 36, 0.45);
        backdrop-filter: blur(4px);
        display: grid;
        place-items: center;
        z-index: 1050;
        padding: 16px;
    }

    .announcement-modal-card {
        background: var(--surface, #ffffff);
        border-radius: 18px;
        max-width: 540px;
        width: 100%;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
        border: 1px solid var(--border, #e4e7df);
        overflow: hidden;
        animation: modalFadeIn 0.18s ease-out;
    }

    .modal-header {
        padding: 18px 22px;
        background: var(--surface-soft, #f8f9f5);
        border-bottom: 1px solid var(--border, #e4e7df);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-eyebrow {
