    }

    .composer-row {
        display: flex;
        gap: 14px;
    }

    .composer-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .composer-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--text, #26332d);
    }

    .composer-input, .composer-select {
        border: 1px solid var(--border, #e4e7df);
        background: var(--surface-soft, #f8f9f5);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13.5px;
        color: var(--text, #26332d);
        outline: none;
        font-family: inherit;
    }

    .composer-textarea {
        border: 1px solid var(--border, #e4e7df);
        background: var(--surface-soft, #f8f9f5);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13.5px;
        color: var(--text, #26332d);
        outline: none;
        font-family: inherit;
        height: 110px;
        resize: vertical;
    }

    .composer-input:focus, .composer-select:focus, .composer-textarea:focus {
        border-color: var(--accent, #557c6c);
        background: #ffffff;
    }

    .composer-checkbox-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .modal-footer {
        padding: 14px 22px;
        background: var(--surface-soft, #f8f9f5);
        border-top: 1px solid var(--border, #e4e7df);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
</style>

@code {
    private List<DaycareAnnouncement> _announcements = new();
    private List<Branch> _branches = new();
    private bool _loading = true;
    private bool _canPost = false;
    private string? _successMessage;

    private bool _showComposerModal = false;
    private bool _isPublishing = false;
    private string? _composerError;

    private string _formTitle = "";
    private string _formTag = "Notice";
    private string _formContent = "";
    private string _formBranchSelection = "";
    private bool _formIsUrgent = false;

    private UserRoleProfile? _profile;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAndDataAsync();
    }

    private async Task LoadPermissionsAndDataAsync()
    {
        try
        {
            _loading = true;
            _profile = await PageAuth.GetUserProfileAsync();
            _canPost = _profile.IsOrgAdmin || _profile.IsBranchAdmin || _profile.IsLeadTeacher || _profile.IsPlatformAdmin;

            var orgId = _profile.OrganizationId != Guid.Empty ? _profile.OrganizationId : (UserContext.OrganizationId ?? Guid.Empty);
            if (orgId != Guid.Empty)
            {
                var branchList = await BranchService.GetBranchesAsync(orgId);
                _branches = branchList.Where(b => b.IsActive).ToList();
            }

            await LoadAnnouncementsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notifications] Error loading data: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAnnouncementsAsync()
    {
        var tenantId = TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId : Guid.Parse("10000000-0000-0000-0000-000000000001");
        var orgId = _profile?.OrganizationId ?? UserContext.OrganizationId;
        var list = await AnnouncementService.GetAnnouncementsAsync(tenantId, orgId);
        _announcements = list.ToList();
    }

    private void OpenComposerModal()
    {
        _composerError = null;
        _formTitle = "";
        _formTag = "Notice";
        _formContent = "";
        _formBranchSelection = "";
        _formIsUrgent = false;
        _showComposerModal = true;
    }

    private void CloseComposerModal()
    {
        _showComposerModal = false;
        _composerError = null;
    }

    private async Task PublishAnnouncement()
    {
        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _composerError = "Please enter an announcement title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formContent))
        {
            _composerError = "Please enter announcement content.";
            return;
        }

        try
        {
            _isPublishing = true;
            _composerError = null;

            var tenantId = TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId : Guid.Parse("10000000-0000-0000-0000-000000000001");
            var orgId = _profile?.OrganizationId ?? UserContext.OrganizationId;
            Guid? branchId = null;
            if (Guid.TryParse(_formBranchSelection, out var parsedBranch))
            {
                branchId = parsedBranch;
            }

            var authorName = !string.IsNullOrWhiteSpace(_profile?.DisplayName) ? _profile.DisplayName : (UserContext.Email ?? "Administration");
            var authorRole = _profile?.PrimaryRoleName ?? "Daycare Admin";

            var item = new DaycareAnnouncement
            {
                TenantId = tenantId,
                OrganizationId = orgId ?? Guid.Parse("20000000-0000-0000-0000-000000000001"),
                BranchId = branchId,
                Title = _formTitle.Trim(),
                Content = _formContent.Trim(),
                Tag = _formTag,
                IsUrgent = _formIsUrgent,
                AuthorName = authorName,
                AuthorRole = authorRole
            };

            await AnnouncementService.CreateAnnouncementAsync(item);
            _showComposerModal = false;
            _successMessage = $"Announcement '{_formTitle}' broadcast successfully to all parents and educators.";
            await LoadAnnouncementsAsync();
        }
        catch (Exception ex)
        {
            _composerError = $"Failed to broadcast announcement: {ex.Message}";
        }
        finally
        {
            _isPublishing = false;
        }
    }
}
