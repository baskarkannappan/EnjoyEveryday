@page "/notifications"
@using EnjoyEveryday.UI.Shared.Components

<PageTitle>Notifications — EnjoyEveryday</PageTitle>

<div class="content notifications-page" style="max-width: 960px; margin: 0 auto; padding: 24px 16px;">
    <PageHero Eyebrow="NOTIFICATIONS"
              Title="Activity &amp; Announcements"
              Subtitle="Keep track of real-time daycare updates, caregiver alerts, and classroom events." />

    <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 18px); padding: 20px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06)); margin-top: 24px;">
        <div style="display: flex; gap: 12px; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--border, #e4e7df);">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #3e5c49); display: grid; place-items: center; font-size: 18px;">
                🔔
            </div>
            <div>
                <h3 style="margin: 0; font-size: 15px; font-weight: 750; color: var(--text, #26332d);">All Caught Up!</h3>
                <p style="margin: 0; font-size: 13px; color: var(--muted, #6c7870);">You have no unread system announcements or alerts.</p>
            </div>
        </div>

        <div style="margin-top: 20px; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; gap: 14px; align-items: flex-start; padding: 12px; border-radius: 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df);">
                <span style="font-size: 18px;">💬</span>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 700; font-size: 13px; color: var(--text, #26332d);">Family Conversations</span>
                        <span style="font-size: 11px; color: var(--muted, #6c7870);">Live</span>
                    </div>
                    <p style="margin: 4px 0 0 0; font-size: 12px; color: var(--muted, #6c7870);">Parent messages are accessible through the dedicated messaging center.</p>
                </div>
                <a href="/classroom-messages" class="btn secondary" style="padding: 4px 10px; font-size: 12px; border-radius: 8px; text-decoration: none; color: var(--text, #26332d); border: 1px solid var(--border, #e4e7df); background: white;">Open Messages</a>
            </div>

            <div style="display: flex; gap: 14px; align-items: flex-start; padding: 12px; border-radius: 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df);">
                <span style="font-size: 18px;">☀️</span>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 700; font-size: 13px; color: var(--text, #26332d);">Classroom Daily Care</span>
                        <span style="font-size: 11px; color: var(--muted, #6c7870);">Today</span>
                    </div>
                    <p style="margin: 4px 0 0 0; font-size: 12px; color: var(--muted, #6c7870);">Check attendance and meal/nap logs for your classroom.</p>
                </div>
                <a href="/management/attendance" class="btn secondary" style="padding: 4px 10px; font-size: 12px; border-radius: 8px; text-decoration: none; color: var(--text, #26332d); border: 1px solid var(--border, #e4e7df); background: white;">Attendance</a>
            </div>
        </div>
    </div>
</div>
