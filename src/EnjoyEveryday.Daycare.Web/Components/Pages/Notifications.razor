        flex-direction: column;
        gap: 16px;
        max-height: 70vh;
        overflow-y: auto;
    }

    .composer-error-box {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 8px 12px;
        border-radius: 8px;
