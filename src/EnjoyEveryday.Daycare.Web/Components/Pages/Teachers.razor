@page "/teachers"

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject UserService UserService
@inject ITeacherService TeacherService
@inject NavigationManager NavigationManager

<PageHero 
    Eyebrow="PEOPLE" 
    Title="Teachers" 
    Subtitle="Less typing. More teaching.">
    <RightContent>
        <button id="addTeacherButton" class="primary" @onclick='() => NavigationManager.NavigateTo("/teachers/new")'>
            + Add teacher
        </button>
    </RightContent>
</PageHero>

<div id="teacherGrid" class="people-grid">
    @if (_teachers != null && _teachers.Any())
    {
        @foreach (var teacher in _teachers)
        {
            <div @onclick='() => NavigationManager.NavigateTo($"/teachers/edit/{teacher.Id}")' style="cursor: pointer;">
                <PersonCard AvatarInitials="@(teacher.FirstName?.FirstOrDefault().ToString() ?? "?")" 
                            Name="@teacher.DisplayName" 
                            Subtitle="Experience Facilitator" 
                            HighlightTitle="Today's support" 
                            HighlightText="4 experiences planned. Keep room for child-led exploration." />
            </div>
        }
    }
    else if (_teachers != null && !_teachers.Any())
    {
        <p>No teachers found. Generating sample data...</p>
    }
</div>

@code {
    private IEnumerable<User>? _teachers;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachersAsync();

        if (_teachers != null && !_teachers.Any())
        {
            await InsertSampleDataAsync();
        }
    }

    private async Task LoadTeachersAsync()
    {
        _teachers = await UserService.GetTeachersAsync();
    }

    private async Task InsertSampleDataAsync()
    {
        await UserService.CreateUserAsync("jane.doe@example.com", "Jane", "Doe", "TEMP_HASH", "Teacher");
        await UserService.CreateUserAsync("john.smith@example.com", "John", "Smith", "TEMP_HASH", "Teacher");
        await LoadTeachersAsync();
    }
}




