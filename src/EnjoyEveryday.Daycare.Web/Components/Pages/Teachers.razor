@page "/teachers"

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using System.Text.Json

@inject UserService UserService
@inject ITeacherService TeacherService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager NavigationManager
<div class="content">
    <PageHero Eyebrow="PEOPLE"
              Title="Teachers"
              Subtitle="Less typing. More teaching.">
        <RightContent>
            <button id="addTeacherButton" class="primary" @onclick='() => NavigationManager.NavigateTo("/teachers/new")'>
                + Add teacher
            </button>
        </RightContent>
    </PageHero>

    <div id="teacherGrid" class="people-grid">
        @if (_teachers != null && _teachers.Any())
        {
            @foreach (var teacher in _teachers)
            {
                <div @onclick='() => NavigationManager.NavigateTo($"/teachers/view/{teacher.UserId}")' style="cursor: pointer;">
                    <PersonCard AvatarInitials="@(teacher.FirstName?.FirstOrDefault().ToString() ?? "?")"
                                PhotoUrl="@teacher.ProfilePhotoUrl"
                                Name="@teacher.FullName"
                                SubtitleTemplate="@GetTeacherSubtitleTemplate(teacher)"
                                Status="@teacher.Status"
                                Progress="@teacher.ProfileCompletionPercentage"
                                HighlightTitle="Today's support"
                                HighlightText="4 experiences planned. Keep room for child-led exploration." />
                </div>
            }
        }
        else if (_teachers != null && !_teachers.Any())
        {
            <p>No teachers found. Click "Add teacher" to get started.</p>
        }
    </div>
</div>
@code {
    private IEnumerable<Teacher>? _teachers;
    private Dictionary<Guid, Classroom> _classrooms = new();
    private Dictionary<Guid, Branch> _branches = new();

    [Inject]
    private EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachersAsync();
        
        var classrooms = await ClassroomService.GetAllClassroomsAsync();
        _classrooms = classrooms.ToDictionary(c => c.Id);

        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = orgs.FirstOrDefault();
        if (org != null)
        {
            var branches = await BranchService.GetBranchesAsync(org.Id);
            _branches = branches.ToDictionary(b => b.Id);
        }
    }

    private async Task LoadTeachersAsync()
    {
        _teachers = await TeacherService.GetAllTeachersAsync(TenantContext.TenantId);
    }

    private RenderFragment GetTeacherSubtitleTemplate(Teacher teacher) => __builder =>
    {
        var assignedClassrooms = GetAssignedClassrooms(teacher);
        if (!assignedClassrooms.Any())
        {
            <text>Unassigned Branch • Unassigned Class</text>
        }
        else
        {
            var first = assignedClassrooms.First();
            <text>@($"{first.BranchName} • {first.ClassName}")</text>
            if (assignedClassrooms.Count > 1)
            {
                var others = string.Join("\n", assignedClassrooms.Skip(1).Select(c => $"{c.BranchName} • {c.ClassName}"));
                <span class="badge-more" title="@others" style="margin-left: 6px; background: #e5eee8; color: #52745e; padding: 2px 6px; border-radius: 10px; font-size: 10px; font-weight: 700; cursor: help;">
                    +@(assignedClassrooms.Count - 1) more
                </span>
            }
        }
    };

    private List<(string BranchName, string ClassName)> GetAssignedClassrooms(Teacher teacher)
    {
        var list = new List<(string BranchName, string ClassName)>();
        
        foreach (var cls in _classrooms.Values)
        {
            if (!string.IsNullOrWhiteSpace(cls.DraftData))
            {
                try
                {
                    var doc = JsonDocument.Parse(cls.DraftData);
                    bool assigned = false;
                    
                    if (doc.RootElement.TryGetProperty("LeadTeacher", out var ltToken))
                    {
                        var ltStr = ltToken.GetString();
                        if (ltStr == teacher.FullName) assigned = true;
                    }
                    if (!assigned && doc.RootElement.TryGetProperty("AssistantTeachers", out var atToken))
                    {
                        var atStr = atToken.GetString();
                        if (!string.IsNullOrEmpty(atStr) && atStr.Split(',').Select(s => s.Trim()).Contains(teacher.FullName))
                        {
                            assigned = true;
                        }
                    }
                    
                    if (assigned)
                    {
                        string bName = _branches.TryGetValue(cls.BranchId, out var b) ? b.Name : "Unknown Branch";
                        list.Add((bName, cls.Name));
                    }
                }
                catch { }
            }
        }

        // Fallback to teacher's own DraftData if nothing found in classrooms (for backward compatibility)
        if (!list.Any() && !string.IsNullOrWhiteSpace(teacher.DraftData))
        {
            string branchName = "Unassigned Branch";
            string className = "Unassigned Class";
            try
            {
                var doc = JsonDocument.Parse(teacher.DraftData);
                
                if (doc.RootElement.TryGetProperty("AssignedBranch", out var bToken) || doc.RootElement.TryGetProperty("assignedBranch", out bToken))
                {
                    var bStr = bToken.GetString();
                    if (Guid.TryParse(bStr, out var bId) && _branches.TryGetValue(bId, out var branch))
                    {
                        branchName = branch.Name;
                    }
                }

                if (doc.RootElement.TryGetProperty("AssignedClassroom", out var cToken) || doc.RootElement.TryGetProperty("assignedClassroom", out cToken))
                {
                    var cStr = cToken.GetString();
                    if (Guid.TryParse(cStr, out var cId) && _classrooms.TryGetValue(cId, out var cls))
                    {
                        className = cls.Name;
                        if (branchName == "Unassigned Branch" && _branches.TryGetValue(cls.BranchId, out var clsBranch))
                        {
                            branchName = clsBranch.Name; // Fallback to classroom's branch
                        }
                    }
                }
                
                if (branchName != "Unassigned Branch" || className != "Unassigned Class")
                {
                    list.Add((branchName, className));
                }
            }
            catch { }
        }

        return list;
    }
}




