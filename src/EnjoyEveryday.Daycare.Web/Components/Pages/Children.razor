@code {
    private IEnumerable<Child>? _children;
    private bool _hideAddModal = true;
    private Child _newChild = new();
    private FluentDialog _addDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadChildrenAsync();
    }

    private async Task LoadChildrenAsync()
    {
        _children = await ChildService.GetChildrenAsync();
    }

    private void OpenAddChildModal()
    {
        _newChild = new Child();
        _hideAddModal = false;
    }

    private void CloseDialog()
    {
        _hideAddModal = true;
    }

    private async Task SaveChildAsync()
    {
        if (!string.IsNullOrWhiteSpace(_newChild.FirstName) && !string.IsNullOrWhiteSpace(_newChild.LastName))
        {
            await ChildService.CreateChildAsync(_newChild.FirstName, _newChild.LastName, _newChild.DateOfBirth, null);
            _hideAddModal = true;
            await LoadChildrenAsync();
        }
    }
}
