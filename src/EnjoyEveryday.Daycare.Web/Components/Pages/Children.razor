@page "/children"

@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities

@inject ChildService ChildService
@inject NavigationManager NavigationManager

<PageHero Eyebrow="PEOPLE"
          Title="Children"
          Subtitle="See the children behind the experiences.">

    <RightContent>
        <button id="addChildButton" class="primary" @onclick="OpenAddChildModal">
            + Add child
        </button>
    </RightContent>

</PageHero>

<div id="childrenGrid" class="people-grid">

    @if (_children != null && _children.Any())
    {
        @foreach (var child in _children)
        {
            <div @onclick="() => OpenEditChildModal(child)" style="cursor: pointer;">
                <PersonCard AvatarInitials="@GetInitials(child.FirstName)"
                            PhotoUrl="@child.PhotoUrl"
                            Name="@child.FullName"
                            Subtitle="@(child.DateOfBirth.HasValue ? $"Born {child.DateOfBirth.Value:MMM yyyy}" : "Unknown Age")"
                            Progress="@child.ProfileCompletionPercentage"
                            Status="@child.EnrollmentStatus" />
            </div>
        }
    }
    else if (_children != null && !_children.Any())
    {
        <p>No children found. Generating sample data...</p>
    }

</div>

<ChildFormModal IsOpen="_isModalOpen"
                IsEditing="_isEditing"
                PhotoUrl="@_currentChild.PhotoUrl"
                @bind-FirstName="_currentChild.FirstName"
                @bind-LastName="_currentChild.LastName"
                @bind-DateOfBirth="_currentChild.DateOfBirth"
                OnClose="CloseDialog"
                OnSave="SaveChildAsync"
                OnDelete="DeleteChildAsync" />

@code {
    private IEnumerable<Child>? _children;
    private Child _currentChild = new();
    private bool _isModalOpen = false;
    private bool _isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadChildrenAsync();

        if (_children != null && !_children.Any())
        {
            await InsertSampleDataAsync();
        }
    }

    private async Task LoadChildrenAsync()
    {
        _children = await ChildService.GetChildrenAsync();
    }

    private async Task InsertSampleDataAsync()
    {
        await ChildService.CreateChildAsync("Aarav", "Patel", new DateTime(2022, 5, 12), null);
        await ChildService.CreateChildAsync("Maya", "Johnson", new DateTime(2023, 2, 20), null);
        await ChildService.CreateChildAsync("Leo", "Smith", new DateTime(2022, 11, 5), null);
        
        await LoadChildrenAsync();
    }

    private void OpenAddChildModal()
    {
        NavigationManager.NavigateTo("/children/add");
    }

    private void OpenEditChildModal(Child child)
    {
        NavigationManager.NavigateTo($"/children/edit/{child.Id}");
    }

    private void CloseDialog()
    {
        _isModalOpen = false;
    }

    private async Task SaveChildAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentChild.FirstName) ||
            string.IsNullOrWhiteSpace(_currentChild.LastName))
        {
            return;
        }

        if (_isEditing)
        {
            await ChildService.UpdateChildAsync(_currentChild);
        }
        else
        {
            await ChildService.CreateChildAsync(
                _currentChild.FirstName,
                _currentChild.LastName,
                _currentChild.DateOfBirth,
                _currentChild.ClassroomId);
        }

        await LoadChildrenAsync();
        CloseDialog();
    }

    private async Task DeleteChildAsync()
    {
        if (_currentChild.Id != Guid.Empty)
        {
            await ChildService.DeleteChildAsync(_currentChild.Id);
            await LoadChildrenAsync();
            CloseDialog();
        }
    }

    private static string GetInitials(string? firstName)
    {
        if (string.IsNullOrWhiteSpace(firstName))
            return "?";

        return firstName.Substring(0, 1).ToUpperInvariant();
    }
}
