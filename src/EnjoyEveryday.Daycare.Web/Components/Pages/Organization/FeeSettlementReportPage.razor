@page "/management/fee-reports"
@using EnjoyEveryday.UI.Shared.Components

<PageTitle>Fee Settlement &amp; Payment Reports — EnjoyEveryday</PageTitle>

<div class="content ee-fee-reports-page">
    <PageHero Eyebrow="FINANCE &amp; REPORTING"
              Title="Fee Settlement &amp; Payment Status Reports"
              Subtitle="Track child-level tuition collection, overdue balances, and verification submissions across branches.">
        <RightContent>
            <a href="/management/billing" class="btn secondary">Fee Management Board</a>
        </RightContent>
    </PageHero>

    <FeeSettlementReportComponent />
</div>

<style>
    .ee-fee-reports-page {
        max-width: 1720px;
        margin: 0 auto;
        padding: 20px;
    }
    @@media (max-width: 600px) {
        .ee-fee-reports-page {
            padding: 12px 10px !important;
        }
    }
</style>

