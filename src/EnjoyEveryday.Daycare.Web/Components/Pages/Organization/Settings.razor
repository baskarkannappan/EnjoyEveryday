@page "/settings"
@page "/organization/settings"
@page "/organization/profile"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject OrganizationService OrgService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject TenantSettingsService TenantSettingsService
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth

<div class="content">
    <PageHero Eyebrow="CONFIGURATION"
              Title="Settings"
              Subtitle="Configure your daycare experience environment.">
    </PageHero>
    <div class="settings">
        <SettingCard Title="Daycare profile"
                     Description="Name, logo, location and languages"
                     ButtonText="Configure" />
        <SettingCard Title="Experience policies"
                     Description="Age, materials and safety rules"
                     ButtonText="Configure" />
        <SettingCard Title="AI governance"
                     Description="Review and approval settings"
                     ButtonText="Configure" />

        <ApiIntegrationCard ApiKey="@_aiApiKey"
                            ApiKeyChanged="@(val => _aiApiKey = val)"
                            SaveMessage="@_saveMessage"
                            OnSave="SaveApiKeyAsync" />
    </div>
</div>

@code {
    private Organization? _org;
    private string? _aiApiKey;
    private string? _saveMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!await PageAuth.EnsureAuthorizedAsync("/settings"))
        {
            return;
        }

        var orgs = await OrgService.GetOrganizationsAsync();
        _org = orgs.FirstOrDefault();

        // Load the existing key if it exists
        var existingKey = await TenantSettingsService.GetAiApiKeyAsync(TenantContext.TenantId);
        if (!string.IsNullOrEmpty(existingKey))
        {
            _aiApiKey = existingKey;
        }
    }

    private async Task SaveApiKeyAsync()
    {
        if (!string.IsNullOrWhiteSpace(_aiApiKey))
        {
            await TenantSettingsService.SetAiApiKeyAsync(TenantContext.TenantId, _aiApiKey);
            _saveMessage = "API Key saved successfully.";

            // Clear message after 3 seconds
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                _saveMessage = null;
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (_org != null)
        {
            await OrgService.UpdateOrganizationAsync(_org);
        }
    }
}
