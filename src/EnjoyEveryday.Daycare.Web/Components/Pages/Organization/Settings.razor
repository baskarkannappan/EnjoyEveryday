@page "/settings"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject OrganizationService OrgService
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject TenantSettingsService TenantSettingsService
<div class="content">
    <PageHero Eyebrow="CONFIGURATION"
              Title="Settings"
              Subtitle="Configure your daycare experience environment.">
    </PageHero>
    <div class="settings">
        <SettingCard Title="Daycare profile"
                     Description="Name, logo, location and languages"
                     ButtonText="Configure" />
        <SettingCard Title="Experience policies"
                     Description="Age, materials and safety rules"
                     ButtonText="Configure" />
        <SettingCard Title="AI governance"
                     Description="Review and approval settings"
                     ButtonText="Configure" />

        <div style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e4e7df); border-radius: var(--radius, 16px); padding: 20px 24px; margin-top: 16px; box-shadow: var(--shadow, 0 8px 30px rgba(40, 55, 47, .06));">
            <h3 style="margin-top: 0; font-size: 16px; font-weight: 750; color: var(--text, #26332d); letter-spacing: -0.3px;">Integrations &amp; API Keys</h3>
            <p style="color: var(--muted, #6c7870); font-size: 13px; margin-bottom: 16px;">Configure third-party services and AI provider credentials for your daycare.</p>

            <div>
                <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text, #26332d); margin-bottom: 8px;">Google Gemini API Key</label>
                <div style="display: flex; gap: 8px; max-width: 600px;">
                    <input type="password" @bind="_aiApiKey" placeholder="Enter your Gemini API Key" style="flex: 1; padding: 7px 12px; border: 1px solid var(--border, #e4e7df); border-radius: 8px; font-size: 12.5px; background: var(--surface-soft, #f8f9f5); outline: none;" />
                    <button class="btn primary" @onclick="SaveApiKeyAsync">Save Key</button>
                </div>
                @if (_saveMessage != null)
                {
                    <div style="margin-top: 10px; color: var(--accent-dark, #3e6253); font-size: 12.5px; font-weight: 700;">@_saveMessage</div>
                }
            </div>
        </div>
    </div>
</div>
@code {
    private Organization? _org;
    private string? _aiApiKey;
    private string? _saveMessage;

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrgService.GetOrganizationsAsync();
        _org = orgs.FirstOrDefault();

        // Load the existing key if it exists
        var existingKey = await TenantSettingsService.GetAiApiKeyAsync(TenantContext.TenantId);
        if (!string.IsNullOrEmpty(existingKey))
        {
            _aiApiKey = existingKey;
        }
    }

    private async Task SaveApiKeyAsync()
    {
        if (!string.IsNullOrWhiteSpace(_aiApiKey))
        {
            await TenantSettingsService.SetAiApiKeyAsync(TenantContext.TenantId, _aiApiKey);
            _saveMessage = "API Key saved successfully.";

            // Clear message after 3 seconds
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                _saveMessage = null;
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (_org != null)
        {
            await OrgService.UpdateOrganizationAsync(_org);
        }
    }
}
