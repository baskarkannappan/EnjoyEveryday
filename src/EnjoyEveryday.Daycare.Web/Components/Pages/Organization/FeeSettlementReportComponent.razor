@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Domain.Repositories
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.Shared.Auth
@using EnjoyEveryday.UI.Shared.Services
@using Microsoft.JSInterop
@inject IOrgFeeManagementService FeeService
@inject IBranchRepository BranchRepo
@inject ClassroomService ClassroomService
@inject ITenantContext TenantContext
@inject IUserContext UserContext
@inject ICurrencyService CurrencyService
@inject IJSRuntime JS

<div class="ee-report-container">
    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <div class="ee-report-banner @(_bannerSuccess ? "ee-banner-ok" : "ee-banner-err")">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>@(_bannerSuccess ? "✓" : "⚠")</span>
                <span>@_bannerMessage</span>
            </div>
            <button class="ee-close-btn" @onclick="() => _bannerMessage = null" title="Dismiss">✕</button>
        </div>
    }

    <!-- FILTERS TOOLBAR -->
    <div class="ee-filter-card">
        <div class="ee-filter-grid">
            <!-- Branch Filter -->
            <div class="ee-filter-item">
                <label class="ee-filter-label">Branch</label>
                <select class="ee-filter-select" value="@(_selectedBranchId?.ToString() ?? "")" @onchange="OnBranchChangedAsync">
                    @if (_isOrgAdmin)
                    {
                        <option value="">All Branches (Organization Wide)</option>
                    }
                    @foreach (var b in _availableBranches)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>

            <!-- Classroom Filter -->
            <div class="ee-filter-item">
                <label class="ee-filter-label">Classroom</label>
                <select class="ee-filter-select" value="@(_selectedClassroomId?.ToString() ?? "")" @onchange="OnClassroomChangedAsync">
                    <option value="">All Classrooms</option>
                    @foreach (var cl in _filteredClassrooms)
                    {
                        <option value="@cl.Id">@cl.Name</option>
                    }
                </select>
            </div>

            <!-- Billing Period -->
            <div class="ee-filter-item">
                <label class="ee-filter-label">Billing Period</label>
                <select class="ee-filter-select" value="@_selectedBillingPeriod" @onchange="OnPeriodChangedAsync">
                    <option value="">All Periods (Cumulative)</option>
                    @foreach (var p in _availablePeriods)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>

            <!-- Settlement Status -->
            <div class="ee-filter-item">
                <label class="ee-filter-label">Payment Status</label>
                <select class="ee-filter-select" value="@_selectedStatus" @onchange="OnStatusChangedAsync">
                    <option value="@SettlementStatuses.All">All Statuses</option>
                    <option value="@SettlementStatuses.Paid">Paid (Fully Settled)</option>
                    <option value="@SettlementStatuses.PartiallyPaid">Partially Paid</option>
                    <option value="@SettlementStatuses.Unpaid">Unpaid (Outstanding)</option>
                    <option value="@SettlementStatuses.Overdue">Overdue Only</option>
                    <option value="@SettlementStatuses.PendingVerification">Pending Verification</option>
                    <option value="@SettlementStatuses.NotInvoiced">Not Invoiced</option>
                </select>
            </div>

            <!-- Child Search -->
            <div class="ee-filter-item" style="grid-column: span 2;">
                <label class="ee-filter-label">Search Child</label>
                <div style="display: flex; gap: 8px;">
                    <input class="ee-filter-input" placeholder="Search by child name..." value="@_searchQuery" @oninput="OnSearchInputAsync" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button class="secondary ee-btn-xs" @onclick="ClearSearchAsync">Clear</button>
                    }
                </div>
            </div>
        </div>

        <div class="ee-filter-footer">
            <!-- Status quick pills -->
            <div class="ee-pill-group">
                <button type="button" class="ee-status-pill @(_selectedStatus == SettlementStatuses.All ? "active" : "")" @onclick='() => SetStatusQuick(SettlementStatuses.All)'>
                    All (@_summary.TotalChildrenCount)
                </button>
                <button type="button" class="ee-status-pill pill-paid @(_selectedStatus == SettlementStatuses.Paid ? "active" : "")" @onclick='() => SetStatusQuick(SettlementStatuses.Paid)'>
                    Paid (@_summary.FullySettledCount)
                </button>
                <button type="button" class="ee-status-pill pill-partial @(_selectedStatus == SettlementStatuses.PartiallyPaid ? "active" : "")" @onclick='() => SetStatusQuick(SettlementStatuses.PartiallyPaid)'>
                    Partial (@_summary.PartiallySettledCount)
                </button>
                <button type="button" class="ee-status-pill pill-unpaid @(_selectedStatus == SettlementStatuses.Unpaid ? "active" : "")" @onclick='() => SetStatusQuick(SettlementStatuses.Unpaid)'>
                    Unpaid (@_summary.UnpaidCount)
                </button>
                <button type="button" class="ee-status-pill pill-overdue @(_selectedStatus == SettlementStatuses.Overdue ? "active" : "")" @onclick='() => SetStatusQuick(SettlementStatuses.Overdue)'>
                    Overdue (@_summary.OverdueCount)
                </button>
                <button type="button" class="ee-status-pill pill-pending @(_selectedStatus == SettlementStatuses.PendingVerification ? "active" : "")" @onclick='() => SetStatusQuick(SettlementStatuses.PendingVerification)'>
                    Pending Verif (@_summary.PendingVerificationCount)
                </button>
            </div>

            <div style="display: flex; gap: 8px;">
                <button class="secondary" @onclick="LoadReportAsync" disabled="@_isLoading">
                    @(_isLoading ? "Refreshing..." : "↻ Refresh")
                </button>
                <button class="secondary" @onclick="ExportCsvAsync" disabled="@(!_summary.Items.Any())">
                    ↓ Export CSV
                </button>
            </div>
        </div>
    </div>

    <!-- KPI SUMMARY CARDS -->
    <div class="ee-kpi-grid">
        <div class="ee-kpi-card">
            <span class="ee-kpi-label">TOTAL INVOICED</span>
            <div class="ee-kpi-val ee-tnum" style="color: var(--text, #26332d);">@FormatMoney(_summary.TotalInvoiced, _currency)</div>
            <span class="ee-kpi-sub">@_summary.TotalChildrenCount child record(s)</span>
        </div>
        <div class="ee-kpi-card">
            <span class="ee-kpi-label">TOTAL COLLECTED (PAID)</span>
            <div class="ee-kpi-val ee-tnum" style="color: #2e7d32;">@FormatMoney(_summary.TotalCollected, _currency)</div>
            <span class="ee-kpi-sub">@(_summary.TotalInvoiced > 0 ? $"{Math.Round((_summary.TotalCollected / _summary.TotalInvoiced) * 100, 1)}% collection rate" : "0.0% collection rate")</span>
        </div>
        <div class="ee-kpi-card">
            <span class="ee-kpi-label">OUTSTANDING BALANCE</span>
            <div class="ee-kpi-val ee-tnum" style="color: #c62828;">@FormatMoney(_summary.TotalOutstanding, _currency)</div>
            <span class="ee-kpi-sub">@_summary.UnpaidCount unpaid / @_summary.OverdueCount overdue</span>
        </div>
        <div class="ee-kpi-card">
            <span class="ee-kpi-label">PENDING VERIFICATION</span>
            <div class="ee-kpi-val ee-tnum" style="color: #b7791f;">@FormatMoney(_summary.TotalPendingVerification, _currency)</div>
            <span class="ee-kpi-sub">@_summary.PendingVerificationCount submission(s) awaiting review</span>
        </div>
    </div>

    <!-- NESTED GRID TABLE -->
    <div class="ee-grid-card">
        @if (_isLoading)
        {
            <div style="padding: 48px; text-align: center; color: var(--muted, #6c7870);">
                <div style="font-size: 24px; margin-bottom: 8px;">⏳</div>
                <strong style="font-size: 14px;">Loading settlement &amp; payment reports...</strong>
            </div>
        }
        else if (!_summary.Items.Any())
        {
            <div style="padding: 48px; text-align: center; color: var(--muted, #6c7870);">
                <div style="font-size: 28px; margin-bottom: 8px;">📋</div>
                <h4 style="margin: 0 0 6px 0; color: var(--text, #26332d); font-weight: 750;">No fee records found</h4>
                <p style="margin: 0; font-size: 13.5px;">No child tuition records match the selected branch, classroom, period, or status filters.</p>
            </div>
        }
        else
        {
            <div class="ee-table-wrapper">
                <table class="ee-nested-table">
                    <thead>
                        <tr>
                            <th style="width: 44px; text-align: center;"></th>
                            <th>Child</th>
                            <th>Classroom / Branch</th>
                            <th style="text-align: right;">Invoiced</th>
                            <th style="text-align: right;">Paid</th>
                            <th style="text-align: right;">Balance</th>
                            <th style="text-align: center;">Status</th>
                            <th style="text-align: right; width: 140px;">Breakdown</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _summary.Items)
                        {
                            var isExpanded = _expandedChildIds.Contains(item.ChildId);
                            var curr = string.IsNullOrWhiteSpace(item.Currency) ? _currency : item.Currency;
                            var activeSubTab = GetChildDetailTab(item.ChildId);
                            <tr class="ee-master-row @(isExpanded ? "expanded" : "")" @onclick="() => ToggleExpand(item.ChildId)">
                                <td style="text-align: center;">
                                    <span class="ee-chevron @(isExpanded ? "open" : "")">▶</span>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div class="ee-avatar">
                                            @GetInitials(item.ChildName)
                                        </div>
                                        <div>
                                            <div class="ee-child-name">@item.ChildName</div>
                                            @if (item.PendingVerificationAmount > 0)
                                            {
                                                <span class="ee-badge-amber" style="margin-top: 3px;" title="Has pending verification payments">
                                                    ⏳ @FormatMoney(item.PendingVerificationAmount, curr) pending
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 3px;">
                                        <span class="ee-classroom-pill">@item.ClassroomName</span>
                                        <span class="ee-branch-label">@item.BranchName</span>
                                    </div>
                                </td>
                                <td style="text-align: right; font-weight: 700; font-size: 14px;" class="ee-tnum">
                                    @FormatMoney(item.TotalInvoiced, curr)
                                </td>
                                <td style="text-align: right; color: #2e7d32; font-weight: 750; font-size: 14px;" class="ee-tnum">
                                    @FormatMoney(item.TotalPaid, curr)
                                </td>
                                <td style="text-align: right; font-weight: 800; font-size: 14px; color: @(item.BalanceDue > 0 ? "#c62828" : "#2e7d32");" class="ee-tnum">
                                    @FormatMoney(item.BalanceDue, curr)
                                    @if (item.BalanceDue == 0 && item.TotalPaid > 0)
                                    {
                                        <div style="font-size: 11px; font-weight: 600; color: #2e7d32; margin-top: 1px;">✓ Settled</div>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @RenderStatusBadge(item.SettlementStatus)
                                </td>
                                <td style="text-align: right;">
                                    <button class="ee-breakdown-btn @(isExpanded ? "open" : "")" @onclick:stopPropagation="true" @onclick="() => ToggleExpand(item.ChildId)">
                                        @(isExpanded ? "▲ Hide" : $"▼ Breakdown ({item.Invoices.Count})")
                                    </button>
                                </td>
                            </tr>

                            @if (isExpanded)
                            {
                                <tr class="ee-detail-row">
                                    <td colspan="8">
                                        <div class="ee-detail-card">
                                            <!-- Detail Summary & Tab Switcher Bar -->
                                            <div class="ee-detail-toolbar">
                                                <div class="ee-detail-stats">
                                                    <span class="ee-detail-stat"><strong>@item.Invoices.Count</strong> Invoices Issued</span>
                                                    <span class="ee-stat-sep">·</span>
                                                    <span class="ee-detail-stat"><strong>@item.Payments.Count</strong> Payments Recorded</span>
                                                    <span class="ee-stat-sep">·</span>
                                                    <span class="ee-detail-stat">Total Billed: <strong>@FormatMoney(item.TotalInvoiced, curr)</strong></span>
                                                    <span class="ee-stat-sep">·</span>
                                                    <span class="ee-detail-stat">Outstanding: <strong style="color: @(item.BalanceDue > 0 ? "#c62828" : "#2e7d32");">@FormatMoney(item.BalanceDue, curr)</strong></span>
                                                </div>
                                                <div class="ee-sub-tab-bar">
                                                    <button type="button" class="ee-sub-tab-btn @(activeSubTab == "Invoices" ? "active" : "")"
                                                            @onclick:stopPropagation="true" @onclick='() => SetChildDetailTab(item.ChildId, "Invoices")'>
                                                        📄 Tuition Invoices (@item.Invoices.Count)
                                                    </button>
                                                    <button type="button" class="ee-sub-tab-btn @(activeSubTab == "Payments" ? "active" : "")"
                                                            @onclick:stopPropagation="true" @onclick='() => SetChildDetailTab(item.ChildId, "Payments")'>
                                                        💳 Payment History (@item.Payments.Count)
                                                    </button>
                                                    <button type="button" class="ee-sub-tab-btn @(activeSubTab == "All" ? "active" : "")"
                                                            @onclick:stopPropagation="true" @onclick='() => SetChildDetailTab(item.ChildId, "All")'>
                                                        📋 View Both
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Invoices Sub-Section -->
                                            @if (activeSubTab == "Invoices" || activeSubTab == "All")
                                            {
                                                <div class="ee-sub-section">
                                                    <div class="ee-sub-header">
                                                        <div style="display: flex; align-items: center; gap: 8px;">
                                                            <span style="font-size: 15px;">📄</span>
                                                            <h5>Tuition Invoices (@item.Invoices.Count)</h5>
                                                        </div>
                                                    </div>
                                                    @if (!item.Invoices.Any())
                                                    {
                                                        <div class="ee-empty-sub">No tuition invoices issued for this child.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="ee-sub-table-wrapper">
                                                            <table class="ee-sub-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="width: 32%;">Invoice &amp; Plan</th>
                                                                        <th style="width: 20%;">Issue / Due Dates</th>
                                                                        <th style="width: 14%; text-align: right;">Amount</th>
                                                                        <th style="width: 14%; text-align: right;">Paid</th>
                                                                        <th style="width: 10%; text-align: right;">Balance</th>
                                                                        <th style="width: 10%; text-align: center;">Status</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var inv in item.Invoices)
                                                                    {
                                                                        var invCurr = string.IsNullOrWhiteSpace(inv.Currency) ? curr : inv.Currency;
                                                                        <tr>
                                                                            <td>
                                                                                <div class="ee-inv-num">@(string.IsNullOrWhiteSpace(inv.InvoiceNumber) ? "-" : $"#{inv.InvoiceNumber}")</div>
                                                                                <div class="ee-inv-meta">
                                                                                    <span class="ee-period-badge">@(string.IsNullOrWhiteSpace(inv.BillingPeriod) ? "-" : inv.BillingPeriod)</span>
                                                                                    <span class="ee-sub-pill">@(string.IsNullOrWhiteSpace(inv.FeeMethod) ? (inv.FeePlanName ?? "Tuition") : inv.FeeMethod)</span>
                                                                                </div>
                                                                                @if (inv.Installments?.Any() == true)
                                                                                {
                                                                                    <div class="ee-installment-bar">
                                                                                        <span class="ee-inst-label">Installments:</span>
                                                                                        @foreach (var inst in inv.Installments)
                                                                                        {
                                                                                            <span class="ee-inst-chip">
                                                                                                <strong>#@inst.InstallmentNumber:</strong> @FormatMoney(inst.AmountDue, invCurr)
                                                                                                <span class="ee-inst-due">· Due @inst.DueDate</span>
                                                                                            </span>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            </td>
                                                                            <td>
                                                                                <div class="ee-date-stack">
                                                                                    <div><span class="ee-date-lbl">Issued:</span> @FormatDate(inv.IssueDate)</div>
                                                                                    <div><span class="ee-date-lbl">Due:</span> @FormatDate(inv.DueDate)</div>
                                                                                </div>
                                                                            </td>
                                                                            <td style="text-align: right; font-weight: 700;" class="ee-tnum">
                                                                                @FormatMoney(inv.EffectivePayable, invCurr)
                                                                            </td>
                                                                            <td style="text-align: right; color: #2e7d32; font-weight: 700;" class="ee-tnum">
                                                                                @FormatMoney(inv.AmountPaid, invCurr)
                                                                            </td>
                                                                            <td style="text-align: right; font-weight: 800; color: @(inv.BalanceDue > 0 ? "#c62828" : "#2e7d32");" class="ee-tnum">
                                                                                @FormatMoney(inv.BalanceDue, invCurr)
                                                                            </td>
                                                                            <td style="text-align: center;">
                                                                                @RenderInvoiceStatusBadge(inv.Status)
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <!-- Payments Sub-Section -->
                                            @if (activeSubTab == "Payments" || activeSubTab == "All")
                                            {
                                                <div class="ee-sub-section" style="@(activeSubTab == "All" ? "margin-top: 18px;" : "")">
                                                    <div class="ee-sub-header">
                                                        <div style="display: flex; align-items: center; gap: 8px;">
                                                            <span style="font-size: 15px;">💳</span>
                                                            <h5>Payment Transactions &amp; Verification History (@item.Payments.Count)</h5>
                                                        </div>
                                                    </div>
                                                    @if (!item.Payments.Any())
                                                    {
                                                        <div class="ee-empty-sub">No payment transactions recorded for this child.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="ee-sub-table-wrapper">
                                                            <table class="ee-sub-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="width: 22%;">Payment Date &amp; Method</th>
                                                                        <th style="width: 26%;">Target Invoice &amp; Reference</th>
                                                                        <th style="width: 14%; text-align: right;">Amount Paid</th>
                                                                        <th style="width: 24%;">Verification &amp; Auditor</th>
                                                                        <th style="width: 14%; text-align: right;">Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var p in item.Payments)
                                                                    {
                                                                        var payCurr = string.IsNullOrWhiteSpace(p.Currency) ? curr : p.Currency;
                                                                        <tr>
                                                                            <td>
                                                                                <div style="font-weight: 700; color: var(--text, #26332d); font-size: 13.5px;">
                                                                                    @FormatDate(p.PaymentDate, includeTime: true)
                                                                                </div>
                                                                                <div style="margin-top: 4px;">
                                                                                    <span class="ee-method-badge">@FormatMethod(p.Method)</span>
                                                                                </div>
                                                                            </td>
                                                                            <td>
                                                                                <div style="font-family: monospace; font-weight: 750; color: var(--accent-dark, #31523c); font-size: 13px;">
                                                                                    @(string.IsNullOrWhiteSpace(p.InvoiceNumber) ? "-" : $"#{p.InvoiceNumber}")
                                                                                </div>
                                                                                @if (!string.IsNullOrWhiteSpace(p.TransactionId))
                                                                                {
                                                                                    <div class="ee-ref-pill">Txn: @p.TransactionId</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(p.PaymentReference) && p.PaymentReference != p.TransactionId)
                                                                                {
                                                                                    <div class="ee-tiny-muted" style="margin-top: 2px;">Ref: @p.PaymentReference</div>
                                                                                }
                                                                            </td>
                                                                            <td style="text-align: right;" class="ee-tnum">
                                                                                <span style="font-size: 15px; font-weight: 800; color: #2e7d32;">
                                                                                    + @FormatMoney(p.Amount, payCurr)
                                                                                </span>
                                                                            </td>
                                                                            <td>
                                                                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                                                    @if (p.Status == "Completed" && p.IsVerified)
                                                                                    {
                                                                                        <span class="ee-badge-green">✓ Verified</span>
                                                                                    }
                                                                                    else if (p.Status == "PendingVerification")
                                                                                    {
                                                                                        <span class="ee-badge-amber">⏳ Pending Review</span>
                                                                                    }
                                                                                    else if (p.Status == "Rejected")
                                                                                    {
                                                                                        <span class="ee-badge-red">✕ Rejected</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="ee-sub-pill">@p.Status</span>
                                                                                    }
                                                                                </div>
                                                                                @if (!string.IsNullOrWhiteSpace(p.VerifiedBy))
                                                                                {
                                                                                    <div class="ee-auditor-line" title="@p.VerifiedBy">
                                                                                        By <strong>@FormatAuditor(p.VerifiedBy)</strong>
                                                                                        @if (p.VerifiedAt.HasValue && p.VerifiedAt.Value.Year > 1)
                                                                                        {
                                                                                            <span> · @FormatDate(p.VerifiedAt.Value, includeTime: true)</span>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(p.Notes))
                                                                                {
                                                                                    <div class="ee-note-tag" title="@p.Notes">
                                                                                        @CleanNote(p.Notes)
                                                                                    </div>
                                                                                }
                                                                            </td>
                                                                            <td style="text-align: right;">
                                                                                @if (p.Status == "PendingVerification")
                                                                                {
                                                                                    <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                                                                        <button class="primary ee-btn-xs" @onclick="() => VerifyPaymentInlineAsync(p.Id)" title="Verify this payment">
                                                                                            ✓ Verify
                                                                                        </button>
                                                                                        <button class="secondary ee-btn-xs" style="color: #9b2c2c;" @onclick="() => RejectPaymentInlineAsync(p.Id)" title="Reject this payment">
                                                                                            ✕ Reject
                                                                                        </button>
                                                                                    </div>
                                                                                }
                                                                                else if (p.IsVerified)
                                                                                {
                                                                                    <span class="ee-confirmed-tag">✓ Confirmed</span>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .ee-report-container {
        font-family: var(--ee-font, "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
        color: var(--text, #26332d);
    }

    .ee-report-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        font-size: 13px;
        border-radius: 8px;
    }

    .ee-banner-ok {
        background: var(--accent-light, #e6eee9);
        border: 1px solid #c8dacd;
        color: var(--accent-dark, #31523c);
        font-weight: 500;
    }

    .ee-banner-err {
        background: #fff5f5;
        border: 1px solid #fed7d7;
        color: #9b2c2c;
        font-weight: 500;
    }

    .ee-close-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        color: inherit;
        opacity: 0.7;
    }
    .ee-close-btn:hover { opacity: 1; }

    /* FILTERS CARD */
    .ee-filter-card {
        background: var(--surface, #ffffff);
        border: 1px solid var(--border, #e4e7df);
        border-radius: var(--radius, 18px);
