@page "/classrooms/view/{Id:guid}"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.ClassroomWizard
@using System.Text.Json

@inject ClassroomService ClassroomService
@inject ExecutionService ExecutionService
@inject ExperienceService ExperienceService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Classroom Profile — EnjoyEveryday</PageTitle>

<PageHero 
    Eyebrow="ENVIRONMENT" 
    Title="Classroom Profile" 
    Subtitle="Read-only view of the classroom's configuration.">
    <RightContent>
        <button class="secondary" @onclick='() => NavigationManager.NavigateTo("/classrooms")'>
            Back to List
        </button>
        <button class="secondary" style="color: #dc3545; border-color: #dc3545;" @onclick="DeleteClassroom">
            Delete
        </button>
        <button class="primary" @onclick='() => NavigationManager.NavigateTo($"/classrooms/edit/{Id}")'>
            Edit Profile
        </button>
    </RightContent>
</PageHero>

<div class="content" style="max-width: 960px; margin: 0 auto; padding-bottom: 40px;">
    @if (_isLoading)
    {
        <LoadingState Message="Loading classroom profile..." />
    }
    else if (_classroom == null)
    {
        <EmptyState Icon="🏫"
                    Title="Classroom not found"
                    Description="We couldn't find the requested classroom configuration."
                    ActionText="Back to Classrooms"
                    OnAction='() => NavigationManager.NavigateTo("/classrooms")' />
    }
    else
    {
        <ClassroomProfileCard Classroom="_classroom"
                              Model="_model"
                              ExperienceHistory="_experienceHistory"
                              ExperiencesDict="_experiencesDict" />
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private Classroom? _classroom;
    private ClassroomWizardModel _model = new();
    private List<ExperienceSession>? _experienceHistory;
    private Dictionary<Guid, string> _experiencesDict = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _classroom = await ClassroomService.GetClassroomByIdAsync(Id);
            
            if (_classroom != null && !string.IsNullOrWhiteSpace(_classroom.DraftData))
            {
                try
                {
                    _model = JsonSerializer.Deserialize<ClassroomWizardModel>(_classroom.DraftData) ?? new();
                }
                catch
                {
                    // Fallback
                    _model.Name = _classroom.Name;
                    _model.AgeGroup = _classroom.AgeGroup ?? "3-4 years";
                    _model.Capacity = _classroom.Capacity;
                    _model.Environment = _classroom.Environment;
                    _model.ClassroomType = _classroom.ClassroomType ?? "Preschool";
                }
            }
            else if (_classroom != null)
            {
                _model.Name = _classroom.Name;
                _model.AgeGroup = _classroom.AgeGroup ?? "3-4 years";
                _model.Capacity = _classroom.Capacity;
                _model.Environment = _classroom.Environment;
                _model.ClassroomType = _classroom.ClassroomType ?? "Preschool";
            }
            if (_classroom != null)
            {
                _experienceHistory = (await ExecutionService.GetClassroomExperienceHistoryAsync(Id)).ToList();
                var exps = await ExperienceService.GetExperiencesAsync();
                _experiencesDict = exps.ToDictionary(e => e.Id, e => e.Title);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteClassroom()
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this classroom? This action cannot be undone.");
        if (confirmed)
        {
            await ClassroomService.DeleteClassroomAsync(Id);
            NavigationManager.NavigateTo("/classrooms");
        }
    }
}
