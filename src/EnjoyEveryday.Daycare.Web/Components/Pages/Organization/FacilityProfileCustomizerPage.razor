@page "/organization/profile-customizer"
@page "/organization/profile-customizer/{BranchId:guid}"
@page "/organization/inquiries"
@page "/organization/inquiries/{BranchId:guid}"
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Facility
@inject NavigationManager Navigation

<PageTitle>About Us &amp; Contact Us Customizer — EnjoyEveryday</PageTitle>

<div class="content">
    <PageHero Eyebrow="ORGANIZATION &amp; CAMPUS IDENTITY"
              Title="Facility Profile &amp; Contact Us"
              Subtitle="Customize your organization and branch identity, logo, motto, campus photos, location, and manage public contact inquiries.">
        <RightContent>
            <a href="/organization/branch-info" class="btn secondary">👁️ View Public Page</a>
            <a href="/management/dashboard" class="btn secondary">&larr; Dashboard</a>
        </RightContent>
    </PageHero>

    <FacilityProfileEditorView DefaultBranchId="BranchId" InitialTab="@GetInitialTab()" />
</div>

@code {
    [Parameter]
    public Guid? BranchId { get; set; }

    private string GetInitialTab()
    {
        var uri = Navigation.Uri;
        if (uri.Contains("/inquiries", StringComparison.OrdinalIgnoreCase))
        {
            return "inquiries";
        }
        return "editor";
    }
}

