@page "/teachers/view/{Id:guid}"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.TeacherWizard
@using System.Text.Json

@using EnjoyEveryday.UI.Shared.Components.Users
@using EnjoyEveryday.Shared.Authorization

@inject UserService UserService
@inject ITeacherService TeacherService
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Application.Services.ExecutionService ExecutionService
@inject EnjoyEveryday.Application.Services.ExperienceService ExperienceService
@inject IJSRuntime JSRuntime
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject EnjoyEveryday.Domain.Repositories.IAccessScopeRepository AccessScopeRepo
@inject EnjoyEveryday.UI.Shared.Services.IAppNotificationService NotificationService

<PageHero 
    Eyebrow="PEOPLE" 
    Title="Teacher Profile" 
    Subtitle="Read-only view of the teacher's profile.">
    <RightContent>
        <button class="secondary" @onclick='() => NavigationManager.NavigateTo("/teachers")'>
            Back to List
        </button>
        @if (_canManage)
        {
            @if (_teacher?.UserId.HasValue == true && !_isLeadTeacher)
            {
                <button class="secondary" @onclick="() => _showPromoteModal = true" style="border-color: var(--accent, #557c6c); color: var(--accent-dark, #31523c); font-weight: 700;">
                    🎓 Promote to Lead
                </button>
            }
            @if (_teacher?.UserId.HasValue == true)
            {
                <button class="secondary" @onclick="() => _showManageClassroomsModal = true" style="font-weight: 650;">
                    🏫 Manage Classrooms
                </button>
            }
            <button class="secondary" style="color: #dc3545; border-color: #dc3545;" @onclick="DeleteTeacher">
                Delete
            </button>
            <button class="primary" @onclick='() => NavigationManager.NavigateTo($"/teachers/edit/{Id}")'>
                Edit Profile
            </button>
        }
    </RightContent>
</PageHero>

<div class="content">
    <!-- FLOATING TOAST -->
    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <div style="position: fixed; bottom: 24px; right: 24px; z-index: 10000; background: #263a32; color: white; padding: 14px 20px; border-radius: 0px; box-shadow: 0 8px 30px rgba(0,0,0,0.25); display: flex; align-items: center; gap: 12px; font-weight: 650; font-size: 13px;">
            <span style="font-size: 16px;">✨</span>
            <span>@_toastMessage</span>
            <button type="button" @onclick="() => _toastMessage = null" style="background: none; border: none; color: white; cursor: pointer; font-size: 16px; margin-left: 12px; opacity: 0.8;">✕</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successBanner))
    {
        <div style="background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; color: var(--accent-dark, #31523c); padding: 12px 16px; font-size: 13px; font-weight: 700; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
            <span>✨ @_successBanner</span>
            <button type="button" @onclick="() => _successBanner = null" style="background: none; border: none; cursor: pointer; color: var(--accent-dark, #31523c); font-size: 16px;">✕</button>
        </div>
    }

    @if (_isLoading)
    {
        <LoadingState Message="Loading educator profile..." />
    }
    else if (_teacher == null)
    {
        <EmptyState Title="Teacher Not Found" Description="We could not find the requested educator profile. It may have been removed." />
    }
    else
    {
        <TeacherProfileCard Teacher="@_teacher" Model="@_model" />
    }

    @if (_teacher?.UserId.HasValue == true)
    {
        <PromoteTeacherModal IsOpen="@_showPromoteModal"
                             UserId="@_teacher.UserId.Value"
                             TeacherName="@_teacher.FullName"
                             TeacherEmail="@_teacherUserEmail"
                             CurrentRole="@(_isLeadTeacher ? "Lead Teacher" : "Teacher")"
                             OnClose="() => _showPromoteModal = false"
                             OnPromoted="HandlePromoted" />

        <ManageTeacherClassroomsModal IsOpen="@_showManageClassroomsModal"
                                      UserId="@_teacher.UserId.Value"
                                      TeacherName="@_teacher.FullName"
                                      TeacherEmail="@_teacherUserEmail"
                                      TeacherRole="@(_isLeadTeacher ? "Lead Teacher" : "Teacher")"
                                      OnClose="() => _showManageClassroomsModal = false"
                                      OnSaved="HandleClassroomsSaved" />
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private bool _canManage = false;
    private bool _isLeadTeacher = false;
    private string _teacherUserEmail = "";
    private bool _showPromoteModal = false;
    private bool _showManageClassroomsModal = false;
    private string? _successBanner;
    private string? _toastMessage;
    private Teacher? _teacher;
    private TeacherCreationWizard.TeacherWizardModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await PageAuth.GetUserProfileAsync();
            _canManage = profile.IsOrgAdmin || profile.IsBranchAdmin;

            var tenantId = TenantContext.TenantId;
            var orgId = profile.OrganizationId != Guid.Empty ? profile.OrganizationId : (Guid?)null;

            // 1. Direct lookup by teacher id or user id in active tenant
            _teacher = await TeacherService.GetTeacherByIdAsync(tenantId, Id);

            // 2. If not found, check organization teacher list
            if (_teacher == null)
            {
                var allTeachers = (await TeacherService.GetAllTeachersAsync(tenantId, orgId)).ToList();
                _teacher = allTeachers.FirstOrDefault(t => t.Id == Id || t.UserId == Id);
            }

            // 3. Fallback to user lookup if teacher profile linked to user in another tenant
            if (_teacher == null)
            {
                var user = await UserService.GetUserByIdAsync(Id);
                if (user != null)
                {
                    var userTeachers = await TeacherService.GetAllTeachersAsync(user.TenantId, orgId);
                    _teacher = userTeachers.FirstOrDefault(t => t.UserId == user.Id);
                }
            }
                
            if (_teacher != null)
            {
                if (_teacher.UserId.HasValue)
                {
                    var user = await UserService.GetUserByIdAsync(_teacher.UserId.Value);
                    _teacherUserEmail = user?.Email ?? "";

                    if (orgId.HasValue)
                    {
                        var roles = await AccessScopeRepo.GetOrganizationRoleNamesAsync(tenantId, orgId.Value, _teacher.UserId.Value);
                        _isLeadTeacher = roles.Any(r => r.Equals(RoleTemplates.LeadTeacher, StringComparison.OrdinalIgnoreCase));
                    }
                }

                if (!string.IsNullOrWhiteSpace(_teacher.DraftData))
                {
                    try
                    {
                        _model = JsonSerializer.Deserialize<TeacherCreationWizard.TeacherWizardModel>(_teacher.DraftData) ?? new();
                    }
                    catch
                    {
                        // Fallback if deserialization fails
                    }
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandlePromoted(string message)
    {
        _showPromoteModal = false;
        _successBanner = message;
        _toastMessage = message;
        _isLeadTeacher = true;
        await NotificationService.ShowSuccessAsync(message);
        await OnInitializedAsync();
        StateHasChanged();
    }

    private async Task HandleClassroomsSaved(string message)
    {
        _showManageClassroomsModal = false;
        _successBanner = message;
        _toastMessage = message;
        await NotificationService.ShowSuccessAsync(message);
        await OnInitializedAsync();
        StateHasChanged();
    }

    private async Task DeleteTeacher()
    {
        if (!_canManage) return;

        if (_teacher != null)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this teacher? This action cannot be undone.");
            if (confirmed)
            {
                await TeacherService.DeleteTeacherAsync(_teacher.TenantId, _teacher.Id);
                NavigationManager.NavigateTo("/teachers");
            }
        }
    }
}
