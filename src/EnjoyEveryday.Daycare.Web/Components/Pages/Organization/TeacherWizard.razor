@page "/teachers/new"
@page "/teachers/edit/{Id:guid}"
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.Infrastructure.Data
@using EnjoyEveryday.Shared.Data
@using EnjoyEveryday.UI.Shared.Components

@inject UserService UserService
@inject ITeacherService TeacherService
@inject ClassroomService ClassroomService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.ITenantContext TenantContext
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext
@inject SystemProvisioningService SystemProvisioning
@inject EnjoyEveryday.Daycare.Web.Services.IPageAuthorizationService PageAuth
@inject IDbConnectionFactory DbConnectionFactory
@inject EnjoyEveryday.Domain.Repositories.IUserRepository UserRepository

<div style="max-width: 900px; margin: 0 auto; padding: 30px 40px;">
    <PageHero 
        Eyebrow="PEOPLE" 
        Title="@(Id.HasValue ? "Edit Teacher" : "Add Teacher")" 
        Subtitle="@(Id.HasValue ? "Update the teacher's profile using the wizard." : "Create a new teacher profile using the wizard.")">
    </PageHero>

    <TeacherCreationWizard 
        Model="@_model" 
        AvailableClassrooms="@_classrooms"
        AvailableBranches="@_branches"
        OnCancel="HandleCancel" 
        OnSaveDraft="HandleSaveDraft" 
        OnActivate="HandleActivate" />
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private TeacherCreationWizard.TeacherWizardModel _model = new();
    private List<Classroom> _classrooms = new();
    private List<Branch> _branches = new();

    protected override async Task OnInitializedAsync()
    {
        var route = Id.HasValue ? $"/teachers/edit/{Id}" : "/teachers/new";
        if (!await PageAuth.EnsureAuthorizedAsync(route))
        {
            return;
        }

        var profile = await PageAuth.GetUserProfileAsync();
        var allClasses = await ClassroomService.GetAllClassroomsAsync();
        
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var org = (profile.OrganizationId != Guid.Empty
            ? orgs.FirstOrDefault(o => o.Id == profile.OrganizationId)
            : null) ?? orgs.FirstOrDefault();
        if (org != null)
        {
            var allBranches = (await BranchService.GetBranchesAsync(org.Id)).ToList();
            if (profile.IsOrgAdmin)
            {
                _branches = allBranches;
                _classrooms = allClasses.ToList();
            }
            else
            {
                _branches = allBranches.Where(b => profile.AssignedBranchIds.Contains(b.Id)).ToList();
                _classrooms = allClasses.Where(c => profile.AssignedBranchIds.Contains(c.BranchId)).ToList();
            }
        }

        if (Id.HasValue)
        {
            var tenantId = TenantContext.TenantId;
            var targetOrgId = profile.OrganizationId != Guid.Empty ? profile.OrganizationId : (Guid?)null;

            var teacher = await TeacherService.GetTeacherByIdAsync(tenantId, Id.Value);
            if (teacher == null)
            {
                var allTeachers = (await TeacherService.GetAllTeachersAsync(tenantId, targetOrgId)).ToList();
                teacher = allTeachers.FirstOrDefault(t => t.Id == Id.Value || t.UserId == Id.Value);
            }
            User? user = null;
            if (teacher != null && teacher.UserId.HasValue)
            {
                user = await UserService.GetUserByIdAsync(teacher.UserId.Value);
            }
            else
            {
                user = await UserService.GetUserByIdAsync(Id.Value);
                if (user != null)
                {
                    var allTeachers = await TeacherService.GetAllTeachersAsync(user.TenantId, targetOrgId);
                    teacher = allTeachers.FirstOrDefault(t => t.UserId == user.Id);
                }
            }

            if (teacher != null)
            {
                if (!string.IsNullOrWhiteSpace(teacher.DraftData))
                {
                    try
                    {
                        _model = System.Text.Json.JsonSerializer.Deserialize<TeacherCreationWizard.TeacherWizardModel>(teacher.DraftData) ?? new();
                        if (string.IsNullOrWhiteSpace(_model.AssignedBranch) && !string.IsNullOrWhiteSpace(_model.AssignedClassroom))
                        {
                            if (Guid.TryParse(_model.AssignedClassroom, out var cid))
                            {
                                var cls = _classrooms.FirstOrDefault(c => c.Id == cid);
                                if (cls != null)
                                {
                                    _model.AssignedBranch = cls.BranchId.ToString();
                                }
                            }
                        }
                    }
                    catch
                    {
                        // Fallback if deserialization fails
                        _model.FirstName = teacher.FirstName ?? user?.FirstName ?? "";
                        _model.LastName = teacher.LastName ?? user?.LastName ?? "";
                        _model.Email = user?.Email ?? "";
                        _model.PreferredName = teacher.PreferredName ?? "";
                    }
                }
                else
                {
                    _model.FirstName = teacher.FirstName ?? user?.FirstName ?? "";
                    _model.LastName = teacher.LastName ?? user?.LastName ?? "";
                    _model.Email = user?.Email ?? "";
                    _model.PreferredName = teacher.PreferredName ?? "";
                }
            }
        }
    }

    private void HandleCancel()
    {
        NavigationManager.NavigateTo("/teachers");
    }

    private async Task HandleSaveDraft(TeacherCreationWizard.TeacherWizardModel model)
    {
        await SaveTeacherAsync(model, "Draft");
        NavigationManager.NavigateTo("/teachers");
    }

    private async Task HandleActivate(TeacherCreationWizard.TeacherWizardModel model)
    {
        await SaveTeacherAsync(model, "Active");
        NavigationManager.NavigateTo("/teachers");
    }

    private async Task SaveTeacherAsync(TeacherCreationWizard.TeacherWizardModel model, string status)
    {
        if (string.IsNullOrWhiteSpace(model.AssignedClassroom))
        {
            var poolId = await SystemProvisioning.EnsureTeacherPoolAsync();
            model.AssignedClassroom = poolId.ToString();
        }

        if (Id.HasValue)
        {
            // Edit existing
            var user = await UserService.GetUserByIdAsync(Id.Value);
            Guid effectiveTenantId = TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId : (user?.TenantId ?? Guid.Empty);
            Guid targetOrgId = UserContext.OrganizationId ?? effectiveTenantId;

            if (user == null)
            {
                var existingTeacher = await TeacherService.GetTeacherByIdAsync(effectiveTenantId, Id.Value);
                if (existingTeacher?.UserId != null)
                {
                    user = await UserService.GetUserByIdAsync(existingTeacher.UserId.Value);
                }
            }

            if (user != null)
            {
                user.FirstName = model.FirstName;
                user.LastName = model.LastName;
                if (!string.IsNullOrWhiteSpace(model.Email))
                {
                    user.Email = model.Email;
                }
                if (status == "Active")
                {
                    user.IsActive = true;
                }
                await UserService.UpdateUserAsync(user);

                var allTeachers = (await TeacherService.GetAllTeachersAsync(effectiveTenantId, targetOrgId)).ToList();
                var teacher = allTeachers.FirstOrDefault(t => t.UserId == user.Id || t.Id == Id.Value);
                if (teacher != null)
                {
                    teacher.FirstName = model.FirstName;
                    teacher.LastName = model.LastName;
                    teacher.PreferredName = model.PreferredName;
                    teacher.ProfilePhotoUrl = model.ProfilePhotoUrl;
                    teacher.Status = status;
                    teacher.DraftData = System.Text.Json.JsonSerializer.Serialize(model);
                    teacher.ProfileCompletionPercentage = model.GetCompletionPercentage();
                    await TeacherService.UpdateTeacherAsync(teacher);
                }
                else
                {
                    // Teacher doesn't exist yet, create it
                    teacher = new Teacher
                    {
                        Id = Guid.NewGuid(),
                        TenantId = effectiveTenantId,
                        UserId = user.Id,
                        FirstName = string.IsNullOrWhiteSpace(model.FirstName) ? "Draft" : model.FirstName,
                        LastName = string.IsNullOrWhiteSpace(model.LastName) ? "Teacher" : model.LastName,
                        DisplayName = user.DisplayName ?? "",
                        PreferredName = model.PreferredName,
                        ProfilePhotoUrl = model.ProfilePhotoUrl,
                        Status = status,
                        DraftData = System.Text.Json.JsonSerializer.Serialize(model),
                        ProfileCompletionPercentage = model.GetCompletionPercentage()
                    };
                    await TeacherService.CreateTeacherAsync(teacher);
                }

                if (Guid.TryParse(model.AssignedClassroom, out var assignedCid) && assignedCid != Guid.Empty)
                {
                    using var conn = await DbConnectionFactory.CreateConnectionAsync();
                    await conn.ExecuteProcedureAsync("sp_dispatch_teacher_to_classroom", new
                    {
                        TenantId = effectiveTenantId,
                        ClassroomId = assignedCid,
                        UserId = user.Id
                    });

                    if (Guid.TryParse(model.AssignedBranch, out var branchId) && branchId != Guid.Empty)
                    {
                        await UserRepository.AssignBranchToUserAsync(effectiveTenantId, targetOrgId, branchId, user.Id, UserContext.UserId);
                    }
                }
            }
        }
        else
        {
            // 1. Create or Map Existing User
            // If they are just saving a draft on the first step, these might be empty
            var safeEmail = string.IsNullOrWhiteSpace(model.Email) ? $"draft_{Guid.NewGuid()}@draft.com" : model.Email.Trim();
            var safeFirstName = string.IsNullOrWhiteSpace(model.FirstName) ? "Draft" : model.FirstName.Trim();
            var safeLastName = string.IsNullOrWhiteSpace(model.LastName) ? "Teacher" : model.LastName.Trim();
            var roleToAssign = !string.IsNullOrWhiteSpace(model.JobTitle) && model.JobTitle.Contains("Lead", StringComparison.OrdinalIgnoreCase) 
                ? "LeadTeacher" 
                : "Teacher";

            var user = await UserService.CreateUserAsync(safeEmail, safeFirstName, safeLastName, "TEMP_HASH", roleToAssign);
            if (status == "Active")
            {
                user.IsActive = true;
                await UserService.UpdateUserAsync(user);
            }
            
            // 2. Create or Update Teacher Record
            Guid effectiveTenantId = TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId : user.TenantId;
            Guid targetOrgId = UserContext.OrganizationId ?? effectiveTenantId;
            var allTeachers = (await TeacherService.GetAllTeachersAsync(effectiveTenantId, targetOrgId)).ToList();
            var teacher = allTeachers.FirstOrDefault(t => t.UserId == user.Id);
            if (teacher != null)
            {
                teacher.FirstName = safeFirstName;
                teacher.LastName = safeLastName;
                teacher.PreferredName = model.PreferredName;
                teacher.ProfilePhotoUrl = model.ProfilePhotoUrl;
                teacher.Status = status;
                teacher.DraftData = System.Text.Json.JsonSerializer.Serialize(model);
                teacher.ProfileCompletionPercentage = model.GetCompletionPercentage();
                await TeacherService.UpdateTeacherAsync(teacher);
            }
            else
            {
                teacher = new Teacher
                {
                    Id = Guid.NewGuid(),
                    TenantId = effectiveTenantId,
                    UserId = user.Id,
                    FirstName = safeFirstName,
                    LastName = safeLastName,
                    DisplayName = user.DisplayName ?? $"{safeFirstName} {safeLastName}".Trim(),
                    PreferredName = model.PreferredName,
                    ProfilePhotoUrl = model.ProfilePhotoUrl,
                    Status = status,
                    DraftData = System.Text.Json.JsonSerializer.Serialize(model),
                    ProfileCompletionPercentage = model.GetCompletionPercentage()
                };
                await TeacherService.CreateTeacherAsync(teacher);
            }

            if (Guid.TryParse(model.AssignedClassroom, out var assignedCid) && assignedCid != Guid.Empty)
            {
                using var conn = await DbConnectionFactory.CreateConnectionAsync();
                await conn.ExecuteProcedureAsync("sp_dispatch_teacher_to_classroom", new
                {
                    TenantId = effectiveTenantId,
                    ClassroomId = assignedCid,
                    UserId = user.Id
                });

                if (Guid.TryParse(model.AssignedBranch, out var branchId) && branchId != Guid.Empty)
                {
                    await UserRepository.AssignBranchToUserAsync(effectiveTenantId, targetOrgId, branchId, user.Id, UserContext.UserId);
                }
            }
        }
    }
}
