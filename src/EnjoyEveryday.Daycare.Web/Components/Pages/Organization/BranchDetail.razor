@page "/management/branches/{BranchId:guid}"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Organization
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@inject BranchService BranchService
@inject ClassroomService ClassroomService
@inject ChildService ChildService
@inject ITeacherService TeacherService
@inject NavigationManager NavigationManager

<PageTitle>@(Branch?.Name ?? "Branch Detail") — EnjoyEveryday</PageTitle>

<div class="content branch-detail-page">
    @if (Branch == null)
    {
        <div style="padding: 40px; text-align: center; color: var(--muted, #6c7870);">
            <p>Loading branch details...</p>
        </div>
    }
    else
    {
        <PageHero Eyebrow="BRANCH VIEW"
                  Title="@Branch.Name"
                  Subtitle="@($"Location: {Branch.Location ?? "Main"} • Status: {(Branch.IsActive ? "Active" : "Inactive")}")">
            <RightContent>
                <button type="button" class="btn secondary" @onclick="GoBack">&larr; Back to Management</button>
                <button type="button" class="btn secondary" @onclick="GoToCreateClassroom">＋ Add Classroom</button>
                <button type="button" class="btn @(Branch.IsActive ? "secondary" : "primary")" @onclick="ToggleActive">
                    @(Branch.IsActive ? "Deactivate Branch" : "Activate Branch")
                </button>
            </RightContent>
        </PageHero>

        <FilterTabs Tabs="BranchTabs"
                    ActiveTab="@ActiveTab"
                    OnTabSelected="tab => ActiveTab = tab" />

        @if (ActiveTab == "classrooms")
        {
            <BranchClassroomsGrid Classrooms="@Classrooms"
                                  OnAddClassroom="GoToCreateClassroom"
                                  OnSelectClassroom="GoToClassroomDetail" />
        }
        else if (ActiveTab == "children")
        {
            <BranchChildrenGrid Children="@BranchChildren" />
        }
        else if (ActiveTab == "teachers")
        {
            <BranchTeachersGrid Teachers="@BranchTeachers" />
        }
    }
</div>

@code {
    [Parameter] public Guid BranchId { get; set; }

    private Branch? Branch;
    private IEnumerable<Classroom>? Classrooms;
    private List<Child>? BranchChildren;
    private List<Teacher>? BranchTeachers;
    
    private string ActiveTab = "classrooms";

    private List<FilterTabs.TabItem> BranchTabs => new()
    {
        new FilterTabs.TabItem { Text = $"Classrooms ({Classrooms?.Count() ?? 0})", Value = "classrooms" },
        new FilterTabs.TabItem { Text = $"Enrolled Children ({BranchChildren?.Count ?? 0})", Value = "children" },
        new FilterTabs.TabItem { Text = $"Teachers ({BranchTeachers?.Count ?? 0})", Value = "teachers" }
    };

    protected override async Task OnInitializedAsync()
    {
        Branch = await BranchService.GetBranchByIdAsync(BranchId);
        if (Branch != null)
        {
            Classrooms = await ClassroomService.GetClassroomsAsync(BranchId);
            
            BranchChildren = new List<Child>();
            foreach(var c in Classrooms)
            {
                var kids = await ChildService.GetChildrenByClassroomAsync(c.Id);
                if (kids != null) BranchChildren.AddRange(kids);
            }

            var allTeachers = await TeacherService.GetAllTeachersAsync(Branch.TenantId);
            BranchTeachers = allTeachers.ToList();
        }
    }

    private async Task ToggleActive()
    {
        if (Branch != null)
        {
            Branch.IsActive = !Branch.IsActive;
            await BranchService.UpdateBranchAsync(Branch);
            StateHasChanged();
        }
    }

    private void GoToCreateClassroom()
    {
        NavigationManager.NavigateTo($"/management/branches/{BranchId}/classrooms/new");
    }

    private void GoToClassroomDetail(Guid classroomId)
    {
        NavigationManager.NavigateTo($"/classrooms/{classroomId}");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/management");
    }
}
