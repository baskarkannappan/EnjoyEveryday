@page "/organization/branch-info"
@page "/organization/branch-info/{BranchId:guid}"
@page "/about-us"
@page "/contact-us"
@page "/about-and-contact"
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Facility
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext

<PageTitle>Campus Information &amp; Contacts — EnjoyEveryday</PageTitle>

<div class="content">
    <PageHero Eyebrow="CAMPUS DIRECTORY"
              Title="Campus Directory &amp; About Us"
              Subtitle="Direct campus phone lines, emergency contacts, operating hours, and location details for teachers and staff.">
        <RightContent>
            <a href="/management/dashboard" class="btn secondary">&larr; Back to Dashboard</a>
        </RightContent>
    </PageHero>

    <FacilityProfileView BranchId="BranchId" OrganizationId="@(UserContext.OrganizationId ?? Guid.Empty)" />
</div>

@code {
    [Parameter]
    public Guid? BranchId { get; set; }
}

