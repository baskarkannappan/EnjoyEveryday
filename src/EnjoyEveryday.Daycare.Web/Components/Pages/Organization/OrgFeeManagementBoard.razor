    .ee-stat-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px dashed var(--border, #e4e7df); font-size: 12.5px; color: var(--text, #26332d); }
    .ee-form-stack { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
