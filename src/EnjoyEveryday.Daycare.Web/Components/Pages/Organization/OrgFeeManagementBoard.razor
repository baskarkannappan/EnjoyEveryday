    .ee-list-item { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; background: var(--surface-soft, #f8f9f5); border: 1px solid var(--border, #e4e7df); border-radius: 0px; font-size: 12.5px; }
    .ee-badge { display: inline-flex; align-items: center; padding: 2px 7px; font-size: 10.5px; font-weight: 700; border-radius: 0px; background: var(--accent-light, #e6eee9); color: var(--accent-dark, #31523c); border: 1px solid #c8dacd; }
    .ee-muted { font-size: 12px; color: var(--muted, #6c7870); }
    .ee-banner { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; font-size: 12.5px; }
    .ee-banner-ok { background: var(--accent-light, #e6eee9); border: 1px solid #c8dacd; color: var(--accent-dark, #31523c); }
    .ee-banner-err { background: #fff5f5; border: 1px solid #fed7d7; color: #9b2c2c; }
