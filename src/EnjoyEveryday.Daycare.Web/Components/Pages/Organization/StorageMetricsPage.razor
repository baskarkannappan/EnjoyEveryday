@page "/organization/storage-metrics"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.UI.Shared.Components.Storage

<PageTitle>Storage &amp; Media Explorer — EnjoyEveryday</PageTitle>

<div class="content" style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <PageHero Eyebrow="ORGANIZATION TELEMETRY"
              Title="Storage &amp; Media Footprint"
              Subtitle="Track image asset counts and storage distribution across all branches and classrooms.">
        <RightContent>
            <a href="/organization/settings" class="btn secondary">Organization Settings</a>
        </RightContent>
    </PageHero>

    <div style="margin-top: 20px;">
        <StorageExplorerView IsPlatformAdminView="false" />
    </div>
</div>

