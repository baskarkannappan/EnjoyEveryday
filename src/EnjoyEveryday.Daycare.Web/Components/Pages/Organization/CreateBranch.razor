@page "/management/branches/new"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext

<PageTopbar Breadcrumb="Organization · Add Branch" Title="Add Branch">
    <RightContent>
        <button class="icon-button" @onclick="GoBack">✕</button>
    </RightContent>
</PageTopbar>

<div class="content">
    <PageHero Eyebrow="ORGANIZATION"
              Title="Create a New Branch"
              Subtitle="Add a new location to your organization to expand classrooms, teachers, and children.">
        <RightContent>
            <button class="btn secondary" @onclick="GoBack">Back to Branches</button>
        </RightContent>
    </PageHero>

    <div style="max-width: 680px; margin: 0 auto;">
        <BranchFormCard @bind-BranchName="BranchName"
                        @bind-Location="Location"
                        ErrorMessage="@ErrorMessage"
                        IsSubmitting="@IsSubmitting"
                        OnSubmit="Create"
                        OnCancel="GoBack" />
    </div>
</div>

@code {
    private string BranchName = "";
    private string Location = "";
    private string ErrorMessage = "";
    private bool IsSubmitting = false;

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(BranchName))
        {
            ErrorMessage = "Branch name is required.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = "";

        try
        {
            var orgs = await OrganizationService.GetOrganizationsAsync();
            var org = (UserContext.OrganizationId.HasValue 
                ? orgs.FirstOrDefault(o => o.Id == UserContext.OrganizationId.Value) 
                : null) ?? orgs.FirstOrDefault();
            if (org != null)
            {
                var branch = await BranchService.CreateBranchAsync(org.Id, BranchName, Location);
                NavigationManager.NavigateTo($"/management/branches/{branch.Id}");
            }
            else
            {
                ErrorMessage = "Could not find organization context.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to create branch: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/management");
    }
}
