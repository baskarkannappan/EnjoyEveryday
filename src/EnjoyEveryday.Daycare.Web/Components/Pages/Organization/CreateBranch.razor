@page "/management/branches/new"
@rendermode InteractiveServer
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Application.Services
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject NavigationManager NavigationManager
@inject EnjoyEveryday.Shared.Tenancy.IUserContext UserContext

<PageTopbar Breadcrumb="Organization · Add Branch" Title="Add Branch">
    <RightContent>
        <button class="icon-button" @onclick="GoBack">✕</button>
    </RightContent>
</PageTopbar>

<style>
    .create-branch-container {
        padding: 34px;
        max-width: 680px;
        margin: auto;
    }
    .create-branch-card {
        background: white;
        border: 1px solid var(--line, #e3e7e1);
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 8px 28px rgba(38,49,43,.06);
    }
    .form-field {
        margin-bottom: 22px;
    }
    .form-field label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        font-weight: 700;
        color: #78827c;
        margin-bottom: 8px;
    }
    .form-field input {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #e3e7e1;
        border-radius: 11px;
        padding: 12px 15px;
        font-size: 14px;
        background: #fff;
        color: #26312b;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        font-family: inherit;
    }
    .form-field input:focus {
        border-color: #52745e;
        box-shadow: 0 0 0 3px rgba(82, 116, 94, 0.12);
    }
    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 32px;
    }
    .alert-error {
        background: #f8e5e1;
        color: #9b4437;
        border: 1px solid #f3cfc8;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 13px;
        font-weight: 600;
    }
</style>

<section class="create-branch-container">
    <div class="page-header" style="margin-bottom: 24px;">
        <h1 style="font-size: 28px; font-weight: 800; letter-spacing: -0.7px; margin: 0 0 6px;">Create a new branch</h1>
        <p class="header-description" style="color: #78827c; font-size: 14px; margin: 0;">Add a new location to your organization.</p>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert-error">@ErrorMessage</div>
    }

    <div class="create-branch-card">
        <div class="form-field">
            <label>Branch Name</label>
            <input type="text" @bind="BranchName" placeholder="e.g. Downtown" />
        </div>

        <div class="form-field">
            <label>Location / Address</label>
            <input type="text" @bind="Location" placeholder="e.g. 72 King Street" />
        </div>

        <div class="form-actions">
            <button class="btn primary" @onclick="Create" disabled="@IsSubmitting">
                @(IsSubmitting ? "Creating..." : "Create Branch")
            </button>
            <button class="btn secondary" @onclick="GoBack" disabled="@IsSubmitting">Cancel</button>
        </div>
    </div>
</section>

@code {
    private string BranchName = "";
    private string Location = "";
    private string ErrorMessage = "";
    private bool IsSubmitting = false;

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(BranchName))
        {
            ErrorMessage = "Branch name is required.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = "";

        try
        {
            var orgs = await OrganizationService.GetOrganizationsAsync();
            var org = (UserContext.OrganizationId.HasValue 
                ? orgs.FirstOrDefault(o => o.Id == UserContext.OrganizationId.Value) 
                : null) ?? orgs.FirstOrDefault();
            if (org != null)
            {
                var branch = await BranchService.CreateBranchAsync(org.Id, BranchName, Location);
                NavigationManager.NavigateTo($"/management/branches/{branch.Id}");
            }
            else
            {
                ErrorMessage = "Could not find organization context.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to create branch: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/management");
    }
}
