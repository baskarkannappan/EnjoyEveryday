</style>

@code {
    private DateTime _selectedDate = DateTime.Today;
    private Guid _selectedBranchId = Guid.Empty;
    private List<Branch>? _branches;
    private StaffRosterOverview? _overview;
    private bool _isLoading = true;

    // Modals
    private bool _isLeaveModalOpen = false;
    private Guid _newLeaveTeacherId = Guid.Empty;
    private string _newLeaveType = "Vacation";
    private DateTime _newLeaveStart = DateTime.Today;
    private DateTime _newLeaveEnd = DateTime.Today.AddDays(1);
    private string _newLeaveReason = "";

    private bool _isSubModalOpen = false;
    private StaffLeaveItem? _selectedLeaveForSub;
    private Guid _selectedSubTeacherId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrganizationService.GetOrganizationsAsync();
        var defaultOrg = orgs.FirstOrDefault();
        if (defaultOrg != null)
        {
            var branchesList = await BranchService.GetBranchesAsync(defaultOrg.Id);
            _branches = branchesList.ToList();
            if (_branches.Any())
            {
                _selectedBranchId = _branches.First().Id;
            }
        }

        await LoadRosterAsync();
    }

    private async Task SelectBranch(Guid branchId)
    {
        _selectedBranchId = branchId;
        await LoadRosterAsync();
    }

    private async Task LoadRosterAsync()
    {
        if (_selectedBranchId == Guid.Empty) return;

        _isLoading = true;
        try
        {
            _overview = await RosterService.GetRosterOverviewAsync(_selectedBranchId, _selectedDate);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetRatioClass(RatioComplianceStatus status) => status switch
    {
        RatioComplianceStatus.Compliant => "compliant",
        RatioComplianceStatus.AtRisk => "atrisk",
        _ => "breached"
    };

    private async Task DispatchFloat(Guid classroomId)
    {
        if (_overview?.AvailableFloatTeachers.Any() == true)
        {
            var floatTeacher = _overview.AvailableFloatTeachers.First();
            await RosterService.DispatchFloatTeacherAsync(floatTeacher.TeacherId, classroomId);
            await LoadRosterAsync();
        }
    }

    private async Task SubmitLeave()
    {
        if (_newLeaveTeacherId == Guid.Empty) return;

        var leave = new StaffLeave
        {
            TeacherId = _newLeaveTeacherId,
            LeaveType = _newLeaveType,
            StartDate = _newLeaveStart,
            EndDate = _newLeaveEnd,
            Reason = _newLeaveReason,
            Status = "Approved",
            CoverageStatus = "Uncovered"
        };

        await RosterService.SubmitStaffLeaveAsync(leave);
        _isLeaveModalOpen = false;
        _newLeaveTeacherId = Guid.Empty;
        _newLeaveReason = "";
        await LoadRosterAsync();
    }

    private void OpenSubModal(StaffLeaveItem leave)
    {
        _selectedLeaveForSub = leave;
        _selectedSubTeacherId = Guid.Empty;
        _isSubModalOpen = true;
    }

    private async Task ConfirmSubAssignment()
    {
        if (_selectedLeaveForSub == null || _selectedSubTeacherId == Guid.Empty) return;

        await RosterService.AssignSubstituteCoverageAsync(_selectedLeaveForSub.Id, _selectedSubTeacherId);
        _isSubModalOpen = false;
        _selectedLeaveForSub = null;
        await LoadRosterAsync();
    }
}
