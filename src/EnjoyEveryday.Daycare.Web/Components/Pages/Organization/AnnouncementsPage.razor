@page "/announcements"
@page "/management/announcements"
@rendermode InteractiveServer
@using EnjoyEveryday.Application.Services
@using EnjoyEveryday.Domain.Entities
@using EnjoyEveryday.UI.Shared.Components
@using EnjoyEveryday.Shared.Tenancy
@using EnjoyEveryday.UI.Shared.Services
@inject IDaycareAnnouncementService AnnouncementService
@inject BranchService BranchService
@inject OrganizationService OrganizationService
@inject IUserContext UserContext
@inject ITenantContext TenantContext
@inject IAppNotificationService NotificationService

<PageTitle>Daycare Announcements — EnjoyEveryday</PageTitle>

<div class="content announcements-container">
    <PageHero Eyebrow="COMMUNICATION &amp; BROADCASTS"
              Title="Daycare Announcements"
              Subtitle="Create, broadcast, and manage official daycare center announcements, seasonal notices, and urgent alerts synced across parent and educator portals.">
        <RightContent>
            <button class="primary" @onclick="OpenCreateModal">
                ＋ Publish Announcement
            </button>
        </RightContent>
    </PageHero>

    <!-- FILTER & SEARCH ROW -->
    <div class="filter-row">
        <div class="tabs-group">
            <button class="status-tab @(_activeStatusTab == "Active" ? "active" : "")" @onclick='() => SetStatusTab("Active")'>
                Active Broadcasts (@_announcements.Count(a => a.IsActive))
            </button>
            <button class="status-tab @(_activeStatusTab == "Deactivated" ? "active" : "")" @onclick='() => SetStatusTab("Deactivated")'>
                Deactivated / Removed (@_announcements.Count(a => !a.IsActive))
            </button>
        </div>

        <div class="filter-controls">
            <div class="filter-group">
                <label class="filter-label">Branch:</label>
                <select class="filter-select" @bind="_selectedBranchFilter" @bind:after="ApplyFilter">
                    <option value="">All Branches</option>
                    @foreach (var br in _branches)
                    {
                        <option value="@br.Id.ToString()">@br.Name</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label class="filter-label">Category:</label>
                <select class="filter-select" @bind="_selectedTagFilter" @bind:after="ApplyFilter">
                    <option value="">All Categories</option>
                    <option value="Notice">Notice</option>
                    <option value="Reminder">Reminder</option>
                    <option value="Urgent Alert">Urgent Alert</option>
                    <option value="Weather">Weather / Safety</option>
                    <option value="Event">Event / Celebration</option>
                    <option value="Policy">Policy Update</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ANNOUNCEMENTS LIST -->
    @if (_loading)
    {
        <LoadingState Message="Loading announcements..." MinHeightPx="180" />
    }
    else if (!_filteredAnnouncements.Any())
    {
        <div class="empty-announcements-card">
            <div class="empty-icon">📢</div>
            <h3>@(_activeStatusTab == "Active" ? "No Active Announcements" : "No Deactivated Announcements")</h3>
            <p>@(_activeStatusTab == "Active" 
                ? "No active published announcements match the selected filter. Click 'Publish Announcement' above to broadcast a new update to families." 
                : "No announcements are currently in the deactivated archive.")</p>
        </div>
    }
    else
    {
        <div class="announcements-grid">
            @foreach (var ann in _filteredAnnouncements)
            {
                <div class="announcement-card @(ann.IsUrgent ? "urgent-card" : "") @(!ann.IsActive ? "deactivated-card" : "")">
                    <div class="announcement-card-header">
                        <div class="announcement-badge-wrap">
                            @if (!ann.IsActive)
                            {
                                <span class="badge-deactivated">🚫 DEACTIVATED</span>
                            }
                            else if (ann.IsUrgent)
                            {
                                <span class="badge-urgent">🚨 URGENT ALERT</span>
                            }
                            <span class="badge-tag">@ann.Tag</span>
                            <span class="badge-scope">
                                @(ann.BranchId.HasValue 
                                    ? $"Branch: {_branches.FirstOrDefault(b => b.Id == ann.BranchId.Value)?.Name ?? "Center"}" 
                                    : "Organization-Wide (All Branches)")
                            </span>
                        </div>
                        <div class="announcement-actions">
                            @if (ann.IsActive)
                            {
                                <button class="btn-deactivate" title="Deactivate and remove from all parent & educator screens" @onclick="() => DeactivateAnnouncement(ann.Id)">
                                    🚫 Deactivate
                                </button>
                            }
                            else
                            {
                                <button class="btn-reactivate" title="Reactivate and broadcast back to parent screens" @onclick="() => ReactivateAnnouncement(ann.Id)">
                                    ↻ Reactivate
                                </button>
                            }
                            <button class="delete-ann-btn" title="Delete announcement permanently" @onclick="() => DeleteAnnouncement(ann.Id)">
                                ✕
                            </button>
                        </div>
                    </div>

                    <h2 class="announcement-title">@ann.Title</h2>
                    <p class="announcement-body">@ann.Content</p>

                    <div class="announcement-footer">
                        <div class="author-info">
                            <span>Posted by <strong>@(ann.AuthorName ?? "Daycare Administration")</strong></span>
                            @if (!string.IsNullOrWhiteSpace(ann.AuthorRole))
                            {
                                <span class="author-role-pill">@ann.AuthorRole</span>
                            }
                            <span class="dot">•</span>
                            <span>@ann.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy · h:mm tt")</span>
                        </div>
                        <div class="sync-status">
                            @if (ann.IsActive)
                            {
                                <span class="dot-online"></span>
                                <span>Live on Parent Portal</span>
                            }
                            else
                            {
                                <span class="dot-offline"></span>
                                <span style="color: #991b1b; font-weight: 700;">Removed from Screens</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- CREATE ANNOUNCEMENT MODAL -->
@if (_showCreateModal)
{
    <div class="modal-backdrop" @onclick="CloseCreateModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="modal-eyebrow">OFFICIAL BROADCAST</div>
                    <h3 class="modal-title">Publish Daycare Announcement</h3>
                </div>
                <button class="close-btn" @onclick="CloseCreateModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-banner">
                        <span>⚠️ @_errorMessage</span>
                    </div>
                }

                <div class="form-field">
                    <label>Announcement Headline / Title *</label>
                    <input type="text" class="form-input" @bind="_formTitle" placeholder="e.g. Seasonal Weather Reminder or Spring Parent-Teacher Conference" />
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label>Category / Tag *</label>
                        <select class="form-select" @bind="_formTag">
                            <option value="Notice">Notice</option>
                            <option value="Reminder">Reminder</option>
                            <option value="Urgent Alert">Urgent Alert</option>
                            <option value="Weather">Weather / Safety</option>
                            <option value="Event">Event / Celebration</option>
                            <option value="Policy">Policy Update</option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label>Target Scope *</label>
                        <select class="form-select" @bind="_formBranchId">
                            <option value="">Organization-Wide (All Branches)</option>
                            @foreach (var br in _branches)
                            {
                                <option value="@br.Id.ToString()">Branch: @br.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-field">
                    <label>Announcement Message Body *</label>
                    <textarea class="form-textarea" rows="4" @bind="_formContent" placeholder="Write the announcement details to be delivered to parents..."></textarea>
                </div>

                <div class="urgent-toggle-field">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_formIsUrgent" />
                        <div>
                            <strong>Mark as Urgent Broadcast</strong>
                            <p>Urgent announcements display immediately as a highlighted alert banner at the top of the Parent Home and Messages pages.</p>
                        </div>
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button class="secondary" @onclick="CloseCreateModal">Cancel</button>
                <button class="primary" disabled="@_isSubmitting" @onclick="SubmitAnnouncement">
                    @(_isSubmitting ? "Publishing..." : "Publish Announcement")
                </button>
            </div>
        </div>
    </div>
}

