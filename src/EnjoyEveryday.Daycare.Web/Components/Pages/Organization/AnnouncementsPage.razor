</style>

@code {
    private List<DaycareAnnouncement> _announcements = new();
    private List<DaycareAnnouncement> _filteredAnnouncements = new();
    private List<Branch> _branches = new();
    private bool _loading = true;
    private bool _showCreateModal = false;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private string _activeStatusTab = "Active";
    private string _selectedBranchFilter = "";
    private string _selectedTagFilter = "";

    // Form inputs
    private string _formTitle = "";
    private string _formTag = "Notice";
    private string _formBranchId = "";
    private string _formContent = "";
    private bool _formIsUrgent = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBranchesAsync();
        await LoadAnnouncementsAsync();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var orgs = await OrganizationService.GetOrganizationsAsync();
            var org = orgs.FirstOrDefault();
            if (org != null)
            {
                var branches = await BranchService.GetBranchesAsync(org.Id);
                _branches = branches.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Announcements] Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadAnnouncementsAsync()
    {
        try
        {
            _loading = true;
            var tenantId = TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId : Guid.Parse("10000000-0000-0000-0000-000000000001");
            var items = await AnnouncementService.GetAnnouncementsAsync(tenantId, activeOnly: false);
            _announcements = items.ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Announcements] Error loading announcements: {ex.Message}");
            _announcements = new();
            _filteredAnnouncements = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetStatusTab(string tab)
    {
        _activeStatusTab = tab;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = _announcements.AsEnumerable();

        if (_activeStatusTab == "Active")
        {
            query = query.Where(a => a.IsActive);
        }
        else
        {
            query = query.Where(a => !a.IsActive);
        }

        if (!string.IsNullOrWhiteSpace(_selectedBranchFilter) && Guid.TryParse(_selectedBranchFilter, out var filterBranchId))
        {
            query = query.Where(a => a.BranchId == null || a.BranchId == filterBranchId);
        }

        if (!string.IsNullOrWhiteSpace(_selectedTagFilter))
        {
            query = query.Where(a => string.Equals(a.Tag, _selectedTagFilter, StringComparison.OrdinalIgnoreCase));
        }

        _filteredAnnouncements = query.ToList();
    }

    private void OpenCreateModal()
    {
        _formTitle = "";
        _formTag = "Notice";
        _formBranchId = "";
        _formContent = "";
        _formIsUrgent = false;
        _errorMessage = null;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _errorMessage = null;
    }

    private async Task SubmitAnnouncement()
    {
        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _errorMessage = "Announcement Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formContent))
        {
            _errorMessage = "Announcement Message Content is required.";
            return;
        }

        try
        {
            _isSubmitting = true;
            _errorMessage = null;

            Guid? branchId = Guid.TryParse(_formBranchId, out var parsedBranchId) ? parsedBranchId : null;
            Guid orgId = _branches.FirstOrDefault(b => b.Id == branchId)?.OrganizationId 
                         ?? (_branches.FirstOrDefault()?.OrganizationId ?? Guid.Parse("20000000-0000-0000-0000-000000000001"));

            var authorName = !string.IsNullOrWhiteSpace(UserContext.Email) ? UserContext.Email : "Daycare Administration";
            var authorRole = UserContext.Roles.FirstOrDefault() ?? "Admin";

            var announcement = new DaycareAnnouncement
            {
                Id = Guid.NewGuid(),
                TenantId = TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId : Guid.Parse("10000000-0000-0000-0000-000000000001"),
                OrganizationId = orgId,
                BranchId = branchId,
                Title = _formTitle.Trim(),
                Content = _formContent.Trim(),
                Tag = _formTag,
                IsUrgent = _formIsUrgent,
                AuthorName = authorName,
                AuthorRole = authorRole,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            await AnnouncementService.CreateAnnouncementAsync(announcement);
            await NotificationService.ShowSuccessAsync("Announcement published and broadcasted to parents!");

            CloseCreateModal();
            await LoadAnnouncementsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to publish: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task DeactivateAnnouncement(Guid id)
    {
        try
        {
            var deactivated = await AnnouncementService.DeactivateAnnouncementAsync(id);
            if (deactivated)
            {
                await NotificationService.ShowSuccessAsync("Announcement deactivated and removed from screens.");
                await LoadAnnouncementsAsync();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorAsync($"Failed to deactivate: {ex.Message}");
        }
    }

    private async Task ReactivateAnnouncement(Guid id)
    {
        try
        {
            var reactivated = await AnnouncementService.ReactivateAnnouncementAsync(id);
            if (reactivated)
            {
                await NotificationService.ShowSuccessAsync("Announcement reactivated and live on screens.");
                await LoadAnnouncementsAsync();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorAsync($"Failed to reactivate: {ex.Message}");
        }
    }

    private async Task DeleteAnnouncement(Guid id)
    {
        try
        {
            var deleted = await AnnouncementService.DeleteAnnouncementAsync(id);
            if (deleted)
            {
                await NotificationService.ShowSuccessAsync("Announcement permanently deleted.");
                await LoadAnnouncementsAsync();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorAsync($"Failed to delete: {ex.Message}");
        }
    }
}
