<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["customstyles.css"]" />
    <link rel="stylesheet" href="@Assets["EnjoyEveryday.Daycare.Web.styles.css"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" />
    </noscript>
    <link rel="stylesheet" href="@Assets["_content/EnjoyEveryday.UI.Shared/css/ee-foundation.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <title>Daycare Web</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <!-- Non-intrusive Scandinavian Reconnection Banner for Classroom Educators -->
    <div id="components-reconnect-modal" class="components-reconnect-hide" role="status" aria-live="polite">
        <div class="reconnect-banner">
            <div class="reconnect-state-reconnecting">
                <div class="reconnect-spinner"></div>
                <div class="reconnect-copy">
                    <strong>Reconnecting to Classroom…</strong>
                    <span>Restoring live connection with EnjoyEveryday.</span>
                </div>
            </div>
            <div class="reconnect-state-failed">
                <span class="reconnect-status-icon" aria-hidden="true">⚠️</span>
                <div class="reconnect-copy">
                    <strong>Connection Paused</strong>
                    <span>Check your Wi-Fi or mobile network.</span>
                </div>
                <button type="button" class="btn-reconnect-action" onclick="window.Blazor.reconnect()">Retry</button>
            </div>
            <div class="reconnect-state-rejected">
                <span class="reconnect-status-icon" aria-hidden="true">🔄</span>
                <div class="reconnect-copy">
                    <strong>Session Expired</strong>
                    <span>Refresh to resume your classroom session.</span>
                </div>
                <button type="button" class="btn-reconnect-action" onclick="location.reload()">Reload</button>
            </div>
        </div>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/EnjoyEveryday.UI.Shared/imageConverter.js" defer></script>
    <script src="_content/EnjoyEveryday.UI.Shared/voiceRecognition.js" defer></script>
    <script src="js/razorpayCheckout.js" defer></script>
    <script src="js/storybook.js" defer></script>
</body>

</html>
