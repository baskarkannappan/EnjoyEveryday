@using FMS.Application.Queries.Clinical.Events
@using FMS.Domain.Clinical.Events

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Clinical Events</h5>
        <button class="btn btn-sm btn-primary" @onclick="ShowRecordEventModal">Record Event</button>
    </div>
    <div class="card-body">
        @if (Events == null)
        {
            <p><em>Loading clinical events...</em></p>
        }
        else if (!Events.Any())
        {
            <p>No clinical events recorded for this treatment cycle.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var evt in Events)
                {
                    <li class="timeline-item @(evt.Status == EventStatus.Voided ? "text-muted" : "")">
                        <strong>@evt.EventType.ToString()</strong> 
                        <span class="float-end">@evt.OccurredAt.ToString("MMM dd, yyyy HH:mm")</span>
                        <p>@evt.Description</p>
                        @if (evt.Status != EventStatus.Voided)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AmendEvent(evt.Id)">Amend</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => VoidEvent(evt.Id)">Void</button>
                        }
                        else
                        {
                            <span class="badge bg-danger">Voided</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid TreatmentCycleId { get; set; }
    
    [Parameter]
    public IReadOnlyList<ClinicalEventDto>? Events { get; set; }

    private void ShowRecordEventModal()
    {
        // Interactivity logic would go here
    }

    private void AmendEvent(Guid eventId)
    {
        // Interactivity logic would go here
    }
    
    private void VoidEvent(Guid eventId)
    {
        // Interactivity logic would go here
    }
}
<style>
.timeline {
    list-style: none;
    padding: 0;
}
.timeline-item {
    border-left: 2px solid #007bff;
    padding-left: 15px;
    margin-bottom: 15px;
    position: relative;
}
.timeline-item::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #007bff;
}
</style>
