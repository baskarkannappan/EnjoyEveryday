<Project>
  <!-- Release locked DLLs before building host executable projects on Windows -->
  <Target Name="KillLockingDevProcesses" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And '$(OutputType)' == 'Exe'">
    <Exec Command="taskkill /F /IM EnjoyEveryday.Daycare.Web.exe 2>nul || (exit 0)" 
          IgnoreExitCode="true" 
          StandardOutputImportance="Low" 
          StandardErrorImportance="Low" />
    <Exec Command="taskkill /F /IM EnjoyEveryday.Api.exe 2>nul || (exit 0)" 
          IgnoreExitCode="true" 
          StandardOutputImportance="Low" 
          StandardErrorImportance="Low" />
    <Exec Command="taskkill /F /IM EnjoyEveryday.Admin.Web.exe 2>nul || (exit 0)" 
          IgnoreExitCode="true" 
          StandardOutputImportance="Low" 
          StandardErrorImportance="Low" />
    <Exec Command="taskkill /F /IM EnjoyEveryday.Parent.Web.exe 2>nul || (exit 0)" 
          IgnoreExitCode="true" 
          StandardOutputImportance="Low" 
          StandardErrorImportance="Low" />
  </Target>
</Project>
