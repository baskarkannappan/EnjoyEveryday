# Copy to .env in the repository root for Docker Compose runtime configuration.
# NEVER commit .env to Git.

GHCR_OWNER=baskarkannappan
ASPNETCORE_ENVIRONMENT=Production

# Immutable Git SHA tags (or 'latest' for initial smoke test)
UI_TAG=latest
API_TAG=latest
AI_TAG=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enjoyeveryday
POSTGRES_HOST_PORT=5433

# AI Service Runtime Credentials & Security
AI_PROVIDER=GoogleGemini
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2
AI_DOTNET_TIMEOUT_SECONDS=45
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
REQUIRE_SERVICE_AUTH=false
AI_SERVICE_SECRET=

